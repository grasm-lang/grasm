{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Grasm",
  "scopeName": "source.grasm",
  "_generated": "scripts/grammar.py \u2014 derived from the compiler; edit that, not this",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#types"
    },
    {
      "include": "#functions"
    },
    {
      "include": "#numbers"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.grasm",
          "match": "//.*$"
        },
        {
          "name": "comment.block.grasm",
          "begin": "/\\*",
          "end": "\\*/",
          "patterns": [
            {
              "include": "#comments"
            }
          ]
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.triple.grasm",
          "begin": "\"\"\"",
          "end": "\"\"\""
        },
        {
          "name": "string.quoted.double.grasm",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.grasm",
              "match": "\\\\."
            },
            {
              "name": "meta.embedded.grasm",
              "begin": "(?<!\\\\)\\{",
              "end": "\\}",
              "patterns": [
                {
                  "include": "$self"
                }
              ]
            }
          ]
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.grasm",
          "match": "\\b(handled_by|continue|return|break|match|while|else|with|for|try|if|in)\\b"
        },
        {
          "name": "keyword.declaration.grasm",
          "match": "\\b(interface|effect|import|impl|test|type|fn)\\b"
        },
        {
          "name": "keyword.operator.word.grasm",
          "match": "\\b(and|not|or)\\b"
        },
        {
          "name": "storage.modifier.grasm",
          "match": "\\b(unsafe|inout|let|own|pub|ref|var)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.grasm",
          "match": "\\b(false|None|Some|true|Err|Ok)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.grasm",
          "match": "\\b(bytes|float|range|usize|bool|f32|f64|i16|i32|i64|int|str|u16|u32|u64|i8|u8)\\b"
        },
        {
          "name": "entity.name.type.grasm",
          "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "entity.name.function.grasm",
          "match": "(?<=\\bfn\\s)[a-z_][A-Za-z0-9_]*"
        },
        {
          "name": "support.function.grasm",
          "match": "\\b(monotonic_millis|monotonic_nanos|tcp_write_bytes|tcp_read_bytes|proc_pipeline|read_bytes_at|tcp_listen_on|udp_recv_from|append_bytes|bytes_filled|make_dir_new|random_bytes|sleep_millis|chan_select|file_exists|net_workers|remove_file|rename_file|tcp_connect|write_bytes|chan_close|now_millis|read_bytes|tcp_accept|tcp_listen|write_file|assert_eq|chan_recv|chan_send|file_size|net_close|read_file|sync_file|tcp_write|bytes_of|chan_new|list_dir|make_dir|net_port|net_wait|proc_run|tcp_peer|tcp_read|udp_bind|udp_recv|udp_send|assert|eprint|input|panic|print|args|exit|env)\\b(?=\\s*\\()"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.grasm",
          "match": "\\b(0x[0-9a-fA-F_]+|0b[01_]+|[0-9][0-9_]*(\\.[0-9_]+)?([eE][+-]?[0-9]+)?)\\b"
        }
      ]
    }
  }
}
