// Runtime values, and the three things every engine must agree on about
// them: how they print ([L-DISPLAY]), when two are equal
// ([E-EQ-STRUCTURAL]) and how they sort ([L-LIB-SORT-NAN]). Each follows
// `crates/grasm_interp/src/value.rs`, the reference.
//
// A variant test costs a call per arm in compiled code, so the `match`es
// here list the common shapes first.
import load

/// A value of the interpreted program.
///
/// Every integer type but `u64` is a `VInt` holding the value already
/// wrapped to its width: the TIR operator says the width, so the value need
/// not. A `u64` is a `VU64`, because from 2^63 up it is not an `i64`, and the
/// value itself has to know to print, compare and divide unsigned -- inside a
/// list, a struct or a map as much as on its own ([T-U64]). A map keeps one
/// host map per key type, of which a program only ever uses one; the first
/// three are in the order [E-MAP-ORDER] sorts their keys. The builders are
/// the host's own, whose copies are copies ([L-LIB-BUILDER]).
type Value =
    | VInt(v: i64)
    | VStr(v: str)
    | VBool(v: bool)
    | VList(items: [Value])
    | VStruct(ty: i64, fields: [Value])
    | VVariant(ty: i64, idx: i64, fields: [Value])
    | VFloat(v: f64)
    | VUnit
    | VTuple(items: [Value])
    | VBytes(v: bytes)
    | VOk(v: Value)
    | VErr(v: Value)
    | VMap(kb: Map[bool, Value], ki: Map[i64, Value], ks: Map[str, Value], ku: Map[u64, Value], kt: Map[str, Value])
    | VRange(lo: i64, hi: i64, incl: bool)
    | VRef(slot: i64, gen: i64)
    | VClosure(node: i64, serial: i64, caps: [Value])
    | VFn(id: i64)
    | VU64(v: u64)
    | VStrB(b: StrBuilder)
    | VByteB(b: ByteBuilder)

// ----- taking a value apart without sharing it ------------------------------
//
// A container held in a variant is shared by the variant until the variant
// is gone, and a write to a shared container copies it. These hand the
// container back from a function that owned the only reference, so the
// caller's write lands in place ([E-COW]): `xs.push(v)` on a local stays
// O(1).

pub fn take(inout slot: Value) -> Value {
    let old = slot
    slot = VUnit
    old
}

/// Which container a value is: 1 a list, 2 a map, 3 bytes, 4 a struct, 5 a
/// `StrBuilder`, 6 a `ByteBuilder`, 0 anything else. Asked before a container is taken out of a value, rather than
/// matching on the value and taking it inside the arm: the `match` keeps
/// its own reference until the arm ends, and the taken container is shared.
pub fn shape(v: Value) -> i64 {
    match v {
        VList(_) -> 1
        VMap(_, _, _, _, _) -> 2
        VBytes(_) -> 3
        VStruct(_, _) -> 4
        VStrB(_) -> 5
        VByteB(_) -> 6
        _ -> 0
    }
}

/// A new list holding a list's elements.
pub fn list_copy(v: Value) -> [Value] {
    var out: [Value] = []
    match v {
        VList(items) -> {
            for x in items {
                out.push(x)
            }
        }
        _ -> ()
    }
    out
}

pub fn list_of(v: Value) -> [Value] {
    match v {
        VList(items) -> items
        VTuple(items) -> items
        _ -> []
    }
}

pub fn fields_of(v: Value) -> [Value] {
    match v {
        VStruct(_, fields) -> fields
        VVariant(_, _, fields) -> fields
        VTuple(items) -> items
        _ -> []
    }
}

pub fn bytes_of_value(v: Value) -> bytes {
    match v {
        VBytes(b) -> b
        _ -> bytes_of([])
    }
}

pub fn none_v(p: Prog) -> Value {
    VVariant(p.option_ty, p.none_idx, [])
}

pub fn some_v(p: Prog, v: Value) -> Value {
    VVariant(p.option_ty, p.some_idx, [v])
}

pub fn empty_map() -> Value {
    VMap(map(), map(), map(), map(), map())
}

// ----- printing ------------------------------------------------------------

/// `print`'s text for a value.
pub fn show(p: Prog, v: Value) -> str {
    match v {
        VStr(s) -> s
        VInt(n) -> "{n}"
        VBool(b) -> if b { "true" } else { "false" }
        VFloat(f) -> "{f}"
        _ -> {
            var out: [str] = []
            show_into(p, v, out)
            out.join("")
        }
    }
}

fn show_seq(p: Prog, items: [Value], inout out: [str]) {
    var first = true
    for x in items {
        if not first {
            out.push(", ")
        }
        first = false
        show_into(p, x, out)
    }
}

fn show_into(p: Prog, v: Value, inout out: [str]) {
    match v {
        VStr(s) -> out.push(s)
        VInt(n) -> out.push("{n}")
        VBool(b) -> out.push(if b { "true" } else { "false" })
        VList(items) -> {
            out.push("[")
            show_seq(p, items, out)
            out.push("]")
        }
        VStruct(ty, fields) -> {
            out.push(p.ty_name[ty])
            out.push("\{")
            let names = p.ty_fields[ty]
            for i in 0..fields.len() {
                if i > 0 {
                    out.push(", ")
                }
                out.push(names.get(i) ?? "?")
                out.push(": ")
                show_into(p, fields[i], out)
            }
            out.push("}")
        }
        VVariant(ty, idx, fields) -> {
            out.push(p.ty_variants[ty].get(idx) ?? "?")
            if not fields.is_empty() {
                out.push("(")
                show_seq(p, fields, out)
                out.push(")")
            }
        }
        VFloat(f) -> out.push("{f}")
        VUnit -> out.push("()")
        VTuple(items) -> {
            out.push("(")
            show_seq(p, items, out)
            out.push(")")
        }
        VBytes(b) -> show_hex(b, out)
        VOk(x) -> {
            out.push("Ok(")
            show_into(p, x, out)
            out.push(")")
        }
        VErr(x) -> {
            out.push("Err(")
            show_into(p, x, out)
            out.push(")")
        }
        VMap(_, _, _, _, _) -> show_map(p, v, out)
        VRange(lo, hi, incl) -> {
            out.push("{lo}..")
            if incl {
                out.push("=")
            }
            out.push("{hi}")
        }
        VRef(slot, gen) -> out.push("ref#{slot}.{gen}")
        VClosure(_, _, _) -> out.push("<closure>")
        VFn(id) -> out.push("<fn {p.fn_name[id]}>")
        VU64(u) -> out.push("{u}")
        // A builder prints as the `str` or `bytes` it would become.
        VStrB(b) -> out.push(b.to_str())
        VByteB(b) -> show_hex(b.to_bytes(), out)
    }
}

/// Bytes as `print` writes them: `0x`, then two hex digits each.
fn show_hex(b: bytes, inout out: [str]) {
    out.push("0x")
    let digits = "0123456789abcdef"
    var hex: [str] = []
    for k in 0..b.len() {
        let x = b.at(k)
        hex.push(digits.substr(x.ushr(4), 1))
        hex.push(digits.substr(x.bit_and(15), 1))
    }
    out.push(hex.join(""))
}

/// `{k: v, ...}` in key order; a map holds keys of one type only.
fn show_map(p: Prog, m: Value, inout out: [str]) {
    out.push("\{")
    let keys = map_keys(m)
    let vals = map_values(m)
    for i in 0..keys.len() {
        if i > 0 {
            out.push(", ")
        }
        show_into(p, keys[i], out)
        out.push(": ")
        show_into(p, vals[i], out)
    }
    out.push("}")
}

/// A map's keys in [E-MAP-ORDER]: `false` before `true`, integers ascending
/// (a `u64` key unsigned), strings by code point.
pub fn map_keys(m: Value) -> [Value] {
    var out: [Value] = []
    match m {
        VMap(kb, ki, ks, ku, kt) -> {
            for k in kb.keys() {
                out.push(VBool(k))
            }
            for k in kt.keys() {
                out.push(pair_half(kt.get(k), 0))
            }
            for k in ki.keys() {
                out.push(VInt(k))
            }
            for k in ks.keys() {
                out.push(VStr(k))
            }
            for k in ku.keys() {
                out.push(VU64(k))
            }
        }
        _ -> ()
    }
    out
}

/// A map's values, in the order of its keys.
pub fn map_values(m: Value) -> [Value] {
    var out: [Value] = []
    match m {
        VMap(kb, ki, ks, ku, kt) -> {
            for k in kb.keys() {
                out.push(kb.get(k) ?? VUnit)
            }
            for k in kt.keys() {
                out.push(pair_half(kt.get(k), 1))
            }
            for k in ki.keys() {
                out.push(ki.get(k) ?? VUnit)
            }
            for k in ks.keys() {
                out.push(ks.get(k) ?? VUnit)
            }
            for k in ku.keys() {
                out.push(ku.get(k) ?? VUnit)
            }
        }
        _ -> ()
    }
    out
}

/// Half of a tuple-keyed entry, which is held as `(key, value)`.
pub fn pair_half(e: Option[Value], i: i64) -> Value {
    match e {
        Some(VTuple(kv)) -> kv[i]
        _ -> VUnit
    }
}

/// A tuple key as text ([T-MAP-KEY]), for the host map that holds them: the
/// text order is [E-MAP-ORDER]'s, component by component, and no two keys
/// share a text, because every component is fixed in width or ended. An
/// integer is sixteen hex digits with its sign bit flipped, so unsigned order
/// is signed order; a `u64` is its sixteen digits; a `bool` one digit; a
/// string six hex digits per character, its code point plus one, ended by six
/// zeros, which sort before any character -- so a string sorts before every
/// string it begins.
pub fn key_text(k: Value) -> str {
    var out: [str] = []
    key_text_into(k, out)
    out.join("")
}

fn key_text_into(k: Value, inout out: [str]) {
    match k {
        VInt(i) -> out.push(i.bit_xor(-9223372036854775808).as_u64().to_base(16).pad_start(16, "0"))
        VU64(u) -> out.push(u.to_base(16).pad_start(16, "0"))
        VBool(b) -> out.push(if b { "1" } else { "0" })
        VStr(s) -> {
            for c in s.codes() {
                out.push((c + 1).to_base(16).pad_start(6, "0"))
            }
            out.push("000000")
        }
        VTuple(items) -> {
            for x in items {
                key_text_into(x, out)
            }
        }
        _ -> ()
    }
}

// ----- equality ------------------------------------------------------------

/// Structural equality, `==` and `assert_eq` (`Value::eq_value`).
pub fn equal(a: Value, b: Value) -> bool {
    match a {
        VInt(x) -> match b {
            VInt(y) -> x == y
            VFloat(y) -> x.as_f64() == y
            _ -> false
        }
        VStr(x) -> match b {
            VStr(y) -> x == y
            _ -> false
        }
        VBool(x) -> match b {
            VBool(y) -> x == y
            _ -> false
        }
        VVariant(t1, i1, f1) -> match b {
            VVariant(t2, i2, f2) -> t1 == t2 and i1 == i2 and equal_seq(f1, f2)
            _ -> false
        }
        VList(x) -> match b {
            VList(y) -> equal_seq(x, y)
            _ -> false
        }
        VStruct(t1, f1) -> match b {
            VStruct(t2, f2) -> t1 == t2 and equal_seq(f1, f2)
            _ -> false
        }
        VFloat(x) -> match b {
            VFloat(y) -> x == y
            VInt(y) -> x == y.as_f64()
            _ -> false
        }
        VUnit -> match b {
            VUnit -> true
            _ -> false
        }
        VTuple(x) -> match b {
            VTuple(y) -> equal_seq(x, y)
            _ -> false
        }
        VBytes(x) -> match b {
            VBytes(y) -> x == y
            _ -> false
        }
        VOk(x) -> match b {
            VOk(y) -> equal(x, y)
            _ -> false
        }
        VErr(x) -> match b {
            VErr(y) -> equal(x, y)
            _ -> false
        }
        VMap(_, _, _, _, _) -> match b {
            VMap(_, _, _, _, _) -> equal_seq(map_keys(a), map_keys(b)) and equal_seq(map_values(a), map_values(b))
            _ -> false
        }
        VRange(a1, a2, a3) -> match b {
            VRange(b1, b2, b3) -> a1 == b1 and a2 == b2 and a3 == b3
            _ -> false
        }
        VRef(s1, g1) -> match b {
            VRef(s2, g2) -> s1 == s2 and g1 == g2
            _ -> false
        }
        VFn(x) -> match b {
            VFn(y) -> x == y
            _ -> false
        }
        VClosure(n1, s1, c1) -> match b {
            VClosure(n2, s2, c2) -> n1 == n2 and s1 == s2 and equal_seq(c1, c2)
            _ -> false
        }
        VU64(x) -> match b {
            VU64(y) -> x == y
            _ -> false
        }
        // Two builders are equal when their contents are.
        VStrB(x) -> match b {
            VStrB(y) -> x.to_str() == y.to_str()
            _ -> false
        }
        VByteB(x) -> match b {
            VByteB(y) -> x.to_bytes() == y.to_bytes()
            _ -> false
        }
    }
}

pub fn equal_seq(x: [Value], y: [Value]) -> bool {
    if x.len() != y.len() {
        return false
    }
    for i in 0..x.len() {
        if not equal(x[i], y[i]) {
            return false
        }
    }
    true
}

// ----- ordering -------------------------------------------------------------

/// `-1`, `0` or `1`: the order `sort`, `min`, `max` and `cmp` use
/// (`compare_values`). Floats by their total order, so `-NaN` sorts first,
/// `NaN` last and `-0.0` before `0.0`; anything unordered is equal.
pub fn compare(a: Value, b: Value) -> i64 {
    match a {
        VInt(x) -> match b {
            VInt(y) -> if x < y { -1 } else if x > y { 1 } else { 0 }
            _ -> 0
        }
        VStr(x) -> match b {
            VStr(y) -> if x < y { -1 } else if x > y { 1 } else { 0 }
            _ -> 0
        }
        VFloat(x) -> match b {
            VFloat(y) -> total_cmp(x, y)
            _ -> 0
        }
        VU64(x) -> match b {
            VU64(y) -> if x < y { -1 } else if x > y { 1 } else { 0 }
            _ -> 0
        }
        VTuple(xs) -> match b {
            VTuple(ys) -> {
                var i = 0
                while i < xs.len() and i < ys.len() {
                    let c = compare(xs[i], ys[i])
                    if c != 0 {
                        return c
                    }
                    i += 1
                }
                if xs.len() < ys.len() {
                    -1
                } else if xs.len() > ys.len() {
                    1
                } else {
                    0
                }
            }
            _ -> 0
        }
        _ -> 0
    }
}

/// `f64::total_cmp`: compare the bit patterns, with the negative half
/// flipped so it runs the other way.
fn total_cmp(x: f64, y: f64) -> i64 {
    var a = x.to_bits()
    var b = y.to_bits()
    a = a.bit_xor(a.shr(63).ushr(1))
    b = b.bit_xor(b.shr(63).ushr(1))
    if a < b {
        -1
    } else if a > b {
        1
    } else {
        0
    }
}

/// A stable merge sort by `compare` -- `sort` and `sort_by` keep the
/// written order of equal elements.
pub fn sort_values(xs: [Value]) -> [Value] {
    let n = xs.len()
    if n < 2 {
        return xs
    }
    var src = xs
    var dst = xs
    var width = 1
    while width < n {
        var lo = 0
        while lo < n {
            let mid = (lo + width).min(n)
            let hi = (lo + 2 * width).min(n)
            var i = lo
            var j = mid
            var k = lo
            while k < hi {
                if i < mid and (j >= hi or compare(src[j], src[i]) >= 0) {
                    dst[k] = src[i]
                    i += 1
                } else {
                    dst[k] = src[j]
                    j += 1
                }
                k += 1
            }
            lo = hi
        }
        let t = src
        src = dst
        dst = t
        width = width * 2
    }
    src
}

/// The permutation that sorts `keys` stably: `order[i]` is the index of the
/// element that belongs at `i`.
pub fn sort_order(keys: [Value]) -> [i64] {
    let n = keys.len()
    var src: [i64] = []
    for i in 0..n {
        src.push(i)
    }
    if n < 2 {
        return src
    }
    var dst = src
    var width = 1
    while width < n {
        var lo = 0
        while lo < n {
            let mid = (lo + width).min(n)
            let hi = (lo + 2 * width).min(n)
            var i = lo
            var j = mid
            var k = lo
            while k < hi {
                if i < mid and (j >= hi or compare(keys[src[j]], keys[src[i]]) >= 0) {
                    dst[k] = src[i]
                    i += 1
                } else {
                    dst[k] = src[j]
                    j += 1
                }
                k += 1
            }
            lo = hi
        }
        let t = src
        src = dst
        dst = t
        width = width * 2
    }
    src
}
