// The JSON the language server and the debug adapter speak, read and
// written as the Rust ones read and write it (`crates/grasm_lsp/src/json.rs`,
// the same in `crates/grasm_dap`; docs/self-hosting.md §6.22): an object's
// keys in byte order, a number a double -- an integral one written as an
// integer, saturating, any other as Rust's `{}` -- `\u` read four characters
// at a time with no surrogate pairs, every failure in the reader's own
// words, and anything after the first value ignored. Not `packages/json`,
// whose errors, numbers, order and escapes are its own.
//
// The reader works on the UTF-8 bytes and counts characters only for an
// error's offset, which the reference gives in characters.
import gfmt.fmt

type Json =
    | JNull
    | JBool(b: bool)
    | JNum(n: f64)
    | JStr(s: str)
    | JArr(items: [Json])
    | JObj(keys: [str], vals: [Json])

// ----- building -------------------------------------------------------------------

pub fn jstr(s: str) -> Json {
    JStr(s)
}

pub fn jint(n: i64) -> Json {
    JNum(n.as_f64())
}

/// An object from pairs, as `Json::obj` collects them into a `BTreeMap`:
/// sorted by key, a later pair replacing an earlier one of the same key.
pub fn obj(pairs: [(str, Json)]) -> Json {
    var keys: [str] = []
    var vals: [Json] = []
    for kv in pairs {
        let (k, v) = kv
        insert(keys, vals, k, v)
    }
    JObj(keys, vals)
}

fn insert(inout keys: [str], inout vals: [Json], k: str, v: Json) {
    // Where it goes: the first key not less than it, by bytes.
    var lo = 0
    var hi = keys.len()
    while lo < hi {
        let mid = (lo + hi) / 2
        if keys[mid] < k {
            lo = mid + 1
        } else {
            hi = mid
        }
    }
    if lo < keys.len() and keys[lo] == k {
        vals[lo] = v
        return
    }
    keys.push(k)
    vals.push(v)
    var j = keys.len() - 1
    while j > lo {
        keys[j] = keys[j - 1]
        vals[j] = vals[j - 1]
        j -= 1
    }
    keys[lo] = k
    vals[lo] = v
}

// ----- asking -----------------------------------------------------------------------

pub fn get(j: Json, key: str) -> Option[Json] {
    match j {
        JObj(keys, vals) -> {
            for i in 0..keys.len() {
                if keys[i] == key {
                    return Some(vals[i])
                }
            }
            None
        }
        _ -> None
    }
}

/// A dotted path: `params.textDocument.uri`.
pub fn path(j: Json, dotted: str) -> Option[Json] {
    var cur = j
    for part in dotted.split(".") {
        match get(cur, part) {
            Some(x) -> cur = x
            None -> return None
        }
    }
    Some(cur)
}

pub fn as_str(o: Option[Json]) -> Option[str] {
    match o {
        Some(j) -> match j {
            JStr(s) -> Some(s)
            _ -> None
        }
        None -> None
    }
}

/// `as_i64`: a number cut toward zero, saturating, NaN 0 (Rust's `as`).
pub fn as_int(o: Option[Json]) -> Option[i64] {
    match o {
        Some(j) -> match j {
            JNum(n) -> Some(to_i64(n))
            _ -> None
        }
        None -> None
    }
}

pub fn to_i64(n: f64) -> i64 {
    if n.is_nan() {
        return 0
    }
    if n >= 9223372036854775807.0 {
        return 9223372036854775807
    }
    if n <= -9223372036854775808.0 {
        return -9223372036854775807 - 1
    }
    n.as_i64()
}

// ----- writing ----------------------------------------------------------------------

pub fn to_text(j: Json) -> str {
    var out = str_builder()
    write(out, j)
    out.to_str()
}

fn write(inout out: StrBuilder, j: Json) {
    match j {
        JNull -> out.push_str("null")
        JBool(b) -> out.push_str(if b { "true" } else { "false" })
        JNum(n) -> {
            if n.is_finite() and n.floor() == n {
                out.push_str("{to_i64(n)}")
            } else {
                out.push_str(rust_float(n))
            }
        }
        JStr(s) -> escaped(out, s)
        JArr(items) -> {
            out.push_str("[")
            for i in 0..items.len() {
                if i > 0 {
                    out.push_str(",")
                }
                write(out, items[i])
            }
            out.push_str("]")
        }
        JObj(keys, vals) -> {
            out.push_str("\{")
            for i in 0..keys.len() {
                if i > 0 {
                    out.push_str(",")
                }
                escaped(out, keys[i])
                out.push_str(":")
                write(out, vals[i])
            }
            out.push_str("}")
        }
    }
}

/// Rust's `{}` of a double that is not integral: the language's text, which
/// is Rust's but for the `.0` it adds to an integral one.
pub fn rust_float(v: f64) -> str {
    let s = v.to_str()
    if s.ends_with(".0") {
        let b = s.to_bytes()
        return b.slice(0, b.len() - 2).to_str()
    }
    s
}

let HEX = "0123456789abcdef"

fn escaped(inout out: StrBuilder, s: str) {
    out.push_str("\"")
    let b = s.to_bytes()
    var start = 0
    for i in 0..b.len() {
        let c = b.at(i)
        if c == 34 or c == 92 or c < 32 {
            if i > start {
                out.push_str(b.slice(start, i).to_str())
            }
            start = i + 1
            if c == 34 {
                out.push_str("\\\"")
            } else if c == 92 {
                out.push_str("\\\\")
            } else if c == 10 {
                out.push_str("\\n")
            } else if c == 13 {
                out.push_str("\\r")
            } else if c == 9 {
                out.push_str("\\t")
            } else {
                let d = HEX.chars()
                out.push_str("\\u00" + d[c.ushr(4)] + d[c.bit_and(15)])
            }
        }
    }
    if b.len() > start {
        out.push_str(b.slice(start, b.len()).to_str())
    }
    out.push_str("\"")
}

// ----- reading ----------------------------------------------------------------------

type Rd = {
    b: bytes,
    i: i64,
}

/// The value at the start of `src` (`json::parse`); what follows it is not
/// looked at.
pub fn parse(src: str) -> Json ! str {
    var r = Rd{ b: src.to_bytes(), i: 0 }
    skip_ws(r)
    value(r)
}

/// How many characters come before byte `i`: the reference's offsets count
/// characters.
fn chars_before(b: bytes, i: i64) -> i64 {
    var n = 0
    for k in 0..i.min(b.len()) {
        let c = b.at(k)
        if c < 128 or c >= 192 {
            n += 1
        }
    }
    n
}

/// The bytes of the character at byte `i`.
fn char_len(b: bytes, i: i64) -> i64 {
    let c = b.at(i)
    if c < 128 {
        return 1
    }
    if c >= 240 {
        return 4
    }
    if c >= 224 {
        return 3
    }
    2
}

fn char_at(b: bytes, i: i64) -> str {
    b.slice(i, (i + char_len(b, i)).min(b.len())).to_str()
}

/// `{:?}` of the `Option<char>` at the reader: `None`, or `Some('c')` with
/// the character escaped as Rust's `char::escape_debug` escapes it.
fn peek_debug(r: Rd) -> str {
    if r.i >= r.b.len() {
        return "None"
    }
    let c = char_at(r.b, r.i)
    "Some('{char_debug(c)}')"
}

fn char_debug(c: str) -> str {
    if c == "\n" {
        return "\\n"
    }
    if c == "\r" {
        return "\\r"
    }
    if c == "\t" {
        return "\\t"
    }
    if c == "\\" {
        return "\\\\"
    }
    if c == "'" {
        return "\\'"
    }
    if c == "\0" {
        return "\\0"
    }
    let b = c.to_bytes()
    if b.len() == 1 and (b.at(0) < 32 or b.at(0) == 127) {
        return "\\u\{" + hex_of(b.at(0)) + "}"
    }
    c
}

fn hex_of(n: i64) -> str {
    let d = HEX.chars()
    if n < 16 {
        return d[n]
    }
    d[n.ushr(4)] + d[n.bit_and(15)]
}

/// The length of the Unicode whitespace character at `i`, or 0
/// (`char::is_whitespace`, gfmt's rule).
pub fn ws_len(b: bytes, i: i64, end: i64) -> i64 {
    fmt.ws_len(b, i, end)
}

fn skip_ws(inout r: Rd) {
    while r.i < r.b.len() {
        let n = fmt.ws_len(r.b, r.i, r.b.len())
        if n == 0 {
            return
        }
        r.i += n
    }
}

fn expect(inout r: Rd, c: i64, shown: str) -> () ! str {
    if r.i < r.b.len() and r.b.at(r.i) == c {
        r.i += 1
        return ()
    }
    fail("expected `{shown}` at offset {chars_before(r.b, r.i)}")
}

fn value(inout r: Rd) -> Json ! str {
    skip_ws(r)
    if r.i >= r.b.len() {
        fail("unexpected None at offset {chars_before(r.b, r.i)}")
    }
    let c = r.b.at(r.i)
    if c == 123 {
        return try object(r)
    }
    if c == 91 {
        return try array(r)
    }
    if c == 34 {
        return JStr(try string(r))
    }
    if c == 116 {
        try literal(r, "true")
        return JBool(true)
    }
    if c == 102 {
        try literal(r, "false")
        return JBool(false)
    }
    if c == 110 {
        try literal(r, "null")
        return JNull
    }
    if c == 45 or (c >= 48 and c <= 57) {
        return try number(r)
    }
    fail("unexpected {peek_debug(r)} at offset {chars_before(r.b, r.i)}")
}

fn literal(inout r: Rd, word: str) -> () ! str {
    let w = word.to_bytes()
    for k in 0..w.len() {
        try expect(r, w.at(k), word.chars()[k])
    }
    ()
}

fn number(inout r: Rd) -> Json ! str {
    let start = r.i
    if r.b.at(r.i) == 45 {
        r.i += 1
    }
    while r.i < r.b.len() {
        let c = r.b.at(r.i)
        if (c >= 48 and c <= 57) or c == 46 or c == 101 or c == 69 or c == 43 or c == 45 {
            r.i += 1
        } else {
            break
        }
    }
    let text = r.b.slice(start, r.i).to_str()
    match text.parse_float() {
        Some(v) -> JNum(v)
        None -> fail("bad number `{text}`: invalid float literal")
    }
}

fn string(inout r: Rd) -> str ! str {
    try expect(r, 34, "\"")
    var out = byte_builder()
    while true {
        if r.i >= r.b.len() {
            fail("unterminated string")
        }
        let c = r.b.at(r.i)
        if c == 34 {
            r.i += 1
            return out.to_bytes().to_str()
        }
        if c != 92 {
            out.push_byte(c)
            r.i += 1
            continue
        }
        r.i += 1
        if r.i >= r.b.len() {
            fail("truncated escape")
        }
        let e = r.b.at(r.i)
        let elen = char_len(r.b, r.i)
        r.i += elen
        if e == 110 {
            out.push_byte(10)
        } else if e == 116 {
            out.push_byte(9)
        } else if e == 114 {
            out.push_byte(13)
        } else if e == 98 {
            out.push_byte(8)
        } else if e == 102 {
            out.push_byte(12)
        } else if e == 34 or e == 92 or e == 47 {
            out.push_byte(e)
        } else if e == 117 {
            // Four characters, whatever they are, as many as there are.
            var hex = byte_builder()
            var k = 0
            while k < 4 and r.i < r.b.len() {
                let n = char_len(r.b, r.i)
                hex.push_bytes(r.b.slice(r.i, (r.i + n).min(r.b.len())))
                r.i += n
                k += 1
            }
            // The reference steps over four characters even past the end,
            // which leaves it at the end.
            let code = try hex_value(hex.to_bytes())
            out.push_bytes(utf8_of(code))
        } else {
            fail("unknown escape \\{char_at(r.b, r.i - elen)}")
        }
    }
    ""
}

/// `u32::from_str_radix(s, 16)`, in its words.
fn hex_value(s: bytes) -> i64 ! str {
    var i = 0
    if s.len() == 0 {
        fail("bad \\u escape: cannot parse integer from empty string")
    }
    if s.at(0) == 43 {
        i = 1
        if s.len() == 1 {
            fail("bad \\u escape: invalid digit found in string")
        }
    }
    var v = 0
    while i < s.len() {
        let c = s.at(i)
        var d = -1
        if c >= 48 and c <= 57 {
            d = c - 48
        } else if c >= 97 and c <= 102 {
            d = c - 87
        } else if c >= 65 and c <= 70 {
            d = c - 55
        }
        if d < 0 {
            fail("bad \\u escape: invalid digit found in string")
        }
        v = v * 16 + d
        i += 1
    }
    v
}

/// The UTF-8 of code point `n`, or of U+FFFD for a surrogate
/// (`char::from_u32(..).unwrap_or('\u{fffd}')`).
fn utf8_of(n: i64) -> bytes {
    var c = n
    if c >= 55296 and c <= 57343 {
        c = 65533
    }
    var b = byte_builder()
    if c < 128 {
        b.push_byte(c)
    } else if c < 2048 {
        b.push_byte(192 + c.ushr(6))
        b.push_byte(128 + c.bit_and(63))
    } else {
        b.push_byte(224 + c.ushr(12))
        b.push_byte(128 + c.ushr(6).bit_and(63))
        b.push_byte(128 + c.bit_and(63))
    }
    b.to_bytes()
}

fn array(inout r: Rd) -> Json ! str {
    try expect(r, 91, "[")
    var items: [Json] = []
    skip_ws(r)
    if r.i < r.b.len() and r.b.at(r.i) == 93 {
        r.i += 1
        return JArr(items)
    }
    while true {
        items.push(try value(r))
        skip_ws(r)
        if r.i < r.b.len() and r.b.at(r.i) == 44 {
            r.i += 1
        } else if r.i < r.b.len() and r.b.at(r.i) == 93 {
            r.i += 1
            return JArr(items)
        } else {
            fail("expected `,` or `]`, got {peek_debug(r)}")
        }
    }
    JNull
}

fn object(inout r: Rd) -> Json ! str {
    try expect(r, 123, "\{")
    var keys: [str] = []
    var vals: [Json] = []
    skip_ws(r)
    if r.i < r.b.len() and r.b.at(r.i) == 125 {
        r.i += 1
        return JObj(keys, vals)
    }
    while true {
        skip_ws(r)
        let key = try string(r)
        skip_ws(r)
        try expect(r, 58, ":")
        let v = try value(r)
        insert(keys, vals, key, v)
        skip_ws(r)
        if r.i < r.b.len() and r.b.at(r.i) == 44 {
            r.i += 1
        } else if r.i < r.b.len() and r.b.at(r.i) == 125 {
            r.i += 1
            return JObj(keys, vals)
        } else {
            fail("expected `,` or `}`, got {peek_debug(r)}")
        }
    }
    JNull
}
