// `gfmt` -- the formatter, written in Grasm.
//
//     gfmt <in.gr> <out.gr>
//
// The formatter itself is `fmt.gr`, the Rust formatter
// (`crates/grasm_syntax/src/fmt.rs`) ported line for line; the `grasm`
// command in Grasm runs it for `grasm fmt` (docs/self-hosting.md §6.19).
// This program writes what it makes of one file to another, which is what
// `scripts/gfmttest.sh` holds to `grasm fmt` over the corpus.
import fmt

fn main() {
    // An output path rather than stdout: `print` appends a newline, and a
    // formatter that cannot reproduce a file byte for byte is not one.
    let a = args()
    if a.len() < 2 {
        print("usage: gfmt <in.gr> <out.gr>")
        return
    }
    let inp = a.get(0).unwrap_or("")
    let outp = a.get(1).unwrap_or("")
    match read_file(inp) {
        Ok(src) -> {
            match write_file(outp, fmt.format_src(src)) {
                Ok(_) -> {}
                Err(e) -> print("gfmt: cannot write {outp}: {e}")
            }
        }
        Err(e) -> print("gfmt: cannot read {inp}: {e}")
    }
}
