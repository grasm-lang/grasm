// `wasmsubset`'s stack (docs/self-hosting.md §6.26): a recursion inside a
// `parallel` block's `spawn`, which on wasm runs on the calling engine stack.
fn depth(n: i64) -> i64 {
    if n == 0 {
        return 0
    }
    1 + depth(n - 1)
}

fn main() {
    let n = args()[0].parse_int() ?? 10
    var out: [i64] = []
    parallel {
        spawn {
            out.push(depth(n))
        }
    }
    print("{out[0]}")
}
