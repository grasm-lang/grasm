//! rtlint: caller: `bad_caller::set_locked` holds `bad_caller::LOCK`, and `bad_caller::careless` neither holds nor takes it
// A function marked as holding a lock, called by one that never took it.
process_local LOCK: i64

/// rtlint: guarded by LOCK
process_local TOTAL: i64

/// rtlint: holds LOCK
fn set_locked(v: i64) {
    unsafe {
        mem_process(TOTAL).store_i64(v)
    }
}

pub fn careless(v: i64) {
    set_locked(v)
}
