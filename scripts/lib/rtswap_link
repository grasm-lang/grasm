#!/usr/bin/env bash
# The linker the S5 gates hand `grasm build --native` (GRASM_LINKER;
# scripts/lib/rtswap.sh). It links what the build gives it as given -- the
# program as it ships, with the Rust runtime archive -- and again with the
# Grasm runtime alone in the archive's place (`compiler/link -interpose`,
# with no archive on the line: every `_grasm_<name>` the program names binds
# to the Grasm runtime's `_grt_<name>`), into `<out>.swap`, writing what that
# link bound to `<out>.swaplog` (docs/self-hosting.md §6.7, §6.12). When
# RTSWAP_POISON names a poisoned Rust runtime, both are linked against the
# poisoned builds too: the Rust one into `<out>.poison`, the Grasm one
# (RTSWAP_RT_POISON) into `<out>.swap.poison`.
#
#   RTSWAP_LINK       the linker (compiler/link)
#   RTSWAP_RT         the Grasm runtime's object
#   RTSWAP_RT_POISON  its poisoned build
#   RTSWAP_POISON     optional: a Rust runtime archive built with grasm_rt/poison
#   RTSWAP_ONLY       =1: link only with the Grasm runtime, into `<out>`
#                     itself, so whatever runs the output runs that
#                     (`scripts/rtwith.sh`), writing what it bound to
#                     RTSWAP_LOG if that is set
set -u

# The link line without the Rust runtime archive, its output renamed to $1
# and, if $2 is given, the archive replaced by $2 rather than dropped; into
# the array LINE. A line with no archive on it is left whole: the build that
# made it does not link a runtime.
line() {
    local to=$1 rt=$2 a p=""
    LINE=()
    for a in "${@:3}"; do
        if [ "$p" = "-o" ] && [ -n "$to" ]; then
            a=$to
        elif [ "${a##*/}" = libgrasm_rt_abi.a ]; then
            if [ -n "$rt" ]; then
                LINE+=("$rt")
            fi
            p=$a
            continue
        fi
        LINE+=("$a")
        p=$a
    done
}

if [ "${RTSWAP_ONLY:-}" = 1 ]; then
    line "" "" "$@"
    if [ -n "${RTSWAP_LOG:-}" ]; then
        exec "$RTSWAP_LINK" -interpose "$RTSWAP_RT" -interpose_log "$RTSWAP_LOG" "${LINE[@]}"
    fi
    exec "$RTSWAP_LINK" -interpose "$RTSWAP_RT" "${LINE[@]}"
fi
out=""
prev=""
for a in "$@"; do
    if [ "$prev" = "-o" ]; then
        out=$a
    fi
    prev=$a
done
if [ -z "$out" ]; then
    echo "rtswap_link: no -o in the link line" >&2
    exit 2
fi

"$RTSWAP_LINK" "$@" || exit $?
line "$out.swap" "" "$@"
"$RTSWAP_LINK" -interpose "$RTSWAP_RT" -interpose_log "$out.swaplog" "${LINE[@]}" || exit $?
if [ -n "${RTSWAP_POISON:-}" ]; then
    line "$out.poison" "$RTSWAP_POISON" "$@"
    "$RTSWAP_LINK" "${LINE[@]}" || exit $?
    line "$out.swap.poison" "" "$@"
    "$RTSWAP_LINK" -interpose "$RTSWAP_RT_POISON" "${LINE[@]}" || exit $?
fi
