// Rust's `Debug` and `Display`, as far as the Rust frontend's dumps use
// them: `grasm tokens` prints a token with `{:?}`, `grasm ast` prints the
// whole tree that way, and a diagnostic names a float with `{}`. The Grasm
// frontend is held to those dumps byte for byte, so it writes what Rust
// writes -- a string's escapes, a float's digits and when they turn
// exponential.

/// The code points `{:?}` of a string writes as `\u{...}`, as sorted ranges.
/// Built once, by `new_esc_table`, and handed to whatever prints.
type EscTable = { lo: [i64], hi: [i64] }

fn hex_value(s: str) -> i64 {
    var v = 0
    let b = s.to_bytes()
    for k in 0..b.len() {
        let c = b.at(k)
        if c >= 48 and c <= 57 {
            v = v * 16 + (c - 48)
        } else if c >= 97 and c <= 102 {
            v = v * 16 + (c - 87)
        }
    }
    v
}

pub fn new_esc_table() -> EscTable {
    var t = EscTable{ lo: [], hi: [] }
    for r in escaped_packed().split(",") {
        let ab = r.split("-")
        t.lo.push(hex_value(ab[0]))
        t.hi.push(hex_value(ab[1]))
    }
    t
}

/// Whether `{:?}` escapes the code point `cp`.
pub fn is_escaped(t: EscTable, cp: i64) -> bool {
    var a = 0
    var b = t.lo.len()
    while a < b {
        let m = (a + b) / 2
        if t.hi[m] < cp {
            a = m + 1
        } else {
            b = m
        }
    }
    a < t.lo.len() and t.lo[a] <= cp
}

fn push_hex_escape(inout out: ByteBuilder, cp: i64) {
    out.push_str("\\u\{")
    out.push_str(cp.to_base(16))
    out.push_str("}")
}

/// Appends `s` as Rust's `{:?}` of a `str` writes it, quotes included.
pub fn push_str_debug(inout out: ByteBuilder, t: EscTable, s: str) {
    out.push_byte(34)
    let b = s.to_bytes()
    let n = b.len()
    var i = 0
    while i < n {
        let c = b.at(i)
        if c < 128 {
            if c == 0 {
                out.push_str("\\0")
            } else if c == 9 {
                out.push_str("\\t")
            } else if c == 13 {
                out.push_str("\\r")
            } else if c == 10 {
                out.push_str("\\n")
            } else if c == 92 {
                out.push_str("\\\\")
            } else if c == 34 {
                out.push_str("\\\"")
            } else if c < 32 or c == 127 {
                push_hex_escape(out, c)
            } else {
                out.push_byte(c)
            }
            i += 1
        } else {
            var len = 4
            var cp = c.bit_and(7)
            if c < 224 {
                len = 2
                cp = c.bit_and(31)
            } else if c < 240 {
                len = 3
                cp = c.bit_and(15)
            }
            var k = 1
            while k < len and i + k < n {
                cp = cp * 64 + b.at(i + k).bit_and(63)
                k += 1
            }
            if is_escaped(t, cp) {
                push_hex_escape(out, cp)
            } else {
                out.push_bytes(b.slice(i, (i + len).min(n)))
            }
            i += len
        }
    }
    out.push_byte(34)
}

pub fn str_debug(t: EscTable, s: str) -> str {
    var out = byte_builder()
    push_str_debug(out, t, s)
    out.to_str()
}

/// Rust's `{:?}` of an `f64`: the shortest digits that read back, written
/// out with at least one digit after the point -- except below 1e-4 and from
/// 1e16 up, where it turns exponential (`1e16`, `1.5e-7`).
pub fn f64_debug(v: f64) -> str {
    if v.is_nan() {
        return "NaN"
    }
    if not v.is_finite() {
        if v > 0.0 {
            return "inf"
        }
        return "-inf"
    }
    // [L-DISPLAY]: the same shortest digits, positional, always a point.
    let s = v.to_str()
    let a = v.abs()
    if a == 0.0 or (a >= 0.0001 and a < 10000000000000000.0) {
        return s
    }
    var body = s
    var sign = ""
    if s.starts_with("-") {
        sign = "-"
        body = s.substr(1, s.len() - 1)
    }
    let parts = body.split(".")
    let ip = parts[0]
    var fp = ""
    if parts.len() > 1 {
        fp = parts[1]
    }
    let all = (ip + fp).to_bytes()
    var s0 = 0
    while s0 < all.len() and all.at(s0) == 48 {
        s0 += 1
    }
    var e1 = all.len()
    while e1 > s0 + 1 and all.at(e1 - 1) == 48 {
        e1 -= 1
    }
    let exp = ip.len() - 1 - s0
    let digits = all.slice(s0, e1).to_str()
    var out = sign + digits.substr(0, 1)
    if digits.len() > 1 {
        out = out + "." + digits.substr(1, digits.len() - 1)
    }
    out + "e" + exp.to_str()
}

/// Rust's `{}` of an `f64`: positional, and no `.0` on a whole number.
pub fn f64_display(v: f64) -> str {
    let s = v.to_str()
    if s.ends_with(".0") {
        return s.substr(0, s.len() - 2)
    }
    s
}

/// An `i64` holding a `u64`'s bits, written as the `u64`.
pub fn u64_display(bits: i64) -> str {
    bits.as_u64().to_str()
}

