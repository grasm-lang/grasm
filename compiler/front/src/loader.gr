// The loader (crates/grasm_sema/src/loader.rs, and the package resolution
// `grasm` runs before it): from an entry file, every module it imports, with
// the names, aliases, paths and span bases the Rust loader gives them.
//
// `import utils` loads `utils.gr` beside the importing file; `import lib.math`
// loads `lib/math.gr`; a name a package's manifest declares as a dependency
// loads that package's entry file, and a module inside a package resolves its
// imports inside that package. Modules are taken from a stack -- the last
// import written is loaded first -- and each file's spans start where the
// previous file's ended, plus one.
//
// Manifests are read twice over, as the Rust toolchain reads them: the
// package graph through the Rust toolchain's own TOML reader (rtoml.gr; the
// root's manifest checked as `grasm_pkg::Manifest` checks it, then every
// path dependency), and the loader's own questions -- a package's
// dependencies and their paths, its entry file, whether it is a runtime
// package -- line by line, as loader.rs asks them.
import lex
import parse
import cst
import ast
import rtoml

let MAX_PACKAGE_DEPTH = 64

/// Everything loading produced.
type Loaded = {
    names: [str],
    aliases: [str],
    paths: [str],
    srcs: [bytes],
    bases: [i64],
    imp_alias: [[str]],
    imp_full: [[str]],
    mods: [ModuleAst],
    /// The loader's diagnostics and the parser's, as messages, with their
    /// spans in the program's offsets and their help ("" for none).
    diags: [str],
    d_s: [i64],
    d_e: [i64],
    d_help: [str],
    /// Module name -> runtime package name ([T-RUNTIME]).
    runtime: Map[str, str],
    /// Module-name prefixes that are dependency packages.
    deps: [str],
    /// A failure before any module was read ("error: ..."), or "".
    fatal: str,
}

// ---------------------------------------------------------------------
// Paths, as std::path treats the relative paths the loader builds
// ---------------------------------------------------------------------

/// `Path::parent`: everything before the last component, or None (as "\0")
/// for a path with no parent.
pub fn parent(p: str) -> str {
    if p == "" or p == "/" {
        return "\0"
    }
    var q = p
    while q.len() > 1 and q.ends_with("/") {
        q = q.substr(0, q.len() - 1)
    }
    match last_slash(q) {
        Some(i) -> {
            if i == 0 {
                return "/"
            }
            var r = q.substr(0, i)
            while r.len() > 1 and r.ends_with("/") {
                r = r.substr(0, r.len() - 1)
            }
            r
        }
        None -> ""
    }
}

fn last_slash(s: str) -> Option[i64] {
    let b = s.to_bytes()
    var i = b.len() - 1
    while i >= 0 {
        if b.at(i) == 47 {
            return Some(i)
        }
        i -= 1
    }
    None
}

/// `Path::join`.
pub fn join(dir: str, rel: str) -> str {
    if rel.starts_with("/") or dir == "" {
        return rel
    }
    if dir.ends_with("/") {
        return dir + rel
    }
    dir + "/" + rel
}

/// `Path::file_stem` of the last component.
fn file_stem(p: str) -> str {
    var name = p
    match last_slash(p) {
        Some(i) -> name = p.substr(i + 1, p.len() - i - 1)
        None -> ()
    }
    let b = name.to_bytes()
    var i = b.len() - 1
    while i > 0 {
        if b.at(i) == 46 {
            return name.substr(0, i)
        }
        i -= 1
    }
    name
}

/// loader.rs `tidy`: `.` dropped and `..` collapsed lexically.
pub fn tidy(path: str) -> str {
    var parts: [str] = []
    if path.starts_with("/") {
        parts.push("/")
    }
    for seg in path.split("/") {
        if seg == "" or seg == "." {
            continue
        }
        if seg == ".." {
            let n = parts.len()
            if n > 0 and parts[n - 1] == "/" {
                continue
            }
            if n > 0 and parts[n - 1] != ".." {
                parts.pop()
                continue
            }
        }
        parts.push(seg)
    }
    if parts.len() == 0 {
        return path
    }
    if parts[0] == "/" {
        return "/" + parts.slice(1, parts.len()).join("/")
    }
    parts.join("/")
}

// `std::fs::canonicalize` is `realpath(3)`. The resolved name is written
// into a buffer of `PATH_MAX` bytes the call is handed.
extern fn realpath(path: str, resolved: bytes) -> i64

/// `std::fs::canonicalize`: the path's absolute name with every symbolic
/// link, `.` and `..` resolved, as the file system answers it; "\0" when it
/// cannot be (the path does not exist).
pub fn canonicalize(p: str) -> str {
    if p.contains("\0") {
        return "\0"
    }
    let buf = bytes_filled(1024, 0)
    let rc = unsafe { realpath(p, buf) }
    if rc == 0 {
        return "\0"
    }
    var n = 0
    while n < buf.len() and buf.at(n) != 0 {
        n += 1
    }
    buf.slice(0, n).to_str()
}

/// loader.rs `real_dir`, grasm_pkg `canonical`: the canonical path, or the
/// path as written when there is none.
pub fn real_dir(d: str) -> str {
    let c = canonicalize(d)
    if c == "\0" {
        return d
    }
    c
}

/// grasm `same_dir`: one directory, by the file system when both exist,
/// else by their components.
pub fn same_dir(a: str, b: str) -> bool {
    let x = canonicalize(a)
    let y = canonicalize(b)
    if x != "\0" and y != "\0" {
        return x == y
    }
    components(a) == components(b)
}

/// `Path::components`, as text: `.` inside a path and repeated `/` dropped.
fn components(p: str) -> [str] {
    var out: [str] = []
    let segs = p.split("/")
    for i in 0..segs.len() {
        let s = segs[i]
        if s == "" {
            if i == 0 and p.starts_with("/") {
                out.push("/")
            }
            continue
        }
        if s == "." and not (i == 0 and out.len() == 0) {
            continue
        }
        out.push(s)
    }
    out
}

fn dotted_to_path(name: str) -> str {
    name.replace(".", "/")
}

fn first_seg(name: str) -> str {
    match name.index_of(".") {
        Some(i) -> name.substr(0, i)
        None -> name
    }
}

fn after_first_seg(name: str) -> str {
    match name.index_of(".") {
        Some(i) -> name.substr(i + 1, name.len() - i - 1)
        None -> ""
    }
}

fn last_seg(name: str) -> str {
    let parts = name.split(".")
    parts[parts.len() - 1]
}

fn read_text(path: str) -> Option[str] {
    match read_bytes(path) {
        Ok(b) -> {
            if utf8_ok(b) {
                Some(b.to_str())
            } else {
                None
            }
        }
        Err(_) -> None
    }
}

/// Whether `b` is UTF-8 as Rust's `str::from_utf8` accepts it.
pub fn utf8_ok(b: bytes) -> bool {
    let n = b.len()
    var i = 0
    while i < n {
        let c = b.at(i)
        if c < 128 {
            i += 1
            continue
        }
        var len = 0
        var lo = 128
        var hi = 191
        if c >= 194 and c <= 223 {
            len = 2
        } else if c >= 224 and c <= 239 {
            len = 3
            if c == 224 {
                lo = 160
            } else if c == 237 {
                hi = 159
            }
        } else if c >= 240 and c <= 244 {
            len = 4
            if c == 240 {
                lo = 144
            } else if c == 244 {
                hi = 143
            }
        } else {
            return false
        }
        if i + len > n {
            return false
        }
        let c1 = b.at(i + 1)
        if c1 < lo or c1 > hi {
            return false
        }
        for k in 2..len {
            let ck = b.at(i + k)
            if ck < 128 or ck > 191 {
                return false
            }
        }
        i += len
    }
    true
}

// ---------------------------------------------------------------------
// Manifests, line by line, as loader.rs reads them
// ---------------------------------------------------------------------

/// The text before the first `#`, trimmed.
fn uncomment(raw: str) -> str {
    match raw.index_of("#") {
        Some(i) -> raw.substr(0, i).trim()
        None -> raw.trim()
    }
}

fn split_eq(line: str) -> Option[(str, str)] {
    match line.index_of("=") {
        Some(i) -> Some((line.substr(0, i), line.substr(i + 1, line.len() - i - 1)))
        None -> None
    }
}

/// `trim_matches('"')`.
fn trim_quotes(s: str) -> str {
    var a = 0
    var b = s.len()
    let bs = s.to_bytes()
    while a < b and bs.at(a) == 34 {
        a += 1
    }
    while b > a and bs.at(b - 1) == 34 {
        b -= 1
    }
    bs.slice(a, b).to_str()
}

/// `trim_end_matches(']')`.
fn trim_end_brackets(s: str) -> str {
    var b = s.len()
    let bs = s.to_bytes()
    while b > 0 and bs.at(b - 1) == 93 {
        b -= 1
    }
    bs.slice(0, b).to_str()
}

fn manifest_text(dir: str) -> Option[str] {
    let p = join(dir, "grasm.toml")
    if not file_exists(p) {
        return None
    }
    read_text(p)
}

/// The directory holding the nearest `grasm.toml` at or above `dir`, and
/// its text; ("\0", "") when there is none.
fn find_manifest(dir: str) -> (str, str) {
    var here = dir
    while here != "\0" {
        match manifest_text(here) {
            Some(text) -> return (here, text)
            None -> ()
        }
        here = parent(here)
    }
    ("\0", "")
}

/// A package's dependencies that have a path: name -> directory.
fn package_dependencies(dir: str) -> Map[str, str] {
    var out: Map[str, str] = map()
    let (root, text) = find_manifest(dir)
    if root == "\0" {
        return out
    }
    var current = "\0"
    for raw in text.lines() {
        let line = uncomment(raw)
        if line.starts_with("[") {
            let name = trim_end_brackets(line.substr(1, line.len() - 1)).trim()
            if name.starts_with("dependencies.") {
                current = name.substr(13, name.len() - 13).trim()
            } else {
                current = "\0"
            }
            continue
        }
        if current == "\0" {
            continue
        }
        match split_eq(line) {
            Some((k, v)) -> {
                if k.trim() == "path" {
                    out.set(current, join(root, trim_quotes(v.trim())))
                }
            }
            None -> ()
        }
    }
    out
}

/// Every dependency name a package declares, path or not, in order.
fn dependency_names(dir: str) -> [str] {
    var out: [str] = []
    let (root, text) = find_manifest(dir)
    if root == "\0" {
        return out
    }
    for raw in text.lines() {
        let line = uncomment(raw)
        if line.starts_with("[") {
            let name = trim_end_brackets(line.substr(1, line.len() - 1)).trim()
            if name.starts_with("dependencies.") {
                out.push(name.substr(13, name.len() - 13).trim())
            }
        }
    }
    out
}

/// The package holding `dir`, if its `[package]` says `runtime = true`;
/// "\0" otherwise.
fn runtime_package(dir: str) -> str {
    let (root, text) = find_manifest(dir)
    if root == "\0" {
        return "\0"
    }
    var in_package = false
    var name = ""
    var runtime = false
    for raw in text.lines() {
        let line = uncomment(raw)
        if line.starts_with("[") {
            in_package = trim_end_brackets(line.substr(1, line.len() - 1)).trim() == "package"
            continue
        }
        if in_package {
            match split_eq(line) {
                Some((k, v)) -> {
                    let key = k.trim()
                    if key == "runtime" {
                        runtime = v.trim() == "true"
                    } else if key == "name" {
                        name = trim_quotes(v.trim())
                    }
                }
                None -> ()
            }
        }
    }
    if runtime {
        name
    } else {
        "\0"
    }
}

/// A package's entry file: its declared `entry`, or `src/main.gr`.
fn package_entry(dir: str) -> str {
    var entry = "src/main.gr"
    match manifest_text(dir) {
        Some(text) -> {
            for raw in text.lines() {
                let l = uncomment(raw)
                match split_eq(l) {
                    Some((k, v)) -> {
                        if k.trim() == "entry" {
                            entry = trim_quotes(v.trim())
                            break
                        }
                    }
                    None -> ()
                }
            }
        }
        None -> ()
    }
    if entry.starts_with("/") or has_parent_component(entry) {
        return join(dir, "src/main.gr")
    }
    join(dir, entry)
}

fn has_parent_component(p: str) -> bool {
    for seg in p.split("/") {
        if seg == ".." {
            return true
        }
    }
    false
}

/// A module path inside a package, following that package's own
/// dependencies; "\0" when there is none.
fn resolve_in_package(pkg_dir: str, rest: str, depth: i64) -> str {
    let entry = package_entry(pkg_dir)
    if rest == "" {
        return entry
    }
    if depth > MAX_PACKAGE_DEPTH {
        return "\0"
    }
    let src_dir = parent(entry)
    if src_dir == "\0" {
        return "\0"
    }
    let direct = join(src_dir, dotted_to_path(rest) + ".gr")
    if file_exists(direct) {
        return direct
    }
    let head = first_seg(rest)
    let tail = after_first_seg(rest)
    match package_dependencies(src_dir).get(head) {
        Some(d) -> return resolve_in_package(d, tail, depth + 1)
        None -> ()
    }
    direct
}

/// Every package reachable from `dir`, named by the prefix its modules
/// carry, best first by (length, prefix) so each is reached first by its
/// shortest name. Returns whether the walk stopped at the depth backstop.
fn collect_packages(prefix: str, dir: str, resolved: Map[str, str], inout out: Map[str, str], inout out_keys: [str], depth: i64) -> bool {
    var expanded: Map[str, bool] = map()
    var truncated = false
    // The queue, kept sorted by (length, prefix, dir, depth).
    var q_len: [i64] = [prefix.len()]
    var q_pre: [str] = [prefix]
    var q_dir: [str] = [dir]
    var q_dep: [i64] = [depth]
    while q_len.len() > 0 {
        // Take the least.
        var best = 0
        for i in 1..q_len.len() {
            if queue_less(q_len[i], q_pre[i], q_dir[i], q_dep[i], q_len[best], q_pre[best], q_dir[best], q_dep[best]) {
                best = i
            }
        }
        let pre = q_pre[best]
        let d = q_dir[best]
        let dep = q_dep[best]
        q_len.remove(best)
        q_pre.remove(best)
        q_dir.remove(best)
        q_dep.remove(best)
        if dep > MAX_PACKAGE_DEPTH {
            truncated = true
            continue
        }
        if out.has(pre) {
            continue
        }
        out.set(pre, d)
        out_keys.push(pre)
        let rd = real_dir(d)
        if expanded.has(rd) {
            continue
        }
        expanded.set(rd, true)
        var src_dir = parent(package_entry(d))
        if src_dir == "\0" {
            src_dir = d
        }
        var subs = package_dependencies(src_dir)
        for name in dependency_names(src_dir) {
            if not subs.has(name) {
                match resolved.get(name) {
                    Some(rd2) -> subs.set(name, rd2)
                    None -> ()
                }
            }
        }
        for name in subs.keys() {
            let child = pre + "." + name
            let sub = subs.get(name) ?? ""
            // A BTreeSet: an equal element already queued is not added twice.
            var dup = false
            for i in 0..q_pre.len() {
                if q_pre[i] == child and q_dir[i] == sub and q_dep[i] == dep + 1 {
                    dup = true
                }
            }
            if not dup {
                q_len.push(child.len())
                q_pre.push(child)
                q_dir.push(sub)
                q_dep.push(dep + 1)
            }
        }
    }
    truncated
}

fn queue_less(l1: i64, p1: str, d1: str, e1: i64, l2: i64, p2: str, d2: str, e2: i64) -> bool {
    if l1 != l2 {
        return l1 < l2
    }
    if p1 != p2 {
        return p1 < p2
    }
    if d1 != d2 {
        return d1 < d2
    }
    e1 < e2
}

/// The longest prefix in `keys` that `name` is or is under, or "\0".
fn longest_prefix(keys: [str], name: str) -> str {
    var best = "\0"
    for p in keys {
        if name == p or name.starts_with(p + ".") {
            if best == "\0" or p.len() > best.len() {
                best = p
            }
        }
    }
    best
}

// ---------------------------------------------------------------------
// The package graph, as `grasm` resolves it before loading
// (crates/grasm/src/main.rs `registry_packages`, grasm_pkg `resolve`)
// ---------------------------------------------------------------------

/// A manifest as grasm_pkg reads it: its package name, its dependencies
/// (sorted by name) with their paths ("\0" for none) and version
/// requirements ("\0" for none), and its version; or why it is refused.
type Manifest = {
    ok: bool,
    why: str,
    name: str,
    version: str,
    dep_names: [str],
    dep_paths: [str],
    dep_reqs: [str],
    /// The capability ceiling, when the manifest declares one.
    has_caps: bool,
    caps: [str],
    entry: str,
}

fn bad_manifest(why: str) -> Manifest {
    Manifest{ ok: false, why: why, name: "", version: "", dep_names: [], dep_paths: [], dep_reqs: [], has_caps: false, caps: [], entry: "" }
}

/// `Version::parse`: three parts, each a `u64` as Rust parses one (an
/// optional `+`, then digits), normalized as it displays them; none when it
/// is not a version.
fn version_parts(v: str) -> [str] {
    let parts = v.split(".")
    if parts.len() != 3 {
        return []
    }
    var out: [str] = []
    for p0 in parts {
        var p = p0
        if p.starts_with("+") {
            p = p.substr(1, p.len() - 1)
        }
        if p == "" {
            return []
        }
        for c in p.chars() {
            if c < "0" or c > "9" {
                return []
            }
        }
        while p.len() > 1 and p.starts_with("0") {
            p = p.substr(1, p.len() - 1)
        }
        if p.len() > 20 or (p.len() == 20 and p > "18446744073709551615") {
            return []
        }
        out.push(p)
    }
    out
}

fn version_ok(v: str) -> bool {
    version_parts(v).len() == 3
}

/// A version as Rust displays it: `1.2.3`.
fn version_shown(v: str) -> str {
    version_parts(v).join(".")
}

fn version_err(v: str) -> str {
    "version `{v}` is not `MAJOR.MINOR.PATCH` (e.g. `0.1.0`)"
}

/// Two normalized numbers compared as numbers.
fn num_less(a: str, b: str) -> bool {
    if a.len() != b.len() {
        return a.len() < b.len()
    }
    a < b
}

fn version_less(a: str, b: str) -> bool {
    let x = version_parts(a)
    let y = version_parts(b)
    for i in 0..3 {
        if x[i] != y[i] {
            return num_less(x[i], y[i])
        }
    }
    false
}

/// `VersionReq::parse`: `=1.2.3` exact, `^1.2.3` or `1.2.3` compatible --
/// the version written, its sign stripped.
fn req_version(r: str) -> str {
    let t = rtoml.rust_trim(r)
    if t.starts_with("=") {
        return rtoml.rust_trim(t.substr(1, t.len() - 1))
    }
    if t.starts_with("^") {
        return rtoml.rust_trim(t.substr(1, t.len() - 1))
    }
    t
}

fn req_exact(r: str) -> bool {
    rtoml.rust_trim(r).starts_with("=")
}

/// A requirement as Rust displays it: `=1.2.3` or `^1.2.3`.
fn req_shown(r: str) -> str {
    if req_exact(r) {
        return "=" + version_shown(req_version(r))
    }
    "^" + version_shown(req_version(r))
}

fn req_matches(r: str, v: str) -> bool {
    let want = version_parts(req_version(r))
    let got = version_parts(v)
    if req_exact(r) {
        return want[0] == got[0] and want[1] == got[1] and want[2] == got[2]
    }
    if version_less(v, req_version(r)) {
        return false
    }
    if want[0] != "0" {
        got[0] == want[0]
    } else if want[1] != "0" {
        got[0] == "0" and got[1] == want[1]
    } else {
        got[0] == "0" and got[1] == "0" and got[2] == want[2]
    }
}

fn is_identifier(name: str) -> bool {
    let kws = ["and", "as", "bench", "break", "const", "continue", "effect", "else", "extern", "fail", "false", "fn", "for", "handled_by", "if", "import", "in", "inout", "let", "match", "not", "or", "own", "parallel", "pub", "ref", "region", "return", "spawn", "test", "true", "try", "type", "unsafe", "var", "while", "with"]
    if name == "" {
        return false
    }
    let b = name.to_bytes()
    let c0 = b.at(0)
    if not ((c0 >= 65 and c0 <= 90) or (c0 >= 97 and c0 <= 122) or c0 == 95) {
        return false
    }
    for i in 1..b.len() {
        let c = b.at(i)
        if not ((c >= 65 and c <= 90) or (c >= 97 and c <= 122) or (c >= 48 and c <= 57) or c == 95) {
            return false
        }
    }
    not kws.contains(name)
}

/// `Path::extension` is `gr`, in any case: the last component's text after
/// its last `.`, when that `.` does not begin it.
fn is_grasm_source(p: str) -> bool {
    var segs: [str] = []
    for s in p.split("/") {
        if s != "" and s != "." {
            segs.push(s)
        }
    }
    if segs.len() == 0 {
        return false
    }
    let last = segs[segs.len() - 1]
    if last == ".." {
        return false
    }
    let b = last.to_bytes()
    var dot = -1
    for i in 0..b.len() {
        if b.at(i) == 46 {
            dot = i
        }
    }
    dot > 0 and b.slice(dot + 1, b.len()).to_str().to_lower() == "gr"
}

/// `Manifest::load`: the manifest in `dir`, read by the Rust toolchain's
/// own reader (rtoml.gr) and checked as `Manifest::parse` checks it, in its
/// order and its words.
fn load_manifest(dir: str) -> Manifest {
    let path = join(dir, "grasm.toml")
    let text = match read_bytes(path) {
        Ok(b) -> {
            if not utf8_ok(b) {
                return bad_manifest("cannot read {path}: stream did not contain valid UTF-8")
            }
            b.to_str()
        }
        Err(e) -> return bad_manifest("cannot read {path}: {io_error_text(e)}")
    }
    let shown = tidy(path)
    let (ok, why, m) = parse_manifest(text)
    if not ok {
        return bad_manifest("{shown}: {why}")
    }
    m
}

fn parse_manifest(text: str) -> (bool, str, Manifest) {
    let none = bad_manifest("")
    let doc = rtoml.parse(text)
    if not doc.ok {
        return (false, doc.why, none)
    }
    let pkg = rtoml.table(doc, "package")
    if pkg < 0 {
        return (false, "manifest is missing a [package] table", none)
    }
    let name = rtoml.as_str(doc, rtoml.get(doc, pkg, "name"))
    if name == "\0" {
        return (false, "[package] is missing `name`", none)
    }
    if name == "" {
        return (false, "[package] name must not be empty", none)
    }
    let version = rtoml.as_str(doc, rtoml.get(doc, pkg, "version"))
    if version == "\0" {
        return (false, "[package] is missing `version`", none)
    }
    if not version_ok(version) {
        return (false, version_err(version), none)
    }
    var has_caps = false
    var caps: [str] = []
    let cv = rtoml.get(doc, pkg, "capabilities")
    if cv >= 0 {
        if not rtoml.is_str_array(doc, cv) {
            return (false, "`capabilities` must be an array of strings", none)
        }
        has_caps = true
        caps = rtoml.str_array(doc, cv)
    }
    let lv = rtoml.get(doc, pkg, "links")
    if lv >= 0 {
        if not rtoml.is_str_array(doc, lv) {
            return (false, "`links` must be an array of strings", none)
        }
        for lib in rtoml.str_array(doc, lv) {
            if not link_name_ok(lib) {
                return (false, "`links` entry `{lib}` is not a library name — letters, digits, `_`, `-`, `.` and `+`, and it must start with a letter, a digit or `_`", none)
            }
        }
    }
    var entry = rtoml.as_str(doc, rtoml.get(doc, pkg, "entry"))
    if entry == "\0" {
        entry = "src/main.gr"
    }
    if entry.starts_with("/") {
        return (false, "`entry` must be a path inside the package: `{entry}` is absolute", none)
    }
    if has_parent_component(entry) {
        return (false, "`entry` must be a path inside the package: `{entry}` leaves it with `..` — the lockfile checksums, the capability ceiling and `grasm publish` all cover this package's own directory, and a file outside it is in none of them", none)
    }
    if not is_grasm_source(entry) {
        return (false, "`entry` must name a `.gr` file: `{entry}` is not one, and the lockfile's checksum and `grasm publish` both cover this package's `.gr` sources — a file outside that set is executed but recorded nowhere", none)
    }
    let rv = rtoml.get(doc, pkg, "runtime")
    if rv >= 0 and doc.v_kind[rv] != rtoml.V_BOOL {
        return (false, "`runtime` must be `true` or `false`", none)
    }
    // Dependencies, in the order of their tables' names.
    var dep_names: [str] = []
    var paths: [str] = []
    var reqs: [str] = []
    for ti in rtoml.subtables(doc, "dependencies") {
        let full = doc.t_names[ti]
        let d = full.substr(13, full.len() - 13)
        let pth = rtoml.as_str(doc, rtoml.get(doc, ti, "path"))
        var r = "\0"
        let vv = rtoml.get(doc, ti, "version")
        if vv >= 0 {
            r = rtoml.as_str(doc, vv)
            if r == "\0" {
                return (false, "dependency `{d}`: `version` must be a string", none)
            }
            if not version_ok(req_version(r)) {
                return (false, "dependency `{d}`: {version_err(req_version(r))}", none)
            }
        }
        if pth == "\0" and r == "\0" {
            return (false, "dependency `{d}` needs a `path` or a `version`: without either there is nothing to resolve it to", none)
        }
        dep_names.push(d)
        paths.push(pth)
        reqs.push(r)
    }
    let pkg_keys = ["name", "version", "capabilities", "entry", "links", "runtime"]
    for k in doc.t_keys[pkg] {
        if not pkg_keys.contains(k) {
            return (false, "`[package]` has no key `{k}` — it takes `name`, `version`, `capabilities`, `entry`, `links`, `runtime`", none)
        }
    }
    let root = rtoml.table(doc, "")
    if root >= 0 and doc.t_keys[root].len() > 0 {
        return (false, "`{doc.t_keys[root][0]}` is written above the first table header, so it belongs to no table — put it under `[package]`", none)
    }
    for tn in doc.t_names {
        if tn == "" or tn == "package" or tn == "dependencies" {
            continue
        }
        if tn.starts_with("dependencies.") and tn.len() > 13 {
            continue
        }
        return (false, "`[{tn}]` is not a table this manifest has — it takes `[package]` and `[dependencies.<name>]`", none)
    }
    for ti in rtoml.subtables(doc, "dependencies") {
        let full = doc.t_names[ti]
        let d = full.substr(13, full.len() - 13)
        for k in doc.t_keys[ti] {
            if k != "path" and k != "version" {
                return (false, "dependency `{d}` has no key `{k}` — it takes `path` or `version`", none)
            }
        }
    }
    if not is_identifier(name) {
        return (false, "`{name}` is not a usable package name: a consumer writes `import {name}`, so it has to be a Grasm identifier — letters, digits and `_`, not starting with a digit, and not a keyword", none)
    }
    (true, "", Manifest{ ok: true, why: "", name: name, version: version, dep_names: dep_names, dep_paths: paths, dep_reqs: reqs, has_caps: has_caps, caps: caps, entry: entry })
}

/// A library name a link line may take: letters, digits, `_`, `-`, `.` and
/// `+`, starting with a letter, a digit or `_`.
fn link_name_ok(name: str) -> bool {
    if name == "" {
        return false
    }
    let b = name.to_bytes()
    for i in 0..b.len() {
        let c = b.at(i)
        let alnum = (c >= 48 and c <= 57) or (c >= 65 and c <= 90) or (c >= 97 and c <= 122)
        if i == 0 and not (alnum or c == 95) {
            return false
        }
        if not (alnum or c == 95 or c == 45 or c == 46 or c == 43) {
            return false
        }
    }
    true
}

/// The packages `grasm_pkg::resolve` reaches from `root_dir`, in its order,
/// as (name, directory); `why` set when resolution fails.
type Resolution = { ok: bool, why: str, names: [str], dirs: [str], mfs: [Manifest] }

pub fn resolve_graph(root_dir: str) -> Resolution {
    var r = Resolution{ ok: true, why: "", names: [], dirs: [], mfs: [] }
    let root = load_manifest(root_dir)
    if not root.ok {
        r.ok = false
        r.why = root.why
        return r
    }
    let reg = discover_registry(root_dir)
    let (sok, swhy, sel_names, sel_versions) = select_versions(root_dir, reg)
    if not sok {
        r.ok = false
        r.why = swhy
        return r
    }
    var sel: Map[str, str] = map()
    for i in 0..sel_names.len() {
        sel.set(sel_names[i], sel_versions[i])
    }
    var visiting: [str] = []
    var done_names: [str] = []
    var done_dirs: [str] = []
    var done_versions: [str] = []
    var done_by: [str] = []
    visit(root_dir, "\0", reg, sel, r, visiting, done_names, done_dirs, done_versions, done_by)
    r
}

// ---------------------------------------------------------------------
// The registry (grasm_pkg `Registry`, `select_versions`): a directory of
// `name/version/` packages, found from `GRASM_REGISTRY` or as the nearest
// `.grasm/registry` above the package; each name gets the lowest version
// at or above the highest floor anyone in the graph states.
// ---------------------------------------------------------------------

/// The registry's root, or "\0" when there is none: from the package's
/// canonical directory up, or from the working directory joined to it.
fn discover_registry(from: str) -> str {
    match env("GRASM_REGISTRY") {
        Some(d) -> return d
        None -> ()
    }
    var start = canonicalize(from)
    if start == "\0" {
        start = from
        match env("PWD") {
            Some(cwd) -> start = join(cwd, from)
            None -> ()
        }
    }
    var here = start
    while here != "\0" {
        let cand = join(join(here, ".grasm"), "registry")
        match list_dir(cand) {
            Ok(_) -> return cand
            Err(_) -> ()
        }
        here = parent(here)
    }
    "\0"
}

/// Every version of `name` the registry holds, normalized and ascending.
fn registry_versions(reg: str, name: str) -> [str] {
    var out: [str] = []
    match list_dir(join(reg, name)) {
        Ok(entries) -> {
            for v in entries {
                if version_ok(v) and is_file(join(join(join(reg, name), v), "grasm.toml")) {
                    out.push(version_shown(v))
                }
            }
        }
        Err(_) -> ()
    }
    // Insertion sort by version: the lists are short.
    for i in 1..out.len() {
        var j = i
        while j > 0 and version_less(out[j], out[j - 1]) {
            let tmp = out[j]
            out[j] = out[j - 1]
            out[j - 1] = tmp
            j -= 1
        }
    }
    out
}

/// `Path::is_file`: there, and not a directory.
fn is_file(p: str) -> bool {
    if not file_exists(p) {
        return false
    }
    match list_dir(p) {
        Ok(_) -> false
        Err(_) -> true
    }
}

/// `missing_registry`.
fn missing_registry(name: str, req_by: [str], req_on: [str]) -> str {
    var who = "this package"
    for i in 0..req_on.len() {
        if req_on[i] == name and who == "this package" {
            who = req_by[i]
        }
    }
    "`{who}` requires `{name}` from the registry, but no registry was found.\n  set GRASM_REGISTRY, or create .grasm/registry beside the package"
}

/// Minimal version selection: (ok, why, names, versions).
fn select_versions(root_dir: str, reg: str) -> (bool, str, [str], [str]) {
    var floor_names: [str] = []
    var floors: [str] = []
    var sel_names: [str] = []
    var sel: [str] = []
    for _ in 0..1000 {
        let (cok, cwhy, req_by, req_on, req_req) = collect_requirements(root_dir, reg, sel_names, sel)
        if not cok {
            return (false, cwhy, [], [])
        }
        var raised = false
        for i in 0..req_on.len() {
            let fl = version_shown(req_version(req_req[i]))
            var at = -1
            for j in 0..floor_names.len() {
                if floor_names[j] == req_on[i] {
                    at = j
                }
            }
            if at < 0 {
                floor_names.push(req_on[i])
                floors.push(fl)
                at = floor_names.len() - 1
            } else if version_less(floors[at], fl) {
                floors[at] = fl
            }
            var cur = fl
            for j in 0..sel_names.len() {
                if sel_names[j] == req_on[i] {
                    cur = sel[j]
                }
            }
            if version_less(cur, floors[at]) {
                raised = true
            }
        }
        // In name order, as the floors' map holds them.
        var sorted_names = floor_names
        sorted_names.sort()
        var order: [i64] = []
        for nm in sorted_names {
            for i in 0..floor_names.len() {
                if floor_names[i] == nm {
                    order.push(i)
                }
            }
        }
        var next_names: [str] = []
        var next: [str] = []
        for i in order {
            if reg == "\0" {
                return (false, missing_registry(floor_names[i], req_by, req_on), [], [])
            }
            let available = registry_versions(reg, floor_names[i])
            var pick = "\0"
            for v in available {
                if not version_less(v, floors[i]) and (pick == "\0" or version_less(v, pick)) {
                    pick = v
                }
            }
            if pick == "\0" {
                if available.len() == 0 {
                    return (false, "the registry has no package named `{floor_names[i]}`\n  looked in {join(reg, floor_names[i])}", [], [])
                }
                return (false, "the registry has no `{floor_names[i]}` at or above {floors[i]}\n  available: {available.join(", ")}", [], [])
            }
            next_names.push(floor_names[i])
            next.push(pick)
        }
        if next_names == sel_names and next == sel and not raised {
            // `verify`: the selection satisfies everyone, or who disagrees.
            for i in 0..req_on.len() {
                for j in 0..sel_names.len() {
                    if sel_names[j] == req_on[i] and not req_matches(req_req[i], sel[j]) {
                        var who: [str] = []
                        for k in 0..req_on.len() {
                            if req_on[k] == req_on[i] {
                                let line = "  `{req_by[k]}` requires {req_shown(req_req[k])}"
                                if not who.contains(line) {
                                    who.push(line)
                                }
                            }
                        }
                        who.sort()
                        return (false, "no version of `{req_on[i]}` satisfies every requirement:\n{who.join("\n")}\n  selected {sel[j]}, the lowest available at or above the highest floor\n  nothing here can be satisfied at once — one of these has to change", [], [])
                    }
                }
            }
            return (true, "", sel_names, sel)
        }
        sel_names = next_names
        sel = next
    }
    (false, "version selection did not settle; is the registry changing?", [], [])
}

/// Every registry requirement stated in the graph, given the versions
/// selected so far: (ok, why, by, on, requirement). Manifests are loaded as
/// they are queued, the last queued visited first.
fn collect_requirements(root_dir: str, reg: str, sel_names: [str], sel: [str]) -> (bool, str, [str], [str], [str]) {
    var by: [str] = []
    var on: [str] = []
    var reqs: [str] = []
    var seen: Map[str, bool] = map()
    var queue: [str] = [root_dir]
    var queued: [Manifest] = [load_manifest(root_dir)]
    while queue.len() > 0 {
        let dir = queue.pop() ?? ""
        let m = queued.pop() ?? bad_manifest("")
        let key = real_dir(dir)
        if seen.has(key) {
            continue
        }
        seen.set(key, true)
        for i in 0..m.dep_names.len() {
            if m.dep_paths[i] != "\0" {
                let d = join(dir, m.dep_paths[i])
                if is_file(join(d, "grasm.toml")) {
                    let dm = load_manifest(d)
                    if not dm.ok {
                        return (false, dm.why, [], [], [])
                    }
                    queue.push(d)
                    queued.push(dm)
                }
            } else {
                by.push(m.name)
                on.push(m.dep_names[i])
                reqs.push(m.dep_reqs[i])
                if reg != "\0" {
                    for j in 0..sel_names.len() {
                        if sel_names[j] == m.dep_names[i] {
                            let d = join(join(reg, m.dep_names[i]), sel[j])
                            if is_file(join(d, "grasm.toml")) {
                                let dm = load_manifest(d)
                                if not dm.ok {
                                    return (false, dm.why, [], [], [])
                                }
                                queue.push(d)
                                queued.push(dm)
                            }
                        }
                    }
                }
            }
        }
    }
    (true, "", by, on, reqs)
}

fn visit(dir: str, required_by: str, reg: str, sel: Map[str, str], inout r: Resolution, inout visiting: [str], inout done_names: [str], inout done_dirs: [str], inout done_versions: [str], inout done_by: [str]) {
    if not r.ok {
        return
    }
    let m = load_manifest(dir)
    if not m.ok {
        r.ok = false
        r.why = m.why
        return
    }
    let here = real_dir(dir)
    let by = if required_by == "\0" { "the root package" } else { required_by }
    for i in 0..done_names.len() {
        if done_names[i] == m.name {
            if done_dirs[i] != here {
                r.ok = false
                r.why = "package `{m.name}` resolves to two different directories:\n  {done_dirs[i]} is {done_versions[i]} (required by `{done_by[i]}`)\n  {here} is {m.version} (required by `{by}`)\na name resolves to one package, so these have to be the same directory"
            }
            return
        }
    }
    if visiting.contains(m.name) {
        r.ok = false
        var cycle = visiting
        cycle.push(m.name)
        r.why = "dependency cycle: {cycle.join(" -> ")}"
        return
    }
    visiting.push(m.name)
    for i in 0..m.dep_names.len() {
        var dep_dir = ""
        if m.dep_paths[i] != "\0" {
            dep_dir = join(dir, m.dep_paths[i])
        } else {
            if reg == "\0" {
                r.ok = false
                r.why = missing_registry(m.dep_names[i], [], [])
                return
            }
            let v = sel.get(m.dep_names[i]) ?? "\0"
            if v == "\0" {
                r.ok = false
                r.why = "internal: no version selected for `{m.dep_names[i]}`"
                return
            }
            dep_dir = join(join(reg, m.dep_names[i]), v)
        }
        if not file_exists(join(dep_dir, "grasm.toml")) {
            r.ok = false
            r.why = "dependency `{m.dep_names[i]}` of `{m.name}`: no grasm.toml at {tidy(dep_dir)}"
            return
        }
        let dm = load_manifest(dep_dir)
        if not dm.ok {
            r.ok = false
            r.why = dm.why
            return
        }
        if dm.name != m.dep_names[i] {
            r.ok = false
            r.why = "dependency `{m.dep_names[i]}` of `{m.name}` resolves to a package named `{dm.name}`"
            return
        }
        if m.dep_reqs[i] != "\0" and not req_matches(m.dep_reqs[i], dm.version) {
            r.ok = false
            r.why = "dependency `{m.dep_names[i]}` of `{m.name}`: requires {req_shown(m.dep_reqs[i])}, but {dep_dir} is {version_shown(dm.version)}"
            return
        }
        visit(dep_dir, m.name, reg, sel, r, visiting, done_names, done_dirs, done_versions, done_by)
        if not r.ok {
            return
        }
    }
    visiting.pop()
    done_names.push(m.name)
    done_dirs.push(here)
    done_versions.push(version_shown(m.version))
    done_by.push(by)
    r.names.push(m.name)
    r.dirs.push(dir)
    r.mfs.push(m)
}

/// `registry_packages`: every package in the entry package's graph but the
/// entry's own, by name. `fatal` is set when the toolchain stops here.
type Graph = { fatal: str, names: [str], dirs: [str] }

fn registry_packages(entry: str) -> Graph {
    var here = parent(entry)
    var pkg_dir = "\0"
    while here != "\0" {
        if file_exists(join(here, "grasm.toml")) {
            pkg_dir = here
            break
        }
        here = parent(here)
    }
    if pkg_dir == "\0" {
        return Graph{ fatal: "", names: [], dirs: [] }
    }
    let root = load_manifest(pkg_dir)
    if not root.ok {
        return Graph{ fatal: root.why, names: [], dirs: [] }
    }
    var all_paths = true
    for p in root.dep_paths {
        if p == "\0" {
            all_paths = false
        }
    }
    let res = resolve_graph(pkg_dir)
    if not res.ok {
        if all_paths {
            return Graph{ fatal: "", names: [], dirs: [] }
        }
        return Graph{ fatal: res.why, names: [], dirs: [] }
    }
    var g = Graph{ fatal: "", names: [], dirs: [] }
    for i in 0..res.names.len() {
        if not same_dir(res.dirs[i], pkg_dir) {
            g.names.push(res.names[i])
            g.dirs.push(res.dirs[i])
        }
    }
    g
}

// ---------------------------------------------------------------------
// Loading
// ---------------------------------------------------------------------

/// What resolving a module name needs: the package prefixes and their
/// directories, the canonical name of each package, and the entry's own
/// declarations.
type Ctx = {
    entry_src_dir: str,
    entry_src: str,
    deps: Map[str, str],
    resolved: Map[str, str],
    prefix_keys: [str],
    prefix_dirs: Map[str, str],
    canon: Map[str, str],
    entry_declares: [str],
    dep_names: [str],
    found: Map[str, str],
    runtime: Map[str, str],
}

/// The module name an import written in `importer` as `written` resolves
/// to, or "\0" to keep the one derived from the prefix.
fn canonical(cx: Ctx, importer: str, written: str) -> str {
    let p = longest_prefix(cx.prefix_keys, importer)
    var pkg_dir = cx.entry_src_dir
    if p != "\0" {
        let d = cx.prefix_dirs.get(p) ?? ""
        let par = parent(package_entry(d))
        if par == "\0" {
            pkg_dir = d
        } else {
            pkg_dir = par
        }
    }
    if file_exists(join(pkg_dir, dotted_to_path(written) + ".gr")) {
        return "\0"
    }
    let root = first_seg(written)
    let subs = package_dependencies(pkg_dir)
    var dir = "\0"
    match subs.get(root) {
        Some(d) -> dir = d
        None -> {
            if dependency_names(pkg_dir).contains(root) {
                match cx.resolved.get(root) {
                    Some(d) -> dir = d
                    None -> ()
                }
            }
        }
    }
    if dir == "\0" {
        return "\0"
    }
    let want = match cx.canon.get(real_dir(dir)) {
        Some(w) -> w
        None -> return "\0"
    }
    match written.index_of(".") {
        Some(i) -> want + "." + written.substr(i + 1, written.len() - i - 1)
        None -> want
    }
}

fn note(inout cx: Ctx, name: str, path: str) {
    cx.found.set(name, tidy(path))
    let par = parent(path)
    if par != "\0" {
        let pkg = runtime_package(par)
        if pkg != "\0" {
            cx.runtime.set(name, pkg)
        }
    }
}

/// The source of module `name`, or "\0" when it cannot be found.
fn provide(inout cx: Ctx, name: str) -> str {
    if name == "main" {
        return cx.entry_src
    }
    let p = longest_prefix(cx.prefix_keys, name)
    if p != "\0" {
        let d = cx.prefix_dirs.get(p) ?? ""
        var rest = name.substr(p.len(), name.len() - p.len())
        while rest.starts_with(".") {
            rest = rest.substr(1, rest.len() - 1)
        }
        let path = resolve_in_package(d, rest, 0)
        if path == "\0" {
            return "\0"
        }
        match read_text(path) {
            Some(src) -> {
                note(cx, name, path)
                return src
            }
            None -> return "\0"
        }
    }
    let rel = dotted_to_path(name) + ".gr"
    let sibling = join(cx.entry_src_dir, rel)
    match read_text(sibling) {
        Some(src) -> {
            note(cx, name, sibling)
            return src
        }
        None -> ()
    }
    let root = first_seg(name)
    if not cx.entry_declares.contains(root) {
        return "\0"
    }
    let dep_dir = match cx.deps.get(root) {
        Some(d) -> d
        None -> return "\0"
    }
    let rest = after_first_seg(name)
    let path = resolve_in_package(dep_dir, rest, 0)
    if path == "\0" {
        return "\0"
    }
    match read_text(path) {
        Some(src) -> {
            note(cx, name, path)
            src
        }
        None -> "\0"
    }
}

/// An I/O error as Rust's `io::Error` displays one: the system's message and
/// its number, `No such file or directory (os error 2)`. The runtime's
/// `IoError` carries the message alone, so the number is found from it, in
/// this system's `strerror` table (macOS, errors 1 to 107).
pub fn io_error_text(e: IoError) -> str {
    let msg = match e {
        NotFound(_) -> "No such file or directory"
        IoFailed(m) -> m
    }
    let table = ["Operation not permitted", "No such file or directory", "No such process", "Interrupted system call", "Input/output error", "Device not configured", "Argument list too long", "Exec format error", "Bad file descriptor", "No child processes", "Resource deadlock avoided", "Cannot allocate memory", "Permission denied", "Bad address", "Block device required", "Resource busy", "File exists", "Cross-device link", "Operation not supported by device", "Not a directory", "Is a directory", "Invalid argument", "Too many open files in system", "Too many open files", "Inappropriate ioctl for device", "Text file busy", "File too large", "No space left on device", "Illegal seek", "Read-only file system", "Too many links", "Broken pipe", "Numerical argument out of domain", "Result too large", "Resource temporarily unavailable", "Operation now in progress", "Operation already in progress", "Socket operation on non-socket", "Destination address required", "Message too long", "Protocol wrong type for socket", "Protocol not available", "Protocol not supported", "Socket type not supported", "Operation not supported", "Protocol family not supported", "Address family not supported by protocol family", "Address already in use", "Can't assign requested address", "Network is down", "Network is unreachable", "Network dropped connection on reset", "Software caused connection abort", "Connection reset by peer", "No buffer space available", "Socket is already connected", "Socket is not connected", "Can't send after socket shutdown", "Too many references: can't splice", "Operation timed out", "Connection refused", "Too many levels of symbolic links", "File name too long", "Host is down", "No route to host", "Directory not empty", "Too many processes", "Too many users", "Disc quota exceeded", "Stale NFS file handle", "Too many levels of remote in path", "RPC struct is bad", "RPC version wrong", "RPC prog. not avail", "Program version wrong", "Bad procedure for program", "No locks available", "Function not implemented", "Inappropriate file type or format", "Authentication error", "Need authenticator", "Device power is off", "Device error", "Value too large to be stored in data type", "Bad executable (or shared library)", "Bad CPU type in executable", "Shared library version mismatch", "Malformed Mach-o file", "Operation canceled", "Identifier removed", "No message of desired type", "Illegal byte sequence", "Attribute not found", "Bad message", "EMULTIHOP (Reserved)", "No message available on STREAM", "ENOLINK (Reserved)", "No STREAM resources", "Not a STREAM", "Protocol error", "STREAM ioctl timeout", "Operation not supported on socket", "Policy not found", "State not recoverable", "Previous owner died", "Interface output queue is full", "Capabilities insufficient"]
    for i in 0..table.len() {
        if table[i] == msg {
            return "{msg} (os error {i + 1})"
        }
    }
    msg
}

fn empty_loaded(fatal: str) -> Loaded {
    Loaded{ names: [], aliases: [], paths: [], srcs: [], bases: [], imp_alias: [], imp_full: [], mods: [], diags: [], d_s: [], d_e: [], d_help: [], runtime: map(), deps: [], fatal: fatal }
}

fn load_diag(inout out: Loaded, s: i64, e: i64, msg: str, help: str) {
    out.diags.push(msg)
    out.d_s.push(s)
    out.d_e.push(e)
    out.d_help.push(help)
}

/// A module's parse diagnostics, moved to the program's offsets -- all but
/// those made inside an interpolation inside an interpolation, which the
/// Rust parser leaves where they were.
fn parse_diags(inout out: Loaded, ps: Parser, base: i64) {
    for i in 0..ps.d_msg.len() {
        if ps.d_deep[i] {
            load_diag(out, ps.d_s[i], ps.d_e[i], ps.d_msg[i], ps.d_help[i])
        } else {
            load_diag(out, ps.d_s[i] + base, ps.d_e[i] + base, ps.d_msg[i], ps.d_help[i])
        }
    }
}

/// "cannot load module": named as the import wrote it, with every place
/// that was tried, or the path that was looked for when nothing says more.
fn not_loaded(written: str, display: str, candidates: [str]) -> str {
    if candidates.len() == 0 {
        return "cannot load module `{written}` (looked for `{display}`)"
    }
    "cannot load module `{written}` (looked in:\n  {candidates.join("\n  ")})"
}

/// The places `provide` looks for module `name` (loader.rs `tried`).
fn tried(cx: Ctx, name: str, truncated: bool) -> [str] {
    let root = first_seg(name)
    match cx.prefix_dirs.get(root) {
        Some(dir) -> {
            var out: [str] = []
            candidates_in_package(dir, after_first_seg(name), root, 0, out)
            if truncated {
                return ["the package graph is more than {MAX_PACKAGE_DEPTH} deep from the entry, so `{root}`'s dependencies past that point were not resolved as package names"]
            }
            return cap_candidates(out)
        }
        None -> ()
    }
    var out = [tidy(join(cx.entry_src_dir, dotted_to_path(name) + ".gr"))]
    match cx.deps.get(root) {
        Some(dir) -> {
            if cx.entry_declares.contains(root) {
                out.push("{tidy(package_entry(dir))} (entry file of dependency `{root}`)")
            } else {
                out.push("no dependency named `{root}` in grasm.toml — it is somewhere in the graph, reached through another package; add it here to import it")
            }
        }
        None -> out.push("no dependency named `{root}` in grasm.toml")
    }
    out
}

/// At most eight candidates, the last ones, and a count of the rest.
fn cap_candidates(out: [str]) -> [str] {
    if out.len() <= 8 {
        return out
    }
    let dropped = out.len() - 8
    var kept = ["… {dropped} earlier candidate(s) in packages between the entry and here"]
    for i in dropped..out.len() {
        kept.push(out[i])
    }
    kept
}

/// The paths `resolve_in_package` would open, in its order.
fn candidates_in_package(pkg_dir: str, rest: str, pkg_name: str, depth: i64, inout out: [str]) {
    let entry = package_entry(pkg_dir)
    if rest == "" {
        out.push("{tidy(entry)} (entry file of dependency `{pkg_name}`)")
        return
    }
    if depth > MAX_PACKAGE_DEPTH {
        out.push("the package graph is more than {MAX_PACKAGE_DEPTH} deep from the entry, so this import was not resolved as a dependency name")
        return
    }
    let src_dir = parent(entry)
    if src_dir == "\0" {
        return
    }
    out.push(tidy(join(src_dir, dotted_to_path(rest) + ".gr")))
    let head = first_seg(rest)
    let tail = after_first_seg(rest)
    match package_dependencies(src_dir).get(head) {
        Some(d) -> candidates_in_package(d, tail, head, depth + 1, out)
        None -> {
            if rest.contains(".") {
                out.push("no dependency named `{head}` in `{pkg_name}`'s grasm.toml")
            }
        }
    }
}

/// Loads the program whose entry file is `entry_path`.
pub fn load(entry_path: str) -> Loaded {
    let g = registry_packages(entry_path)
    if g.fatal != "" {
        return empty_loaded(g.fatal)
    }
    var resolved: Map[str, str] = map()
    for i in 0..g.names.len() {
        resolved.set(g.names[i], g.dirs[i])
    }
    load_with(entry_path, resolved)
}

/// `load_from_disk_with`: the program from `entry_path`, given the package
/// directories already resolved, by name.
pub fn load_with(entry_path: str, resolved: Map[str, str]) -> Loaded {
    var entry_src_dir = parent(entry_path)
    if entry_src_dir == "\0" {
        entry_src_dir = ""
    }
    let entry_display = tidy(entry_path)
    let entry_bytes = match read_bytes(entry_path) {
        Ok(b) -> b
        Err(e) -> return empty_loaded("cannot read `{entry_display}`: {io_error_text(e)}")
    }
    if not utf8_ok(entry_bytes) {
        return empty_loaded("cannot read `{entry_display}`: stream did not contain valid UTF-8")
    }
    let entry_src = entry_bytes.to_str()
    // A source bundle carries its own modules; there is nothing on disk to
    // look for.
    if entry_src.trim_start().starts_with("//!module ") {
        return load_bundle(entry_src)
    }
    var deps = package_dependencies(entry_src_dir)
    for name in resolved.keys() {
        deps.set(name, resolved.get(name) ?? "")
    }
    var all_prefixes: Map[str, str] = map()
    var all_keys: [str] = []
    var truncated = false
    let declared = dependency_names(entry_src_dir)
    for name in declared {
        match deps.get(name) {
            Some(d) -> {
                if collect_packages(name, d, resolved, all_prefixes, all_keys, 0) {
                    truncated = true
                }
            }
            None -> ()
        }
    }
    // One name per package: the shortest prefix, then the least.
    var sorted_keys = all_keys
    sort_prefixes(sorted_keys)
    var canon: Map[str, str] = map()
    for p in sorted_keys {
        let key = real_dir(all_prefixes.get(p) ?? "")
        if not canon.has(key) {
            canon.set(key, p)
        }
    }
    var dep_names: [str] = []
    for k in canon.keys() {
        let v = canon.get(k) ?? ""
        if not dep_names.contains(v) {
            dep_names.push(v)
        }
    }
    var cx = Ctx{ entry_src_dir: entry_src_dir, entry_src: entry_src, deps: deps, resolved: resolved, prefix_keys: all_keys, prefix_dirs: all_prefixes, canon: canon, entry_declares: declared, dep_names: dep_names, found: map(), runtime: map() }
    let ep = parent(entry_path)
    if ep != "\0" {
        let pkg = runtime_package(ep)
        if pkg != "\0" {
            cx.runtime.set("main", pkg)
        }
    }
    let entry_alias = file_stem(entry_path)
    var out = empty_loaded("")
    var loaded: Map[str, bool] = map()
    var q_name: [str] = ["main"]
    var q_disp: [str] = [entry_display]
    // Where each was asked for, and how the import wrote it.
    var q_s: [i64] = [0]
    var q_e: [i64] = [1]
    var q_written: [str] = ["main"]
    var base = 0
    while q_name.len() > 0 {
        let name = q_name.pop() ?? ""
        let display = q_disp.pop() ?? ""
        let asked_s = q_s.pop() ?? 0
        let asked_e = q_e.pop() ?? 0
        let asked_as = q_written.pop() ?? ""
        if loaded.has(name) {
            continue
        }
        loaded.set(name, true)
        let src = provide(cx, name)
        if src == "\0" {
            load_diag(out, asked_s, asked_e, not_loaded(asked_as, display, tried(cx, name, truncated)), "")
            continue
        }
        let sb = src.to_bytes()
        let lx = lex.lex(sb, true)
        let p = parse.parse(sb, lx)
        let c = cst.build(p)
        let m = ast.build(c, sb, p.wide_ints, lx.doc_start, lx.doc_end, lx.doc_text)
        parse_diags(out, p, base)
        let owner = longest_prefix(dep_names, name)
        var ia: [str] = []
        var ifull: [str] = []
        for d in m.decls {
            if m.a.k[d] != ast.D_IMPORT {
                continue
            }
            let path = m.a.pool[m.a.off[d]]
            let sv = m.a.pool[m.a.off[path]]
            let segs = m.a.pool.slice(m.a.off[sv], m.a.off[sv] + m.a.n[sv])
            var parts: [str] = []
            for s in segs {
                parts.push(m.a.t[s])
            }
            let written = parts.join(".")
            var alias = ""
            if parts.len() > 0 {
                alias = parts[parts.len() - 1]
            }
            var full = written
            if owner != "\0" {
                full = owner + "." + written
            }
            let cn = canonical(cx, name, written)
            if cn != "\0" {
                full = cn
            }
            if full == entry_alias {
                full = "main"
            }
            var dup = -1
            for j in 0..ia.len() {
                if ia[j] == alias {
                    dup = j
                }
            }
            if dup >= 0 {
                load_diag(out, m.a.s[d] + base, m.a.e[d] + base, "duplicate import alias `{alias}` in module `{name}`", "")
                ifull[dup] = full
            } else {
                ia.push(alias)
                ifull.push(full)
            }
            q_name.push(full)
            q_disp.push(dotted_to_path(full) + ".gr")
            q_s.push(m.a.s[d] + base)
            q_e.push(m.a.e[d] + base)
            q_written.push(written)
        }
        out.names.push(name)
        out.aliases.push(last_seg(name))
        out.paths.push(cx.found.get(name) ?? display)
        out.srcs.push(sb)
        out.bases.push(base)
        out.imp_alias.push(ia)
        out.imp_full.push(ifull)
        out.mods.push(m)
        base += sb.len() + 1
    }
    out.runtime = cx.runtime
    out.deps = dep_names
    out
}

/// A source bundle (loader.rs `load_from_source_bundle`): every module of a
/// program in one file, each after a `//!module NAME` line, the entry
/// first. An import names a module of the bundle by its qualified name, its
/// written one, or the one module whose name ends with it.
fn load_bundle(src: str) -> Loaded {
    var names: [str] = []
    var bodies: [str] = []
    var cur = "\0"
    var body = str_builder()
    for line in src.lines() {
        if line.starts_with("//!module ") {
            if cur != "\0" {
                names.push(cur)
                bodies.push(body.to_str())
            }
            cur = line.substr(10, line.len() - 10).trim()
            body = str_builder()
        } else if cur != "\0" {
            body.push_str(line)
            body.push_str("\n")
        }
    }
    if cur != "\0" {
        names.push(cur)
        bodies.push(body.to_str())
    }
    var table: Map[str, str] = map()
    for i in 0..names.len() {
        table.set(names[i], bodies[i])
    }
    var entry = "main"
    if names.len() > 0 {
        entry = names[0]
    }
    var out = empty_loaded("")
    var loaded: Map[str, bool] = map()
    var q_name: [str] = [entry]
    var q_disp: [str] = [if entry == "main" { "<bundle>" } else { "<bundle>:" + entry }]
    var q_s: [i64] = [0]
    var q_e: [i64] = [1]
    var q_written: [str] = [entry]
    var base = 0
    while q_name.len() > 0 {
        let name = q_name.pop() ?? ""
        let display = q_disp.pop() ?? ""
        let asked_s = q_s.pop() ?? 0
        let asked_e = q_e.pop() ?? 0
        let asked_as = q_written.pop() ?? ""
        if loaded.has(name) {
            continue
        }
        loaded.set(name, true)
        let msrc = match table.get(name) {
            Some(x) -> x
            None -> {
                load_diag(out, asked_s, asked_e, not_loaded(asked_as, display, []), "")
                continue
            }
        }
        let sb = msrc.to_bytes()
        let lx = lex.lex(sb, true)
        let ps = parse.parse(sb, lx)
        let c = cst.build(ps)
        let m = ast.build(c, sb, ps.wide_ints, lx.doc_start, lx.doc_end, lx.doc_text)
        parse_diags(out, ps, base)
        var ia: [str] = []
        var ifull: [str] = []
        for d in m.decls {
            if m.a.k[d] != ast.D_IMPORT {
                continue
            }
            let path = m.a.pool[m.a.off[d]]
            let sv = m.a.pool[m.a.off[path]]
            let segs = m.a.pool.slice(m.a.off[sv], m.a.off[sv] + m.a.n[sv])
            var parts: [str] = []
            for sg in segs {
                parts.push(m.a.t[sg])
            }
            let written = parts.join(".")
            var alias = ""
            if parts.len() > 0 {
                alias = parts[parts.len() - 1]
            }
            var full = written
            let nested = name + "." + written
            if table.has(nested) {
                full = nested
            } else if table.has(written) {
                full = written
            } else {
                var hit = "\0"
                var many = false
                for k in table.keys() {
                    if k.ends_with("." + written) {
                        if hit != "\0" {
                            many = true
                        }
                        hit = k
                    }
                }
                if hit != "\0" and not many {
                    full = hit
                }
            }
            var dup = -1
            for j in 0..ia.len() {
                if ia[j] == alias {
                    dup = j
                }
            }
            if dup >= 0 {
                load_diag(out, m.a.s[d] + base, m.a.e[d] + base, "duplicate import alias `{alias}` in module `{name}`", "")
                ifull[dup] = full
            } else {
                ia.push(alias)
                ifull.push(full)
            }
            q_name.push(full)
            q_disp.push(dotted_to_path(full) + ".gr")
            q_s.push(m.a.s[d] + base)
            q_e.push(m.a.e[d] + base)
            q_written.push(written)
        }
        out.names.push(name)
        out.aliases.push(last_seg(name))
        out.paths.push(display)
        out.srcs.push(sb)
        out.bases.push(base)
        out.imp_alias.push(ia)
        out.imp_full.push(ifull)
        out.mods.push(m)
        base += sb.len() + 1
    }
    out
}

fn sort_prefixes(inout xs: [str]) {
    // Insertion sort by (length, text): the lists are short.
    for i in 1..xs.len() {
        var j = i
        while j > 0 and prefix_less(xs[j], xs[j - 1]) {
            let tmp = xs[j]
            xs[j] = xs[j - 1]
            xs[j - 1] = tmp
            j -= 1
        }
    }
}

fn prefix_less(a: str, b: str) -> bool {
    if a.len() != b.len() {
        return a.len() < b.len()
    }
    a < b
}

/// The file lines `grasm tir` begins with: each module's name, alias, path
/// and base, then its imports sorted by alias.
pub fn print_files(l: Loaded) -> str {
    var b = str_builder()
    for i in 0..l.names.len() {
        b.push_str("(file {quote(l.names[i])} {quote(l.aliases[i])} {quote(l.paths[i])} {l.bases[i]}")
        var pairs: [str] = []
        for j in 0..l.imp_alias[i].len() {
            pairs.push(quote(l.imp_alias[i][j]) + " " + quote(l.imp_full[i][j]))
        }
        pairs.sort()
        for pr in pairs {
            b.push_str("\n  (import {pr})")
        }
        b.push_str(")\n")
    }
    b.to_str()
}

/// A string as a JSON string literal, as TIR writes one.
pub fn quote(s: str) -> str {
    var b = str_builder()
    b.push_str("\"")
    for c in s.chars() {
        if c == "\"" {
            b.push_str("\\\"")
        } else if c == "\\" {
            b.push_str("\\\\")
        } else if c == "\n" {
            b.push_str("\\n")
        } else if c == "\r" {
            b.push_str("\\r")
        } else if c == "\t" {
            b.push_str("\\t")
        } else {
            let code = c.code_at(0)
            if code < 32 or code == 127 {
                b.push_str("\\u{hex4(code)}")
            } else {
                b.push_str(c)
            }
        }
    }
    b.push_str("\"")
    b.to_str()
}

fn hex4(n: i64) -> str {
    let digits = "0123456789abcdef"
    var s = ""
    var v = n
    for i in 0..4 {
        s = digits.substr(v % 16, 1) + s
        v = v / 16
    }
    s
}
