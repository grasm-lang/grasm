// Capability ceilings (crates/grasm/src/main.rs `check_dependency_ceilings`,
// grasm_pkg `effects_of_package`, effects.rs `effects_of_program` and
// `effects_by_package`): every package in the program's graph whose manifest
// declares `capabilities` is held to them -- what the package performs on its
// own, read from each of its source files loaded and checked as a program of
// its own, and what it performs in this program. A breach refuses the
// program, as `grasm tir` and `grasm check` refuse it.
import ast
import prog
import tys
import sema
import loader
import effrows
import lex
import parse
import cst
import builtin_rows

/// The breaches, one message each; none when the program is within every
/// ceiling or is not in a package.
pub fn check(entry_path: str, p: Prog, c: Ck, inout t: Tys) -> [str] {
    let (msgs, _) = check_with_help(entry_path, p, c, t)
    msgs
}

/// The breaches, each with the help `grasm check` prints under it ("" for
/// none): where the package performs each effect it should not.
pub fn check_with_help(entry_path: str, p: Prog, c: Ck, inout t: Tys) -> ([str], [str]) {
    var here = loader.parent(entry_path)
    var pkg_dir = "\0"
    while here != "\0" {
        if file_exists(loader.join(here, "grasm.toml")) {
            pkg_dir = here
            break
        }
        here = loader.parent(here)
    }
    if pkg_dir == "\0" {
        return ([], [])
    }
    let res = loader.resolve_graph(pkg_dir)
    if not res.ok {
        return ([res.why], [""])
    }
    var out: [str] = []
    var helps: [str] = []
    var by_pkg_done = false
    var by_pkg: Map[str, [str]] = map()
    for i in 0..res.names.len() {
        let m = res.mfs[i]
        if not m.has_caps {
            continue
        }
        let (ok, why, performed) = effects_of_package(res.dirs[i], m)
        if not ok {
            // The reason is not said: `grasm check` names the package.
            let _ = why
            out.push("cannot check the capability ceiling of `{m.name}` — refusing to build against a dependency whose reach is unknown")
            helps.push("")
            continue
        }
        if not by_pkg_done {
            by_pkg = effects_by_package(p, c, t)
            by_pkg_done = true
        }
        var all: Map[str, bool] = map()
        for e in performed {
            all.set(e, true)
        }
        for e in by_pkg.get(m.name) ?? [] {
            all.set(e, true)
        }
        var exceeded: [str] = []
        for e in effrows.sorted_keys(all) {
            if not m.caps.contains(e) {
                exceeded.push(e)
            }
        }
        if exceeded.len() > 0 {
            var caps: Map[str, bool] = map()
            for e in m.caps {
                caps.set(e, true)
            }
            var declared = "nothing"
            if caps.len() > 0 {
                declared = "`" + effrows.sorted_keys(caps).join("`, `") + "`"
            }
            out.push("package `{m.name}` performs `{exceeded.join("`, `")}` but its manifest only permits {declared}")
            // Where each effect happens, when it has a place to point at.
            let sites = effect_sites_of_package(res.dirs[i], m)
            var where_at: [str] = []
            for e in exceeded {
                match sites.get(e) {
                    Some(at) -> where_at.push("`{e}` at {at}")
                    None -> ()
                }
            }
            var help = "either add the capability to that package's manifest, or stop it from performing the effect"
            if where_at.len() > 0 {
                help = help + "\n  performed: " + where_at.join(", ")
            }
            helps.push(help)
        }
    }
    (out, helps)
}

/// Where a package performs each effect, as `path:line:column` of the first
/// place (grasm_pkg `effect_sites_of_package`): its entry file's program,
/// then every other source file it has, each loaded as a program.
fn effect_sites_of_package(dir: str, m: Manifest) -> Map[str, str] {
    var out: Map[str, str] = map()
    let entry = loader.join(dir, m.entry)
    if not file_exists(entry) {
        return out
    }
    var owng: Map[str, str] = map()
    let r = loader.resolve_graph(dir)
    if r.ok {
        for i in 0..r.names.len() {
            owng.set(r.names[i], r.dirs[i])
        }
    }
    let l = loader.load_with(entry, owng)
    if l.fatal != "" {
        // `load_from_disk_with(..)?`: no sites at all.
        return map()
    }
    sites_of(prog.build(l), out)
    for f in source_files(dir) {
        if f != entry {
            let l2 = loader.load_with(f, owng)
            if l2.fatal == "" {
                sites_of(prog.build(l2), out)
            }
        }
    }
    out
}

/// effects.rs `effect_sites`: every function's syntactic effect sites, the
/// first one of each effect kept.
fn sites_of(p: Prog, inout out: Map[str, str]) {
    for mi in 0..p.m_name.len() {
        var externs: Map[str, bool] = map()
        var effects: Map[str, bool] = map()
        for d in p.m_decls[mi] {
            let k = prog.kind(p, d)
            if k == ast.D_EXTERN {
                externs.set(prog.name(p, prog.sl(p, d, 1)), true)
            } else if k == ast.D_EFFECT {
                effects.set(prog.name(p, prog.sl(p, d, 0)), true)
            }
        }
        for d in p.m_decls[mi] {
            if prog.kind(p, d) != ast.D_FN {
                continue
            }
            var names: [str] = []
            var ss: [i64] = []
            if prog.sl(p, d, 1) != 0 {
                let nm = prog.sl(p, d, 2)
                names.push("unsafe")
                ss.push(prog.s(p, nm))
            }
            site_block(p, prog.sl(p, d, 9), externs, effects, names, ss)
            for i in 0..names.len() {
                if not out.has(names[i]) {
                    out.set(names[i], site_at(p, mi, ss[i]))
                }
            }
        }
    }
}

/// `path:line:column` of a program offset, the column in characters.
fn site_at(p: Prog, mi: i64, start: i64) -> str {
    let src = p.m_src[mi]
    var off = start - p.m_base[mi]
    if off < 0 {
        off = 0
    }
    if off > src.len() {
        off = src.len()
    }
    var line = 1
    var col = 1
    for i in 0..off {
        let b = src.at(i)
        if b == 10 {
            line += 1
            col = 1
        } else if b < 128 or b >= 192 {
            col += 1
        }
    }
    "{p.m_path[mi]}:{line}:{col}"
}

fn site_block(p: Prog, b: i64, externs: Map[str, bool], effects: Map[str, bool], inout names: [str], inout ss: [i64]) {
    for st in prog.stmts(p, b) {
        let k = prog.kind(p, st)
        if k == ast.S_LET {
            site_expr(p, prog.sl(p, st, 3), externs, effects, names, ss)
        } else if k == ast.S_ASSIGN {
            site_expr(p, prog.sl(p, st, 2), externs, effects, names, ss)
        } else if k == ast.S_EXPR {
            site_expr(p, prog.sl(p, st, 0), externs, effects, names, ss)
        } else if k == ast.S_RETURN {
            let v = prog.sl(p, st, 0)
            if v >= 0 {
                site_expr(p, v, externs, effects, names, ss)
            }
        } else if k == ast.S_WHILE {
            site_expr(p, prog.sl(p, st, 0), externs, effects, names, ss)
            site_block(p, prog.sl(p, st, 1), externs, effects, names, ss)
        } else if k == ast.S_FOR {
            site_expr(p, prog.sl(p, st, 1), externs, effects, names, ss)
            site_block(p, prog.sl(p, st, 2), externs, effects, names, ss)
        } else if k == ast.S_WITH {
            site_block(p, prog.sl(p, st, 2), externs, effects, names, ss)
        } else if k == ast.S_PARALLEL or k == ast.S_SPAWN {
            site_block(p, prog.sl(p, st, 0), externs, effects, names, ss)
        }
    }
}

fn is_mem_method(name: str) -> bool {
    let layout = ["i8", "i16", "i32", "i64", "u8", "u16", "u32", "u64", "f64", "addr"]
    if name.starts_with("load_") {
        return layout.contains(name.substr(5, name.len() - 5))
    }
    if name.starts_with("store_") {
        return layout.contains(name.substr(6, name.len() - 6))
    }
    if name.starts_with("atomic_") {
        let rest = name.substr(7, name.len() - 7)
        match rest.index_of("_") {
            Some(i) -> {
                let op = rest.substr(0, i)
                let ty = rest.substr(i + 1, rest.len() - i - 1)
                let ok_op = op == "load" or op == "store" or op == "cas" or op == "add"
                return ok_op and layout.contains(ty) and ty != "f64" and ty != "addr"
            }
            None -> return false
        }
    }
    false
}

fn site_expr(p: Prog, e0: i64, externs: Map[str, bool], effects: Map[str, bool], inout names: [str], inout ss: [i64]) {
    // A binary operator's right operand and an `else if` in this loop, not
    // by recursion: their chains are as long as they are written.
    var e = e0
    while e >= 0 {
        e = site_one(p, e, externs, effects, names, ss)
    }
}

/// One node of `site_expr`; the node to walk next in its place, or -1.
fn site_one(p: Prog, e: i64, externs: Map[str, bool], effects: Map[str, bool], inout names: [str], inout ss: [i64]) -> i64 {
    let k = prog.kind(p, e)
    if k == ast.E_CALL {
        let callee = prog.sl(p, e, 0)
        if prog.kind(p, callee) == ast.E_IDENT {
            let n = prog.name(p, prog.sl(p, callee, 0))
            for ef in builtin_rows.row_of(n) {
                names.push(ef)
                ss.push(prog.es(p, e))
            }
            if externs.has(n) {
                names.push("io")
                ss.push(prog.es(p, e))
                names.push("unsafe")
                ss.push(prog.es(p, e))
            }
        }
        site_expr(p, callee, externs, effects, names, ss)
        for a in prog.items(p, prog.sl(p, e, 1)) {
            site_expr(p, a, externs, effects, names, ss)
        }
    } else if k == ast.E_METHOD {
        let recv = prog.sl(p, e, 0)
        if prog.kind(p, recv) == ast.E_IDENT {
            let tn = prog.name(p, prog.sl(p, recv, 0))
            if effects.has(tn) {
                names.push(tn)
                ss.push(prog.es(p, e))
            }
        }
        if is_mem_method(prog.name(p, prog.sl(p, e, 1))) {
            names.push("mem")
            ss.push(prog.es(p, e))
        }
        site_expr(p, recv, externs, effects, names, ss)
        for a in prog.items(p, prog.sl(p, e, 2)) {
            site_expr(p, a, externs, effects, names, ss)
        }
    } else if k == ast.E_UNSAFE {
        let b = prog.sl(p, e, 0)
        names.push("unsafe")
        ss.push(prog.s(p, b))
        site_block(p, b, externs, effects, names, ss)
    } else if k == ast.E_BLOCK or k == ast.E_REGION {
        site_block(p, prog.sl(p, e, 0), externs, effects, names, ss)
    } else if k == ast.E_IF {
        site_expr(p, prog.sl(p, e, 0), externs, effects, names, ss)
        site_block(p, prog.sl(p, e, 1), externs, effects, names, ss)
        let eb = prog.sl(p, e, 2)
        if eb >= 0 {
            if prog.kind(p, eb) == ast.EB_ELSE {
                site_block(p, prog.sl(p, eb, 0), externs, effects, names, ss)
            } else {
                return prog.sl(p, eb, 0)
            }
        }
    } else if k == ast.E_MATCH {
        site_expr(p, prog.sl(p, e, 0), externs, effects, names, ss)
        for arm in prog.items(p, prog.sl(p, e, 1)) {
            site_expr(p, prog.sl(p, arm, 2), externs, effects, names, ss)
        }
    } else if k == ast.E_CLOSURE {
        site_expr(p, prog.sl(p, e, 1), externs, effects, names, ss)
    } else if k == ast.E_UNARY {
        site_expr(p, prog.sl(p, e, 1), externs, effects, names, ss)
    } else if k == ast.E_TRY or k == ast.E_FIELD {
        site_expr(p, prog.sl(p, e, 0), externs, effects, names, ss)
    } else if k == ast.E_BINARY {
        site_expr(p, prog.sl(p, e, 1), externs, effects, names, ss)
        return prog.sl(p, e, 2)
    } else if k == ast.E_INDEX {
        site_expr(p, prog.sl(p, e, 0), externs, effects, names, ss)
        site_expr(p, prog.sl(p, e, 1), externs, effects, names, ss)
    } else if k == ast.E_LIST or k == ast.E_TUPLE {
        for i in prog.items(p, prog.sl(p, e, 0)) {
            site_expr(p, i, externs, effects, names, ss)
        }
    } else if k == ast.E_MAP {
        for pr in prog.items(p, prog.sl(p, e, 0)) {
            site_expr(p, prog.sl(p, pr, 0), externs, effects, names, ss)
            site_expr(p, prog.sl(p, pr, 1), externs, effects, names, ss)
        }
    } else if k == ast.E_STR {
        for pc in prog.items(p, prog.sl(p, e, 0)) {
            if prog.kind(p, pc) == ast.PC_EXPR {
                site_expr(p, prog.sl(p, pc, 0), externs, effects, names, ss)
            }
        }
    }
    -1
}

fn value_tables(c: Ck, inout t: Tys) -> (Map[i64, [str]], Map[i64, [str]]) {
    var vr: Map[i64, [str]] = map()
    for k in c.value_rows.keys() {
        vr.set(k, tys.row_names(t, c.value_rows.get(k) ?? -1))
    }
    var cr: Map[i64, [str]] = map()
    for k in c.callee_rows.keys() {
        cr.set(k, tys.row_names(t, c.callee_rows.get(k) ?? -1))
    }
    (vr, cr)
}

/// What each package performs in this program, by the prefix its modules
/// carry ("" for the entry package): the rows of what escapes it.
fn effects_by_package(p: Prog, c: Ck, inout t: Tys) -> Map[str, [str]] {
    let (vr, cr) = value_tables(c, t)
    let x = effrows.build_with(p, vr, cr, p.deps)
    var acc: Map[str, Map[str, bool]] = map()
    for i in 0..x.keys.len() {
        let d = x.decl[i]
        let name = prog.name(p, prog.sl(p, d, 2))
        let escapes = prog.sl(p, d, 0) != 0 or name == "main"
        if not escapes {
            continue
        }
        let owner = effrows.package_of(x, x.module[i])
        var m = acc.get(owner) ?? map()
        for e in x.rows[i] {
            m.set(e, true)
        }
        acc.set(owner, m)
    }
    var out: Map[str, [str]] = map()
    for k in acc.keys() {
        out.set(k, effrows.sorted_keys(acc.get(k) ?? map()))
    }
    out
}

/// What a package performs on its own: its entry file and every other
/// source file it has, each loaded and checked as a program. Not ok, with
/// why, when one of them cannot be.
fn effects_of_package(dir: str, m: Manifest) -> (bool, str, [str]) {
    let entry = loader.join(dir, m.entry)
    if not file_exists(entry) {
        return (false, "package `{m.name}`: entry file {entry} does not exist", [])
    }
    var owng: Map[str, str] = map()
    let r = loader.resolve_graph(dir)
    if r.ok {
        for i in 0..r.names.len() {
            owng.set(r.names[i], r.dirs[i])
        }
    }
    var all: Map[str, bool] = map()
    var files = [entry]
    for f in source_files(dir) {
        if f != entry {
            files.push(f)
        }
    }
    for f in files {
        let (ok, why, row) = effects_of_file(f, owng)
        if not ok {
            return (false, "package `{m.name}`: {why}", [])
        }
        for e in row {
            all.set(e, true)
        }
    }
    (true, "", effrows.sorted_keys(all))
}

fn effects_of_file(path: str, owng: Map[str, str]) -> (bool, str, [str]) {
    let l = loader.load_with(path, owng)
    if l.fatal != "" {
        return (false, l.fatal, [])
    }
    if l.diags.len() > 0 {
        return (false, "`{loader.tidy(path)}` — {l.diags[0]}", [])
    }
    let p = prog.build(l)
    let (c, t0) = sema.check_program(p)
    var t = t0
    if c.d_s.len() > 0 {
        return (false, "`{loader.tidy(path)}` — {c.d_msg[0]}", [])
    }
    (true, "", effects_of_program(p, c, t))
}

fn is_foreign(p: Prog, module: str) -> bool {
    for d in p.deps {
        if module == d or module.starts_with(d + ".") {
            return true
        }
    }
    false
}

/// What a program needs from outside its package: the rows of what escapes
/// it, its exports (and `unsafe` for each), its documentation examples, its
/// tests and benchmarks.
fn effects_of_program(p: Prog, c: Ck, inout t: Tys) -> [str] {
    let (vr, cr) = value_tables(c, t)
    let x = effrows.build_rows_only(p, vr, cr, p.deps)
    let entry_module = p.m_name[0]
    var all: Map[str, bool] = map()
    for i in 0..x.keys.len() {
        let module = x.module[i]
        if is_foreign(p, module) {
            continue
        }
        let d = x.decl[i]
        let name = prog.name(p, prog.sl(p, d, 2))
        let is_pub = prog.sl(p, d, 0) != 0
        let is_export = prog.sl(p, d, 1) != 0
        if is_pub or (module == entry_module and name == "main") or is_export {
            for e in x.rows[i] {
                all.set(e, true)
            }
        }
        if is_export {
            all.set("unsafe", true)
        }
    }
    for mi in 0..p.m_name.len() {
        let module = p.m_name[mi]
        if is_foreign(p, module) {
            continue
        }
        for d in p.m_decls[mi] {
            match p.docs.get(prog.s(p, d)) {
                Some(doc) -> {
                    for src in fenced_blocks(doc) {
                        for e in example_row(x, p, mi, module, src) {
                            all.set(e, true)
                        }
                    }
                }
                None -> ()
            }
        }
    }
    for mi in 0..p.m_name.len() {
        let module = p.m_name[mi]
        if is_foreign(p, module) {
            continue
        }
        for d in p.m_decls[mi] {
            let k = prog.kind(p, d)
            if k != ast.D_TEST and k != ast.D_BENCH {
                continue
            }
            let body = if k == ast.D_TEST { prog.sl(p, d, 1) } else { prog.sl(p, d, 0) }
            var f = Fnb{ at: map() }
            effrows.collect_fn_bindings(p, body, f)
            var row: Map[str, bool] = map()
            var active: [str] = []
            effrows.walk_block(x, p, mi, module, body, active, f, row)
            for e in row.keys() {
                all.set(e, true)
            }
        }
    }
    effrows.sorted_keys(all)
}

/// The row of one documentation example, run as the body of a function in
/// the module it documents; none when it does not parse.
fn example_row(x: Eff, p: Prog, mi: i64, module: str, src: str) -> [str] {
    let wrapped = "fn __doc_example() \{\n" + src + "\n}\n"
    let sb = wrapped.to_bytes()
    let lx = lex.lex(sb, true)
    let ps = parse.parse(sb, lx)
    if ps.d_s.len() > 0 {
        return []
    }
    let c2 = cst.build(ps)
    let mo = ast.build(c2, sb, ps.wide_ints, lx.doc_start, lx.doc_end, lx.doc_text)
    let fp = prog.fragment(mo, module, p.m_imp_alias[mi], p.m_imp_full[mi])
    var row: Map[str, bool] = map()
    for d in mo.decls {
        if prog.kind(fp, d) != ast.D_FN {
            continue
        }
        let body = prog.sl(fp, d, 9)
        var f = Fnb{ at: map() }
        effrows.collect_fn_bindings(fp, body, f)
        var active: [str] = []
        effrows.walk_block(x, fp, 0, module, body, active, f, row)
    }
    effrows.sorted_keys(row)
}

/// The fenced code blocks of a documentation comment that are Grasm: an
/// empty info string or `grasm`; `# ` hides a setup line's marker.
fn fenced_blocks(doc: str) -> [str] {
    var blocks: [str] = []
    var current: [str] = []
    var open = false
    var skipping = false
    for line in doc.lines() {
        let trimmed = line.trim_start()
        if trimmed.starts_with("```") {
            if skipping {
                skipping = false
                continue
            }
            if open {
                blocks.push(current.join("\n"))
                current = []
                open = false
            } else {
                let info = trimmed.substr(3, trimmed.len() - 3).trim()
                if info == "" or info == "grasm" {
                    open = true
                    current = []
                } else {
                    skipping = true
                }
            }
            continue
        }
        if open {
            if trimmed.starts_with("# ") {
                current.push(trimmed.substr(2, trimmed.len() - 2))
            } else {
                current.push(line)
            }
        }
    }
    if open {
        blocks.push(current.join("\n"))
    }
    blocks
}

/// Every `.gr` file under a directory, sorted.
fn source_files(dir: str) -> [str] {
    var out: [str] = []
    var seen: Map[str, bool] = map()
    collect_sources(dir, out, seen)
    out.sort()
    out
}

fn collect_sources(dir: str, inout out: [str], inout seen: Map[str, bool]) {
    let real = loader.tidy(dir)
    if seen.has(real) {
        return
    }
    seen.set(real, true)
    match list_dir(dir) {
        Ok(names) -> {
            for n in names {
                let path = loader.join(dir, n)
                match list_dir(path) {
                    Ok(_) -> collect_sources(path, out, seen)
                    Err(_) -> {
                        if n.to_lower().ends_with(".gr") {
                            out.push(path)
                        }
                    }
                }
            }
        }
        Err(_) -> ()
    }
}
