// Memory: `malloc` and its family over pages `memory.grow` adds, and the
// byte functions.
//
// Every block has a 16-byte header below the address it is given: its size
// class, and for a block `posix_memalign` aligned past 16, -1 and the block
// it was cut from. A class holds blocks of 16 to 1,024 bytes in steps of 16
// (classes 0 to 63), then the powers of two from 2,048 (64 on); a freed
// block goes to the head of its class's list, its first word the next, and
// is taken from there first. Memory is never given back: wasm cannot.
//
// Large private mappings -- `mmap`, which the runtime asks for a fiber's
// stack, 6.5 MiB -- are cut to their exact size, not to a power of two, and
// kept on a list of their own when unmapped, for the next of that length.
// Anonymous `mmap` promises zeroed memory: pages `memory.grow` has just
// added are zero by the specification and are not written; any other byte of
// a mapping -- one reused, or memory an earlier run of the playground used --
// is zeroed.
//
// When the memory cannot grow, the allocation is not answered with null,
// which the runtime would meet as a trap or a placeholder text: the heap
// moves to a reserve kept for this (`RESERVE`, set aside by
// `reserve_rescue`), and the program ends in the panic "memory allocation of
// N bytes failed" -- Rust's words for the same failure -- and exit 101,
// with room left to say so and to build the answer.

extern fn __wasm_memory_grow(pages: i64) -> i64
extern fn __wasm_memory_size() -> i64
extern fn __wasm_memcpy(dst: addr, src: addr, n: i64)
extern fn __wasm_memset(p: addr, c: i64, n: i64)
extern fn __wasm_heap_base() -> i64
extern fn grasm_panic_msg(p: addr, n: i64)

/// The first unused address, and the end of the memory, 0 until the first
/// allocation; the classes' list heads (a table of `NCLASSES` words).
process_local TOP: i64
process_local END: i64
process_local HEADS: i64
/// The large mappings unmapped, a list through their headers' second word.
process_local BIG: i64
/// The reserve's first address and its end, 0 when none was set aside;
/// whether the heap has moved into it.
process_local RESERVE: i64
process_local RESERVE_END: i64
process_local RESCUED: i64

let NCLASSES = 96
let PAGE = 65536

/// The class of a block of `total` bytes, header included.
fn class_of(total: i64) -> i64 {
    if total <= 1024 {
        return (total + 15) / 16 - 1
    }
    var c = 64
    var size = 2048
    while size < total {
        size = size * 2
        c += 1
    }
    c
}

fn class_size(c: i64) -> i64 {
    if c < 64 {
        return 16 * (c + 1)
    }
    2048.shl(c - 64)
}

/// `n` bytes at the top of the heap, the memory grown to hold them; when it
/// cannot grow, the heap moved to the reserve and the program ended in the
/// out-of-memory panic.
fn carve(n: i64) -> i64 {
    let at = carve_or_0(n)
    if at != 0 {
        return at
    }
    out_of_memory(n)
    0
}

/// The end of the memory the heap was last given, before `carve` grows it:
/// what lies below is not known to be zero.
fn known_end() -> i64 {
    unsafe {
        if mem_process(TOP).atomic_load_i64(Acquire) == 0 {
            return __wasm_memory_size() * PAGE
        }
        mem_process(END).atomic_load_i64(Acquire)
    }
}

/// The memory cannot hold `n` bytes more. The first time, the heap moves to
/// the reserve, and the panic is said from there; past that, nothing can be
/// said.
fn out_of_memory(n: i64) {
    unsafe {
        if mem_process(RESCUED).atomic_load_i64(Acquire) != 0 {
            return
        }
        mem_process(RESCUED).atomic_store_i64(1, Release)
        let r = mem_process(RESERVE).atomic_load_i64(Acquire)
        if r != 0 {
            mem_process(TOP).atomic_store_i64(r, Release)
            mem_process(END).atomic_store_i64(mem_process(RESERVE_END).atomic_load_i64(Acquire), Release)
        }
        // "memory allocation of N bytes failed", N's digits written by hand:
        // nothing here may need the heap twice.
        let msg = carve_or_0(64)
        if msg == 0 {
            return
        }
        let hn = mem_static_len("memory allocation of ")
        __wasm_memcpy(mem_addr(msg), mem_static("memory allocation of "), hn)
        var digits = 1
        var v = n
        while v >= 10 {
            v = v / 10
            digits += 1
        }
        var k = digits
        v = n
        while k > 0 {
            mem_addr(msg + hn + k - 1).store_u8((48 + v % 10).as_u8())
            v = v / 10
            k -= 1
        }
        let tn = mem_static_len(" bytes failed")
        __wasm_memcpy(mem_addr(msg + hn + digits), mem_static(" bytes failed"), tn)
        grasm_panic_msg(mem_addr(msg), hn + digits + tn)
    }
}

/// `n` bytes set aside at the top of the heap for `out_of_memory` to move
/// to: a run's first act (`reset.wasm_begin`). False when there is no room
/// even for that.
pub fn reserve_rescue(n: i64) -> bool {
    let r = carve_or_0(n)
    if r == 0 {
        return false
    }
    unsafe {
        mem_process(RESERVE).atomic_store_i64(r, Release)
        mem_process(RESERVE_END).atomic_store_i64(r + n, Release)
    }
    true
}

/// `carve`, answering 0 when the memory cannot grow.
fn carve_or_0(n: i64) -> i64 {
    unsafe {
        var top = mem_process(TOP).atomic_load_i64(Acquire)
        var end = mem_process(END).atomic_load_i64(Acquire)
        if top == 0 {
            top = (__wasm_heap_base() + 15) / 16 * 16
            end = __wasm_memory_size() * PAGE
            mem_process(END).atomic_store_i64(end, Release)
        }
        if top + n > end {
            let pages = (top + n - end + PAGE - 1) / PAGE
            if __wasm_memory_grow(pages) < 0 {
                mem_process(TOP).atomic_store_i64(top, Release)
                return 0
            }
            end = end + pages * PAGE
            mem_process(END).atomic_store_i64(end, Release)
        }
        mem_process(TOP).atomic_store_i64(top + n, Release)
        top
    }
}

/// The heap begun again at `top`, every block below it the caller's, none
/// free (`reset.wasm_begin`); the memory already grown kept.
pub fn restart(top: i64) {
    unsafe {
        mem_process(TOP).atomic_store_i64(top, Release)
        mem_process(END).atomic_store_i64(__wasm_memory_size() * PAGE, Release)
        mem_process(HEADS).atomic_store_i64(0, Release)
    }
}

/// The list heads' table, made on first use.
fn heads() -> addr {
    unsafe {
        let h = mem_process(HEADS).atomic_load_i64(Acquire)
        if h != 0 {
            return mem_addr(h)
        }
        let t = carve(8 * NCLASSES)
        __wasm_memset(mem_addr(t), 0, 8 * NCLASSES)
        mem_process(HEADS).atomic_store_i64(t, Release)
        mem_addr(t)
    }
}

export fn malloc(n: i64) -> addr {
    unsafe {
        if n < 0 or n > 2147483648 {
            return mem_addr(0)
        }
        let c = class_of(n + 16)
        if c >= NCLASSES {
            return mem_addr(0)
        }
        let h = heads().offset(8 * c)
        let free = h.load_i64()
        var block = 0
        if free != 0 {
            h.store_i64(mem_addr(free).offset(16).load_i64())
            block = free
        } else {
            block = carve(class_size(c))
            if block == 0 {
                return mem_addr(0)
            }
        }
        mem_addr(block).store_i64(c)
        mem_addr(block).offset(8).store_i64(n)
        mem_addr(block + 16)
    }
}

export fn free(p: addr) {
    unsafe {
        if p.as_i64() == 0 {
            return
        }
        let block = p.offset(-16)
        let c = block.load_i64()
        if c == -1 {
            free(mem_addr(block.offset(8).load_i64()))
            return
        }
        let h = heads().offset(8 * c)
        block.offset(16).store_i64(h.load_i64())
        h.store_i64(block.as_i64())
    }
}

/// `malloc` and `free` for the library's own use (an `export fn` is the C
/// symbol, not a module's function).
pub fn take(n: i64) -> addr {
    malloc(n)
}

pub fn give(p: addr) {
    free(p)
}

export fn calloc(n: i64, size: i64) -> addr {
    unsafe {
        let total = n * size
        let p = malloc(total)
        if p.as_i64() != 0 {
            __wasm_memset(p, 0, total)
        }
        p
    }
}

/// What the block at `p` can hold.
fn capacity(p: addr) -> i64 {
    unsafe {
        let c = p.offset(-16).load_i64()
        if c == -1 {
            return p.offset(-8).load_i64()
        }
        class_size(c) - 16
    }
}

export fn realloc(p: addr, n: i64) -> addr {
    unsafe {
        if p.as_i64() == 0 {
            return malloc(n)
        }
        let cap = capacity(p)
        if n <= cap and p.offset(-16).load_i64() != -1 {
            p.offset(-8).store_i64(n)
            return p
        }
        let q = malloc(n)
        if q.as_i64() == 0 {
            return q
        }
        __wasm_memcpy(q, p, if n < cap { n } else { cap })
        free(p)
        q
    }
}

/// `size` bytes at a multiple of `align` into `*out`: 0, or 12 (`ENOMEM`).
export fn posix_memalign(out: addr, align: i64, size: i64) -> i32 {
    unsafe {
        if align <= 16 {
            let p = malloc(size)
            out.store_i64(p.as_i64())
            return if p.as_i64() == 0 { 12.as_i32() } else { 0.as_i32() }
        }
        let raw = malloc(size + align + 16)
        if raw.as_i64() == 0 {
            return 12.as_i32()
        }
        let at = (raw.as_i64() + 16 + align - 1) / align * align
        mem_addr(at - 16).store_i64(-1)
        mem_addr(at - 8).store_i64(raw.as_i64())
        out.store_i64(at)
        0.as_i32()
    }
}

/// Private anonymous memory, zeroed: the only kind the runtime maps (its
/// fibers' stacks; a program's module never starts one, the playground's
/// does).
export fn mmap(a: addr, len: i64, prot: i32, flags: i32, fd: i32, off: i64) -> addr {
    if len >= BIG_MAP {
        return map_big(len)
    }
    unsafe {
        let out = malloc(8)
        if posix_memalign(out, 16384, len) != 0 {
            free(out)
            return mem_addr(-1)
        }
        let p = mem_addr(out.load_i64())
        free(out)
        __wasm_memset(p, 0, len)
        p
    }
}

export fn munmap(a: addr, len: i64) -> i32 {
    if len >= BIG_MAP {
        unsafe {
            a.offset(-8).store_i64(mem_process(BIG).atomic_load_i64(Acquire))
            mem_process(BIG).atomic_store_i64(a.as_i64(), Release)
        }
        return 0.as_i32()
    }
    free(a)
    0.as_i32()
}

/// A mapping this long or longer is a large one.
let BIG_MAP = 65536
/// A large mapping's alignment: the runtime's page.
let BIG_ALIGN = 16384

/// A large mapping of exactly `len` bytes at a multiple of `BIG_ALIGN`,
/// zeroed: one unmapped before of that length, zeroed again, or new from the
/// top of the heap, of which only what lay below the memory's last known end
/// is written -- above it, `memory.grow` has just made it zero. Its header,
/// the 16 bytes below it: its length, and the list's next.
fn map_big(len: i64) -> addr {
    unsafe {
        var prev = 0
        var b = mem_process(BIG).atomic_load_i64(Acquire)
        while b != 0 {
            let next = mem_addr(b - 8).load_i64()
            if mem_addr(b - 16).load_i64() == len {
                if prev == 0 {
                    mem_process(BIG).atomic_store_i64(next, Release)
                } else {
                    mem_addr(prev - 8).store_i64(next)
                }
                __wasm_memset(mem_addr(b), 0, len)
                return mem_addr(b)
            }
            prev = b
            b = next
        }
        let fresh_from = known_end()
        let top = carve(len + BIG_ALIGN + 16)
        let at = (top + 16 + BIG_ALIGN - 1) / BIG_ALIGN * BIG_ALIGN
        mem_addr(at - 16).store_i64(len)
        mem_addr(at - 8).store_i64(0)
        if fresh_from > at {
            let dirty = if fresh_from < at + len { fresh_from - at } else { len }
            __wasm_memset(mem_addr(at), 0, dirty)
        }
        mem_addr(at)
    }
}

export fn mprotect(a: addr, len: i64, prot: i32) -> i32 {
    0.as_i32()
}

export fn memcpy(dst: addr, src: addr, n: i64) -> addr {
    unsafe { __wasm_memcpy(dst, src, n) }
    dst
}

export fn memset(p: addr, c: i32, n: i64) -> addr {
    unsafe { __wasm_memset(p, c.as_i64(), n) }
    p
}

export fn memcmp(a: addr, b: addr, n: i64) -> i32 {
    unsafe {
        var i = 0
        while i < n {
            let x = a.offset(i).load_u8().as_i64()
            let y = b.offset(i).load_u8().as_i64()
            if x != y {
                return (x - y).as_i32()
            }
            i += 1
        }
    }
    0.as_i32()
}

export fn memchr(p: addr, c: i32, n: i64) -> addr {
    unsafe {
        let want = c.as_i64().bit_and(255)
        var i = 0
        while i < n {
            if p.offset(i).load_u8().as_i64() == want {
                return p.offset(i)
            }
            i += 1
        }
        mem_addr(0)
    }
}

export fn strlen(p: addr) -> i64 {
    var n = 0
    unsafe {
        while p.offset(n).load_u8().as_i64() != 0 {
            n += 1
        }
    }
    n
}
