// The libm the runtime calls (docs/self-hosting.md §6.24, decision (6)):
// musl's functions as Rust's `libm` crate writes them -- the code rustc links
// into a `wasm32-unknown-unknown` program, so the Rust playground's own --
// ported to Grasm, line for line, constant for constant, and held to that
// module's answers bit for bit by `scripts/fuzz_wasmmath.sh`. Most are
// FreeBSD's msun (Sun's fdlibm, 1993); `cbrt` is CORE-MATH's correctly
// rounded one. `floor`, `ceil` and `sqrt` are WebAssembly instructions,
// exact, as the crate's are on this target; `fmod`, `round`, `fmin` and
// `fmax` are exact operations, written here as the crate's generic ones are.
//
// This is not the plan's own libm (§4's Math row, §10's decision 2: a
// correctly rounded one in Grasm, on every platform), which replaces it in
// the end; it is the libm the playground already has, so that a module the
// Grasm backend builds answers as the Rust-built one does.
//
// A word's high and low halves are read as the C code reads its `u32`s and
// `i32`s: `hi_s` the high half sign-extended, `hi_u` and `lo_u` unsigned, and
// 32-bit arithmetic wraps through `sx32`. A negation flips the sign bit
// (`neg`), never `0.0 - x`, which loses -0.0.

import mem

fn neg(x: f64) -> f64 {
    x.to_bits().bit_xor(1.shl(63)).from_bits()
}

fn hi_s(x: f64) -> i64 {
    x.to_bits().shr(32)
}

fn hi_u(x: f64) -> i64 {
    x.to_bits().ushr(32)
}

fn lo_u(x: f64) -> i64 {
    x.to_bits().bit_and(4294967295)
}

/// The low 32 bits of `v`, read as a signed 32-bit number.
fn sx32(v: i64) -> i64 {
    let m = v.bit_and(4294967295)
    if m >= 2147483648 { m - 4294967296 } else { m }
}

fn set_lo(x: f64, lo: i64) -> f64 {
    x.to_bits().bit_and(-4294967296).bit_or(lo.bit_and(4294967295)).from_bits()
}

fn set_hi(x: f64, hi: i64) -> f64 {
    hi.bit_and(4294967295).shl(32).bit_or(x.to_bits().bit_and(4294967295)).from_bits()
}

/// The double of high and low words.
fn words(hi: i64, lo: i64) -> f64 {
    hi.bit_and(4294967295).shl(32).bit_or(lo.bit_and(4294967295)).from_bits()
}

/// `x as i32` of a double in range: toward zero.
fn to_int(x: f64) -> i64 {
    x.as_i64()
}

fn copysign(x: f64, y: f64) -> f64 {
    x.to_bits().bit_and(9223372036854775807).bit_or(y.to_bits().bit_and(1.shl(63))).from_bits()
}

fn trunc(x: f64) -> f64 {
    if x.is_nan() {
        return x
    }
    if x < 0.0 { x.ceil() } else { x.floor() }
}

// ----- scalbn -----------------------------------------------------------------------

pub fn scalbn(x0: f64, n0: i64) -> f64 {
    var x = x0
    var n = n0
    if n > 1023 {
        x = x * 9214364837600034816.from_bits()
        n -= 1023
        if n > 1023 {
            x = x * 9214364837600034816.from_bits()
            n -= 1023
            if n > 1023 {
                n = 1023
            }
        }
    } else if n < -1022 {
        // 2^-1022 * 2^53.
        let mul = 4503599627370496.from_bits() * 4845873199050653696.from_bits()
        x = x * mul
        n += 969
        if n < -1022 {
            x = x * mul
            n += 969
            if n < -1022 {
                n = -1022
            }
        }
    }
    x * (1023 + n).shl(52).from_bits()
}

// ----- sin, cos, tan -----------------------------------------------------------------

let S1 = -1.66666666666666324348e-01
let S2 = 8.33333333332248946124e-03
let S3 = -1.98412698298579493134e-04
let S4 = 2.75573137070700676789e-06
let S5 = -2.50507602534068634195e-08
let S6 = 1.58969099521155010221e-10

fn k_sin(x: f64, y: f64, iy: i64) -> f64 {
    let z = x * x
    let w = z * z
    let r = S2 + z * (S3 + z * S4) + z * w * (S5 + z * S6)
    let v = z * x
    if iy == 0 {
        x + v * (S1 + z * r)
    } else {
        x - ((z * (0.5 * y - v * r) - y) - v * S1)
    }
}

let C1 = 4.16666666666666019037e-02
let C2 = -1.38888888888741095749e-03
let C3 = 2.48015872894767294178e-05
let C4 = -2.75573143513906633035e-07
let C5 = 2.08757232129817482790e-09
let C6 = -1.13596475577881948265e-11

fn k_cos(x: f64, y: f64) -> f64 {
    let z = x * x
    let w = z * z
    let r = z * (C1 + z * (C2 + z * C3)) + w * w * (C4 + z * (C5 + z * C6))
    let hz = 0.5 * z
    let w2 = 1.0 - hz
    w2 + (((1.0 - w2) - hz) + (z * r - x * y))
}

fn tt(i: i64) -> f64 {
    match i {
        0 -> 3.33333333333334091986e-01
        1 -> 1.33333333333201242699e-01
        2 -> 5.39682539762260521377e-02
        3 -> 2.18694882948595424599e-02
        4 -> 8.86323982359930005737e-03
        5 -> 3.59207910759131235356e-03
        6 -> 1.45620945432529025516e-03
        7 -> 5.88041240820264096874e-04
        8 -> 2.46463134818469906812e-04
        9 -> 7.81794442939557092300e-05
        10 -> 7.14072491382608190305e-05
        11 -> -1.85586374855275456654e-05
        _ -> 2.59073051863633712884e-05
    }
}

let PIO4 = 7.85398163397448278999e-01
let PIO4_LO = 3.06161699786838301793e-17

fn zero_low(x: f64) -> f64 {
    x.to_bits().bit_and(-4294967296).from_bits()
}

fn k_tan(x0: f64, y0: f64, odd: i64) -> f64 {
    var x = x0
    var y = y0
    let hx = hi_u(x)
    let big = hx.bit_and(2147483647) >= 1072010280
    if big {
        if hx.ushr(31) != 0 {
            x = neg(x)
            y = neg(y)
        }
        x = (PIO4 - x) + (PIO4_LO - y)
        y = 0.0
    }
    let z = x * x
    let w = z * z
    let r0 = tt(1) + w * (tt(3) + w * (tt(5) + w * (tt(7) + w * (tt(9) + w * tt(11)))))
    let v0 = z * (tt(2) + w * (tt(4) + w * (tt(6) + w * (tt(8) + w * (tt(10) + w * tt(12))))))
    let s = z * x
    let r = y + z * (s * (r0 + v0) + y) + s * tt(0)
    let w2 = x + r
    if big {
        let s2 = 1.0 - 2.0 * odd.as_f64()
        let v = s2 - 2.0 * (x + (r - w2 * w2 / (w2 + s2)))
        return if hx.ushr(31) != 0 { neg(v) } else { v }
    }
    if odd == 0 {
        return w2
    }
    let w0 = zero_low(w2)
    let v = r - (w0 - x)
    let a = -1.0 / w2
    let a0 = zero_low(a)
    a0 + a * (1.0 + a0 * w0 + a0 * v)
}

let INV_PIO2 = 6.36619772367581382433e-01
let PIO2_1 = 1.57079632673412561417e+00
let PIO2_1T = 6.07710050650619224932e-11
let PIO2_2 = 6.07710050630396597660e-11
let PIO2_2T = 2.02226624879595063154e-21
let PIO2_3 = 2.02226624871116645580e-21
let PIO2_3T = 8.47842766036889956997e-32
/// 1.5 / 2^-52.
let TO_INT = 6755399441055744.0

/// `rem_pio2`'s answer: the quadrant and the two parts of the reduced
/// argument.
type Red = {
    n: i64,
    y0: f64,
    y1: f64,
}

fn medium(x: f64, ix: i64) -> Red {
    let tmp = x * INV_PIO2 + TO_INT
    let f_n = tmp - TO_INT
    let n = to_int(f_n)
    var r = x - f_n * PIO2_1
    var w = f_n * PIO2_1T
    var y0 = r - w
    let ey = y0.to_bits().ushr(52).bit_and(2047)
    let ex = ix.ushr(20)
    if ex - ey > 16 {
        var t = r
        w = f_n * PIO2_2
        r = t - w
        w = f_n * PIO2_2T - ((t - r) - w)
        y0 = r - w
        let ey2 = y0.to_bits().ushr(52).bit_and(2047)
        if ex - ey2 > 49 {
            t = r
            w = f_n * PIO2_3
            r = t - w
            w = f_n * PIO2_3T - ((t - r) - w)
            y0 = r - w
        }
    }
    let y1 = (r - y0) - w
    Red{ n: n, y0: y0, y1: y1 }
}

fn near(x: f64, k: i64, sign: i64) -> Red {
    let kf = k.as_f64()
    if sign == 0 {
        let z = x - kf * PIO2_1
        let y0 = z - kf * PIO2_1T
        let y1 = (z - y0) - kf * PIO2_1T
        Red{ n: k, y0: y0, y1: y1 }
    } else {
        let z = x + kf * PIO2_1
        let y0 = z + kf * PIO2_1T
        let y1 = (z - y0) + kf * PIO2_1T
        Red{ n: 0 - k, y0: y0, y1: y1 }
    }
}

fn rem_pio2(x: f64) -> Red {
    let sign = x.to_bits().ushr(63)
    let ix = hi_u(x).bit_and(2147483647)
    if ix <= 1074752122 {
        if ix.bit_and(1048575) == 598523 {
            return medium(x, ix)
        }
        if ix <= 1073928572 {
            return near(x, 1, sign)
        }
        return near(x, 2, sign)
    }
    if ix <= 1075594811 {
        if ix <= 1075183036 {
            if ix == 1074977148 {
                return medium(x, ix)
            }
            return near(x, 3, sign)
        }
        if ix == 1075388923 {
            return medium(x, ix)
        }
        return near(x, 4, sign)
    }
    if ix < 1094263291 {
        return medium(x, ix)
    }
    if ix >= 2146435072 {
        let y = x - x
        return Red{ n: 0, y0: y, y1: y }
    }
    // z = scalbn(|x|, -ilogb(x) + 23), cut into 24-bit pieces.
    var ui = x.to_bits()
    ui = ui.bit_and(4503599627370495)
    ui = ui.bit_or(1046.shl(52))
    var z = ui.from_bits()
    var tx0 = to_int(z).as_f64()
    z = (z - tx0) * 16777216.0
    var tx1 = to_int(z).as_f64()
    z = (z - tx1) * 16777216.0
    let tx2 = z
    var nx = 3
    if tx2 == 0.0 {
        nx = 2
        if tx1 == 0.0 {
            nx = 1
        }
    }
    let r = rem_pio2_large(tx0, tx1, tx2, nx, ix.ushr(20) - 1046)
    if sign != 0 {
        return Red{ n: 0 - r.n, y0: neg(r.y0), y1: neg(r.y1) }
    }
    r
}

/// `ipio2`: 2/pi's bits, 24 at a time (the table for a double's
/// exponents).
fn ipio2(i: i64) -> i64 {
    match i {
        0 -> 10680707
        1 -> 7228996
        2 -> 1387004
        3 -> 2578385
        4 -> 16069853
        5 -> 12639074
        6 -> 9804092
        7 -> 4427841
        8 -> 16666979
        9 -> 11263675
        10 -> 12935607
        11 -> 2387514
        12 -> 4345298
        13 -> 14681673
        14 -> 3074569
        15 -> 13734428
        16 -> 16653803
        17 -> 1880361
        18 -> 10960616
        19 -> 8533493
        20 -> 3062596
        21 -> 8710556
        22 -> 7349940
        23 -> 6258241
        24 -> 3772886
        25 -> 3769171
        26 -> 3798172
        27 -> 8675211
        28 -> 12450088
        29 -> 3874808
        30 -> 9961438
        31 -> 366607
        32 -> 15675153
        33 -> 9132554
        34 -> 7151469
        35 -> 3571407
        36 -> 2607881
        37 -> 12013382
        38 -> 4155038
        39 -> 6285869
        40 -> 7677882
        41 -> 13102053
        42 -> 15825725
        43 -> 473591
        44 -> 9065106
        45 -> 15363067
        46 -> 6271263
        47 -> 9264392
        48 -> 5636912
        49 -> 4652155
        50 -> 7056368
        51 -> 13614112
        52 -> 10155062
        53 -> 1944035
        54 -> 9527646
        55 -> 15080200
        56 -> 6658437
        57 -> 6231200
        58 -> 6832269
        59 -> 16767104
        60 -> 5075751
        61 -> 3212806
        62 -> 1398474
        63 -> 7579849
        64 -> 6349435
        _ -> 12618859
    }
}

fn pio2t(i: i64) -> f64 {
    match i {
        0 -> 1.57079625129699707031e+00
        1 -> 7.54978941586159635335e-08
        2 -> 5.39030252995776476554e-15
        3 -> 3.28200341580791294123e-22
        4 -> 1.27065575308067607349e-29
        5 -> 1.22933308981111328932e-36
        6 -> 2.73370053816464559624e-44
        _ -> 2.16741683877804819444e-51
    }
}

fn fget(a: addr, i: i64) -> f64 {
    unsafe { a.offset(8 * i).load_f64() }
}

fn fput(a: addr, i: i64, v: f64) {
    unsafe { a.offset(8 * i).store_f64(v) }
}

fn iget(a: addr, i: i64) -> i64 {
    unsafe { a.offset(8 * i).load_i64() }
}

fn iput(a: addr, i: i64, v: i64) {
    unsafe { a.offset(8 * i).store_i64(v) }
}

/// FreeBSD's `__kernel_rem_pio2` for a double (`prec` 1): `x`'s 24-bit
/// pieces `xs`, `e0` its exponent less 23. Its arrays are raw memory, 20
/// words each, freed before it answers.
fn rem_pio2_large(x0: f64, x1: f64, x2: f64, nx: i64, e0: i64) -> Red {
    let xs = mem.take(8 * 3)
    let f = mem.take(8 * 20)
    let fq = mem.take(8 * 20)
    let q = mem.take(8 * 20)
    let iq = mem.take(8 * 20)
    fput(xs, 0, x0)
    fput(xs, 1, x1)
    fput(xs, 2, x2)
    let x1p24 = 16777216.0
    let x1p_24 = 5.9604644775390625e-08
    let jk = 4
    let jp = jk
    let jx = nx - 1
    var jv = (e0 - 3) / 24
    if e0 - 3 < 0 and (e0 - 3) % 24 != 0 {
        jv -= 1
    }
    if jv < 0 {
        jv = 0
    }
    var q0 = e0 - 24 * (jv + 1)
    var j = jv - jx
    let m = jx + jk
    for i in 0..(m + 1) {
        fput(f, i, if j < 0 { 0.0 } else { ipio2(j).as_f64() })
        j += 1
    }
    for i in 0..(jk + 1) {
        var fw = 0.0
        for k in 0..(jx + 1) {
            fw += fget(xs, k) * fget(f, jx + i - k)
        }
        fput(q, i, fw)
    }
    var jz = jk
    var z = 0.0
    var n = 0
    var ih = 0
    var again = true
    while again {
        again = false
        var i = 0
        z = fget(q, jz)
        var jj = jz
        while jj >= 1 {
            let fw = to_int(x1p_24 * z).as_f64()
            iput(iq, i, to_int(z - x1p24 * fw))
            z = fget(q, jj - 1) + fw
            i += 1
            jj -= 1
        }
        z = scalbn(z, q0)
        z = z - 8.0 * (z * 0.125).floor()
        n = to_int(z)
        z = z - n.as_f64()
        ih = 0
        if q0 > 0 {
            let t = iget(iq, jz - 1).shr(24 - q0)
            n += t
            iput(iq, jz - 1, iget(iq, jz - 1) - t.shl(24 - q0))
            ih = iget(iq, jz - 1).shr(23 - q0)
        } else if q0 == 0 {
            ih = iget(iq, jz - 1).shr(23)
        } else if z >= 0.5 {
            ih = 2
        }
        if ih > 0 {
            n += 1
            var carry = 0
            for k in 0..jz {
                let w = iget(iq, k)
                if carry == 0 {
                    if w != 0 {
                        carry = 1
                        iput(iq, k, 16777216 - w)
                    }
                } else {
                    iput(iq, k, 16777215 - w)
                }
            }
            if q0 > 0 {
                if q0 == 1 {
                    iput(iq, jz - 1, iget(iq, jz - 1).bit_and(8388607))
                } else if q0 == 2 {
                    iput(iq, jz - 1, iget(iq, jz - 1).bit_and(4194303))
                }
            }
            if ih == 2 {
                z = 1.0 - z
                if carry != 0 {
                    z = z - scalbn(1.0, q0)
                }
            }
        }
        if z == 0.0 {
            var w = 0
            var k = jz - 1
            while k >= jk {
                w = w.bit_or(iget(iq, k))
                k -= 1
            }
            if w == 0 {
                var kk = 1
                while iget(iq, jk - kk) == 0 {
                    kk += 1
                }
                for ii in (jz + 1)..(jz + kk + 1) {
                    fput(f, jx + ii, ipio2(jv + ii).as_f64())
                    var fw = 0.0
                    for k2 in 0..(jx + 1) {
                        fw += fget(xs, k2) * fget(f, jx + ii - k2)
                    }
                    fput(q, ii, fw)
                }
                jz += kk
                again = true
            }
        }
    }
    if z == 0.0 {
        jz -= 1
        q0 -= 24
        while iget(iq, jz) == 0 {
            jz -= 1
            q0 -= 24
        }
    } else {
        z = scalbn(z, 0 - q0)
        if z >= x1p24 {
            let fw = to_int(x1p_24 * z).as_f64()
            iput(iq, jz, to_int(z - x1p24 * fw))
            jz += 1
            q0 += 24
            iput(iq, jz, to_int(fw))
        } else {
            iput(iq, jz, to_int(z))
        }
    }
    var fw = scalbn(1.0, q0)
    var i = jz
    while i >= 0 {
        fput(q, i, fw * iget(iq, i).as_f64())
        fw = fw * x1p_24
        i -= 1
    }
    i = jz
    while i >= 0 {
        fw = 0.0
        var k = 0
        while k <= jp and k <= jz - i {
            fw += pio2t(k) * fget(q, i + k)
            k += 1
        }
        fput(fq, jz - i, fw)
        i -= 1
    }
    fw = 0.0
    i = jz
    while i >= 0 {
        fw += fget(fq, i)
        i -= 1
    }
    let y0 = if ih == 0 { fw } else { neg(fw) }
    fw = fget(fq, 0) - fw
    for k in 1..(jz + 1) {
        fw += fget(fq, k)
    }
    let y1 = if ih == 0 { fw } else { neg(fw) }
    mem.give(xs)
    mem.give(f)
    mem.give(fq)
    mem.give(q)
    mem.give(iq)
    Red{ n: n.bit_and(7), y0: y0, y1: y1 }
}

export fn sin(x: f64) -> f64 {
    let ix = hi_u(x).bit_and(2147483647)
    if ix <= 1072243195 {
        if ix < 1045430272 {
            return x
        }
        return k_sin(x, 0.0, 0)
    }
    if ix >= 2146435072 {
        return x - x
    }
    let r = rem_pio2(x)
    let q = r.n.bit_and(3)
    if q == 0 {
        k_sin(r.y0, r.y1, 1)
    } else if q == 1 {
        k_cos(r.y0, r.y1)
    } else if q == 2 {
        neg(k_sin(r.y0, r.y1, 1))
    } else {
        neg(k_cos(r.y0, r.y1))
    }
}

export fn cos(x: f64) -> f64 {
    let ix = hi_u(x).bit_and(2147483647)
    if ix <= 1072243195 {
        if ix < 1044816030 {
            if to_int(x) == 0 {
                return 1.0
            }
        }
        return k_cos(x, 0.0)
    }
    if ix >= 2146435072 {
        return x - x
    }
    let r = rem_pio2(x)
    let q = r.n.bit_and(3)
    if q == 0 {
        k_cos(r.y0, r.y1)
    } else if q == 1 {
        neg(k_sin(r.y0, r.y1, 1))
    } else if q == 2 {
        neg(k_cos(r.y0, r.y1))
    } else {
        k_sin(r.y0, r.y1, 1)
    }
}

export fn tan(x: f64) -> f64 {
    let ix = hi_u(x).bit_and(2147483647)
    if ix <= 1072243195 {
        if ix < 1044381696 {
            return x
        }
        return k_tan(x, 0.0, 0)
    }
    if ix >= 2146435072 {
        return x - x
    }
    let r = rem_pio2(x)
    k_tan(r.y0, r.y1, r.n.bit_and(1))
}

// ----- exp, expm1 ------------------------------------------------------------------

let LN2HI = 6.93147180369123816490e-01
let LN2LO = 1.90821492927058770002e-10
let INVLN2 = 1.44269504088896338700e+00
let P1 = 1.66666666666666019037e-01
let P2 = -2.77777777770155933842e-03
let P3 = 6.61375632143793436117e-05
let P4 = -1.65339022054652515390e-06
let P5 = 4.13813679705723846039e-08

export fn exp(x0: f64) -> f64 {
    var x = x0
    var hx = hi_u(x)
    let sign = hx.ushr(31)
    hx = hx.bit_and(2147483647)
    if hx >= 1082532651 {
        if x.is_nan() {
            return x
        }
        if x > 709.782712893383973096 {
            return x * 9214364837600034816.from_bits()
        }
        if x < -708.39641853226410622 {
            if x < -745.13321910194110842 {
                return 0.0
            }
        }
    }
    var k = 0
    var hi = 0.0
    var lo = 0.0
    if hx > 1071001154 {
        if hx >= 1072734898 {
            k = to_int(INVLN2 * x + (if sign == 0 { 0.5 } else { -0.5 }))
        } else {
            k = 1 - sign - sign
        }
        hi = x - k.as_f64() * LN2HI
        lo = k.as_f64() * LN2LO
        x = hi - lo
    } else if hx > 1043333120 {
        k = 0
        hi = x
        lo = 0.0
    } else {
        return 1.0 + x
    }
    let xx = x * x
    let c = x - xx * (P1 + xx * (P2 + xx * (P3 + xx * (P4 + xx * P5))))
    let y = 1.0 + (x * c / (2.0 - c) - lo + hi)
    if k == 0 { y } else { scalbn(y, k) }
}

let O_THRESHOLD = 7.09782712893383973096e+02
let Q1 = -3.33333333333331316428e-02
let Q2 = 1.58730158725481460165e-03
let Q3 = -7.93650757867487942473e-05
let Q4 = 4.00821782732936239552e-06
let Q5 = -2.01099218183624371326e-07

fn expm1(x0: f64) -> f64 {
    var x = x0
    let hx = x.to_bits().ushr(32).bit_and(2147483647)
    let sign = x.to_bits().ushr(63)
    if hx >= 1078159482 {
        if x.is_nan() {
            return x
        }
        if sign != 0 {
            return -1.0
        }
        if x > O_THRESHOLD {
            return x * 9214364837600034816.from_bits()
        }
    }
    var hi = 0.0
    var lo = 0.0
    var k = 0
    var c = 0.0
    if hx > 1071001154 {
        if hx < 1072734898 {
            if sign == 0 {
                hi = x - LN2HI
                lo = LN2LO
                k = 1
            } else {
                hi = x + LN2HI
                lo = neg(LN2LO)
                k = -1
            }
        } else {
            k = to_int(INVLN2 * x + (if sign != 0 { -0.5 } else { 0.5 }))
            let t = k.as_f64()
            hi = x - t * LN2HI
            lo = t * LN2LO
        }
        x = hi - lo
        c = (hi - x) - lo
    } else if hx < 1016070144 {
        return x
    } else {
        c = 0.0
        k = 0
    }
    let hfx = 0.5 * x
    let hxs = x * hfx
    let r1 = 1.0 + hxs * (Q1 + hxs * (Q2 + hxs * (Q3 + hxs * (Q4 + hxs * Q5))))
    let t = 3.0 - r1 * hfx
    var e = hxs * ((r1 - t) / (6.0 - x * t))
    if k == 0 {
        return x - (x * e - hxs)
    }
    e = x * (e - c) - c
    e = e - hxs
    if k == -1 {
        return 0.5 * (x - e) - 0.5
    }
    if k == 1 {
        if x < -0.25 {
            return -2.0 * (e - (x + 0.5))
        }
        return 1.0 + 2.0 * (x - e)
    }
    let twopk = (1023 + k).shl(52).from_bits()
    if k < 0 or k > 56 {
        var y = x - e + 1.0
        if k == 1024 {
            y = y * 2.0 * 9214364837600034816.from_bits()
        } else {
            y = y * twopk
        }
        return y - 1.0
    }
    let uf = (1023 - k).shl(52).from_bits()
    if k < 20 {
        (x - e + (1.0 - uf)) * twopk
    } else {
        (x - (e + uf) + 1.0) * twopk
    }
}

/// `exp(x - k ln2) * 2^(k-1)` for k = 2043, done as two halves.
fn k_expo2(x: f64) -> f64 {
    let kln2 = 4653942887746821515.from_bits()
    let scale = (1023 + 1021).shl(52).from_bits()
    exp(x - kln2) * scale * scale
}

// ----- log, log2, log10 ------------------------------------------------------------

let LG1 = 6.666666666666735130e-01
let LG2 = 3.999999999940941908e-01
let LG3 = 2.857142874366239149e-01
let LG4 = 2.222219843214978396e-01
let LG5 = 1.818357216161805012e-01
let LG6 = 1.531383769920937332e-01
let LG7 = 1.479819860511658591e-01

/// The reduction the three logarithms share: `x` as 2^k * (1 + f) with
/// 1 + f in [sqrt(2)/2, sqrt(2)], or the answer itself for zero, a negative,
/// an infinity, a NaN or one (`done`).
type LogRed = {
    done: bool,
    v: f64,
    k: i64,
    f: f64,
}

fn log_reduce(x0: f64) -> LogRed {
    var x = x0
    var ui = x.to_bits()
    var hx = ui.ushr(32)
    var k = 0
    if hx < 1048576 or hx.ushr(31) != 0 {
        if ui.shl(1) == 0 {
            return LogRed{ done: true, v: -1.0 / (x * x), k: 0, f: 0.0 }
        }
        if hx.ushr(31) != 0 {
            return LogRed{ done: true, v: (x - x) / 0.0, k: 0, f: 0.0 }
        }
        k -= 54
        x = x * 4850376798678024192.from_bits()
        ui = x.to_bits()
        hx = ui.ushr(32)
    } else if hx >= 2146435072 {
        return LogRed{ done: true, v: x, k: 0, f: 0.0 }
    } else if hx == 1072693248 and ui.shl(32) == 0 {
        return LogRed{ done: true, v: 0.0, k: 0, f: 0.0 }
    }
    hx += 1072693248 - 1072079006
    k += hx.ushr(20) - 1023
    hx = hx.bit_and(1048575) + 1072079006
    ui = hx.shl(32).bit_or(ui.bit_and(4294967295))
    x = ui.from_bits()
    LogRed{ done: false, v: 0.0, k: k, f: x - 1.0 }
}

export fn log(x: f64) -> f64 {
    let lr = log_reduce(x)
    if lr.done {
        return lr.v
    }
    let f = lr.f
    let hfsq = 0.5 * f * f
    let s = f / (2.0 + f)
    let z = s * s
    let w = z * z
    let t1 = w * (LG2 + w * (LG4 + w * LG6))
    let t2 = z * (LG1 + w * (LG3 + w * (LG5 + w * LG7)))
    let r = t2 + t1
    let dk = lr.k.as_f64()
    s * (hfsq + r) + dk * LN2LO - hfsq + f + dk * LN2HI
}

let IVLN2HI = 1.44269504072144627571e+00
let IVLN2LO = 1.67517131648865118353e-10

export fn log2(x: f64) -> f64 {
    let lr = log_reduce(x)
    if lr.done {
        return lr.v
    }
    let f = lr.f
    let hfsq = 0.5 * f * f
    let s = f / (2.0 + f)
    let z = s * s
    let w = z * z
    let t1 = w * (LG2 + w * (LG4 + w * LG6))
    let t2 = z * (LG1 + w * (LG3 + w * (LG5 + w * LG7)))
    let r = t2 + t1
    let hi = zero_low(f - hfsq)
    let lo = f - hi - hfsq + s * (hfsq + r)
    var val_hi = hi * IVLN2HI
    var val_lo = (lo + hi) * IVLN2LO + lo * IVLN2HI
    let y = lr.k.as_f64()
    let w2 = y + val_hi
    val_lo += (y - w2) + val_hi
    val_hi = w2
    val_lo + val_hi
}

let IVLN10HI = 4.34294481878168880939e-01
let IVLN10LO = 2.50829467116452752298e-11
let LOG10_2HI = 3.01029995663611771306e-01
let LOG10_2LO = 3.69423907715893078616e-13

export fn log10(x: f64) -> f64 {
    let lr = log_reduce(x)
    if lr.done {
        return lr.v
    }
    let f = lr.f
    let hfsq = 0.5 * f * f
    let s = f / (2.0 + f)
    let z = s * s
    let w = z * z
    let t1 = w * (LG2 + w * (LG4 + w * LG6))
    let t2 = z * (LG1 + w * (LG3 + w * (LG5 + w * LG7)))
    let r = t2 + t1
    let hi = zero_low(f - hfsq)
    let lo = f - hi - hfsq + s * (hfsq + r)
    var val_hi = hi * IVLN10HI
    let dk = lr.k.as_f64()
    let y = dk * LOG10_2HI
    var val_lo = dk * LOG10_2LO + (lo + hi) * IVLN10LO + lo * IVLN10HI
    let w2 = y + val_hi
    val_lo += (y - w2) + val_hi
    val_hi = w2
    val_lo + val_hi
}

// ----- pow -------------------------------------------------------------------------

let TWO53 = 9007199254740992.0
let HUGE = 1.0e300
let TINY = 1.0e-300
let L1 = 5.99999999999994648725e-01
let L2 = 4.28571428578550184252e-01
let L3 = 3.33333329818377432918e-01
let L4 = 2.72728123808534006489e-01
let L5 = 2.30660745775561754067e-01
let L6 = 2.06975017800338417784e-01
let LG2_ = 6.93147180559945286227e-01
let LG2_H = 6.93147182464599609375e-01
let LG2_L = -1.90465429995776804525e-09
let OVT = 8.0085662595372944372e-017
let CP = 9.61796693925975554329e-01
let CP_H = 9.61796700954437255859e-01
let CP_L = -7.02846165095275826516e-09
let IVLN2 = 1.44269504088896338700e+00
let IVLN2_H = 1.44269502162933349609e+00
let IVLN2_L = 1.92596299112661746887e-08

fn bp(k: i64) -> f64 {
    if k == 0 { 1.0 } else { 1.5 }
}

fn dp_h(k: i64) -> f64 {
    if k == 0 { 0.0 } else { 5.84962487220764160156e-01 }
}

fn dp_l(k: i64) -> f64 {
    if k == 0 { 0.0 } else { 1.35003920212974897128e-08 }
}

export fn pow(x: f64, y: f64) -> f64 {
    let hx = hi_s(x)
    let lx = lo_u(x)
    let hy = hi_s(y)
    let ly = lo_u(y)
    var ix = hx.bit_and(2147483647)
    let iy = hy.bit_and(2147483647)
    if iy.bit_or(ly) == 0 {
        return 1.0
    }
    if hx == 1072693248 and lx == 0 {
        return 1.0
    }
    if ix > 2146435072 or (ix == 2146435072 and lx != 0) or iy > 2146435072 or (iy == 2146435072 and ly != 0) {
        return x + y
    }
    var yisint = 0
    if hx < 0 {
        if iy >= 1128267776 {
            yisint = 2
        } else if iy >= 1072693248 {
            let k = iy.shr(20) - 1023
            if k > 20 {
                let j = ly.ushr(52 - k)
                if sx32(j.shl(52 - k)) == sx32(ly) {
                    yisint = 2 - j.bit_and(1)
                }
            } else if ly == 0 {
                let j = iy.shr(20 - k)
                if sx32(j.shl(20 - k)) == iy {
                    yisint = 2 - j.bit_and(1)
                }
            }
        }
    }
    if ly == 0 {
        if iy == 2146435072 {
            if (ix - 1072693248).bit_or(sx32(lx)) == 0 {
                return 1.0
            } else if ix >= 1072693248 {
                return if hy >= 0 { y } else { 0.0 }
            } else {
                return if hy >= 0 { 0.0 } else { neg(y) }
            }
        }
        if iy == 1072693248 {
            return if hy >= 0 { x } else { 1.0 / x }
        }
        if hy == 1073741824 {
            return x * x
        }
        if hy == 1071644672 {
            if hx >= 0 {
                return x.sqrt()
            }
        }
    }
    var ax = x.abs()
    if lx == 0 {
        if ix == 2146435072 or ix == 0 or ix == 1072693248 {
            var z = ax
            if hy < 0 {
                z = 1.0 / z
            }
            if hx < 0 {
                if (ix - 1072693248).bit_or(yisint) == 0 {
                    z = (z - z) / (z - z)
                } else if yisint == 1 {
                    z = neg(z)
                }
            }
            return z
        }
    }
    var s = 1.0
    if hx < 0 {
        if yisint == 0 {
            return (x - x) / (x - x)
        }
        if yisint == 1 {
            s = -1.0
        }
    }
    var t1 = 0.0
    var t2 = 0.0
    if iy > 1105199104 {
        if iy > 1139802112 {
            if ix <= 1072693247 {
                return if hy < 0 { HUGE * HUGE } else { TINY * TINY }
            }
            if ix >= 1072693248 {
                return if hy > 0 { HUGE * HUGE } else { TINY * TINY }
            }
        }
        if ix < 1072693247 {
            return if hy < 0 { s * HUGE * HUGE } else { s * TINY * TINY }
        }
        if ix > 1072693248 {
            return if hy > 0 { s * HUGE * HUGE } else { s * TINY * TINY }
        }
        let t = ax - 1.0
        let w = (t * t) * (0.5 - t * (0.3333333333333333333333 - t * 0.25))
        let u = IVLN2_H * t
        let v = t * IVLN2_L - w * IVLN2
        t1 = set_lo(u + v, 0)
        t2 = v - (t1 - u)
    } else {
        var n = 0
        if ix < 1048576 {
            ax = ax * TWO53
            n -= 53
            ix = hi_u(ax)
        }
        n += ix.shr(20) - 1023
        let j = ix.bit_and(1048575)
        var k = 0
        ix = j.bit_or(1072693248)
        if j <= 235662 {
            k = 0
        } else if j < 767610 {
            k = 1
        } else {
            k = 0
            n += 1
            ix -= 1048576
        }
        ax = set_hi(ax, ix)
        let u = ax - bp(k)
        let v = 1.0 / (ax + bp(k))
        let ss = u * v
        let s_h = set_lo(ss, 0)
        let t_h = set_hi(0.0, ix.ushr(1).bit_or(536870912) + 524288 + k.shl(18))
        let t_l = ax - (t_h - bp(k))
        let s_l = v * ((u - s_h * t_h) - s_h * t_l)
        let s2 = ss * ss
        var r = s2 * s2 * (L1 + s2 * (L2 + s2 * (L3 + s2 * (L4 + s2 * (L5 + s2 * L6)))))
        r += s_l * (s_h + ss)
        let s2b = s_h * s_h
        let t_h2 = set_lo(3.0 + s2b + r, 0)
        let t_l2 = r - ((t_h2 - 3.0) - s2b)
        let u2 = s_h * t_h2
        let v2 = s_l * t_h2 + t_l2 * ss
        let p_h = set_lo(u2 + v2, 0)
        let p_l = v2 - (p_h - u2)
        let z_h = CP_H * p_h
        let z_l = CP_L * p_h + p_l * CP + dp_l(k)
        let t = n.as_f64()
        t1 = set_lo(((z_h + z_l) + dp_h(k)) + t, 0)
        t2 = z_l - (((t1 - t) - dp_h(k)) - z_h)
    }
    let y1 = set_lo(y, 0)
    let p_l = (y - y1) * t1 + y * t2
    var p_h = y1 * t1
    var z = p_l + p_h
    var j = hi_s(z)
    let i = sx32(lo_u(z))
    if j >= 1083179008 {
        if (j - 1083179008).bit_or(i) != 0 {
            return s * HUGE * HUGE
        }
        if p_l + OVT > z - p_h {
            return s * HUGE * HUGE
        }
    } else if j.bit_and(2147483647) >= 1083231232 {
        if (j.bit_and(4294967295) - 3230714880).bit_and(4294967295).bit_or(i.bit_and(4294967295)) != 0 {
            return s * TINY * TINY
        }
        if p_l <= z - p_h {
            return s * TINY * TINY
        }
    }
    let i2 = j.bit_and(2147483647)
    var k = i2.shr(20) - 1023
    var n = 0
    if i2 > 1071644672 {
        n = j + 1048576.shr(k + 1)
        k = n.bit_and(2147483647).shr(20) - 1023
        let t = set_hi(0.0, n.bit_and(1048575.shr(k).bit_xor(-1)))
        n = n.bit_and(1048575).bit_or(1048576).shr(20 - k)
        if j < 0 {
            n = 0 - n
        }
        p_h = p_h - t
    }
    let t = set_lo(p_l + p_h, 0)
    let u = t * LG2_H
    let v = (p_l - (t - p_h)) * LG2_ + t * LG2_L
    z = u + v
    let w = v - (z - u)
    let tz = z * z
    let t1b = z - tz * (P1 + tz * (P2 + tz * (P3 + tz * (P4 + tz * P5))))
    let r = (z * t1b) / (t1b - 2.0) - (w + z * w)
    z = 1.0 - (r - z)
    j = hi_s(z)
    j = sx32(j + n.shl(20))
    if j.shr(20) <= 0 {
        z = scalbn(z, n)
    } else {
        z = set_hi(z, j)
    }
    s * z
}

// ----- asin, acos, atan, atan2 -----------------------------------------------------

let PIO2_HI = 1.57079632679489655800e+00
let PIO2_LO = 6.12323399573676603587e-17
let PS0 = 1.66666666666666657415e-01
let PS1 = -3.25565818622400915405e-01
let PS2 = 2.01212532134862925881e-01
let PS3 = -4.00555345006794114027e-02
let PS4 = 7.91534994289814532176e-04
let PS5 = 3.47933107596021167570e-05
let QS1 = -2.40339491173441421878e+00
let QS2 = 2.02094576023350569471e+00
let QS3 = -6.88283971605453293030e-01
let QS4 = 7.70381505559019352791e-02

fn comp_r(z: f64) -> f64 {
    let p = z * (PS0 + z * (PS1 + z * (PS2 + z * (PS3 + z * (PS4 + z * PS5)))))
    let q = 1.0 + z * (QS1 + z * (QS2 + z * (QS3 + z * QS4)))
    p / q
}

export fn asin(x0: f64) -> f64 {
    var x = x0
    let hx = hi_u(x)
    let ix = hx.bit_and(2147483647)
    if ix >= 1072693248 {
        let lx = lo_u(x)
        if (ix - 1072693248).bit_or(lx) == 0 {
            return x * PIO2_HI + 4066750463515557888.from_bits()
        }
        return 0.0 / (x - x)
    }
    if ix < 1071644672 {
        if ix >= 1048576 and ix < 1045430272 {
            return x
        }
        return x + x * comp_r(x * x)
    }
    let z = (1.0 - x.abs()) * 0.5
    let s = z.sqrt()
    let r = comp_r(z)
    if ix >= 1072640819 {
        x = PIO2_HI - (2.0 * (s + s * r) - PIO2_LO)
    } else {
        let f = set_lo(s, 0)
        let c = (z - f * f) / (s + f)
        x = 0.5 * PIO2_HI - (2.0 * s * r - (PIO2_LO - 2.0 * c) - (0.5 * PIO2_HI - 2.0 * f))
    }
    if hx.ushr(31) != 0 { neg(x) } else { x }
}

export fn acos(x: f64) -> f64 {
    let x1p_120f = 4066750463515557888.from_bits()
    let hx = hi_u(x)
    let ix = hx.bit_and(2147483647)
    if ix >= 1072693248 {
        let lx = lo_u(x)
        if (ix - 1072693248).bit_or(lx) == 0 {
            if hx.ushr(31) != 0 {
                return 2.0 * PIO2_HI + x1p_120f
            }
            return 0.0
        }
        return 0.0 / (x - x)
    }
    if ix < 1071644672 {
        if ix <= 1012924416 {
            return PIO2_HI + x1p_120f
        }
        return PIO2_HI - (x - (PIO2_LO - x * comp_r(x * x)))
    }
    if hx.ushr(31) != 0 {
        let z = (1.0 + x) * 0.5
        let s = z.sqrt()
        let w = comp_r(z) * s - PIO2_LO
        return 2.0 * (PIO2_HI - (s + w))
    }
    let z = (1.0 - x) * 0.5
    let s = z.sqrt()
    let df = zero_low(s)
    let c = (z - df * df) / (s + df)
    let w = comp_r(z) * s + c
    2.0 * (df + w)
}

fn atanhi(i: i64) -> f64 {
    match i {
        0 -> 4.63647609000806093515e-01
        1 -> 7.85398163397448278999e-01
        2 -> 9.82793723247329054082e-01
        _ -> 1.57079632679489655800e+00
    }
}

fn atanlo(i: i64) -> f64 {
    match i {
        0 -> 2.26987774529616870924e-17
        1 -> 3.06161699786838301793e-17
        2 -> 1.39033110312309984516e-17
        _ -> 6.12323399573676603587e-17
    }
}

fn at(i: i64) -> f64 {
    match i {
        0 -> 3.33333333333329318027e-01
        1 -> -1.99999999998764832476e-01
        2 -> 1.42857142725034663711e-01
        3 -> -1.11111104054623557880e-01
        4 -> 9.09088713343650656196e-02
        5 -> -7.69187620504482999495e-02
        6 -> 6.66107313738753120669e-02
        7 -> -5.83357013379057348645e-02
        8 -> 4.97687799461593236017e-02
        9 -> -3.65315727442169155270e-02
        _ -> 1.62858201153657823623e-02
    }
}

export fn atan(x0: f64) -> f64 {
    var x = x0
    var ix = hi_u(x)
    let sign = ix.ushr(31)
    ix = ix.bit_and(2147483647)
    if ix >= 1141899264 {
        if x.is_nan() {
            return x
        }
        let z = atanhi(3) + 58720256.from_bits()
        return if sign != 0 { neg(z) } else { z }
    }
    var id = -1
    if ix < 1071382528 {
        if ix < 1044381696 {
            return x
        }
        id = -1
    } else {
        x = x.abs()
        if ix < 1072889856 {
            if ix < 1072037888 {
                x = (2.0 * x - 1.0) / (2.0 + x)
                id = 0
            } else {
                x = (x - 1.0) / (x + 1.0)
                id = 1
            }
        } else if ix < 1073971200 {
            x = (x - 1.5) / (1.0 + 1.5 * x)
            id = 2
        } else {
            x = -1.0 / x
            id = 3
        }
    }
    let z = x * x
    let w = z * z
    let s1 = z * (at(0) + w * (at(2) + w * (at(4) + w * (at(6) + w * (at(8) + w * at(10))))))
    let s2 = w * (at(1) + w * (at(3) + w * (at(5) + w * (at(7) + w * at(9)))))
    if id < 0 {
        return x - x * (s1 + s2)
    }
    let r = atanhi(id) - (x * (s1 + s2) - atanlo(id) - x)
    if sign != 0 { neg(r) } else { r }
}

let PI = 3.1415926535897931160E+00
let PI_LO = 1.2246467991473531772E-16

export fn atan2(y: f64, x: f64) -> f64 {
    if x.is_nan() or y.is_nan() {
        return x + y
    }
    var ix = hi_u(x)
    let lx = lo_u(x)
    var iy = hi_u(y)
    let ly = lo_u(y)
    if (ix - 1072693248).bit_and(4294967295).bit_or(lx) == 0 {
        return atan(y)
    }
    let m = iy.ushr(31).bit_and(1).bit_or(ix.ushr(30).bit_and(2))
    ix = ix.bit_and(2147483647)
    iy = iy.bit_and(2147483647)
    if iy.bit_or(ly) == 0 {
        if m == 0 or m == 1 {
            return y
        }
        return if m == 2 { PI } else { neg(PI) }
    }
    if ix.bit_or(lx) == 0 {
        return if m.bit_and(1) != 0 { neg(PI / 2.0) } else { PI / 2.0 }
    }
    if ix == 2146435072 {
        if iy == 2146435072 {
            if m == 0 {
                return PI / 4.0
            }
            if m == 1 {
                return neg(PI / 4.0)
            }
            if m == 2 {
                return 3.0 * PI / 4.0
            }
            return neg(3.0 * PI / 4.0)
        }
        if m == 0 {
            return 0.0
        }
        if m == 1 {
            return -0.0
        }
        if m == 2 {
            return PI
        }
        return neg(PI)
    }
    if (ix + 64.shl(20)).bit_and(4294967295) < iy or iy == 2146435072 {
        return if m.bit_and(1) != 0 { neg(PI / 2.0) } else { PI / 2.0 }
    }
    let z = if m.bit_and(2) != 0 and (iy + 64.shl(20)).bit_and(4294967295) < ix { 0.0 } else { atan((y / x).abs()) }
    if m == 0 {
        z
    } else if m == 1 {
        neg(z)
    } else if m == 2 {
        PI - (z - PI_LO)
    } else {
        (z - PI_LO) - PI
    }
}

// ----- sinh, cosh, tanh -------------------------------------------------------------

export fn sinh(x: f64) -> f64 {
    var h = 0.5
    var ui = x.to_bits()
    if ui.ushr(63) != 0 {
        h = neg(h)
    }
    ui = ui.bit_and(9223372036854775807)
    let absx = ui.from_bits()
    let w = ui.ushr(32)
    if w < 1082535490 {
        let t = expm1(absx)
        if w < 1072693248 {
            if w < 1072693248 - 26.shl(20) {
                return x
            }
            return h * (2.0 * t - t * t / (t + 1.0))
        }
        return h * (t + t / (t + 1.0))
    }
    2.0 * h * k_expo2(absx)
}

export fn cosh(x0: f64) -> f64 {
    let ix = x0.to_bits().bit_and(9223372036854775807)
    let x = ix.from_bits()
    let w = ix.ushr(32)
    if w < 1072049730 {
        if w < 1072693248 - 26.shl(20) {
            return 1.0
        }
        let t = expm1(x)
        return 1.0 + t * t / (2.0 * (1.0 + t))
    }
    if w < 1082535490 {
        let t = exp(x)
        return 0.5 * (t + 1.0 / t)
    }
    k_expo2(x)
}

export fn tanh(x0: f64) -> f64 {
    var ui = x0.to_bits()
    let sign = ui.ushr(63) != 0
    ui = ui.bit_and(9223372036854775807)
    let x = ui.from_bits()
    let w = ui.ushr(32)
    var t = 0.0
    if w > 1071748074 {
        if w > 1077149696 {
            t = 1.0 - 0.0 / x
        } else {
            t = expm1(2.0 * x)
            t = 1.0 - 2.0 / (t + 2.0)
        }
    } else if w > 1070618798 {
        t = expm1(2.0 * x)
        t = t / (t + 2.0)
    } else if w >= 1048576 {
        t = expm1(-2.0 * x)
        t = neg(t) / (t + 2.0)
    } else {
        t = x
    }
    if sign { neg(t) } else { t }
}

// ----- cbrt (CORE-MATH) -------------------------------------------------------------

/// `a * b - p` exactly, where `p` is `a * b` rounded: the error of the
/// product, which Dekker's split gives exactly when nothing overflows -- what
/// the crate's `a.fma(b, -p)` computes here.
fn prod_err(a: f64, b: f64, p: f64) -> f64 {
    let split = 134217729.0
    let ca = a * split
    let ah = ca - (ca - a)
    let al = a - ah
    let cb = b * split
    let bh = cb - (cb - b)
    let bl = b - bh
    ((ah * bh - p) + ah * bl + al * bh) + al * bl
}

fn escale(i: i64) -> f64 {
    if i == 0 {
        1.0
    } else if i == 1 {
        4608352999143469707.from_bits()
    } else {
        4609827837958778429.from_bits()
    }
}

fn rsc(i: i64) -> f64 {
    match i {
        0 -> 1.0
        1 -> -1.0
        2 -> 0.5
        3 -> -0.5
        4 -> 0.25
        _ -> -0.25
    }
}

export fn cbrt(x: f64) -> f64 {
    let c0 = 4603154610227507100.from_bits()
    let c1 = 4603463474957065637.from_bits()
    let c2 = -4628332415333311046
    let c3 = 4582316773905046279.from_bits()
    let cc2 = c2.from_bits()
    let u0 = 4599676419421066581.from_bits()
    let u1 = 4597174419628082972.from_bits()
    let off = 4368491638549381120.from_bits()
    let hx = x.to_bits()
    var mant = hx.bit_and(4503599627370495)
    let sign = hx.ushr(63)
    var e = hx.ushr(52).bit_and(2047)
    if (e + 1).bit_and(2047) < 2 {
        let ix = hx.bit_and(9223372036854775807)
        if e == 2047 or ix == 0 {
            return x + x
        }
        let nz = ix.leading_zeros() - 11
        mant = mant.shl(nz).bit_and(4503599627370495)
        e = (e - (nz - 1)).bit_and(4294967295)
    }
    e = (e + 3072).bit_and(4294967295)
    let cvt1 = mant.bit_or(1023.shl(52))
    var cvt5 = cvt1
    let et = e / 3
    let it = e % 3
    cvt5 += it.shl(52)
    cvt5 = cvt5.bit_or(sign.shl(63))
    let zz = cvt5.from_bits()
    var isc = escale(it).to_bits()
    isc = isc.bit_or(sign.shl(63))
    let cvt2 = isc
    let z = cvt1.from_bits()
    let r = 1.0 / z
    let rr = r * rsc(it.shl(1).bit_or(sign))
    let z2 = z * z
    let k0 = c0 + z * c1
    let k2 = cc2 + z * c3
    var y = k0 + z2 * k2
    var y2 = y * y
    var h = y2 * (y * r) - 1.0
    y = y - (h * y) * (u0 - u1 * h)
    y = y * cvt2.from_bits()
    y2 = y * y
    var y2l = prod_err(y, y, y2)
    var y3 = y2 * y
    var y3l = prod_err(y, y2, y3) + y * y2l
    h = ((y3 - zz) + y3l) * rr
    var dy = h * (y * u0)
    var y1 = y - dy
    dy = (y - y1) - dy
    var ady = dy.abs()
    var ady0 = (ady - off).abs()
    var ady1 = (ady - (4368491638549381120.from_bits() * 2.0 + off)).abs()
    let tiny75 = 4269412446747230208.from_bits()
    if ady0 < tiny75 or ady1 < tiny75 {
        y2 = y1 * y1
        y2l = prod_err(y1, y1, y2)
        y3 = y2 * y1
        y3l = prod_err(y1, y2, y3) + y1 * y2l
        h = ((y3 - zz) + y3l) * rr
        dy = h * (y1 * u0)
        y = y1 - dy
        dy = (y1 - y) - dy
        y1 = y
        ady = dy.abs()
        ady0 = (ady - off).abs()
        ady1 = (ady - (4368491638549381120.from_bits() * 2.0 + off)).abs()
        let tiny98 = 4165829655317708800.from_bits()
        if ady0 < tiny98 or ady1 < tiny98 {
            let azz = zz.abs()
            if azz == 4614421062789771388.from_bits() {
                y1 = copysign(4609325460661786012.from_bits(), zz)
            }
            if azz == 4619039741114441215.from_bits() {
                y1 = copysign(4611097207003120143.from_bits(), zz)
            }
        }
    }
    var cvt3 = y1.to_bits()
    cvt3 = cvt3 + (et - 342 - 1023).shl(52)
    let m0 = cvt3.shl(30)
    let m1 = m0.ushr(63)
    if m0.bit_xor(m1).as_u64() <= 1.shl(30).as_u64() {
        var cvt4 = y1.to_bits()
        cvt4 = (cvt4 + 164.shl(15)).bit_and(-65536)
        if ((cvt4.from_bits() - y1) - dy).abs() < 4336966441157787648.from_bits() or zz.abs() == 1.0 {
            cvt3 = (cvt3 + 1.shl(15)).bit_and(-65536)
        }
    }
    cvt3.from_bits()
}

// ----- hypot ----------------------------------------------------------------------------
// The playground's `hypot` is correctly rounded (measured: 20,000 random
// pairs, every answer the exactly rounded one), so this one is too, by a
// direct method: a candidate from `sqrt`, then each midpoint beside it
// compared with x^2 + y^2 exactly -- the difference a sum of products split
// exactly (Dekker) and powers of two, its sign read from a non-overlapping
// expansion (Shewchuk, "Adaptive Precision Floating-Point Arithmetic",
// 1997) -- moving to the neighbour while the answer lies past a midpoint,
// and a tie to the even one.

/// `a * b` exactly, as the rounded product's error (`prod_err` above).
fn two_prod_err(a: f64, b: f64) -> f64 {
    prod_err(a, b, a * b)
}

/// The sign (-1, 0, 1) of the exact sum of the `n` doubles at `t`, by
/// growing an expansion one term at a time; `e` has room for `n` words.
fn sum_sign(t: addr, n: i64, e: addr) -> i64 {
    var m = 0
    for k in 0..n {
        var q = fget(t, k)
        for i in 0..m {
            let a = q
            let b = fget(e, i)
            let s = a + b
            let bv = s - a
            let av = s - bv
            fput(e, i, (a - av) + (b - bv))
            q = s
        }
        fput(e, m, q)
        m += 1
    }
    var k = m - 1
    while k >= 0 {
        let v = fget(e, k)
        if v > 0.0 {
            return 1
        }
        if v < 0.0 {
            return -1
        }
        k -= 1
    }
    0
}

/// The sign of x^2 + y^2 - (c + d)^2, exactly, for `c` and `d` with
/// `c + d` a midpoint (`d` a power of two, either sign).
fn mid_sign(x: f64, y: f64, c: f64, d: f64, t: addr, e: addr) -> i64 {
    let xh = x * x
    let yh = y * y
    let ch = c * c
    fput(t, 0, xh)
    fput(t, 1, two_prod_err(x, x))
    fput(t, 2, yh)
    fput(t, 3, two_prod_err(y, y))
    fput(t, 4, neg(ch))
    fput(t, 5, neg(two_prod_err(c, c)))
    fput(t, 6, neg(2.0 * c * d))
    fput(t, 7, neg(d * d))
    sum_sign(t, 8, e)
}

/// Whether `c` is odd: its last bit, or as a whole number.
fn odd(c: f64, unit: i64) -> bool {
    if unit == 1 {
        return (c * 0.5).floor() * 2.0 != c
    }
    c.to_bits().bit_and(1) != 0
}

/// The double nearest sqrt(x^2 + y^2) for 0 <= y <= x, where every square
/// and product here is exact: `c` from `sqrt`, then to a neighbour while a
/// midpoint is passed. `unit` 0 rounds to the double's own precision, 1 to
/// whole numbers (the scaled subnormal case).
fn round_root(x: f64, y: f64, unit: i64) -> f64 {
    let t = mem.take(8 * 8)
    let e = mem.take(8 * 8)
    var c = (x * x + y * y).sqrt()
    if unit == 1 {
        c = c.floor()
    }
    var moves = 0
    var done = false
    while not done and moves < 8 {
        let up = if unit == 1 { c + 1.0 } else { (c.to_bits() + 1).from_bits() }
        let down = if unit == 1 { c - 1.0 } else { (c.to_bits() - 1).from_bits() }
        let hu = (up - c) * 0.5
        let hd = (c - down) * 0.5
        let su = mid_sign(x, y, c, hu, t, e)
        if su > 0 {
            c = up
            moves += 1
        } else if su == 0 {
            if odd(c, unit) {
                c = up
            }
            done = true
        } else {
            let sd = mid_sign(x, y, c, neg(hd), t, e)
            if sd < 0 {
                c = down
                moves += 1
            } else if sd == 0 {
                if odd(c, unit) {
                    c = down
                }
                done = true
            } else {
                done = true
            }
        }
    }
    mem.give(t)
    mem.give(e)
    c
}

export fn hypot(x0: f64, y0: f64) -> f64 {
    if x0.is_nan() or y0.is_nan() {
        if x0.abs() == 9218868437227405312.from_bits() or y0.abs() == 9218868437227405312.from_bits() {
            return 9218868437227405312.from_bits()
        }
        return x0 + y0
    }
    var x = x0.abs()
    var y = y0.abs()
    if y > x {
        let t = x
        x = y
        y = t
    }
    if x == 9218868437227405312.from_bits() {
        return x
    }
    if y == 0.0 {
        return x
    }
    let ex = x.to_bits().ushr(52)
    if ex == 0 {
        // Both subnormal: in units of 2^-1074 each is a whole number below
        // 2^52, and so is the answer's last place.
        return hypot_sub(x, y)
    }
    let ey = y.to_bits().ushr(52)
    if ex - ey > 55 {
        return x
    }
    // Scaled so that x lies in [1, 2): exact, both stay normal or y at
    // worst a little below 2^-55.
    let k = ex - 1023
    let xs = scalbn(x, 0 - k)
    let ys = scalbn(y, 0 - k)
    scalbn(round_root(xs, ys, 0), k)
}

/// Both subnormal: x and y as whole numbers of 2^-1074, the answer rounded
/// to a whole number of it.
fn hypot_sub(x: f64, y: f64) -> f64 {
    let xi = x.to_bits().as_f64()
    let yi = y.to_bits().as_f64()
    let r = round_root(xi, yi, 1)
    // r is below 2^53: its bits as a subnormal's or the least normals'.
    r.as_i64().from_bits()
}

// ----- the exact ones -----------------------------------------------------------------

export fn floor(x: f64) -> f64 {
    x.floor()
}

export fn ceil(x: f64) -> f64 {
    x.ceil()
}

export fn sqrt(x: f64) -> f64 {
    x.sqrt()
}

/// Half away from zero, as C's `round`: exact.
export fn round(x: f64) -> f64 {
    // 0.5 - 0.25 * 2^-52, with x's sign.
    trunc(x + copysign(0.49999999999999994, x))
}

export fn fmin(x: f64, y: f64) -> f64 {
    if y.is_nan() or x < y { x } else { y }
}

export fn fmax(x: f64, y: f64) -> f64 {
    if x.is_nan() or x < y { y } else { x }
}

/// `x - n * y` with `n` the quotient toward zero, exactly: the remainder's
/// bits by shift and subtract, as C's `fmod` (musl's).
export fn fmod(x: f64, y: f64) -> f64 {
    let ux0 = x.to_bits()
    let uy0 = y.to_bits()
    var ex = ux0.ushr(52).bit_and(2047)
    var ey = uy0.ushr(52).bit_and(2047)
    let sx = ux0.ushr(63)
    if uy0.shl(1) == 0 or y.is_nan() or ex == 2047 {
        return (x * y) / (x * y)
    }
    if ux0.shl(1).as_u64() <= uy0.shl(1).as_u64() {
        if ux0.shl(1) == uy0.shl(1) {
            return 0.0 * x
        }
        return x
    }
    var uxi = ux0
    var uyi = uy0
    if ex == 0 {
        var i = uxi.shl(12)
        while i.shr(63) == 0 {
            ex -= 1
            i = i.shl(1)
        }
        uxi = uxi.shl(1 - ex)
    } else {
        uxi = uxi.bit_and(4503599627370495).bit_or(4503599627370496)
    }
    if ey == 0 {
        var i = uyi.shl(12)
        while i.shr(63) == 0 {
            ey -= 1
            i = i.shl(1)
        }
        uyi = uyi.shl(1 - ey)
    } else {
        uyi = uyi.bit_and(4503599627370495).bit_or(4503599627370496)
    }
    while ex > ey {
        let i = uxi - uyi
        if i.shr(63) == 0 {
            if i == 0 {
                return 0.0 * x
            }
            uxi = i
        }
        uxi = uxi.shl(1)
        ex -= 1
    }
    let i = uxi - uyi
    if i.shr(63) == 0 {
        if i == 0 {
            return 0.0 * x
        }
        uxi = i
    }
    while uxi.ushr(52) == 0 {
        uxi = uxi.shl(1)
        ex -= 1
    }
    if ex > 0 {
        uxi = uxi - 4503599627370496
        uxi = uxi.bit_or(ex.shl(52))
    } else {
        uxi = uxi.ushr(1 - ex)
    }
    uxi.bit_or(sx.shl(63)).from_bits()
}
