export fn getaddrinfo(host: addr, service: addr, hint: addr, out: addr) -> i32 {
    // `EAI_SYSTEM` on Darwin: the error is in `errno`.
    let _ = refuse()
    11.as_i32()
}

export fn freeaddrinfo(a: addr) {
    ()
