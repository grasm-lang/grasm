// The parallel workers on the Grasm runtime against the Rust runtime's
// (docs/self-hosting.md §6.12), for `scripts/fuzz_rtpar.sh`, which builds
// this twice -- on the Rust runtime and with the Grasm runtime alone --
// and requires the same bytes out and the same way out.
//
//     parfuzz <seed> <rounds> [<panic>]
//
// Each round runs one parallel operation: `par_map` and `par_filter` over
// lists of integers, floats, booleans and strings, short ones (run where
// they are) and long ones or ones whose elements cost (spread over
// workers), with captured values, nested one inside another; a `parallel`
// block's tasks; `net_workers` of each count up to a few, its workers
// reaching the network. With a panic number, the run ends in a worker: a
// panic in a closure, a recursion too deep in a worker's stack, too many
// network workers.

fn next(inout s: i64) -> i64 {
    s = s * 6364136223846793005 + 1442695040888963407
    s.ushr(17)
}

fn pick(inout s: i64, n: i64) -> i64 {
    next(s) % n
}

fn costly(x: i64, k: i64) -> i64 {
    var acc = x
    for i in 0..k {
        acc = (acc * 31 + i) % 1000003
    }
    acc
}

fn descend(n: i64) -> i64 {
    if n <= 0 {
        0
    } else {
        descend(n - 1) + 1
    }
}

/// An order-sensitive digest of a list of integers: each times its place.
fn digest(xs: [i64]) -> i64 {
    var d = 0
    for i in 0..xs.len() {
        d = (d * 31 + xs[i] * (i + 1)) % 1000000007
    }
    d
}

fn ints(inout s: i64, n: i64) -> [i64] {
    var out: [i64] = []
    for i in 0..n {
        out.push(pick(s, 2000) - 1000)
    }
    out
}

fn worker(i: i64) -> i64 / {net} {
    match tcp_listen_on("127.0.0.1", 0) {
        Err(_) -> -1
        Ok(l) -> {
            let p = net_port(l) ?? 0
            net_close(l)
            if p > 0 { i * 10 } else { -2 }
        }
    }
}

fn round(inout s: i64, r: i64) -> str / {net, async} {
    let k = pick(s, 9)
    let long = pick(s, 3) == 0
    let n = if long { 300 + pick(s, 400) } else { pick(s, 12) }
    let cost = if pick(s, 4) == 0 { 2000 } else { 1 }
    let xs = ints(s, n)
    let c = pick(s, 100)
    if k == 0 {
        let ys = xs.par_map(|x| costly(x, cost) + c)
        return "{r} map ints {n}: {digest(ys)} {ys.len()}"
    }
    if k == 1 {
        let ys = xs.par_filter(|x| costly(x, cost) % 3 == c % 3)
        return "{r} filter ints {n}: {ys.len()} {digest(ys)}"
    }
    if k == 2 {
        let fs = xs.map(|x| x.as_f64() / 7.0)
        let ys = fs.par_map(|f| f * 2.5 + c.as_f64())
        return "{r} map floats {n}: {ys.sum()} {digest(ys.map(|f| (f * 1000.0).as_i64()))}"
    }
    if k == 3 {
        let bs = xs.map(|x| x % 2 == 0)
        let ys = bs.par_map(|b| not b)
        let zs = bs.par_filter(|b| b)
        return "{r} bools {n}: {digest(ys.map(|b| if b { 1 } else { 0 }))} {zs.len()}"
    }
    if k == 4 {
        let ss = xs.map(|x| "s{x}")
        let ys = ss.par_map(|t| t.len() + c)
        let zs = ss.par_filter(|t| t.ends_with("{c % 10}"))
        return "{r} strings {n}: {digest(ys)} {zs.len()} {zs.join(",").len()} {digest(zs.map(|t| t.len()))}"
    }
    if k == 5 {
        // One inside another: the inner runs where it is.
        let outer = ints(s, 3 + pick(s, 30))
        let ys = outer.par_map(|x| xs.par_map(|y| y + x).sum())
        return "{r} nested {n}: {ys}"
    }
    if k == 6 {
        let ss = xs.map(|x| "v{x}")
        let ys = ss.par_map(|t| "{t}{c}")
        return "{r} map to strings {n}: {ys.len()} {ys.join("").len()} {digest(ys.map(|t| t.len()))}"
    }
    if k == 7 {
        // Independent tasks, each a thread of its own.
        var a = 0
        var b = 0
        var d = 0
        parallel {
            spawn {
                a = costly(c, cost)
            }
            spawn {
                b = costly(c + 1, cost)
            }
            spawn {
                d = costly(n, 3)
            }
        }
        // And tasks that share a list, run in order.
        var done: [i64] = []
        parallel {
            spawn {
                done.push(a)
            }
            spawn {
                done.push(b)
            }
        }
        return "{r} parallel: {a} {b} {d} {done}"
    }
    let w = pick(s, 5)
    let rs = net_workers(w, |i| worker(i))
    return "{r} net_workers {w}: {rs}"
}

fn panic_case(p: i64, xs: [i64]) / {io, net} {
    if p == 0 {
        let ys = xs.par_map(|x| if x == 777 { panic("worker panic {x}") } else { x })
        print("never {ys.len()}")
    }
    if p == 1 {
        let ys = xs.par_map(|x| descend(x * 100000))
        print("never {ys.len()}")
    }
    if p == 2 {
        let rs = net_workers(300, |i| worker(i))
        print("never {rs.len()}")
    }
    let zs = xs.par_filter(|x| 10 / (x - 777) > 0)
    print("never {zs.len()}")
}

fn main() / {io, net, async} {
    let a = args()
    var s = a[0].parse_int() ?? 1
    let rounds = a[1].parse_int() ?? 10
    if a.len() > 2 {
        var xs: [i64] = []
        for i in 0..1000 {
            xs.push(i)
        }
        print("panic case")
        panic_case(a[2].parse_int() ?? 0, xs)
        return
    }
    // First, while no thread here has run a parallel region: a map spread
    // over the workers whose answers are boxes made on them and released on
    // this thread, which the leak check must count as balanced.
    let first = ints(s, 600).map(|x| "w{x}")
    let made = first.par_map(|t| "{t}!")
    print("made on the workers: {made.len()} {digest(made.map(|t| t.len()))}")
    for r in 0..rounds {
        print(round(s, r))
    }
}
