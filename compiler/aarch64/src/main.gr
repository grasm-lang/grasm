// `aarch64`: MIR in, AArch64 machine code out (docs/self-hosting.md, S3).
//
//     rules.gr     instruction selection, as data, and the table's checker
//     isel.gr      MIR to VCode by those rules, plus the calling convention
//     emit.gr      frame, branches, relocations, bytes
//     mach.gr      the instructions: roles, encodings, assembly text
//     desc.gr      the target description the shared code reads
//     enctest.gr   the encoder's test cases
//     leaves.gr    the runtime dialect's leaves
//
// VCode, both register allocators, the allocation checker, the frame's
// placement and parallel moves are `compiler/vcode`'s, shared with the
// x86-64 target (docs/self-hosting.md §6.16).
import mach
import rules
import desc
import isel
import emit
import enctest
import leaves
import mir.ir
import vcode.vcode
import vcode.regalloc
import vcode.backtrack
import vcode.check

type A64Opts = {
    /// Registers the allocator may hand out; negative for all of them.
    max_regs: i64,
    /// Plant an allocation error, so the checker can be seen to catch it:
    /// `regalloc.PLANT_*`, `PLANT_NONE` for none.
    corrupt: i64,
    want_asm: bool,
    /// Which allocator: `RA_LINEAR` or `RA_BACKTRACK`.
    ra: i64,
    /// The target description (`desc.gr`), made once.
    tg: Target,
}

pub let RA_LINEAR = 0
pub let RA_BACKTRACK = 1

pub fn default_opts() -> A64Opts {
    A64Opts{ max_regs: -1, corrupt: regalloc.PLANT_NONE, want_asm: false, ra: RA_BACKTRACK, tg: desc.description() }
}

/// The kinds of planted allocation error, by the names the driver takes.
pub fn plant_kind(name: str) -> i64 {
    match name {
        "any" -> regalloc.PLANT_ANY
        "fp" -> regalloc.PLANT_FP
        "class" -> regalloc.PLANT_CLASS
        _ -> -1
    }
}

/// What compiling one function produced.
type A64Result = {
    code: A64Code,
    /// The allocation checker's findings: empty, or the build fails.
    ra_errors: [str],
    corrupted: i64,
    vcode_text: str,
}

/// Selects, allocates, checks and encodes one function. `rt_syms` names the
/// runtime functions its calls reach, by id (`MirProg.rt_syms`).
pub fn compile_fn(f: MirFn, rs: [Rule], ccm: [i64], fccm: [i64], opts: A64Opts, callee_sym: [str], rt_syms: [str]) -> A64Result ! str {
    let t = opts.tg
    let vc = try isel.select(t, f, rs, ccm, fccm)
    let al = if opts.ra == RA_BACKTRACK { try backtrack.allocate(t, vc, opts.max_regs, opts.corrupt) } else { try regalloc.allocate(t, vc, opts.max_regs, opts.corrupt) }
    let errs = check.check(t, al)
    var vtext = ""
    if opts.want_asm {
        vtext = print_vcode(vc)
    }
    if errs.len() > 0 {
        // Code the checker refused is not encoded: an operand in the wrong
        // register file is no instruction at all.
        let none = A64Code{ sym: f.sym, words: [], rel_off: [], rel_kind: [], rel_symk: [], rel_sym: [], asm: [], frame: 0, nspill: al.nspill, nsaved: 0, frame_at: 0, row_word: [], row_src: [] }
        return A64Result{ code: none, ra_errors: errs, corrupted: al.corrupted, vcode_text: vtext }
    }
    let code = try emit.emit(t, al, f.sym, opts.want_asm, callee_sym, rt_syms)
    A64Result{ code: code, ra_errors: errs, corrupted: al.corrupted, vcode_text: vtext }
}

/// The function as text, for reading.
fn print_vcode(vc: VCode) -> str {
    var out = str_builder()
    out.push_str("vcode {vc.sym} vregs={vc.nvregs} params={vc.nparams} slots={vc.nslots} out={vc.nout}\n")
    for b in 0..vcode.nblocks(vc) {
        out.push_str("  b{b}:\n")
        for i in vc.bi0[b]..(vc.bi0[b] + vc.bni[b]) {
            var target = ""
            if vc.tgt[i] >= 0 {
                target = "b{vc.tgt[i]}"
            } else if vc.symk[i] > 0 {
                target = "sym{vc.symk[i]}:{vc.sym_id[i]}"
            }
            out.push_str("    " + mach.asm_text(vc.mop[i], vc.rd[i], vc.rn[i], vc.rm[i], vc.ra[i], vc.imm[i], vc.imm2[i], vc.cc[i], 0, target) + "\n")
        }
    }
    out.to_str()
}

pub fn rule_table() -> [Rule] {
    rules.rules()
}

pub fn cond_map() -> [i64] {
    rules.cc_map()
}

pub fn fcond_map() -> [i64] {
    rules.fcc_map()
}

/// Everything wrong with the rule table, or nothing.
pub fn check_rules() -> [str] {
    rules.check(rules.rules())
}

/// Every instruction form compiled code can contain: what the rules emit,
/// and what the calling convention, the allocator and the frame add.
pub fn emittable_forms() -> [str] {
    var seen: [bool] = []
    for m in 0..mach.NMOPS {
        seen.push(false)
    }
    for m in rules.rule_mops(rules.rules()) {
        seen[m] = true
    }
    // Calls and their argument moves; spills and reloads; the prologue,
    // the epilogue and frame adjustment; branches as emission rewrites them.
    for m in [mach.A_MOV, mach.A_BL, mach.A_LDR, mach.A_STR, mach.A_PACIBSP, mach.A_STP_PRE, mach.A_LDP_POST, mach.A_ADDI, mach.A_SUBI, mach.A_RETAB, mach.A_B, mach.A_BCOND, mach.A_CBZ, mach.A_CBNZ, mach.A_FMOV, mach.A_FLDR, mach.A_FSTR, mach.A_FSTP_PRE, mach.A_FLDP_POST, mach.A_BLR] {
        seen[m] = true
    }
    // The runtime dialect's leaves (`leaves.gr`).
    for m in leaves.leaf_mops() {
        seen[m] = true
    }
    var out: [str] = []
    for m in 0..mach.NMOPS {
        if seen[m] {
            out.push(mach.form_name(m))
        }
    }
    out
}

pub fn encode_cases() -> EncCases ! str {
    enctest.cases()
}

/// The fixed leaves the runtime's call of `rt_name` needs ([T-RUNTIME]),
/// given its thread-local cells; none when the name is not one of them.
pub fn leaves_for(rt_name: str, cells: [str]) -> [A64Leaf] ! str {
    leaves.leaves_for(rt_name, cells)
}
