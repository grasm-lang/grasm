// The AArch64 instructions this backend emits: what each one is called,
// which of its operands it reads and writes, how it is encoded and how the
// system assembler spells it.
//
// Every attribute is a lookup on the opcode, so one table answers the
// register allocator (roles), the checker (roles), the encoder (format and
// base word) and the assembly printer (mnemonic, register widths). The
// encoder is held to the assembler by `scripts/encodetest.sh`, across every
// form the lowering rules and the frame code can emit, with generated
// operands -- the printer is how that gate asks the assembler.
//
// Registers are numbered as operands: 0..30 are x0..x30, `R_ZR` is the zero
// register and `R_SP` the stack pointer (both 31 in an encoding; which one an
// encoding means depends on the field, and the encoder refuses the wrong one),
// `R_D0 + k` is the floating-point register dk (the 64-bit view of vk), and
// `VR + n` is virtual register n before allocation.
//
// There are two register classes. Every field of every form is one or the
// other (`fp_field`): a general register (x, or w) or a floating-point one
// (d). The encoder refuses a register of the wrong class in a field, the
// allocator hands each virtual register one of its own class, and the
// checker proves both.

pub let R_ZR = 31
pub let R_SP = 32
/// d0; dk is `R_D0 + k`.
pub let R_D0 = 64
pub let VR = 128
/// x29, the frame pointer: set by the prologue, never allocated, and read
/// for the arguments that arrived on the stack.
pub let R_FP = 29

/// The register classes.
pub let CLS_INT = 0
pub let CLS_FP = 1

pub fn is_vreg(o: i64) -> bool {
    o >= VR
}

/// A physical floating-point register.
pub fn is_fpr(o: i64) -> bool {
    o >= R_D0 and o < R_D0 + 32
}

// ----- opcodes ---------------------------------------------------------------

pub let A_ADDR = 1
pub let A_SUBR = 2
pub let A_ANDR = 3
pub let A_ORRR = 4
pub let A_EORR = 5
pub let A_MUL = 6
pub let A_SDIV = 7
pub let A_UDIV = 8
pub let A_LSLV = 9
pub let A_LSRV = 10
pub let A_ASRV = 11
pub let A_MSUB = 12
pub let A_CMPR = 13
pub let A_NEG = 14
pub let A_MVN = 15
pub let A_MOV = 16
pub let A_MOVW = 17
pub let A_SXTB = 18
pub let A_SXTH = 19
pub let A_SXTW = 20
pub let A_UXTB = 21
pub let A_UXTH = 22
pub let A_CSET = 23
pub let A_ADDI = 24
pub let A_SUBI = 25
pub let A_CMPI = 26
pub let A_CMNI = 27
pub let A_MOVZ = 28
pub let A_MOVN = 29
pub let A_MOVK = 30
pub let A_LDR = 31
pub let A_STR = 32
pub let A_STP_PRE = 33
pub let A_LDP_POST = 34
pub let A_B = 35
pub let A_BL = 36
pub let A_BCOND = 37
pub let A_CBZ = 38
pub let A_CBNZ = 39
pub let A_RET = 40
pub let A_RETAB = 41
pub let A_PACIBSP = 42
pub let A_BRK = 43
pub let A_ADRP = 44
pub let A_ADDPO = 45
// Floating point, all on doubles.
pub let A_FADD = 46
pub let A_FSUB = 47
pub let A_FMUL = 48
pub let A_FDIV = 49
pub let A_FNEG = 50
pub let A_FABS = 51
pub let A_FSQRT = 52
/// Round toward minus infinity: `floor`.
pub let A_FRINTM = 53
/// Round toward plus infinity: `ceil`.
pub let A_FRINTP = 54
/// `fmov dd, dn`.
pub let A_FMOV = 55
/// `fmov xd, dn`: the bits of a double into a general register.
pub let A_FMOV_XD = 56
/// `fmov dd, xn`: the bits in a general register as a double.
pub let A_FMOV_DX = 57
pub let A_FCMP = 58
pub let A_SCVTF = 59
pub let A_UCVTF = 60
/// Toward zero, saturating; NaN is 0.
pub let A_FCVTZS = 61
pub let A_FCVTZU = 62
pub let A_FLDR = 63
pub let A_FSTR = 64
pub let A_FSTP_PRE = 65
pub let A_FLDP_POST = 66
/// `blr xn`: a call through a register, a function value's code.
pub let A_BLR = 67
// Bits, on general registers.
pub let A_CLZ = 68
pub let A_RBIT = 69
/// `rev xd, xn`: the eight bytes reversed.
pub let A_REV = 70
/// `rev16 wd, wn`: the bytes of each halfword swapped, the upper half of
/// the `x` register cleared.
pub let A_REV16W = 71
/// `rev wd, wn`: the four bytes reversed, the upper half cleared.
pub let A_REVW = 72
/// `ror xd, xn, xm`: turned right by `xm` modulo 64.
pub let A_RORV = 73
// Raw memory ([L-LIB-MEM]): loads and stores of a byte, a halfword and a
// word, at an unsigned offset scaled by the size. A load into `w` clears
// the upper half; the `s` forms sign-extend into the whole `x` register.
pub let A_LDRB = 74
pub let A_LDRSB = 75
pub let A_LDRH = 76
pub let A_LDRSH = 77
pub let A_LDRW = 78
pub let A_LDRSW = 79
pub let A_STRB = 80
pub let A_STRH = 81
pub let A_STRW = 82
// Atomics ([L-LIB-ATOMIC]), each sequentially consistent, as the Cranelift
// build makes every one: load-acquire, store-release, and the LSE
// compare-and-swap and fetch-add with both acquire and release, at four
// widths each.
pub let A_LDARB = 83
pub let A_LDARH = 84
pub let A_LDARW = 85
pub let A_LDARX = 86
pub let A_STLRB = 87
pub let A_STLRH = 88
pub let A_STLRW = 89
pub let A_STLRX = 90
/// `casal rs, rt, [xn]`, written here with `rs` in field 0 (read as the
/// expected value, written with what memory held) and `rt` in field 2.
pub let A_CASALB = 91
pub let A_CASALH = 92
pub let A_CASALW = 93
pub let A_CASALX = 94
/// `ldaddal rs, rt, [xn]`, written here with `rt` in field 0 (written with
/// what memory held) and `rs` in field 2 (the addend).
pub let A_LDADDALB = 95
pub let A_LDADDALH = 96
pub let A_LDADDALW = 97
pub let A_LDADDALX = 98
/// `adrp xd, sym@GOTPAGE`: the page of a symbol's slot in the global offset
/// table, which the linker fills (a C function's address, [T-FN-ADDR]).
pub let A_ADRP_GOT = 99
/// `ldr xd, [xn, sym@GOTPAGEOFF]`: the address in that slot.
pub let A_LDR_GOT = 100
/// Not an instruction: the function's return, which becomes the epilogue.
/// `imm` 1 when it returns x0, 2 when it returns d0.
pub let P_RETURN = 150
/// Not an instruction: a 64-bit constant, which instruction selection
/// expands into `movz`/`movn` and `movk`s.
pub let P_MOVIMM = 151
/// One past the largest opcode: the size of a table indexed by opcode.
pub let NMOPS = 160

/// The opcodes that are real instructions, for whoever wants all of them.
pub fn all_mops() -> [i64] {
    var out: [i64] = []
    for m in 1..101 {
        out.push(m)
    }
    out
}

/// The bytes a raw-memory access moves (1, 2, 4 or 8): what its offset is
/// scaled by.
pub fn access_size(m: i64) -> i64 {
    if m == A_LDRB or m == A_LDRSB or m == A_STRB or m == A_LDARB or m == A_STLRB or m == A_CASALB or m == A_LDADDALB {
        1
    } else if m == A_LDRH or m == A_LDRSH or m == A_STRH or m == A_LDARH or m == A_STLRH or m == A_CASALH or m == A_LDADDALH {
        2
    } else if m == A_LDRW or m == A_LDRSW or m == A_STRW or m == A_LDARW or m == A_STLRW or m == A_CASALW or m == A_LDADDALW {
        4
    } else {
        8
    }
}

/// Whether `m` is a call: `bl` to a symbol or `blr` through a register. Both
/// read their argument registers, write their result's, and clobber what a
/// call may change (`imm`, `imm2`: `vcode.RES_*`, `vcode.call_args_code`).
pub fn is_call(m: i64) -> bool {
    m == A_BL or m == A_BLR
}

