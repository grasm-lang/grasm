// Formats.
let F_RRR = 1
let F_CMPR = 2
let F_RRRR = 3
let F_RM = 4
let F_RN = 5
let F_CSET = 6
let F_IMM12 = 7
let F_CMPI = 8
let F_MOVW = 9
let F_LDST = 10
let F_PAIR = 11
let F_B26 = 12
let F_B19 = 13
let F_CB = 14
let F_FIXED = 15
let F_BRK = 16
let F_ADRP = 17
let F_ADDPO = 18
let F_BLR = 19
/// A load or store of 1, 2 or 4 bytes: Rt, [Rn, #uimm12 * size].
let F_LDSTN = 20
/// A load-acquire or store-release: Rt, [Rn].
let F_ACQREL = 21
/// A compare-and-swap: Rs (field 0), Rt (field 2), [Rn].
let F_CAS = 22
/// A fetch-add: Rs (field 2), Rt (field 0), [Rn].
let F_LDADD = 23
/// A load of a global offset table slot: Rt, [Rn, sym@GOTPAGEOFF].
let F_LDRGOT = 24

fn mop_fmt(m: i64) -> i64 {
    if m >= A_FADD {
        return fp_fmt(m)
    }
    if m <= 11 {
        1
    } else if m == 12 {
        3
    } else if m == 13 {
        2
    } else if m <= 17 {
        4
    } else if m <= 22 {
        5
    } else if m == 23 {
        6
    } else if m <= 25 {
        7
    } else if m <= 27 {
        8
    } else if m <= 30 {
        9
    } else if m <= 32 {
        10
    } else if m <= 34 {
        11
    } else if m <= 36 {
        12
    } else if m == 37 {
        13
    } else if m <= 39 {
        14
    } else if m <= 42 {
        15
    } else if m == 43 {
        16
    } else if m == 44 {
        17
    } else if m == 45 {
        18
    } else {
        0
    }
}

/// The floating-point forms, each laid out as an integer one is: the
/// three-register arithmetic as `add`, a compare as `cmp`, the one-operand
/// operations and the moves between classes as `sxtb` (Rd, Rn), loads and
/// stores and pairs as theirs.
fn fp_fmt(m: i64) -> i64 {
    if m >= A_FADD and m <= A_FDIV {
        F_RRR
    } else if m >= A_FNEG and m <= A_FMOV_DX {
        F_RN
    } else if m == A_FCMP {
        F_CMPR
    } else if m >= A_SCVTF and m <= A_FCVTZU {
        F_RN
    } else if m == A_FLDR or m == A_FSTR {
        F_LDST
    } else if m == A_FSTP_PRE or m == A_FLDP_POST {
        F_PAIR
    } else if m == A_BLR {
        F_BLR
    } else if m >= A_CLZ and m <= A_REVW {
        // The bit operations past the floating-point ones, laid out as
        // `sxtb` (Rd, Rn) and `lsrv` (Rd, Rn, Rm).
        F_RN
    } else if m == A_RORV {
        F_RRR
    } else if m >= A_LDRB and m <= A_STRW {
        F_LDSTN
    } else if m >= A_LDARB and m <= A_STLRX {
        F_ACQREL
    } else if m >= A_CASALB and m <= A_CASALX {
        F_CAS
    } else if m >= A_LDADDALB and m <= A_LDADDALX {
        F_LDADD
    } else if m == A_ADRP_GOT {
        F_ADRP
    } else if m == A_LDR_GOT {
        F_LDRGOT
    } else {
        0
    }
}

/// Whether field `field` (0 Rd/Rt, 1 Rn, 2 Rm/Rt2, 3 Ra) of opcode `m` is a
/// floating-point register; every other register field is a general one.
pub fn fp_field(m: i64, field: i64) -> bool {
    if m >= A_FADD and m <= A_FDIV {
        field <= 2
    } else if m >= A_FNEG and m <= A_FMOV {
        field <= 1
    } else if m == A_FMOV_XD or m == A_FCVTZS or m == A_FCVTZU {
        field == 1
    } else if m == A_FMOV_DX or m == A_SCVTF or m == A_UCVTF {
        field == 0
    } else if m == A_FCMP {
        field == 1 or field == 2
    } else if m == A_FLDR or m == A_FSTR {
        field == 0
    } else if m == A_FSTP_PRE or m == A_FLDP_POST {
        field == 0 or field == 2
    } else {
        false
    }
}

