        16 -> 0xAA0003E0
        17 -> 0x2A0003E0
        18 -> 0x93401C00
        19 -> 0x93403C00
        20 -> 0x93407C00
        21 -> 0x53001C00
        22 -> 0x53003C00
        23 -> 0x9A9F07E0
        24 -> 0x91000000
        25 -> 0xD1000000
        26 -> 0xF100001F
        27 -> 0xB100001F
        28 -> 0xD2800000
        29 -> 0x92800000
        30 -> 0xF2800000
        31 -> 0xF9400000
        32 -> 0xF9000000
        33 -> 0xA9800000
        34 -> 0xA8C00000
        35 -> 0x14000000
        36 -> 0x94000000
        37 -> 0x54000000
        38 -> 0xB4000000
        39 -> 0xB5000000
        40 -> 0xD65F03C0
        41 -> 0xD65F0FFF
        42 -> 0xD503237F
        43 -> 0xD4200000
        44 -> 0x90000000
        45 -> 0x91000000
        46 -> 0x1E602800
        47 -> 0x1E603800
        48 -> 0x1E600800
        49 -> 0x1E601800
        50 -> 0x1E614000
        51 -> 0x1E60C000
        52 -> 0x1E61C000
        53 -> 0x1E654000
        54 -> 0x1E64C000
        55 -> 0x1E604000
        56 -> 0x9E660000
        57 -> 0x9E670000
        58 -> 0x1E602000
        59 -> 0x9E620000
        60 -> 0x9E630000
        61 -> 0x9E780000
        62 -> 0x9E790000
        63 -> 0xFD400000
        64 -> 0xFD000000
        65 -> 0x6D800000
        66 -> 0x6CC00000
        67 -> 0xD63F0000
        68 -> 0xDAC01000
        69 -> 0xDAC00000
        70 -> 0xDAC00C00
        71 -> 0x5AC00400
        72 -> 0x5AC00800
        73 -> 0x9AC02C00
        74 -> 0x39400000
        75 -> 0x39800000
        76 -> 0x79400000
        77 -> 0x79800000
        78 -> 0xB9400000
        79 -> 0xB9800000
        80 -> 0x39000000
        81 -> 0x79000000
        82 -> 0xB9000000
        83 -> 0x08DFFC00
        84 -> 0x48DFFC00
        85 -> 0x88DFFC00
        86 -> 0xC8DFFC00
        87 -> 0x089FFC00
        88 -> 0x489FFC00
        89 -> 0x889FFC00
        90 -> 0xC89FFC00
        91 -> 0x08E0FC00
        92 -> 0x48E0FC00
        93 -> 0x88E0FC00
        94 -> 0xC8E0FC00
        95 -> 0x38E00000
        96 -> 0x78E00000
        97 -> 0xB8E00000
        98 -> 0xF8E00000
        99 -> 0x90000000
        100 -> 0xF9400000
        _ -> 0
    }
}

// ----- operand roles -----------------------------------------------------------
// 0: unused, 1: written, 2: read, 3: read and written.

pub let ROLE_NONE = 0
pub let ROLE_DEF = 1
pub let ROLE_USE = 2
pub let ROLE_USEDEF = 3

pub fn role_d(m: i64) -> i64 {
    if m == A_CMPR or m == A_CMPI or m == A_CMNI or m == A_FCMP or m == A_B or m == A_BL or m == A_BLR or m == A_BCOND or m == A_CBZ or m == A_CBNZ or m == A_RET or m == A_RETAB or m == A_PACIBSP or m == A_BRK or m == P_RETURN {
        0
    } else if m == A_MOVK or (m >= A_CASALB and m <= A_CASALX) {
        3
    } else if m == A_STR or m == A_STP_PRE or m == A_FSTR or m == A_FSTP_PRE or (m >= A_STRB and m <= A_STRW) or (m >= A_STLRB and m <= A_STLRX) {
        2
    } else {
        1
    }
}

pub fn role_n(m: i64) -> i64 {
    let f = mop_fmt(m)
    if f == 1 or f == 2 or f == 3 or f == 5 or f == 7 or f == 8 or f == 10 or f == 11 or f == 14 or f == 18 or f == 19 or (f >= F_LDSTN and f <= F_LDRGOT) {
        2
    } else {
        0
    }
}

pub fn role_m(m: i64) -> i64 {
    let f = mop_fmt(m)
    if f == 1 or f == 2 or f == 3 or f == 4 or f == F_CAS or f == F_LDADD {
        2
    } else if m == A_STP_PRE or m == A_FSTP_PRE {
        2
    } else if m == A_LDP_POST or m == A_FLDP_POST {
        1
    } else {
        0
    }
}

pub fn role_a(m: i64) -> i64 {
    if m == A_MSUB { 2 } else { 0 }
}

/// Which fields may name the stack pointer (where 31 means `sp`); every
/// other register field means the zero register by 31.
fn sp_field(m: i64, field: i64) -> bool {
    if m == A_ADDI or m == A_SUBI or m == A_ADDPO {
        field == 0 or field == 1
    } else if m == A_CMPI or m == A_CMNI or m == A_LDR or m == A_STR or m == A_STP_PRE or m == A_LDP_POST or m == A_FLDR or m == A_FSTR or m == A_FSTP_PRE or m == A_FLDP_POST {
        field == 1
    } else if (m >= A_LDRB and m <= A_LDADDALX) or m == A_LDR_GOT {
        // The base of every raw-memory access may be `sp`.
        field == 1
    } else {
        false
    }
}

/// Which fields are 32-bit (`w`) registers in the assembly.
fn w_field(m: i64, field: i64) -> bool {
    if m == A_MOVW {
        field == 0 or field == 2
    } else if m == A_UXTB or m == A_UXTH {
        field == 0 or field == 1
    } else if m == A_SXTB or m == A_SXTH or m == A_SXTW {
        field == 1
    } else if m == A_REV16W or m == A_REVW {
        field == 0 or field == 1
    } else if m == A_LDRB or m == A_LDRH or m == A_LDRW or (m >= A_STRB and m <= A_STRW) {
        // The narrow loads and stores name a `w` register; the sign-extending
        // ones load into the whole `x`.
        field == 0
    } else if (m >= A_LDARB and m <= A_LDARW) or (m >= A_STLRB and m <= A_STLRW) {
        field == 0
    } else if (m >= A_CASALB and m <= A_CASALW) or (m >= A_LDADDALB and m <= A_LDADDALW) {
        field == 0 or field == 2
    } else {
        false
    }
}

// ----- conditions ----------------------------------------------------------------

pub let C_EQ = 0
pub let C_NE = 1
pub let C_HS = 2
pub let C_LO = 3
pub let C_MI = 4
pub let C_HI = 8
pub let C_LS = 9
pub let C_GE = 10
pub let C_LT = 11
pub let C_GT = 12
pub let C_LE = 13

pub fn cond_name(c: i64) -> str {
    match c {
        0 -> "eq"
        1 -> "ne"
        2 -> "hs"
        3 -> "lo"
        4 -> "mi"
        5 -> "pl"
        6 -> "vs"
        7 -> "vc"
        8 -> "hi"
        9 -> "ls"
        10 -> "ge"
        11 -> "lt"
        12 -> "gt"
        13 -> "le"
        14 -> "al"
        _ -> "nv"
    }
}

/// The condition that holds exactly when `c` does not.
pub fn cond_invert(c: i64) -> i64 {
    c.bit_xor(1)
}

// ----- encoding ------------------------------------------------------------------

/// A register operand as its 5-bit field, refusing the wrong kind of 31.
fn reg_field(m: i64, field: i64, o: i64) -> i64 ! str {
    if o < 0 {
        fail("{form_name(m)}: operand {field} is missing")
    }
    if is_vreg(o) {
        fail("{form_name(m)}: operand {field} is still virtual (v{o - VR})")
    }
    if fp_field(m, field) {
        if not is_fpr(o) {
            fail("{form_name(m)}: operand {field} is a floating-point register, not {reg_text(A_ADDR, 0, o)}")
        }
        return o - R_D0
    }
    if is_fpr(o) {
        fail("{form_name(m)}: operand {field} is a general register, not d{o - R_D0}")
    }
    if o == R_SP {
        if not sp_field(m, field) {
            fail("{form_name(m)}: operand {field} cannot be sp")
        }
        return 31
    }
    if o == R_ZR {
        if sp_field(m, field) {
            fail("{form_name(m)}: operand {field} cannot be the zero register")
        }
        return 31
    }
    if o > 30 {
        fail("{form_name(m)}: no register {o}")
    }
    o
}

fn uimm(m: i64, what: str, v: i64, bits: i64) -> i64 ! str {
    if v < 0 or v >= 1.shl(bits) {
        fail("{form_name(m)}: {what} {v} does not fit in {bits} bits")
    }
    v
}

/// A branch displacement in instructions, as a `bits`-wide field.
fn disp(m: i64, off: i64, bits: i64) -> i64 ! str {
    if off.bit_and(3) != 0 {
        fail("{form_name(m)}: branch offset {off} is not a multiple of 4")
    }
    let w = off.shr(2)
    let lim = 1.shl(bits - 1)
    if w < 0 - lim or w >= lim {
        fail("{form_name(m)}: branch offset {off} is out of range")
    }
    w.bit_and(1.shl(bits) - 1)
}

/// One instruction word. `off` is a branch's byte offset from itself; an
/// instruction a relocation completes (`bl` to a symbol, `adrp`, the
/// page-offset `add`) is encoded with the field zero, as the assembler
/// leaves it for the linker.
pub fn encode(m: i64, rd: i64, rn: i64, rm: i64, ra: i64, imm: i64, imm2: i64, cc: i64, off: i64) -> i64 ! str {
    let base = mop_base(m)
    let f = mop_fmt(m)
    if f == 1 {
        let d = try reg_field(m, 0, rd)
        let n = try reg_field(m, 1, rn)
        let mm = try reg_field(m, 2, rm)
        return base.bit_or(mm.shl(16)).bit_or(n.shl(5)).bit_or(d)
    }
    if f == 2 {
        let n = try reg_field(m, 1, rn)
        let mm = try reg_field(m, 2, rm)
        return base.bit_or(mm.shl(16)).bit_or(n.shl(5))
    }
    if f == 3 {
        let d = try reg_field(m, 0, rd)
        let n = try reg_field(m, 1, rn)
        let mm = try reg_field(m, 2, rm)
        let a = try reg_field(m, 3, ra)
        return base.bit_or(mm.shl(16)).bit_or(a.shl(10)).bit_or(n.shl(5)).bit_or(d)
    }
    if f == 4 {
        let d = try reg_field(m, 0, rd)
        let mm = try reg_field(m, 2, rm)
        return base.bit_or(mm.shl(16)).bit_or(d)
    }
    if f == 5 {
        let d = try reg_field(m, 0, rd)
        let n = try reg_field(m, 1, rn)
        return base.bit_or(n.shl(5)).bit_or(d)
    }
    if f == 6 {
        let d = try reg_field(m, 0, rd)
        let c = try uimm(m, "condition", cc, 4)
        if c >= 14 {
            fail("cset: condition {c} has no inverse")
        }
        return base.bit_or(cond_invert(c).shl(12)).bit_or(d)
    }
    if f == 7 or f == 8 {
        var d = 0
        if f == 7 {
            d = try reg_field(m, 0, rd)
        }
        let n = try reg_field(m, 1, rn)
        let k = try uimm(m, "immediate", imm, 12)
        let sh = try uimm(m, "shift", imm2, 1)
        return base.bit_or(sh.shl(22)).bit_or(k.shl(10)).bit_or(n.shl(5)).bit_or(d)
    }
    if f == 9 {
        let d = try reg_field(m, 0, rd)
        let k = try uimm(m, "immediate", imm, 16)
        let hw = try uimm(m, "shift", imm2, 2)
        return base.bit_or(hw.shl(21)).bit_or(k.shl(5)).bit_or(d)
    }
    if f == 10 {
        let t = try reg_field(m, 0, rd)
        let n = try reg_field(m, 1, rn)
        if imm.bit_and(7) != 0 {
            fail("{form_name(m)}: offset {imm} is not a multiple of 8")
        }
        let k = try uimm(m, "offset", imm.shr(3), 12)
        return base.bit_or(k.shl(10)).bit_or(n.shl(5)).bit_or(t)
    }
    if f == 11 {
        let t = try reg_field(m, 0, rd)
        let n = try reg_field(m, 1, rn)
        let t2 = try reg_field(m, 2, rm)
        if imm.bit_and(7) != 0 {
            fail("{form_name(m)}: offset {imm} is not a multiple of 8")
        }
        let w = imm.shr(3)
        if w < -64 or w > 63 {
            fail("{form_name(m)}: offset {imm} is out of range")
        }
        return base.bit_or(w.bit_and(127).shl(15)).bit_or(t2.shl(10)).bit_or(n.shl(5)).bit_or(t)
    }
    if f == 12 {
        let w = try disp(m, off, 26)
        return base.bit_or(w)
    }
    if f == 13 {
        let w = try disp(m, off, 19)
        let c = try uimm(m, "condition", cc, 4)
        return base.bit_or(w.shl(5)).bit_or(c)
    }
    if f == 14 {
        let t = try reg_field(m, 1, rn)
        let w = try disp(m, off, 19)
        return base.bit_or(w.shl(5)).bit_or(t)
    }
    if f == 15 {
        return base
    }
    if f == 16 {
        let k = try uimm(m, "immediate", imm, 16)
        return base.bit_or(k.shl(5))
    }
    if f == 17 {
        let d = try reg_field(m, 0, rd)
        return base.bit_or(d)
    }
    if f == 18 {
        let d = try reg_field(m, 0, rd)
        let n = try reg_field(m, 1, rn)
        return base.bit_or(n.shl(5)).bit_or(d)
    }
    if f == 19 {
        let n = try reg_field(m, 1, rn)
        return base.bit_or(n.shl(5))
    }
    if f == F_LDSTN {
        let t = try reg_field(m, 0, rd)
        let n = try reg_field(m, 1, rn)
        let sz = access_size(m)
        if imm % sz != 0 {
            fail("{form_name(m)}: offset {imm} is not a multiple of {sz}")
        }
        let k = try uimm(m, "offset", imm / sz, 12)
        return base.bit_or(k.shl(10)).bit_or(n.shl(5)).bit_or(t)
    }
    if f == F_ACQREL {
        let t = try reg_field(m, 0, rd)
        let n = try reg_field(m, 1, rn)
        return base.bit_or(n.shl(5)).bit_or(t)
    }
    if f == F_CAS {
        // Rs is field 0 here, Rt field 2.
        let s = try reg_field(m, 0, rd)
        let n = try reg_field(m, 1, rn)
        let t = try reg_field(m, 2, rm)
        return base.bit_or(s.shl(16)).bit_or(n.shl(5)).bit_or(t)
    }
    if f == F_LDADD {
        // Rt is field 0 here, Rs field 2.
        let t = try reg_field(m, 0, rd)
        let n = try reg_field(m, 1, rn)
        let s = try reg_field(m, 2, rm)
        return base.bit_or(s.shl(16)).bit_or(n.shl(5)).bit_or(t)
    }
    if f == F_LDRGOT {
        // The offset is the linker's.
        let t = try reg_field(m, 0, rd)
        let n = try reg_field(m, 1, rn)
        return base.bit_or(n.shl(5)).bit_or(t)
    }
    fail("opcode {m} has no encoding")
}

// ----- assembly text -------------------------------------------------------------

pub fn reg_text(m: i64, field: i64, o: i64) -> str {
    let w = w_field(m, field)
    if is_vreg(o) {
        return "v{o - VR}"
    }
    if is_fpr(o) {
        return "d{o - R_D0}"
    }
    if o == R_SP {
        return "sp"
    }
    if o == R_ZR {
        return if w { "wzr" } else { "xzr" }
    }
    if w {
        "w{o}"
    } else {
        "x{o}"
    }
}

fn rel_text(off: i64) -> str {
    if off < 0 {
        ".-{0 - off}"
    } else {
        ".+{off}"
    }
}

/// The instruction as the system assembler reads it. `target` is what a
/// branch or a relocated instruction refers to: a symbol, or `""` to write
/// the branch as an offset from itself.
pub fn asm_text(m: i64, rd: i64, rn: i64, rm: i64, ra: i64, imm: i64, imm2: i64, cc: i64, off: i64, target: str) -> str {
    let name = mop_name(m)
    let f = mop_fmt(m)
    let d = reg_text(m, 0, rd)
    let n = reg_text(m, 1, rn)
    let mm = reg_text(m, 2, rm)
    if f == 1 {
        return "{name} {d}, {n}, {mm}"
    }
    if f == 2 {
        return "{name} {n}, {mm}"
    }
    if f == 3 {
        return "{name} {d}, {n}, {mm}, {reg_text(m, 3, ra)}"
    }
    if f == 4 {
        return "{name} {d}, {mm}"
    }
    if f == 5 {
        return "{name} {d}, {n}"
    }
    if f == 6 {
        return "{name} {d}, {cond_name(cc)}"
    }
    if f == 7 or f == 8 {
        let sh = if imm2 == 1 { ", lsl #12" } else { "" }
        if f == 7 {
            return "{name} {d}, {n}, #{imm}{sh}"
        }
        return "{name} {n}, #{imm}{sh}"
    }
    if f == 9 {
        if imm2 > 0 {
            return "{name} {d}, #{imm}, lsl #{imm2 * 16}"
        }
        return "{name} {d}, #{imm}"
    }
    if f == 10 {
        return "{name} {d}, [{n}, #{imm}]"
    }
    if f == 11 {
        if m == A_STP_PRE or m == A_FSTP_PRE {
            return "{name} {d}, {mm}, [{n}, #{imm}]!"
        }
        return "{name} {d}, {mm}, [{n}], #{imm}"
    }
    if f == 12 {
        if target != "" {
            return "{name} {target}"
        }
        return "{name} {rel_text(off)}"
    }
    if f == 13 {
        if target != "" {
            return "b.{cond_name(cc)} {target}"
        }
        return "b.{cond_name(cc)} {rel_text(off)}"
    }
    if f == 14 {
        if target != "" {
            return "{name} {n}, {target}"
        }
        return "{name} {n}, {rel_text(off)}"
    }
    if f == 15 {
        return name
    }
    if f == 16 {
        return "{name} #{imm}"
    }
    if f == 17 {
        if m == A_ADRP_GOT {
            return "{name} {d}, {target}@GOTPAGE"
        }
        return "{name} {d}, {target}@PAGE"
    }
    if f == F_LDRGOT {
        return "{name} {d}, [{n}, {target}@GOTPAGEOFF]"
    }
    if f == 18 {
        return "{name} {d}, {n}, {target}@PAGEOFF"
    }
    if f == 19 {
        return "{name} {n}"
    }
    if f == F_LDSTN {
        return "{name} {d}, [{n}, #{imm}]"
    }
    if f == F_ACQREL {
        return "{name} {d}, [{n}]"
    }
    if f == F_CAS {
        return "{name} {d}, {mm}, [{n}]"
    }
    if f == F_LDADD {
        return "{name} {mm}, {d}, [{n}]"
    }
    if m == P_RETURN {
        return "<return>"
    }
    if m == P_MOVIMM {
        return "<movimm> {d}, #{imm}"
    }
    "<?>"
}

/// The register a 16-bit chunk sequence materialises `k` with: (opcode,
/// chunk, shift) triples, first a `movz` or `movn`, then `movk`s.
pub fn movimm_seq(k: i64) -> [i64] {
    var chunks: [i64] = []
    for i in 0..4 {
        chunks.push(k.ushr(16 * i).bit_and(65535))
    }
    var nzero = 0
    var nones = 0
    for c in chunks {
        if c == 0 {
            nzero += 1
        }
        if c == 65535 {
            nones += 1
        }
    }
    var out: [i64] = []
    if nones > nzero {
        // Start from all ones: `movn` writes the complement of its chunk.
        var first = -1
        for i in 0..4 {
            if first < 0 and chunks[i] != 65535 {
                first = i
            }
        }
        if first < 0 {
            out.push(A_MOVN)
            out.push(0)
            out.push(0)
            return out
        }
        out.push(A_MOVN)
        out.push(chunks[first].bit_xor(65535))
        out.push(first)
        for i in 0..4 {
            if i != first and chunks[i] != 65535 {
                out.push(A_MOVK)
                out.push(chunks[i])
                out.push(i)
            }
        }
        return out
    }
    var first = -1
    for i in 0..4 {
        if first < 0 and chunks[i] != 0 {
            first = i
        }
    }
    if first < 0 {
        out.push(A_MOVZ)
        out.push(0)
        out.push(0)
        return out
    }
    out.push(A_MOVZ)
    out.push(chunks[first])
    out.push(first)
    for i in 0..4 {
        if i != first and chunks[i] != 0 {
            out.push(A_MOVK)
            out.push(chunks[i])
            out.push(i)
        }
    }
    out
}
