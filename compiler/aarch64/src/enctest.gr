// The encoder's test cases: for every instruction form, operands generated
// across their ranges -- every register in every field, immediates at both
// ends and between, every condition, branch offsets to the edge of their
// reach -- each with the word the encoder makes and the line the system
// assembler reads. `scripts/encodetest.sh` assembles the lines and compares
// the bytes, word for word (docs/self-hosting.md §6, S3: "an encoding gate
// ... covering every form the rules emit").
import mach

type EncCases = {
    form: [str],
    asm: [str],
    word: [i64],
}

type Rng = {
    s: i64,
}

fn next(inout g: Rng) -> i64 {
    g.s = g.s * 6364136223846793005 + 1442695040888963407
    g.s.ushr(17)
}

/// A number in `lo..=hi`.
fn pick(inout g: Rng, lo: i64, hi: i64) -> i64 {
    let n = next(g)
    lo + n % (hi - lo + 1)
}

/// The register for case `k` of field `f`: every value once in the first
/// 32 cases, then a mix. `alt` is what 31 means here: `R_ZR` or `R_SP`.
fn reg_for(inout g: Rng, k: i64, f: i64, alt: i64) -> i64 {
    var r = 0
    if k < 32 {
        r = (k * (2 * f + 1) + 7 * f) % 32
    } else {
        r = pick(g, 0, 31)
    }
    if r == 31 {
        alt
    } else {
        r
    }
}

fn add(inout c: EncCases, m: i64, rd: i64, rn: i64, rm: i64, ra: i64, imm: i64, imm2: i64, cc: i64, off: i64, target: str) -> () ! str {
    let w = try mach.encode(m, rd, rn, rm, ra, imm, imm2, cc, off)
    c.form.push(mach.form_name(m))
    c.asm.push(mach.asm_text(m, rd, rn, rm, ra, imm, imm2, cc, off, target))
    c.word.push(w)
    ()
}

/// Edge values first, then random ones, of an unsigned field.
fn uimm_for(inout g: Rng, k: i64, bits: i64) -> i64 {
    let top = 1.shl(bits) - 1
    let edges = [0, 1, 2, top, top - 1, 1.shl(bits - 1), 1.shl(bits - 1) - 1]
    if k < edges.len() {
        edges[k]
    } else {
        pick(g, 0, top)
    }
}

/// A branch offset reaching `bits` bits of words: the ends of the range,
/// near zero both ways, and random ones.
fn off_for(inout g: Rng, k: i64, bits: i64) -> i64 {
    let lim = 1.shl(bits - 1)
    let edges = [0, 4, -4, 8, -8, 4 * (lim - 1), -4 * lim, 4 * (lim - 2), -4 * (lim - 1)]
    if k < edges.len() {
        edges[k]
    } else {
        4 * pick(g, 0 - lim, lim - 1)
    }
}

pub fn cases() -> EncCases ! str {
    var c = EncCases{ form: [], asm: [], word: [] }
    var g = Rng{ s: 20261021 }
    let n = 64
    for m in mach.all_mops() {
        if m <= mach.A_ASRV {
            for k in 0..n {
                let rd = reg_for(g, k, 0, mach.R_ZR)
                let rn = reg_for(g, k, 1, mach.R_ZR)
                let rm = reg_for(g, k, 2, mach.R_ZR)
                try add(c, m, rd, rn, rm, -1, 0, 0, -1, 0, "")
            }
        } else if m == mach.A_MSUB {
            for k in 0..n {
                let rd = reg_for(g, k, 0, mach.R_ZR)
                let rn = reg_for(g, k, 1, mach.R_ZR)
                let rm = reg_for(g, k, 2, mach.R_ZR)
                let ra = reg_for(g, k, 3, mach.R_ZR)
                try add(c, m, rd, rn, rm, ra, 0, 0, -1, 0, "")
            }
        } else if m == mach.A_CMPR {
            for k in 0..n {
                let rn = reg_for(g, k, 1, mach.R_ZR)
                let rm = reg_for(g, k, 2, mach.R_ZR)
                try add(c, m, -1, rn, rm, -1, 0, 0, -1, 0, "")
            }
        } else if m >= mach.A_NEG and m <= mach.A_MOVW {
            for k in 0..n {
                let rd = reg_for(g, k, 0, mach.R_ZR)
                let rm = reg_for(g, k, 2, mach.R_ZR)
                try add(c, m, rd, -1, rm, -1, 0, 0, -1, 0, "")
            }
        } else if m >= mach.A_SXTB and m <= mach.A_UXTH {
            for k in 0..n {
                let rd = reg_for(g, k, 0, mach.R_ZR)
                let rn = reg_for(g, k, 1, mach.R_ZR)
                try add(c, m, rd, rn, -1, -1, 0, 0, -1, 0, "")
            }
        } else if m == mach.A_CSET {
            for k in 0..n {
                let rd = reg_for(g, k, 0, mach.R_ZR)
                try add(c, m, rd, -1, -1, -1, 0, 0, k % 14, 0, "")
            }
        } else if m == mach.A_ADDI or m == mach.A_SUBI {
            for k in 0..n {
                let rd = reg_for(g, k, 0, mach.R_SP)
                let rn = reg_for(g, k, 1, mach.R_SP)
                try add(c, m, rd, rn, -1, -1, uimm_for(g, k, 12), k % 2, -1, 0, "")
            }
        } else if m == mach.A_CMPI or m == mach.A_CMNI {
            for k in 0..n {
                let rn = reg_for(g, k, 1, mach.R_SP)
                try add(c, m, -1, rn, -1, -1, uimm_for(g, k, 12), k % 2, -1, 0, "")
            }
        } else if m >= mach.A_MOVZ and m <= mach.A_MOVK {
            for k in 0..n {
                let rd = reg_for(g, k, 0, mach.R_ZR)
                try add(c, m, rd, -1, -1, -1, uimm_for(g, k, 16), k % 4, -1, 0, "")
            }
        } else if m == mach.A_LDR or m == mach.A_STR {
            for k in 0..n {
                let rt = reg_for(g, k, 0, mach.R_ZR)
                let rn = reg_for(g, k, 1, mach.R_SP)
                try add(c, m, rt, rn, -1, -1, 8 * uimm_for(g, k, 12), 0, -1, 0, "")
            }
        } else if m == mach.A_STP_PRE or m == mach.A_LDP_POST {
            var k = 0
            var made = 0
            while made < n {
                let rt = reg_for(g, k, 0, mach.R_ZR)
                let rt2 = reg_for(g, k, 2, mach.R_ZR)
                let rn = reg_for(g, k, 1, mach.R_SP)
                let w = if k < 128 { k - 64 } else { pick(g, -64, 63) }
                k += 1
                // Writing back into a register the pair also names is
                // unpredictable, and the assembler rightly refuses it; so is
                // loading both halves into one register.
                if rn != mach.R_SP and (rn == rt or rn == rt2) {
                    continue
                }
                if m == mach.A_LDP_POST and rt == rt2 {
                    continue
                }
                try add(c, m, rt, rn, rt2, -1, 8 * w, 0, -1, 0, "")
                made += 1
            }
        } else if m == mach.A_B or m == mach.A_BL {
            for k in 0..n {
                try add(c, m, -1, -1, -1, -1, 0, 0, -1, off_for(g, k, 26), "")
            }
            if m == mach.A_BL {
                try add(c, m, -1, -1, -1, -1, 0, 0, -1, 0, "_s3_encode_callee")
            }
        } else if m == mach.A_BCOND {
            for k in 0..n {
                try add(c, m, -1, -1, -1, -1, 0, 0, k % 15, off_for(g, k, 19), "")
            }
        } else if m == mach.A_CBZ or m == mach.A_CBNZ {
            for k in 0..n {
                let rt = reg_for(g, k, 1, mach.R_ZR)
                try add(c, m, -1, rt, -1, -1, 0, 0, -1, off_for(g, k, 19), "")
            }
        } else if m == mach.A_RET or m == mach.A_RETAB or m == mach.A_PACIBSP {
            try add(c, m, -1, -1, -1, -1, 0, 0, -1, 0, "")
        } else if m == mach.A_BRK {
            for k in 0..16 {
                try add(c, m, -1, -1, -1, -1, uimm_for(g, k, 16), 0, -1, 0, "")
            }
        } else if m == mach.A_ADRP {
            for k in 0..31 {
                try add(c, m, k, -1, -1, -1, 0, 0, -1, 0, "_s3_encode_data{k % 3}")
            }
        } else if m == mach.A_ADDPO {
            for k in 0..n {
                let rd = reg_for(g, k, 0, mach.R_SP)
                let rn = reg_for(g, k, 1, mach.R_SP)
                try add(c, m, rd, rn, -1, -1, 0, 0, -1, 0, "_s3_encode_data{k % 3}")
            }
        } else {
            fail("no test cases for opcode {m}")
        }
    }
    c
}
