// VCode: machine instructions over virtual registers, in the blocks MIR had.
//
// An operand is a register number as `mach.gr` defines them: physical
// registers where the calling convention fixes one (arguments, results,
// the stack pointer), virtual ones (`mach.VR + n`) everywhere else. A block
// is a contiguous run of instructions and ends in its branches; a branch's
// target is a block number.
import mach

type VCode = {
    sym: str,
    nvregs: i64,
    /// Per virtual register, its class (`mach.CLS_INT` or `mach.CLS_FP`).
    vcls: [i64],
    nparams: i64,
    /// How many parameters arrive in x0.. and in d0.. (AAPCS64 counts the two
    /// files apart; the rest arrive on the stack).
    nreg_int: i64,
    nreg_fp: i64,
    nslots: i64,
    /// Words at the bottom of the frame for the stack arguments of the
    /// largest call: the frame's slots begin above them.
    nout: i64,
    mop: [i64],
    rd: [i64],
    rn: [i64],
    rm: [i64],
    ra: [i64],
    imm: [i64],
    imm2: [i64],
    cc: [i64],
    tgt: [i64],
    /// What a call or an address refers to: 1 a compiled callable, 2 a
    /// runtime function, 3 a string literal, 4 a writable data object (a
    /// struct descriptor); `sym_id` says which.
    symk: [i64],
    sym_id: [i64],
    bi0: [i64],
    bni: [i64],
}

pub let SYM_NONE = 0
pub let SYM_FN = 1
pub let SYM_RT = 2
pub let SYM_STR = 3
pub let SYM_DATA = 4

pub fn new_vcode(sym: str) -> VCode {
    VCode{
        sym: sym, nvregs: 0, vcls: [], nparams: 0, nreg_int: 0, nreg_fp: 0, nslots: 0, nout: 0,
        mop: [], rd: [], rn: [], rm: [], ra: [], imm: [], imm2: [], cc: [], tgt: [],
        symk: [], sym_id: [], bi0: [], bni: [],
    }
}

pub fn push(inout vc: VCode, mop: i64, rd: i64, rn: i64, rm: i64) -> i64 {
    let i = vc.mop.len()
    vc.mop.push(mop)
    vc.rd.push(rd)
    vc.rn.push(rn)
    vc.rm.push(rm)
    vc.ra.push(-1)
    vc.imm.push(0)
    vc.imm2.push(0)
    vc.cc.push(-1)
    vc.tgt.push(-1)
    vc.symk.push(0)
    vc.sym_id.push(-1)
    i
}

/// A fresh virtual register of class `cls`.
pub fn new_vreg(inout vc: VCode, cls: i64) -> i64 {
    let v = vc.nvregs
    vc.nvregs += 1
    vc.vcls.push(cls)
    mach.VR + v
}

/// The class of operand `o`: a virtual register's own, or a physical
/// register's file.
pub fn cls_of(vc: VCode, o: i64) -> i64 {
    if mach.is_vreg(o) {
        vc.vcls[o - mach.VR]
    } else if mach.is_fpr(o) {
        mach.CLS_FP
    } else {
        mach.CLS_INT
    }
}

pub fn nblocks(vc: VCode) -> i64 {
    vc.bi0.len()
}

// A call (`bl`) says what it reads and writes in its immediates: `imm2` is
// the number of argument registers of each file, `n_int + 16 * n_fp` (x0..,
// d0..), and `imm` the result, 0 none, 1 in x0, 2 in d0. `P_RETURN`'s `imm`
// says the same of the function's own result.
pub let RES_NONE = 0
pub let RES_X0 = 1
pub let RES_D0 = 2

pub fn call_args_code(nint: i64, nfp: i64) -> i64 {
    nint + 16 * nfp
}

pub fn call_nint(code: i64) -> i64 {
    code.bit_and(15)
}

pub fn call_nfp(code: i64) -> i64 {
    code.shr(4)
}

/// The blocks a block can branch to, in the order its branches name them.
pub fn succs(vc: VCode, b: i64) -> [i64] {
    var out: [i64] = []
    for i in vc.bi0[b]..(vc.bi0[b] + vc.bni[b]) {
        if vc.tgt[i] >= 0 {
            out.push(vc.tgt[i])
        }
    }
    out
}

/// The function as text, for reading.
pub fn print_vcode(vc: VCode) -> str {
    var out = str_builder()
    out.push_str("vcode {vc.sym} vregs={vc.nvregs} params={vc.nparams} slots={vc.nslots} out={vc.nout}\n")
    for b in 0..nblocks(vc) {
        out.push_str("  b{b}:\n")
        for i in vc.bi0[b]..(vc.bi0[b] + vc.bni[b]) {
            var target = ""
            if vc.tgt[i] >= 0 {
                target = "b{vc.tgt[i]}"
            } else if vc.symk[i] > 0 {
                target = "sym{vc.symk[i]}:{vc.sym_id[i]}"
            }
            out.push_str("    " + mach.asm_text(vc.mop[i], vc.rd[i], vc.rn[i], vc.rm[i], vc.ra[i], vc.imm[i], vc.imm2[i], vc.cc[i], 0, target) + "\n")
        }
    }
    out.to_str()
}
