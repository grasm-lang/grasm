// Instruction selection for AArch64, as data (docs/self-hosting.md §4: "declarative
// lowering rules per ISA, kept as Grasm data and checked for overlap" -- the
// idea of Cranelift's ISLE and Go's `.rules`).
//
// A rule says: for this MIR opcode, when this guard holds, emit these
// machine instructions. Rules for one opcode are tried in order and the first
// whose guard holds is used, so a rule must come before any rule that would
// cover it. `check` proves that of the table -- no rule is shadowed by an
// earlier one, every opcode ends in a rule that always applies, every
// template reads only what its guard makes available and writes only what it
// may -- and `scripts/encodetest.sh` runs it.
//
// A template names its operands by where they come from (`S_*`), its
// immediates by how they are computed (`K_*`), its condition (`CC_*`) and its
// branch target (`T_*`). `isel.gr` reads nothing else about the instruction
// set: changing what an operation compiles to is changing a row here.
import mach
import mir.ir

type Tmpl = {
    mop: i64,
    d: i64,
    n: i64,
    m: i64,
    a: i64,
    imm: i64,
    imm2: i64,
    cc: i64,
    tgt: i64,
    sym: i64,
}

type Rule = {
    name: str,
    op: i64,
    guard: i64,
    emit: [Tmpl],
}

// Register operands.
pub let S_NONE = 0
pub let S_RES = 1
pub let S_A = 2
pub let S_B = 3
pub let S_T0 = 4
pub let S_ZR = 5
pub let S_SP = 6
/// The operands of the comparison a branch absorbed.
pub let S_IA = 7
pub let S_IB = 8
/// The third operand, of an operation that has one (`ir.has_cargs`): a
/// compare-and-swap's new value.
pub let S_C = 9

// Immediates: a literal when non-negative, else computed.
pub let K_B = -1
pub let K_NB = -2
pub let K_B_HI = -3
pub let K_IB = -4
pub let K_NIB = -5
pub let K_IMM = -6
pub let K_SLOT = -7

// Conditions: through the condition map, from the instruction itself or
// from the comparison its branch absorbed; through the floating-point map
// (`fcc_map`) for a comparison of doubles.
pub let CC_NONE = -3
pub let CC_OWN = -1
pub let CC_INNER = -2
pub let CC_FOWN = -4
pub let CC_FINNER = -5

// Branch targets.
pub let T_NONE = 0
pub let T_THEN = 1
pub let T_ELSE = 2

// Symbols: a compiled function (a function value's code), a string literal
// or a writable data object (a struct descriptor) named by the
// instruction's `imm`.
pub let Y_NONE = 0
pub let Y_FN = 1
pub let Y_STR = 3
pub let Y_DATA = 4
/// A C function, through the global offset table ([T-FN-ADDR]).
pub let Y_GOT = 5

// Guards.
pub let G_ANY = 0
/// Operand b is a constant in 0..4095.
pub let G_B_UIMM12 = 1
/// Operand b is a constant `k << 12` with k in 1..4095.
pub let G_B_UIMM12_HI = 2
/// Operand b is a constant in -4095..-1.
pub let G_B_NIMM12 = 3
/// A `brif` on an `icmp` in its block that nothing else reads.
pub let G_FUSE = 4
/// ... whose b is a constant in 0..4095.
pub let G_FUSE_IMM = 5
/// ... whose b is a constant in -4095..-1.
pub let G_FUSE_NIMM = 6
/// ... `eq` against zero.
pub let G_FUSE_ZERO_EQ = 7
/// ... `ne` against zero.
pub let G_FUSE_ZERO_NE = 8
/// A `brif` on an `fcmp` in its block that nothing else reads.
pub let G_FFUSE = 9

pub fn guard_name(g: i64) -> str {
    match g {
        0 -> "any"
        1 -> "b:uimm12"
        2 -> "b:uimm12<<12"
        3 -> "b:-uimm12"
        4 -> "fuse-icmp"
        5 -> "fuse-icmp b:uimm12"
        6 -> "fuse-icmp b:-uimm12"
        7 -> "fuse-icmp eq 0"
        8 -> "fuse-icmp ne 0"
        9 -> "fuse-fcmp"
        _ -> "?"
    }
}

/// Whether every instruction guard `g2` admits is one `g1` admits too.
pub fn subsumes(g1: i64, g2: i64) -> bool {
    if g1 == G_ANY or g1 == g2 {
        return true
    }
    if g1 == G_FUSE {
        return g2 == G_FUSE_IMM or g2 == G_FUSE_NIMM or g2 == G_FUSE_ZERO_EQ or g2 == G_FUSE_ZERO_NE
    }
    if g1 == G_FUSE_IMM {
        // Zero is in 0..4095.
        return g2 == G_FUSE_ZERO_EQ or g2 == G_FUSE_ZERO_NE
    }
    false
}

fn t(mop: i64, d: i64, n: i64, m: i64) -> Tmpl {
    Tmpl{ mop: mop, d: d, n: n, m: m, a: S_NONE, imm: 0, imm2: 0, cc: CC_NONE, tgt: T_NONE, sym: Y_NONE }
}

fn ti(mop: i64, d: i64, n: i64, imm: i64, imm2: i64) -> Tmpl {
    Tmpl{ mop: mop, d: d, n: n, m: S_NONE, a: S_NONE, imm: imm, imm2: imm2, cc: CC_NONE, tgt: T_NONE, sym: Y_NONE }
}

fn tb(mop: i64, n: i64, cc: i64, tgt: i64) -> Tmpl {
    Tmpl{ mop: mop, d: S_NONE, n: n, m: S_NONE, a: S_NONE, imm: 0, imm2: 0, cc: cc, tgt: tgt, sym: Y_NONE }
}

fn r(name: str, op: i64, guard: i64, emit: [Tmpl]) -> Rule {
    Rule{ name: name, op: op, guard: guard, emit: emit }
}

/// MIR's conditions, in `CC_*` order, as AArch64 condition codes.
pub fn cc_map() -> [i64] {
    [
        mach.C_EQ,
        mach.C_NE,
        mach.C_LT,
        mach.C_LE,
        mach.C_GT,
        mach.C_GE,
        mach.C_LO,
        mach.C_LS,
        mach.C_HI,
        mach.C_HS,
    ]
}

/// MIR's conditions on doubles, `CC_EQ` .. `CC_SGE`, as AArch64 condition
/// codes read after `fcmp`. Not the integer ones: an unordered comparison
/// (a NaN) sets C and V, so `lt` is `mi` (N alone) and `le` is `ls`, which
/// both leave false, where the integer `lt` and `le` would read it as true.
pub fn fcc_map() -> [i64] {
    [
        mach.C_EQ,
        mach.C_NE,
        mach.C_MI,
        mach.C_LS,
        mach.C_GT,
        mach.C_GE,
    ]
}

/// Binary operations with one register form and nothing else to choose.
fn plain(name: str, op: i64, mop: i64) -> Rule {
    r(name, op, G_ANY, [t(mop, S_RES, S_A, S_B)])
}

fn unary(name: str, op: i64, mop: i64) -> Rule {
    if mop == mach.A_NEG or mop == mach.A_MVN or mop == mach.A_MOVW {
        r(name, op, G_ANY, [t(mop, S_RES, S_NONE, S_A)])
    } else {
        r(name, op, G_ANY, [t(mop, S_RES, S_A, S_NONE)])
    }
}

/// The table.
pub fn rules() -> [Rule] {
    var rs: [Rule] = []
    rs.push(r("iconst", ir.M_ICONST, G_ANY, [ti(mach.P_MOVIMM, S_RES, S_NONE, K_IMM, 0)]))

    rs.push(r("add-imm", ir.M_ADD, G_B_UIMM12, [ti(mach.A_ADDI, S_RES, S_A, K_B, 0)]))
    rs.push(r("add-imm-hi", ir.M_ADD, G_B_UIMM12_HI, [ti(mach.A_ADDI, S_RES, S_A, K_B_HI, 1)]))
    rs.push(r("add-negimm", ir.M_ADD, G_B_NIMM12, [ti(mach.A_SUBI, S_RES, S_A, K_NB, 0)]))
    rs.push(plain("add", ir.M_ADD, mach.A_ADDR))

    rs.push(r("sub-imm", ir.M_SUB, G_B_UIMM12, [ti(mach.A_SUBI, S_RES, S_A, K_B, 0)]))
    rs.push(r("sub-imm-hi", ir.M_SUB, G_B_UIMM12_HI, [ti(mach.A_SUBI, S_RES, S_A, K_B_HI, 1)]))
    rs.push(r("sub-negimm", ir.M_SUB, G_B_NIMM12, [ti(mach.A_ADDI, S_RES, S_A, K_NB, 0)]))
    rs.push(plain("sub", ir.M_SUB, mach.A_SUBR))

    rs.push(plain("mul", ir.M_MUL, mach.A_MUL))
    rs.push(plain("sdiv", ir.M_SDIV, mach.A_SDIV))
    rs.push(plain("udiv", ir.M_UDIV, mach.A_UDIV))
    // a % b = a - (a / b) * b; `msub d, n, m, a` is a - n * m.
    var srem_t = t(mach.A_MSUB, S_RES, S_T0, S_B)
    srem_t.a = S_A
    rs.push(r("srem", ir.M_SREM, G_ANY, [t(mach.A_SDIV, S_T0, S_A, S_B), srem_t]))
    rs.push(r("urem", ir.M_UREM, G_ANY, [t(mach.A_UDIV, S_T0, S_A, S_B), srem_t]))
    rs.push(plain("and", ir.M_AND, mach.A_ANDR))
    rs.push(plain("or", ir.M_OR, mach.A_ORRR))
    rs.push(plain("xor", ir.M_XOR, mach.A_EORR))
    rs.push(plain("shl", ir.M_SHL, mach.A_LSLV))
    rs.push(plain("sshr", ir.M_SSHR, mach.A_ASRV))
    rs.push(plain("ushr", ir.M_USHR, mach.A_LSRV))
    rs.push(unary("neg", ir.M_NEG, mach.A_NEG))
    rs.push(unary("not", ir.M_NOT, mach.A_MVN))
    rs.push(unary("sext8", ir.M_SEXT8, mach.A_SXTB))
    rs.push(unary("sext16", ir.M_SEXT16, mach.A_SXTH))
    rs.push(unary("sext32", ir.M_SEXT32, mach.A_SXTW))
    rs.push(unary("uext8", ir.M_UEXT8, mach.A_UXTB))
    rs.push(unary("uext16", ir.M_UEXT16, mach.A_UXTH))
    // Writing a `w` register clears the upper half.
    rs.push(unary("uext32", ir.M_UEXT32, mach.A_MOVW))

    var cset = t(mach.A_CSET, S_RES, S_NONE, S_NONE)
    cset.cc = CC_OWN
    rs.push(r("icmp-imm", ir.M_ICMP, G_B_UIMM12, [ti(mach.A_CMPI, S_NONE, S_A, K_B, 0), cset]))
    rs.push(r("icmp-negimm", ir.M_ICMP, G_B_NIMM12, [ti(mach.A_CMNI, S_NONE, S_A, K_NB, 0), cset]))
    rs.push(r("icmp", ir.M_ICMP, G_ANY, [t(mach.A_CMPR, S_NONE, S_A, S_B), cset]))

    var adrp = t(mach.A_ADRP, S_RES, S_NONE, S_NONE)
    adrp.sym = Y_STR
    var pageoff = t(mach.A_ADDPO, S_RES, S_RES, S_NONE)
    pageoff.sym = Y_STR
    rs.push(r("straddr", ir.M_STRADDR, G_ANY, [adrp, pageoff]))
    var dadrp = t(mach.A_ADRP, S_RES, S_NONE, S_NONE)
    dadrp.sym = Y_DATA
    var dpageoff = t(mach.A_ADDPO, S_RES, S_RES, S_NONE)
    dpageoff.sym = Y_DATA
    rs.push(r("dataaddr", ir.M_DATAADDR, G_ANY, [dadrp, dpageoff]))
    var fadrp = t(mach.A_ADRP, S_RES, S_NONE, S_NONE)
    fadrp.sym = Y_FN
    var fpageoff = t(mach.A_ADDPO, S_RES, S_RES, S_NONE)
    fpageoff.sym = Y_FN
    rs.push(r("fnaddr", ir.M_FNADDR, G_ANY, [fadrp, fpageoff]))
    var gadrp = t(mach.A_ADRP_GOT, S_RES, S_NONE, S_NONE)
    gadrp.sym = Y_GOT
    var gldr = t(mach.A_LDR_GOT, S_RES, S_RES, S_NONE)
    gldr.sym = Y_GOT
    rs.push(r("gotaddr", ir.M_GOTADDR, G_ANY, [gadrp, gldr]))
    rs.push(r("getsp", ir.M_GETSP, G_ANY, [ti(mach.A_ADDI, S_RES, S_SP, 0, 0)]))
    rs.push(r("slotaddr", ir.M_SLOTADDR, G_ANY, [ti(mach.A_ADDI, S_RES, S_SP, K_SLOT, 0)]))
    rs.push(r("load", ir.M_LOAD, G_ANY, [ti(mach.A_LDR, S_RES, S_A, 0, 0)]))
    rs.push(r("store", ir.M_STORE, G_ANY, [ti(mach.A_STR, S_B, S_A, 0, 0)]))

    // Doubles. A constant is its bits made in a general register and moved
    // across; the comparison's condition goes through the floating-point map.
    rs.push(r("fconst", ir.M_FCONST, G_ANY, [ti(mach.P_MOVIMM, S_T0, S_NONE, K_IMM, 0), t(mach.A_FMOV_DX, S_RES, S_T0, S_NONE)]))
    rs.push(plain("fadd", ir.M_FADD, mach.A_FADD))
    rs.push(plain("fsub", ir.M_FSUB, mach.A_FSUB))
    rs.push(plain("fmul", ir.M_FMUL, mach.A_FMUL))
    rs.push(plain("fdiv", ir.M_FDIV, mach.A_FDIV))
    rs.push(unary("fneg", ir.M_FNEG, mach.A_FNEG))
    rs.push(unary("fabs", ir.M_FABS, mach.A_FABS))
    rs.push(unary("fsqrt", ir.M_FSQRT, mach.A_FSQRT))
    rs.push(unary("ffloor", ir.M_FFLOOR, mach.A_FRINTM))
    rs.push(unary("fceil", ir.M_FCEIL, mach.A_FRINTP))
    var fcset = t(mach.A_CSET, S_RES, S_NONE, S_NONE)
    fcset.cc = CC_FOWN
    rs.push(r("fcmp", ir.M_FCMP, G_ANY, [t(mach.A_FCMP, S_NONE, S_A, S_B), fcset]))
    rs.push(unary("scvtf", ir.M_SCVTF, mach.A_SCVTF))
    rs.push(unary("ucvtf", ir.M_UCVTF, mach.A_UCVTF))
    rs.push(unary("fcvtzs", ir.M_FCVTZS, mach.A_FCVTZS))
    rs.push(unary("fcvtzu", ir.M_FCVTZU, mach.A_FCVTZU))
    rs.push(unary("fbits", ir.M_FBITS, mach.A_FMOV_XD))
    rs.push(unary("ffrombits", ir.M_FFROMBITS, mach.A_FMOV_DX))
    // Bits ([L-LIB-BITS-WIDTH]): one instruction each, the narrow widths
    // done around them by the lowering.
    rs.push(unary("clz", ir.M_CLZ, mach.A_CLZ))
    rs.push(unary("rbit", ir.M_RBIT, mach.A_RBIT))
    rs.push(unary("bswap64", ir.M_BSWAP64, mach.A_REV))
    rs.push(unary("bswap16", ir.M_BSWAP16, mach.A_REV16W))
    rs.push(unary("bswap32", ir.M_BSWAP32, mach.A_REVW))
    rs.push(plain("rotr", ir.M_ROTR, mach.A_RORV))
    // Raw memory ([L-LIB-MEM]): each access at offset 0 of its address.
    rs.push(r("load8u", ir.M_LOAD8U, G_ANY, [ti(mach.A_LDRB, S_RES, S_A, 0, 0)]))
    rs.push(r("load8s", ir.M_LOAD8S, G_ANY, [ti(mach.A_LDRSB, S_RES, S_A, 0, 0)]))
    rs.push(r("load16u", ir.M_LOAD16U, G_ANY, [ti(mach.A_LDRH, S_RES, S_A, 0, 0)]))
    rs.push(r("load16s", ir.M_LOAD16S, G_ANY, [ti(mach.A_LDRSH, S_RES, S_A, 0, 0)]))
    rs.push(r("load32u", ir.M_LOAD32U, G_ANY, [ti(mach.A_LDRW, S_RES, S_A, 0, 0)]))
    rs.push(r("load32s", ir.M_LOAD32S, G_ANY, [ti(mach.A_LDRSW, S_RES, S_A, 0, 0)]))
    rs.push(r("store8", ir.M_STORE8, G_ANY, [ti(mach.A_STRB, S_B, S_A, 0, 0)]))
    rs.push(r("store16", ir.M_STORE16, G_ANY, [ti(mach.A_STRH, S_B, S_A, 0, 0)]))
    rs.push(r("store32", ir.M_STORE32, G_ANY, [ti(mach.A_STRW, S_B, S_A, 0, 0)]))
    // Atomics ([L-LIB-ATOMIC]), all sequentially consistent. A
    // compare-and-swap reads the expected value in the register it answers
    // in, so the expected value is moved there first.
    let widths = ["8", "16", "32", "64"]
    for k in 0..4 {
        rs.push(r("aload" + widths[k], ir.M_ALOAD8 + k, G_ANY, [t(mach.A_LDARB + k, S_RES, S_A, S_NONE)]))
        rs.push(r("astore" + widths[k], ir.M_ASTORE8 + k, G_ANY, [t(mach.A_STLRB + k, S_B, S_A, S_NONE)]))
        rs.push(r("aadd" + widths[k], ir.M_AADD8 + k, G_ANY, [t(mach.A_LDADDALB + k, S_RES, S_A, S_B)]))
        rs.push(r("acas" + widths[k], ir.M_ACAS8 + k, G_ANY, [t(mach.A_MOV, S_RES, S_NONE, S_B), t(mach.A_CASALB + k, S_RES, S_A, S_C)]))
    }
    rs.push(r("fload", ir.M_FLOAD, G_ANY, [ti(mach.A_FLDR, S_RES, S_A, 0, 0)]))
    rs.push(r("fstore", ir.M_FSTORE, G_ANY, [ti(mach.A_FSTR, S_B, S_A, 0, 0)]))

    let b_else = tb(mach.A_B, S_NONE, CC_NONE, T_ELSE)
    rs.push(r("brif-fcmp", ir.M_BRIF, G_FFUSE, [t(mach.A_FCMP, S_NONE, S_IA, S_IB), tb(mach.A_BCOND, S_NONE, CC_FINNER, T_THEN), b_else]))
    rs.push(r("brif-cbz", ir.M_BRIF, G_FUSE_ZERO_EQ, [tb(mach.A_CBZ, S_IA, CC_NONE, T_THEN), b_else]))
    rs.push(r("brif-cbnz", ir.M_BRIF, G_FUSE_ZERO_NE, [tb(mach.A_CBNZ, S_IA, CC_NONE, T_THEN), b_else]))
    rs.push(r("brif-cmp-imm", ir.M_BRIF, G_FUSE_IMM, [ti(mach.A_CMPI, S_NONE, S_IA, K_IB, 0), tb(mach.A_BCOND, S_NONE, CC_INNER, T_THEN), b_else]))
    rs.push(r("brif-cmn-imm", ir.M_BRIF, G_FUSE_NIMM, [ti(mach.A_CMNI, S_NONE, S_IA, K_NIB, 0), tb(mach.A_BCOND, S_NONE, CC_INNER, T_THEN), b_else]))
    rs.push(r("brif-cmp", ir.M_BRIF, G_FUSE, [t(mach.A_CMPR, S_NONE, S_IA, S_IB), tb(mach.A_BCOND, S_NONE, CC_INNER, T_THEN), b_else]))
    rs.push(r("brif", ir.M_BRIF, G_ANY, [tb(mach.A_CBNZ, S_A, CC_NONE, T_THEN), b_else]))
    rs.push(r("jump", ir.M_JUMP, G_ANY, [tb(mach.A_B, S_NONE, CC_NONE, T_THEN)]))
    rs.push(r("trap", ir.M_TRAP, G_ANY, [ti(mach.A_BRK, S_NONE, S_NONE, 1, 0)]))
    rs
}

/// The MIR opcodes selection goes through the table for. Calls, returns
/// and block arguments follow the calling convention instead, in `isel.gr`.
pub fn ruled_ops() -> [i64] {
    [
        ir.M_ICONST, ir.M_ADD, ir.M_SUB, ir.M_MUL, ir.M_SDIV, ir.M_UDIV, ir.M_SREM, ir.M_UREM,
        ir.M_AND, ir.M_OR, ir.M_XOR, ir.M_SHL, ir.M_SSHR, ir.M_USHR, ir.M_NEG, ir.M_NOT,
        ir.M_SEXT8, ir.M_SEXT16, ir.M_SEXT32, ir.M_UEXT8, ir.M_UEXT16, ir.M_UEXT32,
        ir.M_ICMP, ir.M_STRADDR, ir.M_DATAADDR, ir.M_FNADDR, ir.M_GOTADDR, ir.M_GETSP, ir.M_SLOTADDR, ir.M_LOAD, ir.M_STORE,
        ir.M_FCONST, ir.M_FADD, ir.M_FSUB, ir.M_FMUL, ir.M_FDIV, ir.M_FNEG, ir.M_FABS, ir.M_FSQRT,
        ir.M_FFLOOR, ir.M_FCEIL, ir.M_FCMP, ir.M_SCVTF, ir.M_UCVTF, ir.M_FCVTZS, ir.M_FCVTZU,
        ir.M_FBITS, ir.M_FFROMBITS, ir.M_FLOAD, ir.M_FSTORE,
        ir.M_CLZ, ir.M_RBIT, ir.M_BSWAP64, ir.M_BSWAP16, ir.M_BSWAP32, ir.M_ROTR,
        ir.M_LOAD8U, ir.M_LOAD8S, ir.M_LOAD16U, ir.M_LOAD16S, ir.M_LOAD32U, ir.M_LOAD32S,
        ir.M_STORE8, ir.M_STORE16, ir.M_STORE32,
        ir.M_ALOAD8, ir.M_ALOAD8 + 1, ir.M_ALOAD8 + 2, ir.M_ALOAD64,
        ir.M_ASTORE8, ir.M_ASTORE8 + 1, ir.M_ASTORE8 + 2, ir.M_ASTORE64,
        ir.M_AADD8, ir.M_AADD8 + 1, ir.M_AADD8 + 2, ir.M_AADD64,
        ir.M_ACAS8, ir.M_ACAS8 + 1, ir.M_ACAS8 + 2, ir.M_ACAS64,
        ir.M_BRIF, ir.M_JUMP, ir.M_TRAP,
    ]
}

/// The operations with no result: the stores and the terminators.
fn no_result(op: i64) -> bool {
    op == ir.M_STORE or op == ir.M_FSTORE or (op >= ir.M_STORE8 and op <= ir.M_STORE32) or (op >= ir.M_ASTORE8 and op <= ir.M_ASTORE64) or op == ir.M_BRIF or op == ir.M_JUMP or op == ir.M_TRAP
}

fn binary_op(op: i64) -> bool {
    ir.nreads(op) == 2 and not ir.is_terminator(op)
}

fn guard_reads_b(g: i64) -> bool {
    g == G_B_UIMM12 or g == G_B_UIMM12_HI or g == G_B_NIMM12
}

/// A guard that absorbs an integer comparison into its branch.
pub fn guard_fuses(g: i64) -> bool {
    g >= G_FUSE and g <= G_FUSE_ZERO_NE
}

/// A guard that absorbs a comparison of doubles into its branch.
pub fn guard_ffuses(g: i64) -> bool {
    g == G_FFUSE
}

/// The class a selector names in a rule for MIR `op` under guard `g`: 1 a
/// double, 0 an integer, -1 nothing a class can be asked of (a temporary,
/// whose class is the field it is first written in).
fn sel_class(op: i64, g: i64, s: i64) -> i64 {
    if s == S_RES {
        return if ir.res_fp(op) { 1 } else { 0 }
    }
    if s == S_A {
        // A branch's `a` is its condition, an integer.
        return if op != ir.M_BRIF and ir.arg_fp(op, 0) { 1 } else { 0 }
    }
    if s == S_B {
        return if ir.arg_fp(op, 1) { 1 } else { 0 }
    }
    if s == S_IA or s == S_IB {
        return if guard_ffuses(g) { 1 } else { 0 }
    }
    if s == S_ZR or s == S_SP or s == S_C {
        return 0
    }
    -1
}

/// The AArch64 condition a signed or unsigned MIR condition must become,
/// and its pairing with its inverse: what `check` holds the map to.
fn cc_inverse(c: i64) -> i64 {
    match c {
        0 -> 1
        1 -> 0
        2 -> 5
        5 -> 2
        3 -> 4
        4 -> 3
        6 -> 9
        9 -> 6
        7 -> 8
        8 -> 7
        _ -> -1
    }
}

/// Everything wrong with the table, or nothing.
pub fn check(rs: [Rule]) -> [str] {
    var problems: [str] = []
    // Coverage, and that each opcode ends in a rule that always applies.
    for op in ruled_ops() {
        var last = -1
        for i in 0..rs.len() {
            if rs[i].op == op {
                last = i
            }
        }
        if last < 0 {
            problems.push("no rule for MIR `{ir.op_name(op)}`")
        } else if rs[last].guard != G_ANY {
            problems.push("the last rule for `{ir.op_name(op)}` ({rs[last].name}) has a guard, so some instructions match nothing")
        }
    }
    for i in 0..rs.len() {
        let ri = rs[i]
        var known = false
        for op in ruled_ops() {
            if op == ri.op {
                known = true
            }
        }
        if not known {
            problems.push("rule {ri.name} is for `{ir.op_name(ri.op)}`, which selection does not route through the table")
        }
        // Overlap: a later rule an earlier one covers can never fire.
        for j in (i + 1)..rs.len() {
            let rj = rs[j]
            if rj.op == ri.op and subsumes(ri.guard, rj.guard) {
                problems.push("rule {rj.name} ({guard_name(rj.guard)}) is shadowed by the earlier rule {ri.name} ({guard_name(ri.guard)})")
            }
        }
        if guard_reads_b(ri.guard) and not binary_op(ri.op) {
            problems.push("rule {ri.name}: guard {guard_name(ri.guard)} on an operation with no operand b")
        }
        if (guard_fuses(ri.guard) or guard_ffuses(ri.guard)) and ri.op != ir.M_BRIF {
            problems.push("rule {ri.name}: only a branch can absorb a comparison")
        }
        if ri.emit.is_empty() {
            problems.push("rule {ri.name} emits nothing")
        }
        // Templates: what each field may read and write.
        var defined_res = false
        var defined_t0 = false
        // The temporary's class: the class of the field it is first written in.
        var t0_class = -1
        for tm in ri.emit {
            let m = tm.mop
            if m != mach.P_MOVIMM and mach.form_name(m) == "?" {
                problems.push("rule {ri.name}: opcode {m} is not an instruction this backend encodes")
            }
            let fields = [tm.d, tm.n, tm.m, tm.a]
            let roles = [mach.role_d(m), mach.role_n(m), mach.role_m(m), mach.role_a(m)]
            for k in 0..4 {
                let s = fields[k]
                let role = roles[k]
                if role == mach.ROLE_NONE and s != S_NONE and not (m == mach.A_CBZ or m == mach.A_CBNZ) {
                    problems.push("rule {ri.name}: {mach.form_name(m)} has no operand {k} to fill")
                }
                // Register classes: what fills a field is of the field's file.
                if s != S_NONE and role != mach.ROLE_NONE {
                    let want = if mach.fp_field(m, k) { 1 } else { 0 }
                    var have = sel_class(ri.op, ri.guard, s)
                    if s == S_T0 {
                        if t0_class < 0 {
                            t0_class = want
                        }
                        have = t0_class
                    }
                    if have >= 0 and have != want {
                        let fw = if want == 1 { "a floating-point" } else { "a general" }
                        problems.push("rule {ri.name}: operand {k} of {mach.form_name(m)} is {fw} register, and what fills it is not")
                    }
                }
                if role == mach.ROLE_DEF and not (s == S_RES or s == S_T0) {
                    problems.push("rule {ri.name}: {mach.form_name(m)} writes operand {k}, which must be the result or a temporary")
                }
                if role == mach.ROLE_USE or role == mach.ROLE_USEDEF {
                    if s == S_NONE {
                        problems.push("rule {ri.name}: {mach.form_name(m)} reads operand {k}, which is not given")
                    }
                    if s == S_RES and not defined_res {
                        problems.push("rule {ri.name}: reads the result before writing it")
                    }
                    if s == S_T0 and not defined_t0 {
                        problems.push("rule {ri.name}: reads a temporary before writing it")
                    }
                    if s == S_B and guard_reads_b(ri.guard) {
                        problems.push("rule {ri.name}: reads b as a register though its guard took it as an immediate")
                    }
                    if s == S_C and not ir.has_cargs(ri.op) {
                        problems.push("rule {ri.name}: reads a third operand its operation does not have")
                    }
                    if (s == S_IA or s == S_IB) and not (guard_fuses(ri.guard) or guard_ffuses(ri.guard)) {
                        problems.push("rule {ri.name}: reads an absorbed comparison it has not absorbed")
                    }
                    if s == S_IB and ri.guard != G_FUSE and ri.guard != G_FFUSE {
                        problems.push("rule {ri.name}: reads the comparison's b as a register though its guard took it as an immediate")
                    }
                }
            }
            if (m == mach.A_CBZ or m == mach.A_CBNZ) and tm.n == S_NONE {
                problems.push("rule {ri.name}: {mach.form_name(m)} tests no register")
            }
            if tm.d == S_RES or tm.n == S_RES {
                if mach.role_d(m) == mach.ROLE_DEF and tm.d == S_RES {
                    defined_res = true
                }
            }
            if tm.d == S_T0 and mach.role_d(m) == mach.ROLE_DEF {
                defined_t0 = true
            }
            for k in [tm.imm, tm.imm2] {
                if (k == K_B or k == K_B_HI or k == K_NB) and not guard_reads_b(ri.guard) {
                    problems.push("rule {ri.name}: uses b as an immediate without a guard that makes it one")
                }
                if k == K_B and ri.guard != G_B_UIMM12 {
                    problems.push("rule {ri.name}: K_B needs the b:uimm12 guard")
                }
                if k == K_B_HI and ri.guard != G_B_UIMM12_HI {
                    problems.push("rule {ri.name}: K_B_HI needs the b:uimm12<<12 guard")
                }
                if k == K_NB and ri.guard != G_B_NIMM12 {
                    problems.push("rule {ri.name}: K_NB needs the b:-uimm12 guard")
                }
                if k == K_IB and ri.guard != G_FUSE_IMM {
                    problems.push("rule {ri.name}: K_IB needs the fuse-icmp b:uimm12 guard")
                }
                if k == K_NIB and ri.guard != G_FUSE_NIMM {
                    problems.push("rule {ri.name}: K_NIB needs the fuse-icmp b:-uimm12 guard")
                }
            }
            if tm.cc == CC_INNER and not guard_fuses(ri.guard) {
                problems.push("rule {ri.name}: takes the condition of a comparison it has not absorbed")
            }
            if tm.cc == CC_FINNER and not guard_ffuses(ri.guard) {
                problems.push("rule {ri.name}: takes the condition of a comparison of doubles it has not absorbed")
            }
            if tm.cc == CC_OWN and ri.op != ir.M_ICMP {
                problems.push("rule {ri.name}: only an integer comparison reads the integer condition map")
            }
            if tm.cc == CC_FOWN and ri.op != ir.M_FCMP {
                problems.push("rule {ri.name}: only a comparison of doubles reads the floating-point condition map")
            }
            if (m == mach.A_CSET or m == mach.A_BCOND) and tm.cc == CC_NONE {
                problems.push("rule {ri.name}: {mach.form_name(m)} needs a condition")
            }
            let branch = m == mach.A_B or m == mach.A_BCOND or m == mach.A_CBZ or m == mach.A_CBNZ
            if branch != (tm.tgt != T_NONE) {
                problems.push("rule {ri.name}: {mach.form_name(m)} and its branch target disagree")
            }
            if (m == mach.A_ADRP or m == mach.A_ADDPO or m == mach.A_ADRP_GOT or m == mach.A_LDR_GOT) != (tm.sym != Y_NONE) {
                problems.push("rule {ri.name}: {mach.form_name(m)} and its symbol disagree")
            }
        }
        if not no_result(ri.op) and not defined_res {
            problems.push("rule {ri.name} never writes its result")
        }
    }
    for p in check_fcc(fcc_map()) {
        problems.push(p)
    }
    // The condition map, checked against what the conditions mean: for
    // pairs of values at the edges of both orders, the AArch64 condition,
    // read off the flags `cmp a, b` sets, must hold exactly when the MIR
    // condition does.
    let cm = cc_map()
    if cm.len() != 10 {
        problems.push("the condition map has {cm.len()} entries for 10 conditions")
    } else {
        let mn = -9223372036854775807 - 1
        let mx = 9223372036854775807
        let vals = [0, 1, -1, 2, -2, 100, -100, mn, mx, mn + 1, mx - 1]
        for c in 0..10 {
            var wrong = 0
            var example = ""
            for a in vals {
                for b in vals {
                    if cond_holds(cm[c], a, b) != mir_holds(c, a, b) {
                        if wrong == 0 {
                            example = "{a} vs {b}"
                        }
                        wrong += 1
                    }
                }
            }
            if wrong > 0 {
                problems.push("{ir.cc_name(c)} maps to {mach.cond_name(cm[c])}, which disagrees on {wrong} pairs, first {example}")
            }
            let inv = cc_inverse(c)
            if mach.cond_invert(cm[c]) != cm[inv] {
                problems.push("{ir.cc_name(c)} maps to {mach.cond_name(cm[c])}, whose inverse is not what {ir.cc_name(inv)} maps to ({mach.cond_name(cm[inv])})")
            }
        }
    }
    problems
}

/// `a <u b`, on the bits.
fn ult(a: i64, b: i64) -> bool {
    let mn = -9223372036854775807 - 1
    a.bit_xor(mn) < b.bit_xor(mn)
}

/// What a MIR condition says of `a` and `b`.
fn mir_holds(c: i64, a: i64, b: i64) -> bool {
    match c {
        0 -> a == b
        1 -> a != b
        2 -> a < b
        3 -> a <= b
        4 -> a > b
        5 -> a >= b
        6 -> ult(a, b)
        7 -> not ult(b, a)
        8 -> ult(b, a)
        9 -> not ult(a, b)
        _ -> false
    }
}

/// Whether AArch64 condition `cond` holds after `cmp a, b`, from the flags
/// the subtraction sets (Arm ARM, ConditionHolds).
fn cond_holds(cond: i64, a: i64, b: i64) -> bool {
    let r = a - b
    let n = r < 0
    let z = r == 0
    let cf = not ult(a, b)
    let v = (a < 0) != (b < 0) and (r < 0) != (a < 0)
    flags_hold(cond, n, z, cf, v)
}

/// The floating-point condition map, checked as the integer one is: for
/// pairs of doubles at the edges -- both zeros, both infinities, the
/// smallest and largest finite values, a subnormal and a NaN -- the AArch64
/// condition, read off the flags `fcmp a, b` sets, must hold exactly when
/// the comparison does by IEEE 754: false for every ordered relation a NaN
/// takes part in, true for `!=`. Grasm's own `f64` comparisons, which are
/// IEEE's, are the reference. Each condition's inverse must also be what the
/// emitter makes of `b.cc next; b other`.
fn check_fcc(fm: [i64]) -> [str] {
    var problems: [str] = []
    if fm.len() != 6 {
        problems.push("the floating-point condition map has {fm.len()} entries for 6 conditions")
        return problems
    }
    let zero = 0.0
    let nan = zero / zero
    let inf = 1.0 / zero
    let big = 0x7FEFFFFFFFFFFFFF.from_bits()
    let tiny = 1.from_bits()
    let vals = [0.0, -zero, 1.0, -1.0, 2.5, -2.5, inf, -inf, nan, big, -big, tiny, -tiny]
    for c in 0..6 {
        var wrong = 0
        var example = ""
        for a in vals {
            for b in vals {
                if fcond_holds(fm[c], a, b) != fmir_holds(c, a, b) {
                    if wrong == 0 {
                        example = "{a} vs {b}"
                    }
                    wrong += 1
                }
            }
        }
        if wrong > 0 {
            problems.push("on doubles, {ir.cc_name(c)} maps to {mach.cond_name(fm[c])}, which disagrees on {wrong} pairs, first {example}")
        }
    }
    problems
}

/// What a MIR condition on doubles says of `a` and `b`.
fn fmir_holds(c: i64, a: f64, b: f64) -> bool {
    match c {
        0 -> a == b
        1 -> a != b
        2 -> a < b
        3 -> a <= b
        4 -> a > b
        5 -> a >= b
        _ -> false
    }
}

/// Whether AArch64 condition `cond` holds after `fcmp a, b` (Arm ARM,
/// FPCompare): equal sets Z and C, less sets N, greater sets C, and
/// unordered sets C and V.
fn fcond_holds(cond: i64, a: f64, b: f64) -> bool {
    if a.is_nan() or b.is_nan() {
        return flags_hold(cond, false, false, true, true)
    }
    if a == b {
        return flags_hold(cond, false, true, true, false)
    }
    if a < b {
        return flags_hold(cond, true, false, false, false)
    }
    flags_hold(cond, false, false, true, false)
}

/// Whether condition `cond` holds of flags N, Z, C, V.
fn flags_hold(cond: i64, n: bool, z: bool, cf: bool, v: bool) -> bool {
    match cond {
        0 -> z
        1 -> not z
        2 -> cf
        3 -> not cf
        4 -> n
        5 -> not n
        6 -> v
        7 -> not v
        8 -> cf and not z
        9 -> not cf or z
        10 -> n == v
        11 -> n != v
        12 -> not z and n == v
        13 -> z or n != v
        _ -> true
    }
}

/// Every opcode a rule can emit, with `P_MOVIMM` as what it expands to.
pub fn rule_mops(rs: [Rule]) -> [i64] {
    var seen: [bool] = []
    for m in 0..mach.NMOPS {
        seen.push(false)
    }
    for ru in rs {
        for tm in ru.emit {
            if tm.mop == mach.P_MOVIMM {
                seen[mach.A_MOVZ] = true
                seen[mach.A_MOVN] = true
                seen[mach.A_MOVK] = true
            } else if tm.mop < mach.NMOPS {
                seen[tm.mop] = true
            }
        }
    }
    var out: [i64] = []
    for m in 0..mach.NMOPS {
        if seen[m] {
            out.push(m)
        }
    }
    out
}
