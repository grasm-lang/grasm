// Instruction selection: MIR to VCode, by the rules in `rules.gr`.
//
// Each MIR value becomes the virtual register of the same number. For every
// instruction the first rule whose guard holds is chosen, then the chosen
// templates are expanded; an instruction whose every use was absorbed into
// another's encoding -- a constant used only as an immediate, a comparison
// folded into its branch -- is not emitted at all.
//
// The calling convention is not in the table, because it is not a choice:
// integer arguments go in x0..x7 and doubles in d0..d7, the two counted
// apart, the rest on the stack in argument order, and the result comes back
// in x0 or d0 (AAPCS64), so a call is moves into those registers, the `bl`,
// and a move out. Block arguments become moves at the end of the jumping
// block, sequenced so that no move overwrites a value another still has to
// read. Every virtual register has the class of the MIR value it holds
// (`MirFn.vfp`), and a move is `mov` or `fmov` by it.
import mach
import rules
import vcode
import mir.ir

type Sel = {
    def_inst: [i64],
    uses: [i64],
    ruses: [i64],
    rule_of: [i64],
    term_rule: [i64],
    inner: [i64],
    absorbed: [bool],
}

fn const_of(f: MirFn, s: Sel, v: i64) -> (bool, i64) {
    if v < 0 {
        return (false, 0)
    }
    let i = s.def_inst[v]
    if i >= 0 and f.op[i] == ir.M_ICONST {
        return (true, f.imm[i])
    }
    (false, 0)
}

fn b_guard(g: i64, k: i64) -> bool {
    if g == rules.G_B_UIMM12 {
        k >= 0 and k <= 4095
    } else if g == rules.G_B_UIMM12_HI {
        k > 4095 and k.bit_and(4095) == 0 and k.shr(12) <= 4095
    } else if g == rules.G_B_NIMM12 {
        k >= -4095 and k <= -1
    } else {
        false
    }
}

/// Whether guard `g` holds for instruction `i` (or, with `i` < 0, for the
/// terminator of block `b`, whose candidate comparison is `j`).
fn guard_holds(f: MirFn, s: Sel, g: i64, i: i64, j: i64) -> bool {
    if g == rules.G_ANY {
        return true
    }
    if g == rules.G_B_UIMM12 or g == rules.G_B_UIMM12_HI or g == rules.G_B_NIMM12 {
        if i < 0 or ir.nreads(f.op[i]) != 2 {
            return false
        }
        let (isk, k) = const_of(f, s, f.b[i])
        return isk and b_guard(g, k)
    }
    // The fusing guards: `j` is a comparison only this branch reads, of
    // integers for the `G_FUSE` family and of doubles for `G_FFUSE`.
    if j < 0 {
        return false
    }
    if g == rules.G_FFUSE {
        return f.op[j] == ir.M_FCMP
    }
    if f.op[j] != ir.M_ICMP {
        return false
    }
    if g == rules.G_FUSE {
        return true
    }
    let (isk, k) = const_of(f, s, f.b[j])
    if g == rules.G_FUSE_IMM {
        return isk and k >= 0 and k <= 4095
    }
    if g == rules.G_FUSE_NIMM {
        return isk and k >= -4095 and k <= -1
    }
    if g == rules.G_FUSE_ZERO_EQ {
        return isk and k == 0 and f.imm[j] == ir.CC_EQ
    }
    if g == rules.G_FUSE_ZERO_NE {
        return isk and k == 0 and f.imm[j] == ir.CC_NE
    }
    false
}

fn choose(f: MirFn, s: Sel, rs: [Rule], op: i64, i: i64, j: i64) -> i64 {
    for k in 0..rs.len() {
        if rs[k].op == op and guard_holds(f, s, rs[k].guard, i, j) {
            return k
        }
    }
    -1
}

fn bump(inout s: Sel, v: i64) {
    if v >= 0 {
        s.ruses[v] += 1
    }
}

/// Counts the register reads a chosen rule makes.
fn count_rule(f: MirFn, inout s: Sel, ru: Rule, a: i64, b: i64, ia: i64, ib: i64) {
    for tm in ru.emit {
        for sel in [tm.d, tm.n, tm.m, tm.a] {
            if sel == rules.S_A {
                bump(s, a)
            } else if sel == rules.S_B {
                bump(s, b)
            } else if sel == rules.S_IA {
                bump(s, ia)
            } else if sel == rules.S_IB {
                bump(s, ib)
            }
        }
    }
}

/// Chooses a rule for every instruction and terminator, and counts what is
/// left to read in registers.
fn plan(f: MirFn, rs: [Rule]) -> Sel ! str {
    let nv = f.nvals
    var s = Sel{ def_inst: [], uses: [], ruses: [], rule_of: [], term_rule: [], inner: [], absorbed: [] }
    for v in 0..nv {
        s.def_inst.push(-1)
        s.uses.push(0)
        s.ruses.push(0)
    }
    for i in 0..f.op.len() {
        if f.res[i] >= 0 {
            s.def_inst[f.res[i]] = i
        }
        let n = ir.nreads(f.op[i])
        if n >= 1 {
            s.uses[f.a[i]] += 1
        }
        if n >= 2 {
            s.uses[f.b[i]] += 1
        }
        for j in f.ca0[i]..(f.ca0[i] + f.can[i]) {
            s.uses[f.cargs[j]] += 1
        }
        s.rule_of.push(-1)
        s.absorbed.push(false)
    }
    let nb = ir.nblocks(f)
    for b in 0..nb {
        if f.tv[b] >= 0 {
            s.uses[f.tv[b]] += 1
        }
        for j in f.ta0[b]..(f.ta0[b] + f.tan[b]) {
            s.uses[f.targs[j]] += 1
        }
        for j in f.fa0[b]..(f.fa0[b] + f.fan[b]) {
            s.uses[f.targs[j]] += 1
        }
    }
    for b in 0..nb {
        // The terminator first: it may absorb a comparison.
        let k = f.tk[b]
        var tr = -1
        var j = -1
        if k == ir.M_BRIF {
            let c = f.tv[b]
            let d = s.def_inst[c]
            if d >= f.bi0[b] and d < f.bi0[b] + f.bni[b] and (f.op[d] == ir.M_ICMP or f.op[d] == ir.M_FCMP) and s.uses[c] == 1 {
                j = d
            }
            tr = choose(f, s, rs, ir.M_BRIF, -1, j)
            if tr >= 0 and (rules.guard_fuses(rs[tr].guard) or rules.guard_ffuses(rs[tr].guard)) {
                s.absorbed[j] = true
            } else {
                j = -1
            }
        } else if k == ir.M_JUMP or k == ir.M_TRAP {
            tr = choose(f, s, rs, k, -1, -1)
        }
        if (k == ir.M_BRIF or k == ir.M_JUMP or k == ir.M_TRAP) and tr < 0 {
            fail("no rule selects `{ir.op_name(k)}`")
        }
        s.term_rule.push(tr)
        s.inner.push(j)
        for i in f.bi0[b]..(f.bi0[b] + f.bni[b]) {
            let op = f.op[i]
            if is_call(op) {
                continue
            }
            let ri = choose(f, s, rs, op, i, -1)
            if ri < 0 {
                fail("no rule selects `{ir.op_name(op)}`")
            }
            s.rule_of[i] = ri
        }
    }
    // Register reads: from every instruction that will be emitted.
    for i in 0..f.op.len() {
        if s.absorbed[i] {
            continue
        }
        let op = f.op[i]
        if op == ir.M_CALL or op == ir.M_CALLRT or op == ir.M_CALLIND {
            if op == ir.M_CALLIND {
                bump(s, f.a[i])
            }
            for j in f.ca0[i]..(f.ca0[i] + f.can[i]) {
                bump(s, f.cargs[j])
            }
        } else if op == ir.M_INC or op == ir.M_DEC {
            bump(s, f.a[i])
        } else {
            count_rule(f, s, rs[s.rule_of[i]], f.a[i], f.b[i], -1, -1)
        }
    }
    for b in 0..nb {
        let k = f.tk[b]
        if k == ir.M_RET {
            bump(s, f.tv[b])
        } else if k == ir.M_BRIF {
            let j = s.inner[b]
            var ia = -1
            var ib = -1
            if j >= 0 {
                ia = f.a[j]
                ib = f.b[j]
            }
            count_rule(f, s, rs[s.term_rule[b]], f.tv[b], -1, ia, ib)
        }
        for j in f.ta0[b]..(f.ta0[b] + f.tan[b]) {
            bump(s, f.targs[j])
        }
        for j in f.fa0[b]..(f.fa0[b] + f.fan[b]) {
            bump(s, f.targs[j])
        }
    }
    // A pure instruction nobody reads in a register is not emitted, and
    // stops counting as a reader of its own operands. Repeat to a fixpoint,
    // walking backwards so a chain goes in one pass.
    var changed = true
    while changed {
        changed = false
        var i = f.op.len() - 1
        while i >= 0 {
            if not s.absorbed[i] and ir.pure_op(f.op[i]) and f.res[i] >= 0 and s.ruses[f.res[i]] == 0 {
                s.absorbed[i] = true
                changed = true
                let ru = rs[s.rule_of[i]]
                for tm in ru.emit {
                    for sel in [tm.d, tm.n, tm.m, tm.a] {
                        if sel == rules.S_A and f.a[i] >= 0 {
                            s.ruses[f.a[i]] -= 1
                        } else if sel == rules.S_B and f.b[i] >= 0 {
                            s.ruses[f.b[i]] -= 1
                        }
                    }
                }
            }
            i -= 1
        }
    }
    s
}

/// Operations that follow the calling convention rather than the rule table.
fn is_call(op: i64) -> bool {
    op == ir.M_CALL or op == ir.M_CALLRT or op == ir.M_CALLIND or op == ir.M_INC or op == ir.M_DEC
}

fn vr(v: i64) -> i64 {
    if v < 0 { -1 } else { mach.VR + v }
}

fn sel_reg(sel: i64, res: i64, a: i64, b: i64, t0: i64, ia: i64, ib: i64) -> i64 {
    match sel {
        1 -> vr(res)
        2 -> vr(a)
        3 -> vr(b)
        4 -> t0
        5 -> mach.R_ZR
        6 -> mach.R_SP
        7 -> vr(ia)
        8 -> vr(ib)
        _ -> -1
    }
}

/// Expands one rule application. `i` is the instruction (-1 for a
/// terminator), `j` the comparison a branch absorbed, `tt`/`tf` the branch
/// targets.
fn expand(inout vc: VCode, f: MirFn, s: Sel, ru: Rule, ccm: [i64], fccm: [i64], i: i64, j: i64, tt: i64, tf: i64, cond: i64) -> () ! str {
    var res = -1
    var a = -1
    var b = -1
    var own_imm = 0
    if i >= 0 {
        res = f.res[i]
        a = f.a[i]
        b = f.b[i]
        own_imm = f.imm[i]
    } else {
        a = cond
    }
    var ia = -1
    var ib = -1
    if j >= 0 {
        ia = f.a[j]
        ib = f.b[j]
    }
    // The temporary, of the class of the field it is first named in.
    var t0 = -1
    for tm in ru.emit {
        let sels = [tm.d, tm.n, tm.m, tm.a]
        for k in 0..4 {
            if t0 < 0 and sels[k] == rules.S_T0 {
                t0 = vcode.new_vreg(vc, if mach.fp_field(tm.mop, k) { mach.CLS_FP } else { mach.CLS_INT })
            }
        }
    }
    for tm in ru.emit {
        let d = sel_reg(tm.d, res, a, b, t0, ia, ib)
        let n = sel_reg(tm.n, res, a, b, t0, ia, ib)
        let m = sel_reg(tm.m, res, a, b, t0, ia, ib)
        let ra = sel_reg(tm.a, res, a, b, t0, ia, ib)
        var imms: [i64] = []
        for k in [tm.imm, tm.imm2] {
            if k >= 0 {
                imms.push(k)
            } else if k == rules.K_B or k == rules.K_NB or k == rules.K_B_HI {
                let (isk, c) = const_of(f, s, b)
                if not isk {
                    fail("a rule took operand b as an immediate, and it is not a constant")
                }
                imms.push(if k == rules.K_B { c } else if k == rules.K_NB { 0 - c } else { c.shr(12) })
            } else if k == rules.K_IB or k == rules.K_NIB {
                let (isk, c) = const_of(f, s, ib)
                if not isk {
                    fail("a rule took the comparison's b as an immediate, and it is not a constant")
                }
                imms.push(if k == rules.K_IB { c } else { 0 - c })
            } else if k == rules.K_IMM {
                imms.push(own_imm)
            } else if k == rules.K_SLOT {
                // Above the outgoing stack arguments.
                let off = (own_imm + vc.nout) * 8
                if off > 4095 {
                    fail("frame slot {own_imm} is out of reach of an immediate")
                }
                imms.push(off)
            } else {
                fail("unknown immediate selector {k}")
            }
        }
        if tm.mop == mach.P_MOVIMM {
            let seq = mach.movimm_seq(imms[0])
            var q = 0
            while q < seq.len() {
                let x = vcode.push(vc, seq[q], d, -1, -1)
                vc.imm[x] = seq[q + 1]
                vc.imm2[x] = seq[q + 2]
                q += 3
            }
            continue
        }
        let x = vcode.push(vc, tm.mop, d, n, m)
        vc.ra[x] = ra
        vc.imm[x] = imms[0]
        vc.imm2[x] = imms[1]
        if tm.cc == rules.CC_OWN {
            vc.cc[x] = ccm[own_imm]
        } else if tm.cc == rules.CC_INNER {
            vc.cc[x] = ccm[f.imm[j]]
        } else if tm.cc == rules.CC_FOWN {
            vc.cc[x] = fccm[own_imm]
        } else if tm.cc == rules.CC_FINNER {
            vc.cc[x] = fccm[f.imm[j]]
        }
        if tm.tgt == rules.T_THEN {
            vc.tgt[x] = tt
        } else if tm.tgt == rules.T_ELSE {
            vc.tgt[x] = tf
        }
        if tm.sym == rules.Y_STR {
            vc.symk[x] = vcode.SYM_STR
            vc.sym_id[x] = own_imm
        } else if tm.sym == rules.Y_FN {
            vc.symk[x] = vcode.SYM_FN
            vc.sym_id[x] = own_imm
        } else if tm.sym == rules.Y_DATA {
            vc.symk[x] = vcode.SYM_DATA
            vc.sym_id[x] = own_imm
        }
    }
    ()
}

/// A register-to-register move within one class: `mov` (an `orr` with the
/// zero register, Rm the source) for integers, `fmov` (Rn the source) for
/// doubles.
fn mov(inout vc: VCode, d: i64, src: i64) {
    if vcode.cls_of(vc, d) == mach.CLS_FP {
        vcode.push(vc, mach.A_FMOV, d, src, -1)
    } else {
        vcode.push(vc, mach.A_MOV, d, -1, src)
    }
    ()
}

/// Moves that happen at once: each `dsts[k]` gets the value `srcs[k]` had
/// before any of them. Emitted one at a time, a destination is written only
/// once nothing still to come reads it; a cycle is broken through a fresh
/// register.
fn par_moves(inout vc: VCode, dsts: [i64], srcs: [i64]) {
    var pd: [i64] = []
    var ps: [i64] = []
    for k in 0..dsts.len() {
        if dsts[k] != srcs[k] {
            pd.push(dsts[k])
            ps.push(srcs[k])
        }
    }
    while pd.len() > 0 {
        var done = -1
        for k in 0..pd.len() {
            if done < 0 {
                var read_later = false
                for q in 0..ps.len() {
                    if q != k and ps[q] == pd[k] {
                        read_later = true
                    }
                }
                if not read_later {
                    done = k
                }
            }
        }
        if done >= 0 {
            mov(vc, pd[done], ps[done])
            pd.remove(done)
            ps.remove(done)
        } else {
            // A cycle: keep the first destination's value, then it is free.
            let keep = pd[0]
            let t = vcode.new_vreg(vc, vcode.cls_of(vc, keep))
            mov(vc, t, keep)
            for q in 0..ps.len() {
                if ps[q] == keep {
                    ps[q] = t
                }
            }
        }
    }
}

/// Where AAPCS64 puts each of a call's (or a function's) arguments, given
/// which are doubles: integers in x0..x7 and doubles in d0..d7, counted
/// apart, and whatever does not fit in its file on the stack, eight bytes
/// each in argument order. `reg[k]` is argument k's register, or -1 when it
/// travels on the stack at slot `slot[k]`.
type ArgPlan = {
    reg: [i64],
    slot: [i64],
    nint: i64,
    nfp: i64,
    nstack: i64,
}

fn plan_args(fp: [bool]) -> ArgPlan {
    var p = ArgPlan{ reg: [], slot: [], nint: 0, nfp: 0, nstack: 0 }
    for k in 0..fp.len() {
        if fp[k] and p.nfp < 8 {
            p.reg.push(mach.R_D0 + p.nfp)
            p.slot.push(-1)
            p.nfp += 1
        } else if not fp[k] and p.nint < 8 {
            p.reg.push(p.nint)
            p.slot.push(-1)
            p.nint += 1
        } else {
            p.reg.push(-1)
            p.slot.push(p.nstack)
            p.nstack += 1
        }
    }
    p
}

/// The classes of instruction `i`'s arguments.
fn call_fp(f: MirFn, i: i64) -> [bool] {
    var out: [bool] = []
    for j in f.ca0[i]..(f.ca0[i] + f.can[i]) {
        out.push(f.vfp[f.cargs[j]])
    }
    out
}

/// Selects machine instructions for a whole function.
pub fn select(f: MirFn, rs: [Rule], ccm: [i64], fccm: [i64]) -> VCode ! str {
    let s = try plan(f, rs)
    var vc = vcode.new_vcode(f.sym)
    vc.nvregs = f.nvals
    for v in 0..f.nvals {
        vc.vcls.push(if f.vfp[v] { mach.CLS_FP } else { mach.CLS_INT })
    }
    vc.nparams = f.nparams
    vc.nslots = f.nslots
    // Arguments that do not fit in registers travel on the stack (AAPCS64),
    // eight bytes each: the caller stores them at the bottom of its frame,
    // where `sp` points at the call, and the callee reads them above its
    // saved frame pointer. The outgoing area is as big as the largest call
    // needs.
    for i in 0..f.op.len() {
        if f.op[i] == ir.M_CALL or f.op[i] == ir.M_CALLRT or f.op[i] == ir.M_CALLIND {
            let ap = plan_args(call_fp(f, i))
            if f.op[i] == ir.M_CALLRT and ap.nstack > 0 {
                fail("a runtime call with {f.can[i]} arguments; only eight of each class travel in registers")
            }
            if ap.nstack > vc.nout {
                vc.nout = ap.nstack
            }
        }
    }
    var pfp: [bool] = []
    for k in 0..f.bnp[0] {
        pfp.push(f.vfp[f.bparams[f.bp0[0] + k]])
    }
    let pp = plan_args(pfp)
    vc.nreg_int = pp.nint
    vc.nreg_fp = pp.nfp
    let nb = ir.nblocks(f)
    for b in 0..nb {
        vc.bi0.push(vc.mop.len())
        if b == 0 {
            // Parameters arrive in x0..x7 and d0..d7, and the rest at the
            // frame pointer: past the saved pair, where the caller's `sp` was.
            for k in 0..f.bnp[0] {
                let p = vr(f.bparams[f.bp0[0] + k])
                if pp.reg[k] >= 0 {
                    mov(vc, p, pp.reg[k])
                } else {
                    let x = vcode.push(vc, if pfp[k] { mach.A_FLDR } else { mach.A_LDR }, p, mach.R_FP, -1)
                    vc.imm[x] = 16 + 8 * pp.slot[k]
                }
            }
        }
        for i in f.bi0[b]..(f.bi0[b] + f.bni[b]) {
            if s.absorbed[i] {
                continue
            }
            let op = f.op[i]
            if op == ir.M_CALL or op == ir.M_CALLRT or op == ir.M_CALLIND {
                let n = f.can[i]
                let cfp = call_fp(f, i)
                let ap = plan_args(cfp)
                // The stack arguments first: storing them reads registers the
                // moves below may be about to fill.
                for k in 0..n {
                    if ap.reg[k] < 0 {
                        let x = vcode.push(vc, if cfp[k] { mach.A_FSTR } else { mach.A_STR }, vr(f.cargs[f.ca0[i] + k]), mach.R_SP, -1)
                        vc.imm[x] = 8 * ap.slot[k]
                    }
                }
                for k in 0..n {
                    if ap.reg[k] >= 0 {
                        mov(vc, ap.reg[k], vr(f.cargs[f.ca0[i] + k]))
                    }
                }
                // A call through a function value's code is `blr` on the
                // register holding it, which the argument moves above cannot
                // have overwritten: its interval spans them, so it was never
                // given one of their registers.
                let x = if op == ir.M_CALLIND { vcode.push(vc, mach.A_BLR, -1, vr(f.a[i]), -1) } else { vcode.push(vc, mach.A_BL, -1, -1, -1) }
                let res_fp = f.res[i] >= 0 and f.vfp[f.res[i]]
                vc.imm[x] = if f.res[i] < 0 { vcode.RES_NONE } else if res_fp { vcode.RES_D0 } else { vcode.RES_X0 }
                vc.imm2[x] = vcode.call_args_code(ap.nint, ap.nfp)
                if op != ir.M_CALLIND {
                    vc.symk[x] = if op == ir.M_CALL { vcode.SYM_FN } else { vcode.SYM_RT }
                    vc.sym_id[x] = f.imm[i]
                }
                if f.res[i] >= 0 {
                    mov(vc, vr(f.res[i]), if res_fp { mach.R_D0 } else { 0 })
                }
                continue
            }
            if op == ir.M_INC or op == ir.M_DEC {
                // Reference counting is the runtime's: a call, so the count
                // is changed atomically and a release that reaches zero frees
                // what it must, exactly as for the Cranelift build.
                mov(vc, 0, vr(f.a[i]))
                let x = vcode.push(vc, mach.A_BL, -1, -1, -1)
                vc.imm[x] = vcode.RES_NONE
                vc.imm2[x] = vcode.call_args_code(1, 0)
                vc.symk[x] = vcode.SYM_RT
                vc.sym_id[x] = if op == ir.M_INC { ir.RT_VAL_INC } else { ir.RT_VAL_DEC }
                continue
            }
            try expand(vc, f, s, rs[s.rule_of[i]], ccm, fccm, i, -1, -1, -1, -1)
        }
        let k = f.tk[b]
        if k == ir.M_RET {
            // The result in x0, or a double in d0.
            var rk = vcode.RES_NONE
            if f.tv[b] >= 0 {
                if f.vfp[f.tv[b]] {
                    mov(vc, mach.R_D0, vr(f.tv[b]))
                    rk = vcode.RES_D0
                } else {
                    mov(vc, 0, vr(f.tv[b]))
                    rk = vcode.RES_X0
                }
            }
            let x = vcode.push(vc, mach.P_RETURN, -1, -1, -1)
            vc.imm[x] = rk
        } else {
            if k == ir.M_JUMP {
                let t = f.tt[b]
                var dsts: [i64] = []
                var srcs: [i64] = []
                for q in 0..f.tan[b] {
                    dsts.push(vr(f.bparams[f.bp0[t] + q]))
                    srcs.push(vr(f.targs[f.ta0[b] + q]))
                }
                par_moves(vc, dsts, srcs)
            } else if k == ir.M_BRIF and (f.tan[b] > 0 or f.fan[b] > 0) {
                fail("a conditional branch passes arguments: its edges were not split")
            }
            try expand(vc, f, s, rs[s.term_rule[b]], ccm, fccm, -1, s.inner[b], f.tt[b], f.tf[b], f.tv[b])
        }
        vc.bni.push(vc.mop.len() - vc.bi0[b])
    }
    vc
}
