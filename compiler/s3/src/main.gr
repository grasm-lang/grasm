// `s3`: the self-hosted backend's driver (docs/self-hosting.md, stage S3).
//
//     s3 <program.tir> -o <out.o> [--ra=backtrack|linear] [--max-regs N] [--listing <file>] [--ra-corrupt[=any|fp|class]] [--runtime] [--inline=N]
//     s3 --check-rules        the lowering rules' own checks
//
// `--runtime` compiles the runtime written in Grasm (docs/self-hosting.md
// §6.7) rather than a program: every function its `export fn`s reach and no
// C entry point -- it has no `main` -- and its calls to C are the runtime's
// own, so they are not reported to `grasm_foreign_call` as a program's are
// (a replay refuses a program's C calls, never the runtime's). Its dialect
// ([T-RUNTIME], §5.6) is lowered here too: each process cell a zeroed
// symbol of `__bss`, each literal `mem_static` names in `__cstring`, its own
// `thread_local` cells Mach-O thread-local variables, and the context
// switch and the variables' getters leaves this driver writes into the
// object (`compiler/aarch64/src/leaves.gr`).
// `--inline=N` inlines callees of at most N MIR instructions and terminators
// into their callers, 0 none (`compiler/mir/src/inline.gr`; the default is
// `INLINE_LIMIT`).
// `--ra=linear` allocates registers by linear scan, the fast allocator, in
// place of the release one (`--ra=backtrack`, the default; docs/self-hosting.md
// §4).
// `--stats` prints how many functions were compiled and checked, how many
// spill slots they needed, and how many hold doubles. `--max-regs N` lets the
// allocator hand out only N registers of each class, so values spill (the
// stress mode of `scripts/ra_check.sh`); `--ra-corrupt` plants an allocation
// error in every function where one can be planted, and reports how many the
// checker caught (its control): of either class (`any`, the default), among
// doubles only (`fp`), or a double given a general register (`class`).
// `--no-rule-check` skips the
// rule table's checks before compiling, and exists for one control only: it
// lets `scripts/s3controls.sh` show that a broken condition code is caught
// by the programs' output as well as by the checks.
//     s3 --forms              every instruction form compiled code can hold
//     s3 --encode-test <p>    writes <p>.s and <p>.tsv for scripts/encodetest.sh
//
// `--target x86_64` (docs/self-hosting.md §6.16, stage S7) compiles for
// x86-64 macOS (`compiler/x86_64`) instead of arm64, the object an x86-64
// Mach-O one, and asks the same questions of that target -- `--check-rules`,
// `--forms`, and its encoder's cases for scripts/encodetest_x64.sh. Every
// other option means what it does for arm64. `--target aarch64` is the
// default.
//
// TIR from the Rust frontend (`grasm tir`) goes to MIR (`compiler/mir`), to
// AArch64 code through the lowering rules, a register allocator and its
// checker (`compiler/aarch64`), and into a relocatable Mach-O object
// (`compiler/macho`). The object links with the system linker and the
// existing runtime:
//
//     cc out.o libgrasm_rt_abi.a -o program -Wl,-dead_strip
//
// It writes machine code itself; no C or assembly text is on that path.
//
// The object carries a DWARF line table (`compiler/macho/src/dwarf.gr`):
// every instruction maps to the line of the TIR expression it was lowered
// from, read from the source files TIR names. A file that cannot be read
// maps to line 0, with a warning. The compile unit's directory is `$PWD`.
//
// Exit status: 0 written; 2 bad usage or unreadable input; 3 the program is
// outside the subset this part compiles (every reason is printed); 4 the
// allocation checker found an error; 1 anything else.
import mir
import mir.ir
import aarch64
import x86_64
import macho

/// The largest callee inlined, in MIR instructions and terminators
/// (`compiler/mir/src/inline.gr`); `--inline=N` sets another, 0 none.
let INLINE_LIMIT = 32

fn usage() {
    eprint("usage: s3 <program.tir> -o <out.o> [--ra=backtrack|linear] [--max-regs N] [--listing <file>] [--ra-corrupt[=any|fp|class]] [--no-rule-check] [--stats] [--runtime] [--inline=N]")
    eprint("       s3 --check-rules | --forms | --encode-test <prefix>   [--target x86_64]")
    exit(2)
}

fn check_rules() -> i64 {
    let problems = aarch64.check_rules()
    for p in problems {
        print(p)
    }
    if problems.len() > 0 {
        print("rule table: {problems.len()} problem(s)")
        return 1
    }
    let rs = aarch64.rule_table()
    print("rule table: {rs.len()} rules, no problems")
    0
}

fn check_rules_x64() -> i64 {
    let problems = x86_64.check_rules()
    for p in problems {
        print(p)
    }
    if problems.len() > 0 {
        print("rule table: {problems.len()} problem(s)")
        return 1
    }
    let rs = x86_64.rule_table()
    print("rule table: {rs.len()} rules, no problems")
    0
}

fn forms() -> i64 {
    for f in aarch64.emittable_forms() {
        print(f)
    }
    0
}

/// Every form compiled code for the x86-64 target can hold
/// (`compiler/x86_64`).
fn forms_x64() -> i64 {
    for f in x86_64.emittable_forms() {
        print(f)
    }
    0
}

/// The x86-64 encoder's cases: `<prefix>.s` for the assembler, and
/// `<prefix>.tsv` with each case's form, bytes, assembly, and the offset and
/// type of the relocation it must carry (-1 for none).
fn encode_test_x64(prefix: str) -> i64 {
    match x86_64.encode_cases() {
        Ok(c) -> {
            var s = str_builder()
            s.push_str("\t.text\n")
            var t = str_builder()
            for k in 0..c.asm.len() {
                s.push_str("\t" + c.asm[k] + "\n")
                t.push_str(c.form[k] + "\t" + c.hex[k] + "\t" + c.asm[k] + "\t{c.rel_off[k]}\t{c.rel_kind[k]}\n")
            }
            match write_file(prefix + ".s", s.to_str()) {
                Ok(_) -> ()
                Err(e) -> {
                    eprint("s3: cannot write {prefix}.s: {e}")
                    return 2
                }
            }
            match write_file(prefix + ".tsv", t.to_str()) {
                Ok(_) -> ()
                Err(e) -> {
                    eprint("s3: cannot write {prefix}.tsv: {e}")
                    return 2
                }
            }
            print("encode cases: {c.asm.len()}")
            0
        }
        Err(msg) -> {
            eprint("s3: the x86-64 encoder refused one of its own test cases: {msg}")
            1
        }
    }
}

fn hex8(w: i64) -> str {
    w.to_base(16).pad_start(8, "0")
}

fn encode_test(prefix: str) -> i64 {
    match aarch64.encode_cases() {
        Ok(c) -> {
            var s = str_builder()
            s.push_str("\t.text\n\t.p2align 2\n")
            var t = str_builder()
            for k in 0..c.asm.len() {
                s.push_str("\t" + c.asm[k] + "\n")
                t.push_str(c.form[k] + "\t" + hex8(c.word[k]) + "\t" + c.asm[k] + "\n")
            }
            match write_file(prefix + ".s", s.to_str()) {
                Ok(_) -> ()
                Err(e) -> {
                    eprint("s3: cannot write {prefix}.s: {e}")
                    return 2
                }
            }
            match write_file(prefix + ".tsv", t.to_str()) {
                Ok(_) -> ()
                Err(e) -> {
                    eprint("s3: cannot write {prefix}.tsv: {e}")
                    return 2
                }
            }
            print("encode cases: {c.asm.len()}")
            0
        }
        Err(msg) -> {
            eprint("s3: the encoder refused one of its own test cases: {msg}")
            1
        }
    }
}

fn put64(inout b: ByteBuilder, v: i64) {
    for k in 0..8 {
        b.push_byte(v.ushr(8 * k).bit_and(255))
    }
}

/// Each source file's line starts, and its length (-1 if it cannot be read).
type SrcLines = {
    starts: [[i64]],
    len: [i64],
}

fn src_lines(p: MirProg) -> SrcLines {
    var out = SrcLines{ starts: [], len: [] }
    for path in p.files {
        match read_bytes(path) {
            Ok(b) -> {
                var ls: [i64] = [0]
                for i in 0..b.len() {
                    if b.at(i) == 10 {
                        ls.push(i + 1)
                    }
                }
                out.starts.push(ls)
                out.len.push(b.len())
            }
            Err(e) -> {
                eprint("s3: cannot read {path} for the line table ({e}); its code maps to line 0")
                out.starts.push([])
                out.len.push(-1)
            }
        }
    }
    out
}

/// The file (from 1) and line of global source offset `o`: line 0 when no
/// file holds it or the file could not be read.
fn file_line(p: MirProg, sl: SrcLines, o: i64) -> (i64, i64) {
    if o < 0 {
        return (1, 0)
    }
    var k = p.fbase.len() - 1
    while k >= 0 and p.fbase[k] > o {
        k -= 1
    }
    if k < 0 {
        return (1, 0)
    }
    let local = o - p.fbase[k]
    if sl.len[k] < 0 or local > sl.len[k] {
        return (k + 1, 0)
    }
    let ls = sl.starts[k]
    var lo = 0
    var hi = ls.len() - 1
    while lo < hi {
        let mid = (lo + hi + 1) / 2
        if ls[mid] <= local {
            lo = mid
        } else {
            hi = mid - 1
        }
    }
    (k + 1, lo + 1)
}

/// The C library's name for C function `name` on the target: on x86-64 the
/// runtime's `opendir` and `readdir` are the 64-bit-inode ones, which the
/// library names `$INODE64` there (docs/self-hosting.md §6.16); a program's
/// keep their plain names, as the Cranelift build's do.
fn c_name(name: str, x64: bool, lib: bool) -> str {
    if x64 and lib and (name == "opendir" or name == "readdir") {
        name + "$INODE64"
    } else {
        name
    }
}

fn reloc_symbol_for(p: MirProg, symk: i64, id: i64, x64: bool, lib: bool) -> str {
    if symk == 2 or symk == 5 {
        "_" + c_name(p.rt_syms[id], x64, lib)
    } else {
        reloc_symbol(p, symk, id)
    }
}

fn reloc_symbol(p: MirProg, symk: i64, id: i64) -> str {
    if symk == 1 {
        p.callee_sym[id]
    } else if symk == 2 or symk == 5 {
        "_" + p.rt_syms[id]
    } else if symk == 4 {
        "l_.desc.{id}"
    } else if symk == 6 {
        ir.cell_sym(p.pcells[id])
    } else {
        "l_.str.{id}"
    }
}

/// The runtime dialect's leaves the runtime's calls reach ([T-RUNTIME]),
/// each once, appended to the object as local functions; their code maps
/// to no source line.
fn add_leaves(p: MirProg, inout obj: MoObj, inout unit: DwUnit, listing: bool, inout text: StrBuilder) -> () ! str {
    var done: Map[str, bool] = {}
    for name in p.rt_syms {
        for lf in try aarch64.leaves_for(name, p.tcells) {
            if done.has(lf.sym) {
                continue
            }
            done.set(lf.sym, true)
            let base = 4 * obj.text.len()
            let fk = obj.fsym.len()
            unit.row_fn.push(fk)
            unit.row_off.push(0)
            unit.row_file.push(1)
            unit.row_line.push(0)
            unit.fn_name.push(lf.sym)
            unit.fn_file.push(0)
            unit.fn_line.push(0)
            obj.fsym.push(lf.sym)
            obj.foff.push(base)
            obj.fext.push(false)
            for w in lf.words {
                obj.text.push(w)
            }
            for k in 0..lf.rel_off.len() {
                obj.rel_off.push(base + lf.rel_off[k])
                obj.rel_kind.push(lf.rel_kind[k])
                obj.rel_sym.push(lf.rel_name[k])
            }
            if listing {
                text.push_str("{lf.sym}:   ; a leaf of the runtime dialect\n")
                for line in lf.asm {
                    text.push_str("    " + line + "\n")
                }
            }
        }
    }
    ()
}

/// The x86-64 leaves, as `add_leaves` adds AArch64's.
fn add_leaves_x64(p: MirProg, inout obj: MoObj, inout unit: DwUnit, listing: bool, inout text: StrBuilder) -> () ! str {
    var done: Map[str, bool] = {}
    for name in p.rt_syms {
        for lf in try x86_64.leaves_for(name, p.tcells) {
            if done.has(lf.sym) {
                continue
            }
            done.set(lf.sym, true)
            pad16(obj)
            let base = obj.code.len()
            let fk = obj.fsym.len()
            unit.row_fn.push(fk)
            unit.row_off.push(0)
            unit.row_file.push(1)
            unit.row_line.push(0)
            unit.fn_name.push(lf.sym)
            unit.fn_file.push(0)
            unit.fn_line.push(0)
            obj.fsym.push(lf.sym)
            obj.foff.push(base)
            obj.fext.push(false)
            for x in lf.bytes {
                obj.code.push(x)
            }
            for k in 0..lf.rel_off.len() {
                obj.rel_off.push(base + lf.rel_off[k])
                obj.rel_kind.push(lf.rel_kind[k])
                obj.rel_sym.push(lf.rel_name[k])
            }
            if listing {
                text.push_str("{lf.sym}:   ; a leaf of the runtime dialect\n")
                for line in lf.asm {
                    text.push_str("    " + line + "\n")
                }
            }
        }
    }
    ()
}

/// Pads x86-64 code to a multiple of 16 with `int3`, which nothing runs: each
/// function starts there, as clang places them.
fn pad16(inout obj: MoObj) {
    while obj.code.len() % 16 != 0 {
        obj.code.push(204)
    }
    ()
}

/// Compiles every function of `p` for x86-64 into `obj`. Answers an exit
/// status, or -1 to go on; `counts` gets functions failing the checker,
/// corrupted, caught, spill slots, frameless and late frames.
fn codegen_x64(p: MirProg, lib: bool, xo: X64Opts, inout obj: MoObj, inout unit: DwUnit, listing: str, inout text: StrBuilder, sl: SrcLines, inout counts: [i64]) -> i64 {
    let rs = x86_64.rule_table()
    let ccm = x86_64.cond_map()
    let fccm = x86_64.fcond_map()
    for f in p.fns {
        match x86_64.compile_fn(f, rs, ccm, fccm, xo, p.rt_syms) {
            Ok(r) -> {
                if r.corrupted > 0 {
                    counts[1] += 1
                    if r.ra_errors.len() > 0 {
                        counts[2] += 1
                    }
                }
                if r.ra_errors.len() > 0 {
                    counts[0] += 1
                    if xo.corrupt == 0 {
                        eprint("s3: register allocation check failed in {f.sym} ({f.name}):")
                        var shown = 0
                        for m in r.ra_errors {
                            if shown < 8 {
                                eprint("  {m}")
                            }
                            shown += 1
                        }
                    }
                }
                counts[3] += r.code.nspill
                if r.code.frame_at < 0 {
                    counts[4] += 1
                } else if r.code.frame_at > 0 {
                    counts[5] += 1
                }
                pad16(obj)
                let base = obj.code.len()
                let fk = obj.fsym.len()
                for q in 0..r.code.row_byte.len() {
                    let fl = file_line(p, sl, r.code.row_src[q])
                    unit.row_fn.push(fk)
                    unit.row_off.push(r.code.row_byte[q])
                    unit.row_file.push(fl.0)
                    unit.row_line.push(fl.1)
                }
                let decl = file_line(p, sl, f.span0)
                unit.fn_name.push(f.name)
                unit.fn_file.push(decl.0)
                unit.fn_line.push(decl.1)
                obj.fsym.push(f.sym)
                obj.foff.push(base)
                obj.fext.push(f.sym == "_main" or f.global)
                for x in r.code.bytes {
                    obj.code.push(x)
                }
                for k in 0..r.code.rel_off.len() {
                    obj.rel_off.push(base + r.code.rel_off[k])
                    obj.rel_kind.push(r.code.rel_kind[k])
                    obj.rel_sym.push(reloc_symbol_for(p, r.code.rel_symk[k], r.code.rel_sym[k], true, lib))
                }
                if listing != "" {
                    text.push_str(r.vcode_text)
                    text.push_str("{f.sym}:   ; frame {r.code.frame}, spills {r.code.nspill}, saved {r.code.nsaved}\n")
                    for line in r.code.asm {
                        if line.ends_with(":") {
                            text.push_str(line + "\n")
                        } else {
                            text.push_str("    " + line + "\n")
                        }
                    }
                }
            }
            Err(msg) -> {
                eprint("s3: {f.sym} ({f.name}): {msg}")
                return 1
            }
        }
    }
    -1
}

/// Compiles a TIR file into an object file. Answers the exit status.
fn compile(inp: str, out: str, opts: A64Opts, listing: str, check: bool, stats: bool, lib: bool, inline_limit: i64, x64: bool) -> i64 {
    let src = match read_bytes(inp) {
        Ok(b) -> b
        Err(e) -> {
            eprint("s3: cannot read {inp}: {e}")
            return 2
        }
    }
    let (st, _object) = compile_tir(src, out, opts, listing, check, stats, lib, inline_limit, x64)
    st
}

/// What `s3 <program.tir> -o <out.o>` makes of a program's TIR and nothing
/// else -- the options a stage's build gives it (docs/self-hosting.md §6.14):
/// for `grasm build --native` (compiler/grasm, §6.17). The exit status, and
/// the object when it is 0.
pub fn compile_program(src: bytes, lib: bool, x64: bool) -> (i64, bytes) {
    compile_tir(src, "", aarch64.default_opts(), "", true, false, lib, INLINE_LIMIT, x64)
}

fn no_object() -> bytes {
    bytes_filled(0, 0)
}

/// Compiles TIR into an object: the exit status, and the object's bytes when
/// it is 0, also written to `out` unless that is "".
fn compile_tir(src: bytes, out: str, opts: A64Opts, listing: str, check: bool, stats: bool, lib: bool, inline_limit: i64, x64: bool) -> (i64, bytes) {
    let p = match mir.build(src, lib, inline_limit) {
        Ok(x) -> x
        Err(msg) -> {
            eprint(msg)
            if msg.contains("outside the subset") {
                return (3, no_object())
            }
            return (1, no_object())
        }
    }
    if check {
        let problems = if x64 { x86_64.check_rules() } else { aarch64.check_rules() }
        if problems.len() > 0 {
            for q in problems {
                eprint("s3: rule table: {q}")
            }
            return (1, no_object())
        }
    }
    let rs = aarch64.rule_table()
    let ccm = aarch64.cond_map()
    let fccm = aarch64.fcond_map()
    var obj = macho.new_obj()
    var text = str_builder()
    if listing != "" {
        text.push_str(mir.print_prog(p))
    }
    var ra_failed = 0
    var corrupted = 0
    var caught = 0
    var spills = 0
    var frameless = 0
    var late_frame = 0
    // The line table's rows, function by function: the byte offset in the
    // function, and the source offset of the code from there on.
    var unit = macho.new_unit()
    let sl = src_lines(p)
    var xcounts = [0, 0, 0, 0, 0, 0]
    if x64 {
        obj.x64 = true
        var xo = x86_64.default_opts()
        xo.max_regs = opts.max_regs
        xo.corrupt = opts.corrupt
        xo.want_asm = opts.want_asm
        xo.ra = opts.ra
        let st = codegen_x64(p, lib, xo, obj, unit, listing, text, sl, xcounts)
        if st >= 0 {
            return (st, no_object())
        }
        ra_failed = xcounts[0]
        corrupted = xcounts[1]
        caught = xcounts[2]
        spills = xcounts[3]
        frameless = xcounts[4]
        late_frame = xcounts[5]
    }
    for f in p.fns {
        if x64 {
            break
        }
        match aarch64.compile_fn(f, rs, ccm, fccm, opts, p.callee_sym, p.rt_syms) {
            Ok(r) -> {
                if r.corrupted > 0 {
                    corrupted += 1
                    if r.ra_errors.len() > 0 {
                        caught += 1
                    }
                }
                if r.ra_errors.len() > 0 {
                    ra_failed += 1
                    if opts.corrupt == 0 {
                        eprint("s3: register allocation check failed in {f.sym} ({f.name}):")
                        var shown = 0
                        for m in r.ra_errors {
                            if shown < 8 {
                                eprint("  {m}")
                            }
                            shown += 1
                        }
                    }
                }
                spills += r.code.nspill
                if r.code.frame_at < 0 {
                    frameless += 1
                } else if r.code.frame_at > 0 {
                    late_frame += 1
                }
                let base = 4 * obj.text.len()
                let fk = obj.fsym.len()
                for q in 0..r.code.row_word.len() {
                    let fl = file_line(p, sl, r.code.row_src[q])
                    unit.row_fn.push(fk)
                    unit.row_off.push(4 * r.code.row_word[q])
                    unit.row_file.push(fl.0)
                    unit.row_line.push(fl.1)
                }
                let decl = file_line(p, sl, f.span0)
                unit.fn_name.push(f.name)
                unit.fn_file.push(decl.0)
                unit.fn_line.push(decl.1)
                obj.fsym.push(f.sym)
                obj.foff.push(base)
                // The C entry and every `export fn`'s are global symbols.
                obj.fext.push(f.sym == "_main" or f.global)
                for w in r.code.words {
                    obj.text.push(w)
                }
                for k in 0..r.code.rel_off.len() {
                    obj.rel_off.push(base + r.code.rel_off[k])
                    obj.rel_kind.push(r.code.rel_kind[k])
                    obj.rel_sym.push(reloc_symbol(p, r.code.rel_symk[k], r.code.rel_sym[k]))
                }
                if listing != "" {
                    text.push_str(r.vcode_text)
                    text.push_str("{f.sym}:   ; frame {r.code.frame}, spills {r.code.nspill}, saved {r.code.nsaved}\n")
                    for line in r.code.asm {
                        if line.ends_with(":") {
                            text.push_str(line + "\n")
                        } else {
                            text.push_str("    " + line + "\n")
                        }
                    }
                }
            }
            Err(msg) -> {
                eprint("s3: {f.sym} ({f.name}): {msg}")
                return (1, no_object())
            }
        }
    }
    if opts.corrupt != 0 {
        print("ra-corrupt: corrupted {corrupted} of {p.fns.len()} functions, the checker caught {caught}")
        return (if caught > 0 { 4 } else { 0 }, no_object())
    }
    if ra_failed > 0 {
        return (4, no_object())
    }
    match if x64 { add_leaves_x64(p, obj, unit, listing != "", text) } else { add_leaves(p, obj, unit, listing != "", text) } {
        Ok(_) -> ()
        Err(msg) -> {
            eprint("s3: a leaf of the runtime dialect: {msg}")
            return (1, no_object())
        }
    }
    // The runtime's process cells and its own thread-local variables.
    for k in 0..p.pcells.len() {
        obj.zsym.push(ir.cell_sym(p.pcells[k]))
        obj.zsize.push(p.psize[k])
    }
    for k in 0..p.tcells.len() {
        obj.tsym.push(ir.tlv_var_sym(p.tcells[k]))
        obj.tsize.push(p.tsize[k])
    }
    unit.producer = "grasm compiler/s3"
    unit.name = if p.files.len() > 0 { p.files[0] } else { "" }
    unit.comp_dir = env("PWD") ?? ""
    unit.files = p.files
    obj.debug = true
    obj.dw = unit
    for k in 0..p.strs.len() {
        obj.dsym.push("l_.str.{k}")
        obj.dbytes.push(p.strs[k].to_bytes())
    }
    // Struct descriptors, laid out as the runtime's `StructDesc`: a cache word
    // the runtime fills in, the type's name, the field count, then each
    // field's name and kind, then a zero auxiliary word per field.
    var doff = 0
    for k in 0..p.descs.len() {
        let d = p.descs[k]
        let n = d.fields.len()
        var b = byte_builder()
        put64(b, 0)
        put64(b, 0)
        put64(b, d.name.to_bytes().len())
        put64(b, n)
        obj.wrel_off.push(doff + 8)
        obj.wrel_sym.push("l_.str.{d.name_str}")
        for i in 0..n {
            obj.wrel_off.push(doff + 32 + 24 * i)
            obj.wrel_sym.push("l_.str.{d.field_strs[i]}")
            put64(b, 0)
            put64(b, d.fields[i].to_bytes().len())
            put64(b, d.kinds[i])
        }
        for i in 0..n {
            put64(b, 0)
        }
        obj.wsym.push("l_.desc.{k}")
        obj.wbytes.push(b.to_bytes())
        doff += 32 + 32 * n
    }
    let bytes = match macho.write(obj) {
        Ok(b) -> b
        Err(msg) -> {
            eprint("s3: writing the object: {msg}")
            return (1, no_object())
        }
    }
    if out != "" {
        match write_bytes(out, bytes) {
            Ok(_) -> ()
            Err(e) -> {
                eprint("s3: cannot write {out}: {e}")
                return (2, no_object())
            }
        }
    }
    if stats {
        var with_fp = 0
        for f in p.fns {
            var any = false
            for x in f.vfp {
                if x {
                    any = true
                }
            }
            if any {
                with_fp += 1
            }
        }
        if x64 {
            print("functions: {p.fns.len()}   checked: {p.fns.len() - ra_failed}   spill slots: {spills}   bytes: {obj.code.len()}   with doubles: {with_fp}")
        } else {
            print("functions: {p.fns.len()}   checked: {p.fns.len() - ra_failed}   spill slots: {spills}   words: {obj.text.len()}   with doubles: {with_fp}")
        }
        // The mid-end's counts on a line of their own: gates read the first
        // line by position (`scripts/ra_check.sh`).
        print("mid-end: folded: {p.folded}   inlined: {p.inlined} calls of {p.inlinees} functions, {p.dropped} no longer called, {p.direct} closures called directly, {p.rcpairs} count pairs cancelled   frameless: {frameless}   frame past the entry: {late_frame}")
    }
    if listing != "" {
        match write_file(listing, text.to_str()) {
            Ok(_) -> ()
            Err(e) -> {
                eprint("s3: cannot write {listing}: {e}")
                return (2, no_object())
            }
        }
    }
    (0, bytes)
}

fn main() {
    let a = args()
    if a.len() == 1 and a[0] == "--check-rules" {
        exit(check_rules())
    }
    if a.len() == 3 and a[0] == "--check-rules" and a[1] == "--target" and a[2] == "x86_64" {
        exit(check_rules_x64())
    }
    if a.len() == 1 and a[0] == "--forms" {
        exit(forms())
    }
    if a.len() == 2 and a[0] == "--encode-test" {
        exit(encode_test(a[1]))
    }
    if a.len() == 3 and a[0] == "--forms" and a[1] == "--target" {
        if a[2] == "x86_64" {
            exit(forms_x64())
        }
        if a[2] == "aarch64" {
            exit(forms())
        }
        usage()
        return
    }
    if a.len() == 4 and a[0] == "--encode-test" and a[2] == "--target" {
        if a[3] == "x86_64" {
            exit(encode_test_x64(a[1]))
        }
        if a[3] == "aarch64" {
            exit(encode_test(a[1]))
        }
        usage()
        return
    }
    var inp = ""
    var out = ""
    var listing = ""
    var opts = aarch64.default_opts()
    var check = true
    var stats = false
    var lib = false
    var inline_limit = INLINE_LIMIT
    var x64 = false
    var i = 0
    while i < a.len() {
        let x = a[i]
        if x == "-o" and i + 1 < a.len() {
            out = a[i + 1]
            i += 2
        } else if x == "--listing" and i + 1 < a.len() {
            listing = a[i + 1]
            opts.want_asm = true
            i += 2
        } else if x == "--max-regs" and i + 1 < a.len() {
            opts.max_regs = a[i + 1].parse_int() ?? -1
            i += 2
        } else if x == "--ra-corrupt" {
            opts.corrupt = aarch64.plant_kind("any")
            i += 1
        } else if x.starts_with("--ra-corrupt=") {
            opts.corrupt = aarch64.plant_kind(x.substr(13, x.len() - 13))
            if opts.corrupt < 0 {
                usage()
                return
            }
            i += 1
        } else if x == "--ra=linear" {
            opts.ra = aarch64.RA_LINEAR
            i += 1
        } else if x == "--ra=backtrack" {
            opts.ra = aarch64.RA_BACKTRACK
            i += 1
        } else if x == "--no-rule-check" {
            check = false
            i += 1
        } else if x == "--stats" {
            stats = true
            i += 1
        } else if x == "--runtime" {
            lib = true
            i += 1
        } else if x == "--target" and i + 1 < a.len() {
            if a[i + 1] == "x86_64" {
                x64 = true
            } else if a[i + 1] != "aarch64" {
                usage()
                return
            }
            i += 2
        } else if x.starts_with("--inline=") {
            inline_limit = x.substr(9, x.len() - 9).parse_int() ?? -1
            if inline_limit < 0 {
                usage()
                return
            }
            i += 1
        } else if x.starts_with("-") or inp != "" {
            usage()
            return
        } else {
            inp = x
            i += 1
        }
    }
    if inp == "" or (out == "" and opts.corrupt == 0) {
        usage()
        return
    }
    exit(compile(inp, out, opts, listing, check, stats, lib, inline_limit, x64))
}
