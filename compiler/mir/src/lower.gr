// TIR to the variable form: three-address code over variables, in basic
// blocks, before SSA.
//
// Every TIR local is a variable, and so is every intermediate result: an
// expression's value is the variable it was computed into. That makes the
// lowering a plain walk with no bookkeeping about which value is live across
// which branch -- `ssa.gr` works that out afterwards, from liveness, and
// turns each variable into the SSA values and block parameters it needs.
//
// This is also where the subset is decided. A construct this part does not
// compile is refused here, by name and span, rather than compiled wrongly;
// `scripts/s3subset.sh` holds the refusals to an independent statement of
// the subset (`scripts/s3_subset.py`), so a refusal cannot quietly shrink
// what is checked.
import sexp
import ir
import prog
import mono

/// A function in the variable form, and the state of building it.
type Vir = {
    nvars: i64,
    vty: [i64],
    /// Variables `0 .. nparams` are the parameters, the floor first.
    nparams: i64,
    // Blocks: where their instructions start and end, and their terminators.
    bstart: [i64],
    bend: [i64],
    btk: [i64],
    btv: [i64],
    btt: [i64],
    btf: [i64],
    // Instructions: `dst = op(a, b)`, with `imm`, or a call's arguments in
    // `cargs[ca0 .. ca0 + can]`.
    op: [i64],
    dst: [i64],
    a: [i64],
    b: [i64],
    imm: [i64],
    ca0: [i64],
    can: [i64],
    cargs: [i64],
    // Building state.
    cur: i64,
    open: bool,
    loop_cont: [i64],
    loop_brk: [i64],
    tvar: Map[i64, i64],
    io_val: [i64],
    io_addr: [i64],
    nslots: i64,
    slot_var: [i64],
    floor: i64,
    returns: bool,
    strs: [str],
    str_ix: Map[str, i64],
    /// Runtime functions named here, past the fixed ones: a `M_CALLRT` with
    /// `imm = RT_COUNT + k` calls `rts[k]` (the driver pools them).
    rts: [str],
    rt_ix: Map[str, i64],
    // Ownership, while building (see "Reference counting" below).
    /// Variables owning a reference, the innermost scope's last.
    owned: [i64],
    /// Where each open scope's variables begin in `owned`.
    scope_mark: [i64],
    /// Owned temporaries: values computed and not yet handed on.
    temps: [i64],
    /// Per enclosing loop, how much of `owned` and `temps` was there when
    /// its body began: what `break` and `continue` leave behind them.
    loop_owned: [i64],
    loop_temps: [i64],
    /// Struct descriptors this function names (`M_DATAADDR`), each once.
    descs: [MirDesc],
    desc_ix: Map[str, i64],
    /// The frame slots words are handed to the runtime in (`argv_slots`).
    argv_base: i64,
    argv_n: i64,
    /// Each TIR variable's type element.
    tvty: Map[i64, i64],
    // A function that can fail (`T ! E`).
    /// The variable holding the hidden last argument of a function returning
    /// by the split-result convention, where its payload goes; -1 if not.
    split_out: i64,
    /// A fallible function that returns its whole result as a box instead
    /// (one named `main`, as in the Cranelift build).
    boxed_result: bool,
    /// The type element of the `T` it answers.
    ok_te: i64,
    // Functions this one makes values of (`M_FNADDR`'s `imm` indexes these
    // until the driver gives each its callable id): a closure lifted out of
    // the body (`LIFT_CLOSURE`, its TIR element and the variables it
    // captures, with their types), or the wrapper a named function is called
    // through as a value (`LIFT_WRAPPER`, the callable).
    lift_kind: [i64],
    lift_elem: [i64],
    lift_caps: [[i64]],
    lift_capte: [[i64]],
    /// The kind of what the function answers, when it answers a value
    /// directly: what a placeholder for a missing one is made as.
    ret_kind: i64,
    /// Effect handlers this function has installed and not yet popped
    /// (`with`), and how many there were when each enclosing loop's body
    /// began: what a `return` or a `break` leaves pops.
    handlers: i64,
    loop_handlers: [i64],
    /// Per enclosing `parallel` block, innermost last: the variable holding
    /// the list of the `spawn` sites that fired, and those sites' elements.
    par_list: [i64],
    par_sites: [[i64]],
    /// Per enclosing `concurrent` block: the variable holding its tasks.
    go_list: [i64],
    /// Whether each enclosing `parallel` block, innermost last, is a
    /// `concurrent` one: what a `spawn` belongs to.
    par_conc: [bool],
    errors: [str],
    // Where the code comes from, for the line table: the span start (a
    // global TIR offset) of the expression being lowered, recorded on every
    // instruction emitted and every block's terminator; -1 where no source
    // line stands for the code. `fn_span` is the function's own.
    cur_span: i64,
    span: [i64],
    bspan: [i64],
    fn_span: i64,
}

pub let LIFT_CLOSURE = 0
pub let LIFT_WRAPPER = 1
/// A worker the runtime's parallel maps call (`lower_worker`); its element
/// is `worker_code`.
pub let LIFT_WORKER = 2
/// A C function used as a value: the wrapper the closure convention calls
/// (`lower_extern_wrapper`); its element is the `extern` declaration.
pub let LIFT_EXTERN = 3
/// A Grasm function's C entry ([T-FN-ADDR], [T-EXPORT]): what its address
/// is and what C calls (`lower_centry`); its element is the callable.
pub let LIFT_CENTRY = 4

pub fn new_vir() -> Vir {
    Vir{
        nvars: 0, vty: [], nparams: 0,
        bstart: [], bend: [], btk: [], btv: [], btt: [], btf: [],
        op: [], dst: [], a: [], b: [], imm: [], ca0: [], can: [], cargs: [],
        cur: -1, open: false, loop_cont: [], loop_brk: [], tvar: {},
        io_val: [], io_addr: [], nslots: 0, slot_var: [], floor: -1, returns: false,
        strs: [], str_ix: {}, rts: [], rt_ix: {},
        owned: [], scope_mark: [], temps: [], loop_owned: [], loop_temps: [],
        descs: [], desc_ix: {}, argv_base: -1, argv_n: 0, tvty: {},
        split_out: -1, boxed_result: false, ok_te: -1,
        lift_kind: [], lift_elem: [], lift_caps: [], lift_capte: [], ret_kind: ir.TY_I64,
        handlers: 0, loop_handlers: [], par_list: [], par_sites: [], go_list: [], par_conc: [],
        errors: [], cur_span: -1, span: [], bspan: [], fn_span: -1,
    }
}

// ----- building ------------------------------------------------------------------

fn bad(inout v: Vir, msg: str) {
    v.errors.push(msg)
}

fn new_var(inout v: Vir, ty: i64) -> i64 {
    let id = v.nvars
    v.nvars += 1
    v.vty.push(ty)
    id
}

fn new_block(inout v: Vir) -> i64 {
    let id = v.bstart.len()
    v.bstart.push(-1)
    v.bend.push(-1)
    v.btk.push(-1)
    v.btv.push(-1)
    v.btt.push(-1)
    v.btf.push(-1)
    v.bspan.push(-1)
    id
}

/// Makes `b` the block being filled. A block still open is closed with a
/// jump to it, so falling into a block is always explicit.
fn switch_to(inout v: Vir, b: i64) {
    if v.open {
        term_jump(v, b)
    }
    v.cur = b
    v.bstart[b] = v.op.len()
    v.open = true
}

/// Code after a `return`, `break` or a call that does not return still has
/// to go somewhere: a fresh block nothing branches to, which SSA
/// construction drops.
fn ensure_open(inout v: Vir) {
    if not v.open {
        let b = new_block(v)
        switch_to(v, b)
    }
}

fn emit(inout v: Vir, op: i64, dst: i64, a: i64, b: i64, imm: i64) -> i64 {
    ensure_open(v)
    let id = v.op.len()
    v.op.push(op)
    v.dst.push(dst)
    v.a.push(a)
    v.b.push(b)
    v.imm.push(imm)
    v.ca0.push(v.cargs.len())
    v.can.push(0)
    v.span.push(v.cur_span)
    id
}

fn finish(inout v: Vir, k: i64, val: i64, t: i64, f: i64) {
    ensure_open(v)
    let b = v.cur
    v.bend[b] = v.op.len()
    v.btk[b] = k
    v.btv[b] = val
    v.btt[b] = t
    v.btf[b] = f
    v.bspan[b] = v.cur_span
    v.open = false
}

fn term_jump(inout v: Vir, target: i64) {
    finish(v, ir.M_JUMP, -1, target, -1)
}

fn term_brif(inout v: Vir, c: i64, t: i64, f: i64) {
    finish(v, ir.M_BRIF, c, t, f)
}

fn term_trap(inout v: Vir) {
    finish(v, ir.M_TRAP, -1, -1, -1)
}

fn konst(inout v: Vir, k: i64) -> i64 {
    let d = new_var(v, ir.TY_I64)
    emit(v, ir.M_ICONST, d, -1, -1, k)
    d
}

fn copy_to(inout v: Vir, dst: i64, src: i64) {
    emit(v, ir.M_COPY, dst, src, -1, 0)
}

fn op1(inout v: Vir, op: i64, a: i64) -> i64 {
    let d = new_var(v, ir.TY_I64)
    emit(v, op, d, a, -1, 0)
    d
}

fn op2(inout v: Vir, op: i64, a: i64, b: i64) -> i64 {
    let d = new_var(v, ir.TY_I64)
    emit(v, op, d, a, b, 0)
    d
}

fn icmp(inout v: Vir, cc: i64, a: i64, b: i64) -> i64 {
    let d = new_var(v, ir.TY_BOOL)
    emit(v, ir.M_ICMP, d, a, b, cc)
    d
}

// ----- doubles -------------------------------------------------------------------
//
// An `f64` lives in a floating-point register: its variables are `TY_F64`,
// its operations the `M_F*` ones. Where the runtime takes or answers a
// double's *bits* in an integer register -- a scalar list's element, a
// struct's word, a split result's word, an interpolated piece -- the bits
// cross with `M_FBITS` and `M_FFROMBITS`, as the Cranelift build's `bitcast`.

/// The double whose bits are `bits`.
fn fkonst(inout v: Vir, bits: i64) -> i64 {
    let d = new_var(v, ir.TY_F64)
    emit(v, ir.M_FCONST, d, -1, -1, bits)
    d
}

fn fop1(inout v: Vir, op: i64, a: i64) -> i64 {
    let d = new_var(v, ir.TY_F64)
    emit(v, op, d, a, -1, 0)
    d
}

fn fop2(inout v: Vir, op: i64, a: i64, b: i64) -> i64 {
    let d = new_var(v, ir.TY_F64)
    emit(v, op, d, a, b, 0)
    d
}

fn fcmp(inout v: Vir, cc: i64, a: i64, b: i64) -> i64 {
    let d = new_var(v, ir.TY_BOOL)
    emit(v, ir.M_FCMP, d, a, b, cc)
    d
}

/// A double's bits, as an integer.
fn fbits(inout v: Vir, x: i64) -> i64 {
    let d = new_var(v, ir.TY_I64)
    emit(v, ir.M_FBITS, d, x, -1, 0)
    d
}

/// An integer's bits, as a double.
fn from_bits(inout v: Vir, x: i64) -> i64 {
    fop1(v, ir.M_FFROMBITS, x)
}

/// `x` as a word for the runtime: a double's bits, anything else itself.
fn word_of(inout v: Vir, x: i64) -> i64 {
    if x >= 0 and ir.ty_fp(v.vty[x]) {
        return fbits(v, x)
    }
    x
}

/// A runtime word read back as kind `k`: the bits of a double become one.
fn word_as(inout v: Vir, w: i64, k: i64) -> i64 {
    if ir.ty_fp(k) {
        return from_bits(v, w)
    }
    w
}

/// Stores `x` at address `addr`: a double from its register, anything else
/// as a word.
fn store_at(inout v: Vir, addr: i64, x: i64) {
    let op = if x >= 0 and ir.ty_fp(v.vty[x]) { ir.M_FSTORE } else { ir.M_STORE }
    emit(v, op, -1, addr, x, 0)
    ()
}

/// Loads a value of kind `k` from `addr` into `dst`.
fn load_into(inout v: Vir, dst: i64, addr: i64) {
    let op = if ir.ty_fp(v.vty[dst]) { ir.M_FLOAD } else { ir.M_LOAD }
    emit(v, op, dst, addr, -1, 0)
    ()
}

/// A placeholder of `x`'s class where no value arrives: an expression that
/// cannot finish, in code that never runs.
fn zero_like(inout v: Vir, ty: i64) -> i64 {
    if ir.ty_fp(ty) {
        fkonst(v, 0)
    } else {
        konst(v, 0)
    }
}

/// A call into the runtime. One that does not return ends the block.
fn callrt(inout v: Vir, sym: i64, args: [i64]) -> i64 {
    var d = -1
    if ir.rt_returns(sym) {
        d = new_var(v, ir.TY_I64)
    }
    let i = emit(v, ir.M_CALLRT, d, -1, -1, sym)
    v.ca0[i] = v.cargs.len()
    v.can[i] = args.len()
    for x in args {
        v.cargs.push(x)
    }
    if ir.rt_noreturn(sym) {
        term_trap(v)
    }
    d
}

// What a runtime function named by the program answers.
let R_VOID = 0
/// A word: an integer, an address, a handle.
let R_WORD = 1
/// A `bool` the C ABI answers in eight bits: the rest of the register is
/// unspecified (AAPCS64), so it is zero-extended before anything reads it.
let R_BOOL8 = 2
/// An owned boxed value, which becomes a temporary of this function.
let R_BOX = 3
/// Nothing: it panics or exits.
let R_NEVER = 4
/// A double, in d0.
let R_F64 = 5
/// An owned box the caller releases at once: what a built-in answering
/// `unit` hands back anyway (`sleep_millis`).
let R_DROP = 6

/// Which arguments of runtime function `name` are doubles (in d0..d7 by the
/// C convention, AAPCS64), as one letter each: `f` a double, `w` a word. ""
/// for a function that takes no double, which is every other one.
fn rt_fp_args(name: str) -> str {
    match name {
        "grasm_out_f64" -> "f"
        "grasm_box_f64" -> "f"
        "grasm_str_from_f64" -> "f"
        "grasm_f64_is_nan" -> "f"
        "grasm_f64_is_finite" -> "f"
        "grasm_f64_to_fixed" -> "fw"
        "grasm_pow_f64" -> "ff"
        "grasm_f64_rem" -> "ff"
        "grasm_f64_atan2" -> "ff"
        "grasm_f64_hypot" -> "ff"
        "grasm_f64_log" -> "ff"
        "grasm_f64_min" -> "ff"
        "grasm_f64_max" -> "ff"
        _ -> if name.starts_with("grasm_f64_") { "f" } else { "" }
    }
}

fn rt_id(inout v: Vir, name: str) -> i64 {
    match v.rt_ix.get(name) {
        Some(k) -> ir.RT_COUNT + k
        None -> {
            let k = v.rts.len()
            v.rts.push(name)
            v.rt_ix.set(name, k)
            ir.RT_COUNT + k
        }
    }
}

/// A call of runtime function `name`, the same symbol with the same
/// arguments as the Cranelift build calls for the same construct.
fn rt(inout v: Vir, name: str, args: [i64], ret: i64) -> i64 {
    // The classes the C function takes, held to what is passed: a double
    // handed to a function that reads a word (or the reverse) would be read
    // from the other register file.
    let sig = rt_fp_args(name)
    for k in 0..args.len() {
        let want = k < sig.len() and sig.substr(k, 1) == "f"
        let x = args[k]
        if x >= 0 and ir.ty_fp(v.vty[x]) != want {
            bad(v, "internal: argument {k} of `{name}` is of the wrong register class")
        }
    }
    var d = -1
    if ret == R_WORD or ret == R_BOOL8 or ret == R_BOX or ret == R_F64 {
        d = new_var(v, if ret == R_BOX { ir.TY_BOX } else if ret == R_F64 { ir.TY_F64 } else { ir.TY_I64 })
    }
    let i = emit(v, ir.M_CALLRT, d, -1, -1, rt_id(v, name))
    v.ca0[i] = v.cargs.len()
    v.can[i] = args.len()
    for x in args {
        v.cargs.push(x)
    }
    if ret == R_NEVER {
        term_trap(v)
        return -1
    }
    if ret == R_BOOL8 {
        return op1(v, ir.M_UEXT8, d)
    }
    if ret == R_BOX {
        own_temp(v, d)
    }
    d
}

// ----- reference counting ------------------------------------------------------
//
// The discipline, which the RC gate (`scripts/s3rc.sh`) holds every compiled
// program to -- nothing live at exit, nothing touched after its release:
//
//   * Every boxed value an expression computes is *owned*: the lowering of
//     the expression hands its caller one reference, which the caller must
//     pass on (to a variable, a container, a callee, the function's result)
//     or release. Until then it is a temporary, kept on `temps`, so a
//     `return`, `break` or `continue` part-way through an expression releases
//     it on the way out.
//   * A variable of a boxed type owns one reference while its scope is open:
//     reading it retains (`inc`) a copy for the reader; leaving the scope --
//     by falling off its end, by `break`/`continue` out of it, or by `return`
//     -- releases it (`dec`); assigning to it releases the old value after the
//     new one is computed.
//   * Parameters are owned by the callee, as the Cranelift build's are unless
//     it proves a parameter only read: the caller hands each argument over
//     and the callee releases it with its other variables. An `inout`
//     parameter's value goes back to the caller instead.
//   * A runtime function takes each argument as its contract says -- borrowed
//     or consumed -- and the lowering releases what was only borrowed.
//
// No `inc` or `dec` is elided yet: matching ownership first, Perceus-style
// removal of the pairs that cancel (docs/self-hosting.md §4) later, measured.

/// `x` is an owned temporary.
fn own_temp(inout v: Vir, x: i64) {
    v.temps.push(x)
}

/// `x`'s reference has been handed on: it is no longer this lowering's to
/// release. A value that is not a temporary is left be: an expression that
/// cannot finish (`panic`, `fail`, `return` inside it) answers a placeholder
/// in code that never runs.
fn forget_temp(inout v: Vir, x: i64) {
    var k = v.temps.len() - 1
    while k >= 0 {
        if v.temps[k] == x {
            v.temps.remove(k)
            return
        }
        k -= 1
    }
}

/// Releases temporary `x`.
fn drop_temp(inout v: Vir, x: i64) {
    forget_temp(v, x)
    emit(v, ir.M_DEC, -1, x, -1, 0)
}

/// A retained copy of variable `w`'s value, owned by the caller.
fn retain_copy(inout v: Vir, w: i64) -> i64 {
    let d = new_var(v, ir.TY_BOX)
    copy_to(v, d, w)
    emit(v, ir.M_INC, -1, d, -1, 0)
    own_temp(v, d)
    d
}

fn open_scope(inout v: Vir) {
    v.scope_mark.push(v.owned.len())
}

/// Closes the innermost scope, releasing what its variables own when control
/// reaches its end.
fn close_scope(inout v: Vir) {
    let m = v.scope_mark.pop() ?? 0
    if v.open {
        var k = v.owned.len() - 1
        while k >= m {
            let w = v.owned[k]
            emit(v, ir.M_DEC, -1, w, -1, 0)
            k -= 1
        }
    }
    while v.owned.len() > m {
        v.owned.pop()
    }
}

/// Variable `w` now owns a reference, until its scope closes. The
/// alternatives of an or-pattern bind the same variable, once each.
fn own_var(inout v: Vir, w: i64) {
    let m = if v.scope_mark.is_empty() { 0 } else { v.scope_mark[v.scope_mark.len() - 1] }
    for k in m..v.owned.len() {
        if v.owned[k] == w {
            return
        }
    }
    v.owned.push(w)
}

/// Releases, without forgetting them, every variable past `nowned` and
/// every temporary past `ntemps`: the way out of a `break`, a `continue` or
/// a `return`, after which this path ends.
fn release_from(inout v: Vir, nowned: i64, ntemps: i64) {
    var k = v.temps.len() - 1
    while k >= ntemps {
        emit(v, ir.M_DEC, -1, v.temps[k], -1, 0)
        k -= 1
    }
    k = v.owned.len() - 1
    while k >= nowned {
        emit(v, ir.M_DEC, -1, v.owned[k], -1, 0)
        k -= 1
    }
}

fn call_fn(inout v: Vir, callee: i64, args: [i64], returns: bool) -> i64 {
    var d = -1
    if returns {
        d = new_var(v, ir.TY_I64)
    }
    let i = emit(v, ir.M_CALL, d, -1, -1, callee)
    v.ca0[i] = v.cargs.len()
    v.can[i] = args.len()
    for x in args {
        v.cargs.push(x)
    }
    d
}

fn str_id(inout v: Vir, s: str) -> i64 {
    match v.str_ix.get(s) {
        Some(i) -> i
        None -> {
            let i = v.strs.len()
            v.strs.push(s)
            v.str_ix.set(s, i)
            i
        }
    }
}

/// The address and byte length of a literal, ready for the runtime.
fn text_args(inout v: Vir, s: str) -> [i64] {
    let id = str_id(v, s)
    let p = new_var(v, ir.TY_I64)
    emit(v, ir.M_STRADDR, p, -1, -1, id)
    let l = konst(v, s.to_bytes().len())
    [p, l]
}

/// A string literal as a value: a fresh, counted string, owned.
fn str_value(inout v: Vir, s: str) -> i64 {
    let args = text_args(v, s)
    rt(v, "grasm_str_lit", args, R_BOX)
}

/// Appends one interpolated value of TIR type element `te` to string
/// builder `sb`, as the Cranelift build's `emit_pieces` does; a boxed value
/// is released once written.
fn build_piece(inout v: Vir, t: TirTree, sb: i64, x: i64, te: i64, where_: str) {
    let k = ty_kind(t, te)
    if k == ir.TY_U64 {
        let s = rt(v, "grasm_str_from_u64", [x], R_BOX)
        rt(v, "grasm_str_build_str", [sb, s], R_VOID)
        drop_temp(v, s)
    } else if k == ir.TY_REF {
        // Written as a boxed reference displays, the slot it names.
        let b = box_kind(v, x, k)
        let s = rt(v, "grasm_str_from_val", [b], R_BOX)
        drop_temp(v, b)
        rt(v, "grasm_str_build_str", [sb, s], R_VOID)
        drop_temp(v, s)
    } else if ir.ty_int(k) {
        callrt(v, ir.RT_STR_BUILD_I64, [sb, x])
    } else if k == ir.TY_BOOL {
        callrt(v, ir.RT_STR_BUILD_BOOL, [sb, x])
    } else if ir.ty_fp(k) {
        // The builder takes the bits, as the Cranelift build passes them.
        let bits = fbits(v, x)
        rt(v, "grasm_str_build_f64", [sb, bits], R_VOID)
    } else if k == ir.TY_UNIT {
        let ta = text_args(v, "()")
        callrt(v, ir.RT_STR_BUILD_TEXT, [sb, ta[0], ta[1]])
    } else if ir.ty_boxed(k) and t.kind[te] == 0 and t.text[te] == "str" {
        rt(v, "grasm_str_build_str", [sb, x], R_VOID)
        drop_temp(v, x)
    } else if ir.ty_boxed(k) {
        let s = rt(v, "grasm_str_from_val", [x], R_BOX)
        drop_temp(v, x)
        rt(v, "grasm_str_build_str", [sb, s], R_VOID)
        drop_temp(v, s)
    } else {
        bad(v, "outside the subset: interpolating this type {where_}")
    }
    ()
}

/// A `str` node as a value: a literal, or text built in one of the
/// runtime's string builders, each interpolated value computed as its piece
/// is reached -- the Cranelift build's `build_string`.
fn lower_str(info: TirInfo, inout v: Vir, e: i64) -> i64 {
    let t = info.t
    let pieces = sexp.kids(t, e)
    var all_text = true
    var text = ""
    for pc in pieces {
        if sexp.kw(t, pc) == "text" {
            text = text + sexp.word(t, pc, 1)
        } else {
            all_text = false
        }
    }
    if all_text {
        return str_value(v, text)
    }
    let sb = callrt(v, ir.RT_STR_BUILD, [])
    for pc in pieces {
        if sexp.kw(t, pc) == "text" {
            let s = sexp.word(t, pc, 1)
            if s != "" {
                let ta = text_args(v, s)
                callrt(v, ir.RT_STR_BUILD_TEXT, [sb, ta[0], ta[1]])
            }
        } else {
            let x = sexp.at(t, pc, 1)
            let xv = value_of(info, v, x)
            build_piece(v, t, sb, xv, ty_el(t, x, 1), span_of(t, x))
        }
    }
    let s = callrt(v, ir.RT_STR_BUILD_END, [sb])
    v.vty[s] = ir.TY_BOX
    own_temp(v, s)
    s
}

// ----- boxes, lists, tuples, structs, variants ------------------------------------
//
// Representations are the runtime's, as the Cranelift build uses them: a list
// of integers, `u64`s or `bool`s is a scalar list of that kind; any other list
// holds boxes; a tuple's elements and a variant's fields are boxes; a struct
// holds a scalar field's bits and a boxed field's pointer, as its descriptor
// says.

/// The runtime's `ScalarKind` a list of `te` is held in, or -1 for a list of
/// boxes.
fn scalar_kind(t: TirTree, te: i64) -> i64 {
    let k = ty_kind(t, te)
    if k == ir.TY_U64 {
        5
    } else if ir.ty_int(k) {
        0
    } else if ir.ty_fp(k) {
        1
    } else if k == ir.TY_BOOL {
        2
    } else if k == ir.TY_REF {
        // A list of references is a scalar list of its own kind: stored as
        // words, printed as the slots they name.
        3
    } else {
        -1
    }
}

/// An owned box holding scalar `x` of kind `k`; a boxed `x` is its own box.
fn box_kind(inout v: Vir, x: i64, k: i64) -> i64 {
    if ir.ty_boxed(k) {
        x
    } else if k == ir.TY_U64 {
        rt(v, "grasm_box_u64", [x], R_BOX)
    } else if k == ir.TY_REF {
        // Boxed as a reference, so it prints as the slot it names.
        rt(v, "grasm_box_ref", [x], R_BOX)
    } else if ir.ty_int(k) {
        rt(v, "grasm_box_i64", [x], R_BOX)
    } else if ir.ty_fp(k) {
        rt(v, "grasm_box_f64", [x], R_BOX)
    } else if k == ir.TY_BOOL {
        rt(v, "grasm_box_bool", [x], R_BOX)
    } else {
        rt(v, "grasm_box_unit", [], R_BOX)
    }
}

/// The value an owned box `b` holds, as kind `k`: the box itself when `k`
/// is boxed, else the scalar read out of it and the box released.
fn unbox_kind(inout v: Vir, b: i64, k: i64) -> i64 {
    if ir.ty_boxed(k) {
        return b
    }
    var x = -1
    if ir.ty_int(k) or k == ir.TY_REF {
        x = rt(v, "grasm_unbox_i64", [b], R_WORD)
    } else if ir.ty_fp(k) {
        x = rt(v, "grasm_unbox_f64", [b], R_F64)
    } else if k == ir.TY_BOOL {
        x = rt(v, "grasm_unbox_bool", [b], R_BOOL8)
    } else {
        x = konst(v, 0)
    }
    drop_temp(v, b)
    x
}

/// Element `j` of a compound type element (`list`'s element is 1).
fn ty_arg(t: TirTree, x: i64, j: i64) -> i64 {
    if x < 0 or t.kind[x] != 2 or j >= t.count[x] {
        return -1
    }
    sexp.at(t, x, j)
}

/// A named type's arguments, as type elements.
fn named_args(t: TirTree, x: i64) -> [i64] {
    var out: [i64] = []
    if ty_head(t, x) == "named" {
        for j in 2..t.count[x] {
            out.push(sexp.at(t, x, j))
        }
    }
    out
}

/// `x` with every `(generic n)` read as `args[n]`: the type element itself
/// when it is one, or `x` unchanged (a compound type holding a generic is a
/// box whatever the generic is).
fn subst(t: TirTree, x: i64, args: [i64]) -> i64 {
    if ty_head(t, x) == "generic" {
        let n = sexp.word(t, x, 1).parse_int() ?? -1
        if n >= 0 and n < args.len() {
            return args[n]
        }
    }
    x
}

/// Whether a compound type element mentions a generic parameter.
fn has_generic(t: TirTree, x: i64) -> bool {
    if x < 0 or t.kind[x] != 2 {
        return false
    }
    if sexp.kw(t, x) == "generic" {
        return true
    }
    for j in 1..t.count[x] {
        if has_generic(t, sexp.at(t, x, j)) {
            return true
        }
    }
    false
}

/// The type of field `j` of variant `vidx` (-1 for a struct) of named type
/// `x`, whose declared type is `fe`: the declared type when it is concrete,
/// the type argument when it is one, else the instantiated type
/// monomorphization made (`mono.field_types`) -- or the declared type, still
/// generic, which the caller refuses.
fn field_te(info: TirInfo, x: i64, vidx: i64, j: i64, fe: i64) -> i64 {
    let t = info.t
    let s = subst(t, fe, named_args(t, x))
    if not has_generic(t, s) {
        return s
    }
    info.field_ty.get(mono.field_key(t, x, vidx, j)) ?? s
}

/// The kind of a declared field type under `args`.
fn field_kind(t: TirTree, fe: i64, args: [i64]) -> i64 {
    let x = subst(t, fe, args)
    if has_generic(t, x) {
        let h = ty_head(t, x)
        if h == "list" or h == "tuple" or h == "map" or h == "named" {
            return ir.TY_BOX
        }
        return ir.TY_OTHER
    }
    ty_kind(t, x)
}

/// The declaration body (`struct` or `sum` node) of the named type `x`.
fn type_body(info: TirInfo, x: i64) -> i64 {
    let t = info.t
    let d = info.type_ix.get(sexp.word(t, x, 1)) ?? -1
    if d < 0 {
        return -1
    }
    let ks = sexp.kids(t, d)
    if ks.is_empty() {
        return -1
    }
    ks[ks.len() - 1]
}

/// The Cranelift build's `VType::mangle` of a type element: how a generic
/// sum's instantiation is named in its values (`Tree[i64]`).
fn mangle(t: TirTree, x: i64) -> str {
    if x < 0 {
        return "?"
    }
    if t.kind[x] == 0 {
        let s = t.text[x]
        if s == "u64" or s == "f64" or s == "bool" or s == "unit" or s == "str" or s == "bytes" {
            return s
        }
        if ir.ty_int(ir.ty_of_name(s)) {
            return "i64"
        }
        return s
    }
    let h = sexp.kw(t, x)
    if h == "list" {
        return "l" + mangle(t, sexp.at(t, x, 1))
    }
    if h == "map" {
        return "m" + mangle(t, sexp.at(t, x, 1)) + "_" + mangle(t, sexp.at(t, x, 2))
    }
    if h == "tuple" {
        var parts: [str] = []
        for j in 1..t.count[x] {
            parts.push(mangle(t, sexp.at(t, x, j)))
        }
        return "t" + parts.join("_")
    }
    if h == "fallible" {
        return "f" + mangle(t, sexp.at(t, x, 1)) + "_" + mangle(t, sexp.at(t, x, 2))
    }
    if h == "ref" {
        return "ref_" + mangle(t, sexp.at(t, x, 1))
    }
    if h == "named" {
        let name = sexp.word(t, x, 1)
        if name == "Option" and t.count[x] == 3 {
            return "o" + mangle(t, sexp.at(t, x, 2))
        }
        return "n" + type_key(t, x)
    }
    "?"
}

/// A named type's name in its values: the name, or for an instantiation of a
/// generic one `Name[args]` (`instantiate_type`).
fn type_key(t: TirTree, x: i64) -> str {
    let name = sexp.word(t, x, 1)
    if t.count[x] <= 2 {
        return name
    }
    var parts: [str] = []
    for j in 2..t.count[x] {
        parts.push(mangle(t, sexp.at(t, x, j)))
    }
    name + "[" + parts.join(",") + "]"
}

/// The list literal `[a, b, ...]`: an empty list of the right kind, then a
/// push of each element as it is computed.
fn lower_list(info: TirInfo, inout v: Vir, e: i64) -> i64 {
    let t = info.t
    let te = ty_arg(t, ty_el(t, e, 1), 1)
    let ek = ty_kind(t, te)
    if not held(ek) {
        bad(v, "outside the subset: a list of {ty_text(t, e, 1)} {span_of(t, e)}")
        return konst(v, 0)
    }
    let sk = scalar_kind(t, te)
    var l = -1
    if sk >= 0 {
        let kc = konst(v, sk)
        l = rt(v, "grasm_list_new_scalar", [kc], R_BOX)
    } else {
        l = rt(v, "grasm_list_new", [], R_BOX)
    }
    for x in sexp.kids(t, e) {
        let xv = value_of(info, v, x)
        if sk >= 0 {
            let kc = konst(v, sk)
            let w = word_of(v, xv)
            forget_temp(v, l)
            l = rt(v, "grasm_list_push_scalar", [l, w, kc], R_BOX)
        } else {
            let b = box_kind(v, xv, ek)
            forget_temp(v, l)
            forget_temp(v, b)
            l = rt(v, "grasm_list_push", [l, b], R_BOX)
        }
    }
    l
}

/// A map literal: an empty map, then each entry's key and value boxed and
/// set, in the order written.
fn lower_maplit(info: TirInfo, inout v: Vir, e: i64) -> i64 {
    let t = info.t
    let mt = ty_el(t, e, 1)
    let kk = ty_kind(t, ty_arg(t, mt, 1))
    let vk = ty_kind(t, ty_arg(t, mt, 2))
    if not held(kk) or not held(vk) {
        bad(v, "outside the subset: a map of {ty_text(t, e, 1)} {span_of(t, e)}")
        return konst(v, 0)
    }
    var m = rt(v, "grasm_map_new", [], R_BOX)
    for en in sexp.kids(t, e) {
        let ek = sexp.kids(t, en)
        let kx = value_of(info, v, ek[0])
        let kb = box_kind(v, kx, kk)
        let vx = value_of(info, v, ek[1])
        let vb = box_kind(v, vx, vk)
        forget_temp(v, m)
        forget_temp(v, kb)
        forget_temp(v, vb)
        m = rt(v, "grasm_map_set", [m, kb, vb], R_BOX)
    }
    m
}

/// Element `i` of owned list (or tuple) `l`, of type `te`, as a value; `l`
/// is left alone.
fn list_elem(inout v: Vir, t: TirTree, l: i64, i: i64, te: i64) -> i64 {
    let sk = scalar_kind(t, te)
    if sk >= 0 {
        let kc = konst(v, sk)
        let w = rt(v, "grasm_list_get_scalar", [l, i, kc], R_WORD)
        return word_as(v, w, ty_kind(t, te))
    }
    let b = rt(v, "grasm_list_get", [l, i], R_BOX)
    unbox_kind(v, b, ty_kind(t, te))
}

fn lower_index(info: TirInfo, inout v: Vir, e: i64) -> i64 {
    let t = info.t
    let te = ty_el(t, e, 1)
    if not held(ty_kind(t, te)) {
        bad(v, "outside the subset: an element of type {ty_text(t, e, 1)} {span_of(t, e)}")
        return konst(v, 0)
    }
    let ks = sexp.kids(t, e)
    let l = value_of(info, v, ks[0])
    let i = value_of(info, v, ks[1])
    let r = list_elem(v, t, l, i, te)
    drop_temp(v, l)
    r
}

/// `for x in xs`: the list is computed once and held for the loop; each
/// element is bound for one iteration, in a scope of its own.
fn lower_for_list(info: TirInfo, inout v: Vir, e: i64) -> i64 {
    let t = info.t
    let ks = sexp.kids(t, e)
    let var_node = ks[0]
    if not held(ty_kind(t, ty_el(t, var_node, 4))) {
        bad(v, "outside the subset: `for` over elements of type {ty_text(t, var_node, 4)} {span_of(t, e)}")
        return -1
    }
    let l = value_of(info, v, ks[1])
    for_over_list(info, v, e, l)
}

/// The loop of `for` node `e` over list `l`, an owned temporary released
/// when the loop ends.
fn for_over_list(info: TirInfo, inout v: Vir, e: i64, l: i64) -> i64 {
    let t = info.t
    let ks = sexp.kids(t, e)
    let var_node = ks[0]
    let te = ty_el(t, var_node, 4)
    let n = rt(v, "grasm_list_len", [l], R_WORD)
    let ctr = new_var(v, ir.TY_I64)
    let zero = konst(v, 0)
    copy_to(v, ctr, zero)
    let head = new_block(v)
    let body = new_block(v)
    let step = new_block(v)
    let exit = new_block(v)
    switch_to(v, head)
    let c = icmp(v, ir.CC_SLT, ctr, n)
    term_brif(v, c, body, exit)
    switch_to(v, body)
    enter_loop(v, step, exit)
    open_scope(v)
    let x = list_elem(v, t, l, ctr, te)
    let k = ty_kind(t, te)
    let w = bind_tvar(v, sexp.word(t, var_node, 1).parse_int() ?? -1, k, te)
    copy_to(v, w, x)
    if ir.ty_boxed(k) {
        forget_temp(v, x)
        own_var(v, w)
    }
    let y = lower_expr(info, v, ks[2])
    discard(v, y)
    close_scope(v)
    leave_loop(v)
    if v.open {
        term_jump(v, step)
    }
    switch_to(v, step)
    let one = konst(v, 1)
    let nx = op2(v, ir.M_ADD, ctr, one)
    copy_to(v, ctr, nx)
    term_jump(v, head)
    switch_to(v, exit)
    drop_temp(v, l)
    -1
}

/// A tuple literal: its elements boxed, in `grasm_tuple2`/`3`, or pushed to a
/// list that is then sealed as a tuple.
fn lower_tuple(info: TirInfo, inout v: Vir, e: i64) -> i64 {
    let t = info.t
    let tt = ty_el(t, e, 1)
    var boxes: [i64] = []
    let ks = sexp.kids(t, e)
    if ks.is_empty() {
        // `()`: the unit value, which has nothing to hold.
        return -1
    }
    for j in 0..ks.len() {
        let k = ty_kind(t, ty_arg(t, tt, j + 1))
        if not held(k) {
            bad(v, "outside the subset: a tuple of {ty_text(t, e, 1)} {span_of(t, e)}")
            return konst(v, 0)
        }
        let xv = value_of(info, v, ks[j])
        boxes.push(box_kind(v, xv, k))
    }
    for b in boxes {
        forget_temp(v, b)
    }
    if boxes.len() == 2 {
        return rt(v, "grasm_tuple2", boxes, R_BOX)
    }
    if boxes.len() == 3 {
        return rt(v, "grasm_tuple3", boxes, R_BOX)
    }
    var l = rt(v, "grasm_list_new", [], R_BOX)
    for b in boxes {
        forget_temp(v, l)
        l = rt(v, "grasm_list_push", [l, b], R_BOX)
    }
    forget_temp(v, l)
    rt(v, "grasm_tuple_seal", [l], R_BOX)
}

fn lower_tuplefield(info: TirInfo, inout v: Vir, e: i64) -> i64 {
    let t = info.t
    let te = ty_el(t, e, 1)
    let k = ty_kind(t, te)
    if not held(k) {
        bad(v, "outside the subset: a tuple element of type {ty_text(t, e, 1)} {span_of(t, e)}")
        return konst(v, 0)
    }
    let idx = sexp.word(t, e, 3).parse_int() ?? 0
    let recv = sexp.kids(t, e)[0]
    let tv0 = value_of(info, v, recv)
    let (tv, _tte) = through_refs(v, t, tv0, ty_el(t, recv, 1))
    let ic = konst(v, idx)
    let b = rt(v, "grasm_list_get", [tv, ic], R_BOX)
    let x = unbox_kind(v, b, k)
    drop_temp(v, tv)
    x
}

/// `let (a, b) = t`.
fn lower_lettuple(info: TirInfo, inout v: Vir, e: i64) -> i64 {
    let t = info.t
    let ks = sexp.kids(t, e)
    let vars = sexp.kids(t, ks[0])
    let tv = value_of(info, v, ks[1])
    for j in 0..vars.len() {
        let vn = vars[j]
        let k = kind_at(t, vn, 4)
        if not held(k) {
            bad(v, "outside the subset: a binding of type {ty_text(t, vn, 4)} {span_of(t, ks[1])}")
            continue
        }
        let ic = konst(v, j)
        let b = rt(v, "grasm_list_get", [tv, ic], R_BOX)
        let x = unbox_kind(v, b, k)
        let w = bind_tvar(v, sexp.word(t, vn, 1).parse_int() ?? -1, k, ty_el(t, vn, 4))
        copy_to(v, w, x)
        if ir.ty_boxed(k) {
            forget_temp(v, x)
            own_var(v, w)
        }
    }
    drop_temp(v, tv)
    -1
}

/// The descriptor of struct type `x` (a `named` type element), as a data
/// object of this function: its name as written and each field's name and
/// kind under the type's arguments.
fn struct_desc(info: TirInfo, inout v: Vir, x: i64) -> i64 {
    let t = info.t
    let body = type_body(info, x)
    let args = named_args(t, x)
    var d = MirDesc{ name: sexp.word(t, x, 1), fields: [], kinds: [], name_str: -1, field_strs: [] }
    for f in sexp.kids(t, body) {
        d.fields.push(sexp.word(t, f, 1))
        let k = field_kind(t, sexp.at(t, f, 2), args)
        d.kinds.push(if k == ir.TY_U64 { ir.FK_U64 } else if ir.ty_int(k) { ir.FK_I64 } else if ir.ty_fp(k) { ir.FK_F64 } else if k == ir.TY_BOOL { ir.FK_BOOL } else if k == ir.TY_UNIT { ir.FK_UNIT } else if k == ir.TY_REF { ir.FK_REF } else { ir.FK_BOXED })
        if not held(k) {
            bad(v, "outside the subset: struct `{d.name}` has a field of a type this part does not hold")
        }
    }
    let key = desc_key(d)
    match v.desc_ix.get(key) {
        Some(k) -> k
        None -> {
            let k = v.descs.len()
            v.descs.push(d)
            v.desc_ix.set(key, k)
            k
        }
    }
}

/// What makes two descriptors the same one.
pub fn desc_key(d: MirDesc) -> str {
    var parts: [str] = [d.name]
    for i in 0..d.fields.len() {
        parts.push(d.fields[i] + ":" + d.kinds[i].to_str())
    }
    parts.join("|")
}

/// `n` adjacent 8-byte frame slots for words handed to the runtime by
/// address (a struct's fields); one area serves every such call of the
/// function, since each is filled and read within one call.
fn argv_slots(inout v: Vir, n: i64) -> i64 {
    if v.argv_base < 0 or v.argv_n < n {
        v.argv_base = v.nslots
        v.argv_n = n
        for k in 0..n {
            v.slot_var.push(-1)
            v.nslots += 1
        }
    }
    v.argv_base
}

/// A struct literal: every field computed in the order written, then
/// `grasm_struct_make` with the words in declared order.
fn lower_struct(info: TirInfo, inout v: Vir, e: i64) -> i64 {
    let t = info.t
    let x = ty_el(t, e, 1)
    let body = type_body(info, x)
    if body < 0 or sexp.kw(t, body) != "struct" {
        bad(v, "outside the subset: a literal of {ty_text(t, e, 1)} {span_of(t, e)}")
        return konst(v, 0)
    }
    let nf = sexp.kids(t, body).len()
    for f in sexp.kids(t, e) {
        if sexp.kw(t, f) == "base" {
            return lower_struct_update(info, v, e, f)
        }
    }
    var words: [i64] = []
    for i in 0..nf {
        words.push(-1)
    }
    for f in sexp.kids(t, e) {
        if sexp.kw(t, f) != "field" {
            bad(v, "outside the subset: a struct literal with `{sexp.kw(t, f)}` {span_of(t, e)}")
            return konst(v, 0)
        }
        let i = sexp.word(t, f, 1).parse_int() ?? 0
        words[i] = value_of(info, v, sexp.at(t, f, 2))
    }
    let d = struct_desc(info, v, x)
    let base = argv_slots(v, if nf > 0 { nf } else { 1 })
    for i in 0..nf {
        let addr = new_var(v, ir.TY_I64)
        emit(v, ir.M_SLOTADDR, addr, -1, -1, base + i)
        // A double's word is its bits, stored from its own register.
        store_at(v, addr, words[i])
        if is_temp(v, words[i]) {
            forget_temp(v, words[i])
        }
    }
    let dp = new_var(v, ir.TY_I64)
    emit(v, ir.M_DATAADDR, dp, -1, -1, d)
    let argv = new_var(v, ir.TY_I64)
    emit(v, ir.M_SLOTADDR, argv, -1, -1, base)
    rt(v, "grasm_struct_make", [dp, argv], R_BOX)
}

// ----- tasks -------------------------------------------------------------------------
//
// `parallel { .. }` runs its block first, which only records which `spawn`
// sites fired, in order; then it runs those tasks' bodies one after another,
// in that order, in this function's frame -- the Cranelift build's
// `emit_parallel`, and the interpreter's schedule ([E-SPAWN-ORDER],
// [E-PARALLEL-JOIN]). The checker's `proved` verdict lets the Cranelift build
// run a block of independent `v = e` tasks on worker threads instead; the
// tasks are effect-free and independent there, so running them in order
// gives the same values, and that is what this backend does.
//
// `concurrent { .. }` collects a closure of no arguments per `go`, each
// capturing by value ([E-CONCURRENT]), and hands the list to the runtime's
// scheduler when the block ends (`grasm_conc_run`), which runs them on
// fibers, switching where a channel operation waits.

// `xs.par_map(f)` and `xs.par_filter(f)` are the runtime's parallel maps
// (`grasm_par_map_scalar`, `grasm_par_map_mixed`, `grasm_par_filter_scalar`,
// `grasm_par_filter_boxed`), as in the Cranelift build: the runtime calls a
// worker of the C signature `fn(env: *const i64, x: i64) -> i64` once per
// element, on as many threads as it judges worth it, and keeps the results
// in input order. The worker here (`lower_worker`) is one per pair of
// element and result classes: the environment's one word is the function
// value, which it calls with the element -- retained, since the list keeps
// its own -- answering the result's bits, or an owned box. The function
// value is shared by the threads, as the Cranelift build's captures are,
// which the runtime's atomic counts make sound. Where the Cranelift build
// maps in order on the calling thread instead -- a result of no value, or a
// function that can fail -- so does this one. `net_workers(n, f)` is the
// same machine over `[0, n)` (`grasm_net_workers`), one thread a worker.

/// How a word crossing to or from a worker is read: 0 the integer bits
/// themselves, 1 a double's bits, 2 a box's pointer, 3 nothing (unit).
fn word_class(k: i64) -> i64 {
    if ir.ty_fp(k) {
        1
    } else if ir.ty_boxed(k) {
        2
    } else if k == ir.TY_UNIT or k == ir.TY_NEVER {
        3
    } else {
        0
    }
}

/// A worker's element: the element's class and the result's.
fn worker_code(ek: i64, rk: i64) -> i64 {
    word_class(ek) * 8 + word_class(rk)
}

/// Whether a parallel map can hand values of type element `te` across
/// threads, as the Cranelift build asks it: a scalar list's kind, or a box.
fn crosses(t: TirTree, te: i64) -> bool {
    scalar_kind(t, te) >= 0 or ir.ty_boxed(ty_kind(t, te))
}

/// The worker for elements and results of the classes in `code`.
pub fn lower_worker(code: i64) -> Vir {
    var v = new_vir()
    let in_cls = code / 8
    let out_cls = code % 8
    let envp = new_var(v, ir.TY_I64)
    let x = new_var(v, ir.TY_I64)
    v.nparams = 2
    v.returns = true
    open_scope(v)
    let entry = new_block(v)
    switch_to(v, entry)
    // Borrowed: the caller holds the value for the whole parallel call.
    let f = new_var(v, ir.TY_BOX)
    emit(v, ir.M_LOAD, f, envp, -1, 0)
    var a = -1
    if in_cls == 1 {
        a = from_bits(v, x)
    } else if in_cls == 2 {
        a = new_var(v, ir.TY_BOX)
        copy_to(v, a, x)
        emit(v, ir.M_INC, -1, a, -1, 0)
    } else {
        a = new_var(v, ir.TY_I64)
        copy_to(v, a, x)
    }
    let rk = if out_cls == 1 { ir.TY_F64 } else if out_cls == 2 { ir.TY_BOX } else if out_cls == 3 { ir.TY_UNIT } else { ir.TY_I64 }
    let r = call_value(v, f, [a], rk)
    var bits = -1
    if out_cls == 1 {
        bits = fbits(v, r)
    } else if out_cls == 2 {
        // The runtime's result list takes it.
        forget_temp(v, r)
        bits = r
    } else if out_cls == 3 {
        bits = konst(v, 0)
    } else {
        bits = r
    }
    do_return(v, bits)
    v.scope_mark.pop()
    v
}

/// The function value `f` in a frame slot and a worker for it: the worker's
/// code address and the address of its one-word environment.
fn worker_for(inout v: Vir, f: i64, code: i64) -> (i64, i64) {
    let slot = fresh_slot(v)
    let a = slot_addr(v, slot)
    emit(v, ir.M_STORE, -1, a, f, 0)
    let li = add_lift(v, LIFT_WORKER, code, [], [])
    let cv = new_var(v, ir.TY_I64)
    emit(v, ir.M_FNADDR, cv, -1, -1, li)
    (cv, slot_addr(v, slot))
}

/// `xs.par_map(f)` and `xs.par_filter(f)`.
fn par_method(info: TirInfo, inout v: Vir, e: i64, name: str) -> i64 {
    let t = info.t
    let ks = sexp.kids(t, e)
    let ete = ty_arg(t, ty_el(t, ks[0], 1), 1)
    let fty = ty_el(t, ks[1], 1)
    let rte = fn_ret(t, fty)
    let filter = name == "par_filter"
    // A function whose failure fails the function around it, too: the
    // workers have nowhere to put an error ([E-PAR-FAIL]).
    if ty_head(t, rte) == "fallible" or not crosses(t, ete) or (not filter and not crosses(t, rte)) or inlined_closure(t, ks[1]) {
        // In order on this thread, as the Cranelift build falls back.
        return hof_method(info, v, e, if filter { "filter" } else { "map" })
    }
    let l = value_of(info, v, ks[0])
    let f = value_of(info, v, ks[1])
    let (cv, envp) = worker_for(v, f, worker_code(ty_kind(t, ete), if filter { ir.TY_BOOL } else { ty_kind(t, rte) }))
    let one = konst(v, 1)
    let isk = scalar_kind(t, ete)
    var r = -1
    if filter {
        r = rt(v, if isk >= 0 { "grasm_par_filter_scalar" } else { "grasm_par_filter_boxed" }, [l, cv, envp, one], R_BOX)
    } else {
        let osk = scalar_kind(t, rte)
        if isk >= 0 and osk >= 0 {
            let okc = konst(v, osk)
            r = rt(v, "grasm_par_map_scalar", [l, cv, envp, one, okc], R_BOX)
        } else {
            let ib = konst(v, if isk < 0 { 1 } else { 0 })
            let okc = konst(v, osk)
            r = rt(v, "grasm_par_map_mixed", [l, cv, envp, one, ib, okc], R_BOX)
        }
    }
    drop_temp(v, l)
    drop_temp(v, f)
    r
}

/// `net_workers(n, f)`: `f(0)` .. `f(n - 1)`, a thread each, the results in
/// index order ([L-LIB-NET-WORKERS]).
fn lower_net_workers(info: TirInfo, inout v: Vir, e: i64) -> i64 {
    let t = info.t
    let ks = sexp.kids(t, e)
    let fty = ty_el(t, ks[1], 1)
    let pts = fn_params(t, fty)
    if not held(kind_at(t, e, 1)) or not ir.ty_boxed(ty_kind(t, fty)) or pts.len() != 1 {
        bad(v, "outside the subset: `net_workers` of {ty_text(t, ks[1], 1)} {span_of(t, e)}")
        return konst(v, 0)
    }
    let rte = fn_ret(t, fty)
    let n = value_of(info, v, ks[0])
    let l = rt(v, "grasm_net_workers_indices", [n], R_BOX)
    let f = value_of(info, v, ks[1])
    if ty_head(t, rte) == "fallible" or not crosses(t, rte) {
        // In order on this thread, as the Cranelift build falls back.
        let out = empty_list_for(v, t, rte)
        var w = walk_list(v, l, pts[0])
        walk_head(v, w)
        let x = walk_elem(v, t, w)
        let y = call_value(v, f, [x], ty_kind(t, rte))
        push_elem(v, t, out, y, rte)
        walk_next(v, w)
        drop_temp(v, f)
        return out
    }
    let (cv, envp) = worker_for(v, f, worker_code(ir.TY_I64, ty_kind(t, rte)))
    let one = konst(v, 1)
    let okc = konst(v, scalar_kind(t, rte))
    let r = rt(v, "grasm_net_workers", [l, cv, envp, one, okc], R_BOX)
    drop_temp(v, l)
    drop_temp(v, f)
    r
}

/// The `spawn` sites of a `parallel` block, in the order written: every
/// `spawn` below it but those of a nested `parallel` or of a closure.
fn spawn_sites(t: TirTree, block: i64) -> [i64] {
    var out: [i64] = []
    var stack: [i64] = [block]
    while not stack.is_empty() {
        let x = stack.pop() ?? 0
        if t.kind[x] != 2 {
            continue
        }
        let k = sexp.kw(t, x)
        if k == "spawn" {
            out.push(x)
            continue
        }
        if (k == "parallel" or k == "closure") and x != block {
            continue
        }
        var i = t.count[x] - 1
        while i >= 0 {
            let y = sexp.at(t, x, i)
            if t.kind[y] == 2 {
                stack.push(y)
            }
            i -= 1
        }
    }
    out
}

fn lower_parallel(info: TirInfo, inout v: Vir, e: i64) -> i64 {
    let t = info.t
    let body = sexp.kids(t, e)[0]
    let concurrent = sexp.word(t, e, 1) == "concurrent"
    // The list lives in a scope of its own, so however the block is left
    // it is released, with the tasks in it.
    open_scope(v)
    var l = -1
    if concurrent {
        l = rt(v, "grasm_list_new", [], R_BOX)
    } else {
        let kc = konst(v, 0)
        l = rt(v, "grasm_list_new_scalar", [kc], R_BOX)
    }
    let w = new_var(v, ir.TY_BOX)
    copy_to(v, w, l)
    forget_temp(v, l)
    own_var(v, w)
    var sites: [i64] = []
    if not concurrent {
        sites = spawn_sites(t, body)
    }
    if concurrent {
        v.go_list.push(w)
    } else {
        v.par_list.push(w)
        v.par_sites.push(sites)
    }
    v.par_conc.push(concurrent)
    let x = lower_expr(info, v, body)
    discard(v, x)
    v.par_conc.pop()
    if concurrent {
        v.go_list.pop()
        if v.open {
            rt(v, "grasm_conc_run", [w], R_VOID)
        }
        close_scope(v)
        return -1
    }
    v.par_list.pop()
    v.par_sites.pop()
    if v.open and not sites.is_empty() {
        // The tasks, in the order their sites fired.
        let n = rt(v, "grasm_list_len", [w], R_WORD)
        let ctr = new_var(v, ir.TY_I64)
        let zero = konst(v, 0)
        copy_to(v, ctr, zero)
        let head = new_block(v)
        let disp = new_block(v)
        let step = new_block(v)
        let exit = new_block(v)
        switch_to(v, head)
        let more = icmp(v, ir.CC_SLT, ctr, n)
        term_brif(v, more, disp, exit)
        switch_to(v, disp)
        let kc = konst(v, 0)
        let site = rt(v, "grasm_list_get_scalar", [w, ctr, kc], R_WORD)
        for k in 0..sites.len() {
            let task = new_block(v)
            let next = if k == sites.len() - 1 { step } else { new_block(v) }
            let want = konst(v, k)
            let hit = icmp(v, ir.CC_EQ, site, want)
            term_brif(v, hit, task, next)
            switch_to(v, task)
            let y = lower_expr(info, v, sexp.kids(t, sites[k])[0])
            discard(v, y)
            if v.open {
                term_jump(v, step)
            }
            if k < sites.len() - 1 {
                switch_to(v, next)
            }
        }
        switch_to(v, step)
        let one = konst(v, 1)
        let nx = op2(v, ir.M_ADD, ctr, one)
        copy_to(v, ctr, nx)
        term_jump(v, head)
        switch_to(v, exit)
    }
    close_scope(v)
    -1
}

/// `spawn { .. }`: in a `parallel` block, its site recorded; in a
/// `concurrent` one (`go`), its task made and added.
fn lower_spawn(info: TirInfo, inout v: Vir, e: i64) -> i64 {
    let t = info.t
    let conc = sexp.word(t, e, 1) == "concurrent"
    if v.par_conc.is_empty() or v.par_conc[v.par_conc.len() - 1] != conc {
        bad(v, "outside the subset: a `spawn` not directly in its own kind of block {span_of(t, e)}")
        return -1
    }
    if conc {
        if v.go_list.is_empty() {
            bad(v, "outside the subset: `go` outside a `concurrent` block {span_of(t, e)}")
            return -1
        }
        let w = v.go_list[v.go_list.len() - 1]
        let f = make_closure(info, v, e)
        forget_temp(v, f)
        let nl = rt(v, "grasm_list_push", [w, f], R_BOX)
        copy_to(v, w, nl)
        forget_temp(v, nl)
        return -1
    }
    var k = -1
    if not v.par_sites.is_empty() {
        let sites = v.par_sites[v.par_sites.len() - 1]
        for j in 0..sites.len() {
            if sites[j] == e {
                k = j
            }
        }
    }
    if k < 0 {
        bad(v, "outside the subset: a `spawn` outside its `parallel` block {span_of(t, e)}")
        return -1
    }
    let w = v.par_list[v.par_list.len() - 1]
    let kc = konst(v, 0)
    let x = konst(v, k)
    let nl = rt(v, "grasm_list_push_scalar", [w, x, kc], R_BOX)
    copy_to(v, w, nl)
    forget_temp(v, nl)
    -1
}

// ----- raw memory --------------------------------------------------------------------
//
// An `addr` is a word ([T-ADDR]), and every raw-memory operation is what the
// Cranelift build's `eval_mem` makes it ([L-LIB-MEM], [L-LIB-ATOMIC]): an
// access is one instruction at the address, unchecked ([E-MEM-UNCHECKED]);
// a narrow value loaded is extended by its signedness; every atomic is
// sequentially consistent whatever ordering is written, which is at least
// what any asks for, so the ordering -- a name, not a value -- chooses
// nothing and is not evaluated; a narrow atomic's answer is extended as a
// load's is. `mem_alloc` and `mem_free` are the runtime's.

/// The layout type a raw-memory method's name ends in (`load_u16` ->
/// `u16`), as the `TY_*` it holds; -1 for none.
fn layout_of(name: str) -> i64 {
    let parts = name.split("_")
    ir.ty_of_name(parts[parts.len() - 1])
}

/// The bytes a layout type takes.
fn layout_size(k: i64) -> i64 {
    if k == ir.TY_I8 or k == ir.TY_U8 {
        1
    } else if k == ir.TY_I16 or k == ir.TY_U16 {
        2
    } else if k == ir.TY_I32 or k == ir.TY_U32 {
        4
    } else {
        8
    }
}

/// Thread-local cell `name`'s offset in the block every thread gets, and the
/// block's size: the program's cells (`(threadlocal "m::C" T)`) in the order
/// of their names, each aligned to its size, the whole rounded up to eight
/// bytes -- the layout the Cranelift build's `tls_layout` makes. The offset
/// is -1 for a cell the program does not declare.
fn tls_place(t: TirTree, name: str) -> (i64, i64) {
    var names: [str] = []
    var sizes: Map[str, i64] = {}
    for r in t.roots {
        if sexp.kw(t, r) == "threadlocal" {
            let n = sexp.word(t, r, 1)
            names.push(n)
            sizes.set(n, layout_size(ir.ty_of_name(sexp.word(t, r, 2))))
        }
    }
    names.sort()
    var at = 0
    var found = -1
    for n in names {
        let sz = sizes.get(n) ?? 8
        at = (at + sz - 1) / sz * sz
        if n == name {
            found = at
        }
        at += sz
    }
    (found, (at + 7) / 8 * 8)
}

/// Whether type element `x` is a layout type: what a C entry's parameters
/// and result may be ([T-FN-ADDR]).
fn layout_te(t: TirTree, x: i64) -> bool {
    if x < 0 or t.kind[x] != 0 {
        return false
    }
    let k = ir.ty_of_name(t.text[x])
    ir.ty_int(k) or ir.ty_fp(k)
}

/// Whether Grasm callable `c` has a C-compatible signature: `let`
/// parameters of layout types, a layout result or none, not generic, not
/// fallible ([T-FN-ADDR]).
pub fn c_compatible(info: TirInfo, c: i64) -> bool {
    let t = info.t
    if info.c_const[c] or fn_err(info, c) >= 0 {
        return false
    }
    let e = info.c_elem[c]
    if t.count[sexp.at(t, e, 2)] > 1 {
        return false
    }
    for p in params_of(info, c) {
        if sexp.word(t, p, 1) != "let" or not layout_te(t, ty_el(t, p, 4)) {
            return false
        }
    }
    let r = ty_el(t, e, 4)
    is_ty(t, r, "unit") or layout_te(t, r)
}

/// The C entry of Grasm function `c`: its parameters by the C convention,
/// each narrow one re-extended from its own width -- C leaves the bits above
/// an `i8` or an `i32` unspecified, and this backend holds every integer as
/// a canonical word -- a stack floor asked for when `c` can recurse (the
/// hidden argument C cannot pass), and the call.
pub fn lower_centry(info: TirInfo, c: i64) -> Vir {
    let t = info.t
    var v = new_vir()
    let e = info.c_elem[c]
    let rk = kind_at(t, e, 4)
    v.returns = valued(rk)
    v.ret_kind = rk
    open_scope(v)
    var pvs: [i64] = []
    var pks: [i64] = []
    for p in params_of(info, c) {
        let k = kind_at(t, p, 4)
        pks.push(k)
        pvs.push(new_var(v, if ir.ty_fp(k) { ir.TY_F64 } else { ir.TY_I64 }))
    }
    v.nparams = v.nvars
    let entry = new_block(v)
    switch_to(v, entry)
    var args: [i64] = []
    if info.recursive[c] {
        args.push(floor_arg(v))
    }
    for j in 0..pvs.len() {
        args.push(wrap(v, pks[j], pvs[j]))
    }
    var r = call_fn(v, c, args, v.returns)
    if r >= 0 and ir.ty_fp(rk) {
        v.vty[r] = ir.TY_F64
    }
    do_return(v, if v.returns { r } else { -1 })
    v.scope_mark.pop()
    v
}

/// `mem_fn_addr(f)` ([T-FN-ADDR]): a Grasm function's C entry, or a C
/// function's own address, as the linker gives it. An `arm64` code pointer
/// is not signed, and nothing here signs or strips one.
fn lower_fn_addr(info: TirInfo, inout v: Vir, e: i64, arg: i64) -> i64 {
    let t = info.t
    let name = sexp.word(t, arg, 1)
    let c = info.fn_ix.get(name) ?? -1
    if c >= 0 {
        if not c_compatible(info, c) {
            bad(v, "outside the subset: the address of `{name}`, which has no C signature {span_of(t, e)}")
            return konst(v, 0)
        }
        let li = add_lift(v, LIFT_CENTRY, c, [], [])
        let d = new_var(v, ir.TY_I64)
        emit(v, ir.M_FNADDR, d, -1, -1, li)
        return d
    }
    let decl = extern_decl(t, name)
    if decl < 0 {
        bad(v, "outside the subset: the address of `{name}` {span_of(t, e)}")
        return konst(v, 0)
    }
    let d = new_var(v, ir.TY_I64)
    emit(v, ir.M_GOTADDR, d, -1, -1, rt_id(v, bare_name(name)))
    d
}

/// `a.call_c(Sig, x, y)` ([L-LIB-CALL-C]): a call through address `a` by the
/// C convention, its arguments crossing as an `extern` call's do and a
/// narrow result read at its width; `grasm_foreign_call` told first, as for
/// any C call. Nothing is checked: a wrong signature is undefined.
fn lower_call_c(info: TirInfo, inout v: Vir, e: i64) -> i64 {
    let t = info.t
    let ks = sexp.kids(t, e)
    let sig = ks[1]
    let ps = sexp.at(t, sig, 1)
    let ret = sexp.at(t, sig, 2)
    if sexp.kw(t, sig) != "sig" or t.kind[ps] != 2 or t.count[ps] != ks.len() - 2 or not c_ret_ok(t, ret) {
        bad(v, "outside the subset: a `call_c` whose signature is not a C one {span_of(t, e)}")
        return konst(v, 0)
    }
    for j in 0..t.count[ps] {
        if not c_param_ok(t, sexp.at(t, ps, j)) {
            bad(v, "outside the subset: a `call_c` whose signature is not a C one {span_of(t, e)}")
            return konst(v, 0)
        }
    }
    let at = value_of(info, v, ks[0])
    var vals: [i64] = []
    var copies: [i64] = []
    var boxes: [i64] = []
    for j in 0..t.count[ps] {
        let pt = sexp.at(t, ps, j)
        let x = value_of(info, v, ks[j + 2])
        if is_ty(t, pt, "str") {
            let p = rt(v, "grasm_str_c_new", [x], R_WORD)
            copies.push(p)
            boxes.push(x)
            vals.push(p)
        } else if is_ty(t, pt, "bytes") {
            boxes.push(x)
            vals.push(rt(v, "grasm_bytes_ptr", [x], R_WORD))
        } else {
            vals.push(x)
        }
    }
    let na = text_args(v, "call_c")
    rt(v, "grasm_foreign_call", [na[0], na[1]], R_VOID)
    let rk = ty_kind(t, ret)
    var d = -1
    if valued(rk) {
        d = new_var(v, if ir.ty_fp(rk) { ir.TY_F64 } else { ir.TY_I64 })
    }
    let i = emit(v, ir.M_CALLIND, d, at, -1, 0)
    v.ca0[i] = v.cargs.len()
    v.can[i] = vals.len()
    for x in vals {
        v.cargs.push(x)
    }
    if d >= 0 and ir.ty_int(rk) {
        d = wrap(v, rk, d)
    }
    for p in copies {
        rt(v, "grasm_str_c_free", [p], R_VOID)
    }
    for x in boxes {
        discard(v, x)
    }
    d
}

/// A method on an `addr`.
fn addr_method(info: TirInfo, inout v: Vir, e: i64, name: str) -> i64 {
    let t = info.t
    if name == "call_c" {
        return lower_call_c(info, v, e)
    }
    let ks = sexp.kids(t, e)
    let atomic = name.starts_with("atomic_")
    // An atomic's last argument is its ordering: a name, not evaluated.
    let nval = if atomic { ks.len() - 1 } else { ks.len() }
    if atomic and (ks.len() < 2 or sexp.kw(t, ks[ks.len() - 1]) != "order") {
        bad(v, "outside the subset: an atomic without its ordering {span_of(t, e)}")
        return konst(v, 0)
    }
    var vals: [i64] = []
    for i in 0..nval {
        vals.push(value_of(info, v, ks[i]))
    }
    let at = vals[0]
    if name == "offset" and nval == 2 {
        return op2(v, ir.M_ADD, at, vals[1])
    }
    if name == "diff" and nval == 2 {
        return op2(v, ir.M_SUB, at, vals[1])
    }
    if name == "as_i64" and nval == 1 {
        return at
    }
    let k = layout_of(name)
    let sz = layout_size(k)
    let signed = k == ir.TY_I8 or k == ir.TY_I16 or k == ir.TY_I32
    if name.starts_with("load_") and nval == 1 {
        if ir.ty_fp(k) {
            return fop1(v, ir.M_FLOAD, at)
        }
        if sz == 8 {
            return op1(v, ir.M_LOAD, at)
        }
        let op = if sz == 1 { if signed { ir.M_LOAD8S } else { ir.M_LOAD8U } } else if sz == 2 { if signed { ir.M_LOAD16S } else { ir.M_LOAD16U } } else { if signed { ir.M_LOAD32S } else { ir.M_LOAD32U } }
        return op1(v, op, at)
    }
    if name.starts_with("store_") and nval == 2 {
        let x = vals[1]
        let op = if ir.ty_fp(k) { ir.M_FSTORE } else if sz == 1 { ir.M_STORE8 } else if sz == 2 { ir.M_STORE16 } else if sz == 4 { ir.M_STORE32 } else { ir.M_STORE }
        emit(v, op, -1, at, x, 0)
        return -1
    }
    if atomic and ir.ty_int(k) {
        var r = -1
        if name.starts_with("atomic_load_") and nval == 1 {
            r = op1(v, ir.atomic_at(ir.M_ALOAD8, sz), at)
        } else if name.starts_with("atomic_store_") and nval == 2 {
            emit(v, ir.atomic_at(ir.M_ASTORE8, sz), -1, at, vals[1], 0)
            return -1
        } else if name.starts_with("atomic_add_") and nval == 2 {
            r = op2(v, ir.atomic_at(ir.M_AADD8, sz), at, vals[1])
        } else if name.starts_with("atomic_cas_") and nval == 3 {
            r = new_var(v, ir.TY_I64)
            let i = emit(v, ir.atomic_at(ir.M_ACAS8, sz), r, at, vals[1], 0)
            v.ca0[i] = v.cargs.len()
            v.can[i] = 1
            v.cargs.push(vals[2])
        } else {
            bad(v, "outside the subset: method `{name}` on addr {span_of(t, e)}")
            return konst(v, 0)
        }
        // A narrow answer comes back zero-extended: a signed one is read at
        // its width.
        return if signed { wrap(v, k, r) } else { r }
    }
    bad(v, "outside the subset: method `{name}` on addr {span_of(t, e)}")
    konst(v, 0)
}

// ----- C functions -------------------------------------------------------------------
//
// An `extern fn` is called by the C convention, as the Cranelift build calls
// it ([T-EXTERN], [T-EXTERN-POINTER]): an integer, an `addr` or an `f64`
// crosses as itself; a `str` as a NUL-terminated copy (`grasm_str_c_new`),
// freed after the call; `bytes` as its own buffer (`grasm_bytes_ptr`), lent
// for the call. `grasm_foreign_call` is told first, as there, so a replay can
// refuse. A narrow integer answered is read at its width: C leaves the
// register's upper bits unspecified. Its symbol is its bare name, resolved by
// the linker.

/// The declaration `(extern "m::f" (P..) R)` of C function `name`, or -1.
fn extern_decl(t: TirTree, name: str) -> i64 {
    for r in t.roots {
        if sexp.kw(t, r) == "extern" and sexp.word(t, r, 1) == name {
            return r
        }
    }
    -1
}

/// Whether type element `x` is one a C function's parameter may be.
fn c_param_ok(t: TirTree, x: i64) -> bool {
    if t.kind[x] != 0 {
        return false
    }
    let s = t.text[x]
    s == "str" or s == "bytes" or s == "addr" or s == "f64" or ir.ty_int(ir.ty_of_name(s))
}

/// Whether type element `x` is one a C function may answer.
fn c_ret_ok(t: TirTree, x: i64) -> bool {
    if t.kind[x] != 0 {
        return false
    }
    let s = t.text[x]
    s == "unit" or s == "addr" or s == "f64" or ir.ty_int(ir.ty_of_name(s))
}

/// Calls C function `decl` with `args` (owned temporaries when boxed, which
/// this releases): each argument as C takes it, the answer read at its width.
fn call_c_decl(inout v: Vir, t: TirTree, decl: i64, args: [i64]) -> i64 {
    let ps = sexp.at(t, decl, 2)
    let ret = sexp.at(t, decl, 3)
    var vals: [i64] = []
    var copies: [i64] = []
    for i in 0..args.len() {
        let pt = sexp.at(t, ps, i)
        let x = args[i]
        if is_ty(t, pt, "str") {
            let p = rt(v, "grasm_str_c_new", [x], R_WORD)
            copies.push(p)
            vals.push(p)
        } else if is_ty(t, pt, "bytes") {
            vals.push(rt(v, "grasm_bytes_ptr", [x], R_WORD))
        } else {
            vals.push(x)
        }
    }
    let cname = bare_name(sexp.word(t, decl, 1))
    let na = text_args(v, cname)
    rt(v, "grasm_foreign_call", [na[0], na[1]], R_VOID)
    let rk = if is_ty(t, ret, "addr") { ir.TY_I64 } else { ty_kind(t, ret) }
    var d = -1
    if valued(rk) {
        d = new_var(v, if ir.ty_fp(rk) { ir.TY_F64 } else { ir.TY_I64 })
    }
    let i = emit(v, ir.M_CALLRT, d, -1, -1, rt_id(v, cname))
    v.ca0[i] = v.cargs.len()
    v.can[i] = vals.len()
    for x in vals {
        v.cargs.push(x)
    }
    if d >= 0 and ir.ty_int(rk) {
        d = wrap(v, rk, d)
    }
    // The call is over: the copies freed, the boxes behind the pointers
    // released.
    for p in copies {
        rt(v, "grasm_str_c_free", [p], R_VOID)
    }
    for x in args {
        discard(v, x)
    }
    d
}

/// `f(a, b)` of an `extern fn`.
fn lower_callextern(info: TirInfo, inout v: Vir, e: i64) -> i64 {
    let t = info.t
    let name = sexp.word(t, e, 3)
    let decl = extern_decl(t, name)
    if decl < 0 or not extern_ok(t, decl) {
        bad(v, "outside the subset: a call of C function `{name}` {span_of(t, e)}")
        return -1
    }
    var args: [i64] = []
    for a in sexp.kids(t, e) {
        args.push(value_of(info, v, a))
    }
    call_c_decl(v, t, decl, args)
}

/// Whether every parameter and the answer of `extern` declaration `decl`
/// cross as this backend passes them.
pub fn extern_ok(t: TirTree, decl: i64) -> bool {
    let ps = sexp.at(t, decl, 2)
    if t.kind[ps] != 2 {
        return false
    }
    var nint = 0
    var nfp = 0
    for j in 0..t.count[ps] {
        let p = sexp.at(t, ps, j)
        if not c_param_ok(t, p) {
            return false
        }
        if is_ty(t, p, "f64") {
            nfp += 1
        } else {
            nint += 1
        }
    }
    // Eight of each class travel in registers; a runtime call takes no more.
    nint <= 8 and nfp <= 8 and c_ret_ok(t, sexp.at(t, decl, 3))
}

/// The function a C function is called through as a value: the closure
/// convention's environment first, which it releases, then the C function's
/// parameters, each crossing as a direct call's does.
pub fn lower_extern_wrapper(info: TirInfo, decl: i64) -> Vir {
    let t = info.t
    var v = new_vir()
    let ret = sexp.at(t, decl, 3)
    let rk = if is_ty(t, ret, "addr") { ir.TY_I64 } else { ty_kind(t, ret) }
    v.returns = valued(rk)
    v.ret_kind = rk
    open_scope(v)
    let env = new_var(v, ir.TY_BOX)
    own_var(v, env)
    let ps = sexp.at(t, decl, 2)
    var pvs: [i64] = []
    for j in 0..t.count[ps] {
        let p = sexp.at(t, ps, j)
        let k = if is_ty(t, p, "addr") { ir.TY_I64 } else { ty_kind(t, p) }
        pvs.push(new_var(v, k))
    }
    v.nparams = v.nvars
    let entry = new_block(v)
    switch_to(v, entry)
    // The parameters are this wrapper's, and C keeps none of them.
    for j in 0..pvs.len() {
        if ir.ty_boxed(v.vty[pvs[j]]) {
            own_temp(v, pvs[j])
        }
    }
    let r = call_c_decl(v, t, decl, pvs)
    do_return(v, if v.returns { r } else { -1 })
    v.scope_mark.pop()
    v
}

// ----- effects -----------------------------------------------------------------------
//
// A handler is a struct of function values, one per operation of its effect
// (TIR writes `ClockHandler{ now: || 1 }`). `with E handled_by h { .. }`
// installs it on the runtime's handler stack for the block -- the same
// `grasm_handler_push`, `grasm_handler_op` and `grasm_handler_pop` the
// Cranelift build calls -- with each operation's function value as both its
// code and its environment: the stack holds them for the block, which owns a
// reference to each and releases it when the handler is popped. An operation
// (`E.op(a)`) asks the stack for the innermost handler's function
// (`grasm_handler_lookup`, which panics if there is none) and calls it as any
// function value is called. Every way out of the block -- its end, `break`,
// `continue`, `return`, `fail`, a `try` that fails -- pops what it installed
// ([E-HANDLER-SCOPE]).

/// The declaration `(effect "E" (op "name" (P..) R) ..)` of effect `name`,
/// or -1.
fn effect_decl(t: TirTree, name: str) -> i64 {
    for r in t.roots {
        if sexp.kw(t, r) == "effect" and sexp.word(t, r, 1) == name {
            return r
        }
    }
    -1
}

/// `with E handled_by h { body }`: the handler's operations installed for
/// the block, innermost first when they are looked up.
fn lower_with(info: TirInfo, inout v: Vir, e: i64) -> i64 {
    let t = info.t
    let ename = sexp.word(t, e, 1)
    let ks = sexp.kids(t, e)
    let decl = effect_decl(t, ename)
    let hte = ty_el(t, ks[0], 1)
    let body = type_body(info, hte)
    if decl < 0 or body < 0 or sexp.kw(t, body) != "struct" or not ir.ty_boxed(ty_kind(t, hte)) {
        bad(v, "outside the subset: a `with {ename}` whose handler is {ty_text(t, ks[0], 1)} {span_of(t, e)}")
        return -1
    }
    // Each operation's field, by name.
    let fields = sexp.kids(t, body)
    var ops: [str] = []
    var idx: [i64] = []
    for op in sexp.kids(t, decl) {
        let name = sexp.word(t, op, 1)
        var found = -1
        for j in 0..fields.len() {
            if sexp.word(t, fields[j], 1) == name {
                found = j
            }
        }
        if found < 0 or not ir.ty_boxed(ty_kind(t, sexp.at(t, fields[found], 2))) {
            bad(v, "outside the subset: a handler with no function for `{ename}.{name}` {span_of(t, e)}")
            return -1
        }
        ops.push(name)
        idx.push(found)
    }
    let h = value_of(info, v, ks[0])
    // A scope of its own holds the functions, so leaving the block by any
    // path releases them -- after the pop that makes them unreachable.
    open_scope(v)
    var fs: [i64] = []
    for j in 0..ops.len() {
        let ic = konst(v, idx[j])
        let f = rt(v, "grasm_struct_get_at", [h, ic], R_BOX)
        let w = new_var(v, ir.TY_BOX)
        copy_to(v, w, f)
        forget_temp(v, f)
        own_var(v, w)
        fs.push(w)
    }
    drop_temp(v, h)
    let en = text_args(v, ename)
    rt(v, "grasm_handler_push", [en[0], en[1]], R_VOID)
    for j in 0..ops.len() {
        let on = text_args(v, ops[j])
        rt(v, "grasm_handler_op", [on[0], on[1], fs[j], fs[j]], R_VOID)
    }
    v.handlers += 1
    let x = lower_expr(info, v, ks[1])
    discard(v, x)
    v.handlers -= 1
    if v.open {
        rt(v, "grasm_handler_pop", [], R_VOID)
    }
    close_scope(v)
    -1
}

/// `E.op(a, b)`: the arguments, then the innermost handler's function for it
/// called with them.
fn lower_effectop(info: TirInfo, inout v: Vir, e: i64) -> i64 {
    let t = info.t
    let rk = kind_at(t, e, 1)
    if not held(rk) {
        bad(v, "outside the subset: an effect operation answering {ty_text(t, e, 1)} {span_of(t, e)}")
        return -1
    }
    var args: [i64] = []
    for a in sexp.kids(t, e) {
        if not held(kind_at(t, a, 1)) {
            bad(v, "outside the subset: an effect operation's argument of type {ty_text(t, a, 1)} {span_of(t, e)}")
            return -1
        }
        args.push(value_of(info, v, a))
    }
    let en = text_args(v, sexp.word(t, e, 3))
    let on = text_args(v, sexp.word(t, e, 4))
    // Borrowed: the `with` that installed it holds it.
    let f = rt(v, "grasm_handler_lookup", [en[0], en[1], on[0], on[1]], R_WORD)
    v.vty[f] = ir.TY_BOX
    call_value(v, f, args, rk)
}

// ----- references ------------------------------------------------------------------
//
// A `ref T` is one word ([T-REF-GENERATIONAL]): the runtime's shared heap
// holds the value, boxed, and the word names its slot and generation. It
// owns nothing, so it is copied like an integer. Reading through it --
// `r.value`, a field of what it points at, a `match` on it -- asks the heap
// for an owned copy of the box (`grasm_ref_get`, which panics on a stale
// reference) and reads that, as the Cranelift build does. A write through it
// lands in the heap: the referent is made the slot's only holder
// (`grasm_ref_make_unique`) and changed in place, or replaced whole
// (`grasm_ref_set`), so every holder of the reference sees it.

/// Whether type element `x` is a reference.
fn is_ref_te(t: TirTree, x: i64) -> bool {
    ty_head(t, x) == "ref"
}

/// What `x`, of type element `te`, points at, through as many references as
/// `te` has: the referent as a value (owned when boxed) and its type
/// element. Anything that is not a reference is answered as it is.
fn through_refs(inout v: Vir, t: TirTree, x: i64, te: i64) -> (i64, i64) {
    var cur = x
    var cte = te
    while is_ref_te(t, cte) {
        let inner = sexp.at(t, cte, 1)
        let b = rt(v, "grasm_ref_get", [cur], R_BOX)
        cur = unbox_kind(v, b, ty_kind(t, inner))
        cte = inner
    }
    (cur, cte)
}

/// `r.value`: the referent itself, read through the shared heap.
fn lower_deref(info: TirInfo, inout v: Vir, e: i64) -> i64 {
    let t = info.t
    let k = kind_at(t, e, 1)
    let inner = sexp.kids(t, e)[0]
    if not held(k) or not is_ref_te(t, ty_el(t, inner, 1)) {
        bad(v, "outside the subset: a `deref` of type {ty_text(t, e, 1)} {span_of(t, e)}")
        return konst(v, 0)
    }
    let r = value_of(info, v, inner)
    let (x, _te) = through_refs(v, t, r, ty_el(t, inner, 1))
    x
}

/// `T{ ..b, f: x }`: the base first, as it is written ([E-ORDER-LTR]), then
/// each field in the order written, set into it by the runtime's
/// copy-on-write setter -- the Cranelift build's `eval_struct_lit` -- so the
/// base itself is left as it was ([E-VALUE-SEMANTICS]).
fn lower_struct_update(info: TirInfo, inout v: Vir, e: i64, base: i64) -> i64 {
    let t = info.t
    let x = ty_el(t, e, 1)
    let body = type_body(info, x)
    let args = named_args(t, x)
    for fd in sexp.kids(t, body) {
        if not held(field_kind(t, sexp.at(t, fd, 2), args)) {
            bad(v, "outside the subset: struct `{sexp.word(t, x, 1)}` has a field of a type this part does not hold")
            return konst(v, 0)
        }
    }
    var s = value_of(info, v, sexp.kids(t, base)[0])
    for f in sexp.kids(t, e) {
        if sexp.kw(t, f) != "field" {
            continue
        }
        let i = sexp.word(t, f, 1).parse_int() ?? 0
        let fd = sexp.kids(t, body)[i]
        let k = field_kind(t, sexp.at(t, fd, 2), args)
        if not held(k) {
            bad(v, "outside the subset: struct `{sexp.word(t, x, 1)}` has a field of a type this part does not hold")
            return s
        }
        let fx = value_of(info, v, sexp.at(t, f, 2))
        let b = box_kind(v, fx, k)
        forget_temp(v, b)
        forget_temp(v, s)
        let ic = konst(v, i)
        s = rt(v, "grasm_struct_set_field_at", [s, ic, b], R_BOX)
    }
    s
}

/// `s.f`: a scalar field's bits, or a boxed field's value retained. A field
/// of what a reference points at is read through it.
fn lower_field(info: TirInfo, inout v: Vir, e: i64) -> i64 {
    let t = info.t
    let k = kind_at(t, e, 1)
    if not held(k) {
        bad(v, "outside the subset: a field of type {ty_text(t, e, 1)} {span_of(t, e)}")
        return konst(v, 0)
    }
    let recv = sexp.kids(t, e)[0]
    var rte = ty_el(t, recv, 1)
    while is_ref_te(t, rte) {
        rte = sexp.at(t, rte, 1)
    }
    if ty_head(t, rte) != "named" or not held(ty_kind(t, ty_el(t, recv, 1))) {
        bad(v, "outside the subset: a field of {ty_text(t, recv, 1)} {span_of(t, e)}")
        return konst(v, 0)
    }
    let s0 = value_of(info, v, recv)
    let (s, _ste) = through_refs(v, t, s0, ty_el(t, recv, 1))
    let ic = konst(v, sexp.word(t, e, 3).parse_int() ?? 0)
    var r = -1
    if ir.ty_boxed(k) {
        r = rt(v, "grasm_struct_get_at", [s, ic], R_BOX)
    } else {
        let w = rt(v, "grasm_struct_scalar_at", [s, ic], R_WORD)
        r = word_as(v, w, k)
    }
    drop_temp(v, s)
    r
}

/// The variant node's name and field types, from the sum's declaration.
fn variant_decl(info: TirInfo, x: i64, idx: i64) -> i64 {
    let t = info.t
    let body = type_body(info, x)
    if body < 0 or sexp.kw(t, body) != "sum" {
        return -1
    }
    let vs = sexp.kids(t, body)
    if idx < 0 or idx >= vs.len() {
        return -1
    }
    vs[idx]
}

/// The name a variant of type `x` carries as its type: `Option`, or the
/// sum's name, or its instantiation's.
fn variant_type_name(t: TirTree, x: i64) -> str {
    if sexp.word(t, x, 1) == "Option" {
        return "Option"
    }
    type_key(t, x)
}

/// `T.V(a, b)`: each field boxed by its declared type, then the variant.
fn lower_variant(info: TirInfo, inout v: Vir, e: i64) -> i64 {
    let t = info.t
    let x = ty_el(t, e, 1)
    let idx = sexp.word(t, e, 4).parse_int() ?? -1
    let vd = variant_decl(info, x, idx)
    if vd < 0 {
        bad(v, "outside the subset: a variant of {ty_text(t, e, 1)} {span_of(t, e)}")
        return konst(v, 0)
    }
    let args = named_args(t, x)
    let fdecls = sexp.kids(t, vd)
    let ks = sexp.kids(t, e)
    var boxes: [i64] = []
    for j in 0..ks.len() {
        let k = field_kind(t, sexp.at(t, fdecls[j], 2), args)
        if not held(k) {
            bad(v, "outside the subset: a variant field of a type this part does not hold {span_of(t, e)}")
            return konst(v, 0)
        }
        let xv = value_of(info, v, ks[j])
        boxes.push(box_kind(v, xv, k))
    }
    let tn = text_args(v, variant_type_name(t, x))
    let vn = text_args(v, sexp.word(t, vd, 1))
    for b in boxes {
        forget_temp(v, b)
    }
    if boxes.len() == 1 {
        return rt(v, "grasm_variant_new1", [tn[0], tn[1], vn[0], vn[1], boxes[0]], R_BOX)
    }
    if boxes.len() == 2 {
        return rt(v, "grasm_variant_new2", [tn[0], tn[1], vn[0], vn[1], boxes[0], boxes[1]], R_BOX)
    }
    let r = rt(v, "grasm_variant_new", [tn[0], tn[1], vn[0], vn[1]], R_BOX)
    for b in boxes {
        rt(v, "grasm_variant_push", [r, b], R_VOID)
    }
    r
}

fn out_text(inout v: Vir, s: str) {
    let args = text_args(v, s)
    callrt(v, ir.RT_OUT_TEXT, args)
}

/// A frame slot for variable `w`, the home of an `inout` argument.
fn slot_for(inout v: Vir, w: i64) -> i64 {
    for k in 0..v.slot_var.len() {
        if v.slot_var[k] == w {
            return k
        }
    }
    v.slot_var.push(w)
    v.nslots += 1
    v.nslots - 1
}

// ----- reading TIR ---------------------------------------------------------------

/// The type written as element `i` of node `e`.
fn ty_at(t: TirTree, e: i64, i: i64) -> i64 {
    if i >= t.count[e] {
        return ir.TY_OTHER
    }
    let x = sexp.at(t, e, i)
    if t.kind[x] != 0 {
        return ir.TY_OTHER
    }
    ir.ty_of_name(t.text[x])
}

/// The type element `i` of node `e` (an atom or a list), or -1.
fn ty_el(t: TirTree, e: i64, i: i64) -> i64 {
    if i >= t.count[e] {
        return -1
    }
    sexp.at(t, e, i)
}

/// What the lowering holds a value of type element `x` as: a scalar's
/// `TY_*`, `TY_BOX` for a boxed type the subset handles, or `TY_OTHER`.
fn ty_kind(t: TirTree, x: i64) -> i64 {
    if x < 0 {
        return ir.TY_OTHER
    }
    if t.kind[x] == 0 {
        let s = ir.ty_of_name(t.text[x])
        if s != ir.TY_OTHER {
            return s
        }
        // A range held as a value is the runtime's boxed `Range`, its bounds
        // and whether it is inclusive (`grasm_range_new`).
        // So are the builders ([L-LIB-BUILDER]): growable text and bytes.
        if t.text[x] == "str" or t.text[x] == "bytes" or t.text[x] == "range" or t.text[x] == "strbuilder" or t.text[x] == "bytebuilder" {
            return ir.TY_BOX
        }
        return ir.TY_OTHER
    }
    if t.kind[x] != 2 or t.count[x] == 0 {
        return ir.TY_OTHER
    }
    let k = sexp.kw(t, x)
    if k == "list" {
        return if ty_kind(t, sexp.at(t, x, 1)) == ir.TY_OTHER { ir.TY_OTHER } else { ir.TY_BOX }
    }
    if k == "fallible" {
        // A whole result, `Ok` or `Err`, as a box. Its error half may be
        // `never` (nothing raises it) or a union of error types.
        let e = sexp.at(t, x, 2)
        let ek = if t.kind[e] == 0 and t.text[e] == "never" { ir.TY_NEVER } else { ty_kind(t, e) }
        if ty_kind(t, sexp.at(t, x, 1)) == ir.TY_OTHER or ek == ir.TY_OTHER {
            return ir.TY_OTHER
        }
        return ir.TY_BOX
    }
    if k == "union" {
        for j in 1..t.count[x] {
            if not ir.ty_boxed(ty_kind(t, sexp.at(t, x, j))) {
                return ir.TY_OTHER
            }
        }
        return ir.TY_BOX
    }
    if k == "tuple" and t.count[x] == 1 {
        // `()` written as a tuple of nothing is the unit value.
        return ir.TY_UNIT
    }
    if k == "ref" {
        // A reference to a held value: the word naming its slot.
        return if ty_kind(t, sexp.at(t, x, 1)) == ir.TY_OTHER { ir.TY_OTHER } else { ir.TY_REF }
    }
    if k == "fn" {
        // A function value, `(fn (P..) R row)`: the runtime's boxed `Fn`, its
        // code and its captures, when what it takes and answers are held.
        if fn_sig_held(t, x) {
            return ir.TY_BOX
        }
        return ir.TY_OTHER
    }
    if k == "named" and sexp.word(t, x, 1) == "Chan" {
        // A channel is a handle into the runtime's table of them: a word, as
        // the Cranelift build holds it ([E-CHANNEL]).
        return ir.TY_I64
    }
    if k == "tuple" or k == "map" or k == "named" {
        let from = if k == "named" { 2 } else { 1 }
        for j in from..t.count[x] {
            if ty_kind(t, sexp.at(t, x, j)) == ir.TY_OTHER {
                return ir.TY_OTHER
            }
        }
        return ir.TY_BOX
    }
    ir.TY_OTHER
}

/// Whether a function type `(fn (P..) R row)` takes and answers held types.
fn fn_sig_held(t: TirTree, x: i64) -> bool {
    if t.count[x] < 3 {
        return false
    }
    let ps = sexp.at(t, x, 1)
    if t.kind[ps] != 2 {
        return false
    }
    for j in 0..t.count[ps] {
        if not held(ty_kind(t, sexp.at(t, ps, j))) {
            return false
        }
    }
    held(ty_kind(t, sexp.at(t, x, 2)))
}

/// A function type's parameter types and its result type.
fn fn_params(t: TirTree, x: i64) -> [i64] {
    var out: [i64] = []
    let ps = sexp.at(t, x, 1)
    for j in 0..t.count[ps] {
        out.push(sexp.at(t, ps, j))
    }
    out
}

fn fn_ret(t: TirTree, x: i64) -> i64 {
    sexp.at(t, x, 2)
}

/// The kind of element `i` of node `e`'s type.
fn kind_at(t: TirTree, e: i64, i: i64) -> i64 {
    ty_kind(t, ty_el(t, e, i))
}

/// Whether element `i` is a type the subset holds: a scalar or a box.
fn held(k: i64) -> bool {
    ir.ty_scalar(k) or ir.ty_boxed(k)
}

/// The type written as element `i`, as TIR spells it, for a message.
fn ty_text(t: TirTree, e: i64, i: i64) -> str {
    if i >= t.count[e] {
        return "?"
    }
    let x = sexp.at(t, e, i)
    if t.kind[x] == 2 {
        return "({sexp.word(t, x, 0)} ...)"
    }
    t.text[x]
}

/// An expression node's type: its element 1.
fn node_ty(t: TirTree, e: i64) -> i64 {
    ty_at(t, e, 1)
}

/// Where a node is, for a message: its first `@start:end`.
/// Where a node's span starts and ends (`@start:end`), or -1 when it has none.
fn span_start(t: TirTree, e: i64) -> i64 {
    let w = span_of(t, e)
    if w == "" {
        return -1
    }
    let parts = w.substr(1, w.len() - 1).split(":")
    parts[0].parse_int() ?? -1
}

fn span_end(t: TirTree, e: i64) -> i64 {
    let w = span_of(t, e)
    if w == "" {
        return -1
    }
    let parts = w.substr(1, w.len() - 1).split(":")
    if parts.len() < 2 {
        return -1
    }
    parts[1].parse_int() ?? -1
}

fn span_of(t: TirTree, e: i64) -> str {
    if t.kind[e] != 2 {
        return ""
    }
    for i in 0..t.count[e] {
        let w = sexp.word(t, e, i)
        if w.starts_with("@") {
            return w
        }
    }
    ""
}

fn is_stmt(k: str) -> bool {
    k == "let" or k == "lettuple" or k == "assign" or k == "return" or k == "break" or k == "continue" or k == "while" or k == "for" or k == "parallel" or k == "spawn" or k == "with"
}

fn tvar_of(inout v: Vir, id: i64) -> i64 {
    match v.tvar.get(id) {
        Some(x) -> x
        None -> {
            bad(v, "local {id} is read before it is bound")
            let x = new_var(v, ir.TY_I64)
            v.tvar.set(id, x)
            x
        }
    }
}

/// The variable a TIR binding site names, made on first sight: the
/// alternatives of an or-pattern bind the same TIR variable. `te` is its
/// type element, for an assignment through it to find its way down.
fn bind_tvar(inout v: Vir, id: i64, ty: i64, te: i64) -> i64 {
    v.tvty.set(id, te)
    match v.tvar.get(id) {
        Some(x) -> x
        None -> {
            let x = new_var(v, ty)
            v.tvar.set(id, x)
            x
        }
    }
}

// ----- expressions ---------------------------------------------------------------

/// The value of an expression, as a variable; 0 for one that has none.
fn value_of(info: TirInfo, inout v: Vir, e: i64) -> i64 {
    let x = lower_expr(info, v, e)
    if x >= 0 {
        x
    } else {
        zero_like(v, kind_at(info.t, e, 1))
    }
}

/// Lowers an expression or a statement. The answer is the variable holding
/// its value, or -1 when it has none (unit, a statement, a `never`).
fn lower_expr(info: TirInfo, inout v: Vir, e: i64) -> i64 {
    let t = info.t
    if t.kind[e] != 2 {
        bad(v, "outside the subset: a bare atom where an expression was expected")
        return -1
    }
    let outer = v.cur_span
    let at = span_start(t, e)
    if at >= 0 {
        v.cur_span = at
    }
    let x = lower_expr_at(info, v, e)
    v.cur_span = outer
    x
}

fn lower_expr_at(info: TirInfo, inout v: Vir, e: i64) -> i64 {
    let t = info.t
    let k = sexp.kw(t, e)
    match k {
        "int" -> lower_int(info, v, e)
        "float" -> lower_float(info, v, e)
        "bool" -> konst(v, if sexp.word(t, e, 3) == "true" { 1 } else { 0 })
        "unit" -> -1
        "local" -> lower_local(info, v, e)
        "binary" -> lower_binary(info, v, e)
        "unary" -> lower_unary(info, v, e)
        "call" -> lower_call(info, v, e)
        "const" -> lower_const_read(info, v, e)
        "builtin" -> lower_builtin(info, v, e)
        "if" -> lower_if(info, v, e)
        "block" -> lower_block(info, v, e)
        "blockexpr" -> {
            if not held(kind_at(t, e, 1)) {
                bad(v, "outside the subset: a block of type {ty_text(t, e, 1)} {span_of(t, e)}")
            }
            lower_block(info, v, sexp.kids(t, e)[0])
        }
        "str" -> lower_str(info, v, e)
        "list" -> lower_list(info, v, e)
        "index" -> lower_index(info, v, e)
        "tuple" -> lower_tuple(info, v, e)
        "tuplefield" -> lower_tuplefield(info, v, e)
        "lettuple" -> lower_lettuple(info, v, e)
        "struct" -> lower_struct(info, v, e)
        "field" -> lower_field(info, v, e)
        "variant" -> lower_variant(info, v, e)
        "try" -> lower_try(info, v, e)
        "method" -> lower_method(info, v, e)
        "maplit" -> lower_maplit(info, v, e)
        "wrapok" -> lower_wrapok(info, v, e)
        "match" -> lower_match(info, v, e)
        "let" -> lower_let(info, v, e)
        "assign" -> lower_assign(info, v, e)
        "return" -> lower_return(info, v, e)
        "break" -> {
            if v.loop_brk.is_empty() {
                bad(v, "`break` outside a loop")
            } else {
                let n = v.loop_brk.len() - 1
                pop_handlers_above(v, v.loop_handlers[n])
                release_from(v, v.loop_owned[n], v.loop_temps[n])
                term_jump(v, v.loop_brk[n])
            }
            -1
        }
        "continue" -> {
            if v.loop_cont.is_empty() {
                bad(v, "`continue` outside a loop")
            } else {
                let n = v.loop_cont.len() - 1
                pop_handlers_above(v, v.loop_handlers[n])
                release_from(v, v.loop_owned[n], v.loop_temps[n])
                term_jump(v, v.loop_cont[n])
            }
            -1
        }
        "while" -> lower_while(info, v, e)
        "for" -> lower_for(info, v, e)
        "closure" -> lower_closure(info, v, e)
        "fnref" -> lower_fnref(info, v, e)
        "callvalue" -> lower_callvalue(info, v, e)
        "range" -> lower_range_value(info, v, e)
        "deref" -> lower_deref(info, v, e)
        "with" -> lower_with(info, v, e)
        "effectop" -> lower_effectop(info, v, e)
        "parallel" -> lower_parallel(info, v, e)
        "spawn" -> lower_spawn(info, v, e)
        "callextern" -> lower_callextern(info, v, e)
        "unsafe" -> {
            // What may be done inside it the checker has settled
            // ([T-EXTERN-VALUE]); compiled as the block it is.
            if not held(kind_at(t, e, 1)) {
                bad(v, "outside the subset: an `unsafe` block of type {ty_text(t, e, 1)} {span_of(t, e)}")
            }
            lower_block(info, v, sexp.kids(t, e)[0])
        }
        "region" -> {
            // A block whose allocations the checker proved die with it
            // ([T-REGION]): compiled as the block it is.
            if not held(kind_at(t, e, 1)) {
                bad(v, "outside the subset: a region of type {ty_text(t, e, 1)} {span_of(t, e)}")
            }
            lower_block(info, v, sexp.kids(t, e)[0])
        }
        _ -> {
            bad(v, "outside the subset: `{k}` {span_of(t, e)}")
            -1
        }
    }
}

fn lower_int(info: TirInfo, inout v: Vir, e: i64) -> i64 {
    let t = info.t
    let ty = node_ty(t, e)
    if not ir.ty_int(ty) {
        bad(v, "outside the subset: an integer of type {ty_text(t, e, 1)} {span_of(t, e)}")
        return konst(v, 0)
    }
    let text = sexp.word(t, e, 3)
    if ty == ir.TY_U64 {
        let u = text.parse_u64() ?? 0
        return konst(v, u.as_i64())
    }
    konst(v, text.parse_int() ?? 0)
}

/// A float literal: TIR writes its bits, `0x` and sixteen hex digits, so the
/// double is exact by construction.
fn lower_float(info: TirInfo, inout v: Vir, e: i64) -> i64 {
    let t = info.t
    let text = sexp.word(t, e, 3)
    let bits = hex_bits(text)
    if bits.is_none() or node_ty(t, e) != ir.TY_F64 {
        bad(v, "a float literal written `{text}` {span_of(t, e)}")
        return fkonst(v, 0)
    }
    fkonst(v, bits ?? 0)
}

/// `0x` and sixteen hex digits as the 64 bits they spell.
pub fn hex_bits(text: str) -> Option[i64] {
    if text.len() != 18 or not text.starts_with("0x") {
        return None
    }
    // Two halves, each in range of a non-negative `i64`.
    let hi = text.substr(2, 8).parse_int_base(16) ?? -1
    let lo = text.substr(10, 8).parse_int_base(16) ?? -1
    if hi < 0 or lo < 0 {
        return None
    }
    Some(hi.shl(32).bit_or(lo))
}

/// A local read. The value is copied out, so a later assignment to the
/// local -- an `inout` argument written back between two operands, say --
/// does not change what was read.
fn lower_local(info: TirInfo, inout v: Vir, e: i64) -> i64 {
    let t = info.t
    let ty = kind_at(t, e, 1)
    if not held(ty) {
        bad(v, "outside the subset: a local of type {ty_text(t, e, 1)} {span_of(t, e)}")
        return -1
    }
    let w = tvar_of(v, sexp.word(t, e, 3).parse_int() ?? -1)
    if ir.ty_boxed(ty) {
        return retain_copy(v, w)
    }
    let d = new_var(v, ty)
    copy_to(v, d, w)
    d
}

/// Whether `x` is one of the owned temporaries.
fn is_temp(v: Vir, x: i64) -> bool {
    if x < 0 {
        return false
    }
    var k = v.temps.len() - 1
    while k >= 0 {
        if v.temps[k] == x {
            return true
        }
        k -= 1
    }
    false
}

/// A value nobody wants: released if it is an owned box.
fn discard(inout v: Vir, x: i64) {
    if is_temp(v, x) {
        drop_temp(v, x)
    }
}

/// Wraps a result to its type's width ([T-INT-FIXED]); `i64` and `u64` wrap
/// by themselves.
fn wrap(inout v: Vir, ty: i64, x: i64) -> i64 {
    if ty == ir.TY_I8 {
        op1(v, ir.M_SEXT8, x)
    } else if ty == ir.TY_I16 {
        op1(v, ir.M_SEXT16, x)
    } else if ty == ir.TY_I32 {
        op1(v, ir.M_SEXT32, x)
    } else if ty == ir.TY_U8 {
        op1(v, ir.M_UEXT8, x)
    } else if ty == ir.TY_U16 {
        op1(v, ir.M_UEXT16, x)
    } else if ty == ir.TY_U32 {
        op1(v, ir.M_UEXT32, x)
    } else {
        x
    }
}

/// Panics through `sym` when `x` is zero ([E-DIV-ZERO]).
fn zero_check(inout v: Vir, x: i64, sym: i64) {
    let z = konst(v, 0)
    let c = icmp(v, ir.CC_EQ, x, z)
    let bad_b = new_block(v)
    let ok_b = new_block(v)
    term_brif(v, c, bad_b, ok_b)
    switch_to(v, bad_b)
    callrt(v, sym, [])
    switch_to(v, ok_b)
}

/// `a <op> b` at type `ty`, with the language's wrapping and its panics.
fn arith(inout v: Vir, op: str, ty: i64, a: i64, b: i64) -> i64 {
    let u = ty == ir.TY_U64 or ty == ir.TY_U8 or ty == ir.TY_U16 or ty == ir.TY_U32
    match op {
        "add" -> {
            let r = op2(v, ir.M_ADD, a, b)
            wrap(v, ty, r)
        }
        "sub" -> {
            let r = op2(v, ir.M_SUB, a, b)
            wrap(v, ty, r)
        }
        "mul" -> {
            let r = op2(v, ir.M_MUL, a, b)
            wrap(v, ty, r)
        }
        "div" -> {
            zero_check(v, b, ir.RT_PANIC_DIV_ZERO)
            let r = op2(v, if u { ir.M_UDIV } else { ir.M_SDIV }, a, b)
            wrap(v, ty, r)
        }
        "rem" -> {
            zero_check(v, b, ir.RT_PANIC_REM_ZERO)
            let r = op2(v, if u { ir.M_UREM } else { ir.M_SREM }, a, b)
            wrap(v, ty, r)
        }
        _ -> {
            bad(v, "outside the subset: operator `{op}`")
            a
        }
    }
}

/// `a <op> b` on doubles: the four operations as instructions, `%` and `^`
/// by the runtime (the Cranelift build's `grasm_f64_rem` and
/// `grasm_pow_f64`), and the comparisons IEEE's -- a NaN is unordered, so
/// it makes every comparison false but `!=`.
fn farith(inout v: Vir, op: str, a: i64, b: i64, where_: str) -> i64 {
    match op {
        "add" -> fop2(v, ir.M_FADD, a, b)
        "sub" -> fop2(v, ir.M_FSUB, a, b)
        "mul" -> fop2(v, ir.M_FMUL, a, b)
        "div" -> fop2(v, ir.M_FDIV, a, b)
        "rem" -> rt(v, "grasm_f64_rem", [a, b], R_F64)
        "pow" -> rt(v, "grasm_pow_f64", [a, b], R_F64)
        _ -> {
            let cc = cmp_cc(op, false)
            if cc < 0 {
                bad(v, "outside the subset: `{op}` on f64 {where_}")
                return fkonst(v, 0)
            }
            fcmp(v, cc, a, b)
        }
    }
}

fn cmp_cc(op: str, unsigned: bool) -> i64 {
    match op {
        "eq" -> ir.CC_EQ
        "ne" -> ir.CC_NE
        "lt" -> if unsigned { ir.CC_ULT } else { ir.CC_SLT }
        "le" -> if unsigned { ir.CC_ULE } else { ir.CC_SLE }
        "gt" -> if unsigned { ir.CC_UGT } else { ir.CC_SGT }
        "ge" -> if unsigned { ir.CC_UGE } else { ir.CC_SGE }
        _ -> -1
    }
}

fn lower_binary(info: TirInfo, inout v: Vir, e: i64) -> i64 {
    let t = info.t
    let op = sexp.word(t, e, 3)
    var ot = ty_at(t, e, 4)
    let ks = sexp.kids(t, e)
    // An integer literal on the left of an `f64` ([E-NUM-PROMOTE], `3 + f`)
    // is a `float` node in TIR, but the operator is still written with the
    // literal's `i64` (`add i64`): the operands' own types are what decide.
    if ir.ty_int(ot) and ks.len() == 2 and kind_at(t, ks[0], 1) == ir.TY_F64 and kind_at(t, ks[1], 1) == ir.TY_F64 {
        ot = ir.TY_F64
    }
    if op == "and" or op == "or" {
        let a = value_of(info, v, ks[0])
        let r = new_var(v, ir.TY_BOOL)
        copy_to(v, r, a)
        let rhs_b = new_block(v)
        let join = new_block(v)
        if op == "and" {
            term_brif(v, a, rhs_b, join)
        } else {
            term_brif(v, a, join, rhs_b)
        }
        switch_to(v, rhs_b)
        let x = value_of(info, v, ks[1])
        copy_to(v, r, x)
        term_jump(v, join)
        switch_to(v, join)
        return r
    }
    if op == "coalesce" {
        return lower_coalesce(info, v, e)
    }
    if ir.ty_boxed(kind_at(t, e, 4)) {
        return lower_boxed_binary(info, v, e, op, ty_el(t, e, 4))
    }
    if ir.ty_fp(ot) {
        let a = value_of(info, v, ks[0])
        let b = value_of(info, v, ks[1])
        return farith(v, op, a, b, span_of(t, e))
    }
    if ot == ir.TY_UNIT and (op == "eq" or op == "ne") {
        // `()` has one value: both sides computed, for what they do, and
        // the answer known.
        let a = value_of(info, v, ks[0])
        let b = value_of(info, v, ks[1])
        discard(v, a)
        discard(v, b)
        return konst(v, if op == "eq" { 1 } else { 0 })
    }
    if kind_at(t, e, 4) == ir.TY_REF and (op == "eq" or op == "ne") {
        // [T-REF-EQ]: identity -- the same slot and the same generation,
        // which is the same word.
        let a = value_of(info, v, ks[0])
        let b = value_of(info, v, ks[1])
        return icmp(v, if op == "eq" { ir.CC_EQ } else { ir.CC_NE }, a, b)
    }
    let cc = cmp_cc(op, ir.ty_unsigned(ot) or ot == ir.TY_BOOL)
    if cc >= 0 {
        if not (ir.ty_int(ot) or ot == ir.TY_BOOL) {
            bad(v, "outside the subset: `{op}` on {ty_text(t, e, 4)} {span_of(t, e)}")
            return konst(v, 0)
        }
        let a = value_of(info, v, ks[0])
        let b = value_of(info, v, ks[1])
        return icmp(v, cc, a, b)
    }
    if not ir.ty_int(ot) {
        bad(v, "outside the subset: `{op}` on {ty_text(t, e, 4)} {span_of(t, e)}")
        return konst(v, 0)
    }
    if op == "pow" {
        let a = value_of(info, v, ks[0])
        let b = value_of(info, v, ks[1])
        // `u64` by its own runtime function, whose exponent is never
        // negative ([T-U64]); a narrower width as `i64` -- a negative
        // exponent panics -- wrapped to the width after, as every other
        // operator at a width is, and as the Cranelift build does.
        if ot == ir.TY_U64 {
            return rt(v, "grasm_pow_u64", [a, b], R_WORD)
        }
        let r = callrt(v, ir.RT_POW_I64, [a, b])
        return wrap(v, ot, r)
    }
    if op != "add" and op != "sub" and op != "mul" and op != "div" and op != "rem" {
        bad(v, "outside the subset: operator `{op}` {span_of(t, e)}")
        return konst(v, 0)
    }
    let a = value_of(info, v, ks[0])
    let b = value_of(info, v, ks[1])
    arith(v, op, ot, a, b)
}

/// Whether type element `x` is the atom `name`.
fn is_ty(t: TirTree, x: i64, name: str) -> bool {
    x >= 0 and t.kind[x] == 0 and t.text[x] == name
}

/// The keyword of a compound type element (`list`, `named`, ...), or "".
fn ty_head(t: TirTree, x: i64) -> str {
    if x < 0 or t.kind[x] != 2 {
        return ""
    }
    sexp.kw(t, x)
}

/// An operator on boxed operands, both computed (owned) first and released
/// after: the Cranelift build's `binop_values_wide`.
fn lower_boxed_binary(info: TirInfo, inout v: Vir, e: i64, op: str, ot: i64) -> i64 {
    let t = info.t
    let ks = sexp.kids(t, e)
    let is_str = is_ty(t, ot, "str")
    let cmp = op == "lt" or op == "le" or op == "gt" or op == "ge"
    if op == "add" and is_str {
        // The left operand is owned, so its reference can be the result's.
        let a = value_of(info, v, ks[0])
        let b = value_of(info, v, ks[1])
        forget_temp(v, a)
        let r = rt(v, "grasm_str_append", [a, b], R_BOX)
        drop_temp(v, b)
        return r
    }
    if op == "add" and ty_head(t, ot) == "list" {
        let a = value_of(info, v, ks[0])
        let b = value_of(info, v, ks[1])
        let r = rt(v, "grasm_list_concat", [a, b], R_BOX)
        drop_temp(v, a)
        drop_temp(v, b)
        return r
    }
    if op == "eq" or op == "ne" {
        let a = value_of(info, v, ks[0])
        let b = value_of(info, v, ks[1])
        let c = rt(v, if is_str { "grasm_str_eq" } else { "grasm_val_eq" }, [a, b], R_BOOL8)
        drop_temp(v, a)
        drop_temp(v, b)
        if op == "ne" {
            let one = konst(v, 1)
            return op2(v, ir.M_XOR, c, one)
        }
        return c
    }
    if cmp and (is_str or ty_head(t, ot) == "tuple") {
        let a = value_of(info, v, ks[0])
        let b = value_of(info, v, ks[1])
        let c = rt(v, if is_str { "grasm_str_cmp" } else { "grasm_val_cmp" }, [a, b], R_WORD)
        drop_temp(v, a)
        drop_temp(v, b)
        let z = konst(v, 0)
        return icmp(v, cmp_cc(op, false), c, z)
    }
    bad(v, "outside the subset: `{op}` on {ty_text(t, e, 4)} {span_of(t, e)}")
    konst(v, 0)
}

fn lower_unary(info: TirInfo, inout v: Vir, e: i64) -> i64 {
    let t = info.t
    let op = sexp.word(t, e, 3)
    let ot = ty_at(t, e, 4)
    let x = value_of(info, v, sexp.kids(t, e)[0])
    if op == "not" and ot == ir.TY_BOOL {
        let one = konst(v, 1)
        return op2(v, ir.M_XOR, x, one)
    }
    if op == "neg" and ir.ty_int(ot) {
        let n = op1(v, ir.M_NEG, x)
        return wrap(v, ot, n)
    }
    if op == "neg" and ir.ty_fp(ot) {
        // The sign flipped, as Cranelift's `fneg`: `-0.0` from `0.0`.
        return fop1(v, ir.M_FNEG, x)
    }
    bad(v, "outside the subset: `{op}` on {ty_text(t, e, 4)} {span_of(t, e)}")
    x
}

/// The parameters a callable declares: `(param mode id "name" T)` each.
fn params_of(info: TirInfo, c: i64) -> [i64] {
    if info.c_const[c] {
        return []
    }
    let t = info.t
    let ks = sexp.kids(t, info.c_elem[c])
    sexp.kids(t, ks[0])
}

fn returns_value(info: TirInfo, c: i64) -> bool {
    let t = info.t
    let e = info.c_elem[c]
    if fn_err(info, c) >= 0 {
        // A tag, or a boxed result.
        return true
    }
    let ty = if info.c_const[c] { ty_at(t, e, 2) } else { ty_at(t, e, 4) }
    ty != ir.TY_UNIT and ty != ir.TY_NEVER
}

/// A call of a function that can fail, as a value: a split one's tag and
/// word boxed into a result (`grasm_result_box`), as the Cranelift build
/// does wherever the call is not the operand of `try`.
fn lower_call(info: TirInfo, inout v: Vir, e: i64) -> i64 {
    let t = info.t
    let (r, slot, c) = call_parts(info, v, e)
    if slot < 0 {
        return r
    }
    let w = new_var(v, ir.TY_I64)
    let a = slot_addr(v, slot)
    emit(v, ir.M_LOAD, w, a, -1, 0)
    let kc = konst(v, result_kind(t, sexp.at(t, info.c_elem[c], 4)))
    rt(v, "grasm_result_box", [r, w, kc], R_BOX)
}

/// The hidden first argument of a function that can reach itself: this
/// function's own floor when it has one, else the runtime's, asked here --
/// which happens once per entry into a recursion, not once per level.
fn floor_arg(inout v: Vir) -> i64 {
    if v.floor >= 0 {
        return v.floor
    }
    let sp = new_var(v, ir.TY_I64)
    emit(v, ir.M_GETSP, sp, -1, -1, 0)
    callrt(v, ir.RT_STACK_FLOOR, [sp])
}

/// A call: the value it answers, and for a callee returning by the
/// split-result convention, the frame slot its word was written to (its tag
/// is the value then), else -1; and the callee.
fn call_parts(info: TirInfo, inout v: Vir, e: i64) -> (i64, i64, i64) {
    let t = info.t
    let name = sexp.word(t, e, 3)
    let c = info.fn_ix.get(name) ?? -1
    if c < 0 {
        bad(v, "outside the subset: a call of `{name}`, which is not a function here {span_of(t, e)}")
        return (-1, -1, c)
    }
    let targs = sexp.at(t, e, 4)
    if t.count[targs] > 1 {
        bad(v, "outside the subset: a generic call of `{name}` {span_of(t, e)}")
    }
    let rty = kind_at(t, e, 1)
    if not held(rty) {
        bad(v, "outside the subset: a call of `{name}` answering {ty_text(t, e, 1)} {span_of(t, e)}")
    }
    let params = params_of(info, c)
    let ks = sexp.kids(t, e)
    if ks.len() != params.len() {
        bad(v, "a call of `{name}` with {ks.len()} arguments for {params.len()} parameters")
        return (-1, -1, c)
    }
    // Arguments left to right. An `inout` one is a frame slot the callee
    // reads and writes through its address: a local's value is stored in it
    // where the argument stands, and loaded back after the call; a place
    // inside something (`bump(s.xs)`) is read there -- moved out of its
    // container unless a later argument reads the same variable -- and
    // written back after the call, as the Cranelift build does.
    var vals: [i64] = []
    var homes: [i64] = []
    var slots: [i64] = []
    var places: [InoutPlace] = []
    for i in 0..ks.len() {
        let mode = sexp.word(t, params[i], 1)
        homes.push(-1)
        slots.push(-1)
        if mode != "inout" {
            vals.push(value_of(info, v, ks[i]))
            continue
        }
        let a = ks[i]
        if sexp.kw(t, a) == "local" {
            let w = tvar_of(v, sexp.word(t, a, 3).parse_int() ?? -1)
            let k = slot_for(v, w)
            let addr = slot_addr(v, k)
            store_at(v, addr, w)
            vals.push(addr)
            homes[i] = w
            slots[i] = k
            continue
        }
        let pl = inout_place(info, v, a, ks, i, ty_el(t, params[i], 4))
        if pl.slot < 0 {
            vals.push(-1)
            continue
        }
        vals.push(slot_addr(v, pl.slot))
        places.push(pl)
    }
    var args: [i64] = []
    if info.recursive[c] {
        args.push(floor_arg(v))
    }
    for x in vals {
        args.push(x)
    }
    // A split callee's word comes back through the last argument.
    var out_slot = -1
    if is_split(info, c) {
        out_slot = fresh_slot(v)
        args.push(slot_addr(v, out_slot))
    }
    // Each argument's reference goes to the callee, which owns its
    // parameters.
    for x in vals {
        if is_temp(v, x) {
            forget_temp(v, x)
        }
    }
    var r = call_fn(v, c, args, returns_value(info, c))
    if r >= 0 and out_slot < 0 and ir.ty_fp(rty) {
        // A double comes back in d0.
        v.vty[r] = ir.TY_F64
    }
    for i in 0..ks.len() {
        if slots[i] >= 0 {
            let addr = slot_addr(v, slots[i])
            load_into(v, homes[i], addr)
        }
    }
    for pl in places {
        write_back_place(info.t, v, pl)
    }
    if out_slot >= 0 {
        // The tag is a C `i8`.
        r = op1(v, ir.M_UEXT8, r)
        return (r, out_slot, c)
    }
    if r >= 0 and (ir.ty_boxed(rty) or fn_err(info, c) >= 0) {
        v.vty[r] = ir.TY_BOX
        own_temp(v, r)
    }
    (r, -1, c)
}

fn lower_const_read(info: TirInfo, inout v: Vir, e: i64) -> i64 {
    let t = info.t
    let name = sexp.word(t, e, 3)
    let c = info.const_ix.get(name) ?? -1
    if c < 0 {
        bad(v, "a read of `{name}`, which is not a constant {span_of(t, e)}")
        return -1
    }
    let k = kind_at(t, e, 1)
    if not held(k) {
        bad(v, "outside the subset: a constant of type {ty_text(t, e, 1)} {span_of(t, e)}")
        return -1
    }
    var args: [i64] = []
    if info.recursive[c] {
        args.push(floor_arg(v))
    }
    let r = call_fn(v, c, args, returns_value(info, c))
    if r >= 0 and ir.ty_boxed(k) {
        v.vty[r] = ir.TY_BOX
        own_temp(v, r)
    }
    if r >= 0 and ir.ty_fp(k) {
        v.vty[r] = ir.TY_F64
    }
    r
}

/// Writes one interpolated value as `print` does ([L-DISPLAY]); a boxed
/// one is written by the runtime's `display` and released.
fn out_value(inout v: Vir, x: i64, ty: i64, where_: str) {
    if ir.ty_boxed(ty) {
        rt(v, "grasm_out_val", [x], R_VOID)
        drop_temp(v, x)
    } else if ty == ir.TY_U64 {
        callrt(v, ir.RT_OUT_U64, [x])
    } else if ty == ir.TY_REF {
        // `ref#slot.generation`, as the interpreter writes one.
        rt(v, "grasm_out_ref", [x], R_VOID)
    } else if ir.ty_int(ty) {
        callrt(v, ir.RT_OUT_I64, [x])
    } else if ty == ir.TY_BOOL {
        callrt(v, ir.RT_OUT_BOOL, [x])
    } else if ir.ty_fp(ty) {
        rt(v, "grasm_out_f64", [x], R_VOID)
    } else if ty == ir.TY_UNIT {
        out_text(v, "()")
    } else {
        bad(v, "outside the subset: printing a value of this type {where_}")
    }
    ()
}

/// `print` and `eprint`. Every interpolated value is computed before
/// anything is written ([E-PRINT-ATOMIC]). `eprint` selects stderr before
/// evaluating, as the Cranelift build does.
fn lower_print(info: TirInfo, inout v: Vir, arg: i64, to_err: bool) {
    let t = info.t
    if to_err {
        let one = konst(v, 1)
        callrt(v, ir.RT_OUT_TO_STDERR, [one])
    }
    if sexp.kw(t, arg) == "str" {
        let pieces = sexp.kids(t, arg)
        var vals: [i64] = []
        var tys: [i64] = []
        for pc in pieces {
            if sexp.kw(t, pc) == "value" {
                let x = sexp.at(t, pc, 1)
                tys.push(kind_at(t, x, 1))
                vals.push(value_of(info, v, x))
            } else {
                tys.push(-1)
                vals.push(-1)
            }
        }
        for i in 0..pieces.len() {
            let pc = pieces[i]
            if sexp.kw(t, pc) == "text" {
                let s = sexp.word(t, pc, 1)
                if s != "" {
                    out_text(v, s)
                }
            } else {
                out_value(v, vals[i], tys[i], span_of(t, arg))
            }
        }
    } else {
        let ty = kind_at(t, arg, 1)
        let x = value_of(info, v, arg)
        out_value(v, x, ty, span_of(t, arg))
    }
    callrt(v, ir.RT_OUT_NL, [])
    if to_err {
        let zero = konst(v, 0)
        callrt(v, ir.RT_OUT_TO_STDERR, [zero])
    }
}

/// `panic(msg)`: a message of one piece of text goes to the runtime as
/// bytes; any other is computed as a string and handed over -- the
/// Cranelift build's two cases.
fn lower_panic(info: TirInfo, inout v: Vir, arg: i64) {
    let t = info.t
    if sexp.kw(t, arg) == "str" {
        let pieces = sexp.kids(t, arg)
        if pieces.len() == 1 and sexp.kw(t, pieces[0]) == "text" {
            let at = span_start(t, arg)
            if at >= 0 {
                v.cur_span = at
            }
            let args = text_args(v, sexp.word(t, pieces[0], 1))
            callrt(v, ir.RT_PANIC_MSG, args)
            return
        }
    }
    if sexp.word(t, arg, 1) != "str" {
        bad(v, "outside the subset: a panic message of type {ty_text(t, arg, 1)} {span_of(t, arg)}")
        return
    }
    let s = value_of(info, v, arg)
    callrt(v, ir.RT_PANIC_VALUE, [s])
}

fn lower_builtin(info: TirInfo, inout v: Vir, e: i64) -> i64 {
    let t = info.t
    let name = sexp.word(t, e, 3)
    let ks = sexp.kids(t, e)
    if (name == "print" or name == "eprint") and ks.len() == 1 {
        lower_print(info, v, ks[0], name == "eprint")
        return -1
    }
    if name == "assert" and ks.len() == 1 {
        if node_ty(t, ks[0]) != ir.TY_BOOL {
            bad(v, "outside the subset: `assert` of a non-bool {span_of(t, e)}")
        }
        let c = value_of(info, v, ks[0])
        let fail_b = new_block(v)
        let ok_b = new_block(v)
        term_brif(v, c, ok_b, fail_b)
        switch_to(v, fail_b)
        callrt(v, ir.RT_PANIC_ASSERT, [])
        switch_to(v, ok_b)
        return -1
    }
    if name == "exit" and ks.len() == 1 {
        if not ir.ty_int(node_ty(t, ks[0])) {
            bad(v, "outside the subset: `exit` of a non-integer {span_of(t, e)}")
        }
        let x = value_of(info, v, ks[0])
        callrt(v, ir.RT_EXIT, [x])
        return -1
    }
    if name == "panic" and ks.len() == 1 {
        lower_panic(info, v, ks[0])
        return -1
    }
    if name == "fail" and ks.len() == 1 {
        return lower_fail(info, v, e)
    }
    if name == "net_workers" and ks.len() == 2 {
        return lower_net_workers(info, v, e)
    }
    if (name == "mem_size_of" or name == "mem_align_of") and ks.len() == 1 and sexp.kw(t, ks[0]) == "type" {
        // A layout type is as large as it is aligned; the argument is a name.
        let k = ir.ty_of_name(sexp.word(t, ks[0], 1))
        if k == ir.TY_OTHER or not (ir.ty_int(k) or ir.ty_fp(k)) {
            bad(v, "outside the subset: `{name}` of {sexp.word(t, ks[0], 1)} {span_of(t, e)}")
            return konst(v, 0)
        }
        return konst(v, layout_size(k))
    }
    if name == "mem_fn_addr" and ks.len() == 1 and sexp.kw(t, ks[0]) == "fnname" {
        return lower_fn_addr(info, v, e, ks[0])
    }
    if name == "mem_alloc" and ks.len() == 2 {
        let n = value_of(info, v, ks[0])
        let al = value_of(info, v, ks[1])
        return rt(v, "grasm_mem_alloc", [n, al], R_WORD)
    }
    if name == "mem_free" and ks.len() == 1 {
        let a = value_of(info, v, ks[0])
        rt(v, "grasm_mem_free", [a], R_VOID)
        return -1
    }
    if name == "mem_addr" and ks.len() == 1 {
        // The address whose integer is `n`: the same word.
        return value_of(info, v, ks[0])
    }
    if name == "mem_tls" and ks.len() == 1 and sexp.kw(t, ks[0]) == "tlsname" {
        // [T-TLS]: the calling thread's block of cells, made by the runtime
        // the first time the thread asks, and the cell's place in it.
        let (off, size) = tls_place(t, sexp.word(t, ks[0], 1))
        if off < 0 {
            bad(v, "outside the subset: `mem_tls` of a cell with no layout {span_of(t, e)}")
            return konst(v, 0)
        }
        let n = konst(v, size)
        let block = rt(v, "grasm_tls_block", [n], R_WORD)
        let o = konst(v, off)
        return op2(v, ir.M_ADD, block, o)
    }
    if name == "ref" and ks.len() == 1 and kind_at(t, e, 1) == ir.TY_REF {
        // [T-REF-GENERATIONAL]: the value boxed and handed to the shared
        // heap, which answers the reference.
        let k = kind_at(t, ks[0], 1)
        let x = value_of(info, v, ks[0])
        let b = box_kind(v, x, k)
        forget_temp(v, b)
        return rt(v, "grasm_ref_new", [b], R_WORD)
    }
    if (name == "release" or name == "alive") and ks.len() == 1 and kind_at(t, ks[0], 1) == ir.TY_REF {
        let r = value_of(info, v, ks[0])
        if name == "release" {
            rt(v, "grasm_ref_release", [r], R_VOID)
            return -1
        }
        return rt(v, "grasm_ref_alive", [r], R_BOOL8)
    }
    if (name == "pi" or name == "e") and ks.len() == 0 and node_ty(t, e) == ir.TY_F64 {
        // `std::f64::consts::PI` and `E`, the doubles the Cranelift build
        // writes for them.
        return fkonst(v, if name == "pi" { 0x400921FB54442D18 } else { 0x4005BF0A8B145769 })
    }
    let r = rt_builtin(info, v, e, name, ks)
    if r != -2 {
        return r
    }
    bad(v, "outside the subset: built-in `{name}` {span_of(t, e)}")
    -1
}

/// The built-ins that are one runtime call, as the Cranelift build makes
/// them: each argument computed in order (a boxed one lent to the call and
/// released after, unless the call takes it), the answer the runtime's.
/// -2 when `name` is not one of them.
fn rt_builtin(info: TirInfo, inout v: Vir, e: i64, name: str, ks: [i64]) -> i64 {
    let t = info.t
    // name -> runtime function, argument codes (`b` lent, `w` a word, `X`
    // boxed and handed over), and the answer.
    var fname = ""
    var codes = ""
    var ret = R_BOX
    if name == "args" and ks.len() == 0 {
        fname = "grasm_args"
    } else if name == "input" and ks.len() == 0 {
        fname = "grasm_input"
    } else if name == "map" and ks.len() == 0 {
        fname = "grasm_map_new"
    } else if name == "bytes_of" and ks.len() == 1 {
        fname = "grasm_bytes_of"
        codes = "b"
    } else if name == "bytes_filled" and ks.len() == 2 {
        fname = "grasm_bytes_filled"
        codes = "ww"
    } else if (name == "read_file" or name == "read_bytes" or name == "list_dir" or name == "file_size" or name == "sync_file" or name == "remove_file" or name == "make_dir" or name == "make_dir_new" or name == "env") and ks.len() == 1 {
        fname = "grasm_" + name
        codes = "b"
    } else if (name == "write_file" or name == "write_bytes" or name == "append_bytes" or name == "rename_file") and ks.len() == 2 {
        fname = "grasm_" + name
        codes = "bb"
    } else if name == "file_exists" and ks.len() == 1 {
        fname = "grasm_file_exists"
        codes = "b"
        ret = R_BOOL8
    } else if name == "assert_eq" and ks.len() == 2 {
        // Boxed and handed over, so a failure can show both values.
        fname = "grasm_assert_eq"
        codes = "XX"
        ret = R_VOID
    } else if (name == "Ok" or name == "Err") and ks.len() == 1 {
        fname = if name == "Ok" { "grasm_ok_new" } else { "grasm_err_new" }
        codes = "X"
    } else if (name == "now_millis" or name == "monotonic_millis" or name == "monotonic_nanos") and ks.len() == 0 {
        // The clocks ([L-LIB-CLOCK]): a word each.
        fname = "grasm_" + name
        ret = R_WORD
    } else if name == "sleep_millis" and ks.len() == 1 {
        // Answers a unit box nobody reads.
        fname = "grasm_sleep_millis"
        codes = "x"
        ret = R_DROP
    } else if (name == "random_bytes" or name == "tcp_listen" or name == "tcp_accept" or name == "tcp_read" or name == "tcp_read_bytes" or name == "net_port" or name == "udp_bind" or name == "udp_recv" or name == "udp_recv_from" or name == "tcp_peer") and ks.len() == 1 {
        // The network ([L-LIB-NET]) and the entropy source: each argument
        // boxed and lent, a result answered.
        fname = "grasm_" + name
        codes = "x"
    } else if name == "net_close" and ks.len() == 1 {
        fname = "grasm_net_close"
        codes = "x"
        ret = R_VOID
    } else if (name == "tcp_connect" or name == "tcp_listen_on" or name == "net_wait" or name == "tcp_write" or name == "tcp_write_bytes" or name == "proc_run" or name == "proc_pipeline") and ks.len() == 2 {
        fname = "grasm_" + name
        codes = "xx"
    } else if (name == "str_builder" or name == "byte_builder") and ks.len() == 0 {
        // [L-LIB-BUILDER]: an empty one of each.
        fname = if name == "str_builder" { "grasm_strbuf_new" } else { "grasm_bytebuf_new" }
    } else if name == "chan_new" and ks.len() <= 1 {
        // Channels ([E-CHANNEL]): a handle each, the runtime's
        // (`grasm_rt::tasks`). A value sent is handed over; one received
        // comes back inside an `Option`.
        fname = "grasm_chan_new"
        codes = "w"
        ret = R_WORD
    } else if name == "chan_send" and ks.len() == 2 {
        fname = "grasm_chan_send"
        codes = "wX"
        ret = R_VOID
    } else if name == "chan_recv" and ks.len() == 1 {
        fname = "grasm_chan_recv"
        codes = "w"
    } else if name == "chan_select" and ks.len() == 1 {
        fname = "grasm_chan_select"
        codes = "b"
        ret = R_WORD
    } else if name == "chan_close" and ks.len() == 1 {
        fname = "grasm_chan_close"
        codes = "w"
        ret = R_VOID
    } else if name == "read_bytes_at" and ks.len() == 3 {
        fname = "grasm_read_bytes_at"
        codes = "xxx"
    } else if name == "udp_send" and ks.len() == 4 {
        fname = "grasm_udp_send"
        codes = "xxxx"
    } else {
        return -2
    }
    if not held(kind_at(t, e, 1)) {
        bad(v, "outside the subset: built-in `{name}` answering {ty_text(t, e, 1)} {span_of(t, e)}")
        return -1
    }
    var args: [i64] = []
    for i in 0..ks.len() {
        let k = kind_at(t, ks[i], 1)
        if not held(k) {
            bad(v, "outside the subset: built-in `{name}` of {ty_text(t, ks[i], 1)} {span_of(t, e)}")
            return -1
        }
        let x = value_of(info, v, ks[i])
        let code = codes.substr(i, 1)
        args.push(if code == "X" or code == "x" { box_kind(v, x, k) } else { x })
    }
    for i in 0..args.len() {
        if codes.substr(i, 1) == "X" {
            forget_temp(v, args[i])
        }
    }
    if name == "chan_new" and args.is_empty() {
        // `chan_new()` is a rendezvous channel: capacity 0.
        args.push(konst(v, 0))
    }
    let r = rt(v, fname, args, if ret == R_DROP { R_BOX } else { ret })
    for i in 0..args.len() {
        let code = codes.substr(i, 1)
        if code == "b" or code == "x" {
            discard(v, args[i])
        }
    }
    if ret == R_DROP {
        discard(v, r)
        return -1
    }
    r
}

/// A block: its own scope, whose variables are released at its end. Its
/// value, when it has one, is a temporary and outlives the scope.
fn lower_block(info: TirInfo, inout v: Vir, e: i64) -> i64 {
    let t = info.t
    let ks = sexp.kids(t, e)
    var last = -1
    open_scope(v)
    for i in 0..ks.len() {
        let x = lower_expr(info, v, ks[i])
        if i == ks.len() - 1 and not is_stmt(sexp.kw(t, ks[i])) {
            last = x
        } else {
            discard(v, x)
        }
    }
    // What leaving the block releases is its closing brace's.
    let end = span_end(t, e)
    if end > 0 {
        v.cur_span = end - 1
    }
    close_scope(v)
    last
}

/// Enters a loop body: `break` and `continue` release what was made inside.
fn enter_loop(inout v: Vir, cont: i64, brk: i64) {
    v.loop_cont.push(cont)
    v.loop_brk.push(brk)
    v.loop_owned.push(v.owned.len())
    v.loop_temps.push(v.temps.len())
    v.loop_handlers.push(v.handlers)
}

fn leave_loop(inout v: Vir) {
    v.loop_cont.pop()
    v.loop_brk.pop()
    v.loop_owned.pop()
    v.loop_temps.pop()
    v.loop_handlers.pop()
}

/// Pops the handlers installed past the first `keep`, without forgetting
/// them: one way out of their blocks, while the others still have them
/// installed ([E-HANDLER-SCOPE]).
fn pop_handlers_above(inout v: Vir, keep: i64) {
    var k = v.handlers
    while k > keep {
        rt(v, "grasm_handler_pop", [], R_VOID)
        k -= 1
    }
}

/// Whether an expression of type `ty` yields a value worth carrying.
fn valued(ty: i64) -> bool {
    ty != ir.TY_UNIT and ty != ir.TY_NEVER
}

/// Ends a branch whose value is `x`: into the result `r` (the temporary's
/// reference with it), or away when the construct has no value.
fn branch_value(inout v: Vir, r: i64, x: i64) {
    if not v.open {
        return
    }
    if r >= 0 {
        let xv = if x >= 0 { x } else { zero_like(v, v.vty[r]) }
        copy_to(v, r, xv)
        if is_temp(v, xv) {
            forget_temp(v, xv)
        }
    } else {
        discard(v, x)
    }
}

/// The result of a construct whose branches have joined: a temporary when
/// it is a box.
fn joined_value(inout v: Vir, r: i64) -> i64 {
    if r >= 0 and ir.ty_boxed(v.vty[r]) {
        own_temp(v, r)
    }
    r
}

fn lower_if(info: TirInfo, inout v: Vir, e: i64) -> i64 {
    let t = info.t
    let ty = kind_at(t, e, 1)
    if not held(ty) {
        bad(v, "outside the subset: an `if` of type {ty_text(t, e, 1)} {span_of(t, e)}")
    }
    let ks = sexp.kids(t, e)
    let c = value_of(info, v, ks[0])
    var r = -1
    if valued(ty) {
        r = new_var(v, ty)
    }
    let then_b = new_block(v)
    let join = new_block(v)
    var else_b = join
    if ks.len() > 2 {
        else_b = new_block(v)
    }
    term_brif(v, c, then_b, else_b)
    switch_to(v, then_b)
    let x = lower_expr(info, v, ks[1])
    branch_value(v, r, x)
    if v.open {
        term_jump(v, join)
    }
    if ks.len() > 2 {
        switch_to(v, else_b)
        let y = lower_expr(info, v, sexp.at(t, ks[2], 1))
        branch_value(v, r, y)
        if v.open {
            term_jump(v, join)
        }
    }
    switch_to(v, join)
    joined_value(v, r)
}

/// Where a failing pattern test goes: block `blk`, after releasing what was
/// bound and held since the point it stands for (`nowned`, `ntemps`).
type PatFail = {
    blk: i64,
    nowned: i64,
    ntemps: i64,
}

/// Continues when `c` holds; otherwise releases down to `no`'s point and
/// goes there.
fn test_or_fail(inout v: Vir, c: i64, no: PatFail) {
    let yes = new_block(v)
    let f = new_block(v)
    term_brif(v, c, yes, f)
    switch_to(v, f)
    release_from(v, no.nowned, no.ntemps)
    term_jump(v, no.blk)
    switch_to(v, yes)
}

/// The sub-pattern `p` of element or field value `x` (an owned temporary
/// when boxed), which is released once the sub-pattern has matched; a
/// failure releases it on the way out with everything else.
fn sub_pat(info: TirInfo, inout v: Vir, p: i64, x: i64, xte: i64, no: PatFail) {
    lower_pat(info, v, p, x, xte, no)
    if is_temp(v, x) {
        drop_temp(v, x)
    }
}

/// Tests pattern `p` against the value in `s`, of type element `ste`: falls
/// through when it matches, with its names bound (each owning a reference
/// of its own when boxed), and branches to `no` when it does not.
fn lower_pat(info: TirInfo, inout v: Vir, p: i64, s: i64, ste: i64, no: PatFail) {
    // A pattern's tests are its own line's, as an expression's code is.
    let outer = v.cur_span
    let at = span_start(info.t, p)
    if at >= 0 {
        v.cur_span = at
    }
    lower_pat_at(info, v, p, s, ste, no)
    v.cur_span = outer
}

fn lower_pat_at(info: TirInfo, inout v: Vir, p: i64, s: i64, ste: i64, no: PatFail) {
    let t = info.t
    let sty = ty_kind(t, ste)
    match sexp.kw(t, p) {
        "pwild" -> ()
        "pbind" -> {
            let w = bind_tvar(v, sexp.word(t, p, 2).parse_int() ?? -1, sty, ste)
            copy_to(v, w, s)
            if ir.ty_boxed(sty) {
                // A reference of the binding's own, released with the arm.
                emit(v, ir.M_INC, -1, w, -1, 0)
                own_var(v, w)
            }
        }
        "pstr" -> {
            let lit = str_value(v, sexp.word(t, p, 2))
            let c = rt(v, "grasm_str_eq", [s, lit], R_BOOL8)
            drop_temp(v, lit)
            test_or_fail(v, c, no)
        }
        "pint" -> {
            let text = sexp.word(t, p, 2)
            let k = konst(v, if sty == ir.TY_U64 { (text.parse_u64() ?? 0).as_i64() } else { text.parse_int() ?? 0 })
            let c = icmp(v, ir.CC_EQ, s, k)
            test_or_fail(v, c, no)
        }
        "pbool" -> {
            if sexp.word(t, p, 2) == "true" {
                test_or_fail(v, s, no)
            } else {
                let one = konst(v, 1)
                let c = op2(v, ir.M_XOR, s, one)
                test_or_fail(v, c, no)
            }
        }
        "por" -> {
            let alts = sexp.kids(t, p)
            let matched = new_block(v)
            for i in 0..alts.len() {
                var next = no
                if i < alts.len() - 1 {
                    next = PatFail{ blk: new_block(v), nowned: v.owned.len(), ntemps: v.temps.len() }
                }
                lower_pat(info, v, alts[i], s, ste, next)
                term_jump(v, matched)
                if i < alts.len() - 1 {
                    switch_to(v, next.blk)
                }
            }
            switch_to(v, matched)
        }
        "ptuple" -> {
            let subs = sexp.kids(t, p)
            for j in 0..subs.len() {
                let xte = ty_arg(t, ste, j + 1)
                if sexp.kw(t, subs[j]) == "pwild" {
                    continue
                }
                let ic = konst(v, j)
                let b = rt(v, "grasm_list_get", [s, ic], R_BOX)
                let x = unbox_kind(v, b, ty_kind(t, xte))
                sub_pat(info, v, subs[j], x, xte, no)
            }
        }
        "pvariant" -> {
            let idx = sexp.word(t, p, 3).parse_int() ?? -1
            let vd = variant_decl(info, ste, idx)
            if vd < 0 {
                bad(v, "outside the subset: a variant pattern on {sexp.word(t, p, 2)} {span_of(t, p)}")
                return
            }
            let vn = text_args(v, sexp.word(t, vd, 1))
            let c = rt(v, "grasm_variant_is", [s, vn[0], vn[1]], R_BOOL8)
            test_or_fail(v, c, no)
            let args = named_args(t, ste)
            let fdecls = sexp.kids(t, vd)
            let subs = sexp.kids(t, p)
            for j in 0..subs.len() {
                if sexp.kw(t, subs[j]) == "pwild" {
                    continue
                }
                let fte = field_te(info, ste, idx, j, sexp.at(t, fdecls[j], 2))
                let k = field_kind(t, sexp.at(t, fdecls[j], 2), args)
                if not held(k) or has_generic(t, fte) {
                    bad(v, "outside the subset: a variant field of a type this part does not hold {span_of(t, p)}")
                    return
                }
                let ic = konst(v, j)
                let b = rt(v, "grasm_variant_field", [s, ic], R_BOX)
                let x = unbox_kind(v, b, k)
                sub_pat(info, v, subs[j], x, fte, no)
            }
        }
        "pok" -> pat_result(info, v, p, s, ste, "Ok", 1, no)
        "perr" -> pat_result(info, v, p, s, ste, "Err", 2, no)
        other -> bad(v, "outside the subset: pattern `{other}` {span_of(t, p)}")
    }
}

/// `Ok(p)` or `Err(p)` on a boxed result: the variant's name, then its one
/// field, of the type's half `half` (1 the `T`, 2 the `E`).
fn pat_result(info: TirInfo, inout v: Vir, p: i64, s: i64, ste: i64, name: str, half: i64, no: PatFail) {
    let t = info.t
    let vn = text_args(v, name)
    let c = rt(v, "grasm_variant_is", [s, vn[0], vn[1]], R_BOOL8)
    test_or_fail(v, c, no)
    let sub = sexp.kids(t, p)[0]
    if sexp.kw(t, sub) == "pwild" {
        return
    }
    let xte = ty_arg(t, ste, half)
    let k = ty_kind(t, xte)
    if not held(k) {
        bad(v, "outside the subset: an `{name}` pattern of type {ty_text(t, ste, 0)} {span_of(t, p)}")
        return
    }
    let zero = konst(v, 0)
    let b = rt(v, "grasm_variant_field", [s, zero], R_BOX)
    let x = unbox_kind(v, b, k)
    sub_pat(info, v, sub, x, xte, no)
}

fn lower_match(info: TirInfo, inout v: Vir, e: i64) -> i64 {
    let t = info.t
    let ty = kind_at(t, e, 1)
    if not held(ty) {
        bad(v, "outside the subset: a `match` of type {ty_text(t, e, 1)} {span_of(t, e)}")
    }
    let ks = sexp.kids(t, e)
    if not held(kind_at(t, ks[0], 1)) {
        bad(v, "outside the subset: matching on {ty_text(t, ks[0], 1)} {span_of(t, e)}")
    }
    // The scrutinee is held, as a temporary, until the arms join. A match on
    // a reference matches what it points at ([T-REF-MATCH]).
    let s00 = value_of(info, v, ks[0])
    let (s0, ste) = through_refs(v, t, s00, ty_el(t, ks[0], 1))
    let sty = ty_kind(t, ste)
    let s = new_var(v, sty)
    copy_to(v, s, s0)
    if is_temp(v, s0) {
        forget_temp(v, s0)
        own_temp(v, s)
    }
    var r = -1
    if valued(ty) {
        r = new_var(v, ty)
    }
    let join = new_block(v)
    for i in 1..ks.len() {
        let arm = ks[i]
        let parts = sexp.kids(t, arm)
        let next = new_block(v)
        // An arm's bindings are a scope of their own.
        open_scope(v)
        let no = PatFail{ blk: next, nowned: v.owned.len(), ntemps: v.temps.len() }
        lower_pat(info, v, parts[0], s, ste, no)
        var body = parts[1]
        if parts.len() == 3 {
            let g = value_of(info, v, sexp.at(t, parts[1], 1))
            let yes = new_block(v)
            let gfail = new_block(v)
            term_brif(v, g, yes, gfail)
            // A guard that fails gives back what the pattern bound.
            switch_to(v, gfail)
            release_from(v, v.scope_mark[v.scope_mark.len() - 1], v.temps.len())
            term_jump(v, next)
            switch_to(v, yes)
            body = parts[2]
        }
        let x = lower_expr(info, v, body)
        branch_value(v, r, x)
        close_scope(v)
        if v.open {
            term_jump(v, join)
        }
        switch_to(v, next)
    }
    // The checker proved the arms exhaustive.
    term_trap(v)
    switch_to(v, join)
    if is_temp(v, s) {
        drop_temp(v, s)
    }
    joined_value(v, r)
}

fn lower_let(info: TirInfo, inout v: Vir, e: i64) -> i64 {
    let t = info.t
    let ty = kind_at(t, e, 4)
    if not held(ty) {
        bad(v, "outside the subset: a binding of type {ty_text(t, e, 4)} {span_of(t, sexp.kids(t, e)[0])}")
    }
    let x = value_of(info, v, sexp.kids(t, e)[0])
    let w = bind_tvar(v, sexp.word(t, e, 1).parse_int() ?? -1, ty, ty_el(t, e, 4))
    copy_to(v, w, x)
    if ir.ty_boxed(ty) {
        // The temporary's reference is the variable's now.
        forget_temp(v, x)
        own_var(v, w)
    }
    -1
}

/// Whether node `e` is a read of TIR local `id`.
fn reads_local(t: TirTree, e: i64, id: i64) -> bool {
    sexp.kw(t, e) == "local" and (sexp.word(t, e, 3).parse_int() ?? -2) == id
}

fn lower_assign(info: TirInfo, inout v: Vir, e: i64) -> i64 {
    let t = info.t
    let op = sexp.word(t, e, 1)
    let ty = kind_at(t, e, 2)
    let ks = sexp.kids(t, e)
    if sexp.kw(t, ks[0]) != "local" {
        return lower_place_assign(info, v, e)
    }
    if not held(ty) {
        bad(v, "outside the subset: assignment of type {ty_text(t, e, 2)} {span_of(t, ks[1])}")
        return -1
    }
    let id = sexp.word(t, ks[0], 1).parse_int() ?? -1
    let w = tvar_of(v, id)
    if ir.ty_boxed(ty) {
        let rhs = ks[1]
        // `s += x` and `s = s + x` on a string append to `s` itself: its
        // reference goes to `grasm_str_append`, which writes in place when it
        // is the only one, so a string built in a loop is built in linear
        // time, as the Cranelift build's is. The right side is computed
        // first; anything it read of `s` it holds a reference of its own to,
        // and then the append copies rather than writing in place.
        var addend = -1
        if op == "add" and sexp.word(t, e, 2) == "str" {
            addend = rhs
        } else if op == "set" and sexp.kw(t, rhs) == "binary" and sexp.word(t, rhs, 3) == "add" and sexp.word(t, rhs, 4) == "str" and reads_local(t, sexp.kids(t, rhs)[0], id) {
            addend = sexp.kids(t, rhs)[1]
        }
        if addend >= 0 {
            let b = value_of(info, v, addend)
            let r = rt(v, "grasm_str_append", [w, b], R_BOX)
            drop_temp(v, b)
            copy_to(v, w, r)
            forget_temp(v, r)
            return -1
        }
        if op != "set" {
            bad(v, "outside the subset: `{op}=` on {ty_text(t, e, 2)} {span_of(t, rhs)}")
            return -1
        }
        // The new value first, then the old one released.
        let x = value_of(info, v, rhs)
        emit(v, ir.M_DEC, -1, w, -1, 0)
        copy_to(v, w, x)
        forget_temp(v, x)
        return -1
    }
    let x = value_of(info, v, ks[1])
    if op == "set" {
        copy_to(v, w, x)
    } else if ir.ty_int(ty) {
        let r = arith(v, op, ty, w, x)
        copy_to(v, w, r)
    } else if ir.ty_fp(ty) {
        let r = farith(v, op, w, x, span_of(t, ks[1]))
        copy_to(v, w, r)
    } else {
        bad(v, "outside the subset: `{op}=` on {ty_text(t, e, 2)}")
    }
    -1
}

/// Child `seg` of owned-or-held container `c`: a struct's field (`key` its
/// position) or a list's element (`key` the index's value), as a value of
/// type `te` -- retained when boxed.
fn read_child(inout v: Vir, t: TirTree, c: i64, is_field: bool, key: i64, te: i64) -> i64 {
    let k = ty_kind(t, te)
    if is_field {
        let ic = konst(v, key)
        if ir.ty_boxed(k) {
            return rt(v, "grasm_struct_get_at", [c, ic], R_BOX)
        }
        let w = rt(v, "grasm_struct_scalar_at", [c, ic], R_WORD)
        return word_as(v, w, k)
    }
    list_elem(v, t, c, key, te)
}

/// Writes `x` (owned when boxed) as child `seg` of container `c`, whose
/// reference the runtime takes; answers the container to keep.
fn write_child(inout v: Vir, t: TirTree, c: i64, is_field: bool, key: i64, te: i64, x: i64) -> i64 {
    let k = ty_kind(t, te)
    if is_temp(v, c) {
        forget_temp(v, c)
    }
    if is_field {
        let b = box_kind(v, x, k)
        forget_temp(v, b)
        let ic = konst(v, key)
        return rt(v, "grasm_struct_set_field_at", [c, ic, b], R_BOX)
    }
    let sk = scalar_kind(t, te)
    if sk >= 0 {
        let kc = konst(v, sk)
        let w = word_of(v, x)
        return rt(v, "grasm_list_set_scalar", [c, key, w, kc], R_BOX)
    }
    let b = box_kind(v, x, k)
    forget_temp(v, b)
    rt(v, "grasm_list_set", [c, key, b], R_BOX)
}

// ----- built-in methods ------------------------------------------------------------
//
// Each the Cranelift build's lowering (`dispatch_method`): the same runtime
// function with the same arguments. A method that reads its receiver gets an
// owned copy of it and of each boxed argument, all released after the call.
// One that changes its receiver -- `push`, `pop`, `remove`, `sort`, a map's
// `set` and `delete`, a byte buffer's `set`, `fill`, `copy_from` -- hands the
// receiver's own reference to the runtime and stores what comes back in its
// place, after the place's indices and then the arguments are computed.

/// The family a method is looked up by: the receiver's type.
fn method_family(t: TirTree, x: i64) -> str {
    if x < 0 {
        return "?"
    }
    if t.kind[x] == 0 {
        let s = t.text[x]
        // An `addr`'s methods are the raw-memory ones (docs/tir.md §6.3).
        if s == "str" or s == "bytes" or s == "u64" or s == "bool" or s == "addr" {
            return s
        }
        if ir.ty_int(ir.ty_of_name(s)) {
            return "int"
        }
        return s
    }
    let h = sexp.kw(t, x)
    if h == "named" and sexp.word(t, x, 1) == "Option" {
        return "option"
    }
    h
}

/// The arguments of a read-only method, by `codes`: `w` a word as it is,
/// `b` a boxed value, `x` a value boxed if it is a scalar. Answers them in
/// order; the boxes are temporaries the caller releases.
fn method_args(info: TirInfo, inout v: Vir, args: [i64], codes: str) -> [i64] {
    let t = info.t
    var out: [i64] = []
    for i in 0..args.len() {
        let x = value_of(info, v, args[i])
        if codes.substr(i, 1) == "x" {
            out.push(box_kind(v, x, kind_at(t, args[i], 1)))
        } else {
            out.push(x)
        }
    }
    out
}

/// A method that only reads its receiver: `fname(recv, args.., extra..)`.
fn read_method(info: TirInfo, inout v: Vir, e: i64, fname: str, codes: str, extra: [i64], ret: i64) -> i64 {
    let t = info.t
    let ks = sexp.kids(t, e)
    let recv = value_of(info, v, ks[0])
    var rest: [i64] = []
    for i in 1..ks.len() {
        rest.push(ks[i])
    }
    let av = method_args(info, v, rest, codes)
    var call: [i64] = [recv]
    for x in av {
        call.push(x)
    }
    for x in extra {
        call.push(x)
    }
    let r = rt(v, fname, call, ret)
    discard(v, recv)
    for x in av {
        discard(v, x)
    }
    r
}

/// A place a method may change: a local, or a path of struct fields and
/// list elements rooted at one, as the method's receiver expression writes
/// it. `ok` is false when the receiver is anything else.
type RecvPath = {
    ok: bool,
    root: i64,
    root_id: i64,
    fields: [bool],
    keys: [i64],
    names: [str],
    tes: [i64],
}

fn recv_path(info: TirInfo, inout v: Vir, recv: i64) -> RecvPath {
    let t = info.t
    var lf: [bool] = []
    var lk: [i64] = []
    var lt: [i64] = []
    var p = recv
    while sexp.kw(t, p) == "field" or sexp.kw(t, p) == "index" {
        lt.push(ty_el(t, p, 1))
        let pk = sexp.kids(t, p)
        if sexp.kw(t, p) == "field" {
            lf.push(true)
            lk.push(sexp.word(t, p, 3).parse_int() ?? 0)
            p = pk[0]
        } else {
            lf.push(false)
            lk.push(pk[1])
            p = pk[0]
        }
    }
    var rp = RecvPath{ ok: false, root: -1, root_id: -1, fields: [], keys: [], names: [], tes: [] }
    if sexp.kw(t, p) != "local" {
        return rp
    }
    let n = lf.len()
    rp.tes.push(ty_el(t, p, 1))
    for j in 0..n {
        rp.fields.push(lf[n - 1 - j])
        rp.keys.push(lk[n - 1 - j])
        rp.tes.push(lt[n - 1 - j])
    }
    // Each step's container: a struct for a field, a list for an element.
    for j in 0..n {
        let ct = rp.tes[j]
        var name = ""
        if rp.fields[j] {
            let body = type_body(info, ct)
            if body < 0 or sexp.kw(t, body) != "struct" {
                return rp
            }
            name = sexp.word(t, sexp.kids(t, body)[rp.keys[j]], 1)
        } else if ty_head(t, ct) != "list" {
            return rp
        }
        if not held(ty_kind(t, rp.tes[j + 1])) {
            return rp
        }
        rp.names.push(name)
    }
    rp.root_id = sexp.word(t, p, 3).parse_int() ?? -1
    rp.root = tvar_of(v, rp.root_id)
    rp.ok = true
    rp
}

/// An `inout` argument that is a place inside a variable: the path, its
/// indices' values, the containers on the way down, and the frame slot the
/// callee reads and writes.
type InoutPlace = {
    rp: RecvPath,
    kv: [i64],
    cs: [i64],
    slot: i64,
}

/// Whether TIR local `id` is read anywhere in nodes `ks[from..]`.
fn later_reads(t: TirTree, ks: [i64], from: i64, id: i64) -> bool {
    var stack: [i64] = []
    for i in from..ks.len() {
        stack.push(ks[i])
    }
    while not stack.is_empty() {
        let e = stack.pop() ?? 0
        if t.kind[e] != 2 {
            continue
        }
        if sexp.kw(t, e) == "local" and (sexp.word(t, e, 3).parse_int() ?? -2) == id {
            return true
        }
        for x in sexp.kids(t, e) {
            stack.push(x)
        }
    }
    false
}

/// Reads the place argument `a` of a call (`ks[i]`) into a fresh frame
/// slot, as a value of parameter type `pte`.
fn inout_place(info: TirInfo, inout v: Vir, a: i64, ks: [i64], i: i64, pte: i64) -> InoutPlace {
    let t = info.t
    let rp = recv_path(info, v, a)
    var pl = InoutPlace{ rp: rp, kv: [], cs: [], slot: -1 }
    if not rp.ok {
        bad(v, "outside the subset: an `inout` argument that is not a place {span_of(t, a)}")
        return pl
    }
    let n = rp.fields.len()
    for j in 0..n {
        pl.kv.push(if rp.fields[j] { rp.keys[j] } else { value_of(info, v, rp.keys[j]) })
    }
    // Moved out where nothing later can see the hole it leaves; copied
    // where a later argument reads the same variable.
    let take = not later_reads(t, ks, i + 1, rp.root_id)
    pl.cs = [rp.root]
    for j in 1..n {
        if take {
            pl.cs.push(take_child(v, pl.cs[j - 1], rp.fields[j - 1], pl.kv[j - 1], rp.names[j - 1]))
        } else {
            pl.cs.push(read_child(v, t, pl.cs[j - 1], rp.fields[j - 1], pl.kv[j - 1], rp.tes[j]))
        }
    }
    let lk = ty_kind(t, rp.tes[n])
    var leaf = -1
    if take and ir.ty_boxed(lk) {
        leaf = take_child(v, pl.cs[n - 1], rp.fields[n - 1], pl.kv[n - 1], rp.names[n - 1])
    } else {
        leaf = read_child(v, t, pl.cs[n - 1], rp.fields[n - 1], pl.kv[n - 1], rp.tes[n])
    }
    if not held(ty_kind(t, pte)) {
        bad(v, "outside the subset: an `inout` argument of type {ty_text(t, a, 1)} {span_of(t, a)}")
    }
    pl.slot = fresh_slot(v)
    let addr = slot_addr(v, pl.slot)
    store_at(v, addr, leaf)
    // The slot holds the reference now; the write-back hands it on.
    if is_temp(v, leaf) {
        forget_temp(v, leaf)
    }
    pl
}

/// After the call: what the callee left in the slot, written back into the
/// place, each container into its parent, the variable last.
fn write_back_place(t: TirTree, inout v: Vir, pl: InoutPlace) {
    let rp = pl.rp
    let n = rp.fields.len()
    let lk = ty_kind(t, rp.tes[n])
    let x = new_var(v, if ir.ty_boxed(lk) { ir.TY_BOX } else if ir.ty_fp(lk) { ir.TY_F64 } else { ir.TY_I64 })
    let addr = slot_addr(v, pl.slot)
    load_into(v, x, addr)
    if ir.ty_boxed(lk) {
        own_temp(v, x)
    }
    var nv = x
    var j = n - 1
    while j >= 0 {
        nv = write_child(v, t, pl.cs[j], rp.fields[j], pl.kv[j], rp.tes[j + 1], nv)
        j -= 1
    }
    copy_to(v, rp.root, nv)
    forget_temp(v, nv)
}

/// A method that changes its receiver: `new = fname(recv, args.., extra..)`
/// stored back where the receiver was. `codes` per argument: `w` a word,
/// `X` a value boxed and handed over, `B` a boxed value lent, `P` the
/// element of a `push`, `K` a key function whose keys over the receiver are
/// computed and lent (`sort_by`). Answers the variable holding the call's
/// result.
///
/// The receiver is a place (`place_path`). One that crosses no reference is
/// taken down from its variable and written back up to it. One below a
/// reference is changed where the shared heap holds it: the referent made
/// the slot's only holder and the path below it taken and written back in
/// place; a receiver that is the referent itself (`r.value.push(x)`) is read
/// out, changed, and put back whole (`grasm_ref_set`), as the Cranelift
/// build does.
fn mut_method(info: TirInfo, inout v: Vir, e: i64, fname: str, codes: str, extra: [i64]) -> i64 {
    let t = info.t
    let ks = sexp.kids(t, e)
    let pp = place_path(info, v, ks[0], true)
    if not pp.ok {
        bad(v, "outside the subset: `{sexp.word(t, e, 3)}` on a receiver that is not a place {span_of(t, e)}")
        return konst(v, 0)
    }
    let n = pp.kinds.len()
    // The path's indices, then the arguments.
    let kv = path_keys(info, v, pp)
    let leaf_te = pp.tes[n]
    var av: [i64] = []
    var push_scalar = -1
    for i in 1..ks.len() {
        let x = value_of(info, v, ks[i])
        let code = codes.substr(i - 1, 1)
        let k = kind_at(t, ks[i], 1)
        if code == "K" {
            // A key function (`sort_by`): every key computed now, over a copy
            // of the receiver read down the path, and lent to the call.
            let cur = read_path(v, t, pp, kv, n)
            let fty = ty_el(t, ks[i], 1)
            let rte = fn_ret(t, fty)
            let keys = empty_list_for(v, t, rte)
            var w = walk_list(v, cur, ty_arg(t, leaf_te, 1))
            walk_head(v, w)
            let el = walk_elem(v, t, w)
            let y = call_value(v, x, [el], ty_kind(t, rte))
            push_elem(v, t, keys, y, rte)
            walk_next(v, w)
            discard(v, x)
            av.push(keys)
        } else if code == "X" or code == "B" {
            av.push(box_kind(v, x, k))
        } else if code == "P" {
            let sk = scalar_kind(t, ty_arg(t, leaf_te, 1))
            if sk >= 0 {
                push_scalar = sk
                av.push(word_of(v, x))
            } else {
                av.push(box_kind(v, x, ty_kind(t, ty_arg(t, leaf_te, 1))))
            }
        } else {
            av.push(x)
        }
    }
    // Down to the receiver. Where the path crosses a reference, the
    // containers above the last one are only read: nothing is written back
    // into them.
    let l = last_deref(pp)
    var cs: [i64] = []
    var raw = -1
    var whole = false
    if l < 0 {
        cs.push(pp.root)
    } else {
        raw = read_path(v, t, pp, kv, l)
        if l == n - 1 {
            whole = true
            cs.push(rt(v, "grasm_ref_get", [raw], R_BOX))
        } else {
            let referent = rt(v, "grasm_ref_make_unique", [raw], R_WORD)
            v.vty[referent] = ir.TY_BOX
            cs.push(referent)
        }
    }
    let from = if l < 0 { 0 } else { l + 1 }
    for j in (from + 1)..(n + 1) {
        cs.push(take_child(v, cs[cs.len() - 1], pp.kinds[j - 1] == STEP_FIELD, kv[j - 1], pp.names[j - 1]))
    }
    let leaf = cs[cs.len() - 1]
    if is_temp(v, leaf) {
        forget_temp(v, leaf)
    }
    var call: [i64] = [leaf]
    var fn_name = fname
    if push_scalar >= 0 {
        fn_name = "grasm_list_push_scalar"
    }
    for i in 0..av.len() {
        let code = codes.substr(i, 1)
        if code == "X" or code == "P" {
            if is_temp(v, av[i]) {
                forget_temp(v, av[i])
            }
        }
        call.push(av[i])
    }
    if push_scalar >= 0 {
        call.push(konst(v, push_scalar))
    }
    for x in extra {
        call.push(x)
    }
    let r = rt(v, fn_name, call, R_BOX)
    for i in 0..av.len() {
        if codes.substr(i, 1) == "B" or codes.substr(i, 1) == "K" {
            discard(v, av[i])
        }
    }
    if whole {
        forget_temp(v, r)
        rt(v, "grasm_ref_set", [raw, r], R_VOID)
        return -1
    }
    // Up: the new receiver into its parent, each parent into its own, the
    // variable last -- or, below a reference, the referent, which the heap
    // keeps.
    var nv = r
    var j = n - 1
    while j >= from {
        nv = write_child(v, t, cs[j - from], pp.kinds[j] == STEP_FIELD, kv[j], pp.tes[j + 1], nv)
        j -= 1
    }
    if l < 0 {
        copy_to(v, pp.root, nv)
    }
    forget_temp(v, nv)
    -1
}

/// The child of container `c` (struct field `name`, or list element `key`),
/// moved out of it when `c` has no other holder, else retained.
fn take_child(inout v: Vir, c: i64, is_field: bool, key: i64, name: str) -> i64 {
    var tk = -1
    if is_field {
        let fa = text_args(v, name)
        tk = rt(v, "grasm_struct_take", [c, fa[0], fa[1]], R_WORD)
    } else {
        tk = rt(v, "grasm_list_take", [c, key], R_WORD)
    }
    let r = new_var(v, ir.TY_BOX)
    copy_to(v, r, tk)
    let z = konst(v, 0)
    let got = icmp(v, ir.CC_NE, tk, z)
    let get_b = new_block(v)
    let join = new_block(v)
    term_brif(v, got, join, get_b)
    switch_to(v, get_b)
    var g = -1
    if is_field {
        let fa = text_args(v, name)
        g = rt(v, "grasm_struct_get", [c, fa[0], fa[1]], R_BOX)
    } else {
        g = rt(v, "grasm_list_get", [c, key], R_BOX)
    }
    copy_to(v, r, g)
    forget_temp(v, g)
    term_jump(v, join)
    switch_to(v, join)
    own_temp(v, r)
    r
}

/// A method whose result comes back through an out-parameter as well as the
/// receiver: `pop` (an `Option`), `remove` (the element), `delete` (a
/// bool). The slot is cleared first: `delete` writes one byte of it.
fn out_method(info: TirInfo, inout v: Vir, e: i64, fname: str, codes: str, what: str) -> i64 {
    let t = info.t
    let slot = fresh_slot(v)
    let z = konst(v, 0)
    let a = slot_addr(v, slot)
    emit(v, ir.M_STORE, -1, a, z, 0)
    let a2 = slot_addr(v, slot)
    mut_method(info, v, e, fname, codes, [a2])
    let a3 = slot_addr(v, slot)
    let w = new_var(v, if what == "delete" { ir.TY_I64 } else { ir.TY_BOX })
    emit(v, ir.M_LOAD, w, a3, -1, 0)
    if what == "delete" {
        return op1(v, ir.M_UEXT8, w)
    }
    own_temp(v, w)
    if what == "remove" {
        return unbox_kind(v, w, kind_at(t, e, 1))
    }
    w
}

/// Wraps `x` to the width of the method's result type, as the Cranelift
/// build does after every integer method.
fn wrap_result(inout v: Vir, t: TirTree, e: i64, x: i64) -> i64 {
    wrap(v, kind_at(t, e, 1), x)
}

/// The integer methods, computed in place.
fn int_method(info: TirInfo, inout v: Vir, e: i64, name: str, is_u64: bool) -> i64 {
    let t = info.t
    let ks = sexp.kids(t, e)
    let rk = kind_at(t, ks[0], 1)
    if name == "to_char" or name == "to_str" or name == "to_base" {
        let fname = if name == "to_char" {
            if is_u64 { "grasm_u64_to_char" } else { "grasm_i64_to_char" }
        } else if name == "to_str" {
            if is_u64 { "grasm_str_from_u64" } else { "grasm_str_from_i64" }
        } else {
            if is_u64 { "grasm_u64_to_base" } else { "grasm_i64_to_base" }
        }
        return read_method(info, v, e, fname, "w", [], R_BOX)
    }
    let x = value_of(info, v, ks[0])
    if name == "bit_not" {
        return wrap_result(v, t, e, op1(v, ir.M_NOT, x))
    }
    if name == "as_f64" {
        // A narrow value is held extended to 64 bits by its sign, so it
        // converts as an `i64`; a `u64` converts unsigned.
        return fop1(v, if is_u64 { ir.M_UCVTF } else { ir.M_SCVTF }, x)
    }
    if name == "from_bits" {
        return from_bits(v, x)
    }
    if name == "as_i64" {
        return x
    }
    if name.starts_with("as_") {
        return wrap_result(v, t, e, x)
    }
    if name == "abs" {
        if is_u64 {
            return x
        }
        return wrap_result(v, t, e, rt(v, "grasm_i64_abs", [x], R_WORD))
    }
    let bits = bits_method(info, v, e, name, x, rk)
    if bits >= 0 {
        return bits
    }
    if name.starts_with("try_") {
        // `Some(v)` when it fits the width named ([L-LIB-INT-CONV]).
        let tk = konst(v, int_tag(ir.ty_of_name(name.substr(4, name.len() - 4))))
        let sk = konst(v, int_tag(rk))
        return rt(v, "grasm_int_try", [tk, sk, x], R_BOX)
    }
    let y = value_of(info, v, ks[1])
    if name.starts_with("checked_") or name.starts_with("saturating_") {
        // At the receiver's width, by the runtime: `None`, or the result held
        // to the range, where the true result does not fit.
        let o = if name.ends_with("_add") { 0 } else if name.ends_with("_sub") { 1 } else { 2 }
        let tk = konst(v, int_tag(rk))
        let ok = konst(v, o)
        if name.starts_with("checked_") {
            return rt(v, "grasm_int_checked", [tk, ok, x, y], R_BOX)
        }
        return rt(v, "grasm_int_saturating", [tk, ok, x, y], R_WORD)
    }
    if name == "bit_and" or name == "bit_or" or name == "bit_xor" {
        let op = if name == "bit_and" { ir.M_AND } else if name == "bit_or" { ir.M_OR } else { ir.M_XOR }
        return wrap_result(v, t, e, op2(v, op, x, y))
    }
    if name == "min" or name == "max" {
        if is_u64 {
            // `umin`/`umax`, by a comparison and a branch.
            let r = new_var(v, ir.TY_U64)
            copy_to(v, r, x)
            let c = icmp(v, if name == "min" { ir.CC_UGT } else { ir.CC_ULT }, x, y)
            let take = new_block(v)
            let join = new_block(v)
            term_brif(v, c, take, join)
            switch_to(v, take)
            copy_to(v, r, y)
            term_jump(v, join)
            switch_to(v, join)
            return r
        }
        let f = if name == "min" { "grasm_i64_min" } else { "grasm_i64_max" }
        return wrap_result(v, t, e, rt(v, f, [x, y], R_WORD))
    }
    // Shifts: the count is masked to 63 whatever the width.
    let m63 = konst(v, 63)
    let n = op2(v, ir.M_AND, y, m63)
    if name == "shl" {
        return wrap_result(v, t, e, op2(v, ir.M_SHL, x, n))
    }
    if name == "shr" {
        return wrap_result(v, t, e, op2(v, if is_u64 { ir.M_USHR } else { ir.M_SSHR }, x, n))
    }
    if name == "ushr" {
        if is_u64 or rk == ir.TY_I64 {
            return op2(v, ir.M_USHR, x, n)
        }
        // A narrow value shifted as the unsigned bits of its own width.
        let mask = konst(v, if rk == ir.TY_I8 or rk == ir.TY_U8 { 255 } else if rk == ir.TY_I16 or rk == ir.TY_U16 { 65535 } else { 4294967295 })
        let xm = op2(v, ir.M_AND, x, mask)
        return wrap_result(v, t, e, op2(v, ir.M_USHR, xm, n))
    }
    bad(v, "outside the subset: method `{name}` on an integer {span_of(t, e)}")
    x
}

/// The runtime's tag for an integer width (`IntKind`'s): `i8` 0 .. `u64` 6,
/// `i64` 255.
fn int_tag(k: i64) -> i64 {
    if k == ir.TY_I8 {
        0
    } else if k == ir.TY_I16 {
        1
    } else if k == ir.TY_I32 {
        2
    } else if k == ir.TY_U8 {
        3
    } else if k == ir.TY_U16 {
        4
    } else if k == ir.TY_U32 {
        5
    } else if k == ir.TY_U64 {
        6
    } else {
        255
    }
}

/// The number of bits an integer type holds.
fn int_width(k: i64) -> i64 {
    if k == ir.TY_I8 or k == ir.TY_U8 {
        8
    } else if k == ir.TY_I16 or k == ir.TY_U16 {
        16
    } else if k == ir.TY_I32 or k == ir.TY_U32 {
        32
    } else {
        64
    }
}

/// The bit methods at the receiver's width ([L-LIB-BITS-WIDTH]), as the
/// Cranelift build's `bits_at_width` computes them: the value's bits at its
/// width, masked off from the 64 it is held in, the operation, and the
/// result read back at that width. `x` is the receiver, of kind `rk`.
/// Answers -1 for a method that is not one of them.
fn bits_method(info: TirInfo, inout v: Vir, e: i64, name: str, x: i64, rk: i64) -> i64 {
    let t = info.t
    if not (name == "count_ones" or name == "leading_zeros" or name == "trailing_zeros" or name == "swap_bytes" or name == "rotate_left" or name == "rotate_right") {
        return -1
    }
    let w = int_width(rk)
    var xm = x
    if w < 64 {
        let mask = konst(v, 1.shl(w) - 1)
        xm = op2(v, ir.M_AND, x, mask)
    }
    if name == "count_ones" {
        // Bits counted in parallel: pairs, nibbles, bytes, then the bytes
        // summed into the top one by a multiply.
        let one = konst(v, 1)
        let m1 = konst(v, 0x5555555555555555)
        let h1 = op2(v, ir.M_USHR, xm, one)
        let p1 = op2(v, ir.M_AND, h1, m1)
        let s1 = op2(v, ir.M_SUB, xm, p1)
        let two = konst(v, 2)
        let m2 = konst(v, 0x3333333333333333)
        let lo2 = op2(v, ir.M_AND, s1, m2)
        let h2 = op2(v, ir.M_USHR, s1, two)
        let hi2 = op2(v, ir.M_AND, h2, m2)
        let s2 = op2(v, ir.M_ADD, lo2, hi2)
        let four = konst(v, 4)
        let h4 = op2(v, ir.M_USHR, s2, four)
        let s4 = op2(v, ir.M_ADD, s2, h4)
        let m4 = konst(v, 0x0F0F0F0F0F0F0F0F)
        let s8 = op2(v, ir.M_AND, s4, m4)
        let ones = konst(v, 0x0101010101010101)
        let prod = op2(v, ir.M_MUL, s8, ones)
        let k56 = konst(v, 56)
        return op2(v, ir.M_USHR, prod, k56)
    }
    if name == "leading_zeros" {
        let z = op1(v, ir.M_CLZ, xm)
        let d = konst(v, 64 - w)
        return op2(v, ir.M_SUB, z, d)
    }
    if name == "trailing_zeros" {
        // A bit just past the width stops the count there, so a zero
        // answers the width.
        var fenced = xm
        if w < 64 {
            let top = konst(v, 1.shl(w))
            fenced = op2(v, ir.M_OR, xm, top)
        }
        let rb = op1(v, ir.M_RBIT, fenced)
        return op1(v, ir.M_CLZ, rb)
    }
    var out = -1
    if name == "swap_bytes" {
        out = if w == 8 { xm } else if w == 16 { op1(v, ir.M_BSWAP16, xm) } else if w == 32 { op1(v, ir.M_BSWAP32, xm) } else { op1(v, ir.M_BSWAP64, xm) }
    } else {
        // Turned modulo the width, as Rust's `rotate_left(n as u32)`.
        let n = value_of(info, v, sexp.kids(t, e)[1])
        let wm = konst(v, w - 1)
        let c = op2(v, ir.M_AND, n, wm)
        if w == 64 {
            if name == "rotate_right" {
                out = op2(v, ir.M_ROTR, xm, c)
            } else {
                // Left by c is right by -c, modulo 64.
                let nc = op1(v, ir.M_NEG, c)
                out = op2(v, ir.M_ROTR, xm, nc)
            }
        } else {
            var left = c
            if name == "rotate_right" {
                let wk = konst(v, w)
                let back = op2(v, ir.M_SUB, wk, c)
                left = op2(v, ir.M_AND, back, wm)
            }
            let wk2 = konst(v, w)
            let right = op2(v, ir.M_SUB, wk2, left)
            let hi = op2(v, ir.M_SHL, xm, left)
            let lo = op2(v, ir.M_USHR, xm, right)
            let both = op2(v, ir.M_OR, hi, lo)
            let mask = konst(v, 1.shl(w) - 1)
            out = op2(v, ir.M_AND, both, mask)
        }
    }
    // Read back at the width: a signed one sign-extends its top bit.
    wrap(v, rk, out)
}

/// `o.unwrap_or(d)` and `o.expect(msg)`: the payload, or (computed only
/// then) the default or the panic.
fn option_method(info: TirInfo, inout v: Vir, e: i64, name: str) -> i64 {
    let t = info.t
    let ks = sexp.kids(t, e)
    let o = value_of(info, v, ks[0])
    let sn = text_args(v, "Some")
    let c = rt(v, "grasm_variant_is", [o, sn[0], sn[1]], R_BOOL8)
    if name == "is_some" or name == "is_none" {
        drop_temp(v, o)
        if name == "is_none" {
            let one = konst(v, 1)
            return op2(v, ir.M_XOR, c, one)
        }
        return c
    }
    let rk = kind_at(t, e, 1)
    var r = -1
    if valued(rk) {
        r = new_var(v, rk)
    }
    let yes = new_block(v)
    let no = new_block(v)
    let join = new_block(v)
    term_brif(v, c, yes, no)
    switch_to(v, yes)
    let zero = konst(v, 0)
    let pb = rt(v, "grasm_variant_field", [o, zero], R_BOX)
    drop_temp(v, o)
    let p = unbox_kind(v, pb, rk)
    branch_value(v, r, p)
    if v.open {
        term_jump(v, join)
    }
    own_temp(v, o)
    switch_to(v, no)
    drop_temp(v, o)
    if name == "unwrap_or" {
        let y = lower_expr(info, v, ks[1])
        branch_value(v, r, y)
        if v.open {
            term_jump(v, join)
        }
    } else {
        let msg = value_of(info, v, ks[1])
        callrt(v, ir.RT_PANIC_VALUE, [msg])
    }
    switch_to(v, join)
    joined_value(v, r)
}

fn lower_method(info: TirInfo, inout v: Vir, e: i64) -> i64 {
    let t = info.t
    let name = sexp.word(t, e, 3)
    let ks = sexp.kids(t, e)
    let rte = ty_el(t, ks[0], 1)
    let fam = method_family(t, rte)
    let na = ks.len() - 1
    let rk = kind_at(t, e, 1)
    let sig = "{fam}.{name}/{na}"
    if sig == "range.to_list/0" or sig == "range.len/0" or sig == "range.sum/0" {
        return range_method(info, v, e, name)
    }
    if fam == "addr" {
        return addr_method(info, v, e, name)
    }
    if sig == "list.par_map/1" or sig == "list.par_filter/1" {
        if not held(rk) or not ir.ty_boxed(kind_at(t, ks[1], 1)) {
            bad(v, "outside the subset: method `{name}` on {ty_text(t, ks[0], 1)} {span_of(t, e)}")
            return konst(v, 0)
        }
        return par_method(info, v, e, name)
    }
    if hof_known(sig) {
        if not held(rk) {
            bad(v, "outside the subset: method `{name}` answering {ty_text(t, e, 1)} {span_of(t, e)}")
            return konst(v, 0)
        }
        return hof_method(info, v, e, name)
    }
    if not held(rk) or not method_known(sig) {
        bad(v, "outside the subset: method `{name}` on {ty_text(t, ks[0], 1)} {span_of(t, e)}")
        return konst(v, 0)
    }
    match sig {
        "str.len/0" -> read_method(info, v, e, "grasm_str_len", "", [], R_WORD)
        "str.byte_len/0" -> read_method(info, v, e, "grasm_str_byte_len", "", [], R_WORD)
        "str.is_empty/0" -> read_method(info, v, e, "grasm_str_is_empty", "", [], R_BOOL8)
        "str.chars/0" -> read_method(info, v, e, "grasm_str_chars", "", [], R_BOX)
        "str.codes/0" -> read_method(info, v, e, "grasm_str_codes", "", [], R_BOX)
        "str.substr/2" -> read_method(info, v, e, "grasm_str_substr", "ww", [], R_BOX)
        "str.split/1" -> read_method(info, v, e, "grasm_str_split", "b", [], R_BOX)
        "str.contains/1" -> read_method(info, v, e, "grasm_str_contains", "b", [], R_BOOL8)
        "str.starts_with/1" -> read_method(info, v, e, "grasm_str_starts_with", "b", [], R_BOOL8)
        "str.ends_with/1" -> read_method(info, v, e, "grasm_str_ends_with", "b", [], R_BOOL8)
        "str.index_of/1" -> read_method(info, v, e, "grasm_str_index_of", "b", [], R_BOX)
        "str.to_lower/0" -> read_method(info, v, e, "grasm_str_lower", "", [], R_BOX)
        "str.to_upper/0" -> read_method(info, v, e, "grasm_str_upper", "", [], R_BOX)
        "str.trim/0" -> read_method(info, v, e, "grasm_str_trim", "", [], R_BOX)
        "str.trim_start/0" -> read_method(info, v, e, "grasm_str_trim_start", "", [], R_BOX)
        "str.trim_end/0" -> read_method(info, v, e, "grasm_str_trim_end", "", [], R_BOX)
        "str.replace/2" -> read_method(info, v, e, "grasm_str_replace", "bb", [], R_BOX)
        "str.repeat/1" -> read_method(info, v, e, "grasm_str_repeat", "w", [], R_BOX)
        "str.pad_start/2" -> read_method(info, v, e, "grasm_str_pad", "wb", [konst(v, 1)], R_BOX)
        "str.pad_end/2" -> read_method(info, v, e, "grasm_str_pad", "wb", [konst(v, 0)], R_BOX)
        "str.parse_int/0" -> read_method(info, v, e, "grasm_str_parse_int", "", [], R_BOX)
        "str.parse_int_base/1" -> read_method(info, v, e, "grasm_str_parse_int_base", "w", [], R_BOX)
        "str.parse_u64/0" -> read_method(info, v, e, "grasm_str_parse_u64", "", [], R_BOX)
        "str.parse_u64_base/1" -> read_method(info, v, e, "grasm_str_parse_u64_base", "w", [], R_BOX)
        "str.code_at/1" -> read_method(info, v, e, "grasm_str_code_at", "w", [], R_WORD)
        "str.lines/0" -> read_method(info, v, e, "grasm_str_lines", "", [], R_BOX)
        "str.words/0" -> read_method(info, v, e, "grasm_str_words", "", [], R_BOX)
        "str.to_bytes/0" -> read_method(info, v, e, "grasm_str_to_bytes", "", [], R_BOX)
        "list.len/0" -> read_method(info, v, e, "grasm_list_len", "", [], R_WORD)
        "list.is_empty/0" -> read_method(info, v, e, "grasm_list_is_empty", "", [], R_BOOL8)
        "list.get/1" -> read_method(info, v, e, "grasm_list_get_opt", "w", [], R_BOX)
        "list.contains/1" -> read_method(info, v, e, "grasm_list_contains", "x", [], R_BOOL8)
        "list.join/1" -> read_method(info, v, e, "grasm_list_join", "b", [], R_BOX)
        "list.sum/0" -> {
            if ir.ty_fp(rk) {
                read_method(info, v, e, "grasm_list_sum_f64", "", [], R_F64)
            } else {
                wrap_result(v, t, e, read_method(info, v, e, "grasm_list_sum_i64", "", [], R_WORD))
            }
        }
        "list.rev/0" -> read_method(info, v, e, "grasm_list_rev", "", [], R_BOX)
        "list.slice/2" -> read_method(info, v, e, "grasm_list_slice", "ww", [], R_BOX)
        "list.first/0" -> read_method(info, v, e, "grasm_list_first", "", [], R_BOX)
        "list.last/0" -> read_method(info, v, e, "grasm_list_last", "", [], R_BOX)
        "list.min/0" -> read_method(info, v, e, "grasm_list_min_max", "", [konst(v, 0)], R_BOX)
        "list.max/0" -> read_method(info, v, e, "grasm_list_min_max", "", [konst(v, 1)], R_BOX)
        "list.enumerate/0" -> read_method(info, v, e, "grasm_list_enumerate", "", [], R_BOX)
        "list.zip/1" -> read_method(info, v, e, "grasm_list_zip", "b", [], R_BOX)
        "list.push/1" -> mut_method(info, v, e, "grasm_list_push", "P", [])
        "list.sort/0" -> mut_method(info, v, e, "grasm_list_sort", "", [])
        "list.pop/0" -> out_method(info, v, e, "grasm_list_pop", "", "pop")
        "list.remove/1" -> out_method(info, v, e, "grasm_list_remove", "w", "remove")
        "bytes.len/0" -> read_method(info, v, e, "grasm_bytes_len", "", [], R_WORD)
        "bytes.is_empty/0" -> {
            let n = read_method(info, v, e, "grasm_bytes_len", "", [], R_WORD)
            let z = konst(v, 0)
            icmp(v, ir.CC_EQ, n, z)
        }
        "bytes.at/1" -> read_method(info, v, e, "grasm_bytes_at", "w", [], R_WORD)
        "bytes.slice/2" -> read_method(info, v, e, "grasm_bytes_slice", "ww", [], R_BOX)
        "bytes.to_str/0" -> read_method(info, v, e, "grasm_bytes_to_str", "", [], R_BOX)
        "bytes.to_list/0" -> read_method(info, v, e, "grasm_bytes_to_list", "", [], R_BOX)
        "bytes.concat/1" -> read_method(info, v, e, "grasm_bytes_concat", "b", [], R_BOX)
        "bytes.index_of/2" -> read_method(info, v, e, "grasm_bytes_index_of", "ww", [], R_BOX)
        "bytes.set/2" -> mut_method(info, v, e, "grasm_bytes_set", "ww", [])
        "bytes.fill/1" -> mut_method(info, v, e, "grasm_bytes_fill", "w", [])
        "bytes.copy_from/2" -> mut_method(info, v, e, "grasm_bytes_copy_from", "wB", [])
        "map.len/0" -> read_method(info, v, e, "grasm_map_len", "", [], R_WORD)
        "map.is_empty/0" -> read_method(info, v, e, "grasm_map_is_empty", "", [], R_BOOL8)
        "map.get/1" -> read_method(info, v, e, "grasm_map_get", "x", [], R_BOX)
        "map.has/1" -> read_method(info, v, e, "grasm_map_has", "x", [], R_BOOL8)
        "map.keys/0" -> read_method(info, v, e, "grasm_map_keys", "", [], R_BOX)
        "map.values/0" -> read_method(info, v, e, "grasm_map_values", "", [], R_BOX)
        "map.entries/0" -> read_method(info, v, e, "grasm_map_entries", "", [], R_BOX)
        "map.set/2" -> mut_method(info, v, e, "grasm_map_set", "XX", [])
        "map.delete/1" -> out_method(info, v, e, "grasm_map_delete", "B", "delete")
        "option.is_some/0" -> option_method(info, v, e, name)
        "option.is_none/0" -> option_method(info, v, e, name)
        "option.unwrap_or/1" -> option_method(info, v, e, name)
        "option.expect/1" -> option_method(info, v, e, name)
        "str.parse_float/0" -> read_method(info, v, e, "grasm_str_parse_float", "", [], R_BOX)
        "strbuilder.len/0" -> read_method(info, v, e, "grasm_builder_len", "", [], R_WORD)
        "bytebuilder.len/0" -> read_method(info, v, e, "grasm_builder_len", "", [], R_WORD)
        "strbuilder.is_empty/0" -> {
            let n = read_method(info, v, e, "grasm_builder_len", "", [], R_WORD)
            let z = konst(v, 0)
            icmp(v, ir.CC_EQ, n, z)
        }
        "bytebuilder.is_empty/0" -> {
            let n = read_method(info, v, e, "grasm_builder_len", "", [], R_WORD)
            let z = konst(v, 0)
            icmp(v, ir.CC_EQ, n, z)
        }
        "strbuilder.to_str/0" -> read_method(info, v, e, "grasm_builder_to_str", "", [], R_BOX)
        "bytebuilder.to_str/0" -> read_method(info, v, e, "grasm_builder_to_str", "", [], R_BOX)
        "bytebuilder.to_bytes/0" -> read_method(info, v, e, "grasm_bytebuf_to_bytes", "", [], R_BOX)
        "bytebuilder.at/1" -> read_method(info, v, e, "grasm_bytebuf_at", "w", [], R_WORD)
        "strbuilder.push_str/1" -> mut_method(info, v, e, "grasm_builder_push_str", "B", [])
        "bytebuilder.push_str/1" -> mut_method(info, v, e, "grasm_builder_push_str", "B", [])
        "bytebuilder.push_byte/1" -> mut_method(info, v, e, "grasm_bytebuf_push_byte", "w", [])
        "bytebuilder.push_bytes/1" -> mut_method(info, v, e, "grasm_bytebuf_push_bytes", "B", [])
        "bytebuilder.set/2" -> mut_method(info, v, e, "grasm_bytebuf_set", "ww", [])
        _ -> {
            if name == "cmp" and na == 1 {
                return cmp_method(info, v, e)
            }
            if fam == "f64" {
                return f64_method(info, v, e, name)
            }
            int_method(info, v, e, name, fam == "u64")
        }
    }
}

/// `a.cmp(b)`: the total order sorting uses ([L-LIB-SORT-NAN]), asked of the
/// runtime on both values boxed, as the Cranelift build asks it.
fn cmp_method(info: TirInfo, inout v: Vir, e: i64) -> i64 {
    let t = info.t
    let ks = sexp.kids(t, e)
    let a = value_of(info, v, ks[0])
    let ab = box_kind(v, a, kind_at(t, ks[0], 1))
    let b = value_of(info, v, ks[1])
    let bb = box_kind(v, b, kind_at(t, ks[1], 1))
    let r = rt(v, "grasm_val_cmp", [ab, bb], R_WORD)
    drop_temp(v, ab)
    drop_temp(v, bb)
    r
}

/// The methods of `f64`, as the Cranelift build lowers each: `abs`, `sqrt`,
/// `floor` and `ceil` as one instruction; `round` (halves away from zero,
/// which no instruction does), `min`, `max` and the math library by the
/// runtime; conversions to an integer toward zero and saturating, NaN to 0.
fn f64_method(info: TirInfo, inout v: Vir, e: i64, name: str) -> i64 {
    let t = info.t
    let ks = sexp.kids(t, e)
    if name == "to_str" {
        return read_method(info, v, e, "grasm_str_from_f64", "", [], R_BOX)
    }
    if name == "to_fixed" {
        return read_method(info, v, e, "grasm_f64_to_fixed", "w", [], R_BOX)
    }
    if name == "is_nan" or name == "is_finite" {
        return read_method(info, v, e, "grasm_f64_" + name, "", [], R_BOOL8)
    }
    if name == "round" or name == "min" or name == "max" or f64_libm(name) {
        return read_method(info, v, e, "grasm_f64_" + name, "w", [], R_F64)
    }
    let x = value_of(info, v, ks[0])
    match name {
        "abs" -> fop1(v, ir.M_FABS, x)
        "sqrt" -> fop1(v, ir.M_FSQRT, x)
        "floor" -> fop1(v, ir.M_FFLOOR, x)
        "ceil" -> fop1(v, ir.M_FCEIL, x)
        "to_bits" -> fbits(v, x)
        "as_i64" -> op1(v, ir.M_FCVTZS, x)
        "as_u64" -> {
            let d = new_var(v, ir.TY_U64)
            emit(v, ir.M_FCVTZU, d, x, -1, 0)
            d
        }
        _ -> {
            // `as_i8` .. `as_u32`: toward zero and saturating to an `i64`,
            // then held to the width's range.
            let k = kind_at(t, e, 1)
            if not (name.starts_with("as_") and ir.ty_int(k)) {
                bad(v, "outside the subset: method `{name}` on f64 {span_of(t, e)}")
                return x
            }
            let wide = op1(v, ir.M_FCVTZS, x)
            let (lo, hi) = int_range(k)
            clamp(v, wide, lo, hi, k)
        }
    }
}

/// The math library's one- and two-argument functions of a double.
fn f64_libm(name: str) -> bool {
    match name {
        "sin" -> true
        "cos" -> true
        "tan" -> true
        "asin" -> true
        "acos" -> true
        "atan" -> true
        "sinh" -> true
        "cosh" -> true
        "tanh" -> true
        "exp" -> true
        "ln" -> true
        "log2" -> true
        "log10" -> true
        "cbrt" -> true
        "to_radians" -> true
        "to_degrees" -> true
        "atan2" -> true
        "hypot" -> true
        "log" -> true
        _ -> false
    }
}

/// The smallest and largest value of a narrow integer type.
fn int_range(k: i64) -> (i64, i64) {
    if k == ir.TY_I8 {
        (-128, 127)
    } else if k == ir.TY_I16 {
        (-32768, 32767)
    } else if k == ir.TY_I32 {
        (-2147483648, 2147483647)
    } else if k == ir.TY_U8 {
        (0, 255)
    } else if k == ir.TY_U16 {
        (0, 65535)
    } else if k == ir.TY_U32 {
        (0, 4294967295)
    } else {
        (-9223372036854775807 - 1, 9223372036854775807)
    }
}

/// `x` held to `lo..=hi`, signed: Cranelift's `smax` then `smin`.
fn clamp(inout v: Vir, x: i64, lo: i64, hi: i64, k: i64) -> i64 {
    let r = new_var(v, k)
    copy_to(v, r, x)
    let lk = konst(v, lo)
    let below = icmp(v, ir.CC_SLT, r, lk)
    let set_lo = new_block(v)
    let mid = new_block(v)
    term_brif(v, below, set_lo, mid)
    switch_to(v, set_lo)
    copy_to(v, r, lk)
    term_jump(v, mid)
    switch_to(v, mid)
    let hk = konst(v, hi)
    let above = icmp(v, ir.CC_SGT, r, hk)
    let set_hi = new_block(v)
    let join = new_block(v)
    term_brif(v, above, set_hi, join)
    switch_to(v, set_hi)
    copy_to(v, r, hk)
    term_jump(v, join)
    switch_to(v, join)
    r
}

/// The higher-order methods, which take a function (`hof_method`).
pub fn hof_known(sig: str) -> bool {
    match sig {
        "list.map/1" -> true
        "list.filter/1" -> true
        "list.all/1" -> true
        "list.any/1" -> true
        "list.find/1" -> true
        "list.fold/2" -> true
        "list.sort_by/1" -> true
        "range.map/1" -> true
        "range.filter/1" -> true
        _ -> false
    }
}

/// The methods this part compiles, as `family.name/arguments`: the same
/// list `scripts/s3_subset.py` states (`METHODS`).
pub fn method_known(sig: str) -> bool {
    match sig {
        "str.len/0" -> true
        "str.byte_len/0" -> true
        "str.is_empty/0" -> true
        "str.chars/0" -> true
        "str.codes/0" -> true
        "str.substr/2" -> true
        "str.split/1" -> true
        "str.contains/1" -> true
        "str.starts_with/1" -> true
        "str.ends_with/1" -> true
        "str.index_of/1" -> true
        "str.to_lower/0" -> true
        "str.to_upper/0" -> true
        "str.trim/0" -> true
        "str.trim_start/0" -> true
        "str.trim_end/0" -> true
        "str.replace/2" -> true
        "str.repeat/1" -> true
        "str.pad_start/2" -> true
        "str.pad_end/2" -> true
        "str.parse_int/0" -> true
        "str.parse_int_base/1" -> true
        "str.parse_u64/0" -> true
        "str.parse_u64_base/1" -> true
        "str.code_at/1" -> true
        "str.lines/0" -> true
        "str.words/0" -> true
        "str.to_bytes/0" -> true
        "list.len/0" -> true
        "list.is_empty/0" -> true
        "list.get/1" -> true
        "list.contains/1" -> true
        "list.join/1" -> true
        "list.sum/0" -> true
        "list.rev/0" -> true
        "list.slice/2" -> true
        "list.first/0" -> true
        "list.last/0" -> true
        "list.min/0" -> true
        "list.max/0" -> true
        "list.enumerate/0" -> true
        "list.zip/1" -> true
        "list.push/1" -> true
        "list.sort/0" -> true
        "list.pop/0" -> true
        "list.remove/1" -> true
        "bytes.len/0" -> true
        "bytes.is_empty/0" -> true
        "bytes.at/1" -> true
        "bytes.slice/2" -> true
        "bytes.to_str/0" -> true
        "bytes.to_list/0" -> true
        "bytes.concat/1" -> true
        "bytes.index_of/2" -> true
        "bytes.set/2" -> true
        "bytes.fill/1" -> true
        "bytes.copy_from/2" -> true
        "map.len/0" -> true
        "map.is_empty/0" -> true
        "map.get/1" -> true
        "map.has/1" -> true
        "map.keys/0" -> true
        "map.values/0" -> true
        "map.entries/0" -> true
        "map.set/2" -> true
        "map.delete/1" -> true
        "option.is_some/0" -> true
        "option.is_none/0" -> true
        "option.unwrap_or/1" -> true
        "option.expect/1" -> true
        "int.bit_and/1" -> true
        "int.bit_or/1" -> true
        "int.bit_xor/1" -> true
        "int.bit_not/0" -> true
        "int.shl/1" -> true
        "int.shr/1" -> true
        "int.ushr/1" -> true
        "int.to_char/0" -> true
        "int.to_str/0" -> true
        "int.to_base/1" -> true
        "int.abs/0" -> true
        "int.min/1" -> true
        "int.max/1" -> true
        "u64.bit_and/1" -> true
        "u64.bit_or/1" -> true
        "u64.bit_xor/1" -> true
        "u64.bit_not/0" -> true
        "u64.shl/1" -> true
        "u64.shr/1" -> true
        "u64.ushr/1" -> true
        "u64.to_char/0" -> true
        "u64.to_str/0" -> true
        "u64.to_base/1" -> true
        "u64.abs/0" -> true
        "u64.min/1" -> true
        "u64.max/1" -> true
        "int.as_f64/0" -> true
        "u64.as_f64/0" -> true
        "int.from_bits/0" -> true
        "str.parse_float/0" -> true
        "int.cmp/1" -> true
        "u64.cmp/1" -> true
        "f64.cmp/1" -> true
        "str.cmp/1" -> true
        "tuple.cmp/1" -> true
        "strbuilder.len/0" -> true
        "bytebuilder.len/0" -> true
        "strbuilder.is_empty/0" -> true
        "bytebuilder.is_empty/0" -> true
        "strbuilder.to_str/0" -> true
        "bytebuilder.to_str/0" -> true
        "bytebuilder.to_bytes/0" -> true
        "bytebuilder.at/1" -> true
        "strbuilder.push_str/1" -> true
        "bytebuilder.push_str/1" -> true
        "bytebuilder.push_byte/1" -> true
        "bytebuilder.push_bytes/1" -> true
        "bytebuilder.set/2" -> true
        _ -> int_conversion(sig) or f64_known(sig) or int_bits_known(sig)
    }
}

/// The integer methods at a width ([L-LIB-BITS-WIDTH], [L-LIB-INT-CONV]):
/// the bit operations, the checked and saturating arithmetic, and the
/// conversions that answer `None` when the value does not fit.
fn int_bits_known(sig: str) -> bool {
    if not (sig.starts_with("int.") or sig.starts_with("u64.")) {
        return false
    }
    let rest = sig.split(".")[1]
    let name = rest.split("/")[0]
    let n = rest.split("/")[1]
    if n == "0" {
        if name == "count_ones" or name == "leading_zeros" or name == "trailing_zeros" or name == "swap_bytes" {
            return true
        }
        return name.starts_with("try_") and ir.ty_int(ir.ty_of_name(name.substr(4, name.len() - 4)))
    }
    if n == "1" {
        return name == "rotate_left" or name == "rotate_right" or name == "checked_add" or name == "checked_sub" or name == "checked_mul" or name == "saturating_add" or name == "saturating_sub" or name == "saturating_mul"
    }
    false
}

/// The methods of `f64` this part compiles (`f64_method`).
fn f64_known(sig: str) -> bool {
    if not sig.starts_with("f64.") {
        return false
    }
    let rest = sig.substr(4, sig.len() - 4)
    let parts = rest.split("/")
    let name = parts[0]
    let n = parts[1].parse_int() ?? -1
    if n == 0 {
        if name == "abs" or name == "sqrt" or name == "floor" or name == "ceil" or name == "round" or name == "to_bits" or name == "to_str" or name == "is_nan" or name == "is_finite" or name == "as_i64" or name == "as_u64" {
            return true
        }
        if name.starts_with("as_") and ir.ty_int(ir.ty_of_name(name.substr(3, name.len() - 3))) {
            return true
        }
        return f64_libm(name) and name != "atan2" and name != "hypot" and name != "log"
    }
    if n == 1 {
        return name == "min" or name == "max" or name == "atan2" or name == "hypot" or name == "log" or name == "to_fixed"
    }
    false
}

/// `as_i64`, `as_u64`, `as_i8` ... on any integer: a wrap to the width.
fn int_conversion(sig: str) -> bool {
    if not (sig.starts_with("int.as_") or sig.starts_with("u64.as_")) or not sig.ends_with("/0") {
        return false
    }
    let w = sig.split(".as_")[1].split("/")[0]
    ir.ty_int(ir.ty_of_name(w))
}

// ----- places ------------------------------------------------------------------------
//
// A place -- what an assignment writes or a mutating method changes -- is a
// local and a path below it: struct fields, list elements, and hops through
// references, each a step from the root. A field or an element of what a
// reference points at is reached through it with no step of its own in
// TIR ([T-REF-WRITE]); the path here makes each such hop a step, so a write
// can be told where it lands: in the shared heap, below the last reference
// it crosses, or in the local, when it crosses none.

/// A struct field (`key` its position).
let STEP_FIELD = 0
/// A list element (`key` the index's TIR node, then its value).
let STEP_INDEX = 1
/// Through a reference to what it points at.
let STEP_DEREF = 2

type PlacePath = {
    ok: bool,
    root_id: i64,
    root: i64,
    kinds: [i64],
    keys: [i64],
    names: [str],
    /// `tes[j]` is the type element of what step `j` is taken from;
    /// `tes[n]` the leaf's.
    tes: [i64],
    why: str,
}

/// The place `target` names. `typed` for one written as an expression (a
/// method's receiver: `(field T @s k x)`), else as an assignment's target
/// (`(field k @s x)`, whose root is typed by its binding).
fn place_path(info: TirInfo, inout v: Vir, target: i64, typed: bool) -> PlacePath {
    let t = info.t
    var pp = PlacePath{ ok: false, root_id: -1, root: -1, kinds: [], keys: [], names: [], tes: [], why: "" }
    var sk: [i64] = []
    var sx: [i64] = []
    var p = target
    while true {
        let k = sexp.kw(t, p)
        if k == "field" {
            sk.push(STEP_FIELD)
            sx.push(sexp.word(t, p, if typed { 3 } else { 1 }).parse_int() ?? 0)
            p = sexp.kids(t, p)[0]
        } else if k == "index" {
            let pk = sexp.kids(t, p)
            sk.push(STEP_INDEX)
            sx.push(pk[1])
            p = pk[0]
        } else if k == "deref" {
            sk.push(STEP_DEREF)
            sx.push(-1)
            p = sexp.kids(t, p)[0]
        } else {
            break
        }
    }
    if sexp.kw(t, p) != "local" {
        pp.why = "through a `{sexp.kw(t, p)}`"
        return pp
    }
    pp.root_id = sexp.word(t, p, if typed { 3 } else { 1 }).parse_int() ?? -1
    var te = if typed { ty_el(t, p, 1) } else { v.tvty.get(pp.root_id) ?? -1 }
    var j = sk.len() - 1
    while j >= 0 {
        if sk[j] == STEP_DEREF {
            if not is_ref_te(t, te) {
                pp.why = "a `deref` of a value that is not a reference"
                return pp
            }
            pp.kinds.push(STEP_DEREF)
            pp.keys.push(-1)
            pp.names.push("")
            pp.tes.push(te)
            te = sexp.at(t, te, 1)
            j -= 1
            continue
        }
        while is_ref_te(t, te) {
            pp.kinds.push(STEP_DEREF)
            pp.keys.push(-1)
            pp.names.push("")
            pp.tes.push(te)
            te = sexp.at(t, te, 1)
        }
        var child = -1
        var name = ""
        if sk[j] == STEP_FIELD {
            let body = type_body(info, te)
            if body >= 0 and sexp.kw(t, body) == "struct" and sx[j] < sexp.kids(t, body).len() {
                let fd = sexp.kids(t, body)[sx[j]]
                child = field_te(info, te, -1, sx[j], sexp.at(t, fd, 2))
                name = sexp.word(t, fd, 1)
            }
        } else if ty_head(t, te) == "list" {
            child = ty_arg(t, te, 1)
        }
        if child < 0 or has_generic(t, child) or not held(ty_kind(t, child)) {
            pp.why = "through this path"
            return pp
        }
        pp.kinds.push(sk[j])
        pp.keys.push(sx[j])
        pp.names.push(name)
        pp.tes.push(te)
        te = child
        j -= 1
    }
    pp.tes.push(te)
    pp.root = tvar_of(v, pp.root_id)
    pp.ok = true
    pp
}

/// The last step of `pp` that crosses a reference, or -1.
fn last_deref(pp: PlacePath) -> i64 {
    var j = pp.kinds.len() - 1
    while j >= 0 {
        if pp.kinds[j] == STEP_DEREF {
            return j
        }
        j -= 1
    }
    -1
}

/// The values of a path's keys, left to right: an element's index computed,
/// a field's position as it is.
fn path_keys(info: TirInfo, inout v: Vir, pp: PlacePath) -> [i64] {
    var kv: [i64] = []
    for j in 0..pp.kinds.len() {
        if pp.kinds[j] == STEP_INDEX {
            kv.push(value_of(info, v, pp.keys[j]))
        } else {
            kv.push(pp.keys[j])
        }
    }
    kv
}

/// What the place holds before step `upto` (`upto = n` for the leaf), read
/// down from the root and owned by the caller when boxed: each container on
/// the way retained and released once its child is read, each reference read
/// through the shared heap.
fn read_path(inout v: Vir, t: TirTree, pp: PlacePath, kv: [i64], upto: i64) -> i64 {
    var cur = pp.root
    var owned = false
    for j in 0..upto {
        var nx = -1
        if pp.kinds[j] == STEP_DEREF {
            let b = rt(v, "grasm_ref_get", [cur], R_BOX)
            nx = unbox_kind(v, b, ty_kind(t, pp.tes[j + 1]))
        } else {
            nx = read_child(v, t, cur, pp.kinds[j] == STEP_FIELD, kv[j], pp.tes[j + 1])
        }
        if owned and is_temp(v, cur) {
            drop_temp(v, cur)
        }
        cur = nx
        owned = true
    }
    if not owned {
        if ir.ty_boxed(ty_kind(t, pp.tes[upto])) {
            return retain_copy(v, cur)
        }
        let d = new_var(v, ty_kind(t, pp.tes[upto]))
        copy_to(v, d, cur)
        return d
    }
    cur
}

/// Below container `base` (held by the caller, of type `pp.tes[from]`),
/// steps `from .. n` of a path that crosses no reference: each container on
/// the way down taken out of its parent when the parent has no other holder
/// (`grasm_struct_take`, `grasm_list_take`) -- so a sole owner is written in
/// place, as the Cranelift build's `write_place` takes it -- else retained;
/// the leaf replaced by `x`, or combined with it by `op`; each container
/// written back into its parent. Answers the new `base`, owned, for the
/// caller to store.
fn write_steps(inout v: Vir, t: TirTree, pp: PlacePath, kv: [i64], from: i64, base: i64, op: str, x: i64, where_: str) -> i64 {
    let n = pp.kinds.len()
    var cs: [i64] = [base]
    for j in (from + 1)..n {
        cs.push(take_child(v, cs[cs.len() - 1], pp.kinds[j - 1] == STEP_FIELD, kv[j - 1], pp.names[j - 1]))
    }
    let leafc = cs[cs.len() - 1]
    var fin = x
    if op != "set" {
        let old = read_child(v, t, leafc, pp.kinds[n - 1] == STEP_FIELD, kv[n - 1], pp.tes[n])
        fin = combine(v, t, op, pp.tes[n], old, x, where_)
    }
    var nv = write_child(v, t, leafc, pp.kinds[n - 1] == STEP_FIELD, kv[n - 1], pp.tes[n], fin)
    var j = n - 2
    while j >= from {
        nv = write_child(v, t, cs[j - from], pp.kinds[j] == STEP_FIELD, kv[j], pp.tes[j + 1], nv)
        j -= 1
    }
    nv
}

/// `old <op> x` for a compound assignment, at type element `te`: a string
/// appended to (both owned; the result owned), or arithmetic.
fn combine(inout v: Vir, t: TirTree, op: str, te: i64, old: i64, x: i64, where_: str) -> i64 {
    let vk = ty_kind(t, te)
    if op == "add" and is_ty(t, te, "str") {
        forget_temp(v, old)
        let r = rt(v, "grasm_str_append", [old, x], R_BOX)
        drop_temp(v, x)
        return r
    }
    if ir.ty_int(vk) {
        return arith(v, op, vk, old, x)
    }
    if ir.ty_fp(vk) {
        return farith(v, op, old, x, where_)
    }
    bad(v, "outside the subset: `{op}=` on this type {where_}")
    old
}

/// `a.f[i].g = x` and its compound forms: the indices first, left to right,
/// then the value ([E-ORDER-LTR]). A path that crosses no reference is
/// written as the Cranelift build's `write_place` writes it, by the runtime's
/// copy-on-write setters, the variable last. One that crosses a reference
/// writes into the shared heap below the last one it crosses, and nothing
/// above that changes: the containers down to it are only read. What that
/// reference points at is made the slot's only holder
/// (`grasm_ref_make_unique`) and written in place, or, when the path ends at
/// it (`r.value = x`), replaced whole (`grasm_ref_set`).
fn lower_place_assign(info: TirInfo, inout v: Vir, e: i64) -> i64 {
    let t = info.t
    let op = sexp.word(t, e, 1)
    let ks = sexp.kids(t, e)
    let pp = place_path(info, v, ks[0], false)
    if not pp.ok {
        bad(v, "outside the subset: an assignment {pp.why} {span_of(t, ks[1])}")
        return -1
    }
    let n = pp.kinds.len()
    let kv = path_keys(info, v, pp)
    let x = value_of(info, v, ks[1])
    let where_ = span_of(t, ks[1])
    let l = last_deref(pp)
    if l < 0 {
        let nv = write_steps(v, t, pp, kv, 0, pp.root, op, x, where_)
        copy_to(v, pp.root, nv)
        forget_temp(v, nv)
        return -1
    }
    let raw = read_path(v, t, pp, kv, l)
    if l == n - 1 {
        // The referent itself: replaced whole, by what it becomes.
        var fin = x
        if op != "set" {
            let b = rt(v, "grasm_ref_get", [raw], R_BOX)
            let old = unbox_kind(v, b, ty_kind(t, pp.tes[n]))
            fin = combine(v, t, op, pp.tes[n], old, x, where_)
        }
        let fb = box_kind(v, fin, ty_kind(t, pp.tes[n]))
        forget_temp(v, fb)
        rt(v, "grasm_ref_set", [raw, fb], R_VOID)
        return -1
    }
    // Borrowed: the heap keeps its reference, and the setters below change
    // the referent where it lies, answering it back.
    let referent = rt(v, "grasm_ref_make_unique", [raw], R_WORD)
    v.vty[referent] = ir.TY_BOX
    let nv = write_steps(v, t, pp, kv, l + 1, referent, op, x, where_)
    forget_temp(v, nv)
    -1
}

/// Leaves the function with `x` (an owned temporary when boxed): every
/// other reference this frame holds is released, every `inout` parameter is
/// written back through its address.
fn do_return(inout v: Vir, x: i64) {
    if is_temp(v, x) {
        forget_temp(v, x)
    }
    pop_handlers_above(v, 0)
    release_from(v, 0, 0)
    for i in 0..v.io_val.len() {
        store_at(v, v.io_addr[i], v.io_val[i])
    }
    finish(v, ir.M_RET, if v.returns { x } else { -1 }, -1, -1)
}

fn lower_return(info: TirInfo, inout v: Vir, e: i64) -> i64 {
    let t = info.t
    let ks = sexp.kids(t, e)
    var x = -1
    if ks.len() > 0 {
        x = value_of(info, v, ks[0])
    }
    if v.split_out >= 0 or v.boxed_result {
        leave_with(t, v, x, if ks.len() > 0 { ty_el(t, ks[0], 1) } else { -1 })
        return -1
    }
    if v.returns and x < 0 {
        x = zero_like(v, v.ret_kind)
    }
    if not v.returns {
        discard(v, x)
    }
    do_return(v, x)
    -1
}

// ----- fallible functions --------------------------------------------------------
//
// The Cranelift build's split-result convention: a function `-> T ! E` that
// is not generic and not named `main` takes a hidden last argument, the
// address of a word, and answers a tag, 0 for `Ok` and 1 for `Err`. Through
// the address it writes the `Ok` payload's bits (0 for unit) or an owned box,
// or the error's owned box. Its callers box that pair into a result value
// only where a value is wanted (`grasm_result_box`); `try` reads it as it is.
// A fallible `main` answers its whole result as a box.

/// How the runtime reads a result's `Ok` word: the scalar kind, 4 for unit,
/// -1 for a box (`result_kind`).
fn result_kind(t: TirTree, te: i64) -> i64 {
    let k = ty_kind(t, te)
    if k == ir.TY_UNIT or k == ir.TY_NEVER or te < 0 {
        4
    } else if k == ir.TY_U64 {
        5
    } else if ir.ty_int(k) {
        0
    } else if ir.ty_fp(k) {
        1
    } else if k == ir.TY_BOOL {
        2
    } else if k == ir.TY_REF {
        3
    } else {
        -1
    }
}

/// The error type element of callable `c`, or -1 when it cannot fail.
fn fn_err(info: TirInfo, c: i64) -> i64 {
    if info.c_const[c] {
        return -1
    }
    let t = info.t
    let e = info.c_elem[c]
    if sexp.word(t, e, 5) == "none" {
        return -1
    }
    sexp.at(t, e, 5)
}

/// The last segment of a qualified name.
fn bare_name(name: str) -> str {
    let parts = name.split("::")
    parts[parts.len() - 1]
}

/// Whether callable `c` returns by the split-result convention.
pub fn is_split(info: TirInfo, c: i64) -> bool {
    fn_err(info, c) >= 0 and bare_name(info.c_name[c]) != "main"
}

/// One more 8-byte frame slot, for a word a callee writes.
fn fresh_slot(inout v: Vir) -> i64 {
    v.slot_var.push(-1)
    v.nslots += 1
    v.nslots - 1
}

fn slot_addr(inout v: Vir, k: i64) -> i64 {
    let a = new_var(v, ir.TY_I64)
    emit(v, ir.M_SLOTADDR, a, -1, -1, k)
    a
}

/// Leaves the function: every reference it holds released, every `inout`
/// parameter written back, `x` answered (nothing when the function answers
/// nothing).
fn finish_return(inout v: Vir, x: i64) {
    pop_handlers_above(v, 0)
    release_from(v, 0, 0)
    for i in 0..v.io_val.len() {
        store_at(v, v.io_addr[i], v.io_val[i])
    }
    finish(v, ir.M_RET, if v.returns { x } else { -1 }, -1, -1)
}

/// Leaves a split function with tag `tag` and the word `w` through its
/// hidden address.
fn split_return(inout v: Vir, tag: i64, w: i64) {
    store_at(v, v.split_out, w)
    let k = konst(v, tag)
    finish_return(v, k)
}

/// Leaves a fallible function with error `x`, an owned box: `fail(e)`, or a
/// `try` whose operand failed. The compile-time bookkeeping is left as it
/// was found, less `x`, for the path that did not fail.
fn leave_err(inout v: Vir, x: i64) {
    forget_temp(v, x)
    if v.split_out >= 0 {
        // The error's reference is the caller's now.
        split_return(v, 1, x)
        return
    }
    let w = new_var(v, ir.TY_BOX)
    let i = emit(v, ir.M_CALLRT, w, -1, -1, rt_id(v, "grasm_err_new"))
    v.ca0[i] = v.cargs.len()
    v.can[i] = 1
    v.cargs.push(x)
    if v.boxed_result {
        finish_return(v, w)
        return
    }
    // A function that cannot fail is `main`: the error ends the program.
    rt(v, "grasm_report_main_err", [w], R_NEVER)
    ()
}

/// `try e`: the `Ok` payload, or out of the function with the error.
fn lower_try(info: TirInfo, inout v: Vir, e: i64) -> i64 {
    let t = info.t
    let te = ty_el(t, e, 1)
    let k = ty_kind(t, te)
    if not held(k) {
        bad(v, "outside the subset: `try` answering {ty_text(t, e, 1)} {span_of(t, e)}")
        return -1
    }
    let inner = sexp.kids(t, e)[0]
    let callee = if sexp.kw(t, inner) == "call" { info.fn_ix.get(sexp.word(t, inner, 3)) ?? -1 } else { -1 }
    if callee >= 0 and is_split(info, callee) {
        // The split call's own tag and word: no result is boxed.
        let (tag, slot, _c) = call_parts(info, v, inner)
        let okb = new_block(v)
        let errb = new_block(v)
        term_brif(v, tag, errb, okb)
        switch_to(v, errb)
        let ea = slot_addr(v, slot)
        let ep = new_var(v, ir.TY_BOX)
        emit(v, ir.M_LOAD, ep, ea, -1, 0)
        own_temp(v, ep)
        leave_err(v, ep)
        switch_to(v, okb)
        let a = slot_addr(v, slot)
        let w = new_var(v, if ir.ty_boxed(k) { ir.TY_BOX } else if ir.ty_fp(k) { ir.TY_F64 } else { ir.TY_I64 })
        load_into(v, w, a)
        if ir.ty_boxed(k) {
            own_temp(v, w)
        }
        return w
    }
    // A boxed result: its payload taken out of it (`grasm_try_take`, or
    // `grasm_try_take_bits` for a scalar), which releases the result; or, on
    // an `Err`, the result left alone and its error read out of it.
    let fv = value_of(info, v, inner)
    let okb = new_block(v)
    let errb = new_block(v)
    var w = -1
    var slot = -1
    if ir.ty_boxed(k) {
        w = rt(v, "grasm_try_take", [fv], R_WORD)
        v.vty[w] = ir.TY_BOX
        let z = konst(v, 0)
        let c = icmp(v, ir.CC_NE, w, z)
        term_brif(v, c, okb, errb)
    } else {
        slot = fresh_slot(v)
        let a = slot_addr(v, slot)
        let c = rt(v, "grasm_try_take_bits", [fv, a], R_BOOL8)
        term_brif(v, c, okb, errb)
    }
    switch_to(v, errb)
    let zero = konst(v, 0)
    let ep = rt(v, "grasm_variant_field", [fv, zero], R_BOX)
    // The result itself is released with everything else on the way out.
    leave_err(v, ep)
    switch_to(v, okb)
    forget_temp(v, fv)
    if ir.ty_boxed(k) {
        own_temp(v, w)
        return w
    }
    let a2 = slot_addr(v, slot)
    let x = new_var(v, if ir.ty_fp(k) { ir.TY_F64 } else { ir.TY_I64 })
    load_into(v, x, a2)
    x
}

/// `fail(e)`: out of the function with error `e`, which is boxed.
fn lower_fail(info: TirInfo, inout v: Vir, e: i64) -> i64 {
    let t = info.t
    let arg = sexp.kids(t, e)[0]
    if not ir.ty_boxed(kind_at(t, arg, 1)) {
        bad(v, "outside the subset: failing with a value of type {ty_text(t, arg, 1)} {span_of(t, e)}")
        return -1
    }
    let x = value_of(info, v, arg)
    leave_err(v, x)
    -1
}

/// `wrapok x`: the bare `T` where a `T ! E` is wanted, as a boxed `Ok`.
fn lower_wrapok(info: TirInfo, inout v: Vir, e: i64) -> i64 {
    let t = info.t
    let te = ty_arg(t, ty_el(t, e, 1), 1)
    let k = ty_kind(t, te)
    if not held(k) {
        bad(v, "outside the subset: `Ok` of type {ty_text(t, e, 1)} {span_of(t, e)}")
        return -1
    }
    let x = value_of(info, v, sexp.kids(t, e)[0])
    let b = box_kind(v, x, k)
    forget_temp(v, b)
    rt(v, "grasm_ok_new", [b], R_BOX)
}

/// `a ?? b` on an `Option` or a result: `a`'s payload when it is `Some` or
/// `Ok`, else `b`, computed only then. `a` is released either way.
fn lower_coalesce(info: TirInfo, inout v: Vir, e: i64) -> i64 {
    let t = info.t
    let ot = ty_el(t, e, 4)
    let rk = kind_at(t, e, 1)
    let ks = sexp.kids(t, e)
    let is_opt = ty_head(t, ot) == "named" and sexp.word(t, ot, 1) == "Option"
    if not held(rk) or not (is_opt or ty_head(t, ot) == "fallible") {
        bad(v, "outside the subset: `??` on {ty_text(t, e, 4)} {span_of(t, e)}")
        return konst(v, 0)
    }
    let pk = ty_kind(t, ty_arg(t, ot, if is_opt { 2 } else { 1 }))
    let lv = value_of(info, v, ks[0])
    var c = -1
    if is_opt {
        let sn = text_args(v, "Some")
        c = rt(v, "grasm_variant_is", [lv, sn[0], sn[1]], R_BOOL8)
    } else {
        c = rt(v, "grasm_is_ok", [lv], R_BOOL8)
    }
    var r = -1
    if valued(rk) {
        r = new_var(v, rk)
    }
    let yes = new_block(v)
    let no = new_block(v)
    let join = new_block(v)
    term_brif(v, c, yes, no)
    switch_to(v, yes)
    let zero = konst(v, 0)
    let pb = rt(v, "grasm_variant_field", [lv, zero], R_BOX)
    drop_temp(v, lv)
    let p = unbox_kind(v, pb, pk)
    branch_value(v, r, p)
    if v.open {
        term_jump(v, join)
    }
    // `lv` is still this path's: the bookkeeping above was the other's.
    own_temp(v, lv)
    switch_to(v, no)
    drop_temp(v, lv)
    let y = lower_expr(info, v, ks[1])
    branch_value(v, r, y)
    if v.open {
        term_jump(v, join)
    }
    switch_to(v, join)
    joined_value(v, r)
}

/// Leaves a fallible function with `x`, of type element `xte`: a whole
/// result (`T ! E`), or the bare `T` that is its `Ok` ([T-OK-ERR-RETURN]).
fn leave_with(t: TirTree, inout v: Vir, x: i64, xte: i64) {
    if x >= 0 and is_temp(v, x) {
        forget_temp(v, x)
    }
    if v.split_out >= 0 {
        if xte >= 0 and ty_head(t, xte) == "fallible" {
            // A whole result: split by the runtime (it takes the reference).
            let tag = new_var(v, ir.TY_I64)
            let kc = konst(v, result_kind(t, v.ok_te))
            pop_handlers_above(v, 0)
            release_from(v, 0, 0)
            let i = emit(v, ir.M_CALLRT, tag, -1, -1, rt_id(v, "grasm_result_split"))
            v.ca0[i] = v.cargs.len()
            v.can[i] = 3
            v.cargs.push(x)
            v.cargs.push(v.split_out)
            v.cargs.push(kc)
            let tg = op1(v, ir.M_UEXT8, tag)
            for j in 0..v.io_val.len() {
                store_at(v, v.io_addr[j], v.io_val[j])
            }
            finish(v, ir.M_RET, tg, -1, -1)
            return
        }
        let unit_ok = result_kind(t, v.ok_te) == 4
        if unit_ok and x >= 0 and ir.ty_boxed(v.vty[x]) {
            // A value where `()` is the payload: nobody will read it.
            emit(v, ir.M_DEC, -1, x, -1, 0)
        }
        let w = if x >= 0 and not unit_ok { x } else { konst(v, 0) }
        split_return(v, 0, w)
        return
    }
    // A boxed result: wrapped when it is the bare `T`.
    if xte >= 0 and ty_head(t, xte) == "fallible" {
        finish_return(v, x)
        return
    }
    var b = -1
    let k = ty_kind(t, v.ok_te)
    if ir.ty_boxed(k) {
        b = x
    } else if k == ir.TY_UNIT or k == ir.TY_NEVER or x < 0 {
        // The implicit `Ok(())` the Cranelift build makes.
        if x >= 0 and ir.ty_boxed(v.vty[x]) {
            emit(v, ir.M_DEC, -1, x, -1, 0)
        }
        let z = konst(v, 0)
        b = rt(v, "grasm_box_i64", [z], R_BOX)
        forget_temp(v, b)
    } else {
        b = box_kind(v, x, k)
        forget_temp(v, b)
    }
    let w = new_var(v, ir.TY_BOX)
    let i = emit(v, ir.M_CALLRT, w, -1, -1, rt_id(v, "grasm_ok_new"))
    v.ca0[i] = v.cargs.len()
    v.can[i] = 1
    v.cargs.push(b)
    finish_return(v, w)
}

fn lower_while(info: TirInfo, inout v: Vir, e: i64) -> i64 {
    let t = info.t
    let ks = sexp.kids(t, e)
    let head = new_block(v)
    let body = new_block(v)
    let exit = new_block(v)
    switch_to(v, head)
    let c = value_of(info, v, ks[0])
    term_brif(v, c, body, exit)
    switch_to(v, body)
    enter_loop(v, head, exit)
    let x = lower_expr(info, v, ks[1])
    discard(v, x)
    leave_loop(v)
    if v.open {
        term_jump(v, head)
    }
    switch_to(v, exit)
    -1
}

/// `lo..hi` or `lo..=hi` as a value: the runtime's boxed `Range`, built
/// from both ends computed left to right -- the Cranelift build's
/// `eval_range_value`.
fn lower_range_value(info: TirInfo, inout v: Vir, e: i64) -> i64 {
    let t = info.t
    let ends = sexp.kids(t, e)
    if kind_at(t, ends[0], 1) != ir.TY_I64 or kind_at(t, ends[1], 1) != ir.TY_I64 {
        bad(v, "outside the subset: a range of non-`i64` bounds {span_of(t, e)}")
        return konst(v, 0)
    }
    let lo = value_of(info, v, ends[0])
    let hi = value_of(info, v, ends[1])
    let kc = konst(v, if sexp.word(t, e, 3) == "inclusive" { 1 } else { 0 })
    rt(v, "grasm_range_new", [lo, hi, kc], R_BOX)
}

/// `r.to_list()`, `r.len()` and `r.sum()` on a range, written in place or
/// held: the runtime's elements or count, as the Cranelift build asks them.
fn range_method(info: TirInfo, inout v: Vir, e: i64, name: str) -> i64 {
    let t = info.t
    let rv = value_of(info, v, sexp.kids(t, e)[0])
    if name == "len" {
        let n = rt(v, "grasm_range_len", [rv], R_WORD)
        drop_temp(v, rv)
        return n
    }
    let l = rt(v, "grasm_range_to_list", [rv], R_BOX)
    drop_temp(v, rv)
    if name == "to_list" {
        return l
    }
    let s = rt(v, "grasm_list_sum_i64", [l], R_WORD)
    drop_temp(v, l)
    s
}

/// `for i in lo..hi` and `lo..=hi`. Both ends are evaluated once, and an
/// inclusive range stops *before* stepping past its end, so `..=i64::MAX`
/// ends ([E-LOOP-RANGE-MAX]).
fn lower_for(info: TirInfo, inout v: Vir, e: i64) -> i64 {
    let t = info.t
    if sexp.word(t, e, 1) == "list" {
        return lower_for_list(info, v, e)
    }
    if sexp.word(t, e, 1) != "range" {
        bad(v, "outside the subset: `for` over a {sexp.word(t, e, 1)} {span_of(t, e)}")
        return -1
    }
    let ks = sexp.kids(t, e)
    let it = ks[1]
    if sexp.kw(t, it) != "range" {
        // A range held as a value: its elements built first and walked as a
        // list, as the Cranelift build and the interpreter both do.
        let rv = value_of(info, v, it)
        let l = rt(v, "grasm_range_to_list", [rv], R_BOX)
        drop_temp(v, rv)
        return for_over_list(info, v, e, l)
    }
    let incl = sexp.word(t, it, 3) == "inclusive"
    let ends = sexp.kids(t, it)
    let lo = value_of(info, v, ends[0])
    let hi = value_of(info, v, ends[1])
    let ctr = new_var(v, ir.TY_I64)
    copy_to(v, ctr, lo)
    let end = new_var(v, ir.TY_I64)
    copy_to(v, end, hi)
    let head = new_block(v)
    let body = new_block(v)
    let step = new_block(v)
    let exit = new_block(v)
    switch_to(v, head)
    let c = icmp(v, if incl { ir.CC_SLE } else { ir.CC_SLT }, ctr, end)
    term_brif(v, c, body, exit)
    switch_to(v, body)
    let iv = bind_tvar(v, sexp.word(t, ks[0], 1).parse_int() ?? -1, ir.TY_I64, ty_el(t, ks[0], 4))
    copy_to(v, iv, ctr)
    enter_loop(v, step, exit)
    let x = lower_expr(info, v, ks[2])
    discard(v, x)
    leave_loop(v)
    if v.open {
        term_jump(v, step)
    }
    switch_to(v, step)
    if incl {
        let done = icmp(v, ir.CC_EQ, ctr, end)
        let bump = new_block(v)
        term_brif(v, done, exit, bump)
        switch_to(v, bump)
    }
    let one = konst(v, 1)
    let nx = op2(v, ir.M_ADD, ctr, one)
    copy_to(v, ctr, nx)
    term_jump(v, head)
    switch_to(v, exit)
    -1
}

// ----- function values ---------------------------------------------------------------
//
// A function value is the runtime's boxed `Fn` (`grasm_fn_new`): the address
// of compiled code and an environment, a list of the captured values, boxed.
// The code takes the environment first, then the arguments, and owns all of
// them, as any function here owns its parameters. A closure's body is lifted
// into a function of its own (`lower_lifted_closure`); a named function used
// as a value is reached through a wrapper (`lower_wrapper`) that releases the
// empty environment and calls it -- the Cranelift build's `fn_value_wrapper`,
// with the same name in the value, so it prints as `<fn module::name>`.
// Calling a value (`callvalue`) reads its code and a reference to its
// environment out of it (`grasm_fn_code`, `grasm_fn_env`) and calls through
// the address.
//
// Captures are by value, at the closure's creation ([E-CLOSURE-CAPTURE]):
// each variable the body reads and does not bind is copied into the
// environment then, a boxed one retained, and nothing can write to one
// afterwards ([T-CAPTURE-WRITE]). TIR does not list them (docs/tir.md §8); a
// closure shares its function's variable numbering, so they are the body's
// reads less its bindings.

/// Records a function this one makes a value of; answers its index for
/// `M_FNADDR` until the driver gives it a callable id.
fn add_lift(inout v: Vir, kind: i64, elem: i64, caps: [i64], capte: [i64]) -> i64 {
    if kind == LIFT_WRAPPER {
        for k in 0..v.lift_kind.len() {
            if v.lift_kind[k] == kind and v.lift_elem[k] == elem {
                return k
            }
        }
    }
    v.lift_kind.push(kind)
    v.lift_elem.push(elem)
    v.lift_caps.push(caps)
    v.lift_capte.push(capte)
    v.lift_kind.len() - 1
}

/// The variables closure `e` captures, by number, and the type each is read
/// at: every local its body reads that it does not bind (a parameter, a
/// `let`, a loop or pattern variable, a nested closure's parameter).
pub fn closure_captures(t: TirTree, e: i64) -> ([i64], [i64]) {
    var bound: Map[i64, bool] = {}
    var reads: Map[i64, i64] = {}
    var stack: [i64] = [e]
    while not stack.is_empty() {
        let x = stack.pop() ?? 0
        if t.kind[x] != 2 {
            continue
        }
        let k = sexp.kw(t, x)
        if k == "var" or k == "let" {
            bound.set(sexp.word(t, x, 1).parse_int() ?? -1, true)
        } else if k == "pbind" {
            bound.set(sexp.word(t, x, 2).parse_int() ?? -1, true)
        } else if k == "local" and t.count[x] >= 4 {
            let id = sexp.word(t, x, 3).parse_int() ?? -1
            if not reads.has(id) or (reads.get(id) ?? -1) < 0 {
                reads.set(id, sexp.at(t, x, 1))
            }
        } else if k == "local" and t.count[x] == 3 {
            // The root of a place written to, which TIR leaves untyped: a
            // captured reference written through ([T-REF-CAPTURE]). Its type
            // is its binding's, which the caller knows (-1 here).
            let id = sexp.word(t, x, 1).parse_int() ?? -1
            if not reads.has(id) {
                reads.set(id, -1)
            }
        }
        for j in 0..t.count[x] {
            let y = sexp.at(t, x, j)
            if t.kind[y] == 2 {
                stack.push(y)
            }
        }
    }
    var ids: [i64] = []
    for id in reads.keys() {
        if not bound.has(id) {
            ids.push(id)
        }
    }
    ids.sort()
    var tes: [i64] = []
    for id in ids {
        tes.push(reads.get(id) ?? -1)
    }
    (ids, tes)
}

/// A closure as a value: its captures copied into a fresh environment, in
/// the order the lifted body unpacks them, and the lifted body's address.
fn lower_closure(info: TirInfo, inout v: Vir, e: i64) -> i64 {
    let t = info.t
    if not ir.ty_boxed(kind_at(t, e, 1)) {
        bad(v, "outside the subset: a closure of type {ty_text(t, e, 1)} {span_of(t, e)}")
        return konst(v, 0)
    }
    if sexp.word(t, e, 3) == "total" and fails_out(t, sexp.kids(t, e)[1]) {
        // A closure that cannot fail, whose `fail` or `try` fails the
        // function around it ([E-PAR-FAIL]): the Cranelift build runs its
        // body inline for that, and a lifted closure has nowhere to put it.
        bad(v, "outside the subset: a closure whose failure leaves the function around it {span_of(t, e)}")
        return konst(v, 0)
    }
    make_closure(info, v, e)
}

/// Whether `body` has a `fail` or a `try` that is not inside a closure of
/// its own that can fail.
fn fails_out(t: TirTree, body: i64) -> bool {
    var stack: [i64] = [body]
    while not stack.is_empty() {
        let x = stack.pop() ?? 0
        if t.kind[x] != 2 {
            continue
        }
        let k = sexp.kw(t, x)
        if k == "try" or (k == "builtin" and sexp.word(t, x, 3) == "fail") {
            return true
        }
        if k == "closure" and sexp.word(t, x, 3) == "fallible" {
            continue
        }
        for j in 0..t.count[x] {
            let y = sexp.at(t, x, j)
            if t.kind[y] == 2 {
                stack.push(y)
            }
        }
    }
    false
}

/// The function value of closure `e` -- or of a `go` task's block, a
/// closure of no arguments ([E-CONCURRENT]).
fn make_closure(info: TirInfo, inout v: Vir, e: i64) -> i64 {
    let t = info.t
    let (ids, tes0) = closure_captures(t, e)
    var tes: [i64] = []
    for k in 0..ids.len() {
        tes.push(if tes0[k] >= 0 { tes0[k] } else { v.tvty.get(ids[k]) ?? -1 })
    }
    for k in 0..ids.len() {
        if not held(ty_kind(t, tes[k])) {
            bad(v, "outside the subset: a closure capturing a value of a type this part does not hold {span_of(t, e)}")
            return konst(v, 0)
        }
    }
    var env = rt(v, "grasm_list_new", [], R_BOX)
    for k in 0..ids.len() {
        let kind = ty_kind(t, tes[k])
        let w = tvar_of(v, ids[k])
        var x = -1
        if ir.ty_boxed(kind) {
            x = retain_copy(v, w)
        } else {
            x = new_var(v, kind)
            copy_to(v, x, w)
        }
        let b = box_kind(v, x, kind)
        forget_temp(v, env)
        forget_temp(v, b)
        env = rt(v, "grasm_list_push", [env, b], R_BOX)
    }
    let li = add_lift(v, LIFT_CLOSURE, e, ids, tes)
    let code = new_var(v, ir.TY_I64)
    emit(v, ir.M_FNADDR, code, -1, -1, li)
    forget_temp(v, env)
    let z = konst(v, 0)
    rt(v, "grasm_fn_new", [code, env, z, z], R_BOX)
}

/// A named function as a value: its wrapper's address, an empty
/// environment, and its name.
fn lower_fnref(info: TirInfo, inout v: Vir, e: i64) -> i64 {
    let t = info.t
    let name = sexp.word(t, e, 3)
    let c = info.fn_ix.get(name) ?? -1
    if c < 0 {
        // A C function as a value ([T-EXTERN-VALUE]): through a wrapper of
        // the closure convention, named as the function is.
        let decl = extern_decl(t, name)
        if decl >= 0 and extern_ok(t, decl) and ir.ty_boxed(kind_at(t, e, 1)) {
            let li = add_lift(v, LIFT_EXTERN, decl, [], [])
            let code = new_var(v, ir.TY_I64)
            emit(v, ir.M_FNADDR, code, -1, -1, li)
            let env = rt(v, "grasm_list_new", [], R_BOX)
            let nm = text_args(v, name)
            forget_temp(v, env)
            return rt(v, "grasm_fn_new", [code, env, nm[0], nm[1]], R_BOX)
        }
        bad(v, "outside the subset: `{name}` as a value, which is not a function here {span_of(t, e)}")
        return konst(v, 0)
    }
    if t.count[sexp.at(t, e, 4)] > 1 {
        bad(v, "outside the subset: a generic function `{name}` as a value {span_of(t, e)}")
        return konst(v, 0)
    }
    if not ir.ty_boxed(kind_at(t, e, 1)) {
        bad(v, "outside the subset: a function value of type {ty_text(t, e, 1)} {span_of(t, e)}")
        return konst(v, 0)
    }
    for p in params_of(info, c) {
        if sexp.word(t, p, 1) == "inout" {
            bad(v, "outside the subset: `{name}`, which has `inout` parameters, as a value {span_of(t, e)}")
            return konst(v, 0)
        }
    }
    let li = add_lift(v, LIFT_WRAPPER, c, [], [])
    let code = new_var(v, ir.TY_I64)
    emit(v, ir.M_FNADDR, code, -1, -1, li)
    let env = rt(v, "grasm_list_new", [], R_BOX)
    let nm = text_args(v, name)
    forget_temp(v, env)
    rt(v, "grasm_fn_new", [code, env, nm[0], nm[1]], R_BOX)
}

/// `f(a, b)` where `f` is a value: the value computed, then the arguments,
/// then the call through its code; the value is released after.
fn lower_callvalue(info: TirInfo, inout v: Vir, e: i64) -> i64 {
    let t = info.t
    let ks = sexp.kids(t, e)
    let fty = ty_el(t, ks[0], 1)
    if ty_head(t, fty) != "fn" or not ir.ty_boxed(ty_kind(t, fty)) {
        bad(v, "outside the subset: calling a value of type {ty_text(t, ks[0], 1)} {span_of(t, e)}")
        return konst(v, 0)
    }
    let f = value_of(info, v, ks[0])
    var args: [i64] = []
    for i in 1..ks.len() {
        args.push(value_of(info, v, ks[i]))
    }
    let r = call_value(v, f, args, ty_kind(t, fn_ret(t, fty)))
    discard(v, f)
    r
}

/// Calls function value `f` (held, not consumed) with `args`, each handed
/// over; answers what it returns -- an owned temporary when boxed -- or -1.
fn call_value(inout v: Vir, f: i64, args: [i64], rk: i64) -> i64 {
    let code = rt(v, "grasm_fn_code", [f], R_WORD)
    let env = rt(v, "grasm_fn_env", [f], R_BOX)
    var all: [i64] = [env]
    for a in args {
        all.push(a)
    }
    for a in all {
        if is_temp(v, a) {
            forget_temp(v, a)
        }
    }
    var d = -1
    if valued(rk) {
        d = new_var(v, if ir.ty_boxed(rk) { ir.TY_BOX } else if ir.ty_fp(rk) { ir.TY_F64 } else { ir.TY_I64 })
    }
    let i = emit(v, ir.M_CALLIND, d, code, -1, 0)
    v.ca0[i] = v.cargs.len()
    v.can[i] = all.len()
    for x in all {
        v.cargs.push(x)
    }
    if d >= 0 and ir.ty_boxed(rk) {
        own_temp(v, d)
    }
    d
}

/// Retires temporary `x` from the bookkeeping and records `y` in its place,
/// for a variable whose value a runtime call replaced: `x` now holds `y`.
fn replace_temp(inout v: Vir, x: i64, y: i64) {
    copy_to(v, x, y)
    forget_temp(v, y)
}

// The higher-order methods of a list -- `map`, `filter`, `fold`, `any`,
// `all`, `find`, `sort_by` -- and `map` and `filter` of a range written in
// place, as loops calling the function value once per element in order, as
// the Cranelift build's inlined loops do: `map` keeps a scalar result inline
// (a scalar list) and boxes any other; `filter` keeps the input's
// representation; `any` and `all` stop at the first element that decides
// them and `find` at the first that matches; `sort_by` computes every key
// first and sorts by them in the runtime's order ([L-LIB-SORT-NAN]). The
// receiver is computed first, then the function.

/// The elements a higher-order method walks: a list (owned, released when
/// the walk ends) or a range written in place.
type Walk = {
    is_range: bool,
    l: i64,
    te: i64,
    ctr: i64,
    end: i64,
    incl: bool,
    n: i64,
    head: i64,
    body: i64,
    step: i64,
    exit: i64,
}

/// Computes what `recv` walks. `elem_te` is the type element of what the
/// function takes, which is the element type of a range held as a value:
/// that range's elements are built first and walked as a list.
fn walk_src(info: TirInfo, inout v: Vir, recv: i64, elem_te: i64) -> Walk {
    let t = info.t
    var w = Walk{ is_range: false, l: -1, te: -1, ctr: -1, end: -1, incl: false, n: -1, head: -1, body: -1, step: -1, exit: -1 }
    if sexp.kw(t, recv) != "range" and is_ty(t, ty_el(t, recv, 1), "range") {
        let rv = value_of(info, v, recv)
        let l = rt(v, "grasm_range_to_list", [rv], R_BOX)
        drop_temp(v, rv)
        return walk_list(v, l, elem_te)
    }
    if sexp.kw(t, recv) == "range" {
        w.is_range = true
        w.incl = sexp.word(t, recv, 3) == "inclusive"
        let ends = sexp.kids(t, recv)
        let lo = value_of(info, v, ends[0])
        let hi = value_of(info, v, ends[1])
        w.ctr = new_var(v, ir.TY_I64)
        copy_to(v, w.ctr, lo)
        w.end = new_var(v, ir.TY_I64)
        copy_to(v, w.end, hi)
        return w
    }
    w.te = ty_arg(t, ty_el(t, recv, 1), 1)
    w.l = value_of(info, v, recv)
    w.n = rt(v, "grasm_list_len", [w.l], R_WORD)
    w.ctr = new_var(v, ir.TY_I64)
    let z = konst(v, 0)
    copy_to(v, w.ctr, z)
    w
}

/// Opens the loop: the test, then the body, where control now is.
fn walk_head(inout v: Vir, inout w: Walk) {
    w.head = new_block(v)
    w.body = new_block(v)
    w.step = new_block(v)
    w.exit = new_block(v)
    switch_to(v, w.head)
    var c = -1
    if w.is_range {
        c = icmp(v, if w.incl { ir.CC_SLE } else { ir.CC_SLT }, w.ctr, w.end)
    } else {
        c = icmp(v, ir.CC_SLT, w.ctr, w.n)
    }
    term_brif(v, c, w.body, w.exit)
    switch_to(v, w.body)
}

/// The current element, owned when boxed.
fn walk_elem(inout v: Vir, t: TirTree, w: Walk) -> i64 {
    if w.is_range {
        let x = new_var(v, ir.TY_I64)
        copy_to(v, x, w.ctr)
        return x
    }
    list_elem(v, t, w.l, w.ctr, w.te)
}

/// The element's kind.
fn walk_kind(t: TirTree, w: Walk) -> i64 {
    if w.is_range { ir.TY_I64 } else { ty_kind(t, w.te) }
}

/// Ends the body: on to the next element. An inclusive range stops before
/// stepping past its end ([E-LOOP-RANGE-MAX]).
fn walk_next(inout v: Vir, w: Walk) {
    if v.open {
        term_jump(v, w.step)
    }
    switch_to(v, w.step)
    if w.is_range and w.incl {
        let done = icmp(v, ir.CC_EQ, w.ctr, w.end)
        let bump = new_block(v)
        term_brif(v, done, w.exit, bump)
        switch_to(v, bump)
    }
    let one = konst(v, 1)
    let nx = op2(v, ir.M_ADD, w.ctr, one)
    copy_to(v, w.ctr, nx)
    term_jump(v, w.head)
    switch_to(v, w.exit)
    if w.l >= 0 {
        drop_temp(v, w.l)
    }
}

/// An empty list to hold elements of type `te`: a scalar list for a scalar.
fn empty_list_for(inout v: Vir, t: TirTree, te: i64) -> i64 {
    let sk = scalar_kind(t, te)
    if sk >= 0 {
        let kc = konst(v, sk)
        return rt(v, "grasm_list_new_scalar", [kc], R_BOX)
    }
    rt(v, "grasm_list_new", [], R_BOX)
}

/// Appends `x` (owned when boxed; -1 for unit) of type `te` to the list in
/// temporary `out`, which then holds the list the runtime answers.
fn push_elem(inout v: Vir, t: TirTree, out: i64, x: i64, te: i64) {
    let sk = scalar_kind(t, te)
    forget_temp(v, out)
    var nl = -1
    if sk >= 0 {
        let kc = konst(v, sk)
        let w = word_of(v, x)
        nl = rt(v, "grasm_list_push_scalar", [out, w, kc], R_BOX)
    } else {
        let b = box_kind(v, x, ty_kind(t, te))
        forget_temp(v, b)
        nl = rt(v, "grasm_list_push", [out, b], R_BOX)
    }
    replace_temp(v, out, nl)
    own_temp(v, out)
}

/// The function argument `k` of method `e`, and its type: `(fn (P..) R row)`.
fn fn_arg(info: TirInfo, inout v: Vir, e: i64, k: i64) -> (i64, i64) {
    let t = info.t
    let a = sexp.kids(t, e)[k]
    let fty = ty_el(t, a, 1)
    if inlined_closure(t, a) {
        // Lowered into the loop where it is applied (`apply_fn`): no value.
        return (-1, fty)
    }
    let f = value_of(info, v, a)
    (f, fty)
}

/// Whether function argument `a` of a higher-order method is a closure
/// written there whose body is lowered into the loop rather than called: one
/// that cannot fail itself, whose `fail` or `try` fails the function around
/// it ([E-PAR-FAIL]) -- which the Cranelift build's loop, the body inlined,
/// gives it. One with a `return` is not: inlined, a `return` would leave the
/// function around it, and it means the closure.
pub fn inlined_closure(t: TirTree, a: i64) -> bool {
    if sexp.kw(t, a) != "closure" or sexp.word(t, a, 3) != "total" {
        return false
    }
    let body = sexp.kids(t, a)[1]
    fails_out(t, body) and not has_return(t, body)
}

/// Whether `body` has a `return` that is not inside a closure of its own.
fn has_return(t: TirTree, body: i64) -> bool {
    var stack: [i64] = [body]
    while not stack.is_empty() {
        let x = stack.pop() ?? 0
        if t.kind[x] != 2 {
            continue
        }
        let k = sexp.kw(t, x)
        if k == "return" {
            return true
        }
        if k == "closure" {
            continue
        }
        for j in 0..t.count[x] {
            let y = sexp.at(t, x, j)
            if t.kind[y] == 2 {
                stack.push(y)
            }
        }
    }
    false
}

/// The function argument `ks[k]` of method `e` applied to `args`: called
/// through its value `f`, or, for a closure `fn_arg` left unmade, its body
/// lowered here with its parameters bound to them, in a scope of its own.
fn apply_fn(info: TirInfo, inout v: Vir, e: i64, k: i64, f: i64, args: [i64], rk: i64) -> i64 {
    let t = info.t
    let a = sexp.kids(t, e)[k]
    if f >= 0 or not inlined_closure(t, a) {
        return call_value(v, f, args, rk)
    }
    let ks = sexp.kids(t, a)
    let params = sexp.kids(t, ks[0])
    open_scope(v)
    for j in 0..params.len() {
        let p = params[j]
        let te = ty_el(t, p, 4)
        let pk = ty_kind(t, te)
        let w = bind_tvar(v, sexp.word(t, p, 1).parse_int() ?? -1, pk, te)
        copy_to(v, w, args[j])
        if ir.ty_boxed(pk) {
            if is_temp(v, args[j]) {
                forget_temp(v, args[j])
            }
            own_var(v, w)
        }
    }
    let x = lower_expr(info, v, ks[1])
    // The value is a temporary, and outlives the scope.
    var r = -1
    if valued(rk) and x >= 0 {
        r = new_var(v, v.vty[x])
        copy_to(v, r, x)
        if is_temp(v, x) {
            forget_temp(v, x)
            own_temp(v, r)
        }
    }
    close_scope(v)
    if valued(rk) and r < 0 {
        r = zero_like(v, rk)
    }
    r
}

fn hof_method(info: TirInfo, inout v: Vir, e: i64, name: str) -> i64 {
    let t = info.t
    let ks = sexp.kids(t, e)
    if name == "sort_by" {
        return sort_by_method(info, v, e)
    }
    let fk = if name == "fold" { 2 } else { 1 }
    let fparams = fn_params(t, ty_el(t, ks[fk], 1))
    let pk = if name == "fold" { 1 } else { 0 }
    var w = walk_src(info, v, ks[0], if fparams.len() > pk { fparams[pk] } else { -1 })
    let ek = walk_kind(t, w)
    let ete = if w.is_range { -1 } else { w.te }
    if name == "fold" {
        let ak = kind_at(t, e, 1)
        let a0 = value_of(info, v, ks[1])
        let (f, _fty) = fn_arg(info, v, e, 2)
        let acc = new_var(v, ak)
        copy_to(v, acc, a0)
        if is_temp(v, a0) {
            forget_temp(v, a0)
            own_temp(v, acc)
        }
        walk_head(v, w)
        let x = walk_elem(v, t, w)
        let r = apply_fn(info, v, e, 2, f, [acc, x], ak)
        if r >= 0 {
            copy_to(v, acc, r)
            if is_temp(v, r) {
                forget_temp(v, r)
                own_temp(v, acc)
            }
        }
        walk_next(v, w)
        discard(v, f)
        return acc
    }
    let (f, fty) = fn_arg(info, v, e, 1)
    let rte = fn_ret(t, fty)
    let rk = ty_kind(t, rte)
    if name == "map" {
        let out = empty_list_for(v, t, rte)
        walk_head(v, w)
        let x = walk_elem(v, t, w)
        let y = apply_fn(info, v, e, 1, f, [x], rk)
        push_elem(v, t, out, y, rte)
        walk_next(v, w)
        discard(v, f)
        return out
    }
    if name == "filter" {
        var out = -1
        if w.is_range {
            let kc = konst(v, 0)
            out = rt(v, "grasm_list_new_scalar", [kc], R_BOX)
        } else {
            out = empty_list_for(v, t, w.te)
        }
        walk_head(v, w)
        let x = walk_elem(v, t, w)
        let xa = if ir.ty_boxed(ek) { retain_copy(v, x) } else { x }
        let keep = apply_fn(info, v, e, 1, f, [xa], ir.TY_BOOL)
        let yes = new_block(v)
        let no = new_block(v)
        term_brif(v, keep, yes, no)
        switch_to(v, yes)
        if w.is_range {
            let kc = konst(v, 0)
            forget_temp(v, out)
            let nl = rt(v, "grasm_list_push_scalar", [out, x, kc], R_BOX)
            replace_temp(v, out, nl)
            own_temp(v, out)
        } else {
            push_elem(v, t, out, x, ete)
        }
        term_jump(v, w.step)
        if ir.ty_boxed(ek) {
            own_temp(v, x)
        }
        switch_to(v, no)
        if ir.ty_boxed(ek) {
            drop_temp(v, x)
        }
        walk_next(v, w)
        discard(v, f)
        return out
    }
    if name == "any" or name == "all" {
        let res = new_var(v, ir.TY_BOOL)
        let init = konst(v, if name == "all" { 1 } else { 0 })
        copy_to(v, res, init)
        walk_head(v, w)
        let x = walk_elem(v, t, w)
        let c = apply_fn(info, v, e, 1, f, [x], ir.TY_BOOL)
        let stop = new_block(v)
        let cont = new_block(v)
        if name == "all" {
            term_brif(v, c, cont, stop)
        } else {
            term_brif(v, c, stop, cont)
        }
        switch_to(v, stop)
        let fin = konst(v, if name == "all" { 0 } else { 1 })
        copy_to(v, res, fin)
        term_jump(v, w.exit)
        switch_to(v, cont)
        walk_next(v, w)
        discard(v, f)
        return res
    }
    // `find`: the first element that matches, as `Some`, else `None`.
    let tn = text_args(v, "Option")
    let nn = text_args(v, "None")
    let res = rt(v, "grasm_variant_new", [tn[0], tn[1], nn[0], nn[1]], R_BOX)
    walk_head(v, w)
    let x = walk_elem(v, t, w)
    let xa = if ir.ty_boxed(ek) { retain_copy(v, x) } else { x }
    let c = apply_fn(info, v, e, 1, f, [xa], ir.TY_BOOL)
    let hit = new_block(v)
    let miss = new_block(v)
    term_brif(v, c, hit, miss)
    switch_to(v, hit)
    // The `None` it started as goes; the element is the `Some`'s now.
    emit(v, ir.M_DEC, -1, res, -1, 0)
    let b = box_kind(v, x, ek)
    forget_temp(v, b)
    let tn2 = text_args(v, "Option")
    let sn = text_args(v, "Some")
    let some = rt(v, "grasm_variant_new1", [tn2[0], tn2[1], sn[0], sn[1], b], R_BOX)
    replace_temp(v, res, some)
    term_jump(v, w.exit)
    if ir.ty_boxed(ek) {
        own_temp(v, x)
    }
    switch_to(v, miss)
    if ir.ty_boxed(ek) {
        drop_temp(v, x)
    }
    walk_next(v, w)
    discard(v, f)
    res
}

/// `xs.sort_by(key)`: every key computed first, over a copy of the list,
/// then the list sorted by them (`grasm_list_sort_by`, which lends the keys)
/// and stored back where it was, as a mutating method stores its receiver.
fn sort_by_method(info: TirInfo, inout v: Vir, e: i64) -> i64 {
    mut_method(info, v, e, "grasm_list_sort_by", "K", [])
}

/// A walk over list `l` (an owned temporary, released when the walk ends)
/// of elements of type `te`.
fn walk_list(inout v: Vir, l: i64, te: i64) -> Walk {
    var w = Walk{ is_range: false, l: l, te: te, ctr: -1, end: -1, incl: false, n: -1, head: -1, body: -1, step: -1, exit: -1 }
    w.n = rt(v, "grasm_list_len", [l], R_WORD)
    w.ctr = new_var(v, ir.TY_I64)
    let z = konst(v, 0)
    copy_to(v, w.ctr, z)
    w
}

// ----- functions -------------------------------------------------------------------

/// The type element of a block's value: its last child's, when that is an
/// expression; -1 when the block has no value.
fn block_tail_te(t: TirTree, b: i64) -> i64 {
    let ks = sexp.kids(t, b)
    if ks.is_empty() {
        return -1
    }
    let last = ks[ks.len() - 1]
    if is_stmt(sexp.kw(t, last)) {
        return -1
    }
    ty_el(t, last, 1)
}

/// Lowers callable `c` (a function or a constant). Anything outside the
/// subset is in `errors` of the result.
pub fn lower_callable(info: TirInfo, c: i64) -> Vir {
    let t = info.t
    var v = new_vir()
    let e = info.c_elem[c]
    var body = -1
    if info.c_const[c] {
        let ty = kind_at(t, e, 2)
        if not held(ty) {
            bad(v, "outside the subset: constant `{info.c_name[c]}` of type {ty_text(t, e, 2)}")
        }
        v.returns = valued(ty)
        v.ret_kind = ty
        body = sexp.kids(t, e)[0]
    } else {
        if t.count[sexp.at(t, e, 2)] > 1 {
            bad(v, "outside the subset: generic function `{info.c_name[c]}`")
        }
        let rty = kind_at(t, e, 4)
        if not held(rty) {
            bad(v, "outside the subset: `{info.c_name[c]}` answers {ty_text(t, e, 4)}")
        }
        v.returns = valued(rty)
        v.ret_kind = rty
        if fn_err(info, c) >= 0 {
            if not ir.ty_boxed(kind_at(t, e, 5)) {
                bad(v, "outside the subset: `{info.c_name[c]}` fails with {ty_text(t, e, 5)}")
            }
            v.returns = true
            v.ok_te = ty_el(t, e, 4)
            v.boxed_result = not is_split(info, c)
        }
        body = sexp.kids(t, e)[1]
    }
    v.fn_span = span_start(t, body)
    v.cur_span = v.fn_span
    // The function's own scope: its parameters.
    open_scope(v)
    if info.recursive[c] {
        v.floor = new_var(v, ir.TY_I64)
    }
    // The floor, the parameters and a split function's address for its word
    // travel in x0..x7 and then on the stack (`aarch64/src/isel.gr`).
    let params = params_of(info, c)
    var inout_ids: [i64] = []
    var inout_addr: [i64] = []
    var inout_ty: [i64] = []
    var owned_params: [i64] = []
    for p in params {
        let mode = sexp.word(t, p, 1)
        let id = sexp.word(t, p, 2).parse_int() ?? -1
        let ty = kind_at(t, p, 4)
        if not held(ty) {
            bad(v, "outside the subset: parameter of type {ty_text(t, p, 4)} in `{info.c_name[c]}`")
        }
        let pv = new_var(v, if mode == "inout" { ir.TY_I64 } else { ty })
        v.tvty.set(id, ty_el(t, p, 4))
        if mode == "inout" {
            inout_ids.push(id)
            inout_addr.push(pv)
            inout_ty.push(ty)
        } else {
            v.tvar.set(id, pv)
            if ir.ty_boxed(ty) {
                owned_params.push(pv)
            }
        }
    }
    for pv in owned_params {
        own_var(v, pv)
    }
    if not info.c_const[c] and is_split(info, c) {
        v.split_out = new_var(v, ir.TY_I64)
    }
    v.nparams = v.nvars
    let entry = new_block(v)
    switch_to(v, entry)
    // An `inout` parameter arrives as the address of the caller's slot: it
    // is read once here and written back at every return.
    for i in 0..inout_ids.len() {
        let val = new_var(v, inout_ty[i])
        load_into(v, val, inout_addr[i])
        v.tvar.set(inout_ids[i], val)
        v.io_val.push(val)
        v.io_addr.push(inout_addr[i])
    }
    // [E-RECURSION-DEPTH]: a function that can reach itself checks the
    // stack against the floor it was handed.
    if v.floor >= 0 {
        let sp = new_var(v, ir.TY_I64)
        emit(v, ir.M_GETSP, sp, -1, -1, 0)
        let lowc = icmp(v, ir.CC_ULT, sp, v.floor)
        let over = new_block(v)
        let ok = new_block(v)
        term_brif(v, lowc, over, ok)
        switch_to(v, over)
        callrt(v, ir.RT_PANIC_STACK, [])
        switch_to(v, ok)
    }
    let x = lower_expr(info, v, body)
    // Falling off the end is the closing brace's.
    let body_end = span_end(t, body)
    if body_end > 0 {
        v.cur_span = body_end - 1
    }
    if v.open and (v.split_out >= 0 or v.boxed_result) {
        leave_with(t, v, x, block_tail_te(t, body))
    }
    if v.open and is_temp(v, x) and ty_head(t, block_tail_te(t, body)) == "fallible" {
        // A result left as the tail of a `main` that cannot fail: its error
        // ends the program, as the Cranelift build reports it.
        let okc = rt(v, "grasm_is_ok", [x], R_BOOL8)
        let okb = new_block(v)
        let errb = new_block(v)
        term_brif(v, okc, okb, errb)
        switch_to(v, errb)
        forget_temp(v, x)
        rt(v, "grasm_report_main_err", [x], R_NEVER)
        own_temp(v, x)
        switch_to(v, okb)
    }
    if v.open {
        var r = x
        if not v.returns {
            discard(v, r)
            r = -1
        } else if r < 0 {
            r = zero_like(v, v.ret_kind)
        }
        do_return(v, r)
    }
    v.scope_mark.pop()
    v
}

/// The C entry point: publishes `argv` for `args()`, runs `main`, and
/// returns 0 -- what the Cranelift build's `main` does, less the layout
/// checks, which guard inline reads of runtime values this backend does not
/// make.
pub fn lower_entry(info: TirInfo) -> Vir {
    var v = new_vir()
    let argc = new_var(v, ir.TY_I64)
    let argv = new_var(v, ir.TY_I64)
    v.nparams = 2
    v.returns = true
    let entry = new_block(v)
    switch_to(v, entry)
    let n = op1(v, ir.M_SEXT32, argc)
    let one = konst(v, 1)
    let n1 = op2(v, ir.M_SUB, n, one)
    let eight = konst(v, 8)
    let av = op2(v, ir.M_ADD, argv, eight)
    callrt(v, ir.RT_SET_ARGS, [n1, av])
    var args: [i64] = []
    if info.recursive[info.main_c] {
        args.push(floor_arg(v))
    }
    if fn_err(info, info.main_c) >= 0 {
        // A `main` that can fail answers its result: an error ends the
        // program with its report and exit 1, an `Ok` is released.
        let res = call_fn(v, info.main_c, args, true)
        v.vty[res] = ir.TY_BOX
        let c = rt(v, "grasm_is_ok", [res], R_BOOL8)
        let okb = new_block(v)
        let errb = new_block(v)
        term_brif(v, c, okb, errb)
        switch_to(v, errb)
        rt(v, "grasm_report_main_err", [res], R_NEVER)
        switch_to(v, okb)
        emit(v, ir.M_DEC, -1, res, -1, 0)
    } else {
        call_fn(v, info.main_c, args, false)
    }
    callrt(v, ir.RT_CHECK_LEAKS, [])
    let z = konst(v, 0)
    do_return(v, z)
    v
}

/// The type element of expression `x`'s value: a block's tail's, nothing
/// for a statement, else its own.
fn expr_te(t: TirTree, x: i64) -> i64 {
    let k = sexp.kw(t, x)
    if k == "block" {
        return block_tail_te(t, x)
    }
    if is_stmt(k) {
        return -1
    }
    ty_el(t, x, 1)
}

/// The function closure `e` is lifted into: its environment, then its
/// parameters, all owned and released when it returns; the captures `ids`
/// (of types `tes`) unpacked from the environment at entry, each bound to
/// the variable number it was captured from, so the body reads them as it
/// would have read the originals. A closure that can fail answers its whole
/// result as a box, as a fallible `main` does.
pub fn lower_lifted_closure(info: TirInfo, e: i64, ids: [i64], tes: [i64]) -> Vir {
    let t = info.t
    var v = new_vir()
    let ks = sexp.kids(t, e)
    // A `go` task is a closure of no arguments over its block, answering
    // nothing: its value, if it has one, is released as it ends.
    let task = sexp.kw(t, e) == "spawn"
    let fty = if task { -1 } else { ty_el(t, e, 1) }
    let rte = if task { -1 } else { fn_ret(t, fty) }
    let rk = if task { ir.TY_UNIT } else { ty_kind(t, rte) }
    var params: [i64] = []
    if not task {
        params = sexp.kids(t, ks[0])
    }
    let body = if task { ks[0] } else { ks[1] }
    v.fn_span = span_start(t, e)
    v.cur_span = v.fn_span
    if not task and ty_head(t, rte) == "fallible" {
        v.returns = true
        v.ok_te = ty_arg(t, rte, 1)
        v.boxed_result = true
    } else {
        v.returns = valued(rk)
        v.ret_kind = rk
    }
    open_scope(v)
    let env = new_var(v, ir.TY_BOX)
    var owned: [i64] = [env]
    for p in params {
        // (var id "name" mode T)
        let id = sexp.word(t, p, 1).parse_int() ?? -1
        let te = ty_el(t, p, 4)
        let k = ty_kind(t, te)
        if not held(k) {
            bad(v, "outside the subset: a closure parameter of type {ty_text(t, p, 4)} {span_of(t, e)}")
        }
        let pv = new_var(v, if held(k) { k } else { ir.TY_I64 })
        v.tvar.set(id, pv)
        v.tvty.set(id, te)
        if ir.ty_boxed(k) {
            owned.push(pv)
        }
    }
    for x in owned {
        own_var(v, x)
    }
    v.nparams = v.nvars
    let entry = new_block(v)
    switch_to(v, entry)
    for k in 0..ids.len() {
        let kind = ty_kind(t, tes[k])
        let ic = konst(v, k)
        let b = rt(v, "grasm_list_get", [env, ic], R_BOX)
        let x = unbox_kind(v, b, kind)
        let w = bind_tvar(v, ids[k], kind, tes[k])
        copy_to(v, w, x)
        if ir.ty_boxed(kind) {
            forget_temp(v, x)
            own_var(v, w)
        }
    }
    let x = lower_expr(info, v, body)
    let body_end = span_end(t, body)
    if body_end > 0 {
        v.cur_span = body_end - 1
    }
    if v.open and v.boxed_result {
        leave_with(t, v, x, expr_te(t, body))
    }
    if v.open {
        var r = x
        if not v.returns {
            discard(v, r)
            r = -1
        } else if r < 0 {
            r = zero_like(v, rk)
        }
        do_return(v, r)
    }
    v.scope_mark.pop()
    v
}

/// The function a named function `c` is called through as a value: the
/// closure convention's environment first, which it releases, then `c`'s
/// parameters, handed on. A function that can reach itself is given a stack
/// floor here, where the recursion is entered, as the Cranelift build's
/// wrapper does; one that answers by the split-result convention has its
/// tag and word boxed into the result a value's caller expects.
pub fn lower_wrapper(info: TirInfo, c: i64) -> Vir {
    let t = info.t
    var v = new_vir()
    let e = info.c_elem[c]
    let split = is_split(info, c)
    let rk = kind_at(t, e, 4)
    v.returns = returns_value(info, c)
    open_scope(v)
    let env = new_var(v, ir.TY_BOX)
    own_var(v, env)
    var pvs: [i64] = []
    for p in params_of(info, c) {
        let k = kind_at(t, p, 4)
        if sexp.word(t, p, 1) == "inout" or not held(k) {
            bad(v, "outside the subset: `{info.c_name[c]}` as a value")
        }
        pvs.push(new_var(v, if held(k) { k } else { ir.TY_I64 }))
    }
    v.nparams = v.nvars
    let entry = new_block(v)
    switch_to(v, entry)
    var args: [i64] = []
    if info.recursive[c] {
        args.push(floor_arg(v))
    }
    for p in pvs {
        args.push(p)
    }
    var out_slot = -1
    if split {
        out_slot = fresh_slot(v)
        args.push(slot_addr(v, out_slot))
    }
    var r = call_fn(v, c, args, returns_value(info, c))
    if r >= 0 and not split and ir.ty_fp(rk) {
        v.vty[r] = ir.TY_F64
    }
    if split {
        let tag = op1(v, ir.M_UEXT8, r)
        let w = new_var(v, ir.TY_I64)
        let a = slot_addr(v, out_slot)
        emit(v, ir.M_LOAD, w, a, -1, 0)
        let kc = konst(v, result_kind(t, sexp.at(t, e, 4)))
        r = rt(v, "grasm_result_box", [tag, w, kc], R_BOX)
    }
    do_return(v, if v.returns { r } else { -1 })
    v.scope_mark.pop()
    v
}

/// Where closure `e` begins in the source: the start of its span, which
/// names its lifted function.
pub fn closure_at(t: TirTree, e: i64) -> str {
    let s = span_of(t, e)
    if s.starts_with("@") {
        return s.substr(1, s.len() - 1).split(":")[0]
    }
    "0"
}
