// `mir`: TIR in, SSA MIR out (docs/self-hosting.md, stage S3).
//
//     sexp.gr   the TIR text reader
//     mono.gr   generic functions instantiated at the types they are used at
//     prog.gr   the whole program: callables, reachability, recursion, symbols
//     lower.gr  TIR to three-address code over variables; decides the subset
//     ssa.gr    variables to SSA with block arguments
//     ir.gr     MIR itself: opcodes, the function record, a printer
import sexp
import mono
import ir
import prog
import lower
import ssa

/// Reads a program's TIR and builds the MIR of every function `main`
/// reaches, plus the C entry point. A program outside the subset is an
/// error naming every construct that put it there.
pub fn build(src: bytes) -> MirProg ! str {
    let t0 = try sexp.read(src)
    let mo = try mono.monomorphize(t0)
    let t = mo.t
    var info = try prog.index(t)
    info.field_ty = mo.field_ty
    var errors: [str] = []
    let me = info.c_elem[info.main_c]
    if sexp.kids(t, sexp.kids(t, me)[0]).len() > 0 {
        errors.push("outside the subset: `main` takes parameters")
    }
    let mret = sexp.word(t, me, 4)
    if mret != "unit" {
        errors.push("outside the subset: `main` answers {mret}")
    }
    var fns: [MirFn] = []
    var strs: [str] = []
    var str_ix: Map[str, i64] = {}
    var descs: [MirDesc] = []
    var desc_ix: Map[str, i64] = {}
    var rt_syms = ir.rt_fixed()
    var rt_ix: Map[str, i64] = {}
    for k in 0..rt_syms.len() {
        rt_ix.set(rt_syms[k], k)
    }
    var order: [i64] = []
    for c in 0..info.c_name.len() {
        if info.reach[c] {
            order.push(c)
        }
    }
    // Lifted functions -- closures' bodies and named functions' wrappers --
    // made as the functions that use them are lowered, each once, and each
    // given a callable id past the program's own (`nc + k`) and a symbol of
    // its own. They are lowered after the program's functions, in the order
    // they were found; the C entry is last.
    let nc = info.c_name.len()
    var callee_sym = info.sym
    var used: Map[str, i64] = {}
    used.set("_main", 1)
    for s in info.sym {
        if s != "" {
            used.set(s, 1)
        }
    }
    var lifts = Lifted{ key: {}, kind: [], elem: [], caps: [], capte: [], name: [], global: [] }
    // Each `export fn`, by name ([T-EXPORT]).
    var exports: Map[str, bool] = {}
    for r in t.roots {
        if sexp.kw(t, r) == "export" {
            exports.set(sexp.word(t, r, 1), true)
        }
    }
    var q = 0
    var done_own = false
    while true {
        var c = -2
        if q < order.len() {
            c = order[q]
            q += 1
        } else if lifts.kind.len() > q - order.len() {
            c = nc + (q - order.len())
            q += 1
        } else if not done_own {
            c = -1
            done_own = true
        } else {
            break
        }
        var v = lower.new_vir()
        var name = "<entry>"
        var sym = "_main"
        if c == -1 {
            v = lower.lower_entry(info)
        } else if c < nc {
            v = lower.lower_callable(info, c)
            name = info.c_name[c]
            sym = info.sym[c]
        } else {
            let k = c - nc
            if lifts.kind[k] == lower.LIFT_CLOSURE {
                v = lower.lower_lifted_closure(info, lifts.elem[k], lifts.caps[k], lifts.capte[k])
            } else if lifts.kind[k] == lower.LIFT_WORKER {
                v = lower.lower_worker(lifts.elem[k])
            } else if lifts.kind[k] == lower.LIFT_EXTERN {
                v = lower.lower_extern_wrapper(info, lifts.elem[k])
            } else if lifts.kind[k] == lower.LIFT_CENTRY {
                v = lower.lower_centry(info, lifts.elem[k])
            } else {
                v = lower.lower_wrapper(info, lifts.elem[k])
            }
            name = lifts.name[k]
            sym = callee_sym[c]
        }
        for m in v.errors {
            errors.push("{name}: {m}")
        }
        if v.errors.len() > 0 {
            continue
        }
        // The functions it makes values of, each found once in the program.
        for i in 0..v.op.len() {
            if v.op[i] == ir.M_FNADDR {
                let li = v.imm[i]
                v.imm[i] = register(lifts, callee_sym, used, info, nc, exports, v.lift_kind[li], v.lift_elem[li], v.lift_caps[li], v.lift_capte[li], name, sym)
            }
        }
        // An `export fn` has its C entry whether or not its address is
        // taken: C finds it by name ([T-EXPORT]).
        if c >= 0 and c < nc and exports.has(info.c_name[c]) and lower.c_compatible(info, c) {
            register(lifts, callee_sym, used, info, nc, exports, lower.LIFT_CENTRY, c, [], [], name, sym)
        }
        // String literals go into one pool for the object, each once.
        for i in 0..v.op.len() {
            if v.op[i] == ir.M_STRADDR {
                let s = v.strs[v.imm[i]]
                let g = match str_ix.get(s) {
                    Some(k) -> k
                    None -> {
                        let k = strs.len()
                        strs.push(s)
                        str_ix.set(s, k)
                        k
                    }
                }
                v.imm[i] = g
            }
            // Struct descriptors, each once, their names in the string pool.
            if v.op[i] == ir.M_DATAADDR {
                let d = v.descs[v.imm[i]]
                let key = lower.desc_key(d)
                let g = match desc_ix.get(key) {
                    Some(k) -> k
                    None -> {
                        let k = descs.len()
                        var nd = d
                        nd.name_str = intern(strs, str_ix, d.name)
                        nd.field_strs = []
                        for fname in d.fields {
                            nd.field_strs.push(intern(strs, str_ix, fname))
                        }
                        descs.push(nd)
                        desc_ix.set(key, k)
                        k
                    }
                }
                v.imm[i] = g
            }
            // So do the runtime functions it names, after the fixed ones.
            if (v.op[i] == ir.M_CALLRT or v.op[i] == ir.M_GOTADDR) and v.imm[i] >= ir.RT_COUNT {
                let name = v.rts[v.imm[i] - ir.RT_COUNT]
                let g = match rt_ix.get(name) {
                    Some(k) -> k
                    None -> {
                        let k = rt_syms.len()
                        rt_syms.push(name)
                        rt_ix.set(name, k)
                        k
                    }
                }
                v.imm[i] = g
            }
        }
        var f = try ssa.to_ssa(v, name, sym)
        if c >= nc and lifts.global[c - nc] {
            f.global = true
        }
        fns.push(f)
    }
    if errors.len() > 0 {
        fail(errors.join("\n"))
    }
    MirProg{ fns: fns, callee_sym: callee_sym, strs: strs, rt_syms: rt_syms, descs: descs }
}

/// The lifted functions found so far: by key (`c<element>` for a closure,
/// `w<callable>` for a wrapper), and in the order found.
type Lifted = {
    key: Map[str, i64],
    kind: [i64],
    elem: [i64],
    caps: [[i64]],
    capte: [[i64]],
    name: [str],
    /// Whether its symbol is global: an `export fn`'s C entry.
    global: [bool],
}

/// The callable id of lifted function `(lk, le)`, made the first time it is
/// asked for: its kind, element and captures recorded, and a symbol of its
/// own given it. `name` and `sym` are the function asking, which names a
/// closure lifted from it.
fn register(inout lifts: Lifted, inout callee_sym: [str], inout used: Map[str, i64], info: TirInfo, nc: i64, exports: Map[str, bool], lk: i64, le: i64, caps: [i64], capte: [i64], name: str, sym: str) -> i64 {
    let t = info.t
    let key = if lk == lower.LIFT_CLOSURE { "c{le}" } else if lk == lower.LIFT_WORKER { "k{le}" } else if lk == lower.LIFT_EXTERN { "x{le}" } else if lk == lower.LIFT_CENTRY { "e{le}" } else { "w{le}" }
    match lifts.key.get(key) {
        Some(id) -> id
        None -> {
            let id = nc + lifts.kind.len()
            lifts.key.set(key, id)
            lifts.kind.push(lk)
            lifts.elem.push(le)
            lifts.caps.push(caps)
            lifts.capte.push(capte)
            var global = false
            var base = ""
            if lk == lower.LIFT_CLOSURE {
                let at = lower.closure_at(t, le)
                lifts.name.push("{name}::<closure@{at}>")
                base = "_gc_" + sym.substr(3, sym.len() - 3) + "_{at}"
            } else if lk == lower.LIFT_WORKER {
                // One per pair of element and result classes, whoever asked
                // for it first.
                lifts.name.push("<parallel worker {le}>")
                base = "_gw_worker_{le}"
            } else if lk == lower.LIFT_EXTERN {
                let xn = sexp.word(t, le, 1)
                lifts.name.push("{xn} as a value")
                base = "_gv_" + prog.sanitize(xn.replace("::", "_"))
            } else if lk == lower.LIFT_CENTRY {
                lifts.name.push("{info.c_name[le]} from C")
                if exports.has(info.c_name[le]) {
                    // An export's entry is C's: its own name, global.
                    let parts = info.c_name[le].split("::")
                    base = "_" + parts[parts.len() - 1]
                    global = true
                } else {
                    base = "_gx_" + info.sym[le].substr(3, info.sym[le].len() - 3)
                }
            } else {
                lifts.name.push("{info.c_name[le]} as a value")
                base = "_gv_" + info.sym[le].substr(3, info.sym[le].len() - 3)
            }
            lifts.global.push(global)
            var s = base
            var n = 2
            while used.has(s) {
                s = base + "_{n}"
                n += 1
            }
            used.set(s, 1)
            callee_sym.push(s)
            id
        }
    }
}

/// Text `s`'s index in the string pool, adding it once.
fn intern(inout strs: [str], inout str_ix: Map[str, i64], s: str) -> i64 {
    match str_ix.get(s) {
        Some(k) -> k
        None -> {
            let k = strs.len()
            strs.push(s)
            str_ix.set(s, k)
            k
        }
    }
}

/// The whole program as text.
pub fn print_prog(p: MirProg) -> str {
    var out = str_builder()
    for i in 0..p.strs.len() {
        out.push_str("s{i} = {sexp_quote(p.strs[i])}\n")
    }
    for f in p.fns {
        out.push_str(ir.print_fn(f, p.callee_sym, p.rt_syms))
    }
    out.to_str()
}

fn sexp_quote(s: str) -> str {
    var out = str_builder()
    out.push_str("\"")
    for c in s.codes() {
        if c == 34 {
            out.push_str("\\\"")
        } else if c == 92 {
            out.push_str("\\\\")
        } else if c == 10 {
            out.push_str("\\n")
        } else if c < 32 or c == 127 {
            out.push_str("\\u" + c.to_base(16).pad_start(4, "0"))
        } else {
            out.push_str(c.to_char())
        }
    }
    out.push_str("\"")
    out.to_str()
}
