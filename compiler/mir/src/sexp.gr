// The TIR text form (docs/tir.md §9): s-expressions of atoms, JSON-escaped
// strings and lists, one top-level form per declaration.
//
// This is the reader of `tools/tirinterp/src/sexp.gr`, without its printer:
// the backend reads TIR and never writes it. It keeps the one thing a plain
// s-expression reader throws away -- whether an element began on a new line
// -- because that is how a node's head (keyword, type, span, operands) is told
// from its children (each on a line of its own).
//
// The reader is iterative: expression chains nest hundreds deep in the
// corpus, and the language guarantees only 10,000 nested calls.

/// A parsed TIR file. Element `e` is an atom (`kind` 0), a string (1) or a
/// list (2); a list's elements are `elems[first[e] .. first[e] + count[e]]`.
type TirTree = {
    kind: [i64],
    text: [str],
    first: [i64],
    count: [i64],
    nl: [bool],
    elems: [i64],
    roots: [i64],
}

pub fn new_tree() -> TirTree {
    TirTree{ kind: [], text: [], first: [], count: [], nl: [], elems: [], roots: [] }
}

fn add_elem(inout t: TirTree, kind: i64, text: str, nl: bool) -> i64 {
    let id = t.kind.len()
    t.kind.push(kind)
    t.text.push(text)
    t.first.push(0)
    t.count.push(0)
    t.nl.push(nl)
    id
}

/// Whether a byte ends an atom.
fn delimits(c: i64) -> bool {
    c == 32 or c == 10 or c == 40 or c == 41 or c == 34 or c == 13 or c == 9
}

fn hex_digit(c: i64) -> i64 {
    if c >= 48 and c <= 57 {
        c - 48
    } else if c >= 97 and c <= 102 {
        c - 87
    } else if c >= 65 and c <= 70 {
        c - 55
    } else {
        -1
    }
}

/// The JSON string starting at `start` (just past its opening quote): its
/// decoded text and the offset just past its closing quote.
fn read_string(src: bytes, start: i64) -> (str, i64) ! str {
    let n = src.len()
    var parts: [str] = []
    var run = start
    var i = start
    while i < n {
        let c = src.at(i)
        if c == 34 {
            if i > run {
                parts.push(src.slice(run, i).to_str())
            }
            return (parts.join(""), i + 1)
        }
        if c == 92 {
            if i > run {
                parts.push(src.slice(run, i).to_str())
            }
            if i + 1 >= n {
                fail("unterminated escape at byte {i}")
            }
            let e = src.at(i + 1)
            if e == 110 {
                parts.push("\n")
                i += 2
            } else if e == 116 {
                parts.push("\t")
                i += 2
            } else if e == 114 {
                parts.push("\r")
                i += 2
            } else if e == 34 {
                parts.push("\"")
                i += 2
            } else if e == 92 {
                parts.push("\\")
                i += 2
            } else if e == 47 {
                parts.push("/")
                i += 2
            } else if e == 117 {
                if i + 6 > n {
                    fail("short \\u escape at byte {i}")
                }
                var code = 0
                for k in 2..6 {
                    let d = hex_digit(src.at(i + k))
                    if d < 0 {
                        fail("bad \\u escape at byte {i}")
                    }
                    code = code * 16 + d
                }
                parts.push(code.to_char())
                i += 6
            } else {
                fail("unknown escape at byte {i}")
            }
            run = i
        } else {
            i += 1
        }
    }
    fail("unterminated string at byte {start}")
}

/// Reads a whole TIR file.
pub fn read(src: bytes) -> TirTree ! str {
    var t = new_tree()
    // The lists still open, innermost last, and where each one's elements
    // begin in `pending`.
    var open: [i64] = []
    var marks: [i64] = []
    var pending: [i64] = []
    var saw_nl = false
    let n = src.len()
    var i = 0
    while i < n {
        let c = src.at(i)
        if c == 10 {
            saw_nl = true
            i += 1
        } else if c == 32 or c == 13 or c == 9 {
            i += 1
        } else if c == 40 {
            let id = add_elem(t, 2, "", saw_nl)
            pending.push(id)
            open.push(id)
            marks.push(pending.len())
            saw_nl = false
            i += 1
        } else if c == 41 {
            if open.is_empty() {
                fail("unbalanced `)` at byte {i}")
            }
            let id = open.pop() ?? 0
            let m = marks.pop() ?? 0
            t.first[id] = t.elems.len()
            t.count[id] = pending.len() - m
            for j in m..pending.len() {
                t.elems.push(pending[j])
            }
            while pending.len() > m {
                pending.pop()
            }
            saw_nl = false
            i += 1
        } else if c == 34 {
            let (text, next) = try read_string(src, i + 1)
            pending.push(add_elem(t, 1, text, saw_nl))
            saw_nl = false
            i = next
        } else {
            var j = i
            while j < n and not delimits(src.at(j)) {
                j += 1
            }
            pending.push(add_elem(t, 0, src.slice(i, j).to_str(), saw_nl))
            saw_nl = false
            i = j
        }
    }
    if not open.is_empty() {
        fail("{open.len()} list(s) not closed at the end of the file")
    }
    t.roots = pending
    t
}

// ----- reading nodes -------------------------------------------------------

/// Element `i` of list `e`.
pub fn at(t: TirTree, e: i64, i: i64) -> i64 {
    t.elems[t.first[e] + i]
}

/// The text of element `i` of list `e` (an atom or a decoded string), or ""
/// past its end.
pub fn word(t: TirTree, e: i64, i: i64) -> str {
    if t.kind[e] != 2 or i >= t.count[e] {
        return ""
    }
    t.text[at(t, e, i)]
}

/// Whether element `i` of `e` is a list.
pub fn is_list_at(t: TirTree, e: i64, i: i64) -> bool {
    t.kind[e] == 2 and i < t.count[e] and t.kind[at(t, e, i)] == 2
}

/// The keyword of a node: its first atom.
pub fn kw(t: TirTree, e: i64) -> str {
    if t.kind[e] != 2 or t.count[e] == 0 {
        return ""
    }
    t.text[at(t, e, 0)]
}

/// How many of `e`'s elements are on its own line: the head. The rest are
/// its children, each on a line of its own.
pub fn head_len(t: TirTree, e: i64) -> i64 {
    var i = 1
    while i < t.count[e] and not t.nl[at(t, e, i)] {
        i += 1
    }
    i
}

/// A node's children: the elements after its head.
pub fn kids(t: TirTree, e: i64) -> [i64] {
    var out: [i64] = []
    if t.kind[e] != 2 {
        return out
    }
    for i in head_len(t, e)..t.count[e] {
        out.push(at(t, e, i))
    }
    out
}

/// A node's elements, head and children alike, from position `from`.
pub fn elems_from(t: TirTree, e: i64, from: i64) -> [i64] {
    var out: [i64] = []
    if t.kind[e] != 2 {
        return out
    }
    for i in from..t.count[e] {
        out.push(at(t, e, i))
    }
    out
}
