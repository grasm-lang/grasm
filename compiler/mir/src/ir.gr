// MIR: what the backend's middle speaks (docs/self-hosting.md §4).
//
// SSA with block arguments: every value is defined once, either as a block
// parameter or as an instruction's result, and a branch passes its target's
// parameters explicitly -- no phi nodes. Values are machine words of two
// classes: integers (and addresses, and boxed values' pointers), and doubles
// (`MirFn.vfp`), which live in the floating-point registers. The types that
// decide an operation's meaning (signedness, width) have already been turned
// into the choice of operation, and an operation fixes the class of what it
// reads and writes (`res_fp`, `arg_fp`): the only ways across are the
// conversions and the bit moves (`M_FBITS`, `M_FFROMBITS`).
//
// Everything is in flat arrays addressed by integer ids (§3.5): a block's
// instructions are a contiguous run, its parameters a run of `bparams`, a
// call's arguments a run of `cargs`.
//
// Reference counting is explicit: a value of a boxed type (a pointer to one
// of the runtime's 64-byte `RtVal`s) is retained by `inc` and released by
// `dec`, written where the lowering decides ownership changes hands
// (`lower.gr` says where), so a later pass can see them and remove them.

// ----- opcodes -------------------------------------------------------------
// The same numbers serve the variable form the lowering builds first
// (`lower.gr`) and the SSA form it becomes (`ssa.gr`).

pub let M_ICONST = 1
/// Only in the variable form: SSA construction turns every copy into a
/// renaming, so no `M_COPY` survives into MIR.
pub let M_COPY = 2
pub let M_ADD = 3
pub let M_SUB = 4
pub let M_MUL = 5
pub let M_SDIV = 6
pub let M_UDIV = 7
pub let M_SREM = 8
pub let M_UREM = 9
pub let M_AND = 10
pub let M_OR = 11
pub let M_XOR = 12
pub let M_SHL = 13
pub let M_SSHR = 14
pub let M_USHR = 15
pub let M_NEG = 16
pub let M_NOT = 17
pub let M_SEXT8 = 18
pub let M_SEXT16 = 19
pub let M_SEXT32 = 20
pub let M_UEXT8 = 21
pub let M_UEXT16 = 22
pub let M_UEXT32 = 23
/// `res = a <cc> b`, 0 or 1; `imm` is the condition (`CC_*`).
pub let M_ICMP = 24
/// A call of a compiled function: `imm` is the callee's callable id.
pub let M_CALL = 25
/// A call into the runtime: `imm` is the symbol (`RT_*`).
pub let M_CALLRT = 26
/// The address of string literal `imm` in the object's data.
pub let M_STRADDR = 27
/// The stack pointer, for the recursion-depth check ([E-RECURSION-DEPTH]).
pub let M_GETSP = 28
/// The address of 8-byte frame slot `imm` (an `inout` argument's home).
pub let M_SLOTADDR = 29
pub let M_LOAD = 30
pub let M_STORE = 31
/// Retains the boxed value `a` (`grasm_val_inc`); a null pointer is left be.
pub let M_INC = 32
/// Releases the boxed value `a` (`grasm_val_dec`), freeing it and whatever it
/// was the last owner of when its count reaches zero.
pub let M_DEC = 33
/// The address of writable data object `imm` of the program (`MirProg.descs`:
/// a struct descriptor the runtime reads and caches its type in).
pub let M_DATAADDR = 34
/// The address of compiled function `imm` (a callable id): the code of a
/// function value (`grasm_fn_new`).
pub let M_FNADDR = 35
/// A call through a code address `a`, with the arguments in `cargs`: a
/// function value's code, which takes the value's environment first.
pub let M_CALLIND = 36
// Terminators.
pub let M_JUMP = 40
pub let M_BRIF = 41
pub let M_RET = 42
/// Control cannot reach here: after a call that does not return, or past a
/// `match` the checker proved exhaustive.
pub let M_TRAP = 43
// Doubles. Arithmetic is IEEE 754 binary64 with the default rounding, as
// the Cranelift build's `fadd` .. `fdiv`.
/// A double whose bits are `imm`.
pub let M_FCONST = 50
pub let M_FADD = 51
pub let M_FSUB = 52
pub let M_FMUL = 53
pub let M_FDIV = 54
/// The sign bit flipped (so `-0.0` from `0.0`).
pub let M_FNEG = 55
pub let M_FABS = 56
pub let M_FSQRT = 57
pub let M_FFLOOR = 58
pub let M_FCEIL = 59
/// `res = a <cc> b` on doubles, 0 or 1; `imm` is one of `CC_EQ` .. `CC_SGE`,
/// read as IEEE comparisons: ordered (false on a NaN) but for `ne`, which a
/// NaN makes true.
pub let M_FCMP = 60
/// A signed integer to a double.
pub let M_SCVTF = 61
/// An unsigned integer to a double.
pub let M_UCVTF = 62
/// A double to a signed integer, toward zero, saturating; NaN is 0.
pub let M_FCVTZS = 63
/// A double to an unsigned integer, toward zero, saturating; NaN is 0.
pub let M_FCVTZU = 64
/// The double's bits, as an integer.
pub let M_FBITS = 65
/// The integer's bits, as a double.
pub let M_FFROMBITS = 66
/// `M_LOAD` and `M_STORE` of a double.
pub let M_FLOAD = 67
pub let M_FSTORE = 68
// Bits ([L-LIB-BITS-WIDTH]), all on the 64-bit word.
/// The number of leading zero bits (64 for zero).
pub let M_CLZ = 80
/// The bits in reverse order.
pub let M_RBIT = 81
/// The eight bytes in reverse order.
pub let M_BSWAP64 = 82
/// The low two bytes swapped, the rest zero.
pub let M_BSWAP16 = 83
/// The low four bytes in reverse order, the rest zero.
pub let M_BSWAP32 = 84
/// `a` turned right by `b` modulo 64.
pub let M_ROTR = 85
// Raw memory ([L-LIB-MEM]): a load of 1, 2 or 4 bytes at address `a`,
// zero- or sign-extended to the word; a store of the low bytes of `b` at `a`.
pub let M_LOAD8U = 86
pub let M_LOAD8S = 87
pub let M_LOAD16U = 88
pub let M_LOAD16S = 89
pub let M_LOAD32U = 90
pub let M_LOAD32S = 91
pub let M_STORE8 = 92
pub let M_STORE16 = 93
pub let M_STORE32 = 94
// Atomics ([L-LIB-ATOMIC]) at address `a`, of 1, 2, 4 or 8 bytes, each
// sequentially consistent: a load (zero-extended), a store of `b`, a
// fetch-add of `b`, and a compare-and-swap that stores the third operand
// (`cargs`) where `b` was found; the last two answer what was there.
pub let M_ALOAD8 = 95
pub let M_ALOAD64 = 98
pub let M_ASTORE8 = 99
pub let M_ASTORE64 = 102
pub let M_AADD8 = 103
pub let M_AADD64 = 106
pub let M_ACAS8 = 107
pub let M_ACAS64 = 110
/// The address of C function `imm` (a runtime-symbol id, as `M_CALLRT`'s),
/// through the global offset table ([T-FN-ADDR]).
pub let M_GOTADDR = 111

/// The atomic of class `base` (`M_ALOAD8`, `M_ASTORE8`, `M_AADD8`,
/// `M_ACAS8`) at `size` bytes.
pub fn atomic_at(base: i64, size: i64) -> i64 {
    base + if size == 1 { 0 } else if size == 2 { 1 } else if size == 4 { 2 } else { 3 }
}

/// Whether an instruction reads operands from `cargs` past `a` and `b`: a
/// call's arguments, a compare-and-swap's new value.
pub fn has_cargs(op: i64) -> bool {
    op == M_CALL or op == M_CALLRT or op == M_CALLIND or (op >= M_ACAS8 and op <= M_ACAS64)
}

pub fn is_terminator(op: i64) -> bool {
    op >= M_JUMP and op <= M_TRAP
}

/// Whether an instruction has no effect but its result, so it may be
/// removed when nothing reads the result.
pub fn pure_op(op: i64) -> bool {
    op != M_CALL and op != M_CALLRT and op != M_CALLIND and op != M_STORE and op != M_FSTORE and op != M_INC and op != M_DEC and not is_terminator(op) and not (op >= M_STORE8 and op <= M_ACAS64)
}

/// Whether an instruction's result is a double. A call's is whatever the
/// value it defines is (`MirFn.vfp`); every other operation fixes it.
pub fn res_fp(op: i64) -> bool {
    op == M_FCONST or (op >= M_FADD and op <= M_FCEIL) or op == M_SCVTF or op == M_UCVTF or op == M_FFROMBITS or op == M_FLOAD
}

/// Whether operand `k` (0 for `a`, 1 for `b`) of an instruction is a double.
pub fn arg_fp(op: i64, k: i64) -> bool {
    if (op >= M_FADD and op <= M_FCEIL) or op == M_FCMP {
        return true
    }
    if op == M_FCVTZS or op == M_FCVTZU or op == M_FBITS {
        return k == 0
    }
    if op == M_FSTORE {
        // The address, then the double stored there.
        return k == 1
    }
    false
}

// ----- conditions ------------------------------------------------------------

pub let CC_EQ = 0
pub let CC_NE = 1
pub let CC_SLT = 2
pub let CC_SLE = 3
pub let CC_SGT = 4
pub let CC_SGE = 5
pub let CC_ULT = 6
pub let CC_ULE = 7
pub let CC_UGT = 8
pub let CC_UGE = 9

pub fn cc_name(cc: i64) -> str {
    match cc {
        0 -> "eq"
        1 -> "ne"
        2 -> "slt"
        3 -> "sle"
        4 -> "sgt"
        5 -> "sge"
        6 -> "ult"
        7 -> "ule"
        8 -> "ugt"
        9 -> "uge"
        _ -> "cc?"
    }
}

// ----- the types TIR writes, as the subset knows them ------------------------

pub let TY_OTHER = -1
pub let TY_UNIT = 0
pub let TY_I64 = 1
pub let TY_BOOL = 2
pub let TY_I8 = 3
pub let TY_I16 = 4
pub let TY_I32 = 5
pub let TY_U8 = 6
pub let TY_U16 = 7
pub let TY_U32 = 8
pub let TY_U64 = 9
pub let TY_NEVER = 10
/// A boxed value: a counted pointer to an `RtVal`, owned by whoever holds it.
pub let TY_BOX = 11
/// A double, held in a floating-point register.
pub let TY_F64 = 12
/// A generational reference ([T-REF-GENERATIONAL]): one word, a slot of the
/// runtime's shared heap and the generation it was on, in an integer
/// register. It owns nothing, so no `inc` or `dec` keeps it.
pub let TY_REF = 13

pub fn ty_of_name(name: str) -> i64 {
    match name {
        "unit" -> 0
        "i64" -> 1
        "bool" -> 2
        "i8" -> 3
        "i16" -> 4
        "i32" -> 5
        "u8" -> 6
        "u16" -> 7
        "u32" -> 8
        "u64" -> 9
        "never" -> 10
        "f64" -> 12
        // An address ([T-ADDR]) is a word, held as the Cranelift build holds
        // it: as an `i64`.
        "addr" -> 1
        _ -> -1
    }
}

/// A type held in a floating-point register.
pub fn ty_fp(t: i64) -> bool {
    t == TY_F64
}

/// An integer type: what arithmetic is defined on.
pub fn ty_int(t: i64) -> bool {
    t == TY_I64 or (t >= TY_I8 and t <= TY_U64)
}

pub fn ty_unsigned(t: i64) -> bool {
    t >= TY_U8 and t <= TY_U64
}

/// A type the subset holds in a register.
pub fn ty_scalar(t: i64) -> bool {
    (t >= TY_UNIT and t <= TY_NEVER) or t == TY_F64 or t == TY_REF
}

/// A counted pointer, which `inc` and `dec` keep alive.
pub fn ty_boxed(t: i64) -> bool {
    t == TY_BOX
}

// ----- runtime symbols -------------------------------------------------------
// The C functions of `crates/grasm_rt` this backend calls: the same symbols,
// with the same arguments, as the Cranelift backend uses for the same
// constructs (`crates/grasm_native`).

pub let RT_OUT_TEXT = 0
pub let RT_OUT_I64 = 1
pub let RT_OUT_U64 = 2
pub let RT_OUT_BOOL = 3
pub let RT_OUT_NL = 4
pub let RT_OUT_TO_STDERR = 5
pub let RT_PANIC_DIV_ZERO = 6
pub let RT_PANIC_REM_ZERO = 7
pub let RT_PANIC_MSG = 8
pub let RT_PANIC_ASSERT = 9
pub let RT_PANIC_VALUE = 10
pub let RT_STR_BUILD = 11
pub let RT_STR_BUILD_TEXT = 12
pub let RT_STR_BUILD_I64 = 13
pub let RT_STR_BUILD_BOOL = 14
pub let RT_STR_BUILD_END = 15
pub let RT_EXIT = 16
pub let RT_STACK_FLOOR = 17
pub let RT_PANIC_STACK = 18
pub let RT_SET_ARGS = 19
pub let RT_CHECK_LEAKS = 20
pub let RT_POW_I64 = 21
pub let RT_VAL_INC = 22
pub let RT_VAL_DEC = 23
/// Runtime symbols past the fixed ones are named by the program: a
/// `M_CALLRT` with `imm >= RT_COUNT` calls `MirProg.rt_syms[imm]`.
pub let RT_COUNT = 24

pub fn rt_name(id: i64) -> str {
    match id {
        0 -> "grasm_out_text"
        1 -> "grasm_out_i64"
        2 -> "grasm_out_u64"
        3 -> "grasm_out_bool"
        4 -> "grasm_out_nl"
        5 -> "grasm_out_to_stderr"
        6 -> "grasm_panic_div_zero"
        7 -> "grasm_panic_rem_zero"
        8 -> "grasm_panic_msg"
        9 -> "grasm_panic_assert"
        10 -> "grasm_panic_value"
        11 -> "grasm_str_build"
        12 -> "grasm_str_build_text"
        13 -> "grasm_str_build_i64"
        14 -> "grasm_str_build_bool"
        15 -> "grasm_str_build_end"
        16 -> "grasm_exit"
        17 -> "grasm_stack_floor"
        18 -> "grasm_panic_stack"
        19 -> "grasm_set_args"
        20 -> "grasm_check_leaks"
        21 -> "grasm_pow_i64"
        22 -> "grasm_val_inc"
        23 -> "grasm_val_dec"
        _ -> "grasm_unknown"
    }
}

/// The fixed runtime symbols, by id: the start of every program's pool.
pub fn rt_fixed() -> [str] {
    var out: [str] = []
    for k in 0..RT_COUNT {
        out.push(rt_name(k))
    }
    out
}

/// Whether a runtime function returns a value.
pub fn rt_returns(id: i64) -> bool {
    id == RT_STR_BUILD or id == RT_STR_BUILD_END or id == RT_STACK_FLOOR or id == RT_POW_I64
}

/// Whether a runtime function never returns (it panics or exits).
pub fn rt_noreturn(id: i64) -> bool {
    id == RT_PANIC_DIV_ZERO or id == RT_PANIC_REM_ZERO or id == RT_PANIC_MSG or id == RT_PANIC_ASSERT or id == RT_PANIC_VALUE or id == RT_EXIT or id == RT_PANIC_STACK
}

// ----- the IR ------------------------------------------------------------------

/// One function in SSA form.
type MirFn = {
    /// The TIR name (`main::fib`), or `<entry>` for the C `main`.
    name: str,
    /// The object symbol, leading underscore included.
    sym: str,
    /// Takes the hidden stack floor as its first parameter.
    floor: bool,
    /// Parameters, the floor included: the entry block's parameters.
    nparams: i64,
    /// Whether it returns a value in x0.
    returns: bool,
    /// Whether its symbol is global: an `export fn`'s C entry ([T-EXPORT]).
    global: bool,
    /// 8-byte frame slots for `inout` arguments.
    nslots: i64,
    nvals: i64,
    /// Per value: whether it is a double (in a floating-point register).
    vfp: [bool],
    // Blocks. Block 0 is the entry.
    bp0: [i64],
    bnp: [i64],
    bparams: [i64],
    bi0: [i64],
    bni: [i64],
    // Each block's terminator: its kind, the value it reads (the condition of
    // a `M_BRIF`, the result of a `M_RET`, else -1), its targets, and the
    // arguments passed to each target.
    tk: [i64],
    tv: [i64],
    tt: [i64],
    tf: [i64],
    ta0: [i64],
    tan: [i64],
    fa0: [i64],
    fan: [i64],
    targs: [i64],
    // Instructions.
    op: [i64],
    res: [i64],
    a: [i64],
    b: [i64],
    imm: [i64],
    ca0: [i64],
    can: [i64],
    cargs: [i64],
    // Where each came from, for the line table (DWARF `__debug_line`): per
    // instruction and per block's terminator, the offset in TIR's global
    // span space of the expression it was lowered from, or -1 for code no
    // source line stands for; and the function's own, for its prologue.
    ispan: [i64],
    tspan: [i64],
    span0: i64,
}

pub fn new_fn(name: str, sym: str) -> MirFn {
    MirFn{
        name: name, sym: sym, floor: false, nparams: 0, returns: false, global: false, nslots: 0, nvals: 0, vfp: [],
        bp0: [], bnp: [], bparams: [], bi0: [], bni: [],
        tk: [], tv: [], tt: [], tf: [], ta0: [], tan: [], fa0: [], fan: [], targs: [],
        op: [], res: [], a: [], b: [], imm: [], ca0: [], can: [], cargs: [],
        ispan: [], tspan: [], span0: -1,
    }
}

/// The whole program: every function the subset compiles, in TIR order,
/// then the C entry; and the string literals they print.
type MirProg = {
    fns: [MirFn],
    /// Per callable id (TIR functions, then constants): its symbol, or ""
    /// when nothing reachable from `main` calls it.
    callee_sym: [str],
    strs: [str],
    /// Every runtime symbol a `M_CALLRT` names, by id: `rt_fixed()` first,
    /// then the ones the program's functions asked for, each once.
    rt_syms: [str],
    /// The struct descriptors `M_DATAADDR` names, by id.
    descs: [MirDesc],
    /// TIR's source files, in loader order: each path as given to the
    /// loader and the base offset of its spans (docs/tir.md §2).
    files: [str],
    fbase: [i64],
}

/// A struct type's descriptor, as the runtime's `StructDesc` reads it
/// (`crates/grasm_rt`, the `StructDesc` comment): the type's name, each
/// field's name and kind (`FK_*`), each name a string of the pool.
type MirDesc = {
    name: str,
    fields: [str],
    kinds: [i64],
    name_str: i64,
    field_strs: [i64],
}

// Field kinds, the runtime's `FK_*`.
pub let FK_BOXED = 0
pub let FK_I64 = 1
pub let FK_F64 = 2
pub let FK_BOOL = 3
pub let FK_REF = 4
pub let FK_UNIT = 5
pub let FK_U64 = 9

// ----- reading it back -----------------------------------------------------------

pub fn nblocks(f: MirFn) -> i64 {
    f.bi0.len()
}

pub fn op_name(op: i64) -> str {
    match op {
        1 -> "iconst"
        2 -> "copy"
        3 -> "add"
        4 -> "sub"
        5 -> "mul"
        6 -> "sdiv"
        7 -> "udiv"
        8 -> "srem"
        9 -> "urem"
        10 -> "and"
        11 -> "or"
        12 -> "xor"
        13 -> "shl"
        14 -> "sshr"
        15 -> "ushr"
        16 -> "neg"
        17 -> "not"
        18 -> "sext8"
        19 -> "sext16"
        20 -> "sext32"
        21 -> "uext8"
        22 -> "uext16"
        23 -> "uext32"
        24 -> "icmp"
        25 -> "call"
        26 -> "callrt"
        27 -> "straddr"
        28 -> "getsp"
        29 -> "slotaddr"
        30 -> "load"
        31 -> "store"
        32 -> "inc"
        33 -> "dec"
        34 -> "dataaddr"
        35 -> "fnaddr"
        36 -> "callind"
        40 -> "jump"
        41 -> "brif"
        42 -> "ret"
        43 -> "trap"
        50 -> "fconst"
        51 -> "fadd"
        52 -> "fsub"
        53 -> "fmul"
        54 -> "fdiv"
        55 -> "fneg"
        56 -> "fabs"
        57 -> "fsqrt"
        58 -> "ffloor"
        59 -> "fceil"
        60 -> "fcmp"
        61 -> "scvtf"
        62 -> "ucvtf"
        63 -> "fcvtzs"
        64 -> "fcvtzu"
        65 -> "fbits"
        66 -> "ffrombits"
        67 -> "fload"
        68 -> "fstore"
        80 -> "clz"
        81 -> "rbit"
        82 -> "bswap64"
        83 -> "bswap16"
        84 -> "bswap32"
        85 -> "rotr"
        86 -> "load8u"
        87 -> "load8s"
        88 -> "load16u"
        89 -> "load16s"
        90 -> "load32u"
        91 -> "load32s"
        92 -> "store8"
        93 -> "store16"
        94 -> "store32"
        95 -> "aload8"
        96 -> "aload16"
        97 -> "aload32"
        98 -> "aload64"
        99 -> "astore8"
        100 -> "astore16"
        101 -> "astore32"
        102 -> "astore64"
        103 -> "aadd8"
        104 -> "aadd16"
        105 -> "aadd32"
        106 -> "aadd64"
        107 -> "acas8"
        108 -> "acas16"
        109 -> "acas32"
        110 -> "acas64"
        111 -> "gotaddr"
        _ -> "op?"
    }
}

/// How many value operands an instruction reads from `a` and `b`.
pub fn nreads(op: i64) -> i64 {
    if op == M_ICONST or op == M_STRADDR or op == M_GETSP or op == M_SLOTADDR or op == M_CALL or op == M_CALLRT or op == M_DATAADDR or op == M_FCONST or op == M_FNADDR or op == M_GOTADDR {
        0
    } else if op == M_COPY or op == M_NEG or op == M_NOT or (op >= M_SEXT8 and op <= M_UEXT32) or op == M_LOAD or op == M_INC or op == M_DEC or op == M_CALLIND {
        1
    } else if op >= M_CLZ and op <= M_BSWAP32 {
        1
    } else if (op >= M_LOAD8U and op <= M_LOAD32S) or (op >= M_ALOAD8 and op <= M_ALOAD64) {
        1
    } else if (op >= M_FNEG and op <= M_FCEIL) or (op >= M_SCVTF and op <= M_FLOAD) {
        1
    } else {
        2
    }
}

fn vname(v: i64) -> str {
    if v < 0 {
        "_"
    } else {
        "v{v}"
    }
}

fn arg_list(xs: [i64], from: i64, n: i64) -> str {
    var parts: [str] = []
    for i in from..(from + n) {
        parts.push(vname(xs[i]))
    }
    parts.join(", ")
}

/// The function as text, one instruction a line, for reading and for
/// debugging the stages after it.
pub fn print_fn(f: MirFn, callee_sym: [str], rt_syms: [str]) -> str {
    var out = str_builder()
    out.push_str("fn {f.sym} ({f.name}) params={f.nparams} floor={f.floor} returns={f.returns} slots={f.nslots}\n")
    for b in 0..nblocks(f) {
        out.push_str("  b{b}({arg_list(f.bparams, f.bp0[b], f.bnp[b])}):\n")
        for i in f.bi0[b]..(f.bi0[b] + f.bni[b]) {
            let op = f.op[i]
            var line = "    "
            if f.res[i] >= 0 {
                let cls = if f.res[i] < f.vfp.len() and f.vfp[f.res[i]] { ":f" } else { "" }
                line = line + "v{f.res[i]}{cls} = "
            }
            line = line + op_name(op)
            if op == M_ICONST or op == M_SLOTADDR {
                line = line + " {f.imm[i]}"
            } else if op == M_FCONST {
                line = line + " 0x" + f.imm[i].as_u64().to_base(16).pad_start(16, "0")
            } else if op == M_FCMP {
                line = line + "." + cc_name(f.imm[i]) + " {vname(f.a[i])}, {vname(f.b[i])}"
            } else if op == M_STRADDR {
                line = line + " s{f.imm[i]}"
            } else if op == M_DATAADDR {
                line = line + " d{f.imm[i]}"
            } else if op == M_ICMP {
                line = line + "." + cc_name(f.imm[i]) + " {vname(f.a[i])}, {vname(f.b[i])}"
            } else if op == M_CALL {
                let callee = if f.imm[i] >= 0 and f.imm[i] < callee_sym.len() { callee_sym[f.imm[i]] } else { "?" }
                line = line + " {callee}({arg_list(f.cargs, f.ca0[i], f.can[i])})"
            } else if op == M_CALLRT {
                let rn = if f.imm[i] >= 0 and f.imm[i] < rt_syms.len() { rt_syms[f.imm[i]] } else { "?" }
                line = line + " {rn}({arg_list(f.cargs, f.ca0[i], f.can[i])})"
            } else if op == M_GOTADDR {
                let rn = if f.imm[i] >= 0 and f.imm[i] < rt_syms.len() { rt_syms[f.imm[i]] } else { "?" }
                line = line + " {rn}"
            } else if op == M_FNADDR {
                let callee = if f.imm[i] >= 0 and f.imm[i] < callee_sym.len() { callee_sym[f.imm[i]] } else { "?" }
                line = line + " {callee}"
            } else if op == M_CALLIND {
                line = line + " *{vname(f.a[i])}({arg_list(f.cargs, f.ca0[i], f.can[i])})"
            } else if op >= M_ACAS8 and op <= M_ACAS64 {
                line = line + " {vname(f.a[i])}, {vname(f.b[i])}, {arg_list(f.cargs, f.ca0[i], f.can[i])}"
            } else if nreads(op) == 1 {
                line = line + " {vname(f.a[i])}"
            } else if nreads(op) == 2 {
                line = line + " {vname(f.a[i])}, {vname(f.b[i])}"
            }
            out.push_str(line + "\n")
        }
        let k = f.tk[b]
        if k == M_JUMP {
            out.push_str("    jump b{f.tt[b]}({arg_list(f.targs, f.ta0[b], f.tan[b])})\n")
        } else if k == M_BRIF {
            out.push_str("    brif {vname(f.tv[b])}, b{f.tt[b]}({arg_list(f.targs, f.ta0[b], f.tan[b])}), b{f.tf[b]}({arg_list(f.targs, f.fa0[b], f.fan[b])})\n")
        } else if k == M_RET {
            out.push_str("    ret {vname(f.tv[b])}\n")
        } else {
            out.push_str("    trap\n")
        }
    }
    out.to_str()
}
