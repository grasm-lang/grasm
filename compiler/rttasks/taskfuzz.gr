// Tasks, channels and fibers on the Grasm runtime against the Rust
// runtime's and the interpreter's (docs/concurrency.md; docs/self-hosting.md
// §6.11), for `scripts/fuzz_rttasks.sh`, which runs this compiled on each
// runtime and under `grasm run`, and requires the same bytes out and the
// same way out from all three: the interpreter's scheduler is the model of
// which fiber runs.
//
//     taskfuzz <seed> <rounds> [<panic> | flat]
//
// Each round makes one to four channels of random capacity (rendezvous
// among them), senders with random scripts across them, receivers on one
// channel each and receivers selecting over all of them, and a task that
// closes every channel once each sender says it is done; every task prints
// what it does, so the output is the schedule. Some tasks recurse deeply
// first, on their own stacks; some run a `concurrent` block of their own --
// none with `flat`, the rounds the interpreter is held to (docs/known-issues
// says why). With a panic number, the run ends in one of the family's
// panics.

fn next(inout s: i64) -> i64 {
    s = s * 6364136223846793005 + 1442695040888963407
    s.ushr(17)
}

fn pick(inout s: i64, n: i64) -> i64 {
    next(s) % n
}

fn depth(n: i64) -> i64 {
    if n == 0 {
        return 0
    }
    1 + depth(n - 1)
}

fn forever(n: i64) -> i64 {
    1 + forever(n + 1)
}

fn scenario(inout s: i64, r: i64, nesting: bool) / {io, async} {
    let nch = 1 + pick(s, 4)
    var chs: [Chan[i64]] = []
    for c in 0..nch {
        chs.push(chan_new(pick(s, 4) - 1))
    }
    let nsend = 1 + pick(s, 4)
    var scripts: [[i64]] = []
    for t in 0..nsend {
        var sc: [i64] = []
        for i in 0..pick(s, 7) {
            sc.push(pick(s, nch))
            sc.push(r * 1000 + t * 100 + i)
        }
        scripts.push(sc)
    }
    let nrecv = nch + pick(s, 3)
    var modes: [i64] = []
    for q in 0..nrecv {
        // A receiver on channel `q` for each channel, then selecting ones.
        modes.push(if q < nch { q } else { -1 })
    }
    let deep = pick(s, 3000)
    let nested = pick(s, 4) == 0 and nesting
    let done = chan_new(nsend)
    concurrent {
        for t in 0..nsend {
            let sc = scripts[t]
            go {
                if t == 0 {
                    print("deep {depth(deep)}")
                }
                for i in 0..sc.len() / 2 {
                    chan_send(chs[sc[2 * i]], sc[2 * i + 1])
                    print("s{t} -> {sc[2 * i]}: {sc[2 * i + 1]}")
                }
                chan_send(done, t)
            }
        }
        go {
            for i in 0..nsend {
                let who = chan_recv(done) ?? -1
                print("done {who}")
            }
            for c in chs {
                chan_close(c)
            }
            print("closed")
        }
        for q in 0..nrecv {
            let mode = modes[q]
            go {
                if mode >= 0 {
                    var going = true
                    while going {
                        match chan_recv(chs[mode]) {
                            Some(v) -> print("r{q} <- {mode}: {v}")
                            None -> going = false
                        }
                    }
                    print("r{q} end")
                } else {
                    var live = chs
                    var names: [i64] = []
                    for c in 0..nch {
                        names.push(c)
                    }
                    while live.len() > 0 {
                        let k = chan_select(live)
                        match chan_recv(live[k]) {
                            Some(v) -> print("x{q} <- {names[k]}: {v}")
                            None -> {
                                let _gone = live.remove(k)
                                let _name = names.remove(k)
                            }
                        }
                    }
                    print("x{q} end")
                }
            }
        }
        if nested {
            go {
                let inner = chan_new(0)
                concurrent {
                    go {
                        for i in 0..3 {
                            chan_send(inner, i)
                        }
                        chan_close(inner)
                    }
                    go {
                        var sum = 0
                        var more = true
                        while more {
                            match chan_recv(inner) {
                                Some(v) -> sum += v
                                None -> more = false
                            }
                        }
                        print("inner {sum} {depth(deep)}")
                    }
                }
            }
        }
    }
    print("round {r} over")
}

fn main() / {io, async} {
    let a = args()
    var s = (a[0].parse_int() ?? 1) * 7919 + 43
    let rounds = a[1].parse_int() ?? 10
    let flat = a.len() > 2 and a[2] == "flat"
    for r in 0..rounds {
        scenario(s, r, not flat)
    }
    if a.len() > 2 and not flat {
        let k = a[2].parse_int() ?? 0
        let ch = chan_new(0)
        if k == 0 {
            // Everyone waits: a deadlock.
            concurrent {
                go {
                    let _ = chan_recv(ch)
                }
                go {
                    let _ = chan_recv(ch)
                }
            }
        } else if k == 1 {
            chan_send(ch, 1)
        } else if k == 2 {
            chan_close(ch)
            chan_close(ch)
        } else if k == 3 {
            chan_close(ch)
            chan_send(ch, 2)
        } else if k == 4 {
            concurrent {
                go {
                    print("{forever(0)}")
                }
            }
        } else {
            let none: [Chan[i64]] = []
            print("{chan_select(none)}")
        }
    }
}
