// Reading a relocatable arm64 Mach-O object (MH_OBJECT) into the linker's
// arrays: its sections, its symbols, and its relocations decoded.
//
// A relocation is decoded in table order, because two kinds modify the one
// after them: ARM64_RELOC_ADDEND carries the addend of the PAGE21,
// PAGEOFF12 or BRANCH26 that follows, and ARM64_RELOC_SUBTRACTOR names the
// symbol subtracted from the UNSIGNED that follows at the same address. Both
// are folded into that relocation's record. The records of a section are
// then sorted by address, so an atom's are a contiguous run.
import rd
import state

pub let R_UNSIGNED = 0
pub let R_SUBTRACTOR = 1
pub let R_BRANCH26 = 2
pub let R_PAGE21 = 3
pub let R_PAGEOFF12 = 4
pub let R_GOT_PAGE21 = 5
pub let R_GOT_PAGEOFF12 = 6
pub let R_POINTER_TO_GOT = 7
pub let R_TLVP_PAGE21 = 8
pub let R_TLVP_PAGEOFF12 = 9
pub let R_ADDEND = 10

pub fn reloc_name(t: i64) -> str {
    let names = ["UNSIGNED", "SUBTRACTOR", "BRANCH26", "PAGE21", "PAGEOFF12", "GOT_LOAD_PAGE21", "GOT_LOAD_PAGEOFF12",
        "POINTER_TO_GOT", "TLVP_LOAD_PAGE21", "TLVP_LOAD_PAGEOFF12", "ADDEND"]
    if t >= 0 and t < names.len() { names[t] } else { "type {t}" }
}

fn role_of(seg: str, name: str, flags: i64) -> i64 {
    let ty = flags.bit_and(255)
    // Marked S_ATTR_DEBUG, but read, not dropped.
    if seg == "__LD" and name == "__compact_unwind" {
        return state.ROLE_CUNWIND
    }
    if flags.bit_and(0x02000000) != 0 {
        return state.ROLE_DROP
    }
    if seg == "__LLVM" {
        return state.ROLE_DROP
    }
    if seg == "__TEXT" and name == "__eh_frame" {
        return state.ROLE_EHFRAME
    }
    if ty == 2 {
        return state.ROLE_CSTRING
    }
    if ty == 3 or ty == 4 or ty == 14 {
        return state.ROLE_LITERAL
    }
    state.ROLE_NORMAL
}

/// Reads one object; answers its file index.
pub fn read(inout l: Ld, path: str, d: bytes, key: i64) -> i64 ! str {
    if d.len() < 32 or rd.u32(d, 0) != 0xfeedfacf {
        fail("{path}: not a 64-bit Mach-O object")
    }
    let cpu = rd.u32(d, 4)
    if cpu != 0x0100000c {
        fail("{path}: built for cpu type {cpu}, not arm64")
    }
    if rd.u32(d, 12) != 1 {
        fail("{path}: not a relocatable object (file type {rd.u32(d, 12)})")
    }
    let fi = l.f_path.len()
    l.f_path.push(path)
    l.f_data.push(d)
    l.f_key.push(key)
    l.f_subsec.push(rd.u32(d, 24).bit_and(0x2000) != 0)
    l.f_sec0.push(l.s_name.len())
    l.f_sym0.push(l.y_name.len())
    let ncmds = rd.u32(d, 16)
    var p = 32
    var nsec = 0
    var symoff = 0
    var nsyms = 0
    var stroff = 0
    for _c in 0..ncmds {
        if p + 8 > d.len() {
            fail("{path}: load commands run past the end")
        }
        let cmd = rd.u32(d, p)
        let size = rd.u32(d, p + 4)
        if cmd == 0x19 {
            let n = rd.u32(d, p + 64)
            for k in 0..n {
                let s = p + 72 + 80 * k
                let name = rd.name16(d, s)
                let seg = rd.name16(d, s + 16)
                let flags = rd.u32(d, s + 64)
                l.s_file.push(fi)
                l.s_name.push(name)
                l.s_seg.push(seg)
                l.s_addr.push(rd.u64(d, s + 32))
                l.s_size.push(rd.u64(d, s + 40))
                l.s_off.push(rd.u32(d, s + 48))
                l.s_p2.push(rd.u32(d, s + 52))
                l.s_reloff.push(rd.u32(d, s + 56))
                l.s_nreloc.push(rd.u32(d, s + 60))
                l.s_flags.push(flags)
                l.s_role.push(role_of(seg, name, flags))
                l.s_atom0.push(0)
                l.s_natom.push(0)
                l.s_rel0.push(0)
                l.s_nrel.push(0)
                l.s_out.push(-1)
                nsec += 1
            }
        } else if cmd == 2 {
            symoff = rd.u32(d, p + 8)
            nsyms = rd.u32(d, p + 12)
            stroff = rd.u32(d, p + 16)
        }
        p += size
    }
    l.f_nsec.push(nsec)
    l.f_nsym.push(nsyms)
    let sec0 = l.f_sec0[fi]
    for i in 0..nsyms {
        let e = symoff + 16 * i
        let strx = rd.u32(d, e)
        let ty = d.at(e + 4)
        let ns = d.at(e + 5)
        l.y_file.push(fi)
        l.y_name.push(rd.cstr(d, stroff + strx))
        l.y_type.push(ty)
        // A stab has no section of ours; neither does an undefined symbol.
        let sect = if ty.bit_and(0xe0) == 0 and ty.bit_and(0x0e) == 0x0e and ns > 0 { sec0 + ns - 1 } else { -1 }
        if sect >= sec0 + nsec {
            fail("{path}: symbol {rd.cstr(d, stroff + strx)} names section {ns} of {nsec}")
        }
        l.y_sect.push(sect)
        l.y_desc.push(rd.u16(d, e + 6))
        l.y_value.push(rd.u64(d, e + 8))
        l.y_atom.push(-1)
        l.y_g.push(-1)
    }
    for k in 0..nsec {
        let si = sec0 + k
        if l.s_role[si] == state.ROLE_DROP {
            l.s_rel0[si] = l.r_off.len()
            continue
        }
        try relocs(l, fi, si)
    }
    fi
}

/// Decodes section `si`'s relocations into the `r_*` arrays, sorted by address.
fn relocs(inout l: Ld, fi: i64, si: i64) -> () ! str {
    let d = l.f_data[fi]
    let sym0 = l.f_sym0[fi]
    let nsym = l.f_nsym[fi]
    let sec0 = l.f_sec0[fi]
    let nsec = l.f_nsec[fi]
    let base = l.s_reloff[si]
    let n = l.s_nreloc[si]
    var off: [i64] = []
    var typ: [i64] = []
    var len: [i64] = []
    var pcr: [bool] = []
    var sym: [i64] = []
    var tsec: [i64] = []
    var add: [i64] = []
    var ssym: [i64] = []
    var ssec: [i64] = []
    var pend_addend = 0
    var have_addend = false
    var pend_ssym = -1
    var pend_ssec = -1
    var have_sub = false
    for k in 0..n {
        let a = rd.u32(d, base + 8 * k)
        let w = rd.u32(d, base + 8 * k + 4)
        if a.bit_and(0x80000000) != 0 {
            fail("{l.f_path[fi]}: a scattered relocation in {l.s_seg[si]},{l.s_name[si]}")
        }
        let symnum = w.bit_and(0xffffff)
        let pcrel = w.ushr(24).bit_and(1) == 1
        let length = w.ushr(25).bit_and(3)
        let ext = w.ushr(27).bit_and(1) == 1
        let t = w.ushr(28).bit_and(15)
        if t == R_ADDEND {
            pend_addend = rd.sext(symnum, 24)
            have_addend = true
            continue
        }
        var ys = -1
        var ts = -1
        if ext {
            if symnum >= nsym {
                fail("{l.f_path[fi]}: a relocation names symbol {symnum} of {nsym}")
            }
            ys = sym0 + symnum
        } else {
            if symnum < 1 or symnum > nsec {
                fail("{l.f_path[fi]}: a relocation names section {symnum} of {nsec}")
            }
            ts = sec0 + symnum - 1
        }
        if t == R_SUBTRACTOR {
            pend_ssym = ys
            pend_ssec = ts
            have_sub = true
            continue
        }
        off.push(a)
        typ.push(t)
        len.push(length)
        pcr.push(pcrel)
        sym.push(ys)
        tsec.push(ts)
        add.push(if have_addend { pend_addend } else { 0 })
        if have_sub {
            ssym.push(pend_ssym)
            ssec.push(pend_ssec)
        } else {
            ssym.push(-1)
            ssec.push(-1)
        }
        have_addend = false
        have_sub = false
    }
    var order: [i64] = []
    for k in 0..off.len() {
        order.push(k)
    }
    order.sort_by(|k| off[k])
    l.s_rel0[si] = l.r_off.len()
    l.s_nrel[si] = off.len()
    for k in order {
        l.r_sec.push(si)
        l.r_off.push(off[k])
        l.r_type.push(typ[k])
        l.r_len.push(len[k])
        l.r_pcrel.push(pcr[k])
        l.r_sym.push(sym[k])
        l.r_tsec.push(tsec[k])
        l.r_addend.push(add[k])
        l.r_subsym.push(ssym[k])
        l.r_subsec.push(ssec[k])
        l.r_atom.push(-1)
        l.r_tkind.push(state.T_NONE)
        l.r_tatom.push(-1)
        l.r_toff.push(0)
        l.r_tg.push(-1)
        l.r_satom.push(-1)
        l.r_soff.push(0)
    }
}
