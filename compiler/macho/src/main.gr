// `macho`: a relocatable Mach-O object for arm64 (docs/self-hosting.md, S3).
//
// What `ld` needs from a compiler and nothing else, laid out the way clang
// lays out its own objects:
//
//     mach_header_64          MH_OBJECT, MH_SUBSECTIONS_VIA_SYMBOLS
//     LC_SEGMENT_64           one unnamed segment: __text, __cstring, __const
//     LC_BUILD_VERSION        macOS; the Cranelift build omits it, and ld then
//                             warns "no platform load command found"
//     LC_SYMTAB, LC_DYSYMTAB  locals, then defined externals, then undefined
//     section contents, relocations, symbols, strings
//
// Every reference from code -- a call, a string's address -- is a relocation
// against a symbol, as clang emits them: with subsections via symbols, ld
// may move or drop each function and string independently, so no
// displacement between two of them can be fixed here.
//
// Nothing depends on time, paths or hash order: two compilations of the same
// TIR are the same bytes (`scripts/objtest.sh`).

type MoObj = {
    /// The code, one 32-bit instruction word per element.
    text: [i64],
    /// Functions: name (with its leading underscore), byte offset in
    /// `__text`, and whether other objects may see it.
    fsym: [str],
    foff: [i64],
    fext: [bool],
    /// Relocations in `__text`: byte offset, kind (`R_*`), the symbol.
    rel_off: [i64],
    rel_kind: [i64],
    rel_sym: [str],
    /// Data, each a symbol of its own: text without a NUL goes in
    /// `__cstring` (NUL-terminated, where ld merges duplicates), anything
    /// else in `__const`.
    dsym: [str],
    dbytes: [bytes],
}

pub let R_BRANCH26 = 2
pub let R_PAGE21 = 3
pub let R_PAGEOFF12 = 4

pub fn new_obj() -> MoObj {
    MoObj{ text: [], fsym: [], foff: [], fext: [], rel_off: [], rel_kind: [], rel_sym: [], dsym: [], dbytes: [] }
}

// ----- bytes ----------------------------------------------------------------------

fn put8(inout b: ByteBuilder, v: i64) {
    b.push_byte(v.bit_and(255))
}

fn put16(inout b: ByteBuilder, v: i64) {
    put8(b, v)
    put8(b, v.ushr(8))
}

fn put32(inout b: ByteBuilder, v: i64) {
    put16(b, v)
    put16(b, v.ushr(16))
}

fn put64(inout b: ByteBuilder, v: i64) {
    put32(b, v)
    put32(b, v.ushr(32))
}

/// A fixed 16-byte name field.
fn name16(inout b: ByteBuilder, s: str) {
    let bs = s.to_bytes()
    for k in 0..16 {
        if k < bs.len() {
            put8(b, bs.at(k))
        } else {
            put8(b, 0)
        }
    }
}

fn pad_to(inout b: ByteBuilder, align: i64) {
    while b.len() % align != 0 {
        put8(b, 0)
    }
}

fn align_up(x: i64, a: i64) -> i64 {
    (x + a - 1) / a * a
}

fn has_nul(bs: bytes) -> bool {
    for k in 0..bs.len() {
        if bs.at(k) == 0 {
            return true
        }
    }
    false
}

// ----- the object -------------------------------------------------------------------

/// The object file's bytes.
pub fn write(o: MoObj) -> bytes ! str {
    // Sections that have something in them, in this order.
    var cstr_ix: [i64] = []
    var const_ix: [i64] = []
    for k in 0..o.dsym.len() {
        if has_nul(o.dbytes[k]) {
            const_ix.push(k)
        } else {
            cstr_ix.push(k)
        }
    }
    let text_size = 4 * o.text.len()
    var cstr_size = 0
    for k in cstr_ix {
        cstr_size += o.dbytes[k].len() + 1
    }
    var const_size = 0
    for k in const_ix {
        const_size += o.dbytes[k].len()
    }
    var nsect = 1
    var cstr_sect = -1
    var const_sect = -1
    if cstr_ix.len() > 0 {
        nsect += 1
        cstr_sect = nsect
    }
    if const_ix.len() > 0 {
        nsect += 1
        const_sect = nsect
    }
    // Addresses within the segment.
    let text_addr = 0
    let cstr_addr = text_size
    let const_addr = cstr_addr + cstr_size
    let vmsize = const_addr + const_size
    // Where each datum sits.
    var daddr: [i64] = []
    var dsect: [i64] = []
    for k in 0..o.dsym.len() {
        daddr.push(0)
        dsect.push(0)
    }
    var at = cstr_addr
    for k in cstr_ix {
        daddr[k] = at
        dsect[k] = cstr_sect
        at += o.dbytes[k].len() + 1
    }
    at = const_addr
    for k in const_ix {
        daddr[k] = at
        dsect[k] = const_sect
        at += o.dbytes[k].len()
    }

    // Symbols: locals (functions, then data, by address), defined
    // externals, undefined externals, each group in a fixed order.
    var sname: [str] = []
    var stype: [i64] = []
    var ssect: [i64] = []
    var svalue: [i64] = []
    var defined: Map[str, i64] = {}
    for k in 0..o.fsym.len() {
        if not o.fext[k] {
            defined.set(o.fsym[k], sname.len())
            sname.push(o.fsym[k])
            stype.push(14)
            ssect.push(1)
            svalue.push(text_addr + o.foff[k])
        }
    }
    for k in cstr_ix {
        defined.set(o.dsym[k], sname.len())
        sname.push(o.dsym[k])
        stype.push(14)
        ssect.push(dsect[k])
        svalue.push(daddr[k])
    }
    for k in const_ix {
        defined.set(o.dsym[k], sname.len())
        sname.push(o.dsym[k])
        stype.push(14)
        ssect.push(dsect[k])
        svalue.push(daddr[k])
    }
    let nlocal = sname.len()
    var ext: [str] = []
    for k in 0..o.fsym.len() {
        if o.fext[k] {
            ext.push(o.fsym[k])
        }
    }
    ext.sort()
    for name in ext {
        var off = -1
        for k in 0..o.fsym.len() {
            if o.fsym[k] == name {
                off = o.foff[k]
            }
        }
        defined.set(name, sname.len())
        sname.push(name)
        stype.push(15)
        ssect.push(1)
        svalue.push(text_addr + off)
    }
    let nextdef = ext.len()
    var undef: [str] = []
    var seen: Map[str, i64] = {}
    for s in o.rel_sym {
        if not defined.has(s) and not seen.has(s) {
            seen.set(s, 1)
            undef.push(s)
        }
    }
    undef.sort()
    for name in undef {
        defined.set(name, sname.len())
        sname.push(name)
        stype.push(1)
        ssect.push(0)
        svalue.push(0)
    }
    let nundef = undef.len()
    let nsyms = sname.len()

    // The string table: a leading NUL, so index 0 is the empty name.
    var strtab = byte_builder()
    put8(strtab, 0)
    var strx: [i64] = []
    for name in sname {
        strx.push(strtab.len())
        strtab.push_str(name)
        put8(strtab, 0)
    }
    pad_to(strtab, 8)

    // Relocations, last address first, as clang writes them.
    var order: [i64] = []
    for k in 0..o.rel_off.len() {
        order.push(k)
    }
    var keys: [i64] = []
    for k in order {
        keys.push(o.rel_off[k] * 65536 + k)
    }
    keys.sort()
    var rels = byte_builder()
    var q = keys.len() - 1
    while q >= 0 {
        let k = keys[q].bit_and(65535)
        let sym = defined.get(o.rel_sym[k]) ?? -1
        if sym < 0 {
            fail("relocation against `{o.rel_sym[k]}`, which has no symbol")
        }
        let kind = o.rel_kind[k]
        var pcrel = 0
        if kind == R_BRANCH26 or kind == R_PAGE21 {
            pcrel = 1
        } else if kind != R_PAGEOFF12 {
            fail("relocation kind {kind} is not one this writer knows")
        }
        put32(rels, o.rel_off[k])
        put32(rels, sym.bit_or(pcrel.shl(24)).bit_or(2.shl(25)).bit_or(1.shl(27)).bit_or(kind.shl(28)))
        q -= 1
    }
    if o.rel_off.len() >= 65536 {
        fail("too many relocations ({o.rel_off.len()})")
    }

    // Layout.
    let seg_cmd_size = 72 + 80 * nsect
    let sizeofcmds = seg_cmd_size + 24 + 24 + 80
    let data_off = align_up(32 + sizeofcmds, 16)
    let rel_off = align_up(data_off + vmsize, 8)
    let sym_off = align_up(rel_off + rels.len(), 8)
    let str_off = sym_off + 16 * nsyms

    var b = byte_builder()
    // mach_header_64
    put32(b, 0xFEEDFACF)
    put32(b, 0x0100000C)
    put32(b, 0)
    put32(b, 1)
    put32(b, 4)
    put32(b, sizeofcmds)
    put32(b, 0x2000)
    put32(b, 0)
    // LC_SEGMENT_64
    put32(b, 0x19)
    put32(b, seg_cmd_size)
    name16(b, "")
    put64(b, 0)
    put64(b, vmsize)
    put64(b, data_off)
    put64(b, vmsize)
    put32(b, 7)
    put32(b, 7)
    put32(b, nsect)
    put32(b, 0)
    // __text: S_REGULAR with S_ATTR_PURE_INSTRUCTIONS | S_ATTR_SOME_INSTRUCTIONS.
    name16(b, "__text")
    name16(b, "__TEXT")
    put64(b, text_addr)
    put64(b, text_size)
    put32(b, data_off + text_addr)
    put32(b, 2)
    put32(b, if o.rel_off.len() > 0 { rel_off } else { 0 })
    put32(b, o.rel_off.len())
    put32(b, 0x80000400)
    put32(b, 0)
    put32(b, 0)
    put32(b, 0)
    if cstr_sect > 0 {
        name16(b, "__cstring")
        name16(b, "__TEXT")
        put64(b, cstr_addr)
        put64(b, cstr_size)
        put32(b, data_off + cstr_addr)
        put32(b, 0)
        put32(b, 0)
        put32(b, 0)
        // S_CSTRING_LITERALS
        put32(b, 2)
        put32(b, 0)
        put32(b, 0)
        put32(b, 0)
    }
    if const_sect > 0 {
        name16(b, "__const")
        name16(b, "__TEXT")
        put64(b, const_addr)
        put64(b, const_size)
        put32(b, data_off + const_addr)
        put32(b, 0)
        put32(b, 0)
        put32(b, 0)
        put32(b, 0)
        put32(b, 0)
        put32(b, 0)
        put32(b, 0)
    }
    // LC_BUILD_VERSION: macOS, minimum 11.0, SDK 11.0, no tools.
    put32(b, 0x32)
    put32(b, 24)
    put32(b, 1)
    put32(b, 0x000B0000)
    put32(b, 0x000B0000)
    put32(b, 0)
    // LC_SYMTAB
    put32(b, 0x2)
    put32(b, 24)
    put32(b, sym_off)
    put32(b, nsyms)
    put32(b, str_off)
    put32(b, strtab.len())
    // LC_DYSYMTAB
    put32(b, 0xB)
    put32(b, 80)
    put32(b, 0)
    put32(b, nlocal)
    put32(b, nlocal)
    put32(b, nextdef)
    put32(b, nlocal + nextdef)
    put32(b, nundef)
    for k in 0..12 {
        put32(b, 0)
    }
    if b.len() != 32 + sizeofcmds {
        fail("load commands are {b.len() - 32} bytes, not the {sizeofcmds} the header says")
    }
    pad_to(b, 16)
    // Section contents.
    for w in o.text {
        put32(b, w)
    }
    for k in cstr_ix {
        b.push_bytes(o.dbytes[k])
        put8(b, 0)
    }
    for k in const_ix {
        b.push_bytes(o.dbytes[k])
    }
    if b.len() != data_off + vmsize {
        fail("section contents end at {b.len()}, not {data_off + vmsize}")
    }
    pad_to(b, 8)
    b.push_bytes(rels.to_bytes())
    pad_to(b, 8)
    // nlist_64
    for k in 0..nsyms {
        put32(b, strx[k])
        put8(b, stype[k])
        put8(b, ssect[k])
        put16(b, 0)
        put64(b, svalue[k])
    }
    b.push_bytes(strtab.to_bytes())
    b.to_bytes()
}
