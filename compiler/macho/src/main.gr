// `macho`: a relocatable Mach-O object for arm64 (docs/self-hosting.md, S3).
//
// What `ld` needs from a compiler and nothing else, laid out the way clang
// lays out its own objects:
//
//     mach_header_64          MH_OBJECT, MH_SUBSECTIONS_VIA_SYMBOLS
//     LC_SEGMENT_64           one unnamed segment: __text, __cstring, __const,
//                             and __DATA,__data for what the runtime writes
//                             into (a struct descriptor's cache), with its
//                             pointers as ARM64_RELOC_UNSIGNED relocations;
//                             then the __DWARF sections of the line table
//                             (`dwarf.gr`), as clang places them
//     LC_BUILD_VERSION        macOS; the Cranelift build omits it, and ld then
//                             warns "no platform load command found"
//     LC_SYMTAB, LC_DYSYMTAB  locals, then defined externals, then undefined
//     section contents, relocations, symbols, strings
//
// Every reference from code -- a call, a string's address -- is a relocation
// against a symbol, as clang emits them: with subsections via symbols, ld
// may move or drop each function and string independently, so no
// displacement between two of them can be fixed here.
//
// Nothing depends on time or hash order: two compilations of the same TIR in
// the same directory are the same bytes (`scripts/objtest.sh`). The one path
// that is not TIR's is the compile unit's directory, which the caller gives,
// as clang records its working directory.
import dwarf

type MoObj = {
    /// The code, one 32-bit instruction word per element.
    text: [i64],
    /// Functions: name (with its leading underscore), byte offset in
    /// `__text`, and whether other objects may see it.
    fsym: [str],
    foff: [i64],
    fext: [bool],
    /// Relocations in `__text`: byte offset, kind (`R_*`), the symbol.
    rel_off: [i64],
    rel_kind: [i64],
    rel_sym: [str],
    /// Data, each a symbol of its own: text without a NUL goes in
    /// `__cstring` (NUL-terminated, where ld merges duplicates), anything
    /// else in `__const`.
    dsym: [str],
    dbytes: [bytes],
    /// Writable data in `__DATA,__data`, each a symbol of its own, 8-byte
    /// aligned: what the runtime writes into (a struct descriptor's cache
    /// word). `wrel_off`/`wrel_sym` are 64-bit absolute pointers in it, at
    /// byte offsets from the start of the section, to a symbol.
    wsym: [str],
    wbytes: [bytes],
    wrel_off: [i64],
    wrel_sym: [str],
    /// The line table and what it needs (`dwarf.gr`), written when `debug`.
    debug: bool,
    dw: DwUnit,
}

pub let R_UNSIGNED = 0
pub let R_BRANCH26 = 2
pub let R_PAGE21 = 3
pub let R_PAGEOFF12 = 4
/// A symbol's slot in the global offset table: its page, pc-relative, and
/// its offset in the page (`ARM64_RELOC_GOT_LOAD_PAGE21`, `_PAGEOFF12`).
pub let R_GOT_PAGE21 = 5
pub let R_GOT_PAGEOFF12 = 6

pub fn new_obj() -> MoObj {
    MoObj{
        text: [], fsym: [], foff: [], fext: [], rel_off: [], rel_kind: [], rel_sym: [], dsym: [], dbytes: [],
        wsym: [], wbytes: [], wrel_off: [], wrel_sym: [], debug: false, dw: dwarf.new_unit(),
    }
}

/// An empty line table, for the caller to fill (`dwarf.gr`).
pub fn new_unit() -> DwUnit {
    dwarf.new_unit()
}

// ----- bytes ----------------------------------------------------------------------

fn put8(inout b: ByteBuilder, v: i64) {
    b.push_byte(v.bit_and(255))
}

fn put16(inout b: ByteBuilder, v: i64) {
    put8(b, v)
    put8(b, v.ushr(8))
}

fn put32(inout b: ByteBuilder, v: i64) {
    put16(b, v)
    put16(b, v.ushr(16))
}

fn put64(inout b: ByteBuilder, v: i64) {
    put32(b, v)
    put32(b, v.ushr(32))
}

/// A fixed 16-byte name field.
fn name16(inout b: ByteBuilder, s: str) {
    let bs = s.to_bytes()
    for k in 0..16 {
        if k < bs.len() {
            put8(b, bs.at(k))
        } else {
            put8(b, 0)
        }
    }
}

fn pad_to(inout b: ByteBuilder, align: i64) {
    while b.len() % align != 0 {
        put8(b, 0)
    }
}

fn align_up(x: i64, a: i64) -> i64 {
    (x + a - 1) / a * a
}

fn has_nul(bs: bytes) -> bool {
    for k in 0..bs.len() {
        if bs.at(k) == 0 {
            return true
        }
    }
    false
}

// ----- the object -------------------------------------------------------------------

/// The object file's bytes.
pub fn write(o: MoObj) -> bytes ! str {
    // Sections that have something in them, in this order.
    var cstr_ix: [i64] = []
    var const_ix: [i64] = []
    for k in 0..o.dsym.len() {
        if has_nul(o.dbytes[k]) {
            const_ix.push(k)
        } else {
            cstr_ix.push(k)
        }
    }
    let text_size = 4 * o.text.len()
    var cstr_size = 0
    for k in cstr_ix {
        cstr_size += o.dbytes[k].len() + 1
    }
    var const_size = 0
    for k in const_ix {
        const_size += o.dbytes[k].len()
    }
    var data_size = 0
    var wsym_off: [i64] = []
    for k in 0..o.wsym.len() {
        wsym_off.push(data_size)
        data_size += align_up(o.wbytes[k].len(), 8)
    }
    var nsect = 1
    var cstr_sect = -1
    var const_sect = -1
    var data_sect = -1
    if cstr_ix.len() > 0 {
        nsect += 1
        cstr_sect = nsect
    }
    if const_ix.len() > 0 {
        nsect += 1
        const_sect = nsect
    }
    if o.wsym.len() > 0 {
        nsect += 1
        data_sect = nsect
    }
    // The debug sections, if any: abbreviations, the compile unit, its
    // strings and the line table, in the order clang writes them.
    var dw = dwarf.sections(dwarf.new_unit(), [], 0)
    if o.debug {
        dw = dwarf.sections(o.dw, o.foff, text_size)
        nsect += 4
    }
    // Addresses within the segment.
    let text_addr = 0
    let cstr_addr = text_size
    let const_addr = cstr_addr + cstr_size
    let data_addr = if data_sect > 0 { align_up(const_addr + const_size, 8) } else { const_addr + const_size }
    let abbrev_addr = data_addr + data_size
    let info_addr = abbrev_addr + dw.abbrev.len()
    let dstr_addr = info_addr + dw.info.len()
    let line_addr = dstr_addr + dw.str.len()
    let vmsize = if o.debug { line_addr + dw.line.len() } else { data_addr + data_size }
    // Where each datum sits.
    var daddr: [i64] = []
    var dsect: [i64] = []
    for k in 0..o.dsym.len() {
        daddr.push(0)
        dsect.push(0)
    }
    var at = cstr_addr
    for k in cstr_ix {
        daddr[k] = at
        dsect[k] = cstr_sect
        at += o.dbytes[k].len() + 1
    }
    at = const_addr
    for k in const_ix {
        daddr[k] = at
        dsect[k] = const_sect
        at += o.dbytes[k].len()
    }

    // Symbols: locals (functions, then data, by address), defined
    // externals, undefined externals, each group in a fixed order.
    var sname: [str] = []
    var stype: [i64] = []
    var ssect: [i64] = []
    var svalue: [i64] = []
    var defined: Map[str, i64] = {}
    for k in 0..o.fsym.len() {
        if not o.fext[k] {
            defined.set(o.fsym[k], sname.len())
            sname.push(o.fsym[k])
            stype.push(14)
            ssect.push(1)
            svalue.push(text_addr + o.foff[k])
        }
    }
    for k in cstr_ix {
        defined.set(o.dsym[k], sname.len())
        sname.push(o.dsym[k])
        stype.push(14)
        ssect.push(dsect[k])
        svalue.push(daddr[k])
    }
    for k in const_ix {
        defined.set(o.dsym[k], sname.len())
        sname.push(o.dsym[k])
        stype.push(14)
        ssect.push(dsect[k])
        svalue.push(daddr[k])
    }
    for k in 0..o.wsym.len() {
        defined.set(o.wsym[k], sname.len())
        sname.push(o.wsym[k])
        stype.push(14)
        ssect.push(data_sect)
        svalue.push(data_addr + wsym_off[k])
    }
    let nlocal = sname.len()
    var ext: [str] = []
    for k in 0..o.fsym.len() {
        if o.fext[k] {
            ext.push(o.fsym[k])
        }
    }
    ext.sort()
    for name in ext {
        var off = -1
        for k in 0..o.fsym.len() {
            if o.fsym[k] == name {
                off = o.foff[k]
            }
        }
        defined.set(name, sname.len())
        sname.push(name)
        stype.push(15)
        ssect.push(1)
        svalue.push(text_addr + off)
    }
    let nextdef = ext.len()
    var undef: [str] = []
    var seen: Map[str, i64] = {}
    for s in o.rel_sym {
        if not defined.has(s) and not seen.has(s) {
            seen.set(s, 1)
            undef.push(s)
        }
    }
    for s in o.wrel_sym {
        if not defined.has(s) and not seen.has(s) {
            seen.set(s, 1)
            undef.push(s)
        }
    }
    undef.sort()
    for name in undef {
        defined.set(name, sname.len())
        sname.push(name)
        stype.push(1)
        ssect.push(0)
        svalue.push(0)
    }
    let nundef = undef.len()
    let nsyms = sname.len()

    // The string table: a leading NUL, so index 0 is the empty name.
    var strtab = byte_builder()
    put8(strtab, 0)
    var strx: [i64] = []
    for name in sname {
        strx.push(strtab.len())
        strtab.push_str(name)
        put8(strtab, 0)
    }
    pad_to(strtab, 8)

    // Relocations, last address first, as clang writes them. Each is sorted
    // by its address with its own position in the low 24 bits of the key: a
    // program of a hundred thousand calls has a hundred thousand of them.
    var order: [i64] = []
    for k in 0..o.rel_off.len() {
        order.push(k)
    }
    var keys: [i64] = []
    for k in order {
        keys.push(o.rel_off[k] * 16777216 + k)
    }
    keys.sort()
    var rels = byte_builder()
    var q = keys.len() - 1
    while q >= 0 {
        let k = keys[q].bit_and(16777215)
        let sym = defined.get(o.rel_sym[k]) ?? -1
        if sym < 0 {
            fail("relocation against `{o.rel_sym[k]}`, which has no symbol")
        }
        let kind = o.rel_kind[k]
        var pcrel = 0
        if kind == R_BRANCH26 or kind == R_PAGE21 or kind == R_GOT_PAGE21 {
            pcrel = 1
        } else if kind != R_PAGEOFF12 and kind != R_GOT_PAGEOFF12 {
            fail("relocation kind {kind} is not one this writer knows")
        }
        put32(rels, o.rel_off[k])
        put32(rels, sym.bit_or(pcrel.shl(24)).bit_or(2.shl(25)).bit_or(1.shl(27)).bit_or(kind.shl(28)))
        q -= 1
    }
    if o.rel_off.len() >= 16777216 {
        fail("too many relocations ({o.rel_off.len()})")
    }
    // The data's pointers: 64-bit absolute (ARM64_RELOC_UNSIGNED, length 3),
    // each against the symbol it points at, last address first.
    var dkeys: [i64] = []
    for k in 0..o.wrel_off.len() {
        if o.wrel_off[k] % 8 != 0 or o.wrel_off[k] + 8 > data_size {
            fail("data relocation at {o.wrel_off[k]} is not an aligned word of `__data`")
        }
        dkeys.push(o.wrel_off[k] * 16777216 + k)
    }
    dkeys.sort()
    if o.wrel_off.len() >= 16777216 {
        fail("too many data relocations ({o.wrel_off.len()})")
    }
    var drels = byte_builder()
    var dq = dkeys.len() - 1
    while dq >= 0 {
        let k = dkeys[dq].bit_and(16777215)
        let sym = defined.get(o.wrel_sym[k]) ?? -1
        if sym < 0 {
            fail("data relocation against `{o.wrel_sym[k]}`, which has no symbol")
        }
        put32(drels, o.wrel_off[k])
        put32(drels, sym.bit_or(3.shl(25)).bit_or(1.shl(27)).bit_or(R_UNSIGNED.shl(28)))
        dq -= 1
    }
    // The debug sections' addresses: 64-bit absolute, against `__text`
    // (section 1) rather than a symbol, last address first, as clang's.
    var irels = byte_builder()
    var ik = dw.info_rel.len() - 1
    while ik >= 0 {
        put32(irels, dw.info_rel[ik])
        put32(irels, 1.bit_or(3.shl(25)).bit_or(R_UNSIGNED.shl(28)))
        ik -= 1
    }
    var lrels = byte_builder()
    var lk = dw.line_rel.len() - 1
    while lk >= 0 {
        put32(lrels, dw.line_rel[lk])
        put32(lrels, 1.bit_or(3.shl(25)).bit_or(R_UNSIGNED.shl(28)))
        lk -= 1
    }

    // Layout.
    let seg_cmd_size = 72 + 80 * nsect
    let sizeofcmds = seg_cmd_size + 24 + 24 + 80
    let data_off = align_up(32 + sizeofcmds, 16)
    let rel_off = align_up(data_off + vmsize, 8)
    let drel_off = rel_off + rels.len()
    let irel_off = drel_off + drels.len()
    let lrel_off = irel_off + irels.len()
    let sym_off = align_up(lrel_off + lrels.len(), 8)
    let str_off = sym_off + 16 * nsyms

    var b = byte_builder()
    // mach_header_64
    put32(b, 0xFEEDFACF)
    put32(b, 0x0100000C)
    put32(b, 0)
    put32(b, 1)
    put32(b, 4)
    put32(b, sizeofcmds)
    put32(b, 0x2000)
    put32(b, 0)
    // LC_SEGMENT_64
    put32(b, 0x19)
    put32(b, seg_cmd_size)
    name16(b, "")
    put64(b, 0)
    put64(b, vmsize)
    put64(b, data_off)
    put64(b, vmsize)
    put32(b, 7)
    put32(b, 7)
    put32(b, nsect)
    put32(b, 0)
    // __text: S_REGULAR with S_ATTR_PURE_INSTRUCTIONS | S_ATTR_SOME_INSTRUCTIONS.
    name16(b, "__text")
    name16(b, "__TEXT")
    put64(b, text_addr)
    put64(b, text_size)
    put32(b, data_off + text_addr)
    put32(b, 2)
    put32(b, if o.rel_off.len() > 0 { rel_off } else { 0 })
    put32(b, o.rel_off.len())
    put32(b, 0x80000400)
    put32(b, 0)
    put32(b, 0)
    put32(b, 0)
    if cstr_sect > 0 {
        name16(b, "__cstring")
        name16(b, "__TEXT")
        put64(b, cstr_addr)
        put64(b, cstr_size)
        put32(b, data_off + cstr_addr)
        put32(b, 0)
        put32(b, 0)
        put32(b, 0)
        // S_CSTRING_LITERALS
        put32(b, 2)
        put32(b, 0)
        put32(b, 0)
        put32(b, 0)
    }
    if const_sect > 0 {
        name16(b, "__const")
        name16(b, "__TEXT")
        put64(b, const_addr)
        put64(b, const_size)
        put32(b, data_off + const_addr)
        put32(b, 0)
        put32(b, 0)
        put32(b, 0)
        put32(b, 0)
        put32(b, 0)
        put32(b, 0)
        put32(b, 0)
    }
    if data_sect > 0 {
        // S_REGULAR, aligned to 2^3.
        name16(b, "__data")
        name16(b, "__DATA")
        put64(b, data_addr)
        put64(b, data_size)
        put32(b, data_off + data_addr)
        put32(b, 3)
        put32(b, if o.wrel_off.len() > 0 { drel_off } else { 0 })
        put32(b, o.wrel_off.len())
        put32(b, 0)
        put32(b, 0)
        put32(b, 0)
        put32(b, 0)
    }
    if o.debug {
        // S_REGULAR with S_ATTR_DEBUG, byte-aligned: the linker leaves them
        // in the object, for `dsymutil` and debuggers.
        let names = ["__debug_abbrev", "__debug_info", "__debug_str", "__debug_line"]
        let addrs = [abbrev_addr, info_addr, dstr_addr, line_addr]
        let sizes = [dw.abbrev.len(), dw.info.len(), dw.str.len(), dw.line.len()]
        let roffs = [0, if dw.info_rel.len() > 0 { irel_off } else { 0 }, 0, if dw.line_rel.len() > 0 { lrel_off } else { 0 }]
        let nrels = [0, dw.info_rel.len(), 0, dw.line_rel.len()]
        for k in 0..4 {
            name16(b, names[k])
            name16(b, "__DWARF")
            put64(b, addrs[k])
            put64(b, sizes[k])
            put32(b, data_off + addrs[k])
            put32(b, 0)
            put32(b, roffs[k])
            put32(b, nrels[k])
            put32(b, 0x02000000)
            put32(b, 0)
            put32(b, 0)
            put32(b, 0)
        }
    }
    // LC_BUILD_VERSION: macOS, minimum 11.0, SDK 11.0, no tools.
    put32(b, 0x32)
    put32(b, 24)
    put32(b, 1)
    put32(b, 0x000B0000)
    put32(b, 0x000B0000)
    put32(b, 0)
    // LC_SYMTAB
    put32(b, 0x2)
    put32(b, 24)
    put32(b, sym_off)
    put32(b, nsyms)
    put32(b, str_off)
    put32(b, strtab.len())
    // LC_DYSYMTAB
    put32(b, 0xB)
    put32(b, 80)
    put32(b, 0)
    put32(b, nlocal)
    put32(b, nlocal)
    put32(b, nextdef)
    put32(b, nlocal + nextdef)
    put32(b, nundef)
    for k in 0..12 {
        put32(b, 0)
    }
    if b.len() != 32 + sizeofcmds {
        fail("load commands are {b.len() - 32} bytes, not the {sizeofcmds} the header says")
    }
    pad_to(b, 16)
    // Section contents.
    for w in o.text {
        put32(b, w)
    }
    for k in cstr_ix {
        b.push_bytes(o.dbytes[k])
        put8(b, 0)
    }
    for k in const_ix {
        b.push_bytes(o.dbytes[k])
    }
    if data_sect > 0 {
        while b.len() < data_off + data_addr {
            put8(b, 0)
        }
        for k in 0..o.wsym.len() {
            b.push_bytes(o.wbytes[k])
            while b.len() < data_off + data_addr + wsym_off[k] + align_up(o.wbytes[k].len(), 8) {
                put8(b, 0)
            }
        }
    }
    if o.debug {
        while b.len() < data_off + abbrev_addr {
            put8(b, 0)
        }
        b.push_bytes(dw.abbrev)
        b.push_bytes(dw.info)
        b.push_bytes(dw.str)
        b.push_bytes(dw.line)
    }
    if b.len() != data_off + vmsize {
        fail("section contents end at {b.len()}, not {data_off + vmsize}")
    }
    pad_to(b, 8)
    b.push_bytes(rels.to_bytes())
    b.push_bytes(drels.to_bytes())
    b.push_bytes(irels.to_bytes())
    b.push_bytes(lrels.to_bytes())
    pad_to(b, 8)
    // nlist_64
    for k in 0..nsyms {
        put32(b, strx[k])
        put8(b, stype[k])
        put8(b, ssect[k])
        put16(b, 0)
        put64(b, svalue[k])
    }
    b.push_bytes(strtab.to_bytes())
    b.to_bytes()
}
