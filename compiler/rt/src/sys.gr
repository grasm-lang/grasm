// The C library calls every family makes: memory. The Rust runtime's global
// allocator is `malloc`, `realloc` and `free` (`grasm_rt_abi`), so a buffer
// either side allocates the other can grow or free -- a `String`'s or a
// `Vec`'s included -- and these are those three calls; with `memcpy` for a
// long copy.

extern fn malloc(n: i64) -> addr
extern fn calloc(n: i64, size: i64) -> addr
extern fn realloc(p: addr, n: i64) -> addr
extern fn free(p: addr)
extern fn memcpy(dst: addr, src: addr, n: i64) -> addr

/// `n` bytes, uninitialised.
pub fn alloc(n: i64) -> addr {
    unsafe { malloc(n) }
}

/// `n` zeroed bytes.
pub fn alloc_zeroed(n: i64) -> addr {
    unsafe { calloc(n, 1) }
}

pub fn grow(p: addr, n: i64) -> addr {
    unsafe { realloc(p, n) }
}

pub fn dealloc(p: addr) {
    unsafe { free(p) }
}

/// Copies `n` bytes from `src` to `dst`; the two do not overlap. A long
/// copy is the C library's, as `to_vec` and `extend_from_slice` make it in
/// the Rust runtime: a list literal of constants copies its whole table
/// each time it is read, and word by word that was most of `casefolddiff`.
/// A short one is words, the last of them overlapping the one before as the
/// C library's are, so a string's few bytes are two loads and two stores,
/// not one of each a byte.
pub fn copy(dst: addr, src: addr, n: i64) {
    if n >= 64 {
        unsafe { memcpy(dst, src, n) }
        return
    }
    unsafe {
        if n >= 8 {
            var i = 0
            while i + 8 < n {
                dst.offset(i).store_u64(src.offset(i).load_u64())
                i += 8
            }
            dst.offset(n - 8).store_u64(src.offset(n - 8).load_u64())
        } else if n >= 4 {
            dst.store_u32(src.load_u32())
            dst.offset(n - 4).store_u32(src.offset(n - 4).load_u32())
        } else if n >= 2 {
            dst.store_u16(src.load_u16())
            dst.offset(n - 2).store_u16(src.offset(n - 2).load_u16())
        } else if n == 1 {
            dst.store_u8(src.load_u8())
        }
    }
}
