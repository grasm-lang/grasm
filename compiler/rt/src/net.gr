        let r = unsafe { journal.replayed(mem_static("tcp_listen_on"), 13) }
        if not sysv.null(r) {
            return r
        }
    }
    let out = listen_now(host, port, true)
    unsafe { journal.record(mem_static("tcp_listen_on"), 13, out) }
    out
}

fn tcp_connect_now(host: addr, port: addr) -> addr {
    if not strread.is_str(host) {
        return unsafe { sysv.failed(mem_static("host must be text"), mem_static_len("host must be text")) }
    }
    var hn = 0
    let hp = strread.text_of(host, hn)
    var p = 0
    if not sysv.int_arg(port, p) {
        return port_not_int()
    }
    if p < 1 or p > 65535 {
        return port_out_of_range(p)
    }
    let fd = connect_to(hp, hn, p)
    if fd < 0 {
        return sysv.failed_os(0 - fd)
    }
    without_nagle(fd)
    sysv.ok(sysv.int(socket_put(STREAM, fd)))
}

export fn grt_tcp_connect(host: addr, port: addr) -> addr {
    if journal.active() {
        let r = unsafe { journal.replayed(mem_static("tcp_connect"), 11) }
        if not sysv.null(r) {
            return r
        }
    }
    let out = tcp_connect_now(host, port)
    unsafe { journal.record(mem_static("tcp_connect"), 11, out) }
    out
}

fn tcp_accept_now(handle: addr) -> addr {
    var h = 0
    if not handle_arg(handle, h) {
        return handle_not_int()
    }
    let ready = ready_take(h)
    let s = socket_get(h)
    if sysv.null(s) {
        return not_open(h)
    }
    let k = kind_of(s)
    if k == STREAM {
        sock_drop(s)
        return unsafe { socket_says(h, mem_static(" is a connection, not a listener"), mem_static_len(" is a connection, not a listener")) }
    }
    if k == DATAGRAM {
        sock_drop(s)
        return unsafe { socket_says(h, mem_static(" is a datagram socket, not a listener"), mem_static_len(" is a datagram socket, not a listener")) }
    }
    let why = display.text_new()
    let c = accept_from(fd_of(s), ready, why)
    sock_drop(s)
    if c < 0 {
        return sysv.failed_buf(why)
    }
    display.text_free(why)
    sysv.ok(sysv.int(socket_put(STREAM, c)))
}

export fn grt_tcp_accept(handle: addr) -> addr {
    if journal.active() {
        let r = unsafe { journal.replayed(mem_static("tcp_accept"), 10) }
        if not sysv.null(r) {
            return r
        }
    }
    let out = tcp_accept_now(handle)
    unsafe { journal.record(mem_static("tcp_accept"), 10, out) }
    out
}

/// One `recv` on a stream into this thread's buffer: how many bytes, or the
/// error number negated.
fn recv_once(fd: i64) -> i64 {
    let b = rbuf()
    while true {
        let n = unsafe { recv(fd.as_i32(), b, 65536, 0.as_i32()) }
        if n >= 0 {
            return n
        }
        let e = sysv.errno()
        if e != sysv.EINTR {
            return 0 - e
        }
    }
    0
}

/// A read on stream `h`: as text (lossy) or as bytes.
fn tcp_read_any(handle: addr, as_bytes: bool) -> addr {
    var h = 0
    if not handle_arg(handle, h) {
        return handle_not_int()
    }
    let s = socket_get(h)
    if sysv.null(s) {
        return not_open(h)
    }
    let k = kind_of(s)
    if k == LISTENER {
        sock_drop(s)
        return unsafe { socket_says(h, mem_static(" is a listener, not a connection"), mem_static_len(" is a listener, not a connection")) }
    }
    if k == DATAGRAM {
        sock_drop(s)
        return unsafe { socket_says(h, mem_static(" is a datagram socket — use udp_recv, which keeps message boundaries"), mem_static_len(" is a datagram socket — use udp_recv, which keeps message boundaries")) }
    }
    let n = recv_once(fd_of(s))
    sock_drop(s)
    if n < 0 {
        return sysv.failed_os(0 - n)
    }
    if as_bytes {
        return sysv.ok(bytes.bytes_copy(rbuf(), n))
    }
    sysv.ok(sysv.lossy_text(rbuf(), n))
}

export fn grt_tcp_read(handle: addr) -> addr {
    if journal.active() {
        let r = unsafe { journal.replayed(mem_static("tcp_read"), 8) }
        if not sysv.null(r) {
            return r
        }
    }
    let out = tcp_read_any(handle, false)
    unsafe { journal.record(mem_static("tcp_read"), 8, out) }
    out
}

export fn grt_tcp_read_bytes(handle: addr) -> addr {
    if journal.active() {
        let r = unsafe { journal.replayed(mem_static("tcp_read_bytes"), 14) }
        if not sysv.null(r) {
            return r
        }
    }
    let out = tcp_read_any(handle, true)
    unsafe { journal.record(mem_static("tcp_read_bytes"), 14, out) }
    out
}

/// All `n` bytes at `p` sent on `fd`, retried past a signal: 0, or the
/// error number.
fn send_all(fd: i64, p: addr, n: i64) -> i64 {
    var done = 0
    while done < n {
        let w = unsafe { send(fd.as_i32(), p.offset(done), n - done, 0.as_i32()) }
        if w > 0 {
            done += w
        } else {
            let e = sysv.errno()
            if not (w < 0 and e == sysv.EINTR) {
                return if e == 0 { -1 } else { e }
            }
        }
    }
    0
}

/// A `bytes` value's window, its length in `n`: what a write or a datagram
/// sends. Not the buffer every window of it shares, which both runtimes sent
/// until 2026-10-31 (docs/known-issues.md).
fn window_bytes(v: addr, inout n: i64) -> addr {
    unsafe {
        n = v.offset(layout.BYTES_LEN).load_i64()
        v.offset(layout.BYTES_PTR).load_addr()
    }
}

/// A write on stream `h`: `p` and `n` the bytes.
fn tcp_write_on(h: i64, p: addr, n: i64) -> addr {
    let s = socket_get(h)
    if sysv.null(s) {
        return not_open(h)
    }
    let k = kind_of(s)
    if k == LISTENER {
        sock_drop(s)
        return unsafe { socket_says(h, mem_static(" is a listener, not a connection"), mem_static_len(" is a listener, not a connection")) }
    }
    if k == DATAGRAM {
        sock_drop(s)
        return unsafe { socket_says(h, mem_static(" is a datagram socket — use udp_send, which needs a destination"), mem_static_len(" is a datagram socket — use udp_send, which needs a destination")) }
    }
    let e = send_all(fd_of(s), p, n)
    sock_drop(s)
    if e != 0 {
        return sysv.failed_os(if e < 0 { 0 } else { e })
    }
    sysv.ok(sysv.unit())
}

fn tcp_write_bytes_now(handle: addr, data: addr) -> addr {
    var h = 0
    if not handle_arg(handle, h) {
        return handle_not_int()
    }
    if sysv.tag(data) != layout.TAG_BYTES {
        return unsafe { sysv.failed(mem_static("tcp_write_bytes needs bytes"), mem_static_len("tcp_write_bytes needs bytes")) }
    }
    var n = 0
    let p = window_bytes(data, n)
    tcp_write_on(h, p, n)
}

export fn grt_tcp_write_bytes(handle: addr, data: addr) -> addr {
    if journal.active() {
        let r = unsafe { journal.replayed(mem_static("tcp_write_bytes"), 15) }
        if not sysv.null(r) {
            return r
        }
    }
    let out = tcp_write_bytes_now(handle, data)
    unsafe { journal.record(mem_static("tcp_write_bytes"), 15, out) }
    out
}

fn tcp_write_now(handle: addr, data: addr) -> addr {
    var h = 0
    if not handle_arg(handle, h) {
        return handle_not_int()
    }
    var n = 0
    let p = sysv.text_arg(data, n)
    tcp_write_on(h, p, n)
}

export fn grt_tcp_write(handle: addr, data: addr) -> addr {
    if journal.active() {
        let r = unsafe { journal.replayed(mem_static("tcp_write"), 9) }
        if not sysv.null(r) {
            return r
        }
    }
    let out = tcp_write_now(handle, data)
    unsafe { journal.record(mem_static("tcp_write"), 9, out) }
