fn tcp_peer_now(handle: addr) -> addr {
    var h = 0
    if not handle_arg(handle, h) {
        return handle_not_int()
    }
    let s = socket_get(h)
    if sysv.null(s) {
        return not_open(h)
    }
    let k = kind_of(s)
    if k == LISTENER {
        sock_drop(s)
        return unsafe { socket_says(h, mem_static(" is a listener, not a connection"), mem_static_len(" is a listener, not a connection")) }
    }
    if k == DATAGRAM {
        sock_drop(s)
        return unsafe { socket_says(h, mem_static(" is a datagram socket — use udp_recv_from, which names each sender"), mem_static_len(" is a datagram socket — use udp_recv_from, which names each sender")) }
    }
    let a = addr_new()
    let e = name_of(fd_of(s), true, a)
    sock_drop(s)
    if e != 0 {
        sys.dealloc(a)
        return sysv.failed_os(e)
    }
    let t = display.text_new()
    let port = parts(a, t)
    sys.dealloc(a)
    let host = sysv.text_of_buf(t)
    sysv.ok(structs.pair(host, sysv.int(port)))
}

export fn grt_tcp_peer(handle: addr) -> addr {
    if journal.active() {
        let r = unsafe { journal.replayed(mem_static("tcp_peer"), 8) }
        if not sysv.null(r) {
            return r
        }
    }
    let out = tcp_peer_now(handle)
    unsafe { journal.record(mem_static("tcp_peer"), 8, out) }
    out
}

/// Closes a listener or a connection; closing one twice is no error. Its
/// record is written before the socket is touched, and a replay never
/// reaches the table.
export fn grt_net_close(handle: addr) {
    if unsafe { journal.gate(mem_static("net_close"), 9) } >= 0 {
        return
    }
    unsafe { journal.record_unit(mem_static("net_close"), 9) }
    var h = 0
    if not handle_arg(handle, h) {
        return
    }
    var tries = 0
    while unsafe { mem_process(SOCK_LOCK).atomic_cas_i64(0, 1, Acquire) } != 0 {
        tries = spin(tries)
    }
    let s = take_held(h)
    unlock()
    if not sysv.null(s) {
        sock_drop(s)
    }
}

fn udp_bind_now(port: addr) -> addr {
    var p = 0
    if not sysv.int_arg(port, p) {
        return port_not_int()
    }
    if p < 0 or p > 65535 {
        return port_out_of_range(p)
    }
    let fd = unsafe { udp_on(mem_static("0.0.0.0"), 7, p) }
    if fd < 0 {
        return sysv.failed_os(0 - fd)
    }
    sysv.ok(sysv.int(socket_put(DATAGRAM, fd)))
}

export fn grt_udp_bind(port: addr) -> addr {
    if journal.active() {
        let r = unsafe { journal.replayed(mem_static("udp_bind"), 8) }
        if not sysv.null(r) {
            return r
        }
    }
    let out = udp_bind_now(port)
    unsafe { journal.record(mem_static("udp_bind"), 8, out) }
    out
}

fn udp_send_now(handle: addr, host: addr, port: addr, data: addr) -> addr {
    var h = 0
    if not handle_arg(handle, h) {
        return handle_not_int()
    }
    var p = 0
    if not sysv.int_arg(port, p) {
        return port_not_int()
    }
    if p < 1 or p > 65535 {
        return port_out_of_range(p)
    }
    var hn = 0
    let hp = sysv.text_arg(host, hn)
    if sysv.tag(data) != layout.TAG_BYTES {
        return unsafe { sysv.failed(mem_static("udp_send takes bytes"), mem_static_len("udp_send takes bytes")) }
    }
    var dn = 0
    let dp = window_bytes(data, dn)
    let s = socket_get(h)
    if sysv.null(s) {
        return not_open(h)
    }
    if kind_of(s) != DATAGRAM {
        sock_drop(s)
        return unsafe { socket_says(h, mem_static(" is not a datagram socket"), mem_static_len(" is not a datagram socket")) }
    }
    // The host's first IPv4 address, or its first of any family when it has
    // none (`resolve_for`): `udp_bind` binds `0.0.0.0`, and the first answer
    // for `localhost` is `::1`, which an IPv4 socket cannot send to.
    let room = 64
    let recs = sys.alloc(8 * room)
    var i = 0
    while i < room {
        unsafe { recs.offset(8 * i).store_addr(addr_new()) }
        i += 1
    }
    let found = resolve(hp, hn, p, true, recs, room)
    var pick = 0
    var k = found - 1
    while k >= 0 {
        if unsafe { recs.offset(8 * k).load_addr().offset(A_FAMILY).load_i64() } == AF_INET {
            pick = k
        }
        k -= 1
    }
    let a = addr_new()
    if found > 0 {
        sys.copy(a, unsafe { recs.offset(8 * pick).load_addr() }, A_SIZE)
    }
    i = 0
    while i < room {
        sys.dealloc(unsafe { recs.offset(8 * i).load_addr() })
        i += 1
    }
    sys.dealloc(recs)
    if found < 0 {
        sys.dealloc(a)
        sock_drop(s)
        return sysv.failed_os(sysv.ENOENT)
    }
    var sent = -1
    var e = 0
    while sent == -1 {
        let w = unsafe { sendto(fd_of(s).as_i32(), dp, dn, 0.as_i32(), a.offset(A_BYTES), a.offset(A_LEN).load_i64().as_i32()) }
        if w >= 0 {
            sent = w
        } else {
            e = sysv.errno()
            if e != sysv.EINTR {
                sent = -2
            }
        }
    }
    sys.dealloc(a)
    sock_drop(s)
    if sent == -2 {
        return sysv.failed_os(e)
    }
    sysv.ok(sysv.int(sent))
}

export fn grt_udp_send(handle: addr, host: addr, port: addr, data: addr) -> addr {
    if journal.active() {
        let r = unsafe { journal.replayed(mem_static("udp_send"), 8) }
        if not sysv.null(r) {
            return r
        }
    }
    let out = udp_send_now(handle, host, port, data)
    unsafe { journal.record(mem_static("udp_send"), 8, out) }
    out
}

/// One datagram on `h`, whole; with `from`, the sender's address and port
/// too.
fn udp_recv_any(handle: addr, from: bool) -> addr {
    var h = 0
    if not handle_arg(handle, h) {
        return handle_not_int()
    }
    let s = socket_get(h)
    if sysv.null(s) {
        return not_open(h)
    }
    if kind_of(s) != DATAGRAM {
        sock_drop(s)
        return unsafe { socket_says(h, mem_static(" is not a datagram socket"), mem_static_len(" is not a datagram socket")) }
    }
    let b = rbuf()
    let a = addr_new()
    let flen = sys.alloc(8)
    unsafe { flen.store_u32(128.as_u32()) }
    var got = -1
    var e = 0
    while got == -1 {
        let n = unsafe { recvfrom(fd_of(s).as_i32(), b, 65536, 0.as_i32(), a.offset(A_BYTES), flen) }
        if n >= 0 {
            got = n
        } else {
            e = sysv.errno()
            if e != sysv.EINTR {
                got = -2
            }
        }
    }
    sock_drop(s)
    let fl = unsafe { flen.load_u32() }.as_i64()
    sys.dealloc(flen)
    if got == -2 {
        sys.dealloc(a)
        return sysv.failed_os(e)
    }
    unsafe { a.offset(A_LEN).store_i64(if fl > 128 { 128 } else { fl }) }
    let data = bytes.bytes_copy(b, got)
    if not from {
        sys.dealloc(a)
        return sysv.ok(data)
    }
    let t = display.text_new()
    let port = parts(a, t)
    sys.dealloc(a)
    let host = sysv.text_of_buf(t)
    sysv.ok(structs.triple(data, host, sysv.int(port)))
}

export fn grt_udp_recv(handle: addr) -> addr {
    if journal.active() {
        let r = unsafe { journal.replayed(mem_static("udp_recv"), 8) }
        if not sysv.null(r) {
            return r
        }
    }
    let out = udp_recv_any(handle, false)
    unsafe { journal.record(mem_static("udp_recv"), 8, out) }
    out
}

export fn grt_udp_recv_from(handle: addr) -> addr {
    if journal.active() {
        let r = unsafe { journal.replayed(mem_static("udp_recv_from"), 13) }
        if not sysv.null(r) {
            return r
        }
    }
    let out = udp_recv_any(handle, true)
    unsafe { journal.record(mem_static("udp_recv_from"), 13, out) }
    out
}
