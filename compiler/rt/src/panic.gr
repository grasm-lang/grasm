// Panics: the message, and the way out ([E-PANIC-EXIT]).
//
// A panic flushes what the program has written to stdout, writes `panic:
// <message>` to stderr and exits 101 -- through this runtime's own buffers
// and way out (`io.gr`, docs/self-hosting.md §6.12). Each message here is
// static bytes (`mem_static`), read-only and NUL-terminated, so saying it
// allocates nothing -- a runtime out of memory can still say so.
import io

/// Panics with the `n` bytes of text at `p`, valid UTF-8: static bytes
/// (`mem_static`), or text a family made.
pub fn say(p: addr, n: i64) {
    io.panic_bytes(p, n)
}

pub fn div_zero() {
    unsafe { say(mem_static("division by zero"), mem_static_len("division by zero")) }
}

pub fn rem_zero() {
    unsafe { say(mem_static("remainder by zero"), mem_static_len("remainder by zero")) }
}

pub fn assert_failed() {
    unsafe { say(mem_static("assertion failed"), mem_static_len("assertion failed")) }
}

pub fn neg_pow() {
    unsafe { say(mem_static("negative integer exponent (use floats)"), mem_static_len("negative integer exponent (use floats)")) }
}

pub fn uaf_inc() {
    unsafe { say(mem_static("use after free: inc on a value already released"), mem_static_len("use after free: inc on a value already released")) }
}

pub fn uaf_dec() {
    unsafe { say(mem_static("use after free: dec on a value already released"), mem_static_len("use after free: dec on a value already released")) }
}

export fn grt_panic_div_zero() {
    div_zero()
}

export fn grt_panic_rem_zero() {
    rem_zero()
}

export fn grt_panic_assert() {
    assert_failed()
}

export fn grt_panic_neg_pow() {
    neg_pow()
}

pub fn byte_len_not_str() {
    unsafe { say(mem_static("byte_len on non-string"), mem_static_len("byte_len on non-string")) }
}

pub fn expected_str() {
    unsafe { say(mem_static("expected a string"), mem_static_len("expected a string")) }
}

pub fn len_not_str() {
    unsafe { say(mem_static("len on non-string"), mem_static_len("len on non-string")) }
}
