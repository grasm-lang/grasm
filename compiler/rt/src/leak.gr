// How many boxes are live, and the leak check at the end of `main`
// (docs/self-hosting.md §6.11, §6.12).
//
// Every box is this runtime's (`alloc.gr`): a thread counts the boxes it
// made and has not freed, and one that ends hands its balance to the
// process (`ESCAPED`). `live_allocations` is the calling thread's count, as
// the Rust runtime's is.
//
// The check, as the Rust runtime's `grasm_check_leaks` makes it: under
// `GRASM_ALLOC_STATS`, how many boxes were made in all, to standard error;
// under `GRASM_LEAK_CHECK`, the roots this runtime keeps released first --
// what the reference heap (`refs.gr`) and the channels (`tasks.gr`) still
// hold, which are reachable as a global is, not leaked -- and then either
// `leak check: nothing live at exit`, or standard output written out, what
// is still live and the C copies never freed (`cmem.gr`) said, and exit 7.
// Each variable counts as set only when it is, and is UTF-8
// (`grasm_sys::sys::env_var`).
import layout
import sys
import alloc
import display
import refs
import tasks
import io
import journal
import cmem

/// Boxes live on this thread.
export fn grt_live_allocations() -> i64 {
    unsafe { alloc.local().offset(alloc.L_LIVE).load_i64() }
}

export fn grt_check_leaks() {
    var n = 0
    let stats = unsafe { journal.env_text(mem_static("GRASM_ALLOC_STATS"), n) }
    if unsafe { stats.as_i64() } != 0 {
        let l = alloc.local()
        let made = unsafe { l.offset(alloc.L_MADE).load_i64() } + alloc.escaped_made(false)
        let t = display.text_new()
        unsafe { display.put(t, mem_static("allocations: "), mem_static_len("allocations: ")) }
        display.put_int(t, made)
        io.err_line(display.text_ptr(t), display.text_len(t))
        display.text_free(t)
    }
    let check = unsafe { journal.env_text(mem_static("GRASM_LEAK_CHECK"), n) }
    if unsafe { check.as_i64() } == 0 {
        return
    }
    refs.drain()
    tasks.drain()
    let live = unsafe { alloc.local().offset(alloc.L_LIVE).load_i64() } + alloc.escaped(false)
    let copies = cmem.c_copies()
    if live == 0 and copies == 0 {
        unsafe { io.err_line(mem_static("leak check: nothing live at exit"), mem_static_len("leak check: nothing live at exit")) }
        return
    }
    io.flush_out()
    let t = display.text_new()
    if live != 0 {
        unsafe { display.put(t, mem_static("leak: "), mem_static_len("leak: ")) }
        display.put_int(t, live)
        unsafe { display.put(t, mem_static(" allocation(s) still live at exit\n"), mem_static_len(" allocation(s) still live at exit\n")) }
    }
    if copies != 0 {
        unsafe { display.put(t, mem_static("leak: "), mem_static_len("leak: ")) }
        display.put_int(t, copies)
        unsafe { display.put(t, mem_static(" string copy/copies handed to C and never freed\n"), mem_static_len(" string copy/copies handed to C and never freed\n")) }
    }
    io.err_bytes(display.text_ptr(t), display.text_len(t))
    display.text_free(t)
    io.leave(7)
}
