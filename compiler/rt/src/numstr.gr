// Numbers made into text that the program keeps: `n.to_str()`, and the
// numbers and booleans of an interpolated string, `"x = {x}"`.
//
// Interpolation builds in a `String` kept per thread for its capacity
// (`strings.gr`, `str_build`) and turned into a value when done; the
// numbers between are appended here, grown as `RawVec` grows it. A value
// of text is a box from this runtime's allocator (`alloc.gr`) with its
// payload written here, as `RtStr::of` writes one.
import fmt
import sys
import layout
import alloc

/// Appends `n` bytes at `p` to the `String` at `s`, growing it as `RawVec`
/// does: to twice its capacity, or to what is needed if that is more, and
/// never to less than `U8_MIN_CAP`.
pub fn string_push(s: addr, p: addr, n: i64) {
    string_reserve(s, n)
    let len = unsafe { s.offset(layout.VEC_LEN).load_i64() }
    sys.copy(unsafe { s.offset(layout.VEC_PTR).load_addr().offset(len) }, p, n)
    unsafe { s.offset(layout.VEC_LEN).store_i64(len + n) }
}

/// Room for `n` more bytes in the `String` (or any `Vec<u8>`) at `s`, as
/// `Vec::reserve` makes it.
pub fn string_reserve(s: addr, n: i64) {
    let cap = unsafe { s.offset(layout.VEC_CAP).load_i64() }
    let len = unsafe { s.offset(layout.VEC_LEN).load_i64() }
    if len + n > cap {
        var want = cap * 2
        if want < len + n {
            want = len + n
        }
        if want < layout.U8_MIN_CAP {
            want = layout.U8_MIN_CAP
        }
        // An empty `String` holds a dangling pointer, never allocated.
        let ptr = unsafe { s.offset(layout.VEC_PTR).load_addr() }
        let grown = if cap == 0 { sys.alloc(want) } else { sys.grow(ptr, want) }
        unsafe {
            s.offset(layout.VEC_PTR).store_addr(grown)
            s.offset(layout.VEC_CAP).store_i64(want)
        }
    }
}

/// A new string value holding the `n` bytes at `p`.
pub fn new_str(p: addr, n: i64) -> addr {
    let v = alloc.take()
    fill_str(v, p, n)
    v
}

/// Box `v` made a string of the `n` bytes at `p`, as `RtStr::of` makes one:
/// inline when they fit, in a `String` exactly as long when not.
pub fn fill_str(v: addr, p: addr, n: i64) {
    unsafe {
        v.offset(layout.TAG).store_u8(layout.TAG_STR.as_u8())
        v.offset(layout.STR_INDEX).store_i64(0)
    }
    if n <= layout.STR_CAP {
        // Inline. The bytes past the text are zero, as `StrData::of` leaves
        // them: two inline strings are compared as whole arrays.
        let at = unsafe { v.offset(layout.STR_BYTES) }
        var k = 0
        while k < layout.STR_CAP {
            unsafe { at.offset(k).store_u8(0) }
            k += 1
        }
        sys.copy(at, p, n)
        unsafe {
            v.offset(layout.STR_DISC).store_u8(layout.STR_INLINE.as_u8())
            v.offset(layout.STR_LEN).store_u8(n.as_u8())
        }
    } else {
        let buf = sys.alloc(n)
        sys.copy(buf, p, n)
        let s = unsafe { v.offset(layout.STR_STRING) }
        unsafe {
            v.offset(layout.STR_DISC).store_u8(layout.STR_HEAP.as_u8())
            s.offset(layout.VEC_PTR).store_addr(buf)
            s.offset(layout.VEC_LEN).store_i64(n)
            s.offset(layout.VEC_CAP).store_i64(n)
        }
    }
}

/// A new string value holding an integer's digits, written straight into
/// its box: any integer's text fits inline (`INT_MAX` is less than
/// `STR_CAP`), so no scratch buffer is made, as `RtStr::of_i64` makes none.
/// The bytes past the text are zero, as `fill_str` leaves them.
fn int_str(v: i64, unsigned: bool) -> addr {
    let s = alloc.take()
    unsafe {
        s.offset(layout.TAG).store_u8(layout.TAG_STR.as_u8())
        s.offset(layout.STR_INDEX).store_i64(0)
    }
    let at = unsafe { s.offset(layout.STR_BYTES) }
    let n = if unsigned { fmt.u64_text(v.as_u64(), at) } else { fmt.i64_text(v, at) }
    var k = n
    while k < layout.STR_CAP {
        unsafe { at.offset(k).store_u8(0) }
        k += 1
    }
    unsafe {
        s.offset(layout.STR_DISC).store_u8(layout.STR_INLINE.as_u8())
        s.offset(layout.STR_LEN).store_u8(n.as_u8())
    }
    s
}

export fn grt_str_from_i64(v: i64) -> addr {
    int_str(v, false)
}

/// A `u64` as text, unsigned ([T-U64]).
export fn grt_str_from_u64(v: i64) -> addr {
    int_str(v, true)
}

export fn grt_str_from_f64(v: f64) -> addr {
    let b = sys.alloc(fmt.F64_MAX)
    let s = new_str(b, fmt.f64_text(v, b))
    sys.dealloc(b)
    s
}

export fn grt_str_from_bool(v: i8) -> addr {
    let b = sys.alloc(8)
    let s = new_str(b, fmt.bool_text(v != 0, b))
    sys.dealloc(b)
    s
}

/// How long `v`'s decimal text is, its sign counted.
fn i64_len(v: i64) -> i64 {
    var n = if v < 0 { (0 - v).as_u64() } else { v.as_u64() }
    var len = if v < 0 { 2 } else { 1 }
    while n >= 10 {
        n = n / 10
        len += 1
    }
    len
}

/// `v`'s decimal text, the `len` bytes `i64_len` counts, written at `to`
/// and nothing past them: a `-`, then its magnitude, taken unsigned as
/// `fmt.i64_text` takes it.
fn put_i64(v: i64, len: i64, to: addr) {
    var n = if v < 0 { (0 - v).as_u64() } else { v.as_u64() }
    var i = len
    while true {
        i -= 1
        unsafe { to.offset(i).store_u8((n % 10).as_u8() + 48) }
        n = n / 10
        if n == 0 {
            break
        }
    }
    if v < 0 {
        unsafe { to.store_u8(45) }
    }
}

/// An integer's digits appended to the builder `at` (a `String`): written
/// in place when it has room for them, as a builder used before nearly
/// always has, so neither a scratch buffer nor growth -- the Rust runtime's
/// digits on its stack and `push_str` make none either; else through a
/// scratch buffer, grown as `push_str` grows it.
export fn grt_str_build_i64(at: i64, v: i64) {
    let s = unsafe { mem_addr(at) }
    let len = unsafe { s.offset(layout.VEC_LEN).load_i64() }
    let n = i64_len(v)
    if unsafe { s.offset(layout.VEC_CAP).load_i64() } - len >= n {
        put_i64(v, n, unsafe { s.offset(layout.VEC_PTR).load_addr().offset(len) })
        unsafe { s.offset(layout.VEC_LEN).store_i64(len + n) }
        return
    }
    let b = sys.alloc(fmt.INT_MAX)
    string_push(s, b, fmt.i64_text(v, b))
    sys.dealloc(b)
}

/// A float, by its bits, appended to the builder `at`.
export fn grt_str_build_f64(at: i64, bits: i64) {
    let b = sys.alloc(fmt.F64_MAX)
    string_push(unsafe { mem_addr(at) }, b, fmt.f64_text(bits.from_bits(), b))
    sys.dealloc(b)
}

export fn grt_str_build_bool(at: i64, v: i64) {
    let b = sys.alloc(8)
    string_push(unsafe { mem_addr(at) }, b, fmt.bool_text(v != 0, b))
    sys.dealloc(b)
}

/// An integer's digits at `data + at`, in a buffer the caller has made room
/// in; answers how many.
export fn grt_str_pin_i64(data: i64, at: i64, v: i64) -> i64 {
    fmt.i64_text(v, unsafe { mem_addr(data).offset(at) })
}
