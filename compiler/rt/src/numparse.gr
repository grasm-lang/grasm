// Numbers read from text and written to a fixed number of places, integers
// held to a width, and `assert_eq` ([L-LIB-PARSE], [L-LIB-BASE],
// [L-LIB-FIXED], [L-LIB-INT-CONV]; docs/self-hosting.md §6.11), as the Rust
// runtime has them.
//
// An integer is read as Rust's `from_str_radix` reads one, after the text
// is trimmed of Unicode whitespace: an optional `+` (or `-` for a signed
// type), then digits of the base and nothing else, in range. A float is read
// as Rust's `str::parse::<f64>` reads one -- `inf`, `infinity` and `nan` in
// any case, or digits with an optional point and exponent -- and its value
// is the decimal's, correctly rounded, made by `core`'s own slow algorithm
// (a decimal of up to 768 digits shifted by powers of two until the bits
// come out, ties to even). `to_fixed` writes the exact binary value to the
// places asked, ties to even, except that a value exactly halfway -- seen
// 25 places further on, as the Rust runtime looks -- goes away from zero.
import layout
import sys
import alloc
import boxes
import val
import strread
import strings
import numstr
import display
import maps
import equal
import fmt
import panic

extern fn grasm_panic_msg(p: addr, n: i64)

/// The digits of 5^s for s from 0 to 64, for a decimal shifted left by s
/// bits: offsets (66 words) and then the digits, made once.
process_local POW5: i64

fn say(p: addr, n: i64) {
    panic.say(p, n)
}

fn byte(p: addr, i: i64) -> i64 {
    unsafe { p.offset(i).load_u8() }.as_i64()
}

/// `v`'s text trimmed of whitespace: where it starts, its length in `n`.
fn trimmed(v: addr, inout n: i64) -> addr {
    var all = 0
    let p = strings.text(v, all)
    let a = strings.lead(p, all)
    let e = strings.trail(p, all, a)
    n = e - a
    unsafe { p.offset(a) }
}

// ----- integers ----------------------------------------------------------------

/// A digit's value in bases up to 36, either case; 99 for anything else.
fn digit(c: i64) -> i64 {
    if c >= 48 and c <= 57 {
        return c - 48
    }
    if c >= 97 and c <= 122 {
        return c - 87
    }
    if c >= 65 and c <= 90 {
        return c - 55
    }
    99
}

/// The integer the `n` bytes at `p` spell in `base`, read as `i64` or (not
/// `signed`) `u64`, into `out`; false when they spell none in range.
fn read_int(p: addr, n: i64, base: i64, signed: bool, inout out: i64) -> bool {
    if n == 0 {
        return false
    }
    var i = 0
    var negative = false
    let c = byte(p, 0)
    if c == 43 or c == 45 {
        if n == 1 {
            return false
        }
        if c == 43 {
            i = 1
        } else if signed {
            i = 1
            negative = true
        }
    }
    let b = base.as_u64()
    var m: u64 = 0.as_u64()
    let most = (0 - 1).as_u64()
    while i < n {
        let d = digit(byte(p, i))
        if d >= base {
            return false
        }
        let du = d.as_u64()
        // m * b + d past what 64 bits hold.
        if m > (most - du) / b {
            return false
        }
        m = m * b + du
        i += 1
    }
    if not signed {
        out = m.as_i64()
        return true
    }
    let top = 1.shl(63).as_u64()
    if negative {
        if m > top {
            return false
        }
        out = (0.as_u64() - m).as_i64()
        return true
    }
    if m >= top {
        return false
    }
    out = m.as_i64()
    true
}

fn base_panic(head: addr, hn: i64, base: i64) {
    let t = display.text_new()
    display.put(t, head, hn)
    display.put_int(t, base)
    unsafe { grasm_panic_msg(display.text_ptr(t), display.text_len(t)) }
}

fn none() -> addr {
    maps.option(unsafe { mem_addr(0) })
}

export fn grt_str_parse_int(s: addr) -> addr {
    var n = 0
    let p = trimmed(s, n)
    var v = 0
    if read_int(p, n, 10, true, v) { maps.option(boxes.fresh_int(v)) } else { none() }
}

export fn grt_str_parse_int_base(s: addr, base: i64) -> addr {
    if base < 2 or base > 36 {
        unsafe { base_panic(mem_static("parse_int_base takes a base in 2..36, not "), mem_static_len("parse_int_base takes a base in 2..36, not "), base) }
    }
    var n = 0
    let p = trimmed(s, n)
    var v = 0
    if read_int(p, n, base, true, v) { maps.option(boxes.fresh_int(v)) } else { none() }
}

export fn grt_str_parse_u64(s: addr) -> addr {
    var n = 0
    let p = trimmed(s, n)
    var v = 0
    if read_int(p, n, 10, false, v) { maps.option(boxes.unsigned(v)) } else { none() }
}

export fn grt_str_parse_u64_base(s: addr, base: i64) -> addr {
    if base < 2 or base > 36 {
        unsafe { base_panic(mem_static("parse_u64_base takes a base in 2..36, not "), mem_static_len("parse_u64_base takes a base in 2..36, not "), base) }
    }
    var n = 0
    let p = trimmed(s, n)
    var v = 0
    if read_int(p, n, base, false, v) { maps.option(boxes.unsigned(v)) } else { none() }
}

// ----- floats: the grammar ----------------------------------------------------------

fn is_digit(c: i64) -> bool {
    c >= 48 and c <= 57
}

/// Whether the `n` bytes at `p` are a decimal number as `core`'s
/// `parse_number` takes one: digits, an optional point and digits -- one
/// digit at least -- and an optional `e` with an optional sign and digits.
fn is_number(p: addr, n: i64) -> bool {
    var i = 0
    var digits = 0
    while i < n and is_digit(byte(p, i)) {
        i += 1
        digits += 1
    }
    if i < n and byte(p, i) == 46 {
        i += 1
        while i < n and is_digit(byte(p, i)) {
            i += 1
            digits += 1
        }
    }
    if digits == 0 {
        return false
    }
    if i < n and (byte(p, i) == 101 or byte(p, i) == 69) {
        i += 1
        if i < n and (byte(p, i) == 43 or byte(p, i) == 45) {
            i += 1
        }
        var e = 0
        while i < n and is_digit(byte(p, i)) {
            i += 1
            e += 1
        }
        if e == 0 {
            return false
        }
    }
    i == n
}

/// `inf`, `infinity` or `nan` in any case: 1, 2 for NaN, 0 for neither.
fn inf_nan(p: addr, n: i64) -> i64 {
    if n != 3 and n != 8 {
        return 0
    }
    var up = 0
    var i = n - 1
    while i >= 0 {
        up = up * 256 + byte(p, i).bit_and(223)
        i -= 1
    }
    if n == 3 and up == 4607561 {
        return 1
    }
    if n == 8 and up == 6436850368004902473 {
        return 1
    }
    if n == 3 and up == 5128526 {
        return 2
    }
    0
}

// ----- floats: `core`'s decimal ------------------------------------------------------
//
// A decimal at an address: its digit count, the point's place, whether
// digits past the 768 kept were not all zero, then the digits.

let MAX_DIGITS = 768
let D_N = 0
let D_POINT = 8
let D_TRUNC = 16
let D_DIGITS = 24
let POINT_RANGE = 2047

fn dn(d: addr) -> i64 {
    unsafe { d.offset(D_N).load_i64() }
}

fn set_dn(d: addr, v: i64) {
    unsafe { d.offset(D_N).store_i64(v) }
}

fn dpoint(d: addr) -> i64 {
    unsafe { d.offset(D_POINT).load_i64() }
}

fn set_dpoint(d: addr, v: i64) {
    unsafe { d.offset(D_POINT).store_i64(v) }
}

fn set_trunc(d: addr) {
    unsafe { d.offset(D_TRUNC).store_i64(1) }
}

fn dig(d: addr, i: i64) -> i64 {
    unsafe { d.offset(D_DIGITS + i).load_u8() }.as_i64()
}

fn set_dig(d: addr, i: i64, v: i64) {
    unsafe { d.offset(D_DIGITS + i).store_u8(v.as_u8()) }
}

fn add_digit(d: addr, v: i64) {
    let n = dn(d)
    if n < MAX_DIGITS {
        set_dig(d, n, v)
    }
    set_dn(d, n + 1)
}

fn trim_zeros(d: addr) {
    while dn(d) != 0 and dig(d, dn(d) - 1) == 0 {
        set_dn(d, dn(d) - 1)
    }
}

/// The number the `n` bytes at `p` spell (`is_number` holds), as a decimal
/// (`parse_decimal`).
fn parse_decimal(d: addr, p: addr, n: i64) {
    var i = 0
    while i < n and byte(p, i) == 48 {
        i += 1
    }
    while i < n and is_digit(byte(p, i)) {
        add_digit(d, byte(p, i) - 48)
        i += 1
    }
    if i < n and byte(p, i) == 46 {
        i += 1
        let first = i
        if dn(d) == 0 {
            while i < n and byte(p, i) == 48 {
                i += 1
            }
        }
        while i < n and is_digit(byte(p, i)) {
            add_digit(d, byte(p, i) - 48)
            i += 1
        }
        set_dpoint(d, first - i)
    }
    if dn(d) != 0 {
        // The zeros at the end of what was read, the point passed over.
        var zeros = 0
        var j = i - 1
        var going = true
        while going and j >= 0 {
            let c = byte(p, j)
            if c == 48 {
                zeros += 1
            } else if c != 46 {
                going = false
            }
            j -= 1
        }
        set_dpoint(d, dpoint(d) + zeros)
        set_dn(d, dn(d) - zeros)
        set_dpoint(d, dpoint(d) + dn(d))
        if dn(d) > MAX_DIGITS {
            set_trunc(d)
            set_dn(d, MAX_DIGITS)
        }
    }
    if i < n and (byte(p, i) == 101 or byte(p, i) == 69) {
        i += 1
        var negative = false
        if i < n {
            negative = byte(p, i) == 45
            if byte(p, i) == 45 or byte(p, i) == 43 {
                i += 1
            }
        }
        var e = 0
        while i < n and is_digit(byte(p, i)) {
            if e < 65536 {
                e = 10 * e + byte(p, i) - 48
            }
            i += 1
        }
        set_dpoint(d, dpoint(d) + if negative { 0 - e } else { e })
    }
    var k = dn(d)
    while k < 19 {
        set_dig(d, k, 0)
        k += 1
    }
}

/// The digits of 5^s, made once for the process.
fn pow5_table() -> addr {
    unsafe {
        let have = mem_process(POW5).atomic_load_i64(Acquire)
        if have != 0 {
            return mem_addr(have)
        }
        let t = sys.alloc_zeroed(66 * 8 + 1600)
        let work = sys.alloc_zeroed(64)
        // 5^s, least significant digit first, and how many digits.
        work.store_u8(1.as_u8())
        var len = 1
        var at = 0
        var s = 0
        while s <= 64 {
            t.offset(8 * s).store_i64(at)
            var k = len - 1
            while k >= 0 {
                t.offset(66 * 8 + at).store_u8(work.offset(k).load_u8())
                at += 1
                k -= 1
            }
            var carry = 0
            var j = 0
            while j < len {
                let v = 5 * work.offset(j).load_u8().as_i64() + carry
                work.offset(j).store_u8((v % 10).as_u8())
                carry = v / 10
                j += 1
            }
            if carry > 0 {
                work.offset(len).store_u8(carry.as_u8())
                len += 1
            }
            s += 1
        }
        t.offset(8 * 65).store_i64(at)
        sys.dealloc(work)
        let was = mem_process(POW5).atomic_cas_i64(0, t.as_i64(), AcqRel)
        if was != 0 {
            sys.dealloc(t)
            return mem_addr(was)
        }
        t
    }
}

/// How many digits a left shift by `shift` adds
/// (`number_of_digits_decimal_left_shift`): as many as 2^shift has, or one
/// fewer when the digits are less than 5^shift's.
fn new_digits(d: addr, shift: i64) -> i64 {
    let s = shift.bit_and(63)
    var count = 1
    var x = 1.shl(s).as_u64()
    while x >= 10.as_u64() {
        x = x / 10.as_u64()
        count += 1
    }
    let t = pow5_table()
    let a = unsafe { t.offset(8 * s).load_i64() }
    let b = unsafe { t.offset(8 * (s + 1)).load_i64() }
    var i = 0
    while i < b - a {
        let p5 = unsafe { t.offset(66 * 8 + a + i).load_u8() }.as_i64()
        if i >= dn(d) {
            return count - 1
        }
        if dig(d, i) != p5 {
            return if dig(d, i) < p5 { count - 1 } else { count }
        }
        i += 1
    }
    count
}

fn left_shift(d: addr, shift: i64) {
    if dn(d) == 0 {
        return
    }
    let added = new_digits(d, shift)
    var r = dn(d)
    var w = dn(d) + added
    var acc: u64 = 0.as_u64()
    let ten = 10.as_u64()
    while r != 0 {
        r -= 1
        w -= 1
        acc = acc + dig(d, r).as_u64().shl(shift)
        let q = acc / ten
        let rem = acc - ten * q
        if w < MAX_DIGITS {
            set_dig(d, w, rem.as_i64())
        } else if rem > 0.as_u64() {
            set_trunc(d)
        }
        acc = q
    }
    while acc > 0.as_u64() {
        w -= 1
        let q = acc / ten
        let rem = acc - ten * q
        if w < MAX_DIGITS {
            set_dig(d, w, rem.as_i64())
        } else if rem > 0.as_u64() {
            set_trunc(d)
        }
        acc = q
    }
    set_dn(d, dn(d) + added)
    if dn(d) > MAX_DIGITS {
        set_dn(d, MAX_DIGITS)
    }
    set_dpoint(d, dpoint(d) + added)
    trim_zeros(d)
}

fn right_shift(d: addr, shift: i64) {
    var r = 0
    var w = 0
    var acc: u64 = 0.as_u64()
    let ten = 10.as_u64()
    let zero = 0.as_u64()
    var reading = true
    while reading and acc.ushr(shift) == zero {
        if r < dn(d) {
            acc = ten * acc + dig(d, r).as_u64()
            r += 1
        } else if acc == zero {
            return
        } else {
            while acc.ushr(shift) == zero {
                acc = acc * ten
                r += 1
            }
            reading = false
        }
    }
    set_dpoint(d, dpoint(d) - (r - 1))
    if dpoint(d) < 0 - POINT_RANGE {
        set_dn(d, 0)
        set_dpoint(d, 0)
        unsafe { d.offset(D_TRUNC).store_i64(0) }
        return
    }
    let mask = 1.shl(shift).as_u64() - 1.as_u64()
    while r < dn(d) {
        let nd = acc.ushr(shift).as_i64()
        acc = ten * acc.bit_and(mask) + dig(d, r).as_u64()
        r += 1
        set_dig(d, w, nd)
        w += 1
    }
    while acc > zero {
        let nd = acc.ushr(shift).as_i64()
        acc = ten * acc.bit_and(mask)
        if w < MAX_DIGITS {
            set_dig(d, w, nd)
            w += 1
        } else if nd > 0 {
            set_trunc(d)
        }
    }
    set_dn(d, w)
    trim_zeros(d)
}

/// The decimal rounded to an integer, ties to even (`Decimal::round`).
fn round_int(d: addr) -> u64 {
    if dn(d) == 0 or dpoint(d) < 0 {
        return 0.as_u64()
    }
    if dpoint(d) > 18 {
        return (0 - 1).as_u64()
    }
    let dp = dpoint(d)
    var v: u64 = 0.as_u64()
    var i = 0
    while i < dp {
        v = v * 10.as_u64()
        if i < dn(d) {
            v = v + dig(d, i).as_u64()
        }
        i += 1
    }
    var up = false
    if dp < dn(d) {
        up = dig(d, dp) >= 5
        if dig(d, dp) == 5 and dp + 1 == dn(d) {
            up = unsafe { d.offset(D_TRUNC).load_i64() } != 0 or (dp != 0 and dig(d, dp - 1).bit_and(1) != 0)
        }
    }
    if up {
        v = v + 1.as_u64()
    }
    v
}

/// How far to shift a decimal whose point is `n` places out (`get_shift`):
/// `core`'s `POWERS`, each byte 48 more than its entry.
fn shift_for(n: i64) -> i64 {
    if n >= 19 {
        return 60
    }
    unsafe { mem_static("0369=@CGJMQTW[^aehk").offset(n).load_u8() }.as_i64() - 48
}

let INF_BITS = 9218868437227405312

/// The bits of the double nearest the decimal number in the `n` bytes at `p`
/// (`parse_long_mantissa`), sign aside.
fn decimal_bits(p: addr, n: i64) -> i64 {
    let d = sys.alloc_zeroed(D_DIGITS + MAX_DIGITS + 8)
    parse_decimal(d, p, n)
    let out = convert(d)
    sys.dealloc(d)
    out
}

fn convert(d: addr) -> i64 {
    if dn(d) == 0 or dpoint(d) < -324 {
        return 0
    }
    if dpoint(d) >= 310 {
        return INF_BITS
    }
    var exp2 = 0
    while dpoint(d) > 0 {
        let shift = shift_for(dpoint(d))
        right_shift(d, shift)
        if dpoint(d) < 0 - POINT_RANGE {
            return 0
        }
        exp2 += shift
    }
    var going = true
    while going and dpoint(d) <= 0 {
        var shift = 0
        if dpoint(d) == 0 {
            let first = dig(d, 0)
            if first >= 5 {
                going = false
            } else {
                shift = if first < 2 { 2 } else { 1 }
            }
        } else {
            shift = shift_for(0 - dpoint(d))
        }
        if going {
            left_shift(d, shift)
            if dpoint(d) > POINT_RANGE {
                return INF_BITS
            }
            exp2 -= shift
        }
    }
    exp2 -= 1
    while - 1022 > exp2 {
        var k = -1022 - exp2
        if k > 60 {
            k = 60
        }
        right_shift(d, k)
        exp2 += k
    }
    if exp2 + 1023 >= 2047 {
        return INF_BITS
    }
    left_shift(d, 53)
    var mant = round_int(d)
    if mant >= 1.shl(53).as_u64() {
        right_shift(d, 1)
        exp2 += 1
        mant = round_int(d)
        if exp2 + 1023 >= 2047 {
            return INF_BITS
        }
    }
    var power2 = exp2 + 1023
    if mant < 1.shl(52).as_u64() {
        power2 -= 1
    }
    mant.bit_and(1.shl(52).as_u64() - 1.as_u64()).as_i64().bit_or(power2.shl(52))
}

export fn grt_str_parse_float(s: addr) -> addr {
    var n = 0
    var p = trimmed(s, n)
    if n == 0 {
        return none()
    }
    let c = byte(p, 0)
    let negative = c == 45
    if c == 45 or c == 43 {
        p = unsafe { p.offset(1) }
        n -= 1
    }
    if n == 0 {
        return none()
    }
    var bits = 0
    if is_number(p, n) {
        bits = decimal_bits(p, n)
    } else {
        let k = inf_nan(p, n)
        if k == 0 {
            return none()
        }
        bits = if k == 1 { INF_BITS } else { 9221120237041090560 }
    }
    if negative {
        bits = bits.bit_xor(1.shl(63))
    }
    maps.option(boxes.float(bits.from_bits()))
}

// ----- fixed places -----------------------------------------------------------------

/// `|x|`'s exact value to `places` digits after the point, ties to even, as
/// text in `t` (`format!("{:.p$}")` of a finite value, the sign aside).
fn fixed_digits(x: f64, places: i64, t: addr) {
    let bits = x.to_bits()
    let e = bits.ushr(52).bit_and(2047)
    let f = bits.bit_and(1.shl(52) - 1)
    let mant = if e == 0 { f } else { f.bit_or(1.shl(52)) }
    let exp2 = if e == 0 { -1074 } else { e - 1075 }
    let a = sys.alloc_zeroed(176)
    fmt.big_from_u64(a, mant.as_u64())
    fmt.big_mul_pow10(a, places)
    if exp2 >= 0 {
        fmt.big_mul_pow2(a, exp2)
    } else {
        let k = 0 - exp2
        // The bit worth a half, and whether any below it is set.
        let hb = k - 1
        let half = fmt.limb(a, hb / 32).ushr(hb % 32).bit_and(1.as_u64()) == 1.as_u64()
        var below = fmt.limb(a, hb / 32).bit_and(1.shl(hb % 32).as_u64() - 1.as_u64()) != 0.as_u64()
        var i = 0
        while i < hb / 32 {
            if fmt.limb(a, i) != 0.as_u64() {
                below = true
            }
            i += 1
        }
        shift_right(a, k)
        let odd = fmt.limb(a, 0).bit_and(1.as_u64()) == 1.as_u64()
        if half and (below or odd) {
            add_one(a)
        }
    }
    // The integer's digits, from the bottom.
    let buf = sys.alloc(512)
    var nd = 0
    while fmt.size(a) > 0 {
        let r = div_small(a, 10)
        unsafe { buf.offset(nd).store_u8((48 + r).as_u8()) }
        nd += 1
    }
    while nd < places + 1 {
        unsafe { buf.offset(nd).store_u8(48.as_u8()) }
        nd += 1
    }
    var i = nd - 1
    while i >= 0 {
        if i == places - 1 {
            display.put_byte(t, 46)
        }
        display.put_byte(t, unsafe { buf.offset(i).load_u8() }.as_i64())
        i -= 1
    }
    sys.dealloc(buf)
    sys.dealloc(a)
}

/// `a >>= k`.
fn shift_right(a: addr, k: i64) {
    let words = k / 32
    let bits = k % 32
    let n = fmt.size(a)
    if words >= n {
        fmt.big_zero(a)
        return
    }
    var i = 0
    while i < n - words {
        var v = fmt.limb(a, i + words).ushr(bits)
        if bits > 0 and i + words + 1 < n {
            v = v.bit_or(fmt.limb(a, i + words + 1).shl(32 - bits).bit_and(4294967295.as_u64()))
        }
        fmt.set_limb(a, i, v)
        i += 1
    }
    while i < n {
        fmt.set_limb(a, i, 0.as_u64())
        i += 1
    }
    var m = n - words
    while m > 0 and fmt.limb(a, m - 1) == 0.as_u64() {
        m -= 1
    }
    fmt.set_size(a, m)
}

fn add_one(a: addr) {
    var i = 0
    var carry = true
    let n = fmt.size(a)
    while carry and i < n {
        let v = fmt.limb(a, i) + 1.as_u64()
        if v == 4294967296.as_u64() {
            fmt.set_limb(a, i, 0.as_u64())
        } else {
            fmt.set_limb(a, i, v)
            carry = false
        }
        i += 1
    }
    if carry {
        fmt.set_limb(a, n, 1.as_u64())
        fmt.set_size(a, n + 1)
    }
}

/// `a /= m`, answering the remainder; `m < 2^32`.
fn div_small(a: addr, m: i64) -> i64 {
    let mu = m.as_u64()
    var rem: u64 = 0.as_u64()
    var i = fmt.size(a) - 1
    while i >= 0 {
        let cur = rem.shl(32).bit_or(fmt.limb(a, i))
        fmt.set_limb(a, i, cur / mu)
        rem = cur % mu
        i -= 1
    }
    var n = fmt.size(a)
    while n > 0 and fmt.limb(a, n - 1) == 0.as_u64() {
        n -= 1
    }
    fmt.set_size(a, n)
    rem.as_i64()
}

/// `x` to exactly `places` digits after the point (0 to 17), a tie going
/// away from zero.
export fn grt_f64_to_fixed(x: f64, places: i64) -> addr {
    if places < 0 or places > 17 {
        let t = display.text_new()
        unsafe { display.put(t, mem_static("to_fixed("), 9) }
        display.put_int(t, places)
        unsafe {
            display.put(t, mem_static("): places must be 0 to 17"), mem_static_len("): places must be 0 to 17"))
            grasm_panic_msg(display.text_ptr(t), display.text_len(t))
        }
    }
    let t = display.text_new()
    let negative = x.to_bits() < 0
    if x != x {
        unsafe { display.put(t, mem_static("NaN"), 3) }
    } else if x == 1.0 / 0.0 or x == -1.0 / 0.0 {
        if negative {
            display.put_byte(t, 45)
        }
        unsafe { display.put(t, mem_static("inf"), 3) }
    } else {
        let mag = x.to_bits().bit_and(1.shl(63) - 1).from_bits()
        let wide = display.text_new()
        fixed_digits(mag, places + 25, wide)
        let wn = display.text_len(wide)
        let wp = display.text_ptr(wide)
        var tie = byte(wp, wn - 25) == 53
        var i = wn - 24
        while i < wn {
            if byte(wp, i) != 48 {
                tie = false
            }
            i += 1
        }
        if negative {
            display.put_byte(t, 45)
        }
        if not tie {
            fixed_digits(mag, places, t)
        } else {
            // The head, its point dropped when nothing follows it, one unit
            // more in its last place.
            var hn = wn - 25
            if hn > 0 and byte(wp, hn - 1) == 46 {
                hn -= 1
            }
            let h = sys.alloc(hn + 1)
            sys.copy(h, wp, hn)
            var j = hn
            var carry = true
            while carry and j > 0 {
                j -= 1
                let c = byte(h, j)
                if c != 46 {
                    if c == 57 {
                        unsafe { h.offset(j).store_u8(48.as_u8()) }
                    } else {
                        unsafe { h.offset(j).store_u8((c + 1).as_u8()) }
                        carry = false
                    }
                }
            }
            if carry {
                display.put_byte(t, 49)
            }
            display.put(t, h, hn)
            sys.dealloc(h)
        }
        display.text_free(wide)
    }
    let out = numstr.new_str(display.text_ptr(t), display.text_len(t))
    display.text_free(t)
    out
}

// ----- integers held to a width ---------------------------------------------------------

/// The range of the width a tag names: `i8 i16 i32 u8 u16 u32 u64`, then
/// `i64` for anything else. A `u64`'s ends are its bits.
fn lo_of(tag: i64) -> i64 {
    if tag == 0 {
        return -128
    }
    if tag == 1 {
        return -32768
    }
    if tag == 2 {
        return -2147483648
    }
    if tag >= 3 and tag <= 6 {
        return 0
    }
    1.shl(63)
}

fn hi_of(tag: i64) -> i64 {
    if tag == 0 {
        return 127
    }
    if tag == 1 {
        return 32767
    }
    if tag == 2 {
        return 2147483647
    }
    if tag == 3 {
        return 255
    }
    if tag == 4 {
        return 65535
    }
    if tag == 5 {
        return 4294967295
    }
    if tag == 6 {
        return -1
    }
    9223372036854775807
}

let U64_TAG = 6

/// The boxed integer of width `tag` holding `v`, which is in its range.
fn int_box(tag: i64, v: i64) -> addr {
    if tag == U64_TAG { boxes.unsigned(v) } else { boxes.int(v) }
}

/// Whether `v`, a value of width `src`, lies in width `tag`'s range.
fn fits(tag: i64, src: i64, v: i64) -> bool {
    if src == U64_TAG and v < 0 {
        // From 2^63 up: past every range but a `u64`'s.
        return tag == U64_TAG
    }
    if tag == U64_TAG {
        return v >= 0 or src == U64_TAG
    }
    v >= lo_of(tag) and v <= hi_of(tag)
}

export fn grt_int_try(tag: i64, src: i64, v: i64) -> addr {
    if fits(tag, src, v) { maps.option(int_box(tag, v)) } else { none() }
}

/// `a op b` (0 add, 1 sub, 2 mul) at width `tag`: its value in `out`, with
/// 0 when it is the true result in range, 1 when the true result is above
/// the range and -1 when below.
fn exact(tag: i64, op: i64, a: i64, b: i64, inout out: i64) -> i64 {
    if tag == U64_TAG {
        let x = a.as_u64()
        let y = b.as_u64()
        if op == 0 {
            let r = x + y
            out = r.as_i64()
            return if r < x { 1 } else { 0 }
        }
        if op == 1 {
            out = (x - y).as_i64()
            return if x < y { -1 } else { 0 }
        }
        let r = x * y
        out = r.as_i64()
        if x != 0.as_u64() and r / x != y {
            return 1
        }
        return 0
    }
    var over = 0
    var r = 0
    if op == 0 {
        r = a + b
        if a >= 0 and b >= 0 and r < 0 {
            over = 1
        } else if a < 0 and b < 0 and r >= 0 {
            over = -1
        }
    } else if op == 1 {
        r = a - b
        if a >= 0 and b < 0 and r < 0 {
            over = 1
        } else if a < 0 and b >= 0 and r >= 0 {
            over = -1
        }
    } else {
        r = a * b
        let min = 1.shl(63)
        let wrapped = (a == -1 and b == min) or (b == -1 and a == min) or (a != 0 and r / a != b)
        if wrapped {
            over = if (a < 0) != (b < 0) { -1 } else { 1 }
        }
    }
    out = r
    if over != 0 {
        return over
    }
    if r > hi_of(tag) {
        return 1
    }
    if r < lo_of(tag) {
        return -1
    }
    0
}

export fn grt_int_checked(tag: i64, op: i64, a: i64, b: i64) -> addr {
    var r = 0
    if exact(tag, op, a, b, r) == 0 { maps.option(int_box(tag, r)) } else { none() }
}

export fn grt_int_saturating(tag: i64, op: i64, a: i64, b: i64) -> i64 {
    var r = 0
    let side = exact(tag, op, a, b, r)
    if side > 0 {
        return hi_of(tag)
    }
    if side < 0 {
        return lo_of(tag)
    }
    r
}

// ----- assert_eq ----------------------------------------------------------------------

/// Releases both when equal; otherwise panics naming them.
export fn grt_assert_eq(a: addr, b: addr) {
    if equal.equal(a, b) {
        val.dec(a)
        val.dec(b)
        return
    }
    let t = display.text_new()
    unsafe { display.put(t, mem_static("assertion failed: `"), mem_static_len("assertion failed: `")) }
    let sa = display.shown(a)
    display.put(t, display.text_ptr(sa), display.text_len(sa))
    unsafe { display.put(t, mem_static("` != `"), mem_static_len("` != `")) }
    let sb = display.shown(b)
    display.put(t, display.text_ptr(sb), display.text_len(sb))
    display.put_byte(t, 96)
    unsafe { grasm_panic_msg(display.text_ptr(t), display.text_len(t)) }
}
