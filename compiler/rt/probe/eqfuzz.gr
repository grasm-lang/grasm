// Equality and order on the Grasm runtime against the Rust runtime's
// (docs/self-hosting.md §6.11), for `scripts/fuzz_rteq.sh`, which builds this
// twice -- on the Rust runtime and with the Grasm runtime interposed -- and
// requires the same lines out.
//
//     eqfuzz <seed> <rounds>
//
// Each round makes random pairs of values of one type, often equal, often
// nearly so, and prints whether `==` holds for each, and `cmp` for the types
// that have an order. The types: integers, `u64`s, floats (NaN and both
// zeros among them), booleans, strings short and long, lists of every scalar
// and of strings, lists of lists, lists against a map's keys (the same list
// held as scalars and as boxes), tuples, `Option`s and enums with payloads,
// maps, structs with float fields, ranges, `bytes`, units and function
// values, named and closures. A compiled `==` on any of these but a scalar
// calls `grasm_val_eq`, and `cmp` on a tuple, string or number
// `grasm_val_cmp`.

type Pt = { x: f64, y: f64, tag: str }
type Box3 = { a: i64, b: [str], c: Pt }
type Shape = | Circle(r: f64) | Rect(w: f64, h: f64) | Dot

fn next(inout s: i64) -> i64 {
    s = s * 6364136223846793005 + 1442695040888963407
    s.ushr(17)
}

fn pick(inout s: i64, n: i64) -> i64 {
    next(s) % n
}

fn float(inout s: i64) -> f64 {
    let k = pick(s, 8)
    if k == 0 {
        return 0.0 / 0.0
    }
    if k == 1 {
        return 0.0
    }
    if k == 2 {
        return 0.0 * -1.0
    }
    if k == 3 {
        return 1.0 / 0.0
    }
    if k == 4 {
        return -1.0 / 0.0
    }
    (pick(s, 9) - 4).as_f64() / 2.0
}

fn word(inout s: i64) -> str {
    let k = pick(s, 6)
    if k == 0 {
        return ""
    }
    if k == 1 {
        return "a"
    }
    if k == 2 {
        return "ab"
    }
    if k == 3 {
        return "a long string past the inline capacity of a box"
    }
    if k == 4 {
        return "a long string past the inline capacity of a boX"
    }
    "é"
}

fn ints(inout s: i64) -> [i64] {
    var out: [i64] = []
    for i in 0..pick(s, 4) {
        out.push(pick(s, 3))
    }
    out
}

fn words(inout s: i64) -> [str] {
    var out: [str] = []
    for i in 0..pick(s, 4) {
        out.push(word(s))
    }
    out
}

fn shape(inout s: i64) -> Shape {
    let k = pick(s, 3)
    if k == 0 {
        return Circle(float(s))
    }
    if k == 1 {
        return Rect(float(s), float(s))
    }
    Dot
}

fn pt(inout s: i64) -> Pt {
    Pt{ x: float(s), y: float(s), tag: word(s) }
}

fn double(x: i64) -> i64 {
    2 * x
}

fn triple(x: i64) -> i64 {
    3 * x
}

/// One closure expression, made over whatever it is given: two made from
/// equal lists run the same code over equal captures.
fn counter(c: [str]) -> fn(i64) -> i64 {
        |x| x + c.len()
}

fn b(v: bool) -> i64 {
    if v { 1 } else { 0 }
}

fn round(inout s: i64) -> str {
    var out = str_builder()
    // Scalars boxed in lists, so the comparison is the runtime's.
    let i1 = [pick(s, 3), pick(s, 3)]
    let i2 = [pick(s, 3), pick(s, 3)]
    out.push_str("{b(i1 == i2)}")
    let u1 = [pick(s, 3).as_u64()]
    let u2 = [pick(s, 3).as_u64()]
    out.push_str("{b(u1 == u2)}")
    let f1 = [float(s), float(s)]
    let f2 = [float(s), float(s)]
    out.push_str("{b(f1 == f2)}")
    let fb1 = [pick(s, 2) == 0]
    let fb2 = [pick(s, 2) == 0]
    out.push_str("{b(fb1 == fb2)}")
    let w1 = word(s)
    let w2 = word(s)
    out.push_str("{b([w1] == [w2])}{w1.cmp(w2)}")
    let ws1 = words(s)
    let ws2 = words(s)
    out.push_str("{b(ws1 == ws2)}")
    let nest1 = [ints(s), ints(s)]
    let nest2 = [ints(s), ints(s)]
    out.push_str("{b(nest1 == nest2)}")
    // The same list held as scalars and, from a map's keys, as boxes.
    var m: Map[i64, str] = {}
    for i in 0..pick(s, 4) {
        m.set(pick(s, 4), word(s))
    }
    let keys = m.keys()
    let lit = ints(s)
    out.push_str("{b(keys == lit)}{b(lit == keys)}")
    var m2: Map[i64, str] = {}
    for i in 0..pick(s, 4) {
        m2.set(pick(s, 4), word(s))
    }
    out.push_str("{b(m == m2)}")
    var fm1: Map[str, f64] = {}
    var fm2: Map[str, f64] = {}
    for i in 0..pick(s, 3) {
        fm1.set(word(s), float(s))
        fm2.set(word(s), float(s))
    }
    out.push_str("{b(fm1 == fm2)}")
    // Tuples, compared and ordered.
    let t1 = (pick(s, 3), word(s), float(s))
    let t2 = (pick(s, 3), word(s), float(s))
    out.push_str("{b(t1 == t2)}{b(t1 < t2)}{b(t1 <= t2)}")
    let tt1 = ((pick(s, 2), word(s)), pick(s, 2).as_u64())
    let tt2 = ((pick(s, 2), word(s)), pick(s, 2).as_u64())
    out.push_str("{b(tt1 == tt2)}{b(tt1 < tt2)}{tt1.cmp(tt2)}")
    let fl1 = float(s)
    let fl2 = float(s)
    out.push_str("{fl1.cmp(fl2)}")
    let n1 = pick(s, 5) - 2
    out.push_str("{n1.cmp(pick(s, 5) - 2)}")
    let un1 = pick(s, 5).as_u64()
    out.push_str("{un1.cmp(pick(s, 5).as_u64())}")
    // Options and enums with payloads.
    let o1 = if pick(s, 3) == 0 { None } else { Some(words(s)) }
    let o2 = if pick(s, 3) == 0 { None } else { Some(words(s)) }
    out.push_str("{b(o1 == o2)}")
    let sh1 = shape(s)
    let sh2 = shape(s)
    out.push_str("{b(sh1 == sh2)}")
    // Structs: float fields, and a struct within one.
    let p1 = pt(s)
    let p2 = pt(s)
    out.push_str("{b(p1 == p2)}")
    let bx1 = Box3{ a: pick(s, 2), b: words(s), c: pt(s) }
    let bx2 = Box3{ a: pick(s, 2), b: words(s), c: pt(s) }
    out.push_str("{b(bx1 == bx2)}")
    // Ranges, bytes, units.
    let r1 = pick(s, 3)..pick(s, 3)
    let r2 = pick(s, 3)..pick(s, 3)
    let r3 = pick(s, 3)..=pick(s, 3)
    out.push_str("{b([r1] == [r2])}{b([r1] == [r3])}")
    let by1 = bytes_of(ints(s))
    let by2 = bytes_of(ints(s))
    out.push_str("{b(by1 == by2)}")
    let us1 = [(), ()]
    let us2: [()] = if pick(s, 2) == 0 { [()] } else { [(), ()] }
    out.push_str("{b(us1 == us2)}")
    // Function values: named, and closures over what they captured.
    let fs1 = [double, if pick(s, 2) == 0 { double } else { triple }]
    let fs2 = [double, if pick(s, 2) == 0 { double } else { triple }]
    out.push_str("{b(fs1 == fs2)}")
    let cap1 = words(s)
    let cap2 = if pick(s, 2) == 0 { cap1 } else { words(s) }
    let c1 = |x| x + cap1.len()
    let c2 = |x| x + cap2.len()
    out.push_str("{b([c1] == [c2])}{b([c1] == [c1])}")
    let k1 = counter(cap1)
    let k2 = counter(if pick(s, 2) == 0 { cap1 } else { words(s) })
    out.push_str("{b([k1] == [k2])}")
    out.to_str()
}

fn main() {
    let a = args()
    var s = (a[0].parse_int() ?? 1) * 7919 + 29
    let rounds = a[1].parse_int() ?? 10
    for r in 0..rounds {
        print(round(s))
    }
}
