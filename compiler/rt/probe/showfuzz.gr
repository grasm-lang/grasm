// Values as text on the Grasm runtime against the Rust runtime's
// (docs/self-hosting.md §6.11), for `scripts/fuzz_rtshow.sh`, which builds
// this twice -- on the Rust runtime and with the Grasm runtime interposed --
// and requires the same bytes out.
//
//     showfuzz <seed> <rounds>
//
// Each round makes random values of every kind `print` and interpolation
// show -- integers, `u64`s, floats (NaN, the infinities, both zeros, the
// extremes), booleans, strings short, long and not ASCII, lists of every
// scalar and of strings, nested lists, tuples, `Option`s and enums with
// payloads, maps keyed by every kind of key, structs with scalar and boxed
// fields, value structs in lists (inline strings and lists among their
// fields), ranges, `bytes` and both builders, units, function values named
// and closed over, and handler values -- and prints each, and each
// interpolated into a string, and the length of what it made. `print` of a
// boxed value calls `grasm_out_val` and interpolation `grasm_str_from_val`.

type Pt = { x: f64, y: f64, tag: str }
type Wide = { a: str, b: i64, c: f64, d: [str], e: bool, f: u64 }
type Cell = { name: str, nums: [i64], k: i64 }
type Shape = | Circle(r: f64) | Rect(w: f64, h: f64) | Dot

effect Ask {
    fn word() -> str
    fn num() -> i64
}

fn next(inout s: i64) -> i64 {
    s = s * 6364136223846793005 + 1442695040888963407
    s.ushr(17)
}

fn pick(inout s: i64, n: i64) -> i64 {
    next(s) % n
}

fn float(inout s: i64) -> f64 {
    let k = pick(s, 10)
    if k == 0 {
        return 0.0 / 0.0
    }
    if k == 1 {
        return 0.0 * -1.0
    }
    if k == 2 {
        return 1.0 / 0.0
    }
    if k == 3 {
        return -1.0 / 0.0
    }
    if k == 4 {
        return 1.0e300 * 1.0e10
    }
    if k == 5 {
        return 123456789.125
    }
    if k == 6 {
        return 1.0e-7
    }
    (pick(s, 9) - 4).as_f64() / 4.0
}

fn word(inout s: i64) -> str {
    let k = pick(s, 6)
    if k == 0 {
        return ""
    }
    if k == 1 {
        return "a b"
    }
    if k == 2 {
        return "naïve, quoted \"text\""
    }
    if k == 3 {
        return "a long string past the inline capacity of a box, with more"
    }
    if k == 4 {
        return "\{braces} and [brackets]"
    }
    "é✓"
}

fn ints(inout s: i64) -> [i64] {
    var out: [i64] = []
    for i in 0..pick(s, 5) {
        out.push(pick(s, 2001) - 1000)
    }
    out
}

fn words(inout s: i64) -> [str] {
    var out: [str] = []
    for i in 0..pick(s, 4) {
        out.push(word(s))
    }
    out
}

fn shape(inout s: i64) -> Shape {
    let k = pick(s, 3)
    if k == 0 {
        return Circle(float(s))
    }
    if k == 1 {
        return Rect(float(s), float(s))
    }
    Dot
}

fn double(x: i64) -> i64 {
    2 * x
}

fn round(inout s: i64) -> i64 {
    var made = 0
    let i1 = [pick(s, 1000) - 500, -9223372036854775807 - 1, 9223372036854775807]
    print(i1)
    let u1 = [pick(s, 3).as_u64(), 18446744073709551615]
    print(u1)
    let f1 = [float(s), float(s), float(s)]
    print(f1)
    let b1 = [pick(s, 2) == 0, true]
    print(b1)
    let w1 = words(s)
    print(w1)
    let nest = [ints(s), ints(s), []]
    print(nest)
    let t1 = (pick(s, 3), word(s), float(s), (pick(s, 2) == 0, words(s)))
    print(t1)
    let o1 = if pick(s, 3) == 0 { None } else { Some(words(s)) }
    print(o1)
    let o2: Option[i64] = if pick(s, 2) == 0 { None } else { Some(pick(s, 9)) }
    print(o2)
    let sh = [shape(s), shape(s)]
    print(sh)
    var mi: Map[i64, str] = {}
    var ms: Map[str, f64] = {}
    var mt: Map[(i64, str), [i64]] = {}
    var mb: Map[bool, u64] = {}
    for i in 0..pick(s, 5) {
        mi.set(pick(s, 20) - 10, word(s))
        ms.set(word(s), float(s))
        mt.set((pick(s, 3), word(s)), ints(s))
        mb.set(pick(s, 2) == 0, pick(s, 9).as_u64())
    }
    print(mi)
    print(ms)
    print(mt)
    print(mb)
    let p = Pt{ x: float(s), y: float(s), tag: word(s) }
    let w = Wide{ a: word(s), b: pick(s, 9), c: float(s), d: words(s), e: pick(s, 2) == 0, f: pick(s, 9).as_u64() }
    print([p])
    print([w])
    var cells: [Cell] = []
    for i in 0..pick(s, 3) {
        cells.push(Cell{ name: word(s), nums: ints(s), k: i })
    }
    print(cells)
    let r1 = pick(s, 9) - 4..pick(s, 9)
    let r2 = pick(s, 9)..=pick(s, 99)
    print([r1, r1])
    print(r2)
    let by = bytes_of([pick(s, 256), 0, 255, 16])
    print(by)
    var bb = byte_builder()
    for i in 0..pick(s, 5) {
        bb.push_byte(pick(s, 256))
    }
    print([bb.len()])
    var sb = str_builder()
    sb.push_str(word(s))
    print([sb.to_str()])
    print([(), ()])
    let fs = [double, |x| x + w1.len()]
    print(fs)
    let h = AskHandler{ word: || "w", num: || 3 }
    print([h])
    // Interpolated, each: `str_from_val`, and the length of what it made.
    let line = "{i1} {u1} {f1} {b1} {w1} {nest} {t1} {o1} {o2} {sh} {mi} {ms} {mt} {mb} {[p]} {cells} {[r1]} {by} {fs}"
    print(line)
    made += line.len() + line.byte_len()
    made
}

fn main() {
    let a = args()
    var s = (a[0].parse_int() ?? 1) * 7919 + 31
    let rounds = a[1].parse_int() ?? 10
    var total = 0
    for r in 0..rounds {
        total += round(s)
    }
    print("made {total}")
}
