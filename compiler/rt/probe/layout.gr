        let fn2 = grasm_fn_new(4242, envbox, names, 2)
        let env_at = find_word(fn2, 16, 6, envbox.as_i64())
        say("FN_ENV", if env_at >= 0 { 16 + env_at } else { -1 })
        say("FN_CODE", word_at(fn2, 16, 6, 4242))
        let nm = fn2.offset(32)
        let named = nm.offset(len_at).load_i64() == 2 and mem_addr(nm.offset(ptr_at).load_i64()).offset(1).load_u8().as_i64() == 65
        say("FN_NAME", if named { 32 } else { -1 })
        say("FN_NAME_NONE", if named and none != nm.offset(cap_at).load_i64() and none < 0 { none } else { 0 })
        grasm_val_dec(fn2)

        // A range, as the Rust runtime reads one. No program can make one
        // through an entry point it may declare (`grasm_range_new` takes an
        // `i8`), so a box is made by hand: the payload tag the declaration's
        // order gives -- a wrong one would end the probe in a panic -- and a
        // distinct word at every place a field could be, asked for its start
        // and end. Then, with only those two set, its length with each other
        // byte set to 1 in turn: the one that adds an element is `inclusive`.
        let rg = malloc(64)
        var ro = 0
        while ro < 64 {
            rg.offset(ro).store_i64(0)
            ro += 8
        }
        rg.store_i64(1)
        rg.offset(8).store_u8(8.as_u8())
        ro = 16
        while ro < 64 {
            rg.offset(ro).store_i64(1000 * ro)
            ro += 8
        }
        let rs = grasm_range_start(rg)
        let re = grasm_range_end(rg)
        let rs_at = if rs % 1000 == 0 and rs >= 16000 and rs < 64000 { rs / 1000 } else { -1 }
        let re_at = if re % 1000 == 0 and re >= 16000 and re < 64000 { re / 1000 } else { -1 }
        say("TAG_RANGE", if rs_at > 0 and re_at > 0 { 8 } else { -1 })
        say("RANGE_START", rs_at)
        say("RANGE_END", re_at)
        ro = 16
        while ro < 64 {
            if ro != rs_at and ro != re_at {
                rg.offset(ro).store_i64(0)
            }
            ro += 8
        }
        let span = grasm_range_len(rg)
        var incl_at = -1
        var rb = 9
        while rb < 64 {
            let inside = (rs_at >= 0 and rb >= rs_at and rb < rs_at + 8) or (re_at >= 0 and rb >= re_at and rb < re_at + 8)
            if not inside {
                rg.offset(rb).store_u8(1.as_u8())
                if grasm_range_len(rg) == span + 1 and incl_at < 0 {
                    incl_at = rb
                }
                rg.offset(rb).store_u8(0.as_u8())
            }
            rb += 1
        }
        say("RANGE_INCL", incl_at)
        free(rg)

        measure_maps(cap_at, ptr_at, len_at)
        measure_structs(cap_at, ptr_at, len_at)
    }
}
