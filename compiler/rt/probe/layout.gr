// Measures the layouts `compiler/rt/src/layout.gr` writes down, in a program
// linked with the Rust runtime (docs/self-hosting.md §6.7): it makes values
// through the runtime's own C entry points and reads their bytes. One line
// per constant, `NAME value`; `scripts/rtlayout.sh` compares the two by name.
//
//     grasm build compiler/rt/probe/layout.gr --native -o probe && ./probe
//
// Built and linked as any program is, never with the Grasm runtime
// interposed: what it measures is the Rust runtime.

extern fn grasm_box_i64(v: i64) -> addr
extern fn grasm_box_f64(v: f64) -> addr
extern fn grasm_box_unit() -> addr
extern fn grasm_box_ref(v: i64) -> addr
extern fn grasm_box_u64(v: i64) -> addr
extern fn grasm_str_lit(p: addr, n: i64) -> addr
extern fn grasm_str_lit_immortal(p: addr, n: i64) -> addr
extern fn grasm_str_len(v: addr) -> i64
extern fn grasm_str_build() -> i64
extern fn grasm_str_build_text(at: i64, p: i64, n: i64)
extern fn grasm_str_build_end(at: i64) -> addr
extern fn grasm_list_new_scalar(kind: i64) -> addr
extern fn grasm_list_push_scalar(l: addr, bits: i64, kind: i64) -> addr
extern fn grasm_list_new() -> addr
extern fn grasm_list_push(l: addr, v: addr) -> addr
extern fn grasm_tuple2(a: addr, b: addr) -> addr
extern fn grasm_map_new() -> addr
extern fn grasm_bytes_filled(n: i64, b: i64) -> addr
extern fn grasm_strbuf_new() -> addr
extern fn grasm_bytebuf_new() -> addr
extern fn grasm_variant_new(tp: addr, tl: i64, vp: addr, vl: i64) -> addr
extern fn grasm_fn_new(code: i64, env: addr, np: addr, nl: i64) -> addr
extern fn grasm_region_push()
extern fn grasm_region_pop()
extern fn grasm_val_dec(v: addr)
extern fn grasm_builder_push_str(b: addr, s: addr) -> addr
extern fn grasm_bytebuf_push_byte(b: addr, x: i64) -> addr
extern fn grasm_variant_new1(tp: addr, tl: i64, vp: addr, vl: i64, a: addr) -> addr
extern fn grasm_variant_new2(tp: addr, tl: i64, vp: addr, vl: i64, a: addr, b: addr) -> addr
extern fn grasm_map_set(m: addr, k: addr, v: addr) -> addr
extern fn grasm_val_inc(v: addr)
extern fn grasm_struct_make(desc: addr, argv: addr) -> addr
extern fn grasm_struct_get_at(s: addr, i: i64) -> addr
extern fn grasm_vals_new(desc: addr) -> addr
extern fn grasm_vals_push(l: addr, src: addr) -> addr
extern fn grasm_vals_at(l: addr, i: i64) -> addr
extern fn grasm_val_dup(desc: addr, p: addr)
extern fn grasm_val_release(desc: addr, p: addr)
extern fn grasm_env_new(n: i64) -> addr
extern fn grasm_env_data(e: addr) -> addr
extern fn grasm_handler_new(p: addr, n: i64) -> addr
extern fn grasm_handler_add(h: addr, p: addr, n: i64, code: i64, env: addr)
extern fn grasm_range_start(r: addr) -> i64
extern fn grasm_range_end(r: addr) -> i64
extern fn grasm_range_len(r: addr) -> i64
extern fn malloc(n: i64) -> addr
extern fn free(p: addr)
extern fn malloc_size(p: addr) -> i64

fn say(name: str, v: i64) {
    print("{name} {v}")
}

/// The offset of the first of words `at .. at + n*8` that holds `want`, or -1.
fn find_word(a: addr, from: i64, n: i64, want: i64) -> i64 / {unsafe, mem} {
    var k = 0
    while k < n {
        if unsafe { a.offset(from + 8 * k).load_i64() } == want {
            return 8 * k
        }
        k += 1
    }
    -1
}

/// The offset of the first byte in `at .. at + n` equal to `want`, or -1.
fn find_byte(a: addr, from: i64, n: i64, want: i64) -> i64 / {unsafe, mem} {
    var k = 0
    while k < n {
        if unsafe { a.offset(from + k).load_u8() }.as_i64() == want {
            return from + k
        }
        k += 1
    }
    -1
}

/// `n` bytes of the letter `c` in fresh memory.
fn letters(c: i64, n: i64) -> addr / {unsafe, mem} {
    let t = unsafe { mem_alloc(n + 8, 8) }
    var k = 0
    while k < n {
        unsafe { t.offset(k).store_u8(c.as_u8()) }
        k += 1
    }
    t
}

/// The byte offset of the first of `n` words from `a + from` that holds
/// `want`, counted from `a`; or -1.
fn word_at(a: addr, from: i64, n: i64, want: i64) -> i64 / {unsafe, mem} {
    let o = find_word(a, from, n, want)
    if o < 0 { -1 } else { from + o }
}

/// A struct descriptor laid out as the backend writes one (`StructDesc`,
/// `repr(C)`): the cache word, the type's name, the field count, a (name,
/// length, kind) triple per field, then a word per field -- an inline value
/// list's element descriptor, or 0.
fn desc(kinds: [i64], aux: [i64]) -> addr / {unsafe, mem} {
    let n = kinds.len()
    let d = unsafe { mem_alloc(32 + 32 * n + 8, 8) }
    unsafe {
        d.offset(8).store_addr(letters(84, 1))
        d.offset(16).store_i64(1)
        d.offset(24).store_i64(n)
    }
    var i = 0
    while i < n {
        unsafe {
            d.offset(32 + 24 * i).store_addr(letters(97 + i, 1))
            d.offset(40 + 24 * i).store_i64(1)
            d.offset(48 + 24 * i).store_i64(kinds[i])
            d.offset(32 + 24 * n + 8 * i).store_i64(aux[i])
        }
        i += 1
    }
    d
}

/// Whether `n` bytes at `p` are `want`'s, in order.
fn bytes_are(p: addr, want: [i64]) -> bool / {unsafe, mem} {
    var i = 0
    while i < want.len() {
        if unsafe { p.offset(i).load_u8() }.as_i64() != want[i] {
            return false
        }
        i += 1
    }
    true
}

/// The `Vec` among `n` words from `a + from` whose length is `len` and whose
/// first element (a byte when `bytes`, else a word) is `first`: its offset
/// from `a`, or -1. `skip` is an offset not to answer.
fn vec_at(a: addr, from: i64, n: i64, cap_at: i64, ptr_at: i64, len_at: i64, len: i64, bytes: bool, first: i64, skip: i64) -> i64 / {io, unsafe, mem} {
    var o = from
    while o + 24 <= from + 8 * n {
        if o != skip {
            let l = unsafe { a.offset(o + len_at).load_i64() }
            let c = unsafe { a.offset(o + cap_at).load_i64() }
            let p = unsafe { a.offset(o + ptr_at).load_i64() }
            if l == len and c >= len and p > 4294967296 and unsafe { malloc_size(mem_addr(p)) } > 0 {
                let got = if bytes { unsafe { mem_addr(p).load_u8() }.as_i64() } else { unsafe { mem_addr(p).load_i64() } }
                if got == first {
                    return o
                }
            }
        }
        o += 8
    }
    -1
}

/// Maps: a `hashbrown` table of `(MapKey, *mut RtVal)` with the process's
/// seed, at 16 in the box (`Map(MapTable)`).
fn measure_maps(cap_at: i64, ptr_at: i64, len_at: i64) / {io, unsafe, mem} {
    unsafe {
        // Five integer keys: eight buckets (mask 7), room for two more
        // (growth_left 2), five items.
        var m = grasm_map_new()
        var held: [i64] = []
        var k = 0
        while k < 5 {
            let v = grasm_box_f64(1.5)
            held.push(v.as_i64())
            m = grasm_map_set(m, grasm_box_i64(100000 + k), v)
            k += 1
        }
        let mask_at = word_at(m, 16, 5, 7)
        let growth_at = word_at(m, 16, 5, 2)
        let items_at = word_at(m, 16, 5, 5)
        // The control bytes: eight, five of them full (top bit clear), and the
        // eight after them a copy of the first eight.
        var ctrl_at = -1
        var o = 16
        while o < 56 {
            let p = m.offset(o).load_i64()
            // The seed is a word too, and may look like an address: only one
            // that ends eight entries of a `malloc` block is read.
            if p > 4294967296 and o != mask_at and o != growth_at and o != items_at and malloc_size(mem_addr(p - 256)) > 0 {
                let c = mem_addr(p)
                var full = 0
                var same = true
                var b = 0
                while b < 8 {
                    if c.offset(b).load_u8().as_i64() < 128 {
                        full += 1
                    }
                    if c.offset(b).load_u8() != c.offset(8 + b).load_u8() {
                        same = false
                    }
                    b += 1
                }
                if full == 5 and same {
                    ctrl_at = o
                }
            }
            o += 8
        }
        say("MAP_CTRL", ctrl_at)
        say("MAP_MASK", mask_at)
        say("MAP_GROWTH", growth_at)
        say("MAP_ITEMS", items_at)
        let ctrl = mem_addr(m.offset(ctrl_at).load_i64())
        // The entries count down from the control bytes, bucket i's at
        // ctrl - (i + 1) * size: the size and the value's place are those
        // for which every full bucket holds one of the five values.
        var entry = -1
        var val_at = -1
        var size = 16
        while size <= 64 and entry < 0 {
            var v = 0
            while v < size and entry < 0 {
                var good = true
                var i = 0
                while i < 8 {
                    if ctrl.offset(i).load_u8().as_i64() < 128 {
                        let w = ctrl.offset(-(i + 1) * size + v).load_i64()
                        if not held.contains(w) {
                            good = false
                        }
                    }
                    i += 1
                }
                if good {
                    entry = size
                    val_at = v
                }
                v += 8
            }
            size += 8
        }
        say("MAP_ENTRY", entry)
        say("MAP_ENTRY_VAL", val_at)
        // The key: its integer, and before it a word the same in all five.
        var int_at = -1
        var tag_at = -1
        var w = 0
        while w < entry {
            var ints = true
            var same = true
            var first = 0
            var seen = false
            var i = 0
            while i < 8 {
                if ctrl.offset(i).load_u8().as_i64() < 128 {
                    let x = ctrl.offset(-(i + 1) * entry + w).load_i64()
                    if x < 100000 or x > 100004 {
                        ints = false
                    }
                    if seen and x != first {
                        same = false
                    }
                    first = x
                    seen = true
                }
                i += 1
            }
            if ints and int_at < 0 {
                int_at = w
            }
            if same and w != val_at and tag_at < 0 {
                tag_at = w
            }
            w += 8
        }
        say("MAPKEY_AT", if tag_at == 0 { int_at } else { -1 })
        // The table's allocation starts at its first bucket's entry, below
        // the last: `malloc` knows it, with the control bytes in it.
        let base = ctrl.offset(-8 * entry)
        let room = malloc_size(base)
        // The seed: the word left, the same in every map of the process.
        var seed_at = -1
        o = 16
        while o < 56 {
            if o != ctrl_at and o != mask_at and o != growth_at and o != items_at {
                seed_at = o
            }
            o += 8
        }
        let m2 = grasm_map_new()
        say("MAP_SEED", if m2.offset(seed_at).load_i64() == m.offset(seed_at).load_i64() { seed_at } else { -1 })
        grasm_val_dec(m2)
        grasm_val_dec(m)

        // One key of each kind, alone in a table of four buckets.
        var tags: [i64] = []
        var key_bytes = -1
        var key_len = -1
        var heap = false
        var bool_at = -1
        var kind = 0
        while kind < 6 {
            let key = if kind == 0 {
                grasm_box_i64(777777)
            } else if kind == 1 {
                grasm_box_u64(888888)
            } else if kind == 2 {
                // "abcde", inline in the key.
                let t = letters(97, 5)
                t.offset(1).store_u8(98)
                t.offset(2).store_u8(99)
                t.offset(3).store_u8(100)
                t.offset(4).store_u8(101)
                grasm_str_lit(t, 5)
            } else if kind == 3 {
                grasm_str_lit(letters(65, 30), 30)
            } else if kind == 4 {
                grasm_tuple2(grasm_box_i64(5555), grasm_str_lit(letters(97, 3), 3))
            } else {
                // `true`, the interned box before -128's.
                grasm_box_i64(-128).offset(-64)
            }
            let m1 = grasm_map_set(grasm_map_new(), key, grasm_box_f64(2.5))
            let c1 = mem_addr(m1.offset(ctrl_at).load_i64())
            var at = -1
            var i = 0
            while i < 4 {
                if c1.offset(i).load_u8().as_i64() < 128 {
                    at = i
                }
                i += 1
            }
            let e = c1.offset(-(at + 1) * entry)
            tags.push(e.load_i64())
            if kind == 0 {
                // The group: a table of four buckets keeps its control bytes'
                // first `width` again after its own, starting at `4`; the
                // full bucket's byte comes back at `width + at`.
                var j = 4
                var group = -1
                while j < 40 and group < 0 {
                    if j != at and c1.offset(j).load_u8() == c1.offset(at).load_u8() {
                        group = j - at
                    }
                    j += 1
                }
                say("MAP_GROUP", if room >= 8 * entry + 8 + group { group } else { -1 })
            }
            if kind == 4 {
                // The tuple's components: a boxed slice of keys, its pointer
                // and its length, each key `size` bytes.
                let tl = word_at(e, 8, 2, 2)
                let tp = if tl == 16 { 8 } else { 16 }
                let slice = mem_addr(e.offset(tp).load_i64())
                say("MAPKEY_TUPLE_PTR", tp)
                say("MAPKEY_TUPLE_LEN", tl)
                var sz = -1
                var s = 16
                while s <= 48 {
                    if slice.load_i64() == tags[0] and slice.offset(8).load_i64() == 5555 and slice.offset(s).load_i64() == tags[2] and slice.offset(s + 8).load_u8().as_i64() == 97 {
                        sz = s
                    }
                    s += 8
                }
                say("MAPKEY_SIZE", sz)
            }
            if kind == 2 {
                key_bytes = find_byte(e, 0, 24, 97)
                key_len = find_byte(e, 9, 15, 5)
            }
            if kind == 3 {
                // A long key is a `String` of its own where the others' tag
                // is: its capacity, never negative.
                heap = e.offset(len_at).load_i64() == 30 and e.offset(cap_at).load_i64() >= 30 and mem_addr(e.offset(ptr_at).load_i64()).load_u8().as_i64() == 65
            }
            if kind == 5 {
                bool_at = find_byte(e, 8, 8, 1)
            }
            grasm_val_dec(m1)
            kind += 1
        }
        say("MAPKEY_I64", tags[0])
        say("MAPKEY_U64", tags[1])
        say("KEYSTR_INLINE", tags[2])
        say("MAPKEY_TUPLE", tags[4])
        say("MAPKEY_BOOL", tags[5])
        say("KEYSTR_BYTES", key_bytes)
        say("KEYSTR_LEN", key_len)
        say("KEYSTR_STRING", if heap and tags[3] >= 0 and tags[0] < 0 and tags[1] < 0 and tags[2] < 0 and tags[4] < 0 and tags[5] < 0 { 0 } else { -1 })
        say("MAPKEY_BOOL_AT", bool_at)
    }
}

/// Structs, value lists, environments and handlers.
fn measure_structs(cap_at: i64, ptr_at: i64, len_at: i64) / {io, unsafe, mem} {
    unsafe {
        // Which kind is a box: a struct of one field of kind k holding a box
        // the probe keeps a count on, released with the struct only for that
        // kind.
        var boxed = -1
        var k = 0
        while k < 10 {
            let x = grasm_box_f64(9.5)
            grasm_val_inc(x)
            let argv = mem_alloc(8, 8)
            argv.store_addr(x)
            let s = grasm_struct_make(desc([k], [0]), argv)
            grasm_val_dec(s)
            if x.load_i64() == 1 {
                boxed = if boxed == -1 { k } else { -2 }
            } else {
                grasm_val_dec(x)
            }
            grasm_val_dec(x)
            k += 1
        }
        say("FK_BOXED", boxed)
        // Which kind is a float: a field of that kind holding 1.5's bits comes
        // back from `struct_get_at` boxed as one.
        // And which kind is a float, a bool, a reference, a unit or a `u64`:
        // a field of that kind comes back from `struct_get_at` boxed as one
        // (1.5's bits, or 1); every other scalar kind comes back an integer.
        var float_kind = -1
        var bool_kind = -1
        var ref_kind = -1
        var unit_kind = -1
        var u64_kind = -1
        k = 0
        while k < 10 {
            if k != boxed {
                for bits in [0, 1] {
                    let argv = mem_alloc(8, 8)
                    if bits == 0 {
                        argv.store_f64(1.5)
                    } else {
                        argv.store_i64(1)
                    }
                    let s = grasm_struct_make(desc([k], [0]), argv)
                    let b = grasm_struct_get_at(s, 0)
                    let t = b.offset(8).load_u8().as_i64()
                    if bits == 0 and t == 3 and b.offset(16).load_f64() == 1.5 {
                        float_kind = if float_kind == -1 { k } else { -2 }
                    }
                    if bits == 1 and t == 4 and b.offset(9).load_u8().as_i64() == 1 {
                        bool_kind = if bool_kind == -1 { k } else { -2 }
                    }
                    if bits == 1 and t == 2 and b.offset(16).load_i64() == 1 {
                        ref_kind = if ref_kind == -1 { k } else { -2 }
                    }
                    if bits == 1 and t == 1 {
                        unit_kind = if unit_kind == -1 { k } else { -2 }
                    }
                    if bits == 1 and t == 18 and b.offset(16).load_i64() == 1 {
                        u64_kind = if u64_kind == -1 { k } else { -2 }
                    }
                    grasm_val_dec(b)
                    grasm_val_dec(s)
                }
            }
            k += 1
        }
        say("FK_F64", float_kind)
        say("FK_BOOL", bool_kind)
        say("FK_REF", ref_kind)
        say("FK_UNIT", unit_kind)
        say("FK_U64", u64_kind)

        // A value list of six fields of kinds 0 7 1 2 8 6, whose second is a
        // list of values of a one-field type.
        let ed = desc([1], [0])
        let d6 = desc([0, 7, 1, 2, 8, 6], [0, ed.as_i64(), 0, 0, 0, 0])
        let l = grasm_vals_new(d6)
        let ty = mem_addr(d6.load_i64())
        say("DESC_CACHE", if ty.as_i64() != 0 and l.offset(16).load_i64() == ty.as_i64() { 0 } else { -1 })
        say("VALS_TY", if l.offset(16).load_i64() == ty.as_i64() { 16 } else { -1 })
        say("TAG_LIST_VALS", l.offset(8).load_u8().as_i64())
        // Its kinds and its element descriptors, two `Vec`s of six in the
        // `StructTy` the descriptor now caches.
        var kinds_at = -1
        var elems_at = -1
        var o = 0
        while o + 24 <= 160 {
            let p = mem_addr(ty.offset(o + ptr_at).load_i64())
            if ty.offset(o + len_at).load_i64() == 6 and p.as_i64() > 4294967296 and malloc_size(p) > 0 {
                if bytes_are(p, [0, 7, 1, 2, 8, 6]) {
                    kinds_at = o
                }
                if p.load_i64() == 0 and p.offset(8).load_i64() == ed.as_i64() and p.offset(16).load_i64() == 0 {
                    elems_at = o
                }
            }
            o += 8
        }
        say("STRUCTTY_KINDS", kinds_at)
        say("STRUCTTY_ELEMS", elems_at)
        // The type's name, a `&str`: the descriptor's name, one byte.
        let tname = d6.offset(8).load_i64()
        let name_at = word_at(ty, 0, 20, tname)
        say("STRUCTTY_NAME", if name_at >= 0 and ty.offset(name_at + 8).load_i64() == 1 { name_at } else { -1 })
        // Its field names, a `Vec<&str>` of six: the first the descriptor's
        // first field's name.
        var fields_at = -1
        let fname = d6.offset(32).load_i64()
        o = 0
        while o + 24 <= 160 {
            let p = mem_addr(ty.offset(o + ptr_at).load_i64())
            if ty.offset(o + len_at).load_i64() == 6 and p.as_i64() > 4294967296 and malloc_size(p) > 0 {
                if p.load_i64() == fname and p.offset(8).load_i64() == 1 {
                    fields_at = o
                }
            }
            o += 8
        }
        say("STRUCTTY_FIELDS", fields_at)
        // Where each field starts, in words: a `Vec<usize>` of 0 1 4 5 6 9
        // for kinds of widths 1 3 1 1 3 3; and the twelve words a value takes;
        // and whether any field is inline, a byte.
        var offs_at = -1
        o = 0
        while o + 24 <= 160 {
            let p = mem_addr(ty.offset(o + ptr_at).load_i64())
            if ty.offset(o + len_at).load_i64() == 6 and p.as_i64() > 4294967296 and malloc_size(p) > 0 {
                if p.load_i64() == 0 and p.offset(8).load_i64() == 1 and p.offset(16).load_i64() == 4 and p.offset(40).load_i64() == 9 {
                    offs_at = o
                }
            }
            o += 8
        }
        say("STRUCTTY_OFFS", offs_at)
        // The words after the four `Vec`s and the name.
        let tail = name_at + 16
        say("STRUCTTY_WIDTH", word_at(ty, tail, 4, 12))
        say("STRUCTTY_INLINE", find_byte(ty, tail + 24, 8, 1))
        // The shared empty list of the type, a `OnceLock<usize>`: its value
        // and, beside it, its state -- UNSET before the first `vals_new` on
        // a fresh type, READY after.
        let dq = desc([1, 1], [0, 0])
        let argq = mem_alloc(16, 8)
        let sq = grasm_struct_make(dq, argq)
        let tq = mem_addr(dq.load_i64())
        var before: [i64] = []
        var j = 0
        while j < 32 {
            before.push(tq.offset(tail + j).load_u8().as_i64())
            j += 1
        }
        let eq = grasm_vals_new(dq)
        let value_at = word_at(tq, tail, 4, eq.as_i64())
        var state_at = -1
        j = 0
        while j < 32 {
            let now = tq.offset(tail + j).load_u8().as_i64()
            if now != before[j] and (tail + j < value_at or tail + j >= value_at + 8) {
                state_at = tail + j
            }
            j += 1
        }
        say("STRUCTTY_EMPTY", value_at)
        say("STRUCTTY_EMPTY_STATE", state_at)
        say("ONCE_UNSET", if state_at >= 0 { before[state_at - tail] } else { -1 })
        say("ONCE_READY", if state_at >= 0 { tq.offset(state_at).load_u8().as_i64() } else { -1 })
        // Its size: the fields found, laid end to end with nothing between
        // them (four `Vec`s, the name, the empty list, the width, the flag),
        // rounded to a word -- `malloc` rounds what it hands out too far to
        // say it.
        let flag_at = find_byte(ty, tail + 24, 8, 1)
        let tiled = fields_at == 0 and kinds_at == 24 and offs_at == 48 and elems_at == 72 and name_at == 96 and value_at == 112 and state_at == 120 and word_at(ty, tail, 4, 12) == 128 and flag_at == 136
        say("STRUCTTY_SIZE", if tiled { (flag_at + 8) / 8 * 8 } else { -1 })
        grasm_val_dec(sq)
        // The descriptor read where it was written: the count at 24, the
        // triples from 32, 24 bytes each, the kind third.
