        say("OP_SIZE", opsize)
        say("OP_CODE", code0)
        say("OP_ENV", word_at(ops.offset(opsize), 0, 5, env.as_i64()))
        say("OP_NAME", vec_at(ops, 0, 5, cap_at, ptr_at, len_at, 2, true, 111, -1))
