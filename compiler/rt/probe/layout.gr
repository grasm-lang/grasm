        grasm_val_dec(l2)

        // A struct box: its type, then `StructFields` -- inline, a length
        // byte and four words, or a `Vec`.
        let a = grasm_box_f64(1.25)
        let b = grasm_box_f64(2.25)
        let argv2 = mem_alloc(16, 8)
        argv2.store_addr(a)
        argv2.offset(8).store_addr(b)
