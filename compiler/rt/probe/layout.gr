        let idisc = s2.offset(24).load_u8().as_i64()
        let hdisc = s6.offset(24).load_u8().as_i64()
        say("STRUCT_DISC", if idisc != hdisc { 24 } else { -1 })
        say("STRUCT_INLINE", idisc)
        say("STRUCT_HEAP", hdisc)
        say("STRUCT_VEC", vec_at(s6, 32, 3, cap_at, ptr_at, len_at, 6, false, a.as_i64(), -1))
        grasm_val_dec(s2)
