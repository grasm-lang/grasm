        while k < 10 {
            let lk = grasm_vals_push(grasm_vals_push(grasm_vals_new(desc([k], [eb.as_i64()])), zero), zero)
            let width = grasm_vals_at(lk, 1).diff(grasm_vals_at(lk, 0)) / 8
            if width == 3 {
                wide.push(k)
