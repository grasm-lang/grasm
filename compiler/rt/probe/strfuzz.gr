// Strings on the Grasm runtime against the Rust runtime's
// (docs/self-hosting.md §6.11), for `scripts/fuzz_rtstrings.sh`, which
// builds this twice -- on the Rust runtime and with the Grasm runtime
// interposed -- and requires the same bytes out and the same way out.
//
//     strfuzz <seed> <rounds> [<panic>]
//
// Each round makes text of ASCII, two-, three- and four-byte characters and
// every kind of whitespace -- some of it long enough to be indexed -- by
// literal, interpolation, `+` and appends in a loop (to a string held once
// and to one shared); cuts it by character and by separator, into lines and
// words; searches, trims, repeats, replaces, pads and changes the case of
// it (a capital sigma in every kind of company); reads its code
// points and turns them back; and writes numbers in bases. With a panic
// number, the run ends in one of the family's panics.

fn next(inout s: i64) -> i64 {
    s = s * 6364136223846793005 + 1442695040888963407
    s.ushr(17)
}

fn pick(inout s: i64, n: i64) -> i64 {
    next(s) % n
}

/// A piece of text, often one that is not a byte.
fn piece(inout s: i64) -> str {
    let pieces = ["a", "b", "ab", " ", "\t", "\n", "\r\n", "é", "✓", "🙂", "語", "\u{a0}", "\u{3000}", "\u{2028}", "\u{85}", "x y", ",", ", ", "", "aa", "\r", "Ω", "Σ", "ΑΣ", "'", "\u{301}", "ß", "İ", "ﬁ", "Ǆ", ".Σ"]
    pieces[pick(s, pieces.len())]
}

fn text(inout s: i64, most: i64) -> str {
    var out = ""
    let n = pick(s, most)
    for i in 0..n {
        out = out + piece(s)
    }
    out
}

/// Only built, read and listed: a value struct, its string inline.
type Tag = { name: str, k: i64 }

fn kind(t: str) -> i64 {
    match t {
        "a" -> 1
        "é" -> 2
        "x y" -> 3
        _ -> 0
    }
}

fn round(inout s: i64) -> str {
    var out = str_builder()
    // Pieces appended to a name: text, integers, floats, bools, strings.
    var line = piece(s)
    let before = line
    for i in 0..pick(s, 9) {
        line = line + "[{i}:{i * 3 - 7}:{0.25 * i.as_f64()}:{i % 2 == 0}:{piece(s)}]"
    }
    // A loop that only appends text and integers: the string held open.
    var pinned = piece(s)
    for i in 0..pick(s, 90) {
        pinned = pinned + "{i}, then a longer piece é"
    }
    // Names that are only map keys, kept as builders.
    var m: Map[str, i64] = {}
    for i in 0..pick(s, 20) {
        let key = "k{i % 5}"
        m.set(key, (m.get(key) ?? 0) + i)
    }
    var tags: [Tag] = []
    for i in 0..pick(s, 6) {
        tags.push(Tag{ name: "t{i}-{piece(s)}", k: kind(piece(s)) })
    }
    out.push_str("{line}|{before}|{pinned.len()}|{pinned.substr(3, 9)}|{m}|")
    for g in tags {
        out.push_str("{g.name}:{g.k} ")
    }
    let t = text(s, 12)
    let u = text(s, 6)
    let sep = piece(s)
    // Interpolated, joined, appended.
    let made = "<{t}|{u}|{t.len()}|{1.5}|{true}>"
    var acc = t
    let shared = acc
    for i in 0..pick(s, 30) {
        acc = acc + piece(s)
        acc = acc + "{i}"
    }
    var grown = ""
    for i in 0..pick(s, 70) {
        grown = grown + "{i % 7}" + piece(s)
    }
    out.push_str("{made}|{acc}|{shared}|{grown.len()}|{grown.byte_len()}|")
    // Cut and searched.
    let big = if pick(s, 3) == 0 { grown + grown + t } else { t }
    let n = big.len()
    let a = pick(s, n + 3) - 1
    let b = pick(s, n + 3) - 1
    out.push_str("{big.substr(a, b)}|{big.index_of(sep)}|{big.index_of(u)}|{big.contains(sep)}|{big.starts_with(u)}|{big.ends_with(sep)}|")
    if n > 0 {
        let i = pick(s, n)
        out.push_str("{big.code_at(i)}|{big.code_at(n - 1)}|")
    }
    out.push_str("{t.chars()}|{t.lines()}|{t.words()}|{t.split(sep)}|{t.codes()}|")
    out.push_str("[{t.trim()}]|[{t.trim_start()}]|[{t.trim_end()}]|{u.repeat(pick(s, 4))}|")
    out.push_str("{t.replace(sep, "#")}|{t.replace("", ".")}|{t.replace(u, sep)}|")
    out.push_str("{t.to_upper()}|{t.to_lower()}|{big.to_lower().len()}|")
    let fill = if pick(s, 2) == 0 { "*" } else { "é-" }
    let w = pick(s, 20) - 3
    out.push_str("[{t.pad_start(w, fill)}]|[{t.pad_end(w, fill)}]|{t.to_bytes().len()}|")
    // Code points back to text, and numbers in bases.
    let c = pick(s, 130000)
    if c < 55296 or c > 57343 {
        out.push_str("{c.to_char()}|")
    }
    let v = pick(s, 2000000) - 1000000
    let base = 2 + pick(s, 35)
    out.push_str("{v.to_base(base)}|{(v * 4611686018427).to_base(base)}|{v.as_u64().to_base(base)}|")
    out.to_str()
}

fn main() {
    let a = args()
    var s = (a[0].parse_int() ?? 1) * 7919 + 43
    let rounds = a[1].parse_int() ?? 10
    for r in 0..rounds {
        print(round(s))
    }
    if a.len() > 2 {
        let k = a[2].parse_int() ?? 0
        let t = "héllo"
        if k == 0 {
            print("{t.code_at(5)}")
        } else if k == 1 {
            print("{t.repeat(-1)}")
        } else if k == 2 {
            print("{t.pad_start(9, "")}")
        } else if k == 3 {
            print("{55296.to_char()}")
        } else if k == 4 {
            print("{12.to_base(37)}")
        } else {
            print("{(0 - 5).as_u64().to_char()}")
        }
    }
}
