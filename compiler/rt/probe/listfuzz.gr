// Lists and ranges on the Grasm runtime against the Rust runtime's
// (docs/self-hosting.md §6.11), for `scripts/fuzz_rtlists.sh`, which builds
// this twice -- on the Rust runtime and with the Grasm runtime interposed --
// and requires the same bytes out and the same way out.
//
//     listfuzz <seed> <rounds> [<panic>]
//
// Each round builds lists of every representation -- integers, floats
// (with -0.0, NaN and the infinities), bools and `u64`s as scalars; strings,
// tuples, options, lists and structs as boxes -- by literal, by push, by
// `map`, `filter` and a filled range; shares them and writes into the copies
// (so a write must copy first and the other must not see it); reads them
// every way there is; sorts, reverses, slices, joins, zips, enumerates,
// searches and sums them; and makes ranges values, forwards and backwards,
// inclusive and not. With a panic number, the run ends in one of the
// family's panics.

type Cell = { name: str, n: i64 }

fn next(inout s: i64) -> i64 {
    s = s * 6364136223846793005 + 1442695040888963407
    s.ushr(17)
}

fn pick(inout s: i64, n: i64) -> i64 {
    next(s) % n
}

fn float(inout s: i64) -> f64 {
    let k = pick(s, 10)
    if k == 0 {
        return 0.0 * -1.0
    }
    if k == 1 {
        return 0.0
    }
    if k == 2 {
        return 1.0 / 0.0
    }
    if k == 3 {
        return -1.0 / 0.0
    }
    if k == 4 {
        return 0.0 / 0.0
    }
    (pick(s, 2001) - 1000).as_f64() / 8.0
}

fn word(inout s: i64) -> str {
    let words = ["", "a", "b", "ab", "ba", "é", "zz", "a b", "Z", "abc"]
    words[pick(s, words.len())]
}

fn ints(inout s: i64) -> [i64] {
    var out: [i64] = []
    let n = pick(s, 40)
    for i in 0..n {
        out.push(pick(s, 21) - 10)
    }
    out
}

fn show_floats(xs: [f64]) -> str {
    xs.map(|x| "{x}").join(",")
}

fn round(inout s: i64) -> str {
    var out = str_builder()
    // Integers: pushed, shared, written, read, sorted.
    var xs = ints(s)
    let kept = xs
    if xs.len() > 0 {
        let i = pick(s, xs.len())
        xs[i] = 99
        out.push_str("{xs[i]} {kept.get(i)} ")
    }
    xs.push(pick(s, 7))
    out.push_str("{xs.len()} {kept.len()} {xs.first()} {xs.last()} {xs.get(pick(s, 50) - 5)} ")
    let popped = xs.pop()
    out.push_str("{popped} {xs.contains(3)} {xs.sum()} {xs.min()} {xs.max()} ")
    if xs.len() > 0 {
        let gone = xs.remove(pick(s, xs.len()))
        out.push_str("{gone} ")
    }
    var sorted = xs
    sorted.sort()
    out.push_str("{sorted} {xs.rev()} {xs.slice(pick(s, 20) - 3, pick(s, 30))} ")
    out.push_str("{xs + sorted} {xs.is_empty()} {kept} ")
    var by = xs
    by.sort_by(|x| x % 3)
    out.push_str("{by} {xs.map(|x| x * 2)} {xs.filter(|x| x > 0)} ")
    out.push_str("{xs.enumerate().len()} {xs.zip(sorted).slice(0, 3)} ")
    out.push_str("{xs.map(|x| "{x}").join("-")} ")
    // A long run of pushes, reserved first.
    var long: [i64] = []
    let m = pick(s, 60)
    for i in 0..m {
        long.push(i * i)
    }
    out.push_str("{long.len()} {long.sum()} ")
    // Indexing in a loop (a pinned list), and writes through it.
    var acc = 0
    var w = long
    for i in 0..w.len() {
        acc += w[i]
        w[i] = w[i] + 1
    }
    out.push_str("{acc} {w.sum()} {long.sum()} ")
    // Floats.
    var fs: [f64] = []
    for i in 0..pick(s, 12) {
        fs.push(float(s))
    }
    let fkept = fs
    var fsorted = fs
    fsorted.sort()
    out.push_str("{show_floats(fsorted)} {fs.sum()} {fs.min()} {fs.max()} {fs.contains(0.0)} {fs.contains(0.0 / 0.0)} ")
    if fs.len() > 0 {
        fs[0] = 2.5
    }
    out.push_str("{show_floats(fs.rev())} {show_floats(fkept)} {fs.first()} ")
    let neg = [0.0 * -1.0]
    out.push_str("{neg.sum()} {[0.0 * -1.0, 0.0 * -1.0].sum()} ")
    // Bools: a byte each.
    let n = pick(s, 20)
    var flags = (0..n).map(|i| true)
    for i in 0..n {
        if pick(s, 3) == 0 {
            flags[i] = false
        }
    }
    let fl2 = flags
    flags.push(false)
    out.push_str("{flags} {fl2.len()} {flags.contains(false)} {flags.rev().first()} ")
    // u64s.
    var us: [u64] = []
    for i in 0..pick(s, 8) {
        us.push((pick(s, 1000) - 500).as_u64())
    }
    var usort = us
    usort.sort()
    out.push_str("{usort} {us.min()} {us.max()} {us.sum()} ")
    // Strings: boxes.
    var ws: [str] = []
    for i in 0..pick(s, 14) {
        ws.push(word(s))
    }
    let wkept = ws
    var wsort = ws
    wsort.sort()
    out.push_str("{wsort} {ws.join("|")} {ws.min()} {ws.max()} {ws.contains("ab")} ")
    if ws.len() > 0 {
        ws[pick(s, ws.len())] = "new"
        let r = ws.remove(0)
        out.push_str("{r} ")
    }
    var wby = ws
    wby.sort_by(|x| x.len())
    out.push_str("{wby} {wkept} {ws.slice(1, 4)} {ws + wkept} {ws.get(2)} {ws.pop()} ")
    // Tuples, ordered component by component.
    var ts: [(i64, str)] = []
    for i in 0..pick(s, 10) {
        ts.push((pick(s, 4), word(s)))
    }
    var tsort = ts
    tsort.sort()
    var tby = ts
    tby.sort_by(|t| (t.1, t.0))
    out.push_str("{tsort} {tby} {ts.min()} {ts.max()} {ts.contains((1, "a"))} ")
    // Options and nested lists.
    var os: [Option[i64]] = []
    for i in 0..pick(s, 8) {
        if pick(s, 2) == 0 {
            os.push(None)
        } else {
            os.push(Some(pick(s, 5)))
        }
    }
    out.push_str("{os} {os.contains(Some(2))} {os.contains(None)} ")
    var grid: [[i64]] = []
    for i in 0..pick(s, 5) {
        grid.push(ints(s).slice(0, 4))
    }
    let gkept = grid
    if grid.len() > 0 and grid[0].len() > 0 {
        grid[0][0] = -1
    }
    out.push_str("{grid} {gkept} ")
    // Structs in a list, written through a place.
    var cells: [Cell] = []
    for i in 0..pick(s, 6) {
        cells.push(Cell{ name: word(s), n: pick(s, 9) })
    }
    let ckept = cells
    if cells.len() > 0 {
        let k = pick(s, cells.len())
        cells[k].n = 100
        cells[k].name = "w"
    }
    var cby = cells
    cby.sort_by(|c| c.n)
    out.push_str("{cells.len()} {cby.map(|c| c.n)} {ckept.map(|c| c.name)} ")
    for c in cells {
        out.push_str("{c.name}.{c.n} ")
    }
    // Ranges held as values.
    let a = pick(s, 20) - 10
    let b = pick(s, 20) - 10
    let r = a..b
    let ri = a..=b
    out.push_str("{r.len()} {ri.len()} {r.to_list()} {ri.to_list()} {r.sum()} {ri.map(|x| x * 3)} {r.filter(|x| x % 2 == 0)} ")
    var total = 0
    for x in ri {
        total += x
    }
    out.push_str("{total} ")
    out.to_str()
}

fn main() {
    let a = args()
    var s = (a[0].parse_int() ?? 1) * 7919 + 43
    let rounds = a[1].parse_int() ?? 10
    for r in 0..rounds {
        print(round(s))
    }
    if a.len() > 2 {
        let k = a[2].parse_int() ?? 0
        var xs = [1, 2, 3]
        var ws = ["a", "b"]
        if k == 0 {
            print("{xs[3]}")
        } else if k == 1 {
            print("{xs.remove(5)}")
        } else if k == 2 {
            xs[-1] = 4
            print("{xs}")
        } else if k == 3 {
            print("{ws[2]}")
        } else if k == 4 {
            print("{ws.remove(-1)}")
        } else {
            ws[7] = "c"
            print("{ws}")
        }
    }
}
