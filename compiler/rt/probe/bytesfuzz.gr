// `bytes` and the builders on the Grasm runtime against the Rust runtime's
// (docs/self-hosting.md §6.11), for `scripts/fuzz_rtbytes.sh`, which builds
// this twice -- on the Rust runtime and with the Grasm runtime interposed --
// and requires the same bytes out and the same way out.
//
//     bytesfuzz <seed> <rounds> [<panic>]
//
// Each round makes buffers from lists, cuts windows out of them that share
// the buffer, writes into some -- one that shares its buffer is copied
// first, so the others must not see the write -- fills, copies between,
// joins and searches them, and makes text of them, valid and not (each
// invalid sequence one U+FFFD, as Rust's `from_utf8_lossy` replaces it);
// grows builders of text and of bytes, shared and not, and reads them
// back. With a panic number, the run ends in one of the family's panics.

fn next(inout s: i64) -> i64 {
    s = s * 6364136223846793005 + 1442695040888963407
    s.ushr(17)
}

fn pick(inout s: i64, n: i64) -> i64 {
    next(s) % n
}

/// A byte, often one that UTF-8 treats specially.
fn byte(inout s: i64) -> i64 {
    let k = pick(s, 8)
    if k == 0 {
        return 0xc3
    }
    if k == 1 {
        return 0xa9
    }
    if k == 2 {
        return 0xe2 + pick(s, 2)
    }
    if k == 3 {
        return 0x80 + pick(s, 64)
    }
    if k == 4 {
        return 0xf0 + pick(s, 6)
    }
    if k == 5 {
        return 0xed
    }
    97 + pick(s, 26)
}

fn bytes_list(inout s: i64, n: i64) -> [i64] {
    var out: [i64] = []
    for i in 0..n {
        out.push(byte(s))
    }
    out
}

fn hex(b: bytes) -> str {
    var out = str_builder()
    for i in 0..b.len() {
        out.push_str(b.at(i).to_base(16))
        out.push_str(".")
    }
    out.to_str()
}

fn round(inout s: i64) -> str {
    var out = str_builder()
    let n = pick(s, 24)
    let base = bytes_of(bytes_list(s, n))
    out.push_str("{base.len()} {hex(base)} {base.to_str()} ")
    // Windows on the same buffer.
    let from = pick(s, n + 1)
    let end = from + pick(s, n - from + 1)
    var win = base.slice(from, end)
    out.push_str("{win.len()} {win.to_str()} {base.slice(from, end).to_str()} ")
    // Writes: into the window (which shares base's buffer, so is copied),
    // and into a buffer of its solo.
    if win.len() > 0 {
        win.set(pick(s, win.len()), byte(s))
    }
    out.push_str("{hex(win)} {hex(base)} ")
    var solo = bytes_filled(pick(s, 8), pick(s, 256))
    solo.fill(pick(s, 256))
    if solo.len() >= win.len() {
        solo.copy_from(solo.len() - win.len(), win)
    }
    out.push_str("{hex(solo)} ")
    let joined = base.concat(solo)
    out.push_str("{joined.len()} {joined.to_str()} ")
    let target = byte(s)
    let found = base.index_of(target, pick(s, n + 1))
    out.push_str("{found} ")
    out.push_str("{base.to_list().len()} ")
    // Builders, of bytes and of text, shared and not.
    var bb = byte_builder()
    for i in 0..pick(s, 12) {
        bb.push_byte(byte(s))
    }
    let kept = bb
    bb.push_bytes(win)
    if bb.len() > 0 {
        bb.set(pick(s, bb.len()), byte(s))
        out.push_str("{bb.at(0)} ")
    }
    out.push_str("{bb.len()} {kept.len()} {bb.to_str()} {hex(bb.to_bytes())} ")
    var sb = str_builder()
    sb.push_str(base.to_str())
    let kept2 = sb
    sb.push_str("é✓")
    out.push_str("{sb.len()} {kept2.len()} {sb.to_str()} ")
    out.to_str()
}

fn main() {
    let a = args()
    var s = (a[0].parse_int() ?? 1) * 7919 + 43
    let rounds = a[1].parse_int() ?? 10
    for r in 0..rounds {
        print(round(s))
    }
    if a.len() > 2 {
        let k = a[2].parse_int() ?? 0
        let b = bytes_of([1, 2, 3])
        if k == 0 {
            print("{b.at(3)}")
        } else if k == 1 {
            print("{b.slice(2, 1).len()}")
        } else if k == 2 {
            print("{bytes_of([1, 256]).len()}")
        } else if k == 3 {
            var c = b
            c.set(0, -1)
            print("{c.len()}")
        } else if k == 4 {
            var c = b
            c.copy_from(2, b)
            print("{c.len()}")
        } else {
            print("{bytes_filled(-1, 0).len()}")
        }
    }
}
