// Generational references on the Grasm runtime against the Rust runtime's
// (docs/self-hosting.md §6.11), for `scripts/fuzz_rtrefs.sh`, which builds
// this twice -- on the Rust runtime and with the Grasm runtime interposed --
// and requires the same bytes out and the same way out.
//
//     reffuzz <seed> <rounds> [stale]
//
// A graph of nodes held by reference, each naming others by reference:
// nodes made, read through, written through (a field, a list field pushed
// to), walked along their edges, released -- so slots are used again and
// references into their earlier lives go stale -- and asked whether they are
// alive. Every line says what was read; with `stale`, the run ends reading
// through a released reference, which panics, and without it the run ends
// so the leak check can count what is left (the heap's own slots are roots).

type Node = { name: str, v: i64, out: [ref Node] }

fn next(inout s: i64) -> i64 {
    s = s * 6364136223846793005 + 1442695040888963407
    s.ushr(17)
}

fn pick(inout s: i64, n: i64) -> i64 {
    next(s) % n
}

fn word(inout s: i64) -> str {
    let k = pick(s, 3)
    if k == 0 {
        return "n"
    }
    if k == 1 {
        return "a node name past the inline capacity of a string box"
    }
    "é"
}

fn main() {
    let a = args()
    var s = (a[0].parse_int() ?? 1) * 7919 + 41
    let rounds = a[1].parse_int() ?? 10
    var nodes: [ref Node] = []
    var gone: [ref Node] = []
    for r in 0..rounds {
        var line = str_builder()
        let k = pick(s, 6)
        if k <= 1 or nodes.len() == 0 {
            nodes.push(ref(Node{ name: word(s), v: pick(s, 100), out: [] }))
            line.push_str("new ")
        } else if k == 2 {
            // An edge, written through the reference.
            let from = nodes[pick(s, nodes.len())]
            let to = nodes[pick(s, nodes.len())]
            from.out.push(to)
            from.v = from.v + 1
            line.push_str("edge {from.out.len()} ")
        } else if k == 3 {
            // A walk along the edges.
            var at = nodes[pick(s, nodes.len())]
            var total = 0
            for step in 0..pick(s, 6) {
                if alive(at) {
                    total += at.v + at.name.len()
                    if at.out.len() > 0 {
                        at = at.out[pick(s, at.out.len())]
                    }
                }
            }
            line.push_str("walk {total} ")
        } else if k == 4 {
            // A release: the slot is used again, and references into its
            // earlier life are stale.
            let i = pick(s, nodes.len())
            let n = nodes[i]
            release(n)
            gone.push(n)
            nodes.remove(i)
            line.push_str("released ")
        } else {
            var live = 0
            for g in gone {
                if alive(g) {
                    live += 1
                }
            }
            for n in nodes {
                if alive(n) {
                    live += 1
                }
            }
            line.push_str("alive {live} of {gone.len() + nodes.len()} ")
        }
        print(line.to_str())
    }
    // Reading through a released reference is a panic, never a read of the
    // slot's next occupant.
    if a.len() > 2 and gone.len() > 0 {
        print("last: {gone[0].v}")
    }
}
