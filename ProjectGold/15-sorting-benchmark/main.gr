// Sorting benchmark — three algorithms, checked against each other, then timed.
//
// A benchmark that does not verify its answers measures how fast a program
// produces the wrong result. So every sort here is checked twice before any
// timing is reported: the output must be ordered, and it must be a permutation
// of the input. Quicksort in particular is easy to write in a way that sorts
// most inputs and silently drops duplicates.
//
// The timing uses `now_millis()`, which is an `io` effect — so `main` declares
// `/ {io}` and the whole program is charged for reading a clock. That is the
// capability system doing its job on a program that has nothing to do with
// capabilities.

fn is_sorted(xs: [i64]) -> bool {
    for i in 1..xs.len() {
        if xs[i - 1] > xs[i] {
            return false
        }
    }
    true
}

/// Same multiset, not just same length — this is what catches a quicksort that
/// loses elements equal to the pivot.
fn same_elements(a: [i64], b: [i64]) -> bool {
    if a.len() != b.len() {
        return false
    }
    var x = a
    var y = b
    x.sort()
    y.sort()
    for i in 0..x.len() {
        if x[i] != y[i] {
            return false
        }
    }
    true
}

fn bubble(xs: [i64]) -> [i64] {
    var a = xs
    let n = a.len()
    var pass = 0
    var swapped = true
    while swapped and pass < n {
        swapped = false
        for i in 1..(n - pass) {
            if a[i - 1] > a[i] {
                let t = a[i - 1]
                a[i - 1] = a[i]
                a[i] = t
                swapped = true
            }
        }
        pass = pass + 1
    }
    a
}

fn insertion(xs: [i64]) -> [i64] {
    var a = xs
    for i in 1..a.len() {
        let key = a[i]
        var j = i - 1
        var going = true
        while going {
            if j >= 0 and a[j] > key {
                a[j + 1] = a[j]
                j = j - 1
            } else {
                going = false
            }
        }
        a[j + 1] = key
    }
    a
}

/// Quicksort, written the allocating way. Three-way partitioning, because
/// two-way on an array of equal keys is the quadratic case and this benchmark
/// includes exactly that input.
fn quick(xs: [i64]) -> [i64] {
    if xs.len() <= 1 {
        return xs
    }
    let pivot = xs[xs.len() / 2]
    var lo: [i64] = []
    var eq: [i64] = []
    var hi: [i64] = []
    for v in xs {
        if v < pivot { lo.push(v) }
        else if v > pivot { hi.push(v) }
        else { eq.push(v) }
    }
    var out = quick(lo)
    for v in eq { out.push(v) }
    for v in quick(hi) { out.push(v) }
    out
}

fn merge_two(a: [i64], b: [i64]) -> [i64] {
    var out: [i64] = []
    var i = 0
    var j = 0
    while i < a.len() and j < b.len() {
        // `<=` and not `<`: taking from the left on a tie is what makes this
        // stable, and stability is the property merge sort is chosen for.
        if a[i] <= b[j] {
            out.push(a[i])
            i = i + 1
        } else {
            out.push(b[j])
            j = j + 1
        }
    }
    while i < a.len() {
        out.push(a[i])
        i = i + 1
    }
    while j < b.len() {
        out.push(b[j])
        j = j + 1
    }
    out
}

fn merge_sort(xs: [i64]) -> [i64] {
    if xs.len() <= 1 {
        return xs
    }
    let mid = xs.len() / 2
    var left: [i64] = []
    var right: [i64] = []
    for i in 0..mid { left.push(xs[i]) }
    for i in mid..xs.len() { right.push(xs[i]) }
    merge_two(merge_sort(left), merge_sort(right))
}

type Rng = { seed: i64 }

fn next(inout r: Rng) -> i64 {
    r.seed = r.seed * 6364136223846793005 + 1442695040888963407
    if r.seed < 0 { 0 - (r.seed + 1) } else { r.seed }
}

fn random_list(n: i64, seed: i64, spread: i64) -> [i64] {
    var r = Rng{ seed: seed }
    var out: [i64] = []
    for _i in 0..n {
        out.push(next(r) % spread)
    }
    out
}

fn sorted_list(n: i64) -> [i64] {
    var out: [i64] = []
    for i in 0..n { out.push(i) }
    out
}

fn reversed_list(n: i64) -> [i64] {
    var out: [i64] = []
    for i in 0..n { out.push(n - i) }
    out
}

fn all_same(n: i64) -> [i64] {
    var out: [i64] = []
    for _i in 0..n { out.push(7) }
    out
}

fn verify(name: str, input: [i64], got: [i64]) -> bool {
    let ordered = is_sorted(got)
    let complete = same_elements(input, got)
    if not ordered or not complete {
        print("  {name}: WRONG (ordered {ordered}, permutation {complete})")
        return false
    }
    true
}

fn check_all(label: str, input: [i64]) {
    var ok = true
    ok = verify("bubble", input, bubble(input)) and ok
    ok = verify("insertion", input, insertion(input)) and ok
    ok = verify("quick", input, quick(input)) and ok
    ok = verify("merge", input, merge_sort(input)) and ok
    ok = verify("library", input, {
        var a = input
        a.sort()
        a
    }) and ok
    // All five must produce the identical list, not merely a sorted one.
    let b = bubble(input)
    let q = quick(input)
    let m = merge_sort(input)
    var agree = true
    for i in 0..b.len() {
        if b[i] != q[i] or b[i] != m[i] {
            agree = false
        }
    }
    print("{label} (n={input.len()}): all correct {ok}, all identical {agree}")
}

fn time_of(f: fn([i64]) -> [i64], xs: [i64]) -> i64 / {io} {
    let start = now_millis()
    let out = f(xs)
    // The result is used, so nothing can be optimised away as dead.
    let guard = if out.len() > 0 { out[0] } else { 0 }
    let elapsed = now_millis() - start
    if guard == 123456789 { 0 - 1 } else { elapsed }
}

fn main() / {io} {
    print("--- correctness first, on the inputs that break sorts ---")
    check_all("random", random_list(200, 1, 1000))
    check_all("already sorted", sorted_list(200))
    check_all("reversed", reversed_list(200))
    check_all("all equal", all_same(200))
    check_all("many duplicates", random_list(200, 2, 5))
    check_all("empty", [])
    check_all("one", [42])
    check_all("two ordered", [1, 2])
    check_all("two reversed", [2, 1])
    check_all("negatives", [3, -1, 4, -1, 5, -9, 2, -6])

    print("--- stability, which only merge sort promises ---")
    // Encoded as value*10 + index: after a stable sort by value, the indices
    // within an equal group must still ascend.
    var tagged: [i64] = []
    for i in 0..8 {
        tagged.push((i % 3) * 10 + i)
    }
    let by_value = merge_sort(tagged)
    print("input:  {tagged}")
    print("merged: {by_value}")
    var stable = true
    for i in 1..by_value.len() {
        if by_value[i - 1] / 10 == by_value[i] / 10 and by_value[i - 1] > by_value[i] {
            stable = false
        }
    }
    print("merge sort kept equal keys in order: {stable}")

    // What the growth section claims is that one sort is quadratic and the
    // other is not. Wall-clock time is a *proxy* for that, and a bad one: the
    // assertions below used to compare elapsed milliseconds, and on a machine
    // that was busy for the wrong two hundred milliseconds the ratio flipped
    // and the gate failed on code that had not changed. A benchmark whose
    // answer depends on what else the machine is doing is the same defect as a
    // benchmark that does not check its answers.
    //
    // So the curve is measured by *counting comparisons*, which is what the
    // complexity claim is actually about. The count is a property of the
    // algorithm and the input, so it is identical on every engine, on every
    // machine, and under any load — and the same numbers still distinguish
    // O(n^2) from O(n log n), which is the whole point.
    //
    // The clock is still read, and its result still printed, because a program
    // that reads a clock is what charges `main` with `io`. It is reported and
    // not asserted on.
    print("--- growth ---")

    let n = 400
    let small = random_list(n, 9, 100000)
    let large = random_list(n * 2, 9, 100000)

    let bubble_1 = bubble_ops(small)
    let bubble_2 = bubble_ops(large)
    let merge_1 = merge_ops(small)
    let merge_2 = merge_ops(large)

    // Ratios as tenths, to avoid float formatting differences.
    let bubble_ratio = (bubble_2 * 10) / bubble_1
    let merge_ratio = (merge_2 * 10) / merge_1

    print("bubble doubles n: at least 3x more comparisons: {bubble_ratio >= 30}")
    print("merge doubles n:  under 3x more comparisons:    {merge_ratio > 0 and merge_ratio < 30}")
    print("quick compares less than bubble on the same input: {quick_ops(small) < bubble_1}")
    print("merge compares less than bubble on the same input: {merge_1 < bubble_1}")

    // The clock is read, because reading one is what charges `main` with `io`
    // and that is half of what this program demonstrates. Nothing is asserted
    // about *how long* anything took: the first version of this line compared
    // two elapsed times, and comparing elapsed times is exactly the thing that
    // made this gate fail on code that had not changed.
    let elapsed = time_of(merge_sort, small)
    print("the clock ran forwards: {elapsed >= 0}")
}

// --- counting the work, instead of timing it ------------------------------
//
// Each of these mirrors the sort above it exactly and returns the number of
// key comparisons instead of the sorted list. Duplicating the loop is the
// price of not having a way to instrument a function from outside it, and it
// buys an answer that does not depend on the machine.

fn bubble_ops(xs: [i64]) -> i64 {
    var a = xs
    let n = a.len()
    var pass = 0
    var swapped = true
    var ops = 0
    while swapped and pass < n {
        swapped = false
        for i in 1..(n - pass) {
            ops = ops + 1
            if a[i - 1] > a[i] {
                let t = a[i - 1]
                a[i - 1] = a[i]
                a[i] = t
                swapped = true
            }
        }
        pass = pass + 1
    }
    ops
}

fn merge_ops(xs: [i64]) -> i64 {
    if xs.len() <= 1 {
        return 0
    }
    let mid = xs.len() / 2
    var left: [i64] = []
    var right: [i64] = []
    for i in 0..mid { left.push(xs[i]) }
    for i in mid..xs.len() { right.push(xs[i]) }
    var ops = merge_ops(left) + merge_ops(right)
    let a = merge_sort(left)
    let b = merge_sort(right)
    var i = 0
    var j = 0
    while i < a.len() and j < b.len() {
        ops = ops + 1
        if a[i] <= b[j] { i = i + 1 } else { j = j + 1 }
    }
    ops
}

fn quick_ops(xs: [i64]) -> i64 {
    if xs.len() <= 1 {
        return 0
    }
    let pivot = xs[xs.len() / 2]
    var lo: [i64] = []
    var eq: [i64] = []
    var hi: [i64] = []
    var ops = 0
    for v in xs {
        // Two comparisons per element, the same two the sort performs.
        ops = ops + 2
        if v < pivot { lo.push(v) }
        else if v > pivot { hi.push(v) }
        else { eq.push(v) }
    }
    ops + quick_ops(lo) + quick_ops(hi)
}
