// FizzBuzz, and then the variant — modulo, boolean composition, and output.
//
// The plain version is four lines and proves nothing. The variant is the test:
// the rules become *data*, so the loop has to compose a string from a list of
// (divisor, word) pairs rather than from a fixed if-chain. That exercises
// tuples in a list, iteration over them, and string accumulation — and it is
// the version where an off-by-one in "did anything match" shows up.

type Rule = { by: i64, say: str }

fn word_for(n: i64, rules: [Rule]) -> str {
    var out = ""
    for r in rules {
        if n % r.by == 0 {
            out = out + r.say
        }
    }
    if out == "" {
        return "{n}"
    }
    out
}

fn run_with(rules: [Rule], upto: i64, show: [i64]) {
    for n in 1..(upto + 1) {
        let text = word_for(n, rules)
        if show.contains(n) {
            print("{n}: {text}")
        }
    }
}

fn main() {
    let classic = [Rule{ by: 3, say: "Fizz" }, Rule{ by: 5, say: "Buzz" }]

    // The whole 1..100 run, summarised rather than printed: 100 lines of
    // output would hide a wrong answer rather than show one.
    var fizz = 0
    var buzz = 0
    var fizzbuzz = 0
    var plain = 0
    for n in 1..101 {
        let w = word_for(n, classic)
        if w == "Fizz" { fizz = fizz + 1 }
        else if w == "Buzz" { buzz = buzz + 1 }
        else if w == "FizzBuzz" { fizzbuzz = fizzbuzz + 1 }
        else { plain = plain + 1 }
    }
    print("1..100: Fizz {fizz}, Buzz {buzz}, FizzBuzz {fizzbuzz}, numbers {plain}")
    print("total {fizz + buzz + fizzbuzz + plain}")

    // The interesting values, printed exactly.
    run_with(classic, 20, [1, 3, 5, 15, 20])

    // The variant: three rules, so a number divisible by all three names all
    // three, in rule order.
    let three = [
        Rule{ by: 3, say: "Fizz" },
        Rule{ by: 5, say: "Buzz" },
        Rule{ by: 7, say: "Bang" },
    ]
    print("--- three rules ---")
    run_with(three, 105, [21, 35, 105])

    // A rule set with no matches at all, and one that matches everything.
    print("--- edge rules ---")
    run_with([Rule{ by: 1000, say: "Never" }], 3, [1, 2, 3])
    run_with([Rule{ by: 1, say: "Always" }], 2, [1, 2])
}
