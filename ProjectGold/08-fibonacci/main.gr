// Fibonacci — recursion, call stacks, and what happens at the end of i64.
//
// The list says this tests "integer overflow handling", and Grasm has a
// specified answer: [E-ARITH-INT] says `+ - *` on `i64` wrap, two's complement.
// So this program does not avoid the overflow — it walks straight into it and
// prints where the sequence stops being Fibonacci, which is the fact a caller
// actually needs. F(92) is the last correct one.
//
// It also checks the three implementations agree with each other, which is the
// real test of the recursion: memoized, naive and iterative are three different
// shapes of the same function, and a call-stack bug shows up as a disagreement
// rather than as a crash.

fn fib_iterative(n: i64) -> i64 {
    if n < 2 {
        return n
    }
    var a = 0
    var b = 1
    // `for _ in` is refused — `_` is a pattern in `match` and nowhere else
    // (FINDINGS.md, F4) — so the counter is named and unused.
    for _step in 2..(n + 1) {
        let next = a + b
        a = b
        b = next
    }
    b
}

fn fib_naive(n: i64) -> i64 {
    if n < 2 {
        return n
    }
    fib_naive(n - 1) + fib_naive(n - 2)
}

fn fib_memo(n: i64, inout seen: Map[i64, i64]) -> i64 {
    if n < 2 {
        return n
    }
    match seen.get(n) {
        Some(v) -> v
        None -> {
            let v = fib_memo(n - 1, seen) + fib_memo(n - 2, seen)
            seen.set(n, v)
            v
        }
    }
}

/// Deep recursion, to show the stack actually goes where [E-RECURSION-DEPTH]
/// says it does. Not Fibonacci — a plain countdown, so the only thing measured
/// is depth.
fn depth(n: i64) -> i64 {
    if n == 0 {
        return 0
    }
    1 + depth(n - 1)
}

fn main() {
    print("--- the first twenty, three ways ---")
    var memo = map()
    var agree = true
    for n in 0..20 {
        let a = fib_iterative(n)
        let b = fib_naive(n)
        let c = fib_memo(n, memo)
        if a != b or a != c {
            agree = false
            print("DISAGREEMENT at {n}: iterative {a}, naive {b}, memo {c}")
        }
    }
    print("all three agree for 0..19: {agree}")

    var line = ""
    for n in 0..15 {
        line = line + "{fib_iterative(n)} "
    }
    print("{line.trim()}")

    print("--- the large ones ---")
    print("F(50)  = {fib_iterative(50)}")
    print("F(90)  = {fib_iterative(90)}")
    print("F(92)  = {fib_iterative(92)}")

    // F(93) does not fit in an i64. [E-ARITH-INT] wraps rather than trapping,
    // so the number that comes back is wrong and is *specified* to be wrong.
    // Detecting it is the caller's job, and this is how: Fibonacci is strictly
    // increasing, so a term smaller than the one before it has wrapped.
    print("--- where i64 runs out ---")
    var a = 0
    var b = 1
    var n = 1
    var wrapped_at = -1
    while n < 95 and wrapped_at < 0 {
        let next = a + b
        if next < b {
            wrapped_at = n + 1
        }
        a = b
        b = next
        n = n + 1
    }
    print("first term that wrapped: F({wrapped_at})")
    print("F(92) fits:   {fib_iterative(92)}")
    print("F(93) wraps:  {fib_iterative(93)}")
    print("i64 max:      9223372036854775807")

    print("--- memoization is the same function, faster ---")
    var memo2 = map()
    print("F(80) memoized  = {fib_memo(80, memo2)}")
    print("F(80) iterative = {fib_iterative(80)}")
    print("memo table holds {memo2.len()} entries")

    print("--- recursion depth ---")
    print("depth(1000)   = {depth(1000)}")
    print("depth(50000)  = {depth(50000)}")
}
