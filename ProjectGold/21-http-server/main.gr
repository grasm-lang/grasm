// A single-threaded HTTP server — TCP sockets, request parsing, response
// framing.
//
// Two halves, and they are separated on purpose. The *parsing and framing* is
// pure and is tested here on every run, deterministically, so it can be
// compared across all three engines. The *socket loop* needs a client to talk
// to and cannot be part of an automated comparison, so it runs only when the
// program is given `serve`:
//
//     grasm run main.gr -- serve      then visit http://localhost:8971
//
// A server whose parser is untested is a server that is wrong in a way nobody
// sees until a real browser sends something slightly unusual — which is why
// the malformed cases below are the bulk of the file.
//
// `net` is a capability ([T-CAPABILITY]), so `main` declares `/ {io, net}` and
// a package that never asked for `net` could not contain this program.

let PORT = 8971

type Request = {
    method: str,
    path: str,
    query: str,
    version: str,
    headers: [str],       // "name: value", name lower-cased
    body: str,
    ok: bool,
    why: str,
}

fn bad_request(why: str) -> Request {
    Request{ method: "", path: "", query: "", version: "", headers: [], body: "", ok: false, why: why }
}

fn header_value(r: Request, name: str) -> Option[str] {
    let want = name.to_lower() + ":"
    for h in r.headers {
        if h.to_lower().starts_with(want) {
            return Some(h.substr(want.len(), h.len() - want.len()).trim())
        }
    }
    None
}

/// Parse a request. Everything that can be wrong with one is a value, because
/// the peer is a stranger and a malformed request must answer 400 rather than
/// end the process.
fn parse_request(raw: str) -> Request {
    if raw.trim() == "" {
        return bad_request("empty request")
    }
    // Headers end at a blank line. A request may legitimately arrive without
    // one if the client is slow, and that is still malformed *so far*.
    let lines = raw.lines()
    if lines.len() == 0 {
        return bad_request("no request line")
    }
    let start = lines[0].trim_end()
    let parts = start.split(" ")
    if parts.len() != 3 {
        return bad_request("a request line has three parts, found {parts.len()}")
    }
    let method = parts[0]
    let target = parts[1]
    let version = parts[2]

    if not version.starts_with("HTTP/") {
        return bad_request("`{version}` is not an HTTP version")
    }
    let known = ["GET", "POST", "PUT", "DELETE", "HEAD", "OPTIONS", "PATCH"]
    if not known.contains(method) {
        return bad_request("unknown method `{method}`")
    }
    if not target.starts_with("/") {
        return bad_request("target must be an absolute path, found `{target}`")
    }

    var path = target
    var query = ""
    match target.index_of("?") {
        None -> {}
        Some(at) -> {
            path = target.substr(0, at)
            query = target.substr(at + 1, target.len() - at - 1)
        }
    }

    var headers: [str] = []
    var body = ""
    var in_body = false
    for i in 1..lines.len() {
        let line = lines[i].trim_end()
        if in_body {
            body = if body == "" { line } else { body + "\n" + line }
        } else if line == "" {
            in_body = true
        } else {
            if line.index_of(":") == None {
                return bad_request("header without a colon: `{line}`")
            }
            headers.push(line)
        }
    }
    Request{
        method: method, path: path, query: query, version: version,
        headers: headers, body: body, ok: true, why: "",
    }
}

/// One query parameter, by name. Percent-decoding is deliberately included:
/// a browser sends `%20` and a server that does not decode reports the wrong
/// value with no error anywhere.
fn query_param(q: str, name: str) -> Option[str] {
    if q == "" {
        return None
    }
    for pair in q.split("&") {
        match pair.index_of("=") {
            None -> {
                if pair == name {
                    return Some("")
                }
            }
            Some(at) -> {
                let k = pair.substr(0, at)
                if k == name {
                    return Some(percent_decode(pair.substr(at + 1, pair.len() - at - 1)))
                }
            }
        }
    }
    None
}

fn hex_value(c: str) -> i64 {
    let h = c.code_at(0)
    if h >= 48 and h <= 57 { return h - 48 }
    if h >= 97 and h <= 102 { return h - 87 }
    if h >= 65 and h <= 70 { return h - 55 }
    -1
}

fn percent_decode(s: str) -> str {
    var out = ""
    let cs = s.chars()
    var i = 0
    while i < cs.len() {
        if cs[i] == "+" {
            out = out + " "
            i = i + 1
        } else if cs[i] == "%" and i + 2 < cs.len() {
            let hi = hex_value(cs[i + 1])
            let lo = hex_value(cs[i + 2])
            if hi < 0 or lo < 0 {
                out = out + cs[i]
                i = i + 1
            } else {
                out = out + (hi * 16 + lo).to_char()
                i = i + 3
            }
        } else {
            out = out + cs[i]
            i = i + 1
        }
    }
    out
}

fn escape_html(s: str) -> str {
    var out = ""
    for c in s.chars() {
        if c == "&" { out = out + "&amp;" }
        else if c == "<" { out = out + "&lt;" }
        else if c == ">" { out = out + "&gt;" }
        else if c == "\"" { out = out + "&quot;" }
        else { out = out + c }
    }
    out
}

/// A response, framed. `Content-Length` is computed from the body rather than
/// guessed, and `Connection: close` is sent because this server closes after
/// every response — telling the client so is the difference between a clean
/// finish and a browser waiting for more.
fn response(status: str, content_type: str, body: str) -> str {
    "HTTP/1.1 {status}\r\nContent-Type: {content_type}\r\nContent-Length: {body.len()}\r\nConnection: close\r\n\r\n{body}"
}

fn route(r: Request) -> str {
    if not r.ok {
        return response("400 Bad Request", "text/plain", "bad request: {r.why}\n")
    }
    if r.method == "HEAD" {
        // A HEAD response carries the headers of the GET and no body.
        let full = route(Request{
            method: "GET", path: r.path, query: r.query, version: r.version,
            headers: r.headers, body: r.body, ok: true, why: "",
        })
        match full.index_of("\r\n\r\n") {
            None -> return full
            Some(at) -> return full.substr(0, at + 4)
        }
    }
    if r.method != "GET" {
        return response("405 Method Not Allowed", "text/plain", "only GET is served\n")
    }
    if r.path == "/" {
        return response("200 OK", "text/html",
            "<!doctype html><title>grasm</title><h1>It works.</h1><p>Served by a Grasm program.</p>\n")
    }
    if r.path == "/hello" {
        let who = query_param(r.query, "name") ?? "world"
        return response("200 OK", "text/plain", "hello, {who}\n")
    }
    if r.path == "/echo" {
        var lines: [str] = []
        lines.push("method: {r.method}")
        lines.push("path: {r.path}")
        lines.push("query: {r.query}")
        lines.push("headers: {r.headers.len()}")
        return response("200 OK", "text/plain", lines.join("\n") + "\n")
    }
    response("404 Not Found", "text/html",
        "<!doctype html><h1>404</h1><p>no route for {escape_html(r.path)}</p>\n")
}

fn status_of(resp: str) -> str {
    match resp.index_of("\r\n") {
        None -> resp
        Some(at) -> resp.substr(0, at)
    }
}

fn body_of(resp: str) -> str {
    match resp.index_of("\r\n\r\n") {
        None -> ""
        Some(at) -> resp.substr(at + 4, resp.len() - at - 4)
    }
}

fn content_length_of(resp: str) -> i64 {
    for line in resp.split("\r\n") {
        if line.to_lower().starts_with("content-length:") {
            return line.substr(15, line.len() - 15).trim().parse_int() ?? -1
        }
    }
    -1
}

fn check(label: str, raw: str) {
    let r = parse_request(raw)
    let resp = route(r)
    let declared = content_length_of(resp)
    let actual = body_of(resp).len()
    // A HEAD response is *supposed* to declare the length it would have sent
    // and send no body, so it is the one case where these differ on purpose.
    let framed = if r.ok and r.method == "HEAD" {
        actual == 0 and declared > 0
    } else {
        declared == actual
    }
    if r.ok {
        print("{label}: {status_of(resp)}  [{r.method} {r.path} q=\"{r.query}\" h={r.headers.len()} framed={framed}]")
    } else {
        print("{label}: {status_of(resp)}  [rejected: {r.why}]")
    }
}

fn serve() / {io, net} {
    match tcp_listen(PORT) {
        Err(e) -> print("cannot listen on {PORT}: {e}")
        Ok(listener) -> {
            print("http://localhost:{PORT}  (ctrl-c to stop)")
            var going = true
            while going {
                match tcp_accept(listener) {
                    Err(e) -> going = false
                    Ok(conn) -> {
                        let raw = tcp_read(conn) ?? ""
                        let r = parse_request(raw)
                        let resp = route(r)
                        match tcp_write(conn, resp) {
                            Ok(_) -> {}
                            Err(e) -> {}
                        }
                        net_close(conn)
                        print("{r.method} {r.path} -> {status_of(resp)}")
                    }
                }
            }
            net_close(listener)
        }
    }
}

fn main() / {io, net} {
    if args().contains("serve") {
        serve()
        return
    }

    print("--- well-formed requests ---")
    check("root", "GET / HTTP/1.1\r\nHost: localhost\r\n\r\n")
    check("hello", "GET /hello HTTP/1.1\r\nHost: x\r\n\r\n")
    check("hello named", "GET /hello?name=ada HTTP/1.1\r\nHost: x\r\n\r\n")
    check("echo", "GET /echo?a=1&b=2 HTTP/1.1\r\nHost: x\r\nUser-Agent: test\r\n\r\n")
    check("missing route", "GET /nope HTTP/1.1\r\nHost: x\r\n\r\n")
    check("head", "HEAD / HTTP/1.1\r\nHost: x\r\n\r\n")
    check("post", "POST / HTTP/1.1\r\nHost: x\r\n\r\nbody here")
    check("http/1.0", "GET / HTTP/1.0\r\n\r\n")
    check("no headers", "GET / HTTP/1.1\r\n\r\n")

    print("--- malformed, which must be 400 and not a crash ---")
    check("empty", "")
    check("whitespace", "   \r\n\r\n")
    check("two parts", "GET /\r\n\r\n")
    check("four parts", "GET / HTTP/1.1 extra\r\n\r\n")
    check("no version", "GET / XYZ\r\n\r\n")
    check("unknown method", "BREW / HTTP/1.1\r\n\r\n")
    check("relative target", "GET index.html HTTP/1.1\r\n\r\n")
    check("bad header", "GET / HTTP/1.1\r\nnot-a-header\r\n\r\n")
    check("lowercase method", "get / HTTP/1.1\r\n\r\n")

    print("--- query parsing ---")
    for q in ["name=ada", "name=", "name", "a=1&name=bob&c=3", "name=a%20b", "name=a+b",
              "name=%41%42", "name=%zz", "other=1", ""] {
        print("  \"{q}\" -> name = {query_param(q, "name")}")
    }

    print("--- percent decoding ---")
    for s in ["plain", "a%20b", "a+b", "%41%42%43", "100%25", "%2F", "%", "%4", "%zz", "caf%C3%A9"] {
        print("  \"{s}\" -> \"{percent_decode(s)}\"")
    }

    print("--- response framing ---")
    let r = route(parse_request("GET /hello?name=ada HTTP/1.1\r\n\r\n"))
    print("  status: {status_of(r)}")
    print("  declared length: {content_length_of(r)}")
    print("  actual body length: {body_of(r).len()}")
    print("  header/body separator present: {r.index_of("\r\n\r\n") != None}")
    let h = route(parse_request("HEAD / HTTP/1.1\r\n\r\n"))
    print("  HEAD body is empty: {body_of(h) == ""}")
    print("  HEAD keeps its Content-Length: {content_length_of(h) > 0}")

    print("--- run `grasm run main.gr -- serve` to serve on {PORT} ---")
}
