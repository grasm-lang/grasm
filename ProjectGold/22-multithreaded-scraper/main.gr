// A concurrent fetcher — many requests in flight on one thread.
//
// This project was blocked until [L-LIB-NET] grew a client half, and it is the
// reason `tcp_connect` was added. It then found the largest gap in this
// directory: `par_map` is the only multicore path in the language and it
// refuses any closure that performs an effect, while `spawn` is deliberately
// single-core ([E-NOT-PARALLEL]). Between them, a program could compute on many
// cores or perform I/O, and not both (FINDINGS.md **F14**).
//
// That is still true of *compute*. It is no longer true of I/O. `net_wait`
// ([L-LIB-NET]) answers with the handles that can be read without blocking, so
// one thread can hold every request open at once — which is what "concurrent
// fetching" means in practice, and what every real client does underneath.
// Threads were never the point; not blocking on the first response was.
//
// The default run proves it without needing anything outside the program. It
// starts a server, dials six clients at it, and drives *both halves from a
// single wait loop* — so the responses are genuinely interleaved and the whole
// exchange is deterministic enough to compare across three engines. `-- fetch`
// does the same thing against project 21's server.
//
// The list also calls for "thread-safe memory sharing, mutexes, or lock
// mechanisms". Grasm has no mutex and does not need one here, and that is the
// interesting part: `par_map` refuses at compile time to capture a `ref`, so
// the data race the exercise is about cannot be written. The refusal is
// demonstrated at the bottom, in the compiler's own words.

type Page = {
    url: str,
    status: i64,
    bytes: i64,
    title: str,
    links: [str],
    error: str,
}

fn failed(url: str, why: str) -> Page {
    Page{ url: url, status: 0, bytes: 0, title: "", links: [], error: why }
}

// --- parsing, which is the testable half --------------------------------------

fn status_of(resp: str) -> i64 {
    let lines = resp.lines()
    if lines.len() == 0 {
        return 0
    }
    let parts = lines[0].split(" ")
    if parts.len() < 2 {
        return 0
    }
    parts[1].trim().parse_int() ?? 0
}

fn body_of(resp: str) -> str {
    match resp.index_of("\r\n\r\n") {
        Some(at) -> resp.substr(at + 4, resp.len() - at - 4)
        None -> match resp.index_of("\n\n") {
            Some(at) -> resp.substr(at + 2, resp.len() - at - 2)
            None -> ""
        }
    }
}

/// Text between the first `<tag>` and its `</tag>`, tags stripped.
fn between_tags(html: str, tag: str) -> str {
    let open = "<" + tag + ">"
    let close = "</" + tag + ">"
    match html.to_lower().index_of(open) {
        None -> ""
        Some(a) -> match html.to_lower().index_of(close) {
            None -> ""
            Some(b) -> {
                if b <= a + open.len() {
                    ""
                } else {
                    html.substr(a + open.len(), b - a - open.len()).trim()
                }
            }
        }
    }
}

/// Every `href="..."`, in document order. Deliberately simple-minded: this is a
/// scraper, not an HTML parser, and it says so rather than pretending.
fn links_in(html: str) -> [str] {
    var out: [str] = []
    let lower = html.to_lower()
    let cs = html.chars()
    let lcs = lower.chars()
    var i = 0
    while i < lcs.len() {
        var matched = true
        let needle = "href=\"".chars()
        if i + needle.len() <= lcs.len() {
            for k in 0..needle.len() {
                if lcs[i + k] != needle[k] {
                    matched = false
                }
            }
        } else {
            matched = false
        }
        if matched {
            var j = i + needle.len()
            var url = ""
            while j < cs.len() and cs[j] != "\"" {
                url = url + cs[j]
                j = j + 1
            }
            out.push(url)
            i = j
        } else {
            i = i + 1
        }
    }
    out
}

fn parse_response(url: str, resp: str) -> Page {
    if resp == "" {
        return failed(url, "empty response")
    }
    let status = status_of(resp)
    if status == 0 {
        return failed(url, "not an HTTP response")
    }
    let body = body_of(resp)
    Page{
        url: url,
        status: status,
        bytes: body.len(),
        title: between_tags(body, "title"),
        links: links_in(body),
        error: "",
    }
}

// --- the concurrent half ------------------------------------------------------

fn request_for(path: str) -> str {
    "GET {path} HTTP/1.1\r\nHost: localhost\r\nConnection: close\r\n\r\n"
}

fn fetch_one(port: i64, path: str) -> Page / {io, net} {
    match tcp_connect("127.0.0.1", port) {
        Err(e) -> failed(path, "connect: {e}")
        Ok(conn) -> {
            match tcp_write(conn, request_for(path)) {
                Err(e) -> {
                    net_close(conn)
                    failed(path, "write: {e}")
                }
                Ok(_) -> {
                    let raw = tcp_read(conn) ?? ""
                    net_close(conn)
                    parse_response(path, raw)
                }
            }
        }
    }
}

/// Every request in flight at once, on one thread.
///
/// The three phases are the whole idea. *Connect* and *write* every request
/// before reading any of them, so the last request is on the wire before the
/// first response is waited for. Then read whatever is ready, in whatever order
/// it arrives — which is what `net_wait` reports, and what a sequential loop
/// cannot use because it is already blocked on the first socket.
///
/// The answer is in **request order**, not arrival order. Concurrency is a
/// property of the fetching; a caller that got its results shuffled would have
/// to sort them back, and every caller would.
fn fetch_all(port: i64, paths: [str]) -> [Page] / {io, net} {
    var handles: [i64] = []
    var results: [str] = []
    var errors: [str] = []

    // Phase 1 and 2: connect and send. A handle of -1 marks a path that never
    // got off the ground, so the result list stays aligned with the input.
    for path in paths {
        results.push("")
        match tcp_connect("127.0.0.1", port) {
            Err(e) -> {
                handles.push(0 - 1)
                errors.push("connect: {e}")
            }
            Ok(conn) -> {
                match tcp_write(conn, request_for(path)) {
                    Err(e) -> {
                        net_close(conn)
                        handles.push(0 - 1)
                        errors.push("write: {e}")
                    }
                    Ok(_) -> {
                        handles.push(conn)
                        errors.push("")
                    }
                }
            }
        }
    }

    // Phase 3: read as they become ready.
    var outstanding = 0
    for h in handles {
        if h >= 0 { outstanding = outstanding + 1 }
    }
    var turns = 0
    while outstanding > 0 and turns < 200 {
        var waiting: [i64] = []
        for i in 0..handles.len() {
            if handles[i] >= 0 and results[i] == "" {
                waiting.push(handles[i])
            }
        }
        if waiting.len() == 0 {
            outstanding = 0
        } else {
            let ready = net_wait(waiting, 2000) ?? []
            if ready.len() == 0 {
                // Nothing arrived in two seconds. Something is wrong with the
                // server, not with this loop, and waiting forever would hide it.
                outstanding = 0
            } else {
                for h in ready {
                    var i = 0
                    while i < handles.len() {
                        if handles[i] == h and results[i] == "" {
                            let chunk = tcp_read(h) ?? ""
                            if chunk == "" {
                                results[i] = "(closed with nothing)"
                            } else {
                                results[i] = chunk
                            }
                            outstanding = outstanding - 1
                        }
                        i = i + 1
                    }
                }
            }
        }
        turns = turns + 1
    }

    var pages: [Page] = []
    for i in 0..paths.len() {
        if handles[i] >= 0 {
            net_close(handles[i])
        }
        if errors[i] != "" {
            pages.push(failed(paths[i], errors[i]))
        } else {
            pages.push(parse_response(paths[i], results[i]))
        }
    }
    pages
}

/// A server that answers a handful of paths, multiplexed with everything else.
///
/// It exists so the demonstration needs nothing outside this program. It is not
/// an HTTP server — project 21 is that — it is the smallest thing that answers
/// well-formed responses to the paths the fetcher asks for.
fn response_for(path: str) -> str {
    let body = if path == "/" {
        "<html><head><title>Home</title></head><body><a href=\"/one\">one</a><a href=\"/two\">two</a></body></html>"
    } else if path == "/hello" {
        "<html><head><title>Hello</title></head><body>hi</body></html>"
    } else if path == "/echo" {
        "<html><head><title>Echo</title></head><body><a href=\"/back\">back</a></body></html>"
    } else {
        ""
    }
    if body == "" {
        "HTTP/1.1 404 Not Found\r\nContent-Length: 0\r\n\r\n"
    } else {
        "HTTP/1.1 200 OK\r\nContent-Length: {body.byte_len()}\r\n\r\n{body}"
    }
}

fn path_of(request: str) -> str {
    let lines = request.lines()
    if lines.len() == 0 {
        return "/"
    }
    let parts = lines[0].split(" ")
    if parts.len() < 2 {
        return "/"
    }
    parts[1]
}

fn show(p: Page) {
    if p.error != "" {
        print("  {p.url}: error: {p.error}")
    } else {
        print("  {p.url}: {p.status}, {p.bytes} byte(s), title \"{p.title}\", {p.links.len()} link(s)")
    }
}

/// Server and clients in one wait loop.
///
/// This is the part that could not be written before `net_wait`. Both halves
/// are in the same wait set, so a request arriving and a response arriving are
/// the same kind of event, and neither side ever blocks on the other. A
/// blocking accept here would deadlock the program against itself on the first
/// dial — the same reason project 30's chat demo works.
fn concurrent_demo(paths: [str]) / {io, net} {
    let listener = match tcp_listen(0) {
        Ok(l) -> l
        Err(e) -> {
            print("  cannot listen: {e}")
            return
        }
    }
    let port = net_port(listener) ?? 0

    // Every request goes out before any response is waited for. That is what
    // makes this concurrent: the sixth request is on the wire while the first
    // is still being answered.
    var conns: [i64] = []
    for path in paths {
        match tcp_connect("127.0.0.1", port) {
            Err(e) -> print("  dial failed: {e}")
            Ok(c) -> {
                match tcp_write(c, request_for(path)) {
                    Ok(_) -> conns.push(c)
                    Err(e) -> print("  send failed: {e}")
                }
            }
        }
    }
    print("  {conns.len()} requests in flight before any reply was read")

    // The server half: accept, answer, close. Interleaved with the client half
    // below by the single `net_wait` that drives both.
    var served: [i64] = []
    var answered = 0
    var replies: [str] = []
    for c in conns {
        replies.push("")
    }
    var turns = 0
    while answered < conns.len() and turns < 400 {
        var waiting: [i64] = [listener]
        for h in served {
            waiting.push(h)
        }
        for i in 0..conns.len() {
            if replies[i] == "" {
                waiting.push(conns[i])
            }
        }
        let ready = net_wait(waiting, 2000) ?? []
        if ready.len() == 0 {
            answered = conns.len()
        }
        for h in ready {
            if h == listener {
                match tcp_accept(listener) {
                    Err(e) -> {}
                    Ok(conn) -> served.push(conn)
                }
            } else {
                var is_server_side = false
                for sh in served {
                    if sh == h { is_server_side = true }
                }
                if is_server_side {
                    let request = tcp_read(h) ?? ""
                    if request != "" {
                        match tcp_write(h, response_for(path_of(request))) {
                            Ok(_) -> {}
                            Err(e) -> {}
                        }
                    }
                } else {
                    var i = 0
                    while i < conns.len() {
                        if conns[i] == h and replies[i] == "" {
                            let chunk = tcp_read(h) ?? ""
                            replies[i] = if chunk == "" { "(nothing)" } else { chunk }
                            answered = answered + 1
                        }
                        i = i + 1
                    }
                }
            }
        }
        turns = turns + 1
    }

    for i in 0..conns.len() {
        show(parse_response(paths[i], replies[i]))
    }
    for h in served {
        net_close(h)
    }
    for h in conns {
        net_close(h)
    }
    net_close(listener)
}

fn main() / {io, net} {
    if args().contains("fetch") {
        // The real thing, against project 21's server. Every request is in
        // flight at once; the server answers them one at a time because it is
        // single-threaded, which is its business and not the client's.
        print("--- fetching concurrently ---")
        let paths = ["/", "/hello", "/hello?name=one", "/echo", "/nope", "/"]
        let pages = fetch_all(8971, paths)
        for p in pages {
            show(p)
        }
        var ok = 0
        for p in pages {
            if p.status == 200 { ok = ok + 1 }
        }
        print("  {ok} of {pages.len()} returned 200")
        return
    }

    print("--- six requests, one thread, no blocking ---")
    concurrent_demo(["/", "/hello", "/echo", "/nope", "/hello", "/"])

    // Canned responses, so the parsing half is deterministic and comparable
    // across all three engines.
    let canned = [
        "HTTP/1.1 200 OK\r\nContent-Type: text/html\r\n\r\n<html><title>First</title><a href=\"/a\">a</a><a href=\"/b\">b</a></html>",
        "HTTP/1.1 200 OK\r\nContent-Type: text/html\r\n\r\n<html><title>No links</title><p>nothing here</p></html>",
        "HTTP/1.1 404 Not Found\r\nContent-Type: text/html\r\n\r\n<h1>404</h1>",
        "HTTP/1.1 500 Internal Server Error\r\n\r\n",
        "HTTP/1.1 200 OK\r\n\r\n<TITLE>Upper Case</TITLE><A HREF=\"/c\">c</A>",
        "not an http response at all",
        "",
    ]
    let names = ["/first", "/nolinks", "/missing", "/broken", "/uppercase", "/garbage", "/empty"]

    print("--- parsing responses ---")
    var pages: [Page] = []
    for i in 0..canned.len() {
        let p = parse_response(names[i], canned[i])
        pages.push(p)
        show(p)
    }

    print("--- the same work through par_map ---")
    // Identical inputs, run in parallel. The results must be the same and in
    // the same order — [E-PAR-MAP-ORDER] says `par_map` preserves it, and a
    // scraper that returns pages in completion order is a scraper whose output
    // changes between runs.
    let indexes = [0, 1, 2, 3, 4, 5, 6]
    let parallel_pages = indexes.par_map(|i| parse_response(names[i], canned[i]))
    var same = true
    for i in 0..pages.len() {
        if pages[i].url != parallel_pages[i].url or
            pages[i].status != parallel_pages[i].status or
            pages[i].bytes != parallel_pages[i].bytes or
            pages[i].title != parallel_pages[i].title or
            pages[i].links.len() != parallel_pages[i].links.len() {
            same = false
        }
    }
    print("  par_map gave identical results, in order: {same}")

    print("--- aggregate ---")
    var total_bytes = 0
    var total_links = 0
    var ok = 0
    var errors = 0
    for p in pages {
        total_bytes = total_bytes + p.bytes
        total_links = total_links + p.links.len()
        if p.status == 200 { ok = ok + 1 }
        if p.error != "" { errors = errors + 1 }
    }
    print("  {pages.len()} pages, {ok} ok, {errors} unusable, {total_bytes} bytes, {total_links} links")

    print("--- link extraction ---")
    for html in ["<a href=\"/one\">x</a>", "<a href=''>x</a>", "no links",
                 "<a href=\"/a\"><a href=\"/b\">", "<a href=\"\">", "href=\"/bare\""] {
        print("  {links_in(html)}")
    }

    print("--- why there is no mutex here ---")
    // A shared counter would be the classic race, and `par_map` will not let
    // one be written. This is refused at compile time:
    //
    //     let hits = ref(Cell{ n: 0 })
    //     let _ = paths.par_map(|p| { hits.n += 1  p })
    //
    //     error: a `par_map` closure may not reach a `ref` declared outside it
    //       help: `par_map` runs its closure on several threads at once, and a
    //             `ref` is a handle into one shared heap
    //
    // So the data race this project is nominally about cannot be expressed.
    // The results are collected by `par_map` itself and merged afterwards,
    // which is the shape the refusal pushes you into.
    print("  a par_map closure cannot capture a `ref` — see the comment above")
    print("  run `grasm run main.gr -- fetch` with the server up for the real thing")
}
