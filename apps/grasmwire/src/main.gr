// A GrasmWire endpoint. Real UDP, real keys, real timers.
//
// Everything below this file is arithmetic over bytes and declares no
// capability at all. This is the layer that touches the outside, and it is
// deliberately thin: bind a socket, wait for either a datagram or a deadline,
// hand what arrives to the protocol, send what the protocol produces.
//
// Run two of these against each other:
//
//     grasm run apps/grasmwire/src/main.gr -- listen  51821 51820 <priv> <pub> <psk>
//     grasm run apps/grasmwire/src/main.gr -- connect 51820 51821 <priv> <pub> <psk>
//
// The responder is told a port only as a fallback. It learns where its peer
// actually is from the datagram, with `udp_recv_from`, and follows it if it
// moves — which is what lets a peer on a phone keep a session alive across a
// change of network. That builtin did not exist when this file was first
// written; `udp_recv` answered the datagram and dropped the address, so a
// responder could only answer peers it had been configured with. Writing this
// is what found that, and it is now `[L-LIB-UDP]`.

import grasmwire
import noise
import x25519
import bytes_codec

fn unhex(s: str) -> bytes {
    match bytes_codec.decode_hex(s) {
        Some(b) -> b
        None -> panic("not a hex key: {s}")
    }
}

fn hex(b: bytes) -> str {
    bytes_codec.encode_hex(b)
}

/// Sixteen bytes of the key, which is enough to tell peers apart in a log and
/// not enough to be a key in one.
fn short(b: bytes) -> str {
    var out: [i64] = []
    for i in 0..8 {
        out.push(b.at(i))
    }
    bytes_codec.encode_hex(bytes_of(out))
}

fn main() / {io, net} {
    let argv = args()
    if argv.len() < 6 {
        print("usage: grasmwire <listen|connect> <local-port> <peer-port> <private> <peer-public> <psk> [underload]")
        return
    }
    let mode = argv[0]
    let local_port = to_int(argv[1])
    let peer_port = to_int(argv[2])
    let private = x25519.clamp(unhex(argv[3]))
    let peer_public = unhex(argv[4])
    let psk = unhex(argv[5])
    let public = x25519.public_key(private)

    print("[{mode}] this peer is {short(public)}, talking to {short(peer_public)} on port {peer_port}")

    let socket = match udp_bind(local_port) {
        Ok(h) -> h
        Err(e) -> {
            print("[{mode}] cannot bind port {local_port}: {e}")
            return
        }
    }

    // Under load a responder must not allocate for an unanswered packet, so
    // it answers with a cookie and remembers nothing. This flag makes it
    // behave that way from the first message rather than waiting for a flood.
    let under_load = argv.len() > 6 and argv[6] == "underload"

    if mode == "connect" {
        run_initiator(socket, private, public, peer_public, psk, peer_port)
    } else {
        run_responder(socket, private, public, peer_public, psk, peer_port, under_load)
    }
    net_close(socket)
}

fn to_int(s: str) -> i64 {
    var n = 0
    for ch in s.chars() {
        n = n * 10 + (ch.to_bytes().at(0) - 48)
    }
    n
}

/// Thirty-two bytes for keying cookies.
fn fresh_secret() -> bytes / {io} {
    match random_bytes(32) {
        Ok(b) -> b
        Err(_e) -> panic("the operating system would not give us randomness")
    }
}

/// A session index, chosen at random.
///
/// It is not a secret — it travels in the clear on every data packet, because
/// a receiver with many peers must pick a session before it can try any key.
/// It is chosen randomly anyway: a predictable index is one an off-path
/// attacker can put on a forged packet, and while the AEAD will refuse it, the
/// cheapest thing to make an attacker guess is a number nobody needs to
/// predict.
fn session_index() -> i64 / {io} {
    match random_bytes(4) {
        Ok(b) -> b.at(0).bit_or(b.at(1).shl(8)).bit_or(b.at(2).shl(16)).bit_or(b.at(3).shl(24))
        Err(_e) -> panic("the operating system would not give us randomness")
    }
}

/// One ephemeral key, from the operating system.
///
/// This is the only randomness the whole protocol needs, and it is generated
/// here rather than in the library — which is why every package below this
/// file declares no capabilities and why the handshake could be pinned to a
/// fixed transcript in its own test.
fn ephemeral() -> bytes / {io} {
    match random_bytes(32) {
        Ok(b) -> x25519.clamp(b)
        Err(_e) -> panic("the operating system would not give us randomness")
    }
}

/// The side that speaks first.
fn run_initiator(socket: i64, private: bytes, public: bytes, peer_public: bytes,
    psk: bytes, peer_port: i64) / {io, net} {
    let started_ms = now_millis()
    let my_index = session_index()
    let init: Initiation ! HandshakeError = noise.initiate(private, public, peer_public,
        ephemeral(), grasmwire.stamp(started_ms), my_index)

    let handshake = match init {
        Ok(i) -> i
        Err(_e) -> {
            print("[connect] could not build a first message")
            return
        }
    }
    match udp_send(socket, "127.0.0.1", peer_port, handshake.message) {
        Ok(n) -> print("[connect] sent a {n}-byte first message")
        Err(e) -> {
            print("[connect] send failed: {e}")
            return
        }
    }

    // Wait for the reply, but not forever. A handshake that gets no answer is
    // retried by `next_action`; here the deadline just stops the demo hanging.
    let ready = match net_wait([socket], grasmwire.rekey_attempt_ms()) {
        Ok(hs) -> hs
        Err(_e) -> []
    }
    if ready.len() == 0 {
        print("[connect] no reply within {grasmwire.rekey_attempt_ms()}ms")
        return
    }
    var reply = match udp_recv(socket) {
        Ok(b) -> b
        Err(e) -> {
            print("[connect] receive failed: {e}")
            return
        }
    }

    // A cookie reply where a handshake response was expected means the far
    // side is under load. It is not a failure: the same message goes back out
    // with mac2 filled in, and nothing else about the handshake changes.
    if reply.len() == noise.cookie_reply_len() and reply.at(0) == noise.type_cookie() {
        match noise.consume_cookie_reply(peer_public, reply, mac1_of(handshake.message)) {
            Some(cookie) -> {
                print("[connect] the far side is under load and sent a cookie")
                let retry = noise.apply_mac2(handshake.message, cookie)
                match udp_send(socket, "127.0.0.1", peer_port, retry) {
                    Ok(_n) -> print("[connect] sent the same message again with mac2 on it")
                    Err(_e) -> {
                        print("[connect] the retry could not be sent")
                        return
                    }
                }
                let waited = match net_wait([socket], 10000) {
                    Ok(hs) -> hs
                    Err(_e) -> []
                }
                if waited.len() == 0 {
                    print("[connect] no reply to the cookie retry")
                    return
                }
                reply = match udp_recv(socket) {
                    Ok(b) -> b
                    Err(_e) -> {
                        print("[connect] could not read the reply to the retry")
                        return
                    }
                }
            }
            None -> {
                print("[connect] a cookie reply that did not open, giving up")
                return
            }
        }
    }
    print("[connect] got a {reply.len()}-byte reply")

    let finished = match noise.consume_response(handshake.state, reply, psk) {
        Ok(st) -> st
        Err(_e) -> {
            print("[connect] the reply did not authenticate")
            return
        }
    }
    let keys = noise.split(finished, true)
    print("[connect] handshake complete, session hash {hex(noise.transcript(finished))}")

    // The far side's index comes off its reply; until a data packet arrives
    // there is nothing else to address one to.
    var session = grasmwire.session_of(keys, my_index, index_of(reply), now_millis(), true)

    // Three packets through the tunnel, each echoed back. What is checked is
    // that what comes home is what went out — end to end, through a real
    // socket, under keys neither side sent.
    var sent_count = 0
    var returned_count = 0
    for i in 0..3 {
        let payload = sample_packet(i)
        match grasmwire.seal_data(session, payload) {
            Ok(datagram) -> {
                match udp_send(socket, "127.0.0.1", peer_port, datagram) {
                    Ok(_n) -> {
                        sent_count = sent_count + 1
                        print("[connect] sent packet {i}: {payload.len()} bytes became {datagram.len()} on the wire")
                    }
                    Err(_e) -> print("[connect] packet {i} could not be sent")
                }
                let back = match net_wait([socket], 5000) {
                    Ok(hs) -> hs
                    Err(_e) -> []
                }
                if back.len() > 0 {
                    match udp_recv(socket) {
                        Ok(echo) -> {
                            match grasmwire.open_data(session, echo, now_millis()) {
                                Ok(opened) -> {
                                    let plain = grasmwire.unpad(opened)
                                    if hex(plain) == hex(payload) {
                                        returned_count = returned_count + 1
                                        print("[connect] packet {i} came back byte for byte")
                                    } else {
                                        print("[connect] packet {i} came back changed")
                                    }
                                }
                                Err(_e) -> print("[connect] packet {i}'s echo did not authenticate")
                            }
                        }
                        Err(_e) -> print("[connect] packet {i}'s echo could not be read")
                    }
                }
            }
            Err(_e) -> print("[connect] packet {i} could not be sealed")
        }
    }

    // Replay the first message, exactly as it was sent. A network observer
    // could have recorded it; the far side must refuse it on its timestamp
    // even though every signature and tag in it is genuine.
    match udp_send(socket, "127.0.0.1", peer_port, handshake.message) {
        Ok(_n) -> print("[connect] replayed the original first message, which should be refused")
        Err(_e) -> print("[connect] could not replay")
    }

    // A rekey, for real. A session expires after three minutes and must be
    // replaced before it does, so this is not an exceptional path — it is what
    // a long-lived tunnel spends most of its life doing. A *new* ephemeral and
    // a *newer* timestamp: reusing either would make this a replay, which the
    // far side has just been shown to refuse.
    var rekeyed = false
    let second: Initiation ! HandshakeError = noise.initiate(private, public, peer_public,
        ephemeral(), grasmwire.stamp(now_millis() + 1000), session_index())
    match second {
        Ok(again) -> {
            match udp_send(socket, "127.0.0.1", peer_port, again.message) {
                Ok(_n) -> print("[connect] sent a second handshake to replace the session")
                Err(_e) -> print("[connect] the rekey could not be sent")
            }
            let waiting = match net_wait([socket], 10000) {
                Ok(hs) -> hs
                Err(_e) -> []
            }
            if waiting.len() > 0 {
                match udp_recv(socket) {
                    Ok(reply2) -> {
                        match noise.consume_response(again.state, reply2, psk) {
                            Ok(done2) -> {
                                let fresh_keys = noise.split(done2, true)
                                print("[connect] rekeyed, new session hash {hex(noise.transcript(done2))}")
                                // The new keys must differ from the old ones,
                                // or the rekey bought nothing.
                                if hex(fresh_keys.sending) != hex(keys.sending) {
                                    print("[connect] the new keys are different from the old ones")
                                }
                                var next_session = grasmwire.session_of(fresh_keys,
                                    session_index(), index_of(reply2), now_millis(), true)
                                let payload = sample_packet(7)
                                match grasmwire.seal_data(next_session, payload) {
                                    Ok(d) -> {
                                        match udp_send(socket, "127.0.0.1", peer_port, d) {
                                            Ok(_m) -> {}
                                            Err(_e) -> print("[connect] could not send under the new key")
                                        }
                                        let back = match net_wait([socket], 5000) {
                                            Ok(hs) -> hs
                                            Err(_e) -> []
                                        }
                                        if back.len() > 0 {
                                            match udp_recv(socket) {
                                                Ok(echo) -> {
                                                    match grasmwire.open_data(next_session, echo, now_millis()) {
                                                        Ok(op) -> {
                                                            if hex(grasmwire.unpad(op)) == hex(payload) {
                                                                rekeyed = true
                                                                print("[connect] a packet under the new key came back byte for byte")
                                                            }
                                                        }
                                                        Err(_e) -> print("[connect] the echo under the new key did not authenticate")
                                                    }
                                                }
                                                Err(_e) -> print("[connect] no echo under the new key")
                                            }
                                        }
                                    }
                                    Err(_e) -> print("[connect] could not seal under the new key")
                                }
                            }
                            Err(_e) -> print("[connect] the rekey reply did not authenticate")
                        }
                    }
                    Err(_e) -> print("[connect] no rekey reply")
                }
            } else {
                print("[connect] no rekey reply within ten seconds")
            }
        }
        Err(_e) -> print("[connect] could not build a second handshake")
    }

    print("[connect] {sent_count} sent, {returned_count} returned intact")
    if returned_count == 3 and rekeyed {
        print("[connect] TUNNEL OK")
    }
}

/// The side that waits, and never speaks to anyone it cannot already name.
fn run_responder(socket: i64, private: bytes, public: bytes, peer_public: bytes,
    psk: bytes, peer_port: i64, under_load: bool) / {io, net} {
    // The secret that keys the cookies, and the one before it.
    //
    // A cookie is a bearer token for an address, so the secret expires — that
    // is what bounds how long a stolen one is worth having. Keeping the
    // previous secret for one more period is not sloppiness: a cookie issued
    // a moment before a rotation would otherwise be refused a moment after
    // one, and the peer holding it did nothing wrong.
    var cookie_secret = fresh_secret()
    var previous_secret = cookie_secret
    var secret_born = now_millis()
    let ready = match net_wait([socket], grasmwire.rekey_attempt_ms()) {
        Ok(hs) -> hs
        Err(_e) -> []
    }
    if ready.len() == 0 {
        print("[listen] nobody called")
        return
    }

    // Where the peer is, learned rather than configured. `peer_port` is only
    // the fallback for the case where nothing has been heard yet.
    var host = "127.0.0.1"
    var port = peer_port

    let first = match udp_recv_from(socket) {
        Ok(got) -> {
            host = got.1
            port = got.2
            got.0
        }
        Err(e) -> {
            print("[listen] receive failed: {e}")
            return
        }
    }
    print("[listen] got a {first.len()}-byte first message from {host}:{port}")

    var opening = first
    if under_load {
        // No state is created here. The cookie is a keyed hash of the address
        // the packet came from, sealed to whoever is at that address, and the
        // responder forgets it the moment the datagram is sent.
        if grasmwire.cookie_secret_stale(secret_born, now_millis()) {
            previous_secret = cookie_secret
            cookie_secret = fresh_secret()
            secret_born = now_millis()
            print("[listen] rotated the cookie secret")
        }
        let cookie = noise.cookie_of(cookie_secret, "{host}:{port}")
        let nonce = match random_bytes(24) {
            Ok(b) -> b
            Err(_e) -> panic("no randomness for a cookie nonce")
        }
        let their_mac1 = mac1_of(first)
        match udp_send(socket, host, port, noise.cookie_reply(public, cookie, 0, nonce, their_mac1)) {
            Ok(_n) -> print("[listen] under load: answered with a cookie and stored nothing")
            Err(_e) -> print("[listen] the cookie reply could not be sent")
        }
        // Now wait for the message to come back carrying mac2.
        let again = match net_wait([socket], 10000) {
            Ok(hs) -> hs
            Err(_e) -> []
        }
        if again.len() == 0 {
            print("[listen] the caller did not come back with a cookie")
            return
        }
        match udp_recv_from(socket) {
            Ok(got) -> {
                opening = got.0
                host = got.1
                port = got.2
            }
            Err(_e) -> {
                print("[listen] could not read the second attempt")
                return
            }
        }
        let current_ok = noise.check_mac2(opening, noise.cookie_of(cookie_secret, "{host}:{port}"))
        let previous_ok = noise.check_mac2(opening, noise.cookie_of(previous_secret, "{host}:{port}"))
        if not current_ok and not previous_ok {
            print("[listen] the second attempt had no valid mac2, refused")
            return
        }
        print("[listen] the second attempt carries a valid mac2, proceeding")
    }

    let incoming = match noise.consume_initiation(private, public, opening) {
        Ok(i) -> i
        Err(_e) -> {
            // Silence. A responder that answered a bad packet would confirm
            // it is there, and would be a way to send traffic to a third
            // party by writing their address on a datagram.
            print("[listen] refused, and said nothing to the sender")
            return
        }
    }

    // The initiator proved it holds the private half of a key. Whether that
    // key is *allowed* is a separate question and this is where it is asked.
    if hex(incoming.initiator_static) != hex(peer_public) {
        print("[listen] a valid handshake from an unknown key {short(incoming.initiator_static)}, refused")
        return
    }
    print("[listen] the caller is {short(incoming.initiator_static)}, which is on the list")

    let my_index = session_index()
    let reply = match noise.respond(incoming, ephemeral(), psk, my_index) {
        Ok(r) -> r
        Err(_e) -> {
            print("[listen] could not build a reply")
            return
        }
    }
    match udp_send(socket, host, port, reply.message) {
        Ok(n) -> print("[listen] sent a {n}-byte reply to {host}:{port}")
        Err(e) -> {
            print("[listen] reply failed: {e}")
            return
        }
    }
    let keys = noise.split(reply.state, false)
    print("[listen] handshake complete, session hash {hex(noise.transcript(reply.state))}")

    var session = grasmwire.session_of(keys, my_index, incoming.sender_index, now_millis(), false)

    // The greatest timestamp seen from this peer. A recorded first message
    // replayed later carries the *old* timestamp, so refusing anything that is
    // not strictly greater refuses the recording — and does it without keeping
    // a list of everything ever seen, which is the property that makes this
    // cheap enough to do for every peer.
    var newest = incoming.timestamp

    var echoed = 0
    var replays_refused = 0
    var moves = 0
    var rekeys = 0
    // Six datagrams are expected: three payloads, a replayed handshake, a
    // rekey, and one payload under the new key. The loop stops on silence
    // rather than on a count, so a run that goes wrong still says what it saw.
    var quiet = false
    for _i in 0..6 {
        if not quiet {
            let waiting = match net_wait([socket], 10000) {
                Ok(hs) -> hs
                Err(_e) -> []
            }
            if waiting.len() == 0 {
                print("[listen] nothing more arrived")
                quiet = true
            }
        }
        if not quiet {
            var datagram = bytes_of([])
            var from_host = host
            var from_port = port
            match udp_recv_from(socket) {
                Ok(got) -> {
                    datagram = got.0
                    from_host = got.1
                    from_port = got.2
                }
                Err(_e) -> {
                    print("[listen] a datagram could not be read")
                    return
                }
            }

            // Roaming, and the order here is the security property. The reply goes
            // to wherever this datagram came from, and the *remembered* endpoint
            // moves only once something has authenticated from there. Moving it on
            // an unauthenticated packet would let anyone redirect a live session by
            // spoofing a single datagram, which is a denial of service that costs
            // the attacker nothing.
            let moved = from_host != host or from_port != port

            if datagram.len() > 0 and datagram.at(0) == grasmwire.type_initiation() {
                // Another handshake. It may be a genuine rekey or a recording.
                match noise.consume_initiation(private, public, datagram) {
                    Ok(again) -> {
                        if grasmwire.later_than(again.timestamp, newest) {
                            newest = again.timestamp
                            // A rekey. The old session stays usable until the new
                            // one carries traffic — dropping it the moment a
                            // replacement is agreed would lose whatever is still
                            // in flight under the old key.
                            if hex(again.initiator_static) != hex(peer_public) {
                                print("[listen] a rekey from an unknown key, refused")
                            } else {
                                let next_index = session_index()
                                match noise.respond(again, ephemeral(), psk, next_index) {
                                    Ok(r2) -> {
                                        match udp_send(socket, from_host, from_port, r2.message) {
                                            Ok(_n) -> {
                                                if moved {
                                                    print("[listen] the peer moved to {from_host}:{from_port}")
                                                    moves = moves + 1
                                                }
                                                host = from_host
                                                port = from_port
                                                session = grasmwire.session_of(
                                                    noise.split(r2.state, false), next_index,
                                                    again.sender_index, now_millis(), false)
                                                rekeys = rekeys + 1
                                                print("[listen] rekeyed, new session hash {hex(noise.transcript(r2.state))}")
                                            }
                                            Err(_e) -> print("[listen] the rekey reply could not be sent")
                                        }
                                    }
                                    Err(_e) -> print("[listen] could not answer the rekey")
                                }
                            }
                        } else {
                            replays_refused = replays_refused + 1
                            print("[listen] a replayed handshake, refused on its timestamp")
                        }
                    }
                    Err(_e) -> print("[listen] a handshake that did not authenticate, dropped")
                }
            } else {
                match grasmwire.open_data(session, datagram, now_millis()) {
                    Ok(opened) -> {
                        // It authenticated, so this address is the peer's.
                        if moved {
                            print("[listen] the peer moved to {from_host}:{from_port}")
                            moves = moves + 1
                        }
                        host = from_host
                        port = from_port
                        let plain = grasmwire.unpad(opened)
                        if grasmwire.is_keepalive(plain) {
                            print("[listen] a keepalive")
                        } else {
                            print("[listen] {plain.len()} bytes out of the tunnel, sending them back")
                            match grasmwire.seal_data(session, plain) {
                                Ok(back) -> {
                                    match udp_send(socket, from_host, from_port, back) {
                                        Ok(_n) -> echoed = echoed + 1
                                        Err(_e) -> print("[listen] the echo could not be sent")
                                    }
                                }
                                Err(_e) -> print("[listen] the echo could not be sealed")
                            }
                        }
                    }
                    Err(_e) -> print("[listen] a datagram did not authenticate, dropped in silence")
                }
            }
        }
    }
    print("[listen] echoed {echoed}, refused {replays_refused} replayed handshake(s), rekeyed {rekeys} time(s), {moves} endpoint change(s)")
    if echoed == 4 and replays_refused == 1 and rekeys == 1 {
        print("[listen] TUNNEL OK")
    }
}

/// The `mac1` field of a first message: the sixteen bytes before `mac2`.
///
/// A cookie reply is sealed with this as its associated data, so it only opens
/// against the message that provoked it — which is what stops one being
/// replayed at a different handshake.
fn mac1_of(message: bytes) -> bytes {
    var out: [i64] = []
    for i in (message.len() - 32)..(message.len() - 16) {
        out.push(message.at(i))
    }
    bytes_of(out)
}

/// The sender index a reply carries, which is what a data packet must be
/// addressed to. Bytes four to seven, little-endian, same as every other
/// index on the wire.
fn index_of(message: bytes) -> i64 {
    if message.len() < 8 {
        return 0
    }
    var index = 0
    for i in 0..4 {
        index = index.bit_or(message.at(4 + i).shl(i * 8))
    }
    index
}

/// An IPv4 packet that declares its own length, which is what the padding
/// relies on and what a real tunnel would be carrying.
fn sample_packet(n: i64) -> bytes {
    var head = [69, 0, 0, 40, 0, n, 0, 0, 64, 6, 0, 0, 192, 168, 0, 1, 192, 168, 0, 2]
    for i in 0..20 {
        head.push((n * 20 + i).bit_and(255))
    }
    bytes_of(head)
}
