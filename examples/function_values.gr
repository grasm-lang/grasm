// Functions as data — and every line here compiles natively as well as
// running in the interpreter, which is the point.
//
//   grasm run   examples/function_values.gr
//   grasm build examples/function_values.gr --native -o fv && ./fv
//
// A named function and a closure share one representation: a code pointer
// plus a captured environment. That is why a list can hold either, and why
// calling one is the same indirect call in both cases.

fn inc(n: i64) -> i64 {
    n + 1
}

fn double(n: i64) -> i64 {
    n * 2
}

fn square(n: i64) -> i64 {
    n * n
}

/// Applies every function in `pipeline` to `seed`, in order.
fn run_pipeline(seed: i64, stages: [i64]) -> i64 {
    var acc = seed
    for s in stages {
        acc = acc + s
    }
    acc
}

fn main() {
    // A named function bound to a variable, then called through it.
    let f = inc
    print("{f(41)}")

    // Functions in a list, iterated and called indirectly.
    let stages = [inc, double, square]
    var acc = 3
    for stage in stages {
        acc = stage(acc)
    }
    print("3 -> {acc}")

    // A closure bound to a name.
    let halve = |n| n / 2
    print("{halve(84)}")

    // Closures capture by value at the moment they are created, so a later
    // change to the captured binding is not visible inside.
    var offset = 10
    let shift = |n| n + offset
    offset = 1000
    print("{shift(5)} offset={offset}")

    // Captures may be boxed values, and outlive the scope they came from.
    let label = "result"
    let describe = |n| "{label}: {n}"
    print(describe(7))

    // Printing a function value says which one it is.
    print("{f}")
    print("{halve}")

    let totals = [1, 2, 3]
    print("{run_pipeline(0, totals)}")

    // A named function passed to a combinator, which is the way most people
    // reach for first. The backend used to require a closure written at the
    // call site and refuse this, so `xs.map(square)` compiled only under the
    // interpreter.
    let ns = [1, 2, 3, 4, 5]
    print("{ns.map(square)}")
    print("{ns.filter(is_even)}")
    print("{ns.any(is_even)} {ns.all(is_even)}")
    print("{ns.find(is_even) ?? -1}")
    print("{ns.par_map(square)}")
    print("{ns.par_filter(is_even)}")
    print("{mixed()}")
}

fn is_even(n: i64) -> bool {
    n % 2 == 0
}

/// A list holding a named function and a closure together.
///
/// The annotation is doing real work: nothing in `|n| n + 100` says what `n`
/// is, and inside a list there is no call site to learn it from. Naming the
/// element type once is what makes both spellings usable in one place.
fn mixed() -> i64 {
    let fs: [fn(i64) -> i64] = [double, |n| n + 100]
    var total = 0
    for f in fs {
        total = total + f(1)
    }
    total
}
