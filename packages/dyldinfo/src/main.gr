// Mach-O rebase and bind opcodes (LC_DYLD_INFO): fixups before chained
// fixups.
//
// Every binary built for macOS 11 and earlier, and every one built by a
// linker that predates chained fixups, tells dyld what to patch with four
// byte-code streams: rebases (pointers to slide), binds (pointers to fill
// with a symbol's address), lazy binds (stubs filled on first call) and
// weak binds (definitions to coalesce). The opcodes set a segment and
// offset, a type, a library ordinal (or a special one: this image, the
// main executable, a flat lookup, a weak lookup), a symbol with flags
// (weak import, non-weak definition) and an addend, then perform one
// fixup or a run of them -- n times, or n times skipping a stride.
//
// `fixups` decodes every stream; `describe` prints the fixups as
// `dyld_info -fixups` does: binds, then lazy binds, then rebases (with the
// pointer each rebase finds in the file as its target).
import machoread
import chainedfixups

type DyldFixup = { kind: str, address: i64, ordinal: i64, symbol: str, addend: i64, weak_import: bool, target: i64, bind_type: i64 }

type DyldInfoError =
    | DyldInfoMalformed(why: str)
    | DyldInfoMissing()

fn le(d: bytes, at: i64, n: i64) -> i64 ! DyldInfoError {
    if at < 0 or at + n > d.len() {
        fail(DyldInfoMalformed("a read past the end at {at}"))
    }
    var v = 0
    for k in 0..n {
        v = v.shl(8).bit_or(d.at(at + n - 1 - k))
    }
    return v
}

fn uleb(d: bytes, p0: i64) -> (i64, i64) ! DyldInfoError {
    var v = 0
    var shift = 0
    var p = p0
    while true {
        let b = try le(d, p, 1)
        p = p + 1
        if shift < 64 {
            v = v.bit_or(b.bit_and(127).shl(shift))
        }
        shift = shift + 7
        if b < 128 {
            break
        }
    }
    return (v, p)
}

fn sleb(d: bytes, p0: i64) -> (i64, i64) ! DyldInfoError {
    var v = 0
    var shift = 0
    var p = p0
    var b = 128
    while b >= 128 {
        b = try le(d, p, 1)
        p = p + 1
        if shift < 64 {
            v = v.bit_or(b.bit_and(127).shl(shift))
        }
        shift = shift + 7
    }
    if shift < 64 and b.bit_and(64) != 0 {
        v = v.bit_or((0 - 1).shl(shift))
    }
    return (v, p)
}

fn cstr(d: bytes, p: i64) -> (str, i64) ! DyldInfoError {
    var e = p
    while e < d.len() and d.at(e) != 0 {
        e = e + 1
    }
    if e >= d.len() {
        fail(DyldInfoMalformed("an unterminated symbol name"))
    }
    return (d.slice(p, e).to_str(), e + 1)
}

type DyldState = { seg: i64, offset: i64, ordinal: i64, symbol: str, flags: i64, addend: i64 }

fn address(segs: [MachSeg], st: DyldState) -> i64 ! DyldInfoError {
    if st.seg < 0 or st.seg >= segs.len() {
        fail(DyldInfoMalformed("a segment {st.seg} that is not there"))
    }
    return segs[st.seg].vmaddr + st.offset
}

fn pointer_at(image: bytes, at: i64, segs: [MachSeg], addr: i64) -> i64 ! DyldInfoError {
    for s in segs {
        if addr >= s.vmaddr and s.name != "__PAGEZERO" {
            let off = at + s.fileoff + (addr - s.vmaddr)
            if off + 8 <= image.len() {
                return try le(image, off, 8)
            }
        }
    }
    return 0
}

fn rebases(image: bytes, at: i64, d: bytes, segs: [MachSeg], inout out: [DyldFixup]) -> () ! DyldInfoError {
    var st = DyldState{ seg: 0, offset: 0, ordinal: 0, symbol: "", flags: 0, addend: 0 }
    var p = 0
    while p < d.len() {
        let b = d.at(p)
        p = p + 1
        let op = b.bit_and(240)
        let imm = b.bit_and(15)
        var times = 0
        var skip = 0
        if op == 0 {
            break
        } else if op == 16 {
            continue
        } else if op == 32 {
            st.seg = imm
            let (v, q) = try uleb(d, p)
            st.offset = v
            p = q
        } else if op == 48 {
            let (v, q) = try uleb(d, p)
            st.offset = st.offset + v
            p = q
        } else if op == 64 {
            st.offset = st.offset + imm * 8
        } else if op == 80 {
            times = imm
        } else if op == 96 {
            let (v, q) = try uleb(d, p)
            times = v
            p = q
        } else if op == 112 {
            let (v, q) = try uleb(d, p)
            times = 1
            skip = v
            p = q
        } else if op == 128 {
            let (n, q) = try uleb(d, p)
            let (v, q2) = try uleb(d, q)
            times = n
            skip = v
            p = q2
        } else {
            fail(DyldInfoMalformed("a rebase opcode {op}"))
        }
        for _k in 0..times {
            let a = try address(segs, st)
            out.push(DyldFixup{ kind: "rebase", address: a, ordinal: 0, symbol: "", addend: 0, weak_import: false, target: try pointer_at(image, at, segs, a),
                bind_type: 1 })
            st.offset = st.offset + 8 + skip
        }
    }
}

fn binds(d: bytes, kind: str, segs: [MachSeg], inout out: [DyldFixup]) -> () ! DyldInfoError {
    var st = DyldState{ seg: 0, offset: 0, ordinal: 0, symbol: "", flags: 0, addend: 0 }
    var bind_type = 1
    var p = 0
    while p < d.len() {
        let b = d.at(p)
        p = p + 1
        let op = b.bit_and(240)
        let imm = b.bit_and(15)
        var times = 0
        var skip = 0
        if op == 0 {
            if kind == "lazy-bind" {
                continue
            }
            break
        } else if op == 16 {
            st.ordinal = imm
        } else if op == 32 {
            let (v, q) = try uleb(d, p)
            st.ordinal = v
            p = q
        } else if op == 48 {
            st.ordinal = if imm == 0 { 0 } else { imm.bit_or(240) - 256 }
        } else if op == 64 {
            st.flags = imm
            let (name, q) = try cstr(d, p)
            st.symbol = name
            p = q
            // A definition that is not weak binds nothing: it tells dyld
            // to prefer this image's copy over every weak one.
            if kind == "weak-bind" and imm.bit_and(8) != 0 {
                out.push(DyldFixup{ kind: "strong", address: 0, ordinal: 0, symbol: name, addend: 0, weak_import: false, target: 0, bind_type: 0 })
            }
        } else if op == 80 {
            bind_type = imm
        } else if op == 96 {
            let (v, q) = try sleb(d, p)
            st.addend = v
            p = q
        } else if op == 112 {
            st.seg = imm
            let (v, q) = try uleb(d, p)
            st.offset = v
            p = q
        } else if op == 128 {
            let (v, q) = try uleb(d, p)
            st.offset = st.offset + v
            p = q
        } else if op == 144 {
            times = 1
        } else if op == 160 {
            let (v, q) = try uleb(d, p)
            times = 1
            skip = v
            p = q
        } else if op == 176 {
            times = 1
            skip = imm * 8
        } else if op == 192 {
            let (n, q) = try uleb(d, p)
            let (v, q2) = try uleb(d, q)
            times = n
            skip = v
            p = q2
        } else {
            fail(DyldInfoMalformed("a bind opcode {op}"))
        }
        for _k in 0..times {
            out.push(DyldFixup{ kind: kind, address: try address(segs, st), ordinal: st.ordinal, symbol: st.symbol, addend: st.addend,
                weak_import: st.flags.bit_and(1) != 0, target: 0, bind_type: bind_type })
            st.offset = st.offset + 8 + skip
        }
    }
}

/// The LC_DYLD_INFO ranges: rebase, bind, weak bind, lazy bind.
fn ranges(image: bytes, at: i64) -> [(i64, i64)] ! DyldInfoError {
    for c in machoread.commands(image, at) ?? fail(DyldInfoMalformed("bad load commands")) {
        if c.kind == 34 or c.kind == 2147483682 {
            var out: [(i64, i64)] = []
            for k in 0..4 {
                out.push((try le(image, c.at + 8 + 8 * k, 4), try le(image, c.at + 12 + 8 * k, 4)))
            }
            return out
        }
    }
    fail(DyldInfoMissing())
}

fn stream(image: bytes, at: i64, r: (i64, i64)) -> bytes ! DyldInfoError {
    if r.1 == 0 {
        return bytes_of([])
    }
    if at + r.0 + r.1 > image.len() {
        fail(DyldInfoMalformed("opcodes past the end of the file"))
    }
    return image.slice(at + r.0, at + r.0 + r.1)
}

/// Every fixup, as dyld_info lists them: binds, weak binds, lazy binds,
/// then rebases.
pub fn fixups(image: bytes, at: i64) -> [DyldFixup] ! DyldInfoError {
    let rs = try ranges(image, at)
    let segs = chainedfixups.segments_of(image, at) ?? fail(DyldInfoMalformed("segments"))
    var out: [DyldFixup] = []
    try binds(try stream(image, at, rs[1]), "bind", segs, out)
    try binds(try stream(image, at, rs[3]), "lazy-bind", segs, out)
    try rebases(image, at, try stream(image, at, rs[0]), segs, out)
    return out
}

/// The weak-bind stream on its own: the places to coalesce with other
/// images' weak definitions, and (kind "strong") the symbols this image
/// defines strongly, which win over every weak copy.
pub fn weak_binds(image: bytes, at: i64) -> [DyldFixup] ! DyldInfoError {
    let rs = try ranges(image, at)
    let segs = chainedfixups.segments_of(image, at) ?? fail(DyldInfoMalformed("segments"))
    var out: [DyldFixup] = []
    try binds(try stream(image, at, rs[2]), "weak-bind", segs, out)
    return out
}

fn hex(v: i64, width: i64) -> str {
    let digits = "0123456789ABCDEF"
    var s = ""
    var n = 0
    while n < 16 and (n < width or v.ushr(4 * n) != 0) {
        s = digits.substr(v.ushr(4 * n).bit_and(15), 1) + s
        n = n + 1
    }
    return s
}

fn pad(s: str, n: i64) -> str {
    return if s.len() >= n { s } else { s + " ".repeat(n - s.len()) }
}

/// The segment and section an address lies in.
fn place(segs: [MachSeg], address: i64) -> (str, str) {
    var seg = segs[0]
    for s in segs {
        if address >= s.vmaddr {
            seg = s
        }
    }
    var sect = ""
    for (name, addr, size) in seg.sections {
        if address >= addr and address < addr + size {
            sect = name
        }
    }
    return (seg.name, sect)
}

/// The fixups as `dyld_info -fixups` prints them.
pub fn describe(image: bytes, at: i64) -> [str] ! DyldInfoError {
    let segs = chainedfixups.segments_of(image, at) ?? fail(DyldInfoMalformed("segments"))
    let libs = chainedfixups.library_names(image, at) ?? fail(DyldInfoMalformed("libraries"))
    var out: [str] = []
    for f in try fixups(image, at) {
        let (seg_name, sect) = place(segs, f.address)
        let lib = if f.ordinal == 0 { "<this-image>" } else if f.ordinal == 0 - 1 { "<main-executable>" } else if f.ordinal == 0 - 2 { "<flat-namespace>" }
        else if f.ordinal == 0 - 3 { "<weak-def-coalesce>" } else if f.ordinal >= 1 and f.ordinal <= libs.len() { libs[f.ordinal - 1] } else { "<ordinal {f.ordinal}>" }
        let target = if f.kind == "rebase" { "0x" + hex(f.target, 8) }
        else { lib + "/" + f.symbol + (if f.addend != 0 { " + 0x" + hex(f.addend, 1) } else { "" }) + if f.weak_import { " [weak-import]" } else { "" } }
        out.push(pad(seg_name, 15) + " " + pad(sect, 16) + " 0x" + hex(f.address, 8) + " " + " ".repeat(13 - f.kind.len()) + f.kind + "  " + target)
    }
    return out
}

/// The weak-bind table as `objdump --macho --weak-bind` prints it, its
/// heading line included.
pub fn describe_weak(image: bytes, at: i64) -> [str] ! DyldInfoError {
    let segs = chainedfixups.segments_of(image, at) ?? fail(DyldInfoMalformed("segments"))
    var out = ["segment  section            address     type       addend   symbol"]
    for f in try weak_binds(image, at) {
        if f.kind == "strong" {
            out.push(" ".repeat(40) + "strong" + " ".repeat(14) + f.symbol)
            continue
        }
        let (seg_name, sect) = place(segs, f.address)
        let kind = if f.bind_type == 1 { "pointer" } else if f.bind_type == 2 { "text abs32" } else if f.bind_type == 3 { "text rel32" } else { "unknown" }
        let n = "{f.addend}"
        let addend = if n.len() >= 8 { n } else { " ".repeat(8 - n.len()) + n }
        out.push(pad(seg_name, 8) + " " + pad(sect, 18) + " 0x" + hex(f.address, 8) + " " + pad(kind, 8) + " " + addend + "   " + f.symbol)
    }
    return out
}
