// The Grasm side of scripts/packet_diff.py: arguments in threes -- an
// operation and two hex fields, each with a leading `x` -- and one answer
// each. `<proto>` decodes a packet scapy built and prints its fields;
// `<proto>.rt` decodes and re-encodes it, which must give scapy's bytes
// back, checksums and lengths included.
import icmp
import icmpv6
import arp
import vlan
import gre
import vxlan
import geneve
import sllcap

fn from_hex(text: str) -> bytes {
    var out: [i64] = []
    var i = 1
    while i + 1 < text.len() {
        out.push(text.substr(i, 2).parse_int_base(16) ?? 0)
        i = i + 2
    }
    bytes_of(out)
}

fn hex(raw: bytes) -> str {
    let digits = "0123456789abcdef"
    var out = ""
    var i = 0
    while i < raw.len() {
        out = out + digits.substr(raw.at(i) / 16, 1) + digits.substr(raw.at(i) % 16, 1)
        i = i + 1
    }
    out
}

fn flag(b: bool) -> str {
    if b { "1" } else { "0" }
}

fn answer_icmp(what: str, a: bytes, b: bytes) -> str {
    if what.starts_with("icmpv6") {
        let src = b.slice(0, 16)
        let dst = b.slice(16, 32)
        return match icmpv6.decode(a) {
            Err(_) -> "ERR"
            Ok(m) -> {
                if what == "icmpv6.rt" {
                    return hex(icmpv6.encode(m, src, dst))
                }
                var opts: [str] = []
                match icmpv6.nd_options(m) {
                    Ok(list) -> {
                        for o in list {
                            opts.push("{o.kind}:{o.length}:{hex(o.data)}")
                        }
                    }
                    Err(_) -> opts.push("ERR")
                }
                "type={m.kind};code={m.code};cksum={m.checksum};body={hex(m.body)};ok=" +
                flag(icmpv6.checksum_holds(a, src, dst)) + ";opts=" + opts.join("|")
            }
        }
    }
    match icmp.decode(a) {
        Err(_) -> "ERR"
        Ok(m) -> {
            if what == "icmp.rt" {
                return hex(icmp.encode(m))
            }
            var typed = ""
            if m.kind == 0 or m.kind == 8 {
                typed = ";id={icmp.echo_id(m)};seq={icmp.echo_seq(m)}"
            }
            "type={m.kind};code={m.code};chksum={m.checksum};rest={hex(m.rest)};body={hex(m.body)};ok=" +
            flag(icmp.checksum_holds(a)) + typed
        }
    }
}

fn answer_link(what: str, a: bytes) -> str {
    if what.starts_with("arp") {
        return match arp.decode(a) {
            Err(_) -> "ERR"
            Ok(p) -> if what == "arp.rt" {
                hex(arp.encode(p))
            } else {
                "hwtype={p.hwtype};ptype={p.ptype};hwlen={p.hwlen};plen={p.plen};op={p.op};" +
                "hwsrc={hex(p.hwsrc)};psrc={hex(p.psrc)};hwdst={hex(p.hwdst)};pdst={hex(p.pdst)}"
            }
        }
    }
    if what.starts_with("vlan") {
        return match vlan.tags(a) {
            Err(_) -> "ERR"
            Ok(found) -> {
                var parts: [str] = []
                // The addresses and the first type, then each tag's TCI and
                // inner type -- which is the next tag's TPID.
                var again = a.slice(0, 14)
                for t in found.0 {
                    parts.push("{t.tpid}:{t.prio}:{t.dei}:{t.vlan}:{t.inner_type}")
                    again = again.concat(vlan.encode(t))
                }
                if what == "vlan.rt" {
                    return hex(again.concat(a.slice(found.1, a.len())))
                }
                "tags=" + parts.join("|") + ";payload_at={found.1}"
            }
        }
    }
    if what.starts_with("sll2") {
        return sll_text(what, sllcap.decode_v2(a))
    }
    sll_text(what, sllcap.decode_v1(a))
}

fn sll_text(what: str, r: SllHeader ! SllError) -> str {
    match r {
        Err(_) -> "ERR"
        Ok(h) -> if what.ends_with(".rt") {
            hex(sllcap.encode(h))
        } else {
            "pkttype={h.pkttype};lladdrtype={h.lladdrtype};lladdrlen={h.lladdrlen};src={hex(h.src)};" +
            "proto={h.proto};ifindex={h.ifindex};reserved={h.reserved};payload={hex(h.payload)}"
        }
    }
}

fn answer_tunnel(what: str, a: bytes) -> str {
    if what.starts_with("gre") {
        return match gre.decode(a) {
            Err(_) -> "ERR"
            Ok(h) -> if what == "gre.rt" {
                hex(gre.encode(h))
            } else {
                "chksum_present={h.chksum_present};routing_present={h.routing_present};" +
                "key_present={h.key_present};seqnum_present={h.seqnum_present};" +
                "strict_route_source={h.strict_route_source};recursion_control={h.recursion_control};" +
                "flags={h.flags};version={h.version};proto={h.proto};chksum={h.chksum};" +
                "offset={h.offset};key={h.key};sequence_number={h.sequence_number};payload={hex(h.payload)}"
            }
        }
    }
    if what.starts_with("vxlan") {
        return match vxlan.decode(a) {
            Err(_) -> "ERR"
            Ok(h) -> if what == "vxlan.rt" {
                hex(vxlan.encode(h))
            } else {
                "flags={h.flags};vni={h.vni};payload={hex(h.payload)}"
            }
        }
    }
    match geneve.decode(a) {
        Err(_) -> "ERR"
        Ok(h) -> if what == "geneve.rt" {
            hex(geneve.encode(h))
        } else {
            var opts: [str] = []
            for o in h.options {
                opts.push("{o.classid}:{o.kind}:{o.reserved}:{hex(o.data)}")
            }
            "version={h.version};oam={h.oam};critical={h.critical};reserved={h.reserved};" +
            "proto={h.proto};vni={h.vni};reserved2={h.reserved2};options=" + opts.join("|") +
            ";payload={hex(h.payload)}"
        }
    }
}

fn answer(what: str, a: bytes, b: bytes) -> str {
    if what.starts_with("icmp") {
        return answer_icmp(what, a, b)
    }
    if what.starts_with("arp") or what.starts_with("vlan") or what.starts_with("sll") {
        return answer_link(what, a)
    }
    answer_tunnel(what, a)
}

fn main() / {io} {
    let argv = args()
    var i = 0
    while i + 2 < argv.len() {
        print(answer(argv[i], from_hex(argv[i + 1]), from_hex(argv[i + 2])))
        i = i + 3
    }
}
