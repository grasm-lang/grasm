// DES and Triple DES (TDEA), with ECB and CBC -- Go's `crypto/des`.
//
// ## Legacy. Read with it; do not choose it.
//
// Single DES has a 56-bit key and was searched exhaustively in 1998. Triple
// DES survives by running it three times, but its 64-bit block makes a
// collision likely after about 32 GiB under one key (Sweet32, 2016), and
// NIST withdrew it at the end of 2023. It is here because a great deal that
// is still read was written with it: PKCS#12 files from older tools, EMV
// payment cards, Kerberos' `des3-cbc-sha1`, LM and NTLM hashes, smart cards,
// and every `openssl` invocation that once said `-des3`. Anything new
// belongs in `aes`.
//
// ## The tables
//
// Taken from Go's `crypto/des`, the implementation this is checked against,
// in its convention: an entry names a bit of the input counted from the
// least significant end, and the table's first entry fills the most
// significant bit of the output. FIPS 46-3 counts from the other end and
// from one; `57` there is `7` here. Writing them in the reference's
// convention is what lets a mistyped entry be found by comparing the two
// files rather than by staring.
//
// A 64-bit block lives in an `i64` as the same bits. Every shift right that
// could see the sign bit is `ushr`.

type DesCipher = {
    /// One schedule of sixteen 48-bit subkeys for DES, three for TDEA.
    schedules: [[i64]],
}

type DesError =
    | KeyLength(got: i64)
    | BlockLength(got: i64)
    | IvLength(got: i64)
    | NotWholeBlocks(got: i64)

fn initial_permutation() -> [i64] {
    [6, 14, 22, 30, 38, 46, 54, 62, 4, 12, 20, 28, 36, 44, 52, 60,
        2, 10, 18, 26, 34, 42, 50, 58, 0, 8, 16, 24, 32, 40, 48, 56,
        7, 15, 23, 31, 39, 47, 55, 63, 5, 13, 21, 29, 37, 45, 53, 61,
        3, 11, 19, 27, 35, 43, 51, 59, 1, 9, 17, 25, 33, 41, 49, 57]
}

fn final_permutation() -> [i64] {
    [24, 56, 16, 48, 8, 40, 0, 32, 25, 57, 17, 49, 9, 41, 1, 33,
        26, 58, 18, 50, 10, 42, 2, 34, 27, 59, 19, 51, 11, 43, 3, 35,
        28, 60, 20, 52, 12, 44, 4, 36, 29, 61, 21, 53, 13, 45, 5, 37,
        30, 62, 22, 54, 14, 46, 6, 38, 31, 63, 23, 55, 15, 47, 7, 39]
}

fn expansion() -> [i64] {
    [0, 31, 30, 29, 28, 27, 28, 27, 26, 25, 24, 23, 24, 23, 22, 21,
        20, 19, 20, 19, 18, 17, 16, 15, 16, 15, 14, 13, 12, 11, 12, 11,
        10, 9, 8, 7, 8, 7, 6, 5, 4, 3, 4, 3, 2, 1, 0, 31]
}

fn permutation() -> [i64] {
    [16, 25, 12, 11, 3, 20, 4, 15, 31, 17, 9, 6, 27, 14, 1, 22,
        30, 24, 8, 18, 0, 5, 29, 23, 13, 19, 2, 26, 10, 21, 28, 7]
}

fn choice1() -> [i64] {
    [7, 15, 23, 31, 39, 47, 55, 63, 6, 14, 22, 30, 38, 46, 54, 62,
        5, 13, 21, 29, 37, 45, 53, 61, 4, 12, 20, 28, 1, 9, 17, 25,
        33, 41, 49, 57, 2, 10, 18, 26, 34, 42, 50, 58, 3, 11, 19, 27,
        35, 43, 51, 59, 36, 44, 52, 60]
}

fn choice2() -> [i64] {
    [42, 39, 45, 32, 55, 51, 53, 28, 41, 50, 35, 46, 33, 37, 44, 52,
        30, 48, 40, 49, 29, 36, 43, 54, 15, 4, 25, 19, 9, 1, 26, 16,
        5, 11, 23, 8, 12, 7, 17, 0, 22, 3, 10, 14, 6, 20, 27, 24]
}

fn rotations() -> [i64] {
    [1, 1, 2, 2, 2, 2, 2, 2, 1, 2, 2, 2, 2, 2, 2, 1]
}

/// The eight S-boxes, each four rows of sixteen, flattened: box `s`, row
/// `r`, column `c` is at `s * 64 + r * 16 + c`.
fn sboxes() -> [i64] {
    [14, 4, 13, 1, 2, 15, 11, 8, 3, 10, 6, 12, 5, 9, 0, 7,
        0, 15, 7, 4, 14, 2, 13, 1, 10, 6, 12, 11, 9, 5, 3, 8,
        4, 1, 14, 8, 13, 6, 2, 11, 15, 12, 9, 7, 3, 10, 5, 0,
        15, 12, 8, 2, 4, 9, 1, 7, 5, 11, 3, 14, 10, 0, 6, 13,
        15, 1, 8, 14, 6, 11, 3, 4, 9, 7, 2, 13, 12, 0, 5, 10,
        3, 13, 4, 7, 15, 2, 8, 14, 12, 0, 1, 10, 6, 9, 11, 5,
        0, 14, 7, 11, 10, 4, 13, 1, 5, 8, 12, 6, 9, 3, 2, 15,
        13, 8, 10, 1, 3, 15, 4, 2, 11, 6, 7, 12, 0, 5, 14, 9,
        10, 0, 9, 14, 6, 3, 15, 5, 1, 13, 12, 7, 11, 4, 2, 8,
        13, 7, 0, 9, 3, 4, 6, 10, 2, 8, 5, 14, 12, 11, 15, 1,
        13, 6, 4, 9, 8, 15, 3, 0, 11, 1, 2, 12, 5, 10, 14, 7,
        1, 10, 13, 0, 6, 9, 8, 7, 4, 15, 14, 3, 11, 5, 2, 12,
        7, 13, 14, 3, 0, 6, 9, 10, 1, 2, 8, 5, 11, 12, 4, 15,
        13, 8, 11, 5, 6, 15, 0, 3, 4, 7, 2, 12, 1, 10, 14, 9,
        10, 6, 9, 0, 12, 11, 7, 13, 15, 1, 3, 14, 5, 2, 8, 4,
        3, 15, 0, 6, 10, 1, 13, 8, 9, 4, 5, 11, 12, 7, 2, 14,
        2, 12, 4, 1, 7, 10, 11, 6, 8, 5, 3, 15, 13, 0, 14, 9,
        14, 11, 2, 12, 4, 7, 13, 1, 5, 0, 15, 10, 3, 9, 8, 6,
        4, 2, 1, 11, 10, 13, 7, 8, 15, 9, 12, 5, 6, 3, 0, 14,
        11, 8, 12, 7, 1, 14, 2, 13, 6, 15, 0, 9, 10, 4, 5, 3,
        12, 1, 10, 15, 9, 2, 6, 8, 0, 13, 3, 4, 14, 7, 5, 11,
        10, 15, 4, 2, 7, 12, 9, 5, 6, 1, 13, 14, 0, 11, 3, 8,
        9, 14, 15, 5, 2, 8, 12, 3, 7, 0, 4, 10, 1, 13, 11, 6,
        4, 3, 2, 12, 9, 5, 15, 10, 11, 14, 1, 7, 6, 0, 8, 13,
        4, 11, 2, 14, 15, 0, 8, 13, 3, 12, 9, 7, 5, 10, 6, 1,
        13, 0, 11, 7, 4, 9, 1, 10, 14, 3, 5, 12, 2, 15, 8, 6,
        1, 4, 11, 13, 12, 3, 7, 14, 10, 15, 6, 8, 0, 5, 9, 2,
        6, 11, 13, 8, 1, 4, 10, 7, 9, 5, 0, 15, 14, 2, 3, 12,
        13, 2, 8, 4, 6, 15, 11, 1, 10, 9, 3, 14, 5, 0, 12, 7,
        1, 15, 13, 8, 10, 3, 7, 4, 12, 5, 6, 11, 0, 14, 9, 2,
        7, 11, 4, 1, 9, 12, 14, 2, 0, 6, 10, 13, 15, 3, 5, 8,
        2, 1, 14, 7, 4, 10, 8, 13, 15, 12, 9, 0, 3, 5, 6, 11]
}

/// Bit `table[p]` of `src` becomes bit `len - 1 - p` of the result.
fn permute(src: i64, table: [i64]) -> i64 {
    let n = table.len()
    var out = 0
    var p = 0
    while p < n {
        let bit = src.ushr(table[p]).bit_and(1)
        out = out.bit_or(bit.shl(n - 1 - p))
        p = p + 1
    }
    out
}

fn rotl28(x: i64, n: i64) -> i64 {
    x.shl(n).bit_or(x.ushr(28 - n)).bit_and(268435455)
}

fn read64(b: bytes, at: i64) -> i64 {
    var v = 0
    for k in 0..8 {
        v = v.shl(8).bit_or(b.at(at + k))
    }
    v
}

fn write64(inout out: bytes, at: i64, v: i64) {
    for k in 0..8 {
        out.set(at + k, v.ushr(56 - 8 * k).bit_and(255))
    }
}

/// Sixteen 48-bit subkeys from one 8-byte key. The parity bits -- the low
/// bit of every byte -- are ignored, as every implementation ignores them.
fn schedule(key: bytes, at: i64) -> [i64] {
    let pc1 = choice1()
    let pc2 = choice2()
    let permuted = permute(read64(key, at), pc1)
    var c = permuted.ushr(28).bit_and(268435455)
    var d = permuted.bit_and(268435455)
    var keys: [i64] = []
    for r in rotations() {
        c = rotl28(c, r)
        d = rotl28(d, r)
        keys.push(permute(c.shl(28).bit_or(d), pc2))
    }
    keys
}

/// The round function: expand to 48 bits, mix in the subkey, substitute
/// through the eight boxes, permute.
fn feistel(r: i64, k: i64, e: [i64], p: [i64], s: [i64]) -> i64 {
    let x = permute(r, e).bit_xor(k)
    var out = 0
    for b in 0..8 {
        let six = x.ushr(42 - 6 * b).bit_and(63)
        let row = six.ushr(4).bit_and(2).bit_or(six.bit_and(1))
        let col = six.ushr(1).bit_and(15)
        out = out.shl(4).bit_or(s[b * 64 + row * 16 + col])
    }
    permute(out, p)
}

/// One DES pass over a 64-bit block; `decrypt` runs the subkeys backwards.
fn crypt64(block: i64, keys: [i64], decrypt: bool) -> i64 {
    let e = expansion()
    let p = permutation()
    let s = sboxes()
    let b = permute(block, initial_permutation())
    var left = b.ushr(32).bit_and(4294967295)
    var right = b.bit_and(4294967295)
    for round in 0..16 {
        let k = if decrypt { keys[15 - round] } else { keys[round] }
        let next = left.bit_xor(feistel(right, k, e, p, s))
        left = right
        right = next
    }
    permute(right.shl(32).bit_or(left), final_permutation())
}

/// A DES cipher from an 8-byte key.
pub fn new_cipher(key: bytes) -> DesCipher ! DesError {
    if key.len() != 8 {
        fail(KeyLength(key.len()))
    }
    DesCipher{ schedules: [schedule(key, 0)] }
}

/// A Triple DES cipher from a 24-byte key, run encrypt-decrypt-encrypt
/// with its three thirds. Two-key TDEA is the 16-byte key with its first
/// eight bytes repeated at the end; Go asks the caller to do that, and so
/// does this, so a 16-byte key is refused rather than guessed at.
pub fn new_triple(key: bytes) -> DesCipher ! DesError {
    if key.len() != 24 {
        fail(KeyLength(key.len()))
    }
    DesCipher{ schedules: [schedule(key, 0), schedule(key, 8), schedule(key, 16)] }
}

fn encrypt64(c: DesCipher, v: i64) -> i64 {
    if c.schedules.len() == 1 {
        return crypt64(v, c.schedules[0], false)
    }
    let a = crypt64(v, c.schedules[0], false)
    let b = crypt64(a, c.schedules[1], true)
    crypt64(b, c.schedules[2], false)
}

fn decrypt64(c: DesCipher, v: i64) -> i64 {
    if c.schedules.len() == 1 {
        return crypt64(v, c.schedules[0], true)
    }
    let a = crypt64(v, c.schedules[2], true)
    let b = crypt64(a, c.schedules[1], false)
    crypt64(b, c.schedules[0], true)
}

fn whole_blocks(data: bytes) -> () ! DesError {
    if data.len() % 8 != 0 {
        fail(NotWholeBlocks(data.len()))
    }
}

/// One 8-byte block.
pub fn encrypt_block(c: DesCipher, block: bytes) -> bytes ! DesError {
    if block.len() != 8 {
        fail(BlockLength(block.len()))
    }
    var out = bytes_filled(8, 0)
    write64(out, 0, encrypt64(c, read64(block, 0)))
    out
}

pub fn decrypt_block(c: DesCipher, block: bytes) -> bytes ! DesError {
    if block.len() != 8 {
        fail(BlockLength(block.len()))
    }
    var out = bytes_filled(8, 0)
    write64(out, 0, decrypt64(c, read64(block, 0)))
    out
}

/// ECB: every block alone. Equal plaintext blocks give equal ciphertext
/// blocks, which is why it is only for formats that already chose it.
pub fn encrypt_ecb(c: DesCipher, data: bytes) -> bytes ! DesError {
    try whole_blocks(data)
    var out = bytes_filled(data.len(), 0)
    var at = 0
    while at < data.len() {
        write64(out, at, encrypt64(c, read64(data, at)))
        at = at + 8
    }
    out
}

pub fn decrypt_ecb(c: DesCipher, data: bytes) -> bytes ! DesError {
    try whole_blocks(data)
    var out = bytes_filled(data.len(), 0)
    var at = 0
    while at < data.len() {
        write64(out, at, decrypt64(c, read64(data, at)))
        at = at + 8
    }
    out
}

/// CBC with an 8-byte IV. No padding is added or removed: the formats that
/// use DES disagree about padding, so the caller applies its own.
pub fn encrypt_cbc(c: DesCipher, iv: bytes, data: bytes) -> bytes ! DesError {
    if iv.len() != 8 {
        fail(IvLength(iv.len()))
    }
    try whole_blocks(data)
    var out = bytes_filled(data.len(), 0)
    var prev = read64(iv, 0)
    var at = 0
    while at < data.len() {
        prev = encrypt64(c, read64(data, at).bit_xor(prev))
        write64(out, at, prev)
        at = at + 8
    }
    out
}

pub fn decrypt_cbc(c: DesCipher, iv: bytes, data: bytes) -> bytes ! DesError {
    if iv.len() != 8 {
        fail(IvLength(iv.len()))
    }
    try whole_blocks(data)
    var out = bytes_filled(data.len(), 0)
    var prev = read64(iv, 0)
    var at = 0
    while at < data.len() {
        let block = read64(data, at)
        write64(out, at, decrypt64(c, block).bit_xor(prev))
        prev = block
        at = at + 8
    }
    out
}
