// MD4 (RFC 1320).
//
// ## Broken. Here for reading what was written with it.
//
// Collisions in MD4 are found by hand; it has been unfit for anything
// since 1995. It survives in old file formats and legacy Windows protocols,
// and a program that has to interoperate with them needs it. For anything
// new, `blake3`.
//
// Words are little-endian 32-bit values held in `i64`s; every sum is
// masked, so nothing overflows in a debug build.

fn mask() -> i64 {
    4294967295
}

fn rotl(x: i64, n: i64) -> i64 {
    x.shl(n).bit_or(x.ushr(32 - n)).bit_and(mask())
}

fn ff(a: i64, b: i64, c: i64, d: i64, x: i64, s: i64) -> i64 {
    rotl((a + b.bit_and(c).bit_or(b.bit_not().bit_and(mask()).bit_and(d)) + x).bit_and(mask()), s)
}

fn gg(a: i64, b: i64, c: i64, d: i64, x: i64, s: i64) -> i64 {
    rotl((a + b.bit_and(c).bit_or(b.bit_and(d)).bit_or(c.bit_and(d)) + x + 1518500249).bit_and(mask()), s)
}

fn hh(a: i64, b: i64, c: i64, d: i64, x: i64, s: i64) -> i64 {
    rotl((a + b.bit_xor(c).bit_xor(d) + x + 1859775393).bit_and(mask()), s)
}

fn word(b: bytes, at: i64) -> i64 {
    b.at(at).bit_or(b.at(at + 1).shl(8)).bit_or(b.at(at + 2).shl(16)).bit_or(b.at(at + 3).shl(24))
}

/// The sixteen-byte digest of `message`.
pub fn hash(message: bytes) -> bytes {
    let n = message.len()
    var padded = message.concat(bytes_of([128]))
    while padded.len() % 64 != 56 {
        padded = padded.concat(bytes_of([0]))
    }
    let bits = n * 8
    var lenb: [i64] = []
    for k in 0..8 {
        lenb.push(bits.ushr(8 * k).bit_and(255))
    }
    padded = padded.concat(bytes_of(lenb))
    var a0 = 1732584193
    var b0 = 4023233417
    var c0 = 2562383102
    var d0 = 271733878
    var at = 0
    while at < padded.len() {
        var x: [i64] = []
        for k in 0..16 {
            x.push(word(padded, at + 4 * k))
        }
        var a = a0
        var b = b0
        var c = c0
        var d = d0
        for i in [0, 4, 8, 12] {
            a = ff(a, b, c, d, x[i], 3)
            d = ff(d, a, b, c, x[i + 1], 7)
            c = ff(c, d, a, b, x[i + 2], 11)
            b = ff(b, c, d, a, x[i + 3], 19)
        }
        for i in [0, 1, 2, 3] {
            a = gg(a, b, c, d, x[i], 3)
            d = gg(d, a, b, c, x[i + 4], 5)
            c = gg(c, d, a, b, x[i + 8], 9)
            b = gg(b, c, d, a, x[i + 12], 13)
        }
        for i in [0, 2, 1, 3] {
            a = hh(a, b, c, d, x[i], 3)
            d = hh(d, a, b, c, x[i + 8], 9)
            c = hh(c, d, a, b, x[i + 4], 11)
            b = hh(b, c, d, a, x[i + 12], 15)
        }
        a0 = (a0 + a).bit_and(mask())
        b0 = (b0 + b).bit_and(mask())
        c0 = (c0 + c).bit_and(mask())
        d0 = (d0 + d).bit_and(mask())
        at = at + 64
    }
    var out: [i64] = []
    for v in [a0, b0, c0, d0] {
        for k in 0..4 {
            out.push(v.ushr(8 * k).bit_and(255))
        }
    }
    bytes_of(out)
}
