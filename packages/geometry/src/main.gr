// 2D geometry in f64: points, vectors, rectangles, and the tests that need care.
//
// Two things here are worth more than the rest. **Vec2-in-polygon** by ray
// casting, which is the algorithm that works for concave shapes and holes
// where a bounding-box check does not. And **segment intersection** by
// orientation, which avoids computing a slope and therefore never divides by
// zero on a vertical line — the case a slope-based test silently gets wrong.

type Vec2 = {
    x: f64,
    y: f64,
}

type Rect = {
    x: f64,
    y: f64,
    w: f64,
    h: f64,
}

pub fn point(x: f64, y: f64) -> Vec2 {
    return Vec2{ x: x, y: y }
}

pub fn rect(x: f64, y: f64, w: f64, h: f64) -> Rect {
    return Rect{ x: x, y: y, w: w, h: h }
}

fn abs_of(v: f64) -> f64 {
    if v < 0.0 {
        return 0.0 - v
    }
    return v
}

fn sqrt_of(v: f64) -> f64 {
    if v <= 0.0 {
        return 0.0
    }
    var g = v
    for _i in 0..24 {
        g = (g + v / g) / 2.0
    }
    return g
}

pub fn add(a: Vec2, b: Vec2) -> Vec2 {
    return Vec2{ x: a.x + b.x, y: a.y + b.y }
}

pub fn sub(a: Vec2, b: Vec2) -> Vec2 {
    return Vec2{ x: a.x - b.x, y: a.y - b.y }
}

pub fn scale(a: Vec2, k: f64) -> Vec2 {
    return Vec2{ x: a.x * k, y: a.y * k }
}

pub fn dot(a: Vec2, b: Vec2) -> f64 {
    return a.x * b.x + a.y * b.y
}

/// The z of the 3D cross product — its sign says which way b turns from a.
pub fn cross(a: Vec2, b: Vec2) -> f64 {
    return a.x * b.y - a.y * b.x
}

pub fn length(a: Vec2) -> f64 {
    return sqrt_of(dot(a, a))
}

pub fn distance(a: Vec2, b: Vec2) -> f64 {
    return length(sub(a, b))
}

/// Distance squared — for comparing distances, which needs no square root.
pub fn distance_squared(a: Vec2, b: Vec2) -> f64 {
    let d = sub(a, b)
    return dot(d, d)
}

pub fn normalise(a: Vec2) -> Vec2 {
    let l = length(a)
    if l == 0.0 {
        return a
    }
    return scale(a, 1.0 / l)
}

pub fn rect_holds(r: Rect, p: Vec2) -> bool {
    return p.x >= r.x and p.x <= r.x + r.w and p.y >= r.y and p.y <= r.y + r.h
}

pub fn rects_overlap(a: Rect, b: Rect) -> bool {
    return a.x <= b.x + b.w and b.x <= a.x + a.w and
    a.y <= b.y + b.h and b.y <= a.y + a.h
}

pub fn rect_area(r: Rect) -> f64 {
    return r.w * r.h
}

/// The shoelace area of a polygon, positive whichever way it winds.
pub fn polygon_area(points: [Vec2]) -> f64 {
    let n = points.len()
    if n < 3 {
        return 0.0
    }
    var total = 0.0
    for i in 0..n {
        let j = (i + 1) % n
        total = total + points[i].x * points[j].y - points[j].x * points[i].y
    }
    return abs_of(total) / 2.0
}

/// Whether `p` is inside `polygon`, by ray casting.
///
/// A horizontal ray to the right crosses the boundary an odd number of times
/// when the point is inside. This handles concave shapes, which a bounding box
/// cannot, and it is why a hit test on an arbitrary region needs this rather
/// than a rectangle check.
pub fn polygon_holds(polygon: [Vec2], p: Vec2) -> bool {
    var inside = false
    let n = polygon.len()
    var j = n - 1
    for i in 0..n {
        let a = polygon[i]
        let b = polygon[j]
        // The edge must straddle the ray's height, and the crossing must be to
        // the right of the point.
        if (a.y > p.y) != (b.y > p.y) {
            let at = (b.x - a.x) * (p.y - a.y) / (b.y - a.y) + a.x
            if p.x < at {
                inside = not inside
            }
        }
        j = i
    }
    return inside
}

/// 1 clockwise, -1 anticlockwise, 0 collinear.
pub fn orientation(a: Vec2, b: Vec2, c: Vec2) -> i64 {
    let v = cross(sub(b, a), sub(c, a))
    if v > 0.000000001 {
        return 0 - 1
    }
    if v < 0.0 - 0.000000001 {
        return 1
    }
    return 0
}

/// Whether two segments cross.
///
/// By orientation rather than by slope: a vertical segment has no slope, and a
/// slope-based test either divides by zero or special-cases it wrongly.
pub fn segments_cross(p1: Vec2, p2: Vec2, p3: Vec2, p4: Vec2) -> bool {
    let o1 = orientation(p1, p2, p3)
    let o2 = orientation(p1, p2, p4)
    let o3 = orientation(p3, p4, p1)
    let o4 = orientation(p3, p4, p2)
    if o1 != o2 and o3 != o4 {
        return true
    }
    // Collinear and overlapping counts as crossing.
    if o1 == 0 and on_segment(p1, p3, p2) {
        return true
    }
    if o2 == 0 and on_segment(p1, p4, p2) {
        return true
    }
    if o3 == 0 and on_segment(p3, p1, p4) {
        return true
    }
    if o4 == 0 and on_segment(p3, p2, p4) {
        return true
    }
    return false
}

fn on_segment(a: Vec2, p: Vec2, b: Vec2) -> bool {
    let lo_x = if a.x < b.x { a.x } else { b.x }
    let hi_x = if a.x > b.x { a.x } else { b.x }
    let lo_y = if a.y < b.y { a.y } else { b.y }
    let hi_y = if a.y > b.y { a.y } else { b.y }
    return p.x >= lo_x and p.x <= hi_x and p.y >= lo_y and p.y <= hi_y
}
