// The OpenType `post` table: PostScript facts about a font, and the names
// of its glyphs.
//
// The italic angle, the underline position and thickness, whether the
// font is fixed-pitch, and memory hints for PostScript printers, in all
// versions; version 2.0 adds a name for every glyph, as an index either
// into the 258 standard Macintosh glyph names or into Pascal strings that
// follow. Version 3.0 has no names. PDF generators, font editors and
// shaping debuggers show these names; `uniXXXX` names from them are how
// text is extracted from PDFs without a `cmap`.
//
// Checked against fontTools' `post` table on macOS's system fonts.

type PostTable = {
    version: i64,
    italic_angle: i64,
    underline_position: i64,
    underline_thickness: i64,
    fixed_pitch: i64,
    memory: [i64],
    names: [str],
}

type PostError =
    | PostMalformed(why: str)

fn u16(b: bytes, at: i64) -> i64 {
    return b.at(at) * 256 + b.at(at + 1)
}

fn s16(b: bytes, at: i64) -> i64 {
    let v = u16(b, at)
    return if v >= 32768 { v - 65536 } else { v }
}

fn u32(b: bytes, at: i64) -> i64 {
    return u16(b, at) * 65536 + u16(b, at + 2)
}

fn s32(b: bytes, at: i64) -> i64 {
    let v = u32(b, at)
    return if v >= 2147483648 { v - 4294967296 } else { v }
}

/// The table; `version` and `italic_angle` are raw 16.16 fixed-point.
pub fn parse(d: bytes) -> PostTable ! PostError {
    if d.len() < 32 {
        fail(PostMalformed("shorter than its header"))
    }
    let version = u32(d, 0)
    var names: [str] = []
    if version == 131072 {
        if d.len() < 34 {
            fail(PostMalformed("no glyph count"))
        }
        let n = u16(d, 32)
        if 34 + 2 * n > d.len() {
            fail(PostMalformed("glyph name indices past the end"))
        }
        // As many Pascal strings as the highest index needs; any bytes after
        // them are ignored, and a name the table cuts short is empty, as
        // fontTools reads it. Names are Latin-1.
        var highest = 0
        for i in 0..n {
            let idx = u16(d, 34 + 2 * i)
            if idx > highest {
                highest = idx
            }
        }
        var extra: [str] = []
        var at = 34 + 2 * n
        for _k in 0..(highest - 257) {
            let len = if at < d.len() { d.at(at) } else { 0 }
            at = at + 1
            var name = ""
            if at + len <= d.len() {
                for c in 0..len {
                    name = name + d.at(at + c).to_char()
                }
            }
            extra.push(name)
            at = at + len
        }
        let standard = STANDARD_NAMES
        for i in 0..n {
            let idx = u16(d, 34 + 2 * i)
            if idx < 258 {
                names.push(standard[idx])
            } else {
                names.push(extra[idx - 258])
            }
        }
    }
    return PostTable{ version: version, italic_angle: s32(d, 4), underline_position: s16(d, 8), underline_thickness: s16(d, 10),
        fixed_pitch: u32(d, 12), memory: [u32(d, 16), u32(d, 20), u32(d, 24), u32(d, 28)], names: names }
}

/// The italic angle in degrees, counter-clockwise from vertical.
pub fn italic_degrees(t: PostTable) -> f64 {
    return t.italic_angle.as_f64() / 65536.0
}

