import patchid
import sshsig

fn from_hex(text: str) -> str {
    var out: [i64] = []
    var i = 1
    while i + 1 < text.len() {
        out.push(text.substr(i, 2).parse_int_base(16) ?? 0)
        i = i + 2
    }
    return bytes_of(out).to_str()
}

fn read_or_hex(where: str) -> str / {io} {
    match read_file(where) {
        Ok(text) -> return text
        Err(_e) -> return from_hex(where)
    }
}

fn main() / {io} {
    var i = 0
    while i + 1 < args().len() {
        if args()[i] == "sig" {
            // `sig <signature path> <message path>`
            let text = read_or_hex(args()[i + 1])
            let message = read_or_hex(args()[i + 2]).to_bytes()
            match sshsig.parse(text) {
                Err(_e) -> print("?refused?")
                Ok(signature) -> {
                    var verdict = "no"
                    if sshsig.verify(signature, message) {
                        verdict = "yes"
                    }
                    print(signature.namespace + " " +
                        signature.hash_algorithm + " " +
                        sshsig.key_type(signature) + " " +
                        sshsig.signature_algorithm(signature) + " " +
                        sshsig.fingerprint(signature) + " " + verdict)
                }
            }
            i = i + 3
            continue
        }
        if args()[i] == "sigrender" {
            let text = read_or_hex(args()[i + 1])
            match sshsig.parse(text) {
                Err(_e) -> print("?refused?")
                Ok(signature) -> print(sshsig.render(signature))
            }
            i = i + 2
            continue
        }
        // Diffs are read from a file rather than an argument: a real one
        // runs to megabytes and does not fit in an argument list.
        var diff = ""
        match read_file(args()[i + 1]) {
            Ok(text) -> diff = text
            Err(_e) -> diff = from_hex(args()[i + 1])
        }
        if args()[i] == "id" {
            print(patchid.of(diff))
        } else {
            print(patchid.file_count(diff).to_str())
        }
        i = i + 2
    }
}
