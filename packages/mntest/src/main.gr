import mnemonic

fn from_hex(text: str) -> bytes {
    var out: [i64] = []
    var i = 0
    while i + 1 < text.len() {
        out.push(text.substr(i, 2).parse_int_base(16) ?? 0)
        i = i + 2
    }
    return bytes_of(out)
}

fn to_hex(data: bytes) -> str {
    let digits = "0123456789abcdef"
    var out = ""
    var i = 0
    while i < data.len() {
        out = out + digits.substr(data.at(i) / 16, 1) +
        digits.substr(data.at(i) % 16, 1)
        i = i + 1
    }
    return out
}

fn main() / {io} {
    var i = 0
    while i + 2 < args().len() {
        let what = args()[i]
        if what == "words" {
            match mnemonic.from_entropy(from_hex(args()[i + 1])) {
                Ok(words) -> print(mnemonic.render(words))
                Err(_why) -> print("error")
            }
        } else if what == "entropy" {
            match mnemonic.to_entropy(mnemonic.split(args()[i + 1])) {
                Ok(entropy) -> print(to_hex(entropy))
                Err(_why) -> print("error")
            }
        } else {
            print(mnemonic.seed_hex(args()[i + 1], args()[i + 2]))
        }
        i = i + 3
    }
}
