// Unicode IDNA compatibility processing (UTS #46): the domain names a
// browser, a URL parser or a certificate check actually compares.
//
// `packages/idna` does IDNA2003's nameprep. The web moved on: the URL
// Standard turns a host into ASCII by UTS #46, whose table says, for every
// code point, whether it is valid, mapped to something else (case, width,
// compatibility forms, `。` to `.`), ignored (soft hyphens, variation
// selectors), a deviation (`ß`, `ς`, ZWJ, ZWNJ: kept, under the
// non-transitional processing everyone now uses) or disallowed. Then the
// text is put in NFC, split at dots, any `xn--` label decoded from
// Punycode and checked, and every other label that is not ASCII checked
// and encoded.
//
// This follows Node's URL parser (ada 3.3.0) where it reads the standard
// its own way, because a domain is a security boundary and two programs
// that disagree on one are the bug:
//
// - A label in ASCII is not checked at all (only lowercased); an `xn--`
//   label must decode to something beyond ASCII that mapping and NFC
//   leave as it is.
// - A label may not begin with a mark.
// - Joiners: the first ZWNJ or ZWJ in a label decides. Either may follow
//   a virama; a ZWNJ may also stand between a letter that joins on the
//   left or both sides somewhere before it and one that joins on the
//   right or both sides somewhere after it.
// - Bidi: a label holding R, AL or AN is checked. Starting with L, every
//   character before the last non-mark must be L, EN, ES, CS, ET, ON, BN
//   or NSM. Otherwise every character up to the last non-mark must be R,
//   AL, AN, EN, ES, CS, ET, ON, BN or NSM, EN and AN may not both appear,
//   and the last must be R, AL, AN or EN. A label of marks alone fails.
//
// The mapping table is IdnaMappingTable 16.0; the marks, viramas, joining
// types and bidi classes are the ones ada carries.
import punycode
import unicodenorm

type Uts46Tables = { ranges: [i64], strings: [i64], joining: [i64], marks: [i64], viramas: [i64], directions: [i64] }

type Uts46Error =
    | Uts46Disallowed()
    | Uts46Invalid(label: str)
    | Uts46Empty()

/// The tables, built once and passed to every call.
pub fn tables() -> Uts46Tables {
    return Uts46Tables{ ranges: idna_ranges(), strings: idna_strings(), joining: joining_ranges(), marks: mark_ranges(), viramas: virama_codes(),
        directions: direction_ranges() }
}

/// The value for `c` in a table of (first, last, value...) rows of `width`
/// numbers, or -1.
fn lookup(t: [i64], width: i64, c: i64) -> i64 {
    var lo = 0
    var hi = t.len() / width - 1
    while lo <= hi {
        let mid = (lo + hi) / 2
        if c < t[width * mid] {
            hi = mid - 1
        } else if c > t[width * mid + 1] {
            lo = mid + 1
        } else {
            return mid
        }
    }
    return 0 - 1
}

fn direction(t: Uts46Tables, c: i64) -> i64 {
    let i = lookup(t.directions, 3, c)
    return if i < 0 { 0 } else { t.directions[3 * i + 2] }
}

fn joining(t: Uts46Tables, c: i64) -> i64 {
    let i = lookup(t.joining, 3, c)
    return if i < 0 { 0 } else { t.joining[3 * i + 2] }
}

fn is_virama(t: Uts46Tables, c: i64) -> bool {
    var lo = 0
    var hi = t.viramas.len() - 1
    while lo <= hi {
        let mid = (lo + hi) / 2
        if c < t.viramas[mid] {
            hi = mid - 1
        } else if c > t.viramas[mid] {
            lo = mid + 1
        } else {
            return true
        }
    }
    return false
}

fn from_codes(cs: [i64]) -> str {
    var out: [i64] = []
    for r in cs {
        if r < 128 {
            out.push(r)
        } else if r < 2048 {
            out.push(192 + r.ushr(6))
            out.push(128 + r.bit_and(63))
        } else if r < 65536 {
            out.push(224 + r.ushr(12))
            out.push(128 + r.ushr(6).bit_and(63))
            out.push(128 + r.bit_and(63))
        } else {
            out.push(240 + r.ushr(18))
            out.push(128 + r.ushr(12).bit_and(63))
            out.push(128 + r.ushr(6).bit_and(63))
            out.push(128 + r.bit_and(63))
        }
    }
    return bytes_of(out).to_str()
}

/// The mapping step over code points: None when one is disallowed.
pub fn map_codes(t: Uts46Tables, cs: [i64]) -> Option[[i64]] {
    var out: [i64] = []
    for c in cs {
        let i = lookup(t.ranges, 4, c)
        let kind = if i < 0 { 2 } else { t.ranges[4 * i + 2] }
        let arg = if i < 0 { 0 } else { t.ranges[4 * i + 3] }
        if kind == 2 {
            return None
        }
        if kind == 4 {
            out.push(c + arg)
        } else if kind == 5 {
            for k in 0..t.strings[arg] {
                out.push(t.strings[arg + 1 + k])
            }
        } else if kind != 1 {
            out.push(c)
        }
    }
    return Some(out)
}

/// The mapping step: the mapped domain, or None when something in it is
/// disallowed.
pub fn map_domain(t: Uts46Tables, domain: str) -> Option[str] {
    return match map_codes(t, domain.codes()) {
        Some(cs) -> Some(from_codes(cs))
        None -> None
    }
}

fn joiners_ok(t: Uts46Tables, cs: [i64]) -> bool {
    for i in 0..cs.len() {
        let c = cs[i]
        if c == 8204 or c == 8205 {
            if i > 0 and is_virama(t, cs[i - 1]) {
                return true
            }
            if c == 8205 or i + 1 >= cs.len() {
                return false
            }
            var before = false
            for k in 0..i {
                let j = joining(t, cs[k])
                before = before or j == 3 or j == 2
            }
            var after = false
            for k in (i + 1)..cs.len() {
                let j = joining(t, cs[k])
                after = after or j == 4 or j == 2
            }
            return before and after
        }
    }
    return true
}

fn in_set(d: i64, set: [i64]) -> bool {
    for x in set {
        if x == d {
            return true
        }
    }
    return false
}

fn bidi_ok(t: Uts46Tables, cs: [i64]) -> bool {
    var last = cs.len() - 1
    while last >= 0 and direction(t, cs[last]) == 8 {
        last = last - 1
    }
    if last < 0 {
        return false
    }
    var rtl = false
    for c in cs {
        rtl = rtl or in_set(direction(t, c), [7, 9, 10])
    }
    if not rtl {
        return true
    }
    if direction(t, cs[0]) == 6 {
        for i in 0..last {
            if not in_set(direction(t, cs[i]), [6, 5, 3, 2, 11, 4, 1, 8]) {
                return false
            }
        }
        return true
    }
    var has_an = false
    var has_en = false
    for i in 0..(last + 1) {
        let d = direction(t, cs[i])
        if d == 5 {
            has_en = true
        }
        if d == 10 {
            has_an = true
        }
        if has_an and has_en {
            return false
        }
        if not in_set(d, [7, 9, 10, 5, 3, 2, 11, 4, 1, 8]) {
            return false
        }
        if i == last and not in_set(d, [7, 9, 10, 5]) {
            return false
        }
    }
    return true
}

/// The checks every label beyond ASCII must pass.
pub fn label_ok(t: Uts46Tables, cs: [i64]) -> bool {
    if cs.len() == 0 {
        return true
    }
    if lookup(t.marks, 2, cs[0]) >= 0 {
        return false
    }
    return joiners_ok(t, cs) and bidi_ok(t, cs)
}

fn ascii_only(s: str) -> bool {
    for b in s.to_bytes().to_list() {
        if b >= 128 {
            return false
        }
    }
    return true
}

/// An `xn--` label's tail: it must decode to something beyond ASCII that
/// mapping and NFC leave alone and that passes the label checks.
fn punycode_ok(t: Uts46Tables, rest: str) -> bool {
    match punycode.decode(rest) {
        Ok(decoded) -> {
            if ascii_only(decoded) {
                return false
            }
            let cs = decoded.codes()
            match map_codes(t, cs) {
                Some(m) -> {
                    if m != cs {
                        return false
                    }
                }
                None -> return false
            }
            return unicodenorm.nfc(decoded) == decoded and label_ok(t, cs)
        }
        Err(_e) -> return false
    }
}

/// The URL Standard's domain to ASCII (beStrict false), as Node's URL
/// parser computes it. An empty result is an error.
pub fn to_ascii(t: Uts46Tables, domain: str) -> str ! Uts46Error {
    var out: [str] = []
    if ascii_only(domain) {
        for label in domain.to_lower().split(".") {
            if label.starts_with("xn--") and not punycode_ok(t, label.substr(4, label.len() - 4)) {
                fail(Uts46Invalid(label))
            }
            out.push(label)
        }
    } else {
        let mapped = map_domain(t, domain) ?? fail(Uts46Disallowed())
        for label in unicodenorm.nfc(mapped).split(".") {
            if label.starts_with("xn--") {
                if not ascii_only(label) or not punycode_ok(t, label.substr(4, label.len() - 4)) {
                    fail(Uts46Invalid(label))
                }
                out.push(label)
            } else if ascii_only(label) {
                out.push(label)
            } else {
                if not label_ok(t, label.codes()) {
                    fail(Uts46Invalid(label))
                }
                out.push("xn--" + punycode.encode(label))
            }
        }
    }
    let s = out.join(".")
    if s.len() == 0 {
        fail(Uts46Empty())
    }
    return s
}

/// Whether a domain needs the tables at all: something beyond ASCII, or
/// an `xn--` label to check.
pub fn needs_tables(domain: str) -> bool {
    return not ascii_only(domain) or domain.to_lower().starts_with("xn--") or domain.to_lower().contains(".xn--")
}

/// Domain to Unicode as ada computes it: every `xn--` label that decodes
/// is decoded (unless what follows `xn--` starts with `xn--` again);
/// nothing else changes.
pub fn to_unicode(domain: str) -> str {
    var out: [str] = []
    for label in domain.split(".") {
        // A body that itself starts with `xn--` is left alone, as ada's
        // verify_punycode refuses it.
        if label.starts_with("xn--") and ascii_only(label) and not label.substr(4, label.len() - 4).starts_with("xn--") {
            match punycode.decode(label.substr(4, label.len() - 4)) {
                Ok(d) -> out.push(d)
                Err(_e) -> out.push(label)
            }
        } else {
            out.push(label)
        }
    }
    return out.join(".")
}

