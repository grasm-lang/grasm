// Shell archives: files packed into a script that recreates them when
// run with `sh` -- the format of `shar` (BSD and macOS), of 1980s and
// 1990s Usenet source postings, and of self-extracting installers.
//
// BSD `shar` writes, for each file, `sed 's/^X//' >name << 'DELIM'`, the
// file's lines each prefixed with X, and the delimiter; for each
// directory, `mkdir -p name`. Reading follows what `sh` does with that
// text rather than what the writer meant: a here-document runs to the
// first line that is exactly its delimiter, or to the end of the archive
// when there is none -- which is what happens to a file that did not
// end with a newline, since BSD `shar` then writes the delimiter on the
// file's last line, and `sh` puts the rest of the archive into that
// file. Lines this does not recognise are refused rather than run.
//
// Writing quotes every name, uses a here-document for text that ends
// with a newline (with a delimiter that is no line of the file), and
// `printf '%b'` with octal escapes for anything else, so every file comes
// back byte for byte.
//
// Checked against macOS `shar` and `sh`.

type SharItem =
    | SharFile(path: str, data: bytes)
    | SharDir(path: str)

type SharError =
    | SharUnsupported(line: i64, text: str)

/// A shell word: single-quoted, or bare.
fn word(s: str) -> (str, str) {
    if s.starts_with("'") {
        var out = ""
        var rest = s.substr(1, s.len() - 1)
        while true {
            let q = rest.index_of("'") ?? rest.len()
            out = out + rest.substr(0, q)
            rest = if q < rest.len() { rest.substr(q + 1, rest.len() - q - 1) } else { "" }
            // '\'' continues the word.
            if rest.starts_with("\\''") {
                out = out + "'"
                rest = rest.substr(3, rest.len() - 3)
            } else {
                return (out, rest)
            }
        }
    }
    let sp = s.index_of(" ") ?? s.len()
    return (s.substr(0, sp), s.substr(sp, s.len() - sp))
}

fn unescape_b(s: str) -> bytes {
    let b = s.to_bytes()
    var out: [i64] = []
    var i = 0
    while i < b.len() {
        if b.at(i) == 92 and i + 1 < b.len() {
            let c = b.at(i + 1)
            if c == 48 {
                var v = 0
                var k = i + 2
                while k < b.len() and k < i + 5 and b.at(k) >= 48 and b.at(k) <= 55 {
                    v = v * 8 + b.at(k) - 48
                    k = k + 1
                }
                out.push(v.bit_and(255))
                i = k
                continue
            }
            if c == 92 {
                out.push(92)
                i = i + 2
                continue
            }
            if c == 110 {
                out.push(10)
                i = i + 2
                continue
            }
        }
        out.push(b.at(i))
        i = i + 1
    }
    return bytes_of(out)
}

pub fn parse(text: str) -> [SharItem] ! SharError {
    let lines = text.split("\n")
    var out: [SharItem] = []
    var i = 0
    while i < lines.len() {
        let l = lines[i].trim()
        i = i + 1
        if l.len() == 0 or l.starts_with("#") or l.starts_with("echo ") or l == "exit" or l == "exit 0" or l == ":" {
            continue
        }
        if l.starts_with("mkdir -p ") {
            var rest = l.substr(9, l.len() - 9)
            if rest.starts_with("-- ") {
                rest = rest.substr(3, rest.len() - 3)
            }
            let (name, _r) = word(rest)
            out.push(SharDir(name))
            continue
        }
        if l.starts_with("sed 's/^X//' >") {
            let after = l.substr(14, l.len() - 14)
            let (name, rest) = word(after)
            let r = rest.trim()
            if not r.starts_with("<<") {
                fail(SharUnsupported(i, l))
            }
            let (delim, _x) = word(r.substr(2, r.len() - 2).trim())
            var body: [str] = []
            while i < lines.len() and lines[i] != delim {
                let x = lines[i]
                body.push(if x.starts_with("X") { x.substr(1, x.len() - 1) } else { x })
                i = i + 1
            }
            // To the delimiter, or (as sh does) to the end of the text.
            let ended = i < lines.len()
            if ended {
                i = i + 1
            } else if body.len() > 0 and body[body.len() - 1].len() == 0 and text.ends_with("\n") {
                let _l = body.pop()
            }
            out.push(SharFile(name, bytes_of(body.map(|x| x + "\n").join("").to_bytes().to_list())))
            continue
        }
        if l.starts_with("printf '%b' ") {
            let (content, rest) = word(l.substr(12, l.len() - 12))
            let r = rest.trim()
            if not r.starts_with(">") {
                fail(SharUnsupported(i, l))
            }
            let (name, _x) = word(r.substr(1, r.len() - 1).trim())
            out.push(SharFile(name, unescape_b(content)))
            continue
        }
        fail(SharUnsupported(i, l))
    }
    return out
}

fn quote(s: str) -> str {
    return "'" + s.replace("'", "'\\''") + "'"
}

/// `printf '%b'` text for any bytes: printable ASCII as itself, backslash
/// doubled, everything else as \0ooo.
fn escaped(b: bytes) -> str {
    var parts: [str] = []
    for i in 0..b.len() {
        let c = b.at(i)
        if c == 92 {
            parts.push("\\\\")
        } else if c == 39 {
            parts.push("'\\''")
        } else if c >= 32 and c < 127 {
            parts.push(c.to_char())
        } else {
            parts.push("\\0" + (c.ushr(6)).to_str() + c.ushr(3).bit_and(7).to_str() + c.bit_and(7).to_str())
        }
    }
    return parts.join("")
}

/// A shell archive of the items.
pub fn write(items: [SharItem]) -> str {
    var out = ["# This is a shell archive.  Save it in a file and unpack it by entering \"sh file\".", "#"]
    for it in items {
        match it {
            SharDir(p) -> out.push("mkdir -p -- " + quote(p) + " > /dev/null 2>&1")
            SharFile(p, data) -> {
                let text = data.to_str()
                let printable = data.to_list().all(|c| c >= 32 and c < 127 or c == 9 or c == 10)
                if printable and data.len() > 0 and text.ends_with("\n") {
                    let lines = text.substr(0, text.len() - 1).split("\n")
                    var delim = "SHAR_EOF"
                    while lines.any(|x| "X" + x == delim) {
                        delim = delim + "_"
                    }
                    out.push("sed 's/^X//' >" + quote(p) + " << '" + delim + "'")
                    for x in lines {
                        out.push("X" + x)
                    }
                    out.push(delim)
                } else {
                    out.push("printf '%b' '" + escaped(data) + "' >" + quote(p))
                }
            }
        }
    }
    out.push("exit")
    return out.join("\n") + "\n"
}
