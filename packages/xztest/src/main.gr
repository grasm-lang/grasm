import xzfile

fn from_hex(text: str) -> bytes {
    var out: [i64] = []
    var i = 1
    while i + 1 < text.len() {
        out.push(text.substr(i, 2).parse_int_base(16) ?? 0)
        i = i + 2
    }
    return bytes_of(out)
}

fn to_hex(raw: bytes) -> str {
    let digits = "0123456789abcdef"
    var out = ""
    var i = 0
    while i < raw.len() {
        out = out + digits.substr(raw.at(i) / 16, 1) +
        digits.substr(raw.at(i) % 16, 1)
        i = i + 1
    }
    return out
}

fn main() / {io} {
    var i = 0
    while i + 1 < args().len() {
        let raw = from_hex(args()[i + 1])
        if args()[i] == "check" {
            print(xzfile.check_kind(raw).to_str())
        } else {
            match xzfile.decode(raw, 8000000) {
                Ok(data) -> print(to_hex(data))
                Err(_e) -> print("error")
            }
        }
        i = i + 2
    }
}
