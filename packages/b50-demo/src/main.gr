// Eight libraries, each run once on an input whose answer came from the
// tool it is held to -- Node 25 for two, Go 1.25 for three, Python 3.13 for
// three. scripts/b50_diff.sh holds them to those tools on thousands more.
import gocsv
import goduration
import gojson
import jsradix
import jsuri
import pydatetime
import pyfnmatch
import pyjson

fn js() {
    assert_eq(jsradix.to_string_radix(255.5, 16) ?? "", "ff.8")
    assert_eq(jsradix.to_string_radix(0.1, 3) ?? "", "0.0022002200220022002200220022002201")
    assert_eq(jsradix.parse_int("0x1F", 0), 31.0)
    assert_eq(jsradix.parse_int("  -z!", 36), -35.0)
    assert_eq(jsuri.encode_uri_component(jsuri.units("a b&é")) ?? "", "a%20b%26%C3%A9")
    assert_eq(jsuri.text(jsuri.decode_uri(jsuri.units("%3B%2F%41%C3%A9")) ?? []), "%3B%2FAé")
    assert_eq(jsuri.escape(jsuri.units("é€")), "%E9%u20AC")
    let malformed = match jsuri.decode_uri_component(jsuri.units("%")) {
        Ok(_u) -> false
        Err(_e) -> true
    }
    assert(malformed)
    print("javascript: V8's")
}

fn go() {
    let compacted = match gojson.compact("\{\"a\":1,}".to_bytes()) {
        Ok(_b) -> ""
        Err(e) -> gojson.error_text(e)
    }
    assert_eq(compacted, "invalid character '}' looking for beginning of object key string")
    let v = gojson.unmarshal("\{\"b\":1,\"a\":\"<x>\",\"b\":2}".to_bytes()) ?? GjNull
    assert_eq((gojson.marshal(v, true) ?? "".to_bytes()).to_str(), "\{\"a\":\"\\u003cx\\u003e\",\"b\":2}")
    assert_eq(gojson.encode_number(1e21) ?? "", "1e+21")
    assert_eq(gojson.encode_number(1e-7) ?? "", "1e-7")
    assert_eq(gocsv.read_all_text("a,\"b\"\"c\"\r\nd,e\n") ?? [], [["a", "b\"c"], ["d", "e"]])
    let bare = match gocsv.read_all_text("a,b\"c\n") {
        Ok(_r) -> ""
        Err(e) -> gocsv.error_text(e)
    }
    assert_eq(bare, "parse error on line 1, column 4: bare \" in non-quoted-field")
    let row = ["a b", " x", "q\"r"].map(|f| f.to_bytes())
    assert_eq((gocsv.write([row], 44, false) ?? "".to_bytes()).to_str(), "a b,\" x\",\"q\"\"r\"\n")
    assert_eq(goduration.parse_duration("1h30m") ?? 0, 5400000000000)
    assert_eq(goduration.duration_string(1500), "1.5µs")
    assert_eq(goduration.duration_string(3600500000000), "1h0m0.5s")
    let unit = match goduration.parse_duration("1x") {
        Ok(_d) -> ""
        Err(e) -> goduration.error_text(e)
    }
    assert_eq(unit, "time: unknown unit \"x\" in duration \"1x\"")
    print("go: Go's")
}

fn python() {
    let doc = pyjson.loads_text("[1, 2.0, NaN, \"\\ud800\"]") ?? PjNull
    assert_eq(pyjson.dumps_text(doc) ?? "", "[1, 2.0, NaN, \"\\ud800\"]")
    let trailing = match pyjson.loads_text("[1,]") {
        Ok(_v) -> ""
        Err(e) -> pyjson.error_text(e)
    }
    assert_eq(trailing, "Illegal trailing comma before end of array: line 1 column 3 (char 2)")
    let o = pyjson.default_options()
    let sorted = PyDumpOptions{ ensure_ascii: true, allow_nan: true, sort_keys: true, indent: Some("  "), item_separator: ",", key_separator: ": " }
    let nested = pyjson.loads_text("\{\"b\": 1, \"a\": [1.0, 1e16]}") ?? PjNull
    let text = (pyjson.dumps(nested, sorted) ?? []).map(|c| c.to_char()).join("")
    assert_eq(text, "\{\n  \"a\": [\n    1.0,\n    1e+16\n  ],\n  \"b\": 1\n}")
    assert_eq(o.item_separator, ", ")
    let dt = pydatetime.datetime_fromisoformat("2021-W01-1T12:30+05:30".codes()) ?? panic("iso")
    assert_eq(pydatetime.datetime_isoformat(dt, 84, "auto") ?? "", "2021-01-04T12:30:00+05:30")
    assert_eq(pydatetime.datetime_ctime(dt), "Mon Jan  4 12:30:00 2021")
    let back = pydatetime.timedelta(0, 0, 0, 0, 0 - 1, 0, 0) ?? panic("td")
    assert_eq(pydatetime.td_str(back), "-1 day, 23:59:59")
    assert_eq(pydatetime.td_repr(back), "datetime.timedelta(days=-1, seconds=86399)")
    let bad = match pydatetime.date_fromisoformat("2021-13".codes()) {
        Ok(_d) -> ""
        Err(e) -> pydatetime.error_text(e)
    }
    assert_eq(bad, "Invalid isoformat string: '2021-13'")
    let utc = PyTimedelta{ days: 0, seconds: 0, microseconds: 0 }
    // 1.5 and 2.5 microseconds both round to 2: half to even.
    let a = pydatetime.fromtimestamp(0.0000015, utc) ?? panic("ts")
    let b = pydatetime.fromtimestamp(0.0000025, utc) ?? panic("ts")
    assert_eq(a.time.microsecond, 2)
    assert_eq(b.time.microsecond, 2)
    assert_eq(pyfnmatch.translate("*.py"), "(?s:.*\\.py)\\Z")
    assert_eq(pyfnmatch.translate("[!z-a]x*?"), "(?s:.x.*.)\\Z")
    assert(pyfnmatch.fnmatchcase("a/b.py", "*.py"))
    assert(not pyfnmatch.fnmatchcase("b", "[z-a]"))
    print("python: CPython's")
}

fn main() / {io} {
    js()
    go()
    python()
}
