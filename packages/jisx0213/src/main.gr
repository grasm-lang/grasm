/// Cells that stand for two code points, a letter and a combining mark,
/// as `cell:codepoint,codepoint`. A cell is plane, row and cell, a byte each.
fn packed_sequences() -> str {
    return "10457:304b,309a 10458:304d,309a 10459:304f,309a 1045a:3051,309a " +
    "1045b:3053,309a 10557:30ab,309a 10558:30ad,309a 10559:30af,309a " +
    "1055a:30b1,309a 1055b:30b3,309a 1055c:30bb,309a 1055d:30c4,309a " +
    "1055e:30c8,309a 10658:31f7,309a 10b24:e6,300 10b28:254,300 " +
    "10b29:254,301 10b2a:28c,300 10b2b:28c,301 10b2c:259,300 " +
    "10b2d:259,301 10b2e:25a,300 10b2f:25a,301 10b45:2e9,2e5 " +
    "10b46:2e5,2e9 "
}

/// Cells Shift_JIS reads as a different code point from EUC, as
/// `cell:codepoint`.
fn packed_sjis_reads() -> str {
    return "10120:5c 10212:7e "
}

/// Cells JIS X 0213:2000 holds differently, as `cell:codepoint`; 0 is
/// a cell the 2004 edition added.
fn packed_edition_2000() -> str {
    return "10e01:0 10f5e:0 12f34:0 12f5e:0 15407:0 15e5a:0 15e5b:0 15e5c:0 " +
    "15e5d:0 15e5e:0 25d1b:9b1d "
}

/// Python's `shift_jis_2004` encoder where it departs from the default table,
/// as `codepoint:bytes`; bytes 0 means it refuses the character.
fn preferred_sjis_2004() -> str {
    return ""
}

/// Python's `euc_jis_2004` encoder where it departs from the default table,
/// as `codepoint:bytes`; bytes 0 means it refuses the character.
fn preferred_euc_2004() -> str {
    return "7e:7e "
}

/// Python's `shift_jisx0213` encoder where it departs from the default table,
/// as `codepoint:bytes`; bytes 0 means it refuses the character.
fn preferred_sjis_2000() -> str {
    return ""
}

/// Python's `euc_jisx0213` encoder where it departs from the default table,
/// as `codepoint:bytes`; bytes 0 means it refuses the character.
fn preferred_euc_2000() -> str {
    return "7e:7e 7626:0 7e6b:0 9b1c:0 "
}

