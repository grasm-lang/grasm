// JIS X 0213: the Japanese character set that finally has every kanji in
// a school textbook, in the three byte forms it is written in.
//
// JIS X 0208 stopped at 6,879 characters, and the names, place names and
// literary kanji it lacks were written for twenty years as images,
// private-use code points or a vendor's own extension. JIS X 0213 (2000,
// revised 2004) adds them: 11,233 cells in two planes, holding more than
// 4,000 new kanji, the Ainu katakana, phonetic symbols, and 25 cells that
// stand for a letter followed by a combining mark, the kana with a
// semi-voiced mark among them. It is what macOS, Emacs and most Japanese
// publishing tools mean by Shift_JIS-2004 and EUC-JIS-2004.
//
// One table, two byte forms:
//
// - Shift_JIS-2004 keeps Shift_JIS's arithmetic for plane 1 and fits plane
//   2's 26 rows into lead bytes 0xF0 to 0xFC, in an order that has to be
//   looked up. Below 0x80 it is JIS X 0201 Roman, so 0x5C reads as the yen
//   sign and 0x7E as the overline, and the backslash and tilde have cells
//   of their own.
// - EUC-JIS-2004 writes plane 1 as two bytes from 0xA1 and plane 2 after
//   0x8F, in exactly the rows JIS X 0212 left empty, so an EUC-JP file
//   with JIS X 0212 in it still reads: those rows go to `packages/jisx0212`.
//
// Each comes in the 2000 edition too, which lacks the ten kanji the 2004
// revision added and maps one cell of plane 2 to a different code point.
//
// An encoder has one job a table cannot do alone: `か` followed by a
// combining semi-voiced mark is one cell, not two, and is written as one.
//
// The tables are generated by `scripts/gen_jis.py` from Python's
// `shift_jis_2004`, `euc_jis_2004`, `shift_jisx0213` and `euc_jisx0213`
// codecs, and the gate checks every cell in every form both ways.

import jisx0212

type Jis0213Error =
    | Jis0213Invalid(at: i64, byte: i64)
    | Jis0213Truncated(at: i64)
    | Jis0213Unencodable(at: i64, codepoint: i64)

/// The byte form and the edition.
type Jis0213Form =
    | ShiftJis2004
    | EucJis2004
    | ShiftJisX0213
    | EucJisX0213

/// A reverse table for one form, built once for a document: single code
/// points, and letter-and-mark pairs keyed by both code points.
type Jis0213Encoder = { form: Jis0213Form, map: Map[i64, i64], pairs: Map[i64, i64] }

fn hex_value(text: str) -> i64 {
    return text.parse_int_base(16) ?? 0
}

fn load_pairs(packed: str) -> Map[i64, i64] {
    var out: Map[i64, i64] = {}
    for entry in packed.split(" ") {
        let cut = entry.index_of(":") ?? -1
        if cut >= 0 {
            out.set(hex_value(entry.substr(0, cut)), hex_value(entry.substr(cut + 1, entry.len() - cut - 1)))
        }
    }
    return out
}

fn load_sequences(packed: str) -> Map[i64, [i64]] {
    var out: Map[i64, [i64]] = {}
    for entry in packed.split(" ") {
        let cut = entry.index_of(":") ?? -1
        if cut >= 0 {
            out.set(hex_value(entry.substr(0, cut)), entry.substr(cut + 1, entry.len() - cut - 1).split(",").map(|c| hex_value(c)))
        }
    }
    return out
}

let PLANE1: [str] = plane1()
let PLANE2: [str] = plane2()
let PLANE2_ROWS: [i64] = plane2_rows()
let SEQUENCES: Map[i64, [i64]] = load_sequences(packed_sequences())
let SJIS_READS: Map[i64, i64] = load_pairs(packed_sjis_reads())
let EDITION_2000: Map[i64, i64] = load_pairs(packed_edition_2000())
let WIDTH = 6

/// Shift_JIS-2004 lead bytes 0xF0 to 0xF4 hold these rows of plane 2, odd
/// trail range first; from 0xF5 on the rows run in order from 79.
let ODD_ROWS: [i64] = [1, 3, 5, 13, 15]
let EVEN_ROWS: [i64] = [8, 4, 12, 14, 78]

fn is_sjis(form: Jis0213Form) -> bool {
    return match form {
        ShiftJis2004 -> true
        ShiftJisX0213 -> true
        _ -> false
    }
}

fn is_2000(form: Jis0213Form) -> bool {
    return match form {
        ShiftJisX0213 -> true
        EucJisX0213 -> true
        _ -> false
    }
}

fn place(plane: i64, row: i64, cell: i64) -> i64 {
    return plane * 65536 + row * 256 + cell
}

fn plane2_index(row: i64) -> i64 {
    var i = 0
    for candidate in PLANE2_ROWS {
        if candidate == row {
            return i
        }
        i = i + 1
    }
    return 0 - 1
}

/// The code points a cell stands for in a form: none for an empty cell,
/// two for a letter and its combining mark.
pub fn cell_codes(form: Jis0213Form, plane: i64, row: i64, cell: i64) -> [i64] {
    if cell < 1 or cell > 94 or row < 1 or row > 94 or plane < 1 or plane > 2 {
        return []
    }
    let key = place(plane, row, cell)
    if is_2000(form) {
        match EDITION_2000.get(key) {
            Some(code) -> return if code == 0 { [] } else { [code] }
            None -> {}
        }
    }
    if is_sjis(form) {
        match SJIS_READS.get(key) {
            Some(code) -> return [code]
            None -> {}
        }
    }
    match SEQUENCES.get(key) {
        Some(codes) -> return codes
        None -> {}
    }
    var text = ""
    if plane == 1 {
        text = PLANE1[row - 1]
    } else {
        let i = plane2_index(row)
        if i < 0 {
            return []
        }
        text = PLANE2[i]
    }
    let code = hex_value(text.substr((cell - 1) * WIDTH, WIDTH))
    return if code == 0 { [] } else { [code] }
}

/// A cell's Shift_JIS-2004 bytes, as one number.
fn sjis_bytes(plane: i64, row: i64, cell: i64) -> i64 {
    var lead = 0
    if plane == 1 {
        lead = if row <= 62 { (row + 257) / 2 } else { (row + 385) / 2 }
    } else if row <= 15 {
        lead = (row + 479) / 2 - row / 8 * 3
    } else {
        lead = (row + 411) / 2
    }
    var trail = cell + 158
    if row % 2 == 1 {
        trail = cell + 63
        if cell >= 64 {
            trail = trail + 1
        }
    }
    return lead * 256 + trail
}

fn euc_bytes(plane: i64, row: i64, cell: i64) -> i64 {
    let pair = (row + 160) * 256 + cell + 160
    return if plane == 1 { pair } else { 9371648 + pair }
}

/// The plane, row and cell a Shift_JIS-2004 pair names, or -1.
fn sjis_place(lead: i64, trail: i64) -> i64 {
    if trail < 64 or trail > 252 or trail == 127 {
        return 0 - 1
    }
    let even = trail >= 159
    var cell = trail - 158
    if not even {
        cell = trail - 63
        if trail >= 128 {
            cell = cell - 1
        }
    }
    let step = if even { 1 } else { 0 }
    if lead >= 129 and lead <= 159 {
        return place(1, (lead - 129) * 2 + 1 + step, cell)
    }
    if lead >= 224 and lead <= 239 {
        return place(1, (lead - 193) * 2 + 1 + step, cell)
    }
    if lead >= 240 and lead <= 244 {
        let row = if even { EVEN_ROWS[lead - 240] } else { ODD_ROWS[lead - 240] }
        return place(2, row, cell)
    }
    if lead >= 245 and lead <= 252 {
        return place(2, 79 + (lead - 245) * 2 + step, cell)
    }
    return 0 - 1
}

fn append_codes(out: str, codes: [i64]) -> str {
    var text = out
    for code in codes {
        text = text + code.to_char()
    }
    return text
}

fn decode_sjis(form: Jis0213Form, data: bytes) -> str ! Jis0213Error {
    var out = ""
    var at = 0
    while at < data.len() {
        let b = data.at(at)
        if b < 128 {
            // JIS X 0201 Roman, not ASCII.
            out = out + (if b == 92 { 165 } else if b == 126 { 8254 } else { b }).to_char()
            at = at + 1
            continue
        }
        if b >= 161 and b <= 223 {
            out = out + (65377 + b - 161).to_char()
            at = at + 1
            continue
        }
        if b == 128 or b == 160 or b > 252 {
            fail(Jis0213Invalid(at, b))
        }
        if at + 1 >= data.len() {
            fail(Jis0213Truncated(at))
        }
        let key = sjis_place(b, data.at(at + 1))
        if key < 0 {
            fail(Jis0213Invalid(at, b))
        }
        let codes = cell_codes(form, key / 65536, key / 256 % 256, key % 256)
        if codes.len() == 0 {
            fail(Jis0213Invalid(at, b))
        }
        out = append_codes(out, codes)
        at = at + 2
    }
    return out
}

fn is_euc_byte(b: i64) -> bool {
    return b >= 161 and b <= 254
}

fn decode_euc(form: Jis0213Form, data: bytes) -> str ! Jis0213Error {
    var out = ""
    var at = 0
    while at < data.len() {
        let b = data.at(at)
        if b < 128 {
            out = out + b.to_char()
            at = at + 1
            continue
        }
        if b == 142 {
            if at + 1 >= data.len() {
                fail(Jis0213Truncated(at))
            }
            let k = data.at(at + 1)
            if k < 161 or k > 223 {
                fail(Jis0213Invalid(at + 1, k))
            }
            out = out + (65377 + k - 161).to_char()
            at = at + 2
            continue
        }
        if b == 143 {
            if at + 2 >= data.len() {
                fail(Jis0213Truncated(at))
            }
            let row = data.at(at + 1)
            let cell = data.at(at + 2)
            if not is_euc_byte(row) or not is_euc_byte(cell) {
                fail(Jis0213Invalid(at, b))
            }
            // Plane 2 lives in the rows JIS X 0212 leaves empty; the rest
            // are JIS X 0212, so EUC-JP with it still reads.
            var codes: [i64] = []
            if plane2_index(row - 160) >= 0 {
                codes = cell_codes(form, 2, row - 160, cell - 160)
            } else {
                let code = jisx0212.code_at(row - 160, cell - 160)
                if code >= 0 {
                    codes = [code]
                }
            }
            if codes.len() == 0 {
                fail(Jis0213Invalid(at, b))
            }
            out = append_codes(out, codes)
            at = at + 3
            continue
        }
        if not is_euc_byte(b) {
            fail(Jis0213Invalid(at, b))
        }
        if at + 1 >= data.len() {
            fail(Jis0213Truncated(at))
        }
        let second = data.at(at + 1)
        if not is_euc_byte(second) {
            fail(Jis0213Invalid(at + 1, second))
        }
        let codes = cell_codes(form, 1, b - 160, second - 160)
        if codes.len() == 0 {
            fail(Jis0213Invalid(at, b))
        }
        out = append_codes(out, codes)
        at = at + 2
    }
    return out
}

/// Bytes to text.
pub fn decode(form: Jis0213Form, data: bytes) -> str ! Jis0213Error {
    if is_sjis(form) {
        return try decode_sjis(form, data)
    }
    return try decode_euc(form, data)
}

fn preferred(form: Jis0213Form) -> str {
    return match form {
        ShiftJis2004 -> preferred_sjis_2004()
        EucJis2004 -> preferred_euc_2004()
        ShiftJisX0213 -> preferred_sjis_2000()
        EucJisX0213 -> preferred_euc_2000()
    }
}

/// Code points this large still fit twice in an i64 key.
let PAIR_SHIFT = 4194304

/// The reverse table for a form: every cell's first code point in table
/// order, JIS X 0212 behind plane 2 for EUC, half-width katakana and JIS X
/// 0201's two Roman characters, then the reference encoder's own choices.
pub fn encoder(form: Jis0213Form) -> Jis0213Encoder {
    let sjis = is_sjis(form)
    var out: Map[i64, i64] = {}
    var pairs: Map[i64, i64] = {}
    for plane in [1, 2] {
        let rows = if plane == 1 { (1..95).to_list() } else { PLANE2_ROWS }
        for row in rows {
            var cell = 1
            while cell <= 94 {
                let codes = cell_codes(form, plane, row, cell)
                let value = if sjis { sjis_bytes(plane, row, cell) } else { euc_bytes(plane, row, cell) }
                if codes.len() == 1 and not out.has(codes[0]) {
                    out.set(codes[0], value)
                } else if codes.len() == 2 {
                    pairs.set(codes[0] * PAIR_SHIFT + codes[1], value)
                }
                cell = cell + 1
            }
        }
    }
    if not sjis {
        for row in jisx0212.rows() {
            if plane2_index(row) >= 0 {
                continue
            }
            var cell = 1
            while cell <= 94 {
                let code = jisx0212.code_at(row, cell)
                if code >= 0 and not out.has(code) {
                    out.set(code, euc_bytes(2, row, cell))
                }
                cell = cell + 1
            }
        }
    }
    var k = 65377
    while k <= 65439 {
        if not out.has(k) {
            out.set(k, if sjis { k - 65377 + 161 } else { 36352 + k - 65377 + 161 })
        }
        k = k + 1
    }
    if sjis {
        if not out.has(165) {
            out.set(165, 92)
        }
        if not out.has(8254) {
            out.set(8254, 126)
        }
    }
    for entry in load_pairs(preferred(form)).entries() {
        if entry.1 == 0 {
            out.delete(entry.0)
        } else {
            out.set(entry.0, entry.1)
        }
    }
    return Jis0213Encoder{ form: form, map: out, pairs: pairs }
}

fn push_value(out: [i64], v: i64) -> [i64] {
    var bytes_out = out
    if v >= 65536 {
        bytes_out.push(v / 65536)
    }
    if v >= 256 {
        bytes_out.push(v / 256 % 256)
    }
    bytes_out.push(v % 256)
    return bytes_out
}

/// Text to bytes with a prepared table. A letter followed by the
/// combining mark its cell includes is written as that one cell.
pub fn encode_with(table: Jis0213Encoder, text: str) -> bytes ! Jis0213Error {
    var out: [i64] = []
    let codes = text.codes()
    var at = 0
    while at < codes.len() {
        let code = codes[at]
        if at + 1 < codes.len() {
            match table.pairs.get(code * PAIR_SHIFT + codes[at + 1]) {
                Some(v) -> {
                    out = push_value(out, v)
                    at = at + 2
                    continue
                }
                None -> {}
            }
        }
        match table.map.get(code) {
            Some(v) -> out = push_value(out, v)
            None -> {
                if code >= 128 {
                    fail(Jis0213Unencodable(at, code))
                }
                out.push(code)
            }
        }
        at = at + 1
    }
    return bytes_of(out)
}

/// Text to bytes, building the table first.
pub fn encode(form: Jis0213Form, text: str) -> bytes ! Jis0213Error {
    return try encode_with(encoder(form), text)
}

// ---- Generated by scripts/gen_jis.py from Python's codecs. Do not edit below. ----

/// The rows plane 2 uses, which are the ones JIS X 0212 leaves empty.
fn plane2_rows() -> [i64] {
    return [1, 3, 4, 5, 8, 12, 13, 14, 15, 78, 79, 80, 81, 82, 83, 84, 85, 86, 87, 88, 89, 90, 91, 92, 93, 94]
}

