// The Grasm side of scripts/b41_diff.py: pairs of `<op[:param...]> <path>`.
// Each answer is one line of text, or ERR.
import zipcrypto
import shar
import debfile
import xar
import pkgbom
import reftable
import ewah
import gitnotes
import ignorewalk
import gitstatus
import gitindex
import zlib
import md5
import bytes_codec

fn hex(raw: bytes) -> str {
    let digits = "0123456789abcdef"
    var parts: [str] = []
    for i in 0..raw.len() {
        parts.push(digits.substr(raw.at(i) / 16, 1) + digits.substr(raw.at(i) % 16, 1))
    }
    parts.join("")
}

fn hs(s: str) -> str {
    hex(s.to_bytes())
}

fn unhex(s: str) -> bytes {
    bytes_codec.decode_hex(s) ?? bytes_of([])
}

fn ints(v: [i64]) -> str {
    v.map(|x| "{x}").join(",")
}

/// Lines of a spec file, each split at spaces.
fn spec(d: bytes) -> [[str]] {
    d.to_str().split("\n").filter(|l| l.len() > 0).map(|l| l.split(" "))
}

fn archives(p: [str], d: bytes) -> str ! str {
    let op = p[0]
    if op == "zcopen" {
        return match zipcrypto.open(d, unhex(p[2]).to_str(), unhex(p[1])) {
            Ok(b) -> hex(b)
            Err(ZcWrongPassword(_n)) -> "WRONG"
            Err(_e) -> "ERR"
        }
    }
    if op == "zcenc" {
        var files: [(str, bytes)] = []
        for f in spec(d) {
            files.push((unhex(f[0]).to_str(), if f.len() > 1 { unhex(f[1]) } else { bytes_of([]) }))
        }
        return hex(zipcrypto.encrypt_archive(files, unhex(p[1]), unhex(p[2]), 23119, 39612))
    }
    if op == "shar" {
        return (shar.parse(d.to_str()) ?? fail("x")).map(|it| match it {
            SharFile(path, data) -> "F:" + hs(path) + ":" + hex(data)
            SharDir(path) -> "D:" + hs(path)
        }).join(";")
    }
    if op == "sharw" {
        var items: [SharItem] = []
        for f in spec(d) {
            items.push(if f[0] == "D" { SharDir(unhex(f[1]).to_str()) } else { SharFile(unhex(f[1]).to_str(), if f.len() > 2 { unhex(f[2]) } else { bytes_of([]) }) })
        }
        return hs(shar.write(items))
    }
    if op == "deb" {
        let pkg = debfile.parse(d) ?? fail("x")
        return pkg.format + "|" + pkg.fields.map(|kv| hs(kv.0) + "=" + hs(kv.1)).join(",") + "|" +
        pkg.control_files.map(|e| hs(e.name)).join(",") + "|" + pkg.data_files.map(|e| hs(e.name) + ":" + md5.hex(e.data)).join(",") + "|" +
        debfile.check_md5sums(pkg).map(|x| hs(x)).join(",")
    }
    if op == "debdeps" {
        return match debfile.depends(d.to_str()) {
            Ok(groups) -> groups.map(|g| g.map(|r| r.name + "/" + r.arch_qualifier + "/" + r.relation + "/" + r.version + "/" + r.architectures.join("+"))
                    .join("|")).join(",")
            Err(_e) -> "ERR"
        }
    }
    if op == "debbuild" {
        let lines = spec(d)
        var fields: [(str, str)] = []
        var files: [(str, bytes)] = []
        for f in lines {
            if f[0] == "F" {
                fields.push((unhex(f[1]).to_str(), unhex(f[2]).to_str()))
            } else {
                files.push((unhex(f[1]).to_str(), if f.len() > 2 { unhex(f[2]) } else { bytes_of([]) }))
            }
        }
        return hex(debfile.build(fields, files, 1700000000))
    }
    return try more_archives(p, d)
}

fn more_archives(p: [str], d: bytes) -> str ! str {
    let op = p[0]
    if op == "xar" {
        let a = xar.parse(d) ?? fail("x")
        var rows: [str] = []
        for e in a.entries {
            let content = xar.contents(a, e) ?? fail("x")
            rows.push(hs(e.path) + ":" + e.kind + ":{e.mode}:{e.uid}:{e.gid}:" + hs(e.link) + ":{content.len()}:" + md5.hex(content))
        }
        return "{xar.toc_checksum_holds(a)}|" + rows.join(";")
    }
    if op == "xarw" {
        var items: [XarItem] = []
        for f in spec(d) {
            let path = unhex(f[1]).to_str()
            items.push(if f[0] == "D" { XiDir(path, f[2].parse_int_base(8) ?? 493) } else if f[0] == "L" { XiLink(path, unhex(f[2]).to_str()) }
                else { XiFile(path, if f.len() > 3 { unhex(f[3]) } else { bytes_of([]) }, f[2].parse_int_base(8) ?? 420) })
        }
        return hex(xar.build(items))
    }
    if op == "bom" {
        return hs((pkgbom.parse(d) ?? fail("x")).map(|e| pkgbom.lsbom_line(e)).join("\n"))
    }
    return try git_ops(p, d)
}

fn read_text(path: str) -> str / {io} {
    return match read_bytes(path) {
        Ok(b) -> b.to_str()
        Err(_e) -> ""
    }
}

fn git_ops(p: [str], d: bytes) -> str ! str / {io} {
    let op = p[0]
    if op == "reftable" {
        let dir = d.to_str().trim()
        var tables: [RtTable] = []
        for name in read_text(dir + "/tables.list").split("\n") {
            if name.len() > 0 {
                let b = read_bytes(dir + "/" + name) ?? fail("x")
                tables.push(reftable.read_table(b) ?? fail("x"))
            }
        }
        let (refs, logs) = reftable.merge(tables)
        return refs.map(|r| r.name + " {r.kind} " + r.value + " " + r.peeled + " " + r.target).join(";") + "|" +
        logs.map(|l| l.name + " " + l.old_id + " " + l.new_id + " " + hs(l.who) + " " + hs(l.email) + " {l.time} {l.tz} " + hs(l.message)).join(";")
    }
    if op == "bitmap" {
        let f = ewah.bitmap_file(d, p[1].parse_int() ?? 0) ?? fail("x")
        // Every EWAH in the file, decoded and written again.
        var at = 32
        var same = 0
        var differ = 0
        var k = 0
        while k < 4 + f.entries.len() {
            let start = if k < 4 { at } else { at + 6 }
            let (bits, next) = ewah.decode(d, start) ?? fail("x")
            let size = d.at(start).shl(24).bit_or(d.at(start + 1).shl(16)).bit_or(d.at(start + 2).shl(8)).bit_or(d.at(start + 3))
            if ewah.encode(bits, size) == d.slice(start, next) {
                same = same + 1
            } else {
                differ = differ + 1
            }
            at = next
            k = k + 1
        }
        return ints(f.commits) + "|" + ints(f.trees) + "|" + ints(f.blobs) + "|" + ints(f.tags) + "|" +
        f.entries.map(|e| "{e.position}:" + ints(e.bits)).join(";") + "|{f.name_hashes.len()}|{same}:{differ}"
    }
    return try more_git(p, d)
}

fn read_loose(dir: str, id: str) -> Option[bytes] / {io} {
    return match read_bytes(dir + "/objects/" + id.substr(0, 2) + "/" + id.substr(2, 38)) {
        Ok(raw) -> match zlib.decompress(raw, 1073741824) {
            Ok(full) -> {
                var n = 0
                while n < full.len() and full.at(n) != 0 {
                    n = n + 1
                }
                Some(full.slice(n + 1, full.len()))
            }
            Err(_e) -> None
        }
        Err(_e) -> None
    }
}

/// Every tree reachable from `root`, read from loose objects.
fn preload(dir: str, root: str) -> Map[str, bytes] / {io} {
    var m: Map[str, bytes] = {}
    var todo = [root]
    while todo.len() > 0 {
        let id = todo.pop() ?? ""
        match read_loose(dir, id) {
            Some(content) -> {
                m.set(id, content)
                match gitnotes.tree_entries(content) {
                    Ok(es) -> {
                        for (mode, _name, child) in es {
                            if mode == "40000" {
                                todo.push(child)
                            }
                        }
                    }
                    Err(_e) -> {}
                }
            }
            None -> {}
        }
    }
    return m
}

fn more_git(p: [str], d: bytes) -> str ! str / {io} {
    let op = p[0]
    if op == "notes" {
        let objects = preload(d.to_str().trim(), p[1])
        let (notes, other) = gitnotes.read(|id| objects.get(id), p[1]) ?? fail("x")
        return notes.map(|n| n.object + " " + n.blob).join(";") + "|{other.len()}"
    }
    if op == "notesw" {
        var notes: [NoteEntry] = []
        for f in spec(d) {
            notes.push(NoteEntry{ object: f[0], blob: f[1] })
        }
        let (root, trees) = gitnotes.write(notes)
        return root + "|" + trees.map(|t| t.0 + ":" + hex(t.1)).join(";")
    }
    if op == "notescombine" {
        let parts = d.to_str().split("\n")
        let a = unhex(parts[0]).to_str()
        let b = unhex(if parts.len() > 1 { parts[1] } else { "" }).to_str()
        return hs(if p[1] == "union" { gitnotes.combine_concatenate(a, b) } else { gitnotes.combine_cat_sort_uniq(a, b) })
    }
    if op == "ignore" or op == "status" {
        var paths: [(str, bool)] = []
        var gitignores: [(str, str)] = []
        var info = ""
        var global = ""
        var head: [GsEntry] = []
        var work: [GsEntry] = []
        var index: [GsIndexEntry] = []
        for f in spec(d) {
            let k = f[0]
            if k == "P" {
                paths.push((unhex(f[1]).to_str(), f[2] == "1"))
            } else if k == "G" {
                gitignores.push((unhex(f[1]).to_str(), unhex(f[2]).to_str()))
            } else if k == "X" {
                info = unhex(f[1]).to_str()
            } else if k == "E" {
                global = unhex(f[1]).to_str()
            } else if k == "H" or k == "W" {
                let e = GsEntry{ path: unhex(f[1]).to_str(), mode: f[2].parse_int_base(8) ?? 0, id: f[3] }
                if k == "H" {
                    head.push(e)
                } else {
                    work.push(e)
                }
            } else if k == "I" {
                let ix = gitindex.decode(read_bytes(unhex(f[1]).to_str()) ?? fail("x")) ?? fail("x")
                for e in ix.entries {
                    index.push(GsIndexEntry{ path: e.path, mode: e.mode, id: e.oid, stage: e.stage })
                }
            }
        }
        if op == "ignore" {
            return ignorewalk.walk(paths, gitignores, info, global).filter(|x| x.1).map(|x| hs(x.0)).join(",")
        }
        return hs(gitstatus.porcelain_v2(gitstatus.status(head, index, work, gitignores, info, global)).join("\n"))
    }
    fail("unknown op")
}

fn main() / {io} {
    let argv = args()
    var i = 0
    while i + 1 < argv.len() {
        let out = match read_bytes(argv[i + 1]) {
            Ok(data) -> match archives(argv[i].split(":"), data) {
                Ok(s) -> s
                Err(_) -> "ERR"
            }
            Err(_) -> "NOFILE"
        }
        print(out)
        i = i + 2
    }
}
