    let extras = [("PHAGS-PA", "PHAGS_PA")]
    // END TABLES
    var keys: Map[str, str] = map()
    for (b, spaced) in blocks {
        keys.set(b, b)
        for s in spaced {
            keys.set(s, b)
            keys.set(s.replace(" ", ""), b)
        }
    }
    for (k, b) in extras {
        keys.set(k, b)
    }
    return UbTable{ blocks: blocks, ranges: ranges, keys: keys }
}

type UbError =
    | InvalidCodePoint(cp: i64)

/// The block `cp` is in, as its Java constant name; `None` for a code point
/// in no block. Outside 0..0x10FFFF is an error, as Java throws.
pub fn of(t: UbTable, cp: i64) -> Option[str] ! UbError {
    if cp < 0 or cp > 1114111 {
        fail(InvalidCodePoint(cp))
    }
    var lo = 0
    var hi = t.ranges.len()
    while lo < hi {
        let mid = (lo + hi) / 2
        let (a, z, name) = t.ranges[mid]
        if cp < a {
            hi = mid
        } else if cp > z {
            lo = mid + 1
        } else {
            return Some(name)
        }
    }
    return None
}

/// `UnicodeBlock.forName`: any accepted spelling, any case.
pub fn for_name(t: UbTable, name: str) -> Option[str] {
    return t.keys.get(name.to_upper())
}
