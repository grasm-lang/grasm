// Python's `mimetypes`, as a CPython 3.13 `MimeTypes()` answers on a POSIX
// system: `guess_type`, `guess_file_type`, `guess_all_extensions` and
// `guess_extension`, from Python's built-in tables.
//
// Python web frameworks, upload handlers and static file servers pick a
// Content-Type with this, so a tool that has to predict what such a server
// sends needs the same answers, including the odd ones:
//
//   - `guess_type` reads its argument as a URL first (`urllib.parse`,
//     errors included): with a scheme of two or more letters only the path
//     counts, so `?query`, `#fragment` and `;params` are cut off, and a
//     `data:` URL is typed by what precedes its first `;` or `,` (or is
//     `text/plain` when that holds `=` or no `/`). A one-letter scheme is a
//     drive letter and the whole text is a file name.
//   - Extensions are matched case-insensitively (Python's `lower()`, so
//     the Kelvin sign is a `k`), after `.tgz`, `.taz`, `.tz`, `.tbz2`,
//     `.txz` and `.svgz` are expanded; an encoding suffix (`.gz`, `.Z`,
//     `.bz2`, `.xz`, `.br`) is matched case-sensitively and strips first.
//   - `splitext` ignores leading dots, so `.bashrc` has no extension.
//   - Non-strict mode adds Python's eight common-but-unofficial types.
//   - `guess_all_extensions` lowercases the type and lists extensions in
//     the order Python's table first gave them.
//
// Not modelled: the module-level functions, which also read the system's
// mime.types files (their answers depend on the machine), and types added
// with `add_type` or `read`. The tables at the end are generated from
// CPython 3.13 by gen_tables.py.

import pyurlparse

/// The ValueError `urllib.parse` raises for a malformed URL.
type PyMimeError = | PyMimeValueError(msg: str)

pub fn error_text(e: PyMimeError) -> str {
    return match e {
        PyMimeValueError(m) -> m
    }
}

/// Python's `lower()` where it can matter here: the tables are ASCII, and
/// the only other character whose lower case is ASCII is the Kelvin sign.
/// None when the text holds anything else outside ASCII (it cannot match).
fn key_lower(s: str) -> Option[str] {
    var out: [str] = []
    for c in s.codes() {
        if c >= 65 and c <= 90 {
            out.push((c + 32).to_char())
        } else if c == 8490 {
            out.push("k")
        } else if c < 128 {
            out.push(c.to_char())
        } else {
            return None
        }
    }
    return Some(out.join(""))
}

fn lookup(table: [str], key: str) -> Option[str] {
    var i = 0
    while i + 1 < table.len() {
        if table[i] == key {
            return Some(table[i + 1])
        }
        i = i + 2
    }
    return None
}

fn lookup_lower(table: [str], key: str) -> Option[str] {
    return match key_lower(key) {
        Some(k) -> lookup(table, k)
        None -> None
    }
}

/// `posixpath.splitext`.
pub fn splitext(p: str) -> (str, str) {
    let cs = p.chars()
    var sep = 0 - 1
    var dot = 0 - 1
    for i in 0..cs.len() {
        if cs[i] == "/" {
            sep = i
        }
        if cs[i] == "." {
            dot = i
        }
    }
    if dot > sep {
        var k = sep + 1
        while k < dot {
            if cs[k] != "." {
                return (cs.slice(0, dot).join(""), cs.slice(dot, cs.len()).join(""))
            }
            k = k + 1
        }
    }
    return (p, "")
}

fn file_type(path: str, strict: bool) -> (Option[str], Option[str]) {
    var parts = splitext(path)
    var expanded = lookup_lower(PYMIME_SUFFIXES, parts.1)
    while expanded != None {
        parts = splitext(parts.0 + (expanded ?? ""))
        expanded = lookup_lower(PYMIME_SUFFIXES, parts.1)
    }
    let encoding = lookup(PYMIME_ENCODINGS, parts.1)
    if encoding != None {
        parts = splitext(parts.0)
    }
    let strict_type = lookup_lower(PYMIME_TYPES, parts.1)
    if strict_type != None or strict {
        return (strict_type, encoding)
    }
    return (lookup_lower(PYMIME_COMMON, parts.1), encoding)
}

/// `guess_file_type(path, strict=strict)`: the type and encoding of a file
/// name (POSIX: there is no drive to remove).
pub fn guess_file_type(path: str, strict: bool) -> (Option[str], Option[str]) {
    return file_type(path, strict)
}

fn data_type(url: str) -> Option[str] {
    let cs = url.chars()
    var comma = 0 - 1
    for i in 0..cs.len() {
        if comma < 0 and cs[i] == "," {
            comma = i
        }
    }
    if comma < 0 {
        return None
    }
    var end = comma
    for i in 0..comma {
        if end == comma and cs[i] == ";" {
            end = i
        }
    }
    let t = cs.slice(0, end).join("")
    if t.contains("=") or not t.contains("/") {
        return Some("text/plain")
    }
    return Some(t)
}

/// `guess_type(url, strict)`: the type and encoding.
pub fn guess_type(url: str, strict: bool) -> (Option[str], Option[str]) ! PyMimeError {
    let p = match pyurlparse.urlparse(url, "", true) {
        Ok(p) -> p
        Err(e) -> match e {
            PyValueError(m) -> fail(PyMimeValueError(m))
        }
    }
    if p.scheme.len() <= 1 {
        return file_type(url, strict)
    }
    if p.scheme == "data" {
        return (data_type(p.path), None)
    }
    return file_type(p.path, strict)
}

fn extensions_of(table: [str], t: str) -> [str] {
    var out: [str] = []
    var i = 0
    while i + 1 < table.len() {
        if table[i + 1] == t and not out.contains(table[i]) {
            out.push(table[i])
        }
        i = i + 2
    }
    return out
}

/// `guess_all_extensions(type, strict)`.
pub fn guess_all_extensions(mime: str, strict: bool) -> [str] {
    let t = match key_lower(mime) {
        Some(k) -> k
        None -> return []
    }
    var out = extensions_of(PYMIME_TYPES, t)
    if not strict {
        for e in extensions_of(PYMIME_COMMON, t) {
            if not out.contains(e) {
                out.push(e)
            }
        }
    }
    return out
}

/// `guess_extension(type, strict)`: the first of them.
pub fn guess_extension(mime: str, strict: bool) -> Option[str] {
    let all = guess_all_extensions(mime, strict)
    return if all.len() > 0 { Some(all[0]) } else { None }
}

