// Whether a package may be installed here: npm-install-checks.
//
// Three questions npm asks of every package it is about to install, and
// the messages it gives when the answer is no:
//
// - `check_engine`: does this Node and this npm satisfy `engines.node`
//   and `engines.npm`? Ranges are node-semver ranges, prereleases
//   included; a range that is not text fails.
// - `check_platform`: does `os`, `cpu` and `libc` allow this machine? Each
//   is a name or a list of names; `!name` excludes one, a list of only
//   exclusions allows everything else, `["any"]` allows everything, and
//   a `libc` requirement fails where the C library is unknown.
// - `check_dev_engines`: the `devEngines` field -- `packageManager`,
//   `runtime`, `cpu`, `libc`, `os`, each one dependency or a list of
//   them, with `name`, `version` (a range when it is one, else exact) and
//   `onFail` (`ignore`, `warn`, `error`, `download`); malformed entries
//   throw, mismatches are reported, and an engine fails only when every
//   dependency listed for it does.
//
// Inputs are JSON, read as JavaScript reads it: keys that are integers
// first, the last of a repeated key winning; a value of the wrong type
// gets the TypeError JavaScript would throw. This follows
// npm-install-checks 7.1.2 with node-semver 7.7.3.
import nodesemver
import jsnumber

type NicValue =
    | NicNull
    | NicBool(b: bool)
    | NicNum(n: f64)
    | NicStr(s: str)
    | NicArr(items: [NicValue])
    | NicObj(keys: [str], vals: [NicValue])

type InstallCheckError =
    | BadEngine()
    | BadPlatform()
    /// What JavaScript would throw: an Error's or a TypeError's message.
    | CheckThrown(why: str)
    | CheckJsonError(why: str)

type DevEngineFailure = { engine: str, is_warn: bool, is_error: bool, messages: [str] }

// --- JSON, as JSON.parse reads it ---------------------------------------------

type NicCursor = { c: [i64], at: i64 }

fn ws(inout p: NicCursor) {
    while p.at < p.c.len() and (p.c[p.at] == 32 or p.c[p.at] == 9 or p.c[p.at] == 10 or p.c[p.at] == 13) {
        p.at = p.at + 1
    }
}

fn hex_digit(c: i64) -> i64 {
    return if c >= 48 and c <= 57 { c - 48 } else if c >= 97 and c <= 102 { c - 87 } else if c >= 65 and c <= 70 { c - 55 } else { 0 - 1 }
}

fn read_string(inout p: NicCursor) -> str ! InstallCheckError {
    p.at = p.at + 1
    var units: [i64] = []
    while true {
        if p.at >= p.c.len() {
            fail(CheckJsonError("unterminated string"))
        }
        let c = p.c[p.at]
        p.at = p.at + 1
        if c == 34 {
            break
        }
        if c < 32 {
            fail(CheckJsonError("control character in a string"))
        }
        if c != 92 {
            units.push(c)
            continue
        }
        let e = if p.at < p.c.len() { p.c[p.at] } else { 0 }
        p.at = p.at + 1
        if e == 117 {
            var v = 0
            for _k in 0..4 {
                let d = if p.at < p.c.len() { hex_digit(p.c[p.at]) } else { 0 - 1 }
                if d < 0 {
                    fail(CheckJsonError("bad \\u escape"))
                }
                v = v * 16 + d
                p.at = p.at + 1
            }
            units.push(0 - 1 - v)
        } else {
            let m = [(34, 34), (92, 92), (47, 47), (98, 8), (102, 12), (110, 10), (114, 13), (116, 9)].filter(|x| x.0 == e)
            if m.len() == 0 {
                fail(CheckJsonError("bad escape"))
            }
            units.push(m[0].1)
        }
    }
    // Escaped units (stored negated) pair up as UTF-16; a lone surrogate
    // becomes U+FFFD.
    var out: [i64] = []
    var i = 0
    while i < units.len() {
        let u = if units[i] < 0 { 0 - 1 - units[i] } else { units[i] }
        if units[i] < 0 and u >= 55296 and u <= 56319 and i + 1 < units.len() and units[i + 1] < 0 and 0 - 1 - units[i + 1] >= 56320 and 0 - 1 - units[i + 1] <= 57343 {
            out.push(65536 + (u - 55296).shl(10) + (0 - 1 - units[i + 1]) - 56320)
            i = i + 2
            continue
        }
        out.push(if units[i] < 0 and u >= 55296 and u <= 57343 { 65533 } else { u })
        i = i + 1
    }
    return out.map(|x| x.to_char()).join("")
}

fn at_digit(p: NicCursor) -> bool {
    return p.at < p.c.len() and p.c[p.at] >= 48 and p.c[p.at] <= 57
}

fn read_number(inout p: NicCursor) -> f64 ! InstallCheckError {
    let start = p.at
    if p.c[p.at] == 45 {
        p.at = p.at + 1
    }
    let int_start = p.at
    while at_digit(p) {
        p.at = p.at + 1
    }
    if p.at == int_start or p.at - int_start > 1 and p.c[int_start] == 48 {
        fail(CheckJsonError("bad number"))
    }
    if p.at < p.c.len() and p.c[p.at] == 46 {
        p.at = p.at + 1
        let f = p.at
        while at_digit(p) {
            p.at = p.at + 1
        }
        if p.at == f {
            fail(CheckJsonError("bad number"))
        }
    }
    if p.at < p.c.len() and (p.c[p.at] == 101 or p.c[p.at] == 69) {
        p.at = p.at + 1
        if p.at < p.c.len() and (p.c[p.at] == 43 or p.c[p.at] == 45) {
            p.at = p.at + 1
        }
        let e = p.at
        while at_digit(p) {
            p.at = p.at + 1
        }
        if p.at == e {
            fail(CheckJsonError("bad number"))
        }
    }
    return jsnumber.number(p.c.slice(start, p.at).map(|x| x.to_char()).join(""))
}

/// A canonical array index, which JavaScript lists first.
fn index_key(k: str) -> i64 {
    if k.len() == 0 or k.len() > 10 or k.len() > 1 and k.starts_with("0") {
        return 0 - 1
    }
    var v = 0
    for c in k.codes() {
        if c < 48 or c > 57 {
            return 0 - 1
        }
        v = v * 10 + c - 48
    }
    return if v < 4294967295 { v } else { 0 - 1 }
}

/// Keys in JavaScript's order: integer indices ascending, then the rest as
/// they first appeared.
fn js_order(keys: [str], vals: [NicValue]) -> NicValue {
    var ints: [(i64, i64)] = []
    var rest: [i64] = []
    for i in 0..keys.len() {
        let n = index_key(keys[i])
        if n >= 0 {
            ints.push((n, i))
        } else {
            rest.push(i)
        }
    }
    ints.sort()
    let order = ints.map(|x| x.1) + rest
    return NicObj(order.map(|i| keys[i]), order.map(|i| vals[i]))
}

fn read_object(inout p: NicCursor, depth: i64) -> NicValue ! InstallCheckError {
    p.at = p.at + 1
    var keys: [str] = []
    var vals: [NicValue] = []
    ws(p)
    if p.at < p.c.len() and p.c[p.at] == 125 {
        p.at = p.at + 1
        return NicObj([], [])
    }
    while true {
        ws(p)
        if p.at >= p.c.len() or p.c[p.at] != 34 {
            fail(CheckJsonError("expected a key"))
        }
        let k = try read_string(p)
        ws(p)
        if p.at >= p.c.len() or p.c[p.at] != 58 {
            fail(CheckJsonError("expected ':'"))
        }
        p.at = p.at + 1
        let v = try read_value(p, depth + 1)
        var found = false
        for i in 0..keys.len() {
            if keys[i] == k {
                vals[i] = v
                found = true
            }
        }
        if not found {
            keys.push(k)
            vals.push(v)
        }
        ws(p)
        if p.at < p.c.len() and p.c[p.at] == 44 {
            p.at = p.at + 1
        } else if p.at < p.c.len() and p.c[p.at] == 125 {
            p.at = p.at + 1
            return js_order(keys, vals)
        } else {
            fail(CheckJsonError("expected ',' or '}'"))
        }
    }
    fail(CheckJsonError("unterminated object"))
}

fn read_value(inout p: NicCursor, depth: i64) -> NicValue ! InstallCheckError {
    ws(p)
    if p.at >= p.c.len() or depth > 256 {
        fail(CheckJsonError("unexpected end"))
    }
    let c = p.c[p.at]
    if c == 123 {
        return try read_object(p, depth)
    }
    if c == 91 {
        p.at = p.at + 1
        var items: [NicValue] = []
        ws(p)
        if p.at < p.c.len() and p.c[p.at] == 93 {
            p.at = p.at + 1
            return NicArr(items)
        }
        while true {
            items.push(try read_value(p, depth + 1))
            ws(p)
            if p.at < p.c.len() and p.c[p.at] == 44 {
                p.at = p.at + 1
            } else if p.at < p.c.len() and p.c[p.at] == 93 {
                p.at = p.at + 1
                return NicArr(items)
            } else {
                fail(CheckJsonError("expected ',' or ']'"))
            }
        }
    }
    if c == 34 {
        return NicStr(try read_string(p))
    }
    if c == 45 or c >= 48 and c <= 57 {
        return NicNum(try read_number(p))
    }
    for (word, v) in [("true", NicBool(true)), ("false", NicBool(false)), ("null", NicNull)] {
        let w = word.codes()
        if p.at + w.len() <= p.c.len() and p.c.slice(p.at, p.at + w.len()) == w {
            p.at = p.at + w.len()
            return v
        }
    }
    fail(CheckJsonError("unexpected token"))
}

/// JSON.parse.
pub fn parse_json(text: str) -> NicValue ! InstallCheckError {
    var p = NicCursor{ c: text.codes(), at: 0 }
    let v = try read_value(p, 0)
    ws(p)
    if p.at < p.c.len() {
        fail(CheckJsonError("trailing text"))
    }
    return v
}

// --- property access, as JavaScript does it -------------------------------------

/// `v[key]`, None for undefined. Objects and arrays have no inherited
/// property any of these checks reads.
fn get(v: NicValue, key: str) -> Option[NicValue] {
    return match v {
        NicObj(keys, vals) -> {
            var out: Option[NicValue] = None
            for i in 0..keys.len() {
                if keys[i] == key {
                    out = Some(vals[i])
                }
            }
            out
        }
        NicArr(items) -> {
            let i = index_key(key)
            if key == "length" { Some(NicNum(items.len().as_f64())) } else if i >= 0 and i < items.len() { Some(items[i]) } else { None }
        }
        NicStr(s) -> {
            let i = index_key(key)
            if key == "length" { Some(NicNum(s.len().as_f64())) } else if i >= 0 and i < s.len() { Some(NicStr(s.substr(i, 1))) } else { None }
        }
        _ -> None
    }
}

fn truthy(v: Option[NicValue]) -> bool {
    return match v {
        None -> false
        Some(NicNull) -> false
        Some(NicBool(b)) -> b
        Some(NicNum(n)) -> n != 0.0 and n == n
        Some(NicStr(s)) -> s.len() > 0
        Some(_x) -> true
    }
}

fn text_of(v: Option[NicValue]) -> Option[str] {
    return match v {
        Some(NicStr(s)) -> Some(s)
        _ -> None
    }
}

/// `typeof v === 'object' && v !== null && !Array.isArray(v)`
fn is_plain_object(v: Option[NicValue]) -> bool {
    return match v {
        Some(NicObj(_k, _v)) -> true
        _ -> false
    }
}

fn keys_of(v: NicValue) -> [str] {
    return match v {
        NicObj(keys, _vals) -> keys
        _ -> []
    }
}

// --- checkEngine and checkPlatform ----------------------------------------------

fn satisfied(r: NsRegexes, version: str, range: Option[NicValue], loose: bool, pre: bool) -> bool {
    return match text_of(range) {
        Some(rg) -> nodesemver.satisfies(r, version, rg, loose, pre)
        None -> false
    }
}

/// `checkEngine`: Ok, or BadEngine when the Node or npm version given is
/// outside `engines`. `force` ignores the Node version.
pub fn check_engine(r: NsRegexes, target: NicValue, npm_version: Option[str], node_version: Option[str], force: bool) -> () ! InstallCheckError {
    let eng = get(target, "engines")
    if not truthy(eng) {
        return ()
    }
    let e = match eng {
        Some(x) -> x
        None -> NicNull
    }
    let node = if force { "" } else { node_version ?? "" }
    let npm = npm_version ?? ""
    let node_fail = node.len() > 0 and truthy(get(e, "node")) and not satisfied(r, node, get(e, "node"), false, true)
    let npm_fail = npm.len() > 0 and truthy(get(e, "npm")) and not satisfied(r, npm, get(e, "npm"), false, true)
    if node_fail or npm_fail {
        fail(BadEngine())
    }
    return ()
}

fn type_error_for(v: NicValue, what: str) -> InstallCheckError {
    return match v {
        NicNull -> CheckThrown("Cannot read properties of null (reading '" + what + "')")
        _ -> CheckThrown("entry." + what + " is not a function")
    }
}

/// `checkList`: allowed by a name or a list of names.
fn check_list(value: Option[str], list0: NicValue) -> bool ! InstallCheckError {
    let list = match list0 {
        NicStr(s) -> NicArr([NicStr(s)])
        x -> x
    }
    if get(list, "length") == Some(NicNum(1.0)) and get(list, "0") == Some(NicStr("any")) {
        return true
    }
    let items = match list {
        NicArr(xs) -> xs
        _ -> fail(CheckThrown("list is not iterable"))
    }
    var negated = 0
    var matched = false
    for entry in items {
        let e = match entry {
            NicStr(s) -> s
            x -> fail(type_error_for(x, "charAt"))
        }
        let negate = e.starts_with("!")
        let probe = if negate { e.substr(1, e.len()) } else { e }
        if negate {
            negated = negated + 1
            if value == Some(probe) {
                return false
            }
        } else {
            matched = matched or value == Some(probe)
        }
    }
    return matched or negated == items.len()
}

/// `checkPlatform` against an `os`, a `cpu`, and a C library (`glibc`,
/// `musl`, or None where it is unknown).
pub fn check_platform(target: NicValue, force: bool, os: str, cpu: str, libc: Option[str]) -> () ! InstallCheckError {
    if force {
        return ()
    }
    let os_ok = if truthy(get(target, "os")) { try check_list(Some(os), get(target, "os") ?? NicNull) } else { true }
    let cpu_ok = if truthy(get(target, "cpu")) { try check_list(Some(cpu), get(target, "cpu") ?? NicNull) } else { true }
    let known = match libc {
        Some(s) -> s.len() > 0
        None -> false
    }
    var libc_ok = if truthy(get(target, "libc")) { try check_list(if known { libc } else { None }, get(target, "libc") ?? NicNull) } else { true }
    if truthy(get(target, "libc")) and not known {
        libc_ok = false
    }
    if not os_ok or not cpu_ok or not libc_ok {
        fail(BadPlatform())
    }
    return ()
}

// --- checkDevEngines -------------------------------------------------------------

fn throw(why: str) -> InstallCheckError {
    return CheckThrown(why)
}

/// One dependency: None when it matches, a message when it does not, or
/// the error thrown for a malformed one.
fn check_dependency(r: NsRegexes, wanted: NicValue, current: Option[NicValue], engine: str, loose: bool, pre: bool) -> Option[str] ! InstallCheckError {
    if not is_plain_object(Some(wanted)) {
        fail(throw("Invalid non-object value for \"" + engine + "\""))
    }
    let props = keys_of(wanted)
    for prop in props {
        if not ["name", "version", "onFail"].contains(prop) {
            fail(throw("Invalid property \"" + prop + "\" for \"" + engine + "\""))
        }
    }
    if not props.contains("name") {
        fail(throw("Missing \"name\" property for \"" + engine + "\""))
    }
    let name = text_of(get(wanted, "name")) ?? fail(throw("Invalid non-string value for \"name\" within \"" + engine + "\""))
    let cur = current ?? NicNull
    let cur_name = text_of(get(cur, "name")) ?? ""
    if cur_name.len() == 0 {
        fail(throw("Unable to determine \"name\" for \"" + engine + "\""))
    }
    if props.contains("onFail") {
        let on_fail = text_of(get(wanted, "onFail")) ?? fail(throw("Invalid non-string value for \"onFail\" within \"" + engine + "\""))
        if not ["ignore", "warn", "error", "download"].contains(on_fail) {
            fail(throw("Invalid onFail value \"" + on_fail + "\" for \"" + engine + "\""))
        }
    }
    if name != cur_name {
        return Some("Invalid name \"" + name + "\" does not match \"" + cur_name + "\" for \"" + engine + "\"")
    }
    if props.contains("version") {
        let version = text_of(get(wanted, "version")) ?? fail(throw("Invalid non-string value for \"version\" within \"" + engine + "\""))
        let cur_version = text_of(get(cur, "version")) ?? ""
        if cur_version.len() == 0 {
            fail(throw("Unable to determine \"version\" for \"" + engine + "\" \"" + name + "\""))
        }
        if nodesemver.valid_range(r, version, false, false) != None {
            if not nodesemver.satisfies(r, cur_version, version, loose, pre) {
                return Some("Invalid semver version \"" + version + "\" does not match \"" + cur_version + "\" for \"" + engine + "\"")
            }
        } else if version != cur_version {
            return Some("Invalid version \"" + version + "\" does not match \"" + cur_version + "\" for \"" + engine + "\"")
        }
    }
    return None
}

/// `checkDevEngines`: the engines that fail (each with its dependencies'
/// messages and whether `onFail` makes it a warning or an error), or the
/// error thrown for a malformed field. `loose` and `pre` are the semver
/// options passed on to range checks.
pub fn check_dev_engines(r: NsRegexes, wanted: NicValue, current: NicValue, loose: bool, pre: bool) -> [DevEngineFailure] ! InstallCheckError {
    if not is_plain_object(Some(wanted)) {
        fail(throw("Invalid non-object value for \"devEngines\""))
    }
    var out: [DevEngineFailure] = []
    for engine in keys_of(wanted) {
        if not ["packageManager", "runtime", "cpu", "libc", "os"].contains(engine) {
            fail(throw("Invalid property \"devEngines." + engine + "\""))
        }
        let authored = get(wanted, engine) ?? NicNull
        let deps = match authored {
            NicArr(xs) -> xs
            x -> [x]
        }
        let cur = match current {
            NicNull -> fail(CheckThrown("Cannot read properties of null (reading '" + engine + "')"))
            _ -> get(current, engine)
        }
        let current_engine = if truthy(cur) { cur } else { Some(NicObj([], [])) }
        if deps.len() == 0 {
            continue
        }
        var messages: [str] = []
        for dep in deps {
            match try check_dependency(r, dep, current_engine, engine, loose, pre) {
                Some(m) -> messages.push(m)
                None -> ()
            }
        }
        if messages.len() == deps.len() {
            let last = deps[deps.len() - 1]
            var on_fail = if truthy(get(last, "onFail")) { text_of(get(last, "onFail")) ?? "error" } else { "error" }
            if on_fail == "download" {
                on_fail = "error"
            }
            out.push(DevEngineFailure{ engine: engine, is_warn: on_fail == "warn", is_error: on_fail == "error", messages: messages })
        }
    }
    return out
}
