// The Grasm side of scripts/b31_diff.py: `<op> x<bytes> x<text>`. Answers
// that can hold a line break are hex.
import gomod
import signednote
import tlog
import coverprofile

fn from_hex(text: str) -> bytes {
    var out: [i64] = []
    var i = 1
    while i + 1 < text.len() {
        out.push(text.substr(i, 2).parse_int_base(16) ?? 0)
        i = i + 2
    }
    bytes_of(out)
}

fn unhex(text: str) -> bytes {
    from_hex(":" + text)
}

fn hex(raw: bytes) -> str {
    let digits = "0123456789abcdef"
    var out = ""
    var i = 0
    while i < raw.len() {
        out = out + digits.substr(raw.at(i) / 16, 1) + digits.substr(raw.at(i) % 16, 1)
        i = i + 1
    }
    out
}

fn summary(f: GoModFile) -> str {
    let rs = "\u{1e}"
    "module=" + f.module + rs + "deprecated=" + f.deprecated + rs + "go=" + f.go + rs + "toolchain=" + f.toolchain + rs +
    "godebug=" + f.godebug.map(|g| g.0 + "=" + g.1).join(",") + rs +
    "require=" + f.require.map(|r| r.path + "@" + r.version + (if r.indirect { "!" } else { "" })).join(",") + rs +
    "exclude=" + f.exclude.map(|e| e.0 + "@" + e.1).join(",") + rs +
    "replace=" + f.replace.map(|r| r.old_path + "@" + r.old_version + "=>" + r.new_path + "@" + r.new_version).join(",") + rs +
    "retract=" + f.retract.map(|r| r.low + ".." + r.high + "#" + r.rationale).join(",") + rs +
    "tool=" + f.tool.join(",") + rs + "ignore=" + f.ignore.join(",")
}

fn sig_names(sigs: [NoteSig]) -> str {
    let d = "0123456789abcdef"
    var names = sigs.map(|s| {
        var h = ""
        var i = 7
        while i >= 0 {
            h = h + d.substr(s.hash.ushr(4 * i).bit_and(15), 1)
            i = i - 1
        }
        s.name + "+" + h
    })
    names.sort()
    names.join(",")
}

fn answer_note(what: str, a: bytes, text: str) -> str {
    if what == "note.keygen" {
        return match signednote.generate_key(a, text) {
            Ok(k) -> k.0 + "|" + k.1
            Err(_) -> "ERR"
        }
    }
    let keys = if text.len() == 0 { [] } else { text.split("\n") }
    if what == "note.sign" {
        var signers: [NoteSigner] = []
        for k in keys {
            match signednote.parse_signer(k) {
                Ok(s) -> signers.push(s)
                Err(_) -> return "ERR"
            }
        }
        return match signednote.sign(a.to_str(), signers) {
            Ok(m) -> hex(m.to_bytes())
            Err(_) -> "ERR"
        }
    }
    var vs: [NoteVerifier] = []
    for k in keys {
        match signednote.parse_verifier(k) {
            Ok(v) -> vs.push(v)
            Err(_) -> return "ERR"
        }
    }
    match signednote.open(a, vs) {
        Ok(n) -> "OK|" + hex(n.text.to_bytes()) + "|" + sig_names(n.sigs) + "|" + sig_names(n.unverified)
        Err(NoteUnverified(n)) -> "UNVERIFIED|" + hex(n.text.to_bytes()) + "|" + sig_names(n.unverified)
        Err(_) -> "ERR"
    }
}

fn int(s: str) -> i64 {
    s.parse_int() ?? 0
}

fn csv_hex(s: str) -> [bytes] {
    if s.len() == 0 { [] } else { s.split(",").map(|x| unhex(x)) }
}

fn answer_tlog(what: str, a: bytes, text: str) -> str {
    if what == "tlog" {
        let parts = text.split(";")
        // A log is never empty, so "" is one empty record.
        let stored = tlog.store(parts[0].split(",").map(|x| unhex(x)))
        var out: [str] = []
        for q in parts[1].split(" ") {
            let f = q.split(":")
            let x = int(f[1])
            let y = int(f[2])
            if f[0] == "th" {
                out.push(hex(tlog.tree_hash(stored, x)))
            } else if f[0] == "rp" {
                out.push(match tlog.prove_record(stored, x, y) {
                    Ok(p) -> p.map(|h| hex(h)).join(",")
                    Err(_) -> "ERR"
                })
            } else if f[0] == "tp" {
                out.push(match tlog.prove_tree(stored, x, y) {
                    Ok(p) -> p.map(|h| hex(h)).join(",")
                    Err(_) -> "ERR"
                })
            } else if f[0] == "sc" {
                out.push("{tlog.stored_count(x)}")
            } else {
                out.push("{tlog.stored_index(x, y)}")
            }
        }
        return out.join("|")
    }
    if what == "tlog.check" {
        let f = text.split("|")
        let ok = if f[0] == "record" {
            tlog.check_record(csv_hex(f[3]), int(f[1]), unhex(f[4]), int(f[2]), unhex(f[5]))
        } else {
            tlog.check_tree(csv_hex(f[3]), int(f[1]), unhex(f[4]), int(f[2]), unhex(f[5]))
        }
        return if ok { "true" } else { "false" }
    }
    if what == "tlog.tile" {
        var out: [str] = []
        for q in text.split(" ") {
            let f = q.split(":")
            if f[0] == "for" {
                out.push(tlog.tile_path(tlog.tile_for_index(int(f[1]), int(f[2]))))
            } else if f[0] == "new" {
                out.push(tlog.new_tiles(int(f[1]), int(f[2]), int(f[3])).map(|t| tlog.tile_path(t)).join(" "))
            } else {
                out.push(match tlog.parse_tile_path(f[1]) {
                    Ok(t) -> "{t.h}/{t.l}/{t.n}/{t.w}"
                    Err(_) -> "ERR"
                })
            }
        }
        return out.join("|")
    }
    match tlog.parse_tree(a.to_str()) {
        Ok(t) -> "{t.0}|" + hex(t.1) + "|" + hex(tlog.format_tree(t.0, t.1).to_bytes())
        Err(_) -> "ERR"
    }
}

fn answer(what: str, a: bytes, text: str) -> str {
    if what == "mod" {
        return match gomod.parse(a.to_str()) {
            Ok(f) -> hex((summary(f) + "\u{1f}" + hex(gomod.format(f).to_bytes())).to_bytes())
            Err(_) -> "ERR"
        }
    }
    if what.starts_with("note") {
        return answer_note(what, a, text)
    }
    if what.starts_with("tlog") or what == "tree" {
        return answer_tlog(what, a, text)
    }
    match coverprofile.parse(a.to_str()) {
        Ok(ps) -> hex(ps.map(|p| p.file + "|" + p.mode + "|" + p.blocks.map(|b|
            "{b.start_line}.{b.start_col},{b.end_line}.{b.end_col}:{b.statements}:{b.count}").join(";")).join("\n").to_bytes())
        Err(_) -> "ERR"
    }
}

fn main() / {io} {
    let argv = args()
    var i = 0
    while i + 2 < argv.len() {
        print(answer(argv[i], from_hex(argv[i + 1]), from_hex(argv[i + 2]).to_str()))
        i = i + 3
    }
}
