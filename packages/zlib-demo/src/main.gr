import zlib
import bytes_codec

fn unhex(s: str) -> bytes {
    match bytes_codec.decode_hex(s) {
        Some(b) -> b
        None -> panic("not hex")
    }
}

fn say(inout f: i64, name: str, held: bool) / {io} {
    if held {
        print("  ok    {name}")
    } else {
        print("  FAIL  {name}")
        f = f + 1
    }
}

/// A stream produced by a real zlib, and what it must decompress to.
fn check(inout f: i64, name: str, stream: str, want: str) / {io} {
    match zlib.decompress(unhex(stream), 10000000) {
        Ok(got) -> {
            if bytes_codec.encode_hex(got) == want {
                print("  ok    {name}")
            } else {
                print("  FAIL  {name}: {got.len()} bytes out, wanted {want.len() / 2}")
                f = f + 1
            }
        }
        Err(_e) -> {
            print("  FAIL  {name}: would not decompress")
            f = f + 1
        }
    }
}

fn refuses(stream: bytes) -> bool {
    match zlib.decompress(stream, 1000000) {
        Ok(_b) -> false
        Err(_e) -> true
    }
}

fn main() / {io} {
    var f = 0
    print("-- streams a real zlib produced, at every level and shape")
    check(f, "empty", "789c030000000001", "")
    check(f, "one byte", "789c73040000420042", "41")
    check(f, "hello world", "789ccb48cdc9c95728cf2fca4901001a0b045d", "68656c6c6f20776f726c64")
    check(f, "stored (level 0)", "7801013900c6ff74686520717569636b2062726f776e20666f7874686520717569636b2062726f776e20666f7874686520717569636b2062726f776e20666f787123159a", "74686520717569636b2062726f776e20666f7874686520717569636b2062726f776e20666f7874686520717569636b2062726f776e20666f78")
    check(f, "fixed huffman (short)", "78da4b4c84010014e103cb", "61616161616161616161")
    check(f, "dynamic huffman", "78da2bc94855282ccd4cce56482aca2fcf5348cbaf50c82acd2d2856c82f4b2d5228014ae72456552aa4e4a7eb8179a38a47158f2a1e553caa7854f130520c008d988b37", "")
    check(f, "long run", "78daedc13101000000c2a0da8b6f0a3fa00000000080b70114162848", "")
    check(f, "binary", "", "")
    check(f, "git-like blob", "789c4bcac94f52303462c848cdc9c95728cf2fca49e1020044110689", "626c6f622031320068656c6c6f20776f726c640a")
    check(f, "incompressible", "", "")
    print("-- Adler-32, against the published values")
    say(f, "the empty string is 1", zlib.adler32(bytes_of([])) == 1)
    say(f, "\"Wikipedia\" is 0x11E60398",
        zlib.adler32("Wikipedia".to_bytes()) == 300286872)
    say(f, "\"abc\" is 0x024d0127", zlib.adler32("abc".to_bytes()) == 38600999)

    print("-- writing a stream a real zlib can read")
    // Stored blocks are legal DEFLATE, so this round-trips through our own
    // reader and, more importantly, through anyone else's.
    var round_trips = true
    for n in [0, 1, 100, 65535, 65536, 200000] {
        var buf: [i64] = []
        for i in 0..n {
            buf.push((i * 31 + 7).bit_and(255))
        }
        let original = bytes_of(buf)
        match zlib.decompress(zlib.compress_stored(original), 1000000) {
            Ok(back) -> {
                if bytes_codec.encode_hex(back) != bytes_codec.encode_hex(original) {
                    round_trips = false
                    print("        {n} bytes came back wrong")
                }
            }
            Err(_e) -> {
                round_trips = false
                print("        {n} bytes would not round-trip")
            }
        }
    }
    say(f, "0, 1, 100, 65535, 65536 and 200000 bytes round-trip", round_trips)

    print("-- and what a decoder must refuse, because every byte came off a disk")
    say(f, "an empty input", refuses(bytes_of([])))
    say(f, "a header that is not deflate", refuses(unhex("7a9c030000000001")))
    say(f, "a header whose check fails", refuses(unhex("789d030000000001")))
    say(f, "a stream cut in half",
        refuses(unhex("789ccb48cdc9c95728cf2f")))
    say(f, "a block type of 3, which does not exist",
        refuses(unhex("789c07000000000001")))
    // A stored block whose length and complement disagree.
    say(f, "a stored length that fails its own complement",
        refuses(unhex("789c01050000000048656c6c6f00000001")))
    // A back-reference pointing before the start of the output.
    say(f, "a distance reaching before the output begins",
        refuses(unhex("789ccb48cdc9c95728cf2fca490100ff0b045d")))
    // The checksum must actually be checked.
    say(f, "a stream whose Adler-32 is wrong",
        refuses(unhex("789ccb48cdc9c95728cf2fca4901001a0b045e")))

    print("-- and a bomb, which is the reason the limit exists")
    // A few bytes of input that expand to megabytes. With a limit, this is a
    // refusal; without one it is however much memory the attacker chose.
    var bomb: [i64] = []
    for i in 0..2000 {
        bomb.push(120)
    }
    let compressed_bomb = zlib.compress_stored(bytes_of(bomb))
    match zlib.decompress(compressed_bomb, 100) {
        Ok(_b) -> say(f, "output past the limit is refused", false)
        Err(_e) -> say(f, "output past the limit is refused", true)
    }
    match zlib.decompress(compressed_bomb, 10000) {
        Ok(b) -> say(f, "and the same stream is fine under a larger limit",
            b.len() == 2000)
        Err(_e) -> say(f, "and the same stream is fine under a larger limit", false)
    }

    if f == 0 {
        print("all checks passed")
    } else {
        print("{f} check(s) failed")
    }
}
