// Java's `java.math.BigInteger`, as Java 17 parses, prints and computes:
// the string and byte-array constructors, `toString(radix)`,
// `toByteArray`, the two's-complement bit operations, shifts, division,
// `mod`, `modPow`, `modInverse`, `gcd`, `pow`, `sqrt`, and the
// conversions to `long` and `int`.
//
// Java keys, hashes and identifiers pass through BigInteger, and a peer
// must print and parse them identically, and fail where Java fails:
//
//   - Parsing takes one leading sign, skips leading zeros, and accepts any
//     Unicode decimal digit in the Basic Multilingual Plane and the
//     full-width Latin letters, as `Character.digit` does; a bad character
//     is reported as `Integer.parseInt` reports the digit group it fell in
//     (`For input string: "12x4"`, with ` under radix 16` when the radix
//     is not ten). Java works in UTF-16 units, so a character beyond the
//     BMP is two bad digits and counts twice when the groups are cut; a
//     group that ends between the two halves shows the lone half as `?`,
//     as Java writes it when it encodes the message.
//   - Negative numbers behave as infinitely sign-extended two's
//     complement: `and`, `or`, `xor`, `not`, `andNot`, `testBit`,
//     `bitLength` and `bitCount` all see it; `shiftRight` floors.
//   - `divide` and `remainder` truncate; `mod` is never negative and wants
//     a positive modulus; `toByteArray` is the shortest two's-complement
//     big-endian form.
//   - The exceptions carry Java's text: "BigInteger divide by zero",
//     "BigInteger: modulus not positive", "BigInteger not invertible.",
//     "Negative exponent", "Negative bit address", "BigInteger out of long
//     range".
//
// Digits are Unicode 15.1's; Java 17 knows Unicode 13 and so refuses the
// few digit sets added since.

import bigint
import pycharclass

/// NumberFormatException or ArithmeticException, with Java's message.
type JavaBigError =
    | JbNumberFormat(msg: str)
    | JbArithmetic(msg: str)

pub fn error_text(e: JavaBigError) -> str {
    return match e {
        JbNumberFormat(m) -> m
        JbArithmetic(m) -> m
    }
}

fn big(n: i64) -> BigInt {
    return bigint.from_i64(n)
}

fn zero() -> BigInt {
    return bigint.zero()
}

fn is_zero(n: BigInt) -> bool {
    return bigint.is_zero(n)
}

fn sign(n: BigInt) -> i64 {
    return bigint.sign(n)
}

fn neg(n: BigInt) -> BigInt {
    return bigint.negate(n)
}

fn babs(n: BigInt) -> BigInt {
    return if sign(n) < 0 { neg(n) } else { n }
}

fn pow2(k: i64) -> BigInt {
    return bigint.pow(big(2), k)
}

/// Floored division and modulus.
fn fdivmod(a: BigInt, b: BigInt) -> (BigInt, BigInt) {
    let (q, r) = bigint.divmod(a, b) ?? (zero(), zero())
    if not is_zero(r) and sign(r) != sign(b) {
        return (bigint.sub(q, big(1)), bigint.add(r, b))
    }
    return (q, r)
}

// ---- parsing and printing

/// `Character.digit(c, radix)`.
fn char_digit(c: i64, radix: i64) -> i64 {
    var v = 0 - 1
    if c >= 48 and c <= 57 {
        v = c - 48
    } else if c >= 97 and c <= 122 {
        v = c - 87
    } else if c >= 65 and c <= 90 {
        v = c - 55
    } else if c >= 65313 and c <= 65338 {
        v = c - 65303
    } else if c >= 65345 and c <= 65370 {
        v = c - 65335
    } else if c > 127 and (c < 55296 or c > 57343) {
        v = pycharclass.decimal_value(c)
    }
    return if v >= 0 and v < radix { v } else { 0 - 1 }
}

fn digits_per_int(radix: i64) -> i64 {
    return [0, 0, 30, 19, 15, 13, 11, 11, 10, 9, 9, 8, 8, 8, 8, 7, 7, 7, 7, 7, 7, 7, 6, 6, 6, 6, 6, 6, 6, 6, 6, 6, 6, 6, 6, 6, 5][radix]
}

/// The text as UTF-16 units.
fn utf16(val: str) -> [i64] {
    var out: [i64] = []
    for c in val.codes() {
        if c >= 65536 {
            out.push(55296 + (c - 65536).shr(10))
            out.push(56320 + (c - 65536).bit_and(1023))
        } else {
            out.push(c)
        }
    }
    return out
}

fn is_high(u: i64) -> bool {
    return u >= 55296 and u <= 56319
}

/// UTF-16 units back to text; an unpaired half is `?`.
fn from_utf16(units: [i64]) -> str {
    var out = ""
    var i = 0
    while i < units.len() {
        let u = units[i]
        if is_high(u) and i + 1 < units.len() and units[i + 1] >= 56320 and units[i + 1] <= 57343 {
            out = out + (65536 + (u - 55296).shl(10) + units[i + 1] - 56320).to_char()
            i = i + 2
        } else {
            out = out + if u >= 55296 and u <= 57343 { "?" } else { u.to_char() }
            i = i + 1
        }
    }
    return out
}

/// `new BigInteger(val, radix)`.
pub fn parse(val: str, radix: i64) -> BigInt ! JavaBigError {
    if radix < 2 or radix > 36 {
        fail(JbNumberFormat("Radix out of range"))
    }
    let cs = utf16(val)
    let len = cs.len()
    if len == 0 {
        fail(JbNumberFormat("Zero length BigInteger"))
    }
    var minus = 0 - 1
    var plus = 0 - 1
    for i in 0..len {
        if cs[i] == 45 {
            minus = i
        }
        if cs[i] == 43 {
            plus = i
        }
    }
    var cursor = 0
    var negative = false
    if minus >= 0 {
        if minus != 0 or plus >= 0 {
            fail(JbNumberFormat("Illegal embedded sign character"))
        }
        negative = true
        cursor = 1
    } else if plus >= 0 {
        if plus != 0 {
            fail(JbNumberFormat("Illegal embedded sign character"))
        }
        cursor = 1
    }
    if cursor == len {
        fail(JbNumberFormat("Zero length BigInteger"))
    }
    while cursor < len and char_digit(cs[cursor], radix) == 0 {
        cursor = cursor + 1
    }
    if cursor == len {
        return zero()
    }
    // Digit groups as Java cuts them, each parsed by Integer.parseInt.
    let n = len - cursor
    let per = digits_per_int(radix)
    var first = n % per
    if first == 0 {
        first = per
    }
    var value = zero()
    var at = cursor
    var group = first
    while at < len {
        let piece = cs.slice(at, at + group)
        var g = 0
        for c in piece {
            let d = char_digit(c, radix)
            if d < 0 {
                let text = from_utf16(piece)
                fail(JbNumberFormat("For input string: \"" + text + "\"" + if radix == 10 { "" } else { " under radix " + radix.to_str() }))
            }
            g = g * radix + d
        }
        value = bigint.add(bigint.mul(value, bigint.pow(big(radix), group)), big(g))
        at = at + group
        group = per
    }
    return if negative { neg(value) } else { value }
}

/// `n.toString(radix)`; a radix outside 2..36 is ten.
pub fn to_string(n: BigInt, radix0: i64) -> str {
    let radix = if radix0 < 2 or radix0 > 36 { 10 } else { radix0 }
    if is_zero(n) {
        return "0"
    }
    let digits = "0123456789abcdefghijklmnopqrstuvwxyz"
    var left = babs(n)
    var out = ""
    while not is_zero(left) {
        let (q, r) = bigint.divmod(left, big(radix)) ?? (zero(), zero())
        out = digits.substr(bigint.to_i64(r) ?? 0, 1) + out
        left = q
    }
    return if sign(n) < 0 { "-" + out } else { out }
}

// ---- two's complement

/// `n.bitLength()`: bits of the two's complement form, sign bit excluded.
pub fn bit_length(n: BigInt) -> i64 {
    return if sign(n) < 0 { bigint.bit_length(bigint.sub(neg(n), big(1))) } else { bigint.bit_length(n) }
}

/// The value as `width` bytes of two's complement, big-endian.
fn twos(n: BigInt, width: i64) -> [i64] {
    let v = if sign(n) < 0 { bigint.add(pow2(8 * width), n) } else { n }
    return (bigint.to_bytes(v, width) ?? bytes_of([])).to_list()
}

fn from_twos(b: [i64]) -> BigInt {
    let v = bigint.from_bytes(bytes_of(b))
    if b.len() > 0 and b[0] >= 128 {
        return bigint.sub(v, pow2(8 * b.len()))
    }
    return v
}

/// `n.toByteArray()`.
pub fn to_byte_array(n: BigInt) -> bytes {
    return bytes_of(twos(n, bit_length(n) / 8 + 1))
}

/// `new BigInteger(bytes)`.
pub fn from_byte_array(b: bytes) -> BigInt ! JavaBigError {
    if b.len() == 0 {
        fail(JbNumberFormat("Zero length BigInteger"))
    }
    return from_twos(b.to_list())
}

fn bitwise(a: BigInt, b: BigInt, op: i64) -> BigInt {
    let width = (if bit_length(a) > bit_length(b) { bit_length(a) } else { bit_length(b) }) / 8 + 1
    let x = twos(a, width)
    let y = twos(b, width)
    var out: [i64] = []
    for i in 0..width {
        out.push(if op == 0 { x[i].bit_and(y[i]) } else if op == 1 { x[i].bit_or(y[i]) } else if op == 2 { x[i].bit_xor(y[i]) } else {
            x[i].bit_and(255 - y[i])
        })
    }
    return from_twos(out)
}

/// `a.and(b)`.
pub fn and_bits(a: BigInt, b: BigInt) -> BigInt {
    return bitwise(a, b, 0)
}

/// `a.or(b)`.
pub fn or_bits(a: BigInt, b: BigInt) -> BigInt {
    return bitwise(a, b, 1)
}

/// `a.xor(b)`.
pub fn xor_bits(a: BigInt, b: BigInt) -> BigInt {
    return bitwise(a, b, 2)
}

/// `a.andNot(b)`: `a & ~b`.
pub fn and_not(a: BigInt, b: BigInt) -> BigInt {
    return bitwise(a, b, 3)
}

/// `n.not()`: `-n - 1`.
pub fn not_bits(n: BigInt) -> BigInt {
    return bigint.sub(neg(n), big(1))
}

/// `n.shiftLeft(k)`; a negative `k` shifts right.
pub fn shift_left(n: BigInt, k: i64) -> BigInt {
    if k >= 0 {
        return bigint.mul(n, pow2(k))
    }
    let (q, _r) = fdivmod(n, pow2(0 - k))
    return q
}

/// `n.shiftRight(k)`, flooring.
pub fn shift_right(n: BigInt, k: i64) -> BigInt {
    return shift_left(n, 0 - k)
}

fn bit_address(k: i64) -> () ! JavaBigError {
    if k < 0 {
        fail(JbArithmetic("Negative bit address"))
    }
    return ()
}

/// `n.testBit(k)`.
pub fn test_bit(n: BigInt, k: i64) -> bool ! JavaBigError {
    try bit_address(k)
    let (_q, r) = fdivmod(shift_right(n, k), big(2))
    return not is_zero(r)
}

pub fn set_bit(n: BigInt, k: i64) -> BigInt ! JavaBigError {
    try bit_address(k)
    return or_bits(n, pow2(k))
}

pub fn clear_bit(n: BigInt, k: i64) -> BigInt ! JavaBigError {
    try bit_address(k)
    return and_not(n, pow2(k))
}

pub fn flip_bit(n: BigInt, k: i64) -> BigInt ! JavaBigError {
    try bit_address(k)
    return xor_bits(n, pow2(k))
}

fn popcount(n: BigInt) -> i64 {
    var count = 0
    for b in (bigint.to_bytes(n, 0) ?? bytes_of([])).to_list() {
        var v = b
        while v > 0 {
            count = count + v.bit_and(1)
            v = v.shr(1)
        }
    }
    return count
}

/// `n.bitCount()`: the bits that differ from the sign bit.
pub fn bit_count(n: BigInt) -> i64 {
    return if sign(n) < 0 { popcount(not_bits(n)) } else { popcount(n) }
}

/// `n.getLowestSetBit()`, -1 for zero.
pub fn lowest_set_bit(n: BigInt) -> i64 {
    if is_zero(n) {
        return 0 - 1
    }
    var k = 0
    var v = babs(n)
    while true {
        let (q, r) = fdivmod(v, big(2))
        if not is_zero(r) {
            return k
        }
        v = q
        k = k + 1
    }
    return k
}

// ---- arithmetic

/// `a.divide(b)`, truncating.
pub fn divide(a: BigInt, b: BigInt) -> BigInt ! JavaBigError {
    if is_zero(b) {
        fail(JbArithmetic("BigInteger divide by zero"))
    }
    let (q, _r) = bigint.divmod(a, b) ?? (zero(), zero())
    return q
}

/// `a.remainder(b)`, with the sign of `a`.
pub fn remainder(a: BigInt, b: BigInt) -> BigInt ! JavaBigError {
    if is_zero(b) {
        fail(JbArithmetic("BigInteger divide by zero"))
    }
    let (_q, r) = bigint.divmod(a, b) ?? (zero(), zero())
    return r
}

/// `a.mod(m)`.
pub fn modulo(a: BigInt, m: BigInt) -> BigInt ! JavaBigError {
    if sign(m) <= 0 {
        fail(JbArithmetic("BigInteger: modulus not positive"))
    }
    let (_q, r) = fdivmod(a, m)
    return r
}

/// `a.gcd(b)`.
pub fn gcd(a: BigInt, b: BigInt) -> BigInt {
    var x = babs(a)
    var y = babs(b)
    while not is_zero(y) {
        let (_q, r) = bigint.divmod(x, y) ?? (zero(), zero())
        x = y
        y = r
    }
    return x
}

/// `a.modInverse(m)`.
pub fn mod_inverse(a: BigInt, m: BigInt) -> BigInt ! JavaBigError {
    if sign(m) <= 0 {
        fail(JbArithmetic("BigInteger: modulus not positive"))
    }
    if bigint.compare(m, big(1)) == 0 {
        return zero()
    }
    let v = try modulo(a, m)
    // Extended Euclid on (v, m).
    var r0 = m
    var r1 = v
    var t0 = zero()
    var t1 = big(1)
    while not is_zero(r1) {
        let (q, r) = bigint.divmod(r0, r1) ?? (zero(), zero())
        r0 = r1
        r1 = r
        let t = bigint.sub(t0, bigint.mul(q, t1))
        t0 = t1
        t1 = t
    }
    if bigint.compare(r0, big(1)) != 0 {
        fail(JbArithmetic("BigInteger not invertible."))
    }
    return try modulo(t0, m)
}

/// `a.modPow(e, m)`.
pub fn mod_pow(a: BigInt, e: BigInt, m: BigInt) -> BigInt ! JavaBigError {
    if sign(m) <= 0 {
        fail(JbArithmetic("BigInteger: modulus not positive"))
    }
    let one_mod = bigint.compare(m, big(1)) == 0
    if is_zero(e) or bigint.compare(a, big(1)) == 0 {
        return if one_mod { zero() } else { big(1) }
    }
    if is_zero(a) and sign(e) >= 0 {
        return zero()
    }
    var base = try modulo(a, m)
    var exp = babs(e)
    var result = try modulo(big(1), m)
    while not is_zero(exp) {
        let (q, r) = fdivmod(exp, big(2))
        if not is_zero(r) {
            result = try modulo(bigint.mul(result, base), m)
        }
        base = try modulo(bigint.mul(base, base), m)
        exp = q
    }
    return if sign(e) < 0 { try mod_inverse(result, m) } else { result }
}

/// `a.pow(k)`.
pub fn pow(a: BigInt, k: i64) -> BigInt ! JavaBigError {
    if k < 0 {
        fail(JbArithmetic("Negative exponent"))
    }
    return bigint.pow(a, k)
}

/// `a.sqrt()`: the floor of the square root.
pub fn sqrt(a: BigInt) -> BigInt ! JavaBigError {
    if sign(a) < 0 {
        fail(JbArithmetic("Negative BigInteger"))
    }
    if is_zero(a) {
        return zero()
    }
    var x = pow2(bigint.bit_length(a) / 2 + 1)
    while true {
        let (q, _r) = fdivmod(a, x)
        let (y, _r2) = fdivmod(bigint.add(x, q), big(2))
        if bigint.compare(y, x) >= 0 {
            return x
        }
        x = y
    }
    return x
}

/// `a.longValue()`: the low 64 bits, as two's complement.
pub fn long_value(a: BigInt) -> i64 {
    let b = twos(a, bit_length(a) / 8 + 9)
    var v = 0
    for x in b.slice(b.len() - 8, b.len()) {
        v = v.shl(8).bit_or(x)
    }
    return v
}

/// `a.intValue()`: the low 32 bits, as two's complement.
pub fn int_value(a: BigInt) -> i64 {
    let v = long_value(a).bit_and(4294967295)
    return if v >= 2147483648 { v - 4294967296 } else { v }
}

/// `a.longValueExact()`.
pub fn long_value_exact(a: BigInt) -> i64 ! JavaBigError {
    if bit_length(a) > 63 {
        fail(JbArithmetic("BigInteger out of long range"))
    }
    return long_value(a)
}
