// How much guessing does this secret actually cost.
//
// "Entropy" gets quoted about passwords as though it were a property of the
// string. It is not: it is a property of the process that produced it. A
// password generated by picking 12 characters uniformly from 94 has 78.7
// bits whatever the characters turn out to be, including `aaaaaaaaaaaa`. A
// password a person chose has whatever entropy their choosing had, which is
// far less and is not computable from the string either.
//
// This package holds the three things that *can* be computed, and is clear
// about which question each answers.
//
// ## The character-set estimate, and why it is wrong
//
// `length * log2(alphabet)` is the number every password meter shows. It is
// the entropy of a *uniform random* password of that length and alphabet.
// Applied to a password a person typed, it is an upper bound that is
// routinely fifty bits too high: `Password1!` scores 65 bits by this
// formula and is guessed in under a second. It is here because it is the
// right answer for a generated secret, and labelled so it is not used for
// the other thing.
//
// ## Shannon entropy of the string itself
//
// The entropy of the character distribution, times the length. This
// measures repetition and nothing else: it cannot tell `qwertyuiop` from
// `x7#kP2vLm9` because both use ten distinct characters once each. It is
// the right tool for deciding whether a *found* string looks like a random
// key — which is what a secret scanner needs, and is why this is here.
//
// ## Guess numbers
//
// The only honest answer for a human-chosen password is "how many guesses
// would a good attacker need", estimated by looking for the patterns
// attackers actually try: dictionary words, dates, keyboard runs,
// repetition, and the leetspeak and capitalisation people layer on top.
// That is what `guesses_of` does, and it agrees with zxcvbn's ordering.

type EntropyError =
    | Empty()
    | BadAlphabet(size: i64)

    /// Which kinds of character a string uses.
type Alphabet = {
    lower: bool,
    upper: bool,
    digits: bool,
    symbols: bool,
    /// Anything above 127, which a brute force has to widen for.
    other: bool,
}

/// A pattern found inside a candidate secret.
type Pattern = {
    /// `dictionary`, `repeat`, `sequence`, `keyboard`, `date` or `brute`.
    kind: str,
    start: i64,
    end: i64,
    /// How many guesses this piece alone is worth.
    guesses: f64,
    matched: str,
}

/// Which character classes a string draws on.
pub fn alphabet_of(text: str) -> Alphabet {
    var out = Alphabet{ lower: false, upper: false, digits: false,
        symbols: false, other: false }
    for code in text.codes() {
        if code >= 97 and code <= 122 {
            out.lower = true
        } else if code >= 65 and code <= 90 {
            out.upper = true
        } else if code >= 48 and code <= 57 {
            out.digits = true
        } else if code >= 32 and code < 127 {
            out.symbols = true
        } else {
            out.other = true
        }
    }
    return out
}

/// How many characters a brute force would have to try per position.
///
/// The conventional sizes: 26 letters of each case, 10 digits, 33 printable
/// symbols. The number is a convention rather than a measurement, and every
/// password meter uses roughly these.
pub fn alphabet_size(alphabet: Alphabet) -> i64 {
    var size = 0
    if alphabet.lower {
        size = size + 26
    }
    if alphabet.upper {
        size = size + 26
    }
    if alphabet.digits {
        size = size + 10
    }
    if alphabet.symbols {
        size = size + 33
    }
    if alphabet.other {
        size = size + 100
    }
    return size
}

/// `length * log2(alphabet)`: the entropy of a *generated* secret.
///
/// Correct for something a random number generator produced and an
/// overestimate for anything a person chose. Use `guesses_of` for the
/// second case; this one is for saying how strong a token you just minted
/// is.
pub fn generated_bits(length: i64, alphabet: i64) -> f64 ! EntropyError {
    if alphabet < 2 {
        fail(BadAlphabet(alphabet))
    }
    return length.as_f64() * (alphabet.as_f64().ln() / 0.6931471805599453)
}

/// The same, read off a string that is assumed to have been generated.
pub fn assumed_bits(text: str) -> f64 ! EntropyError {
    if text.len() == 0 {
        fail(Empty())
    }
    return try generated_bits(text.len(),
        alphabet_size(alphabet_of(text)))
}

/// The Shannon entropy of the character distribution, in bits per
/// character.
///
/// Measures repetition, not unpredictability. `abababab` scores 1.0 and
/// `xk7#Qm2v` scores 3.0, which is the right ordering for "does this look
/// like a key" and the wrong one for "is this a good password".
pub fn shannon_bits(text: str) -> f64 ! EntropyError {
    if text.len() == 0 {
        fail(Empty())
    }
    var seen: [i64] = []
    var counts: [i64] = []
    for code in text.codes() {
        var found = 0 - 1
        var i = 0
        while i < seen.len() {
            if seen[i] == code {
                found = i
            }
            i = i + 1
        }
        if found < 0 {
            seen.push(code)
            counts.push(1)
        } else {
            counts[found] = counts[found] + 1
        }
    }
    let total = text.len().as_f64()
    var bits = 0.0
    for count in counts {
        let share = count.as_f64() / total
        bits = bits - share * (share.ln() / 0.6931471805599453)
    }
    return bits
}

/// The Shannon entropy of the whole string, in bits.
pub fn shannon_total(text: str) -> f64 ! EntropyError {
    return (try shannon_bits(text)) * text.len().as_f64()
}

/// The min-entropy: the bits in the *most likely* character alone.
///
/// Always at or below the Shannon entropy, and the one a security proof
/// wants, because an attacker starts with the most likely guess rather than
/// an average one.
pub fn min_entropy_bits(text: str) -> f64 ! EntropyError {
    if text.len() == 0 {
        fail(Empty())
    }
    var seen: [i64] = []
    var counts: [i64] = []
    for code in text.codes() {
        var found = 0 - 1
        var i = 0
        while i < seen.len() {
            if seen[i] == code {
                found = i
            }
            i = i + 1
        }
        if found < 0 {
            seen.push(code)
            counts.push(1)
        } else {
            counts[found] = counts[found] + 1
        }
    }
    var most = 0
    for count in counts {
        if count > most {
            most = count
        }
    }
    let share = most.as_f64() / text.len().as_f64()
    return 0.0 - (share.ln() / 0.6931471805599453)
}

// ------------------------------------------- what an attacker would try

/// QWERTY adjacency, taken from zxcvbn's own graph.
///
/// Each entry is a key followed by every key touching it, shifted twins
/// folded onto their unshifted form. A run along a row is the obvious case;
/// the ones this catches that a row-only check does not are the columns and
/// the diagonals — `1qaz`, `zaq1`, `2wsx` — which are exactly what people
/// reach for when told to use a mixture of characters.
fn adjacency() -> [str] {
    return [
        "'/;[]",
        ",./;klm",
        "-0=[p",
        ".,/;klm",
        "/',.;",
        "0-9op",
        "12`q",
        "213qw",
        "324ew",
        "435er",
        "546rt",
        "657ty",
        "768uy",
        "879iu",
        "908io",
        ";',./[lp",
        "=-[]",
        "['-;=]p",
        "\\]",
        "]'=[\\",
        "`1",
        "aqswz",
        "bghnv",
        "cdfvx",
        "dcefrsx",
        "e34drsw",
        "fcdgrtv",
        "gbfhtvy",
        "hbgjnuy",
        "i89jkou",
        "jhikmnu",
        "k,.ijlmo",
        "l,.;kop",
        "m,.jkn",
        "nbhjm",
        "o09iklp",
        "p-0;[lo",
        "q12aw",
        "r45deft",
        "sadewxz",
        "t56fgry",
        "u78hijy",
        "vbcfg",
        "w23aeqs",
        "xcdsz",
        "y67ghtu",
        "zasx",
    ]
}

/// Whether two keys touch on a QWERTY keyboard.
pub fn are_adjacent(a: i64, b: i64) -> bool {
    let left = a.to_char().to_lower()
    let right = b.to_char().to_lower()
    for entry in adjacency() {
        if entry.substr(0, 1) == left {
            return entry.substr(1, entry.len() - 1).contains(right)
        }
    }
    return false
}

/// The substitutions people make and think nobody has heard of.
fn unleet(text: str) -> str {
    return text.replace("4", "a").replace("@", "a").replace("3", "e")
        .replace("1", "l").replace("!", "i").replace("0", "o")
        .replace("$", "s").replace("5", "s").replace("7", "t")
        .replace("+", "t")
}

/// Whether a run walks from key to touching key across the keyboard.
///
/// Direction does not matter and neither does the shift key: `qwerty`,
/// `ytrewq`, `1qaz` and `!QAZ` are all walks, and all four are in every
/// attacker's first million guesses.
pub fn is_keyboard_run(text: str) -> bool {
    if text.len() < 3 {
        return false
    }
    let codes = text.codes()
    var i = 1
    while i < codes.len() {
        if not are_adjacent(codes[i - 1], codes[i]) {
            return false
        }
        i = i + 1
    }
    return true
}

/// Whether a run steps by one through the alphabet or the digits.
pub fn is_sequence(text: str) -> bool {
    if text.len() < 3 {
        return false
    }
    let codes = text.to_lower().codes()
    var up = true
    var down = true
    var i = 1
    while i < codes.len() {
        if codes[i] != codes[i - 1] + 1 {
            up = false
        }
        if codes[i] != codes[i - 1] - 1 {
            down = false
        }
        i = i + 1
    }
    return up or down
}

/// Whether a run is one character, or one short group, repeated.
pub fn is_repeat(text: str) -> bool {
    if text.len() < 3 {
        return false
    }
    var unit = 1
    while unit <= text.len() / 2 {
        if text.len() % unit == 0 {
            let head = text.substr(0, unit)
            var same = true
            var at = unit
            while at < text.len() {
                if text.substr(at, unit) != head {
                    same = false
                }
                at = at + unit
            }
            if same {
                return true
            }
        }
        unit = unit + 1
    }
    return false
}

/// Whether a run of four to eight digits reads as a date.
pub fn is_date(text: str) -> bool {
    if text.len() < 4 or text.len() > 8 {
        return false
    }
    for code in text.codes() {
        if code < 48 or code > 57 {
            return false
        }
    }
    if text.len() == 4 {
        let year = text.parse_int() ?? 0
        return year >= 1900 and year <= 2100
    }
    return true
}

/// How many guesses a piece of the secret is worth on its own.
///
/// The numbers are zxcvbn's: a word in a common list costs its rank, a
/// capitalisation or a substitution multiplies rather than adds, and a piece
/// nothing matches costs the brute force of its own alphabet.
fn piece_guesses(kind: str, matched: str, rank: i64) -> f64 {
    if kind == "dictionary" {
        var guesses = rank.as_f64()
        // Capitalising the first letter roughly doubles the work; other
        // patterns of capitals cost more, and neither is worth much.
        if matched != matched.to_lower() {
            guesses = guesses * 2.0
        }
        if unleet(matched.to_lower()) != matched.to_lower() {
            guesses = guesses * 2.0
        }
        return guesses
    }
    if kind == "repeat" {
        return matched.len().as_f64() * 8.0
    }
    if kind == "sequence" {
        return matched.len().as_f64() * 10.0
    }
    if kind == "keyboard" {
        return matched.len().as_f64() * 25.0
    }
    if kind == "date" {
        return 36500.0
    }
    let alphabet = alphabet_size(alphabet_of(matched))
    var guesses = 1.0
    var i = 0
    while i < matched.len() {
        guesses = guesses * alphabet.as_f64()
        i = i + 1
    }
    return guesses
}

/// Every pattern found in a candidate, at every position.
///
/// `words` is the list an attacker is assumed to have, most common first;
/// its position in the list is the rank, which is what a dictionary match
/// costs.
pub fn patterns_of(text: str, words: [str]) -> [Pattern] {
    var out: [Pattern] = []
    var start = 0
    while start < text.len() {
        var end = start + 1
        while end <= text.len() {
            let piece = text.substr(start, end - start)
            let rank = rank_of(piece, words)
            if rank > 0 {
                out.push(Pattern{ kind: "dictionary", start: start,
                    end: end, guesses: piece_guesses("dictionary", piece,
                        rank), matched: piece })
            }
            if is_repeat(piece) {
                out.push(Pattern{ kind: "repeat", start: start, end: end,
                    guesses: piece_guesses("repeat", piece, 0),
                    matched: piece })
            }
            if is_sequence(piece) {
                out.push(Pattern{ kind: "sequence", start: start, end: end,
                    guesses: piece_guesses("sequence", piece, 0),
                    matched: piece })
            }
            if is_keyboard_run(piece) {
                out.push(Pattern{ kind: "keyboard", start: start, end: end,
                    guesses: piece_guesses("keyboard", piece, 0),
                    matched: piece })
            }
            if is_date(piece) {
                out.push(Pattern{ kind: "date", start: start, end: end,
                    guesses: piece_guesses("date", piece, 0),
                    matched: piece })
            }
            end = end + 1
        }
        start = start + 1
    }
    return out
}

/// Where a piece sits in the word list, counting from one, or zero when it
/// is not in it.
///
/// The leetspeak is undone first, and the case ignored, because an attacker
/// trying `password` tries `P4ssw0rd` in the same breath.
pub fn rank_of(piece: str, words: [str]) -> i64 {
    let plain = unleet(piece.to_lower())
    var i = 0
    while i < words.len() {
        if words[i] == plain {
            return i + 1
        }
        i = i + 1
    }
    return 0
}

/// The cheapest way to cover the whole string with patterns, and what it
/// costs.
///
/// The dynamic program zxcvbn calls the "search": the best cover of the
/// first `i` characters is the best cover of some earlier prefix times the
/// cost of one pattern that reaches `i`. The factorial term zxcvbn adds for
/// the number of pieces is left out here, so the numbers are smaller than
/// its and the ordering is the same.
pub fn guesses_of(text: str, words: [str]) -> f64 ! EntropyError {
    if text.len() == 0 {
        fail(Empty())
    }
    let found = patterns_of(text, words)
    var best: [f64] = [1.0]
    var i = 1
    while i <= text.len() {
        var cheapest = 0.0
        var j = 0
        while j < i {
            var cost = piece_guesses("brute", text.substr(j, i - j), 0)
            for pattern in found {
                if pattern.start == j and pattern.end == i and
                pattern.guesses < cost {
                    cost = pattern.guesses
                }
            }
            let total = best[j] * cost
            if j == 0 or total < cheapest {
                cheapest = total
            }
            j = j + 1
        }
        best.push(cheapest)
        i = i + 1
    }
    return best[text.len()]
}

/// The guess count as bits, which is what people mean by "entropy".
pub fn guess_bits(text: str, words: [str]) -> f64 ! EntropyError {
    return (try guesses_of(text, words)).ln() / 0.6931471805599453
}

/// zxcvbn's score from zero to four, at its own thresholds.
///
/// The thresholds are guess counts, not bits: below a thousand is trivial,
/// a million is an online attack, a hundred million is an offline one with
/// a slow hash, and ten billion is an offline one with a fast hash.
pub fn score_of(guesses: f64) -> i64 {
    if guesses < 1000.0 {
        return 0
    }
    if guesses < 1000000.0 {
        return 1
    }
    if guesses < 100000000.0 {
        return 2
    }
    if guesses < 10000000000.0 {
        return 3
    }
    return 4
}

/// How long a guessing attack takes, in seconds, at a given rate.
pub fn seconds_to_guess(guesses: f64, per_second: f64) -> f64 {
    if per_second <= 0.0 {
        return 0.0
    }
    // Half the space on average, which is the number worth quoting.
    return guesses / 2.0 / per_second
}
