// `.mailmap`: the file that says two commits were by the same person.
//
// Over a long project people change employer, change laptop, commit once
// from a machine whose `user.email` was never set, and appear in `git
// shortlog` three times. A `.mailmap` fixes that after the fact without
// rewriting history, which is the only way to fix it that does not break
// every existing hash.
//
// Any tool that counts contributions, attributes a change, or builds a
// contributor list has to apply it, and a tool that does not produces
// numbers that are wrong in a way its readers will notice and its author
// will not.
//
// Four line forms, and which parts are compared is the whole of the
// difficulty:
//
//   `Proper Name <proper@email>`
//       Rewrites the *name* of anyone committing as `proper@email`.
//
//   `<proper@email> <commit@email>`
//       Rewrites the *email* of anyone committing as `commit@email`,
//       whatever name they used.
//
//   `Proper Name <proper@email> <commit@email>`
//       Both, matched on the email alone.
//
//   `Proper Name <proper@email> Commit Name <commit@email>`
//       Both, matched on the name *and* the email together — which is how
//       two people who once shared a machine account are told apart.
//
// Emails and names are both compared without regard to ASCII case. An
// entry that names a commit name as well as an email is tried before the
// plain entries for that email, or the person who shared the account would
// be rewritten to whoever comes first in the file.
//
// Entries for one email accumulate the way git's `add_mapping` accumulates
// them: `Jane <jane@x>` and then `<new@x> <jane@x>` together give both the
// name and the address, a later name replaces an earlier one, and an entry
// that only fixes a name leaves the commit's own spelling of the address
// alone — `JANE@X` stays `JANE@X`. Only a line whose first character is `#`
// is a comment, and addresses are taken exactly as written between the
// brackets.
//
// Checked against `git check-mailmap` and `git shortlog`.

type MailmapEntry = {
    /// Empty when the line gives no name.
    proper_name: str,
    proper_email: str,
    /// Empty when the entry matches on email alone.
    commit_name: str,
    commit_email: str,
    /// Whether the line gives a second address, so the first one replaces
    /// the commit's.
    rewrites_email: bool,
}

type Mailmap = {
    entries: [MailmapEntry],
}

/// Git's `isspace`: space, tab, newline, carriage return.
fn is_space(c: str) -> bool {
    return c == " " or c == "\t" or c == "\n" or c == "\r"
}

fn trim_git(text: str) -> str {
    let chars = text.chars()
    var start = 0
    var end = chars.len()
    while start < end and is_space(chars[start]) {
        start = start + 1
    }
    while end > start and is_space(chars[end - 1]) {
        end = end - 1
    }
    return text.substr(start, end - start)
}

/// `parse_name_and_email`: the name before the first `<` (trimmed), the
/// address up to the next `>` (as written), and the text after it — or
/// `None` when there is no such pair, or the address is empty and that is
/// not allowed.
fn name_and_email(text: str, allow_empty: bool) -> Option[(str, str, str)] {
    let left = text.index_of("<") ?? -1
    if left < 0 {
        return None
    }
    let after = text.substr(left + 1, text.len())
    let right = after.index_of(">") ?? -1
    if right < 0 or (right == 0 and not allow_empty) {
        return None
    }
    return Some((trim_git(text.substr(0, left)), after.substr(0, right),
        after.substr(right + 1, after.len())))
}

/// A whole `.mailmap`, one entry per line that has an address.
pub fn parse(text: str) -> Mailmap {
    var entries: [MailmapEntry] = []
    for line in text.split("\n") {
        if line.starts_with("#") {
            continue
        }
        match name_and_email(line, false) {
            Some(first) -> {
                var commit_name = ""
                var commit_email = first.1
                var rewrites = false
                if first.2.len() > 0 {
                    match name_and_email(first.2, true) {
                        Some(second) -> {
                            commit_name = second.0
                            commit_email = second.1
                            rewrites = true
                        }
                        None -> {}
                    }
                }
                entries.push(MailmapEntry{ proper_name: first.0,
                    proper_email: first.1, commit_name: commit_name,
                    commit_email: commit_email, rewrites_email: rewrites })
            }
            None -> {}
        }
    }
    return Mailmap{ entries: entries }
}

/// ASCII case folding, which is what `strcasecmp` does.
fn fold(text: str) -> str {
    var out = ""
    for c in text.chars() {
        let code = c.code_at(0)
        out = out + (if code >= 65 and code <= 90 { (code + 32).to_char() }
            else { c })
    }
    return out
}

/// The canonical name and email for a commit's name and email, as git's
/// `map_user` finds them.
pub fn resolve(map: Mailmap, name: str, email: str) -> (str, str) {
    let key = fold(email)
    var found = false
    var simple_name = ""
    var simple_email = ""
    var named: [MailmapEntry] = []
    for entry in map.entries {
        if fold(entry.commit_email) != key {
            continue
        }
        found = true
        if entry.commit_name.len() == 0 {
            if entry.proper_name.len() > 0 {
                simple_name = entry.proper_name
            }
            if entry.rewrites_email {
                simple_email = entry.proper_email
            }
            continue
        }
        // A later line for the same commit name replaces an earlier one.
        var kept: [MailmapEntry] = []
        for n in named {
            if fold(n.commit_name) != fold(entry.commit_name) {
                kept.push(n)
            }
        }
        kept.push(entry)
        named = kept
    }
    if not found {
        return (name, email)
    }
    if name.len() > 0 {
        for n in named {
            if fold(n.commit_name) == fold(name) {
                return (proper_or(n.proper_name, name),
                    if n.rewrites_email { n.proper_email } else { email })
            }
        }
    }
    return (proper_or(simple_name, name), proper_or(simple_email, email))
}

fn proper_or(proper: str, fallback: str) -> str {
    if proper.len() == 0 {
        return fallback
    }
    return proper
}

/// The same, written back as `Name <email>` — the form `git check-mailmap`
/// takes and prints.
pub fn resolve_line(map: Mailmap, line: str) -> str {
    let open = line.index_of("<") ?? -1
    if open < 0 {
        return line
    }
    let rest = line.substr(open + 1, line.len())
    let close = rest.index_of(">") ?? -1
    if close < 0 {
        return line
    }
    var name = line.substr(0, open)
    let chars = name.chars()
    var end = chars.len()
    while end > 0 and is_space(chars[end - 1]) {
        end = end - 1
    }
    name = name.substr(0, end)
    let found = resolve(map, name, rest.substr(0, close))
    if found.0.len() == 0 {
        return "<" + found.1 + ">"
    }
    return found.0 + " <" + found.1 + ">"
}

/// Every email the map rewrites, which is the list a contributor tool wants
/// to check its own data against.
pub fn mapped_emails(map: Mailmap) -> [str] {
    var out: [str] = []
    var seen: Map[str, bool] = {}
    for entry in map.entries {
        let key = fold(entry.commit_email)
        if not seen.has(key) {
            seen.set(key, true)
            out.push(entry.commit_email)
        }
    }
    return out
}

/// How many entries the map holds.
pub fn count(map: Mailmap) -> i64 {
    return map.entries.len()
}
