import purl

fn from_hex(text: str) -> str {
    var out: [i64] = []
    var i = 0
    while i + 1 < text.len() {
        out.push(text.substr(i, 2).parse_int_base(16) ?? 0)
        i = i + 2
    }
    return bytes_of(out).to_str()
}

fn to_hex(text: str) -> str {
    let digits = "0123456789abcdef"
    let raw = text.to_bytes()
    var out = ""
    var i = 0
    while i < raw.len() {
        out = out + digits.substr(raw.at(i) / 16, 1) +
            digits.substr(raw.at(i) % 16, 1)
        i = i + 1
    }
    return out
}

fn described(one: Purl) -> str {
    var pieces: [str] = []
    for pair in one.qualifiers {
        pieces.push(pair.0 + "=" + pair.1)
    }
    return one.kind + "\u{2}" + one.namespace + "\u{2}" + one.name +
        "\u{2}" + one.version + "\u{2}" + pieces.join("&") + "\u{2}" +
        one.subpath + "\u{2}" + purl.render(one)
}

fn main() / {io} {
    var i = 0
    while i < args().len() {
        let request = from_hex(args()[i]).split("\u{1}")
        if request[0] == "parse" {
            match purl.parse(request[1]) {
                Ok(one) -> print(to_hex(described(one)))
                Err(_why) -> print("error")
            }
        } else {
            var qualifiers: [(str, str)] = []
            if request[5].len() > 0 {
                for piece in request[5].split("&") {
                    var at = 0
                    var j = 0
                    while j < piece.len() {
                        if piece.substr(j, 1) == "=" {
                            at = j
                            j = piece.len()
                        } else {
                            j = j + 1
                        }
                    }
                    qualifiers.push((piece.substr(0, at),
                        piece.substr(at + 1, piece.len() - at - 1)))
                }
            }
            match purl.build(request[1], request[2], request[3], request[4],
                qualifiers, request[6]) {
                Ok(one) -> print(to_hex(described(one)))
                Err(_why) -> print("error")
            }
        }
        i = i + 1
    }
}
