import md5
import uuidnamed
import uuid

// Every byte string arrives with a leading `:`, because an empty argument
// does not survive the shell and an empty message is the first test vector
// RFC 1321 lists.
fn from_hex(text: str) -> bytes {
    var out: [i64] = []
    var i = 1
    while i + 1 < text.len() {
        out.push(text.substr(i, 2).parse_int_base(16) ?? 0)
        i = i + 2
    }
    return bytes_of(out)
}

fn main() / {io} {
    var i = 0
    while i + 1 < args().len() {
        let what = args()[i]
        if what == "md5" {
            print(md5.hex(from_hex(args()[i + 1])))
            i = i + 2
            continue
        }
        if what == "hmac" {
            print(md5.hmac_hex(from_hex(args()[i + 1]),
                from_hex(args()[i + 2])))
            i = i + 3
            continue
        }
        // `v5 <namespace> <name-hex>` or `v3 ...`
        let space = uuidnamed.namespace_named(args()[i + 1]) ??
        bytes_of([])
        let name = from_hex(args()[i + 2]).to_str()
        if what == "v5" {
            print(uuid.format(uuidnamed.v5(space, name)))
        } else {
            print(uuid.format(uuidnamed.v3(space, name)))
        }
        i = i + 3
    }
}
