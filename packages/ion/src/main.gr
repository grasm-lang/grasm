// Amazon Ion's binary encoding: a self-describing format with a symbol
// table.
//
// Ion is JSON's data model plus the types JSON leaves out — timestamps,
// arbitrary-precision decimals, binary blobs, annotations — in two
// interchangeable encodings, one text and one binary. This reads the binary
// one, which is what the format is for: the text form exists so a human can
// read the same document, and the two are defined to carry exactly the same
// values.
//
// ## Every value is a type-and-length nibble pair
//
// One byte: the high nibble is the type code, the low nibble is the length.
// A length of 14 means "the length follows as a variable-length integer",
// and 15 means the value is null of that type — so `0x2F` is a null int and
// `0x0F` is plain null. Everything else in the format hangs off that byte,
// and a reader that handles the two escapes handles most of it.
//
// ## VarUInt and VarInt, which are not the same
//
// Both are seven bits per byte with the top bit marking the last one.
// VarInt spends one further bit, in the *first* byte, on the sign — so a
// one-byte VarInt holds -63 to 63 and a one-byte VarUInt holds 0 to 127.
// Confusing them shifts every field that follows, and the symptom is a
// document that reads as garbage from the first negative number onwards.
//
// ## The symbol table is why it is compact
//
// Field names are integers into a table, and the table is itself an Ion
// value at the front of the stream. Ten thousand records with the same
// twenty field names carry the names once. The system symbols occupy the
// first nine slots and are the same in every document, which is what lets
// a reader make sense of the table before it has read the table.

type IonError =
    | TruncatedAt(at: i64)
    | BadVersionMarker()
    | UnknownType(code: i64, at: i64)
    | Overlong(at: i64)
    | NoSuchSymbol(id: i64)
    | NotAContainer(at: i64)

/// A decoded value. Ion's types, with the ones this reads.
type IonValue =
    | IonNull
    | IonBool(v: bool)
    | IonInt(v: i64)
    | IonFloat(v: f64)
    | IonDecimal(coefficient: i64, exponent: i64)
    | IonString(v: str)
    | IonSymbol(id: i64, text: str)
    | IonBlob(v: bytes)
    | IonClob(v: bytes)
    | IonList(items: [ref IonValue])
    | IonSexp(items: [ref IonValue])
    | IonStruct(names: [str], values: [ref IonValue])
    | IonTimestamp(text: str)
    | IonTyped(kind: str)

type IonReader = {
    data: bytes,
    at: i64,
    /// The symbols in force, the first nine being Ion's own.
    symbols: [str],
}

/// The nine symbols every Ion document starts with.
///
/// Slot zero is unnamed on purpose: a symbol id of zero means "unknown
/// text", which is what a reader writes when it has lost the table a
/// document referred to.
pub fn system_symbols() -> [str] {
    return ["", "$ion", "$ion_1_0", "$ion_symbol_table", "name",
        "version", "imports", "symbols", "max_id",
        "$ion_shared_symbol_table"]
}

/// The four bytes every binary Ion document begins with.
pub fn version_marker() -> bytes {
    return bytes_of([224, 1, 0, 234])
}

fn need(inout reader: IonReader, count: i64) -> bool ! IonError {
    if reader.at + count > reader.data.len() {
        fail(TruncatedAt(reader.at))
    }
    return true
}

fn take(inout reader: IonReader) -> i64 ! IonError {
    try need(reader, 1)
    let value = reader.data.at(reader.at)
    reader.at = reader.at + 1
    return value
}

/// A VarUInt: seven bits a byte, the last one flagged.
pub fn read_var_uint(inout reader: IonReader) -> i64 ! IonError {
    var value = 0
    var bytes_read = 0
    while true {
        let byte = try take(reader)
        bytes_read = bytes_read + 1
        if bytes_read > 9 {
            fail(Overlong(reader.at))
        }
        value = value * 128 + byte.bit_and(127)
        if byte >= 128 {
            return value
        }
    }
    return value
}

/// A VarInt, which spends a bit of the first byte on the sign.
pub fn read_var_int(inout reader: IonReader) -> i64 ! IonError {
    let first = try take(reader)
    let negative = first.bit_and(64) != 0
    var value = first.bit_and(63)
    if first >= 128 {
        if negative {
            return 0 - value
        }
        return value
    }
    var bytes_read = 1
    while true {
        let byte = try take(reader)
        bytes_read = bytes_read + 1
        if bytes_read > 10 {
            fail(Overlong(reader.at))
        }
        value = value * 128 + byte.bit_and(127)
        if byte >= 128 {
            if negative {
                return 0 - value
            }
            return value
        }
    }
    return value
}

/// A big-endian unsigned integer of a given width.
fn read_uint(inout reader: IonReader, width: i64) -> i64 ! IonError {
    try need(reader, width)
    var value = 0
    var i = 0
    while i < width {
        value = value * 256 + reader.data.at(reader.at + i)
        i = i + 1
    }
    reader.at = reader.at + width
    return value
}

/// The length of a value from its type byte, following the escape.
fn read_length(inout reader: IonReader, low: i64) -> i64 ! IonError {
    if low == 14 {
        return try read_var_uint(reader)
    }
    return low
}

fn read_text(inout reader: IonReader, length: i64) -> str ! IonError {
    try need(reader, length)
    var out = ""
    var i = reader.at
    let stop = reader.at + length
    while i < stop {
        let first = reader.data.at(i)
        if first < 128 {
            out = out + first.to_char()
            i = i + 1
        } else if first >= 192 and first < 224 and i + 1 < stop {
            out = out + ((first - 192) * 64 +
                (reader.data.at(i + 1) - 128)).to_char()
            i = i + 2
        } else if first >= 224 and first < 240 and i + 2 < stop {
            out = out + ((first - 224) * 4096 +
                (reader.data.at(i + 1) - 128) * 64 +
                (reader.data.at(i + 2) - 128)).to_char()
            i = i + 3
        } else if first >= 240 and i + 3 < stop {
            out = out + ((first - 240) * 262144 +
                (reader.data.at(i + 1) - 128) * 4096 +
                (reader.data.at(i + 2) - 128) * 64 +
                (reader.data.at(i + 3) - 128)).to_char()
            i = i + 4
        } else {
            out = out + "\u{fffd}"
            i = i + 1
        }
    }
    reader.at = stop
    return out
}

fn read_octets(inout reader: IonReader, length: i64) -> bytes ! IonError {
    try need(reader, length)
    var out: [i64] = []
    var i = 0
    while i < length {
        out.push(reader.data.at(reader.at + i))
        i = i + 1
    }
    reader.at = reader.at + length
    return bytes_of(out)
}

/// Read a whole document: the version marker, then the values, keeping any
/// symbol table found along the way.
pub fn decode(data: bytes) -> [IonValue] ! IonError {
    if data.len() < 4 {
        fail(TruncatedAt(0))
    }
    if data.at(0) != 224 or data.at(1) != 1 or data.at(2) != 0 or
    data.at(3) != 234 {
        fail(BadVersionMarker())
    }
    var reader = IonReader{ data: data, at: 4, symbols: system_symbols() }
    var out: [IonValue] = []
    while reader.at < data.len() {
        let value = try read_value(reader, 0)
        // A local symbol table is an annotated struct and is not part of
        // the user's data: it is the table the rest of the document names
        // its fields with.
        match value {
            IonTyped(kind) -> {
                if kind != "symbol-table" {
                    out.push(value)
                }
            }
            _ -> out.push(value)
        }
    }
    return out
}

fn read_value(inout reader: IonReader,
    depth: i64) -> IonValue ! IonError {
    if depth > 100 {
        fail(Overlong(reader.at))
    }
    let byte = try take(reader)
    let high = byte.ushr(4).bit_and(15)
    let low = byte.bit_and(15)
    if high == 0 {
        // A no-op pad, or the version marker appearing again mid-stream.
        if low == 15 {
            return IonNull
        }
        let length = try read_length(reader, low)
        let _skipped = try read_octets(reader, length)
        return IonTyped("pad")
    }
    if high == 1 {
        if low == 15 {
            return IonNull
        }
        return IonBool(low == 1)
    }
    if high == 2 or high == 3 {
        if low == 15 {
            return IonNull
        }
        let length = try read_length(reader, low)
        let magnitude = try read_uint(reader, length)
        if high == 3 {
            return IonInt(0 - magnitude)
        }
        return IonInt(magnitude)
    }
    if high == 4 {
        if low == 15 {
            return IonNull
        }
        if low == 0 {
            return IonFloat(0.0)
        }
        let bits = try read_uint(reader, low)
        if low == 4 {
            return IonFloat(widen(bits))
        }
        return IonFloat(bits.from_bits())
    }
    if high == 5 {
        if low == 15 {
            return IonNull
        }
        return try read_decimal(reader, low)
    }
    if high == 6 {
        if low == 15 {
            return IonNull
        }
        let length = try read_length(reader, low)
        return IonTimestamp(try timestamp_text(reader, length))
    }
    if high >= 7 and high <= 10 {
        if low == 15 {
            return IonNull
        }
        return try read_sized(reader, high, low)
    }
    if high == 11 or high == 12 {
        if low == 15 {
            return IonNull
        }
        let length = try read_length(reader, low)
        let items = try read_items(reader, length, depth)
        if high == 12 {
            return IonSexp(items)
        }
        return IonList(items)
    }
    if high == 13 {
        if low == 15 {
            return IonNull
        }
        return try read_struct(reader, low, depth)
    }
    if high == 14 {
        return try read_annotated(reader, low, depth)
    }
    fail(UnknownType(high, reader.at - 1))
}

/// The four types that are a length followed by that many bytes.
fn read_sized(inout reader: IonReader, high: i64,
    low: i64) -> IonValue ! IonError {
    let length = try read_length(reader, low)
    if high == 7 {
        let id = try read_uint(reader, length)
        return IonSymbol(id, symbol_text(reader.symbols, id))
    }
    if high == 8 {
        return IonString(try read_text(reader, length))
    }
    if high == 9 {
        return IonClob(try read_octets(reader, length))
    }
    return IonBlob(try read_octets(reader, length))
}

fn widen(bits: i64) -> f64 {
    let sign = bits.ushr(31).bit_and(1)
    let exponent = bits.ushr(23).bit_and(255)
    let mantissa = bits.bit_and(8388607)
    if exponent == 0 and mantissa == 0 {
        if sign == 1 {
            return 0.0 - 0.0
        }
        return 0.0
    }
    if exponent == 255 {
        return (sign.shl(63) + 2047.shl(52) + mantissa.shl(29)).from_bits()
    }
    return (sign.shl(63) + (exponent + 896).shl(52) +
        mantissa.shl(29)).from_bits()
}

fn symbol_text(symbols: [str], id: i64) -> str {
    if id < 0 or id >= symbols.len() {
        return "$" + "{id}"
    }
    return symbols[id]
}

fn read_decimal(inout reader: IonReader,
    low: i64) -> IonValue ! IonError {
    let length = try read_length(reader, low)
    if length == 0 {
        return IonDecimal(0, 0)
    }
    let start = reader.at
    let exponent = try read_var_int(reader)
    let used = reader.at - start
    let remaining = length - used
    if remaining <= 0 {
        return IonDecimal(0, exponent)
    }
    // The coefficient is a signed big-endian integer whose sign is the top
    // bit — which means a coefficient of zero can be written as a negative
    // zero, and Ion keeps the distinction.
    try need(reader, remaining)
    let first = reader.data.at(reader.at)
    var magnitude = first.bit_and(127)
    var i = 1
    while i < remaining {
        magnitude = magnitude * 256 + reader.data.at(reader.at + i)
        i = i + 1
    }
    reader.at = reader.at + remaining
    if first.bit_and(128) != 0 {
        return IonDecimal(0 - magnitude, exponent)
    }
    return IonDecimal(magnitude, exponent)
}

fn timestamp_text(inout reader: IonReader,
    length: i64) -> str ! IonError {
    let stop = reader.at + length
    let offset = try read_var_int(reader)
    var out = ""
    let year = try read_var_uint(reader)
    out = pad(year, 4)
    if reader.at < stop {
        out = out + "-" + pad(try read_var_uint(reader), 2)
    }
    if reader.at < stop {
        out = out + "-" + pad(try read_var_uint(reader), 2)
    }
    if reader.at < stop {
        out = out + "T" + pad(try read_var_uint(reader), 2)
        out = out + ":" + pad(try read_var_uint(reader), 2)
    }
    if reader.at < stop {
        out = out + ":" + pad(try read_var_uint(reader), 2)
    }
    // Whatever is left is the fractional second: an exponent, then a
    // coefficient in the bytes that remain. Skipping it turns a timestamp
    // recorded to the microsecond into one recorded to the second, which is
    // a loss the format went to some trouble to avoid.
    if reader.at < stop {
        let exponent = try read_var_int(reader)
        let width = stop - reader.at
        var coefficient = 0
        if width > 0 {
            coefficient = try read_uint(reader, width)
        }
        if exponent < 0 {
            out = out + "." + pad(coefficient, 0 - exponent)
        }
    }
    reader.at = stop
    if offset == 0 {
        return out + "Z"
    }
    if offset > 0 {
        return out + "+" + pad(offset / 60, 2) + ":" + pad(offset % 60, 2)
    }
    return out + "-" + pad((0 - offset) / 60, 2) + ":" +
    pad((0 - offset) % 60, 2)
}

fn pad(value: i64, width: i64) -> str {
    var out = "{value}"
    while out.len() < width {
        out = "0" + out
    }
    return out
}

fn read_items(inout reader: IonReader, length: i64,
    depth: i64) -> [ref IonValue] ! IonError {
    let stop = reader.at + length
    var out: [ref IonValue] = []
    while reader.at < stop {
        out.push(ref(try read_value(reader, depth + 1)))
    }
    return out
}

fn read_struct(inout reader: IonReader, low: i64,
    depth: i64) -> IonValue ! IonError {
    // A low nibble of 1 means the length follows and the fields are sorted;
    // it is otherwise the same as the escape.
    var length = 0
    if low == 1 or low == 14 {
        length = try read_var_uint(reader)
    } else {
        length = low
    }
    let stop = reader.at + length
    var names: [str] = []
    var values: [ref IonValue] = []
    while reader.at < stop {
        let id = try read_var_uint(reader)
        names.push(symbol_text(reader.symbols, id))
        values.push(ref(try read_value(reader, depth + 1)))
    }
    return IonStruct(names, values)
}

fn read_annotated(inout reader: IonReader, low: i64,
    depth: i64) -> IonValue ! IonError {
    let length = try read_length(reader, low)
    let stop = reader.at + length
    let annotation_length = try read_var_uint(reader)
    let annotation_stop = reader.at + annotation_length
    var annotations: [i64] = []
    while reader.at < annotation_stop {
        annotations.push(try read_var_uint(reader))
    }
    let value = try read_value(reader, depth + 1)
    reader.at = stop
    // Annotation 3 is `$ion_symbol_table`, and the value it wraps is the
    // table rather than data. Reading it is what makes every field name
    // after this point mean something.
    for annotation in annotations {
        if annotation == 3 {
            adopt_symbols(reader, value)
            return IonTyped("symbol-table")
        }
    }
    return value
}

fn adopt_symbols(inout reader: IonReader, table: IonValue) {
    match table {
        IonStruct(names, values) -> {
            var i = 0
            while i < names.len() {
                if names[i] == "symbols" {
                    var symbols = system_symbols()
                    match values[i].value {
                        IonList(items) -> {
                            for item in items {
                                match item.value {
                                    IonString(text) -> symbols.push(text)
                                    _ -> symbols.push("")
                                }
                            }
                        }
                        _ -> {}
                    }
                    reader.symbols = symbols
                }
                i = i + 1
            }
        }
        _ -> {}
    }
}

/// A struct's field, by name.
pub fn field_of(value: IonValue, name: str) -> IonValue ! IonError {
    match value {
        IonStruct(names, values) -> {
            var i = 0
            while i < names.len() {
                if names[i] == name {
                    return values[i].value
                }
                i = i + 1
            }
            fail(NoSuchSymbol(0 - 1))
        }
        _ -> fail(NotAContainer(0))
    }
}

/// A decimal's value as a float, which is lossy and says so.
///
/// Ion keeps decimals exact because money is decimal and binary floating
/// point is not: 0.1 + 0.2 is 0.30000000000000004 in a double and exactly
/// 0.3 in an Ion decimal. Converting one to a float throws that away, which
/// is why it is a named function rather than something that happens on the
/// way past.
pub fn decimal_as_float(coefficient: i64, exponent: i64) -> f64 {
    var value = coefficient.as_f64()
    var i = 0
    if exponent >= 0 {
        while i < exponent {
            value = value * 10.0
            i = i + 1
        }
    } else {
        while i < 0 - exponent {
            value = value / 10.0
            i = i + 1
        }
    }
    return value
}
