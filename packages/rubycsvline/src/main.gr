// One line of CSV the way Ruby 2.6 reads and writes it: `CSV.parse_line`
// and `CSV.generate_line` from the csv 3.0.9 that Ruby 2.6 ships, with
// `col_sep`, `row_sep` (`:auto` too), `quote_char` (or none),
// `liberal_parsing` (with `double_quote_outside_quote` and
// `backslash_quote`), `strip`, `field_size_limit`, `skip_blanks`,
// `nil_value` and `empty_value` for reading, and `force_quotes`,
// `quote_empty`, `write_nil_value` and `write_empty_value` for writing.
//
// csv 3.0.9 reads a line two ways, and which way decides some answers:
//
//   - A line with no line break in it and no quote but around a whole
//     field is split on `col_sep` as a string. Otherwise -- and always
//     with `liberal_parsing` or `strip` -- a scanner reads it, which may
//     go on past the line inside quotes. So `a|||b` with `col_sep: "||"`
//     is `["a", "|b"]`, but `field_size_limit` is only checked by the
//     scanner.
//   - The scanner's errors are MalformedCSVError, "... in line 1.":
//     "Illegal quoting", "Unclosed quoted field", "Any value after quoted
//     field isn't allowed", "Unquoted fields do not allow new line
//     <"\r">", "New line must be <"\n"> not <"\r">", "Field size
//     exceeded", and for anything else "TODO: Meaningful message".
//   - Text that is not UTF-8 fails before any parsing, naming the first
//     bad line, even when only the first row is wanted.
//   - `row_sep: :auto` looks at the first line break: `\r\n`, `\r` or
//     `\n`, and `\n` when there is none.
//   - With no quote character, `strip: true` splits on the literal
//     " \t\r\n\f" before the separator (a bug in 3.0.9), so it does not
//     split around ordinary spaces; a one-character `strip` works.
//   - `String#strip` keeps a leading NUL and drops a trailing one.
//   - With `backslash_quote`, `\"` becomes `"` inside and outside
//     quotes, where outside quotes the pattern is a backslash and the
//     quote character as `Regexp.escape` writes it (`\\|` for `|`).
//
// Writing quotes a field holding a CR, an LF, the quote character or any
// character of `col_sep`, and an empty one unless `quote_empty` is off; a
// nil field is written empty. A row with no string in it is written as
// US-ASCII, so a non-ASCII `col_sep`, `row_sep` or `quote_char` is
// Encoding::UndefinedConversionError ("U+00A6 from UTF-8 to US-ASCII"), as
// is a non-ASCII quote around a nil field with `force_quotes`.
//
// Limits: `col_sep`, `quote_char`, the `strip` character and `row_sep`
// must not share characters (Ruby's results for such options come from
// how its regular expressions happen to backtrack), `row_sep` must be
// ASCII when the text is not valid UTF-8, and converters other than
// `nil_value` and `empty_value` are not supported.

type RbCsvError = | RbCsvMalformedError(message: str) | RbCsvArgumentError(message: str) | RbCsvConversionError(message: str)

/// The Ruby exception's class name.
pub fn error_name(e: RbCsvError) -> str {
    return match e {
        RbCsvMalformedError(_m) -> "MalformedCSVError"
        RbCsvArgumentError(_m) -> "ArgumentError"
        RbCsvConversionError(_m) -> "UndefinedConversionError"
    }
}

/// The Ruby exception's message.
pub fn error_message(e: RbCsvError) -> str {
    return match e {
        RbCsvMalformedError(m) -> m
        RbCsvArgumentError(m) -> m
        RbCsvConversionError(m) -> m
    }
}

/// `CSV.parse_line`'s options. `row_sep` None is `:auto`; `strip_char`,
/// when set, is a string `strip:` and wins over `strip`.
type RbCsvParseOptions = {
    col_sep: str,
    row_sep: Option[str],
    quote_char: Option[str],
    liberal_parsing: bool,
    double_quote_outside_quote: bool,
    backslash_quote: bool,
    strip: bool,
    strip_char: Option[str],
    field_size_limit: Option[i64],
    skip_blanks: bool,
    nil_value: Option[str],
    empty_value: str,
}

/// `CSV.generate_line`'s options.
type RbCsvWriteOptions = {
    col_sep: str,
    row_sep: str,
    quote_char: str,
    force_quotes: bool,
    quote_empty: bool,
    write_nil_value: Option[str],
    write_empty_value: str,
}

/// Ruby's defaults for reading.
pub fn parse_options() -> RbCsvParseOptions {
    return RbCsvParseOptions{ col_sep: ",", row_sep: None, quote_char: Some("\""), liberal_parsing: false, double_quote_outside_quote: false, backslash_quote: false,
        strip: false, strip_char: None, field_size_limit: None, skip_blanks: false, nil_value: None, empty_value: "" }
}

/// Ruby's defaults for writing.
pub fn write_options() -> RbCsvWriteOptions {
    return RbCsvWriteOptions{ col_sep: ",", row_sep: "\n", quote_char: "\"", force_quotes: false, quote_empty: true, write_nil_value: None, write_empty_value: "" }
}

fn cps(s: str) -> [i64] {
    return s.codes()
}

fn text(cs: [i64]) -> str {
    return cs.map(|c| c.to_char()).join("")
}

fn extend(inout out: [i64], xs: [i64]) {
    for x in xs {
        out.push(x)
    }
}

fn starts_at(s: [i64], at: i64, w: [i64]) -> bool {
    return w.len() > 0 and s.len() - at >= w.len() and s.slice(at, at + w.len()) == w
}

fn ends_with(s: [i64], w: [i64]) -> bool {
    return s.len() >= w.len() and s.slice(s.len() - w.len(), s.len()) == w
}

fn repeat(c: i64, n: i64) -> [i64] {
    var out: [i64] = []
    var i = 0
    while i < n {
        out.push(c)
        i = i + 1
    }
    return out
}

/// `gsub` with a string pattern: left to right, never overlapping.
fn replace_all(s: [i64], pat: [i64], rep: [i64]) -> [i64] {
    var out: [i64] = []
    var i = 0
    while i < s.len() {
        if starts_at(s, i, pat) {
            extend(out, rep)
            i = i + pat.len()
        } else {
            out.push(s[i])
            i = i + 1
        }
    }
    return out
}

/// `String#inspect` for the separators and line ends in messages.
fn inspect(cs: [i64]) -> str {
    var out = "\""
    var i = 0
    while i < cs.len() {
        let c = cs[i]
        let next = if i + 1 < cs.len() { cs[i + 1] } else { 0 - 1 }
        if c == 34 or c == 92 {
            out = out + "\\" + c.to_char()
        } else if c == 35 and (next == 123 or next == 36 or next == 64) {
            out = out + "\\#"
        } else if c == 10 {
            out = out + "\\n"
        } else if c == 13 {
            out = out + "\\r"
        } else if c == 9 {
            out = out + "\\t"
        } else if c == 12 {
            out = out + "\\f"
        } else if c == 11 {
            out = out + "\\v"
        } else if c == 8 {
            out = out + "\\b"
        } else if c == 7 {
            out = out + "\\a"
        } else if c == 27 {
            out = out + "\\e"
        } else if c < 32 or c == 127 {
            out = out + "\\u00" + "0123456789ABCDEF".substr(c / 16, 1) + "0123456789ABCDEF".substr(c % 16, 1)
        } else {
            out = out + c.to_char()
        }
        i = i + 1
    }
    return out + "\""
}

// ---- UTF-8

/// The length of the valid UTF-8 sequence at `i`, or 0.
fn utf8_len(b: [i64], i: i64) -> i64 {
    let c = b[i]
    if c < 128 {
        return 1
    }
    let n = if c >= 194 and c <= 223 { 2 } else if c >= 224 and c <= 239 { 3 } else if c >= 240 and c <= 244 { 4 } else { 0 }
    if n == 0 or i + n > b.len() {
        return 0
    }
    var lo = 128
    var hi = 191
    if c == 224 {
        lo = 160
    } else if c == 237 {
        hi = 159
    } else if c == 240 {
        lo = 144
    } else if c == 244 {
        hi = 143
    }
    if b[i + 1] < lo or b[i + 1] > hi {
        return 0
    }
    var k = 2
    while k < n {
        if b[i + k] < 128 or b[i + k] > 191 {
            return 0
        }
        k = k + 1
    }
    return n
}

fn valid_utf8(b: [i64]) -> bool {
    var i = 0
    while i < b.len() {
        let n = utf8_len(b, i)
        if n == 0 {
            return false
        }
        i = i + n
    }
    return true
}

/// `string.lines(row_sep).index { |l| !l.valid_encoding? }`, by bytes.
fn first_bad_line(b: [i64], rs: [i64]) -> i64 {
    var index = 0
    var start = 0
    var i = 0
    while i <= b.len() {
        let at_sep = starts_at(b, i, rs)
        if at_sep or i == b.len() {
            let end = if at_sep { i + rs.len() } else { i }
            if not valid_utf8(b.slice(start, end)) {
                return index
            }
            index = index + 1
            start = end
            i = end
            if not at_sep {
                i = i + 1
            }
        } else {
            i = i + 1
        }
    }
    return index
}

/// `detect_row_separator`: the first line break decides.
fn detect_row_sep(b: [i64]) -> [i64] {
    var lf = 0 - 1
    var i = 0
    while i < b.len() and lf < 0 {
        if b[i] == 10 {
            lf = i
        }
        i = i + 1
    }
    var cr = 0 - 1
    i = 0
    while i < (if lf >= 0 { lf } else { b.len() }) and cr < 0 {
        if b[i] == 13 {
            cr = i
        }
        i = i + 1
    }
    if cr >= 0 and lf >= 0 {
        return if cr + 1 == lf { [13, 10] } else { [13] }
    }
    if cr >= 0 {
        return [13]
    }
    return [10]
}

// ---- reading

/// The scanner's state: the text, where it is, and the options it reads.
/// `q` is -1 with no quote character; `strip` is 0, 1 for whitespace or 2
/// for the character `sc`; `limit` is -1 for none.
type RbCsvScan = {
    s: [i64],
    pos: i64,
    q: i64,
    col: [i64],
    rs: [i64],
    liberal: bool,
    dq: bool,
    bq: bool,
    strip: i64,
    sc: i64,
    limit: i64,
    skip_blanks: bool,
    quoted: bool,
    unquoted: bool,
}

fn is_ruby_space(c: i64) -> bool {
    return c == 32 or c >= 9 and c <= 13
}

fn strip_has(p: RbCsvScan, c: i64) -> bool {
    return p.strip == 1 and is_ruby_space(c) or p.strip == 2 and c == p.sc
}

/// What `@unquoted_value` stops at.
fn unquoted_stop(p: RbCsvScan, c: i64) -> bool {
    return c == 13 or c == 10 or c == p.col[0] or not p.liberal and c == p.q or strip_has(p, c)
}

fn malformed(m: str) -> RbCsvError {
    return RbCsvMalformedError(m + " in line 1.")
}

fn eat(inout p: RbCsvScan, w: [i64]) -> bool {
    if starts_at(p.s, p.pos, w) {
        p.pos = p.pos + w.len()
        return true
    }
    return false
}

fn run_of(p: RbCsvScan, c: i64) -> i64 {
    var k = p.pos
    while k < p.s.len() and p.s[k] == c {
        k = k + 1
    }
    return k - p.pos
}

/// `@strip_value`, which exists only with a quote character.
fn skip_strip(inout p: RbCsvScan) {
    if p.q >= 0 {
        while p.pos < p.s.len() and strip_has(p, p.s[p.pos]) {
            p.pos = p.pos + 1
        }
    }
}

/// `parse_quoted_column_value`.
fn parse_quoted(inout p: RbCsvScan) -> Option[[i64]] ! RbCsvError {
    let n0 = run_of(p, p.q)
    if n0 == 0 {
        return None
    }
    p.pos = p.pos + n0
    p.quoted = true
    if n0 % 2 == 0 {
        return Some(repeat(p.q, (n0 - 2) / 2))
    }
    var value = repeat(p.q, (n0 - 1) / 2)
    while true {
        while p.pos < p.s.len() and p.s[p.pos] != p.q and not (p.bq and p.s[p.pos] == 92) {
            value.push(p.s[p.pos])
            p.pos = p.pos + 1
        }
        if p.bq and p.pos < p.s.len() and p.s[p.pos] == 92 {
            p.pos = p.pos + 1
            if p.pos < p.s.len() and p.s[p.pos] == p.q {
                value.push(p.q)
                p.pos = p.pos + 1
            } else {
                value.push(92)
            }
            continue
        }
        let n = run_of(p, p.q)
        if n == 0 {
            fail(malformed("Unclosed quoted field"))
        }
        p.pos = p.pos + n
        if n % 2 == 1 {
            extend(value, repeat(p.q, (n - 1) / 2))
            break
        }
        extend(value, repeat(p.q, n / 2))
    }
    return Some(value)
}

fn scan_unquoted(inout p: RbCsvScan) -> [i64] {
    let start = p.pos
    while p.pos < p.s.len() and not unquoted_stop(p, p.s[p.pos]) {
        p.pos = p.pos + 1
    }
    return p.s.slice(start, p.pos)
}

/// `Regexp.escape` of one character.
fn regexp_escape(c: i64) -> [i64] {
    let special = c == 91 or c == 93 or c == 123 or c == 125 or c == 40 or c == 41 or c == 124 or c == 45 or c == 42 or c == 46 or c == 92 or c == 63 or c == 43 or c ==
    94 or c == 36 or c == 35 or c == 32
    if special {
        return [92, c]
    }
    let named = if c == 9 { 116 } else if c == 10 { 110 } else if c == 13 { 114 } else if c == 12 { 102 } else if c == 11 { 118 } else { 0 }
    return if named > 0 { [92, named] } else { [c] }
}

/// `parse_unquoted_column_value`.
fn parse_unquoted(inout p: RbCsvScan) -> Option[[i64]] {
    var value = scan_unquoted(p)
    if value.len() == 0 {
        return None
    }
    p.unquoted = true
    if p.col.len() > 1 {
        // A longer separator: runs of its first character that do not
        // start the whole separator belong to the value.
        while not starts_at(p.s, p.pos, p.col) {
            let k = run_of(p, p.col[0])
            if k == 0 {
                break
            }
            extend(value, p.s.slice(p.pos, p.pos + k))
            p.pos = p.pos + k
            let more = scan_unquoted(p)
            if more.len() == 0 {
                break
            }
            extend(value, more)
        }
    }
    if p.bq {
        var pat = [92]
        extend(pat, regexp_escape(p.q))
        value = replace_all(value, pat, [p.q])
    }
    return Some(value)
}

/// `parse_column_value`.
fn column_value(inout p: RbCsvScan) -> Option[[i64]] ! RbCsvError {
    let quoted = try parse_quoted(p)
    if not p.liberal {
        return match quoted {
            Some(v) -> Some(v)
            None -> parse_unquoted(p)
        }
    }
    let qv = match quoted {
        Some(v) -> v
        None -> return parse_unquoted(p)
    }
    var uv = match parse_unquoted(p) {
        Some(v) -> v
        None -> return Some(qv)
    }
    var out = [p.q]
    if p.dq {
        uv = replace_all(uv, [p.q, p.q], [p.q])
        if qv.len() == 0 {
            extend(out, uv)
            return Some(out)
        }
    }
    extend(out, qv)
    out.push(p.q)
    extend(out, uv)
    return Some(out)
}

/// The error for a field followed by something that is neither a
/// separator nor the end.
fn broken(p: RbCsvScan) -> RbCsvError {
    if p.quoted {
        return malformed("Any value after quoted field isn't allowed")
    }
    let c = p.s[p.pos]
    let line_break = c == 13 or c == 10
    if p.unquoted and line_break {
        return malformed("Unquoted fields do not allow new line <" + inspect([c]) + ">")
    }
    if c == p.q {
        return malformed("Illegal quoting")
    }
    if line_break {
        return malformed("New line must be <" + inspect(p.rs) + "> not <" + inspect([c]) + ">")
    }
    return malformed("TODO: Meaningful message")
}

fn is_none(v: Option[[i64]]) -> bool {
    return match v {
        Some(_x) -> false
        None -> true
    }
}

/// `parse_quotable_robust`, up to the first row.
fn robust(inout p: RbCsvScan) -> Option[[Option[[i64]]]] ! RbCsvError {
    var row: [Option[[i64]]] = []
    while true {
        p.quoted = false
        p.unquoted = false
        skip_strip(p)
        let value = try column_value(p)
        match value {
            Some(v) -> {
                skip_strip(p)
                if p.limit >= 0 and v.len() >= p.limit {
                    fail(malformed("Field size exceeded"))
                }
            }
            None -> ()
        }
        let blank = row.len() == 0 and is_none(value)
        if eat(p, p.col) {
            row.push(value)
        } else if eat(p, p.rs) {
            if not blank {
                row.push(value)
                return Some(row)
            }
            if not p.skip_blanks {
                return Some([])
            }
        } else if p.pos >= p.s.len() {
            if blank {
                return None
            }
            row.push(value)
            return Some(row)
        } else {
            fail(broken(p))
        }
    }
    return None
}

/// The end of the line that starts at `pos`, after its row separator.
fn line_end(s: [i64], pos: i64, rs: [i64]) -> i64 {
    var i = pos
    while i < s.len() {
        if starts_at(s, i, rs) {
            return i + rs.len()
        }
        i = i + 1
    }
    return s.len()
}

/// `split(sep, -1)` with the separator found by `sep_end`.
fn split_with(line: [i64], p: RbCsvScan, no_quote: bool) -> [[i64]] {
    var out: [[i64]] = []
    var beg = 0
    var i = 0
    while i < line.len() {
        let e = sep_end(line, i, p, no_quote)
        if e > i {
            out.push(line.slice(beg, i))
            beg = e
            i = e
        } else {
            i = i + 1
        }
    }
    out.push(line.slice(beg, line.len()))
    return out
}

fn run_from(s: [i64], at: i64, c: i64) -> i64 {
    var k = at
    while k < s.len() and s[k] == c {
        k = k + 1
    }
    return k
}

/// Where `@split_column_separator` matching at `i` ends, or `i`. With no
/// quote character and `strip`, it is `strip*` `col_sep` `strip*`, where
/// for `strip: true` the "strip" is the literal " \t\r\n\f" and a run
/// of `\v`.
fn sep_end(line: [i64], i: i64, p: RbCsvScan, no_quote: bool) -> i64 {
    if not no_quote or p.strip == 0 {
        return if starts_at(line, i, p.col) { i + p.col.len() } else { i }
    }
    if p.strip == 2 {
        let k = run_from(line, i, p.sc)
        return if starts_at(line, k, p.col) { run_from(line, k + p.col.len(), p.sc) } else { i }
    }
    let ws = [32, 9, 13, 10, 12]
    if not starts_at(line, i, ws) {
        return i
    }
    let k = run_from(line, i + 5, 11)
    if not starts_at(line, k, p.col) or not starts_at(line, k + p.col.len(), ws) {
        return i
    }
    return run_from(line, k + p.col.len() + 5, 11)
}

/// `strip_value` for a whole line with no quote character.
fn strip_line(line: [i64], p: RbCsvScan) -> [i64] {
    var a = 0
    var b = line.len()
    if p.strip == 2 {
        while a < b and line[a] == p.sc {
            a = a + 1
        }
        while b > a and line[b - 1] == p.sc {
            b = b - 1
        }
    } else if p.strip == 1 {
        while a < b and is_ruby_space(line[a]) {
            a = a + 1
        }
        while b > a and (is_ruby_space(line[b - 1]) or line[b - 1] == 0) {
            b = b - 1
        }
    }
    return line.slice(a, b)
}

/// `parse_no_quote`, up to the first row.
fn no_quote(p: RbCsvScan) -> Option[[Option[[i64]]]] {
    var pos = 0
    while pos < p.s.len() {
        let end = line_end(p.s, pos, p.rs)
        var line = p.s.slice(pos, end)
        if ends_with(line, p.rs) {
            line = line.slice(0, line.len() - p.rs.len())
        }
        if line.len() > 0 or not p.skip_blanks {
            if line.len() == 0 {
                return Some([])
            }
            let stripped = strip_line(line, p)
            if stripped.len() == 0 {
                return Some([])
            }
            return Some(split_with(stripped, p, true).map(|f| if f.len() == 0 { None } else { Some(f) }))
        }
        pos = end
    }
    return None
}

/// One loose field: None when the scanner has to take over.
fn loose_field(f: [i64], q: i64) -> Option[Option[[i64]]] {
    if f.len() == 0 {
        return Some(None)
    }
    let n = f.filter(|c| c == q).len()
    if n == 0 {
        return Some(Some(f))
    }
    if n == 2 and f[0] == q and f[f.len() - 1] == q {
        return Some(Some(f.slice(1, f.len() - 1)))
    }
    return None
}

/// `parse_quotable_loose`, up to the first row; it hands a line it cannot
/// split to the scanner.
fn loose(inout p: RbCsvScan) -> Option[[Option[[i64]]]] ! RbCsvError {
    var pos = 0
    while pos < p.s.len() {
        let end = line_end(p.s, pos, p.rs)
        var line = p.s.slice(pos, end)
        if ends_with(line, p.rs) {
            line = line.slice(0, line.len() - p.rs.len())
        }
        if line.len() == 0 {
            if not p.skip_blanks {
                return Some([])
            }
        } else {
            var row: [Option[[i64]]] = []
            var ok = not line.contains(13) and not line.contains(10)
            if ok {
                for f in split_with(line, p, false) {
                    match loose_field(f, p.q) {
                        Some(v) -> row.push(v)
                        None -> {
                            ok = false
                        }
                    }
                }
            }
            if ok {
                return Some(row)
            }
            p.pos = pos
            return try robust(p)
        }
        pos = end
    }
    return None
}

fn one_char(o: Option[str]) -> i64 {
    return match o {
        Some(s) -> s.codes()[0]
        None -> 0 - 1
    }
}

fn check_options(o: RbCsvParseOptions) -> bool ! RbCsvError {
    match o.quote_char {
        Some(q) -> {
            if q.codes().len() != 1 {
                fail(RbCsvArgumentError(":quote_char has to be nil or a single character String"))
            }
        }
        None -> ()
    }
    match o.strip_char {
        Some(c) -> {
            if c.codes().len() == 0 {
                fail(RbCsvArgumentError(":strip must not be an empty String"))
            }
            if c.codes().len() > 1 {
                fail(RbCsvArgumentError(":strip doesn't support 2 or more characters yet"))
            }
        }
        None -> ()
    }
    return true
}

fn convert_field(f: Option[[i64]], o: RbCsvParseOptions) -> Option[str] {
    return match f {
        None -> o.nil_value
        Some(v) -> if v.len() == 0 { Some(o.empty_value) } else { Some(text(v)) }
    }
}

fn convert(row: [Option[[i64]]], o: RbCsvParseOptions) -> [Option[str]] {
    return row.map(|f| convert_field(f, o))
}

/// `CSV.parse_line(line, **options)`: the first row, or None when there is
/// none. A field is None where Ruby has nil.
pub fn parse_line(line: bytes, o: RbCsvParseOptions) -> Option[[Option[str]]] ! RbCsvError {
    let _ok = try check_options(o)
    let raw = line.to_list()
    let rs = match o.row_sep {
        Some(r) -> r.to_bytes().to_list()
        None -> detect_row_sep(raw)
    }
    if not valid_utf8(raw) {
        fail(RbCsvMalformedError("Invalid byte sequence in UTF-8 in line " + (first_bad_line(raw, rs) + 1).to_str() + "."))
    }
    let strip = match o.strip_char {
        Some(_c) -> 2
        None -> if o.strip { 1 } else { 0 }
    }
    let liberal = o.liberal_parsing
    var p = RbCsvScan{ s: cps(line.to_str()), pos: 0, q: one_char(o.quote_char), col: cps(o.col_sep), rs: cps(text(rs)), liberal: liberal, dq: liberal and
        o.double_quote_outside_quote, bq: liberal and o.backslash_quote, strip: strip, sc: one_char(o.strip_char), limit: o.field_size_limit ?? (0 - 1),
        skip_blanks: o.skip_blanks, quoted: false, unquoted: false }
    var row: Option[[Option[[i64]]]] = None
    if p.q < 0 {
        row = no_quote(p)
    } else if liberal or strip != 0 {
        row = try robust(p)
    } else {
        row = try loose(p)
    }
    return match row {
        Some(r) -> Some(convert(r, o))
        None -> None
    }
}

// ---- writing

fn is_some_str(f: Option[str]) -> bool {
    return match f {
        Some(_s) -> true
        None -> false
    }
}

fn quote_field(field: [i64], q: [i64]) -> [i64] {
    var qq = q
    extend(qq, q)
    var out = q
    extend(out, replace_all(field, q, qq))
    extend(out, q)
    return out
}

/// Encoding `s` to US-ASCII: the error for its first other character.
fn to_ascii(s: str) -> bool ! RbCsvError {
    for c in s.codes() {
        if c >= 128 {
            let h = "0123456789ABCDEF"
            var digits = ""
            var v = c
            while v > 0 or digits.len() < 4 {
                digits = h.substr(v % 16, 1) + digits
                v = v / 16
            }
            fail(RbCsvConversionError("U+" + digits + " from UTF-8 to US-ASCII"))
        }
    }
    return true
}

fn quote(field: Option[str], o: RbCsvWriteOptions) -> [i64] ! RbCsvError {
    let q = cps(o.quote_char)
    let f = match field {
        Some(s) -> cps(s)
        None -> {
            if o.force_quotes {
                // `String(nil)` is US-ASCII, and the quote is encoded to it.
                let _ok = try to_ascii(o.quote_char)
                return quote_field([], q)
            }
            return []
        }
    }
    if o.force_quotes {
        return quote_field(f, q)
    }
    let col = cps(o.col_sep)
    let quotable = f.any(|c| c == 13 or c == 10 or col.contains(c) or q.contains(c))
    if o.quote_empty and f.len() == 0 or quotable {
        return quote_field(f, q)
    }
    return f
}

/// `CSV.generate_line(row, **options)`.
pub fn generate_line(row: [Option[str]], o: RbCsvWriteOptions) -> str ! RbCsvError {
    if not row.any(|f| is_some_str(f)) {
        let _c = try to_ascii(o.col_sep)
        let _r = try to_ascii(o.row_sep)
        if not o.force_quotes {
            let _q = try to_ascii(o.quote_char)
        }
    }
    var out: [i64] = []
    var first = true
    for field in row {
        if not first {
            extend(out, cps(o.col_sep))
        }
        first = false
        let converted = match field {
            None -> o.write_nil_value
            Some(s) -> if s.len() == 0 { Some(o.write_empty_value) } else { Some(s) }
        }
        extend(out, try quote(converted, o))
    }
    extend(out, cps(o.row_sep))
    return text(out)
}
