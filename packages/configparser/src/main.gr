// Python's `configparser`, which is not the INI file anyone else writes.
//
// `packages/ini` reads the dialect git and desktop entries use. This one
// reads the dialect Python programs use, and the differences are not
// cosmetic — a file that round-trips through one and then the other comes out
// changed:
//
//   - **Keys are lower-cased.** `Name` and `name` are the same option, and
//     what comes back is the lower-cased spelling. Section names are not.
//   - **`:` separates as well as `=`,** so `y: 2` is a pair, and a value
//     containing a colon is still fine because only the first separator
//     counts.
//   - **A continuation is an indented line**, joined with a newline rather
//     than a space. A value can therefore hold several lines, and a file with
//     inconsistent indentation means something different from what it looks
//     like.
//   - **`[DEFAULT]` is inherited by every section**, and its keys appear in
//     every section's listing — which is why `items()` on a section returns
//     more than that section wrote.
//   - **A value is interpolated.** `%(home)s` in the basic dialect,
//     `${section:option}` in the extended one, and a loop is an error rather
//     than a hang.
//   - **A key with no separator is a key with no value**, which is an error
//     unless the file is read with `allow_no_value`.

type ConfigError =
    | MissingSectionHeader(line: i64, text: str)
    | DuplicateSection(line: i64, name: str)
    | DuplicateOption(line: i64, section: str, name: str)
    | NoValue(line: i64, name: str)
    | BadInterpolation(section: str, option: str, why: str)
    | NoSection(name: str)
    | NoOption(section: str, name: str)

/// One option: the key as it will be looked up, and the raw text of its
/// value before any interpolation.
type Setting = {
    key: str,
    value: str,
    /// A key that appeared with no separator at all.
    bare: bool,
}

type Section = {
    name: str,
    options: [Setting],
}

type Config = {
    sections: [Section],
    /// Whether `%(x)s` or `${a:x}` is the interpolation syntax.
    extended: bool,
}

let DEFAULT_SECTION = "DEFAULT"

fn trimmed(text: str) -> str {
    return text.trim()
}

fn starts_indented(line: str) -> bool {
    if line.len() == 0 {
        return false
    }
    let first = line.substr(0, 1)
    return first == " " or first == "\t"
}

fn is_comment(line: str) -> bool {
    let t = line.trim()
    return t.starts_with("#") or t.starts_with(";")
}

/// An empty configuration, before anything is read into it.
pub fn empty(extended: bool) -> Config {
    let none: [Section] = []
    return Config{ sections: none, extended: extended }
}

fn find_section(c: Config, name: str) -> i64 {
    var i = 0
    while i < c.sections.len() {
        if c.sections[i].name == name {
            return i
        }
        i = i + 1
    }
    return -1
}

fn find_option(s: Section, key: str) -> i64 {
    var i = 0
    while i < s.options.len() {
        if s.options[i].key == key {
            return i
        }
        i = i + 1
    }
    return -1
}

/// Reads a whole file. Later values for the same key replace earlier ones,
/// which is what `read_string` does when a file is read twice.
pub fn read(text: str, allow_no_value: bool,
    extended: bool) -> Config ! ConfigError {
    var c = empty(extended)
    var section = -1
    var option = -1
    var number = 0
    for raw in text.split("\n") {
        number = number + 1
        let line = if raw.ends_with("\r") { raw.substr(0, raw.len() - 1) } else {
            raw }
        if line.trim().len() == 0 {
            // A blank line ends a continuation but not a section.
            option = -1
            continue
        }
        if is_comment(line) {
            continue
        }
        if starts_indented(line) and option >= 0 and section >= 0 {
            c.sections[section].options[option].value =
            c.sections[section].options[option].value + "\n" + line.trim()
            continue
        }
        let t = line.trim()
        if t.starts_with("[") {
            let close = t.index_of("]") ?? -1
            if close < 0 {
                fail(MissingSectionHeader(number, line))
            }
            let name = t.substr(1, close - 1)
            let at = find_section(c, name)
            if at >= 0 {
                section = at
            } else {
                let fresh: [Setting] = []
                c.sections.push(Section{ name: name, options: fresh })
                section = c.sections.len() - 1
            }
            option = -1
            continue
        }
        if section < 0 {
            fail(MissingSectionHeader(number, line))
        }
        // The first `=` or `:`, whichever comes first, is the separator.
        let equals = t.index_of("=") ?? -1
        let colon = t.index_of(":") ?? -1
        var cut = equals
        if colon >= 0 and (equals < 0 or colon < equals) {
            cut = colon
        }
        if cut < 0 {
            if not allow_no_value {
                fail(NoValue(number, t))
            }
            c.sections[section].options.push(Setting{ key: t.to_lower(),
                value: "", bare: true })
            option = c.sections[section].options.len() - 1
            continue
        }
        let key = t.substr(0, cut).trim().to_lower()
        let value = t.substr(cut + 1, t.len() - cut - 1).trim()
        let where_at = find_option(c.sections[section], key)
        if where_at >= 0 {
            c.sections[section].options[where_at].value = value
            c.sections[section].options[where_at].bare = false
            option = where_at
        } else {
            c.sections[section].options.push(Setting{ key: key, value: value,
                bare: false })
            option = c.sections[section].options.len() - 1
        }
    }
    return c
}

/// The names of every section but `DEFAULT`, which is not one.
pub fn sections(c: Config) -> [str] {
    var out: [str] = []
    for s in c.sections {
        if s.name != DEFAULT_SECTION {
            out.push(s.name)
        }
    }
    return out
}

fn raw_lookup(c: Config, section: str, key: str) -> Option[str] {
    let at = find_section(c, section)
    if at < 0 and section != DEFAULT_SECTION {
        // A section that is not in the file inherits nothing: `DEFAULT` gives
        // its keys to the sections that exist, not to any name asked for.
        return None
    }
    if at >= 0 {
        let where_at = find_option(c.sections[at], key)
        if where_at >= 0 {
            return Some(c.sections[at].options[where_at].value)
        }
    }
    // Every section inherits from `DEFAULT`, which is the whole point of it.
    let fallback = find_section(c, DEFAULT_SECTION)
    if fallback >= 0 and section != DEFAULT_SECTION {
        let where_at = find_option(c.sections[fallback], key)
        if where_at >= 0 {
            return Some(c.sections[fallback].options[where_at].value)
        }
    }
    return None
}

/// The raw text of a value, with nothing expanded.
pub fn raw(c: Config, section: str, key: str) -> Option[str] {
    return raw_lookup(c, section, key.to_lower())
}

fn expand(c: Config, section: str, key: str, text: str,
    depth: i64) -> str ! ConfigError {
    if depth > 10 {
        fail(BadInterpolation(section, key, "the value refers to itself"))
    }
    var out = ""
    let chars = text.chars()
    var i = 0
    while i < chars.len() {
        if c.extended and chars[i] == "$" and i + 1 < chars.len() and
        chars[i + 1] == "\{" {
            var close = i + 2
            while close < chars.len() and chars[close] != "\}" {
                close = close + 1
            }
            if close >= chars.len() {
                fail(BadInterpolation(section, key, "an unclosed $\{"))
            }
            var name = ""
            var k = i + 2
            while k < close {
                name = name + chars[k]
                k = k + 1
            }
            var from = section
            var want = name
            let colon = name.index_of(":") ?? -1
            if colon >= 0 {
                from = name.substr(0, colon)
                want = name.substr(colon + 1, name.len() - colon - 1)
            }
            match raw_lookup(c, from, want.to_lower()) {
                Some(found) -> out = out + (try expand(c, from, want, found,
                    depth + 1))
                None -> fail(BadInterpolation(section, key,
                    "there is no `" + name + "`"))
            }
            i = close + 1
        } else if not c.extended and chars[i] == "%" and i + 1 < chars.len() {
            if chars[i + 1] == "%" {
                out = out + "%"
                i = i + 2
                continue
            }
            if chars[i + 1] != "(" {
                fail(BadInterpolation(section, key,
                    "a `%` that starts nothing"))
            }
            var close = i + 2
            while close < chars.len() and chars[close] != ")" {
                close = close + 1
            }
            if close + 1 >= chars.len() or chars[close + 1] != "s" {
                fail(BadInterpolation(section, key, "a `%(` without `)s`"))
            }
            var name = ""
            var k = i + 2
            while k < close {
                name = name + chars[k]
                k = k + 1
            }
            match raw_lookup(c, section, name.to_lower()) {
                Some(found) -> out = out + (try expand(c, section, name,
                    found, depth + 1))
                None -> fail(BadInterpolation(section, key,
                    "there is no `" + name + "`"))
            }
            i = close + 2
        } else {
            out = out + chars[i]
            i = i + 1
        }
    }
    return out
}

/// A value, interpolated.
//
// A missing section and a missing option are different refusals, as they are
// in Python: one means the file is not the file you thought, the other that a
// key you expected was left out.
pub fn get(c: Config, section: str, key: str) -> str ! ConfigError {
    match raw_lookup(c, section, key.to_lower()) {
        Some(found) -> return try expand(c, section, key, found, 0)
        None -> {
            if find_section(c, section) < 0 and section != DEFAULT_SECTION {
                fail(NoSection(section))
            }
            fail(NoOption(section, key))
        }
    }
}

/// Whether a section has a key — its own or `DEFAULT`'s.
pub fn has(c: Config, section: str, key: str) -> bool {
    return raw_lookup(c, section, key.to_lower()) != None
}

/// Every key a section answers to, its own first and then `DEFAULT`'s.
pub fn keys(c: Config, section: str) -> [str] {
    var out: [str] = []
    if section == DEFAULT_SECTION {
        // `DEFAULT` is not a section, so it has no listing of its own — the
        // same answer `has_section` gives for it.
        return out
    }
    let at = find_section(c, section)
    if at < 0 {
        return out
    }
    if at >= 0 {
        for o in c.sections[at].options {
            out.push(o.key)
        }
    }
    let fallback = find_section(c, DEFAULT_SECTION)
    if fallback >= 0 and section != DEFAULT_SECTION {
        for o in c.sections[fallback].options {
            var already = false
            for name in out {
                if name == o.key {
                    already = true
                }
            }
            if not already {
                out.push(o.key)
            }
        }
    }
    return out
}

/// The eight words Python treats as booleans, and nothing else.
pub fn as_bool(text: str) -> Option[bool] {
    let t = text.to_lower()
    if t == "1" or t == "yes" or t == "true" or t == "on" {
        return Some(true)
    }
    if t == "0" or t == "no" or t == "false" or t == "off" {
        return Some(false)
    }
    return None
}

/// The file written back out, in the order it was read.
pub fn write(c: Config) -> str {
    var out = ""
    for s in c.sections {
        out = out + "[" + s.name + "]\n"
        for o in s.options {
            if o.bare {
                out = out + o.key + "\n"
            } else {
                out = out + o.key + " = " +
                o.value.split("\n").join("\n\t") + "\n"
            }
        }
        out = out + "\n"
    }
    return out
}

/// What went wrong, for a person.
pub fn message_of(e: ConfigError) -> str {
    match e {
        MissingSectionHeader(line, _text) -> {
            return "line {line}: a value outside any section"
        }
        DuplicateSection(line, name) -> {
            return "line {line}: the section `" + name + "` appears twice"
        }
        DuplicateOption(line, section, name) -> {
            return "line {line}: `" + name + "` appears twice in `" +
            section + "`"
        }
        NoValue(line, name) -> {
            return "line {line}: `" + name + "` has no value"
        }
        BadInterpolation(section, option, why) -> {
            return "in [" + section + "] " + option + ": " + why
        }
        NoSection(name) -> {
            return "there is no section [" + name + "]"
        }
        NoOption(section, name) -> {
            return "[" + section + "] has no `" + name + "`"
        }
    }
}
