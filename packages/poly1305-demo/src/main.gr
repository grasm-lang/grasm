// Poly1305 against RFC 8439's vectors, including the edge cases in appendix
// A.3 — which exist because they are the ones implementations get wrong.
import bytes_codec
import poly1305

fn hex(h: str) -> bytes {
    bytes_codec.decode_hex(h) ?? bytes_of([])
}

fn check(label: str, key: str, msg: bytes, want: str) {
    let got = bytes_codec.encode_hex(poly1305.tag(hex(key), msg))
    let mark = if got == want { "ok   " } else { "WRONG" }
    print("  {mark} {label}")
    if got != want {
        print("        got  {got}")
        print("        want {want}")
    }
}

fn zeros(n: i64) -> bytes {
    var out: [i64] = []
    for _i in 0..n {
        out.push(0)
    }
    bytes_of(out)
}

fn main() {
    print("-- RFC 8439 section 2.5.2")
    check("the cryptographic forum paragraph",
        "85d6be7857556d337f4452fe42d506a80103808afb0db2fd4abff6af4149f51b",
        "Cryptographic Forum Research Group".to_bytes(),
        "a8061dc1305136c6c22b8baf0c0127a9")

    print("-- appendix A.3, the cases that catch a broken carry chain")
    check("a zero key, a zero message", "0".repeat(64), zeros(64),
        "00000000000000000000000000000000")
    check("A.3 #2 — r is zero, s is the answer",
        "0000000000000000000000000000000036e5f6b5c5e06070f0efca96227a863e",
        ("Any submission to the IETF intended by the Contributor for publication as all or part of an IETF Internet-Draft or RFC and any statement made within the context of an IETF activity is considered an \"IETF Contribution\". Such statements include oral statements in IETF sessions, as well as written and electronic communications made at any time or place, which are addressed to").to_bytes(),
        "36e5f6b5c5e06070f0efca96227a863e")

    print("-- verification, and its failure")
    let key = hex("85d6be7857556d337f4452fe42d506a80103808afb0db2fd4abff6af4149f51b")
    let msg = "Cryptographic Forum Research Group".to_bytes()
    let good = poly1305.tag(key, msg)
    print("  the right tag:            {poly1305.verify(key, msg, good)}")
    var bad = good.to_list()
    bad[0] = bad[0].bit_xor(1)
    print("  one bit changed:          {poly1305.verify(key, msg, bytes_of(bad))}")
    print("  a different message:      {poly1305.verify(key, "another message".to_bytes(), good)}")
    print("  a truncated tag:          {poly1305.verify(key, msg, bytes_of([1, 2, 3]))}")

    print("-- lengths around the block boundary")
    for n in [0, 1, 15, 16, 17, 31, 32, 33, 63, 64] {
        var body: [i64] = []
        for i in 0..n {
            body.push(i % 256)
        }
        let t = poly1305.tag(key, bytes_of(body))
        print("  {"{n}".pad_start(3, " ")} bytes -> {bytes_codec.encode_hex(t)}")
    }
}
