// Java's `Integer` and `Long` conversions between numbers and text, as
// Java 17 does them: `parseInt`, `parseLong`, `parseUnsignedInt`,
// `parseUnsignedLong`, `decode`, `toString(n, radix)`,
// `toUnsignedString`, `toHexString`, `toOctalString`, `toBinaryString`.
//
// Configuration values, protocol fields and command-line options in Java
// programs go through these, and a peer has to accept and refuse the same
// text with the same messages:
//
//   - A digit is whatever `Character.digit` takes: ASCII, any decimal
//     digit in the Basic Multilingual Plane (Arabic-Indic, Devanagari,
//     fullwidth...) and fullwidth Latin letters, so `parseInt("١٢٣")` is
//     123. The table comes from Java 17 itself.
//   - `parseInt` and `parseLong` take one optional sign; errors read `For
//     input string: "12x"` (with ` under radix 16` when the radix is not
//     10), or name a radix outside 2..36.
//   - The unsigned parsers refuse a minus sign by name, pass short text to
//     the signed parser, and report `String value ... exceeds range of
//     unsigned int.`; `parseUnsignedLong` reads all but the last digit
//     with the index-reporting parser (`Error at index 3 in: "..."`).
//   - `decode` takes `0x`, `0X`, `#` and a leading `0` (octal), one sign,
//     and retries with the sign attached so MIN_VALUE decodes.
//   - Printing with a radix outside 2..36 prints in base 10.
//
// Values are i64; for `int` results they are within the int range, and an
// unsigned 64-bit result is its bit pattern.

/// NumberFormatException, with Java's message.
type JavaNumberError = | JavaNumberError(msg: str)

pub fn error_text(e: JavaNumberError) -> str {
    return match e {
        JavaNumberError(m) -> m
    }
}

/// The characters `Character.digit(c, 36)` gives a value, as first-last
/// pairs with the first one's value; generated by running Java 17.
fn digit_ranges() -> [i64] {
    return [
        48, 57, 0, 65, 90, 10, 97, 122, 10, 1632, 1641, 0, 1776, 1785, 0, 1984, 1993, 0, 2406, 2415, 0, 2534, 2543, 0, 2662, 2671, 0, 2790, 2799, 0,
        2918, 2927, 0, 3046, 3055, 0, 3174, 3183, 0, 3302, 3311, 0, 3430, 3439, 0, 3558, 3567, 0, 3664, 3673, 0, 3792, 3801, 0, 3872, 3881, 0, 4160,
        4169, 0, 4240, 4249, 0, 6112, 6121, 0, 6160, 6169, 0, 6470, 6479, 0, 6608, 6617, 0, 6784, 6793, 0, 6800, 6809, 0, 6992, 7001, 0, 7088, 7097,
        0, 7232, 7241, 0, 7248, 7257, 0, 42528, 42537, 0, 43216, 43225, 0, 43264, 43273, 0, 43472, 43481, 0, 43504, 43513, 0, 43600, 43609, 0, 44016,
        44025, 0, 65296, 65305, 0, 65313, 65338, 10, 65345, 65370, 10
    ]
}

/// `Character.digit(c, radix)` for a UTF-16 unit.
fn digit(c: i64, radix: i64, table: [i64]) -> i64 {
    var k = 0
    while k < table.len() {
        if c >= table[k] and c <= table[k + 1] {
            let v = table[k + 2] + c - table[k]
            return if v < radix { v } else { 0 - 1 }
        }
        k = k + 3
    }
    return 0 - 1
}

fn units(s: str) -> [i64] {
    var out: [i64] = []
    for c in s.codes() {
        if c >= 65536 {
            out.push(55296 + (c - 65536).shr(10))
            out.push(56320 + (c - 65536).bit_and(1023))
        } else {
            out.push(c)
        }
    }
    return out
}

fn input_error(s: str, radix: i64) -> JavaNumberError {
    return JavaNumberError("For input string: \"" + s + "\"" + (if radix == 10 { "" } else { " under radix " + radix.to_str() }))
}

fn check_radix(radix: i64) ! JavaNumberError {
    if radix < 2 {
        fail(JavaNumberError("radix " + radix.to_str() + " less than Character.MIN_RADIX"))
    }
    if radix > 36 {
        fail(JavaNumberError("radix " + radix.to_str() + " greater than Character.MAX_RADIX"))
    }
}

fn min_of(bits: i64) -> i64 {
    return if bits == 32 { 0 - 2147483648 } else { 0 - 9223372036854775807 - 1 }
}

/// The signed parse, accumulating negatively as Java does: the value, or
/// the index of the unit that fails it.
fn accumulate(u: [i64], from: i64, to: i64, radix: i64, bits: i64) -> (i64, i64) {
    var i = from
    var negative = false
    var limit = 0 - (if bits == 32 { 2147483647 } else { 9223372036854775807 })
    if i < to and u[i] < 48 {
        if u[i] == 45 {
            negative = true
            limit = min_of(bits)
        } else if u[i] != 43 {
            return (0, i)
        }
        i = i + 1
        if i >= to {
            return (0, i)
        }
    }
    let table = digit_ranges()
    let multmin = limit / radix
    var result = 0
    while i < to {
        let d = digit(u[i], radix, table)
        if d < 0 or result < multmin {
            return (0, i)
        }
        result = result * radix
        if result < limit + d {
            return (0, i)
        }
        result = result - d
        i = i + 1
    }
    return (if negative { result } else { 0 - result }, 0 - 1)
}

fn parse_signed(s: str, radix: i64, bits: i64) -> i64 ! JavaNumberError {
    try check_radix(radix)
    let u = units(s)
    if u.len() == 0 {
        fail(input_error(s, radix))
    }
    let (v, bad) = accumulate(u, 0, u.len(), radix, bits)
    if bad >= 0 {
        fail(input_error(s, radix))
    }
    return v
}

/// `Integer.parseInt(s, radix)`.
pub fn parse_int(s: str, radix: i64) -> i64 ! JavaNumberError {
    return try parse_signed(s, radix, 32)
}

/// `Long.parseLong(s, radix)`.
pub fn parse_long(s: str, radix: i64) -> i64 ! JavaNumberError {
    return try parse_signed(s, radix, 64)
}

/// `Integer.parseUnsignedInt(s, radix)`: the int's bits (negative past
/// Integer.MAX_VALUE), as Java returns them.
pub fn parse_unsigned_int(s: str, radix: i64) -> i64 ! JavaNumberError {
    let u = units(s)
    if u.len() == 0 {
        fail(input_error(s, radix))
    }
    if u[0] == 45 {
        fail(JavaNumberError("Illegal leading minus sign on unsigned string " + s + "."))
    }
    if u.len() <= 5 or (radix == 10 and u.len() <= 9) {
        return try parse_int(s, radix)
    }
    let v = try parse_long(s, radix)
    if v < 0 or v > 4294967295 {
        fail(JavaNumberError("String value " + s + " exceeds range of unsigned int."))
    }
    return wrap32(v)
}

/// `Long.parseUnsignedLong(s, radix)`: the 64 bits.
pub fn parse_unsigned_long(s: str, radix: i64) -> i64 ! JavaNumberError {
    let u = units(s)
    if u.len() == 0 {
        fail(input_error(s, radix))
    }
    if u[0] == 45 {
        fail(JavaNumberError("Illegal leading minus sign on unsigned string " + s + "."))
    }
    if u.len() <= 12 or (radix == 10 and u.len() <= 18) {
        return try parse_long(s, radix)
    }
    try check_radix(radix)
    let (first, bad) = accumulate(u, 0, u.len() - 1, radix, 64)
    if bad >= 0 {
        let shown = text_of(u.slice(0, u.len() - 1))
        fail(JavaNumberError("Error at index " + bad.to_str() + " in: \"" + shown + "\""))
    }
    let second = digit(u[u.len() - 1], radix, digit_ranges())
    if second < 0 {
        fail(JavaNumberError("Bad digit at end of " + s))
    }
    let result = first * radix + second
    let guard = radix * first.ushr(57)
    if guard >= 128 or (result >= 0 and guard >= 128 - 36) {
        fail(JavaNumberError("String value " + s + " exceeds range of unsigned long."))
    }
    return result
}

fn text_of(u: [i64]) -> str {
    var out: [i64] = []
    var i = 0
    while i < u.len() {
        let c = u[i]
        if c >= 55296 and c <= 56319 and i + 1 < u.len() and u[i + 1] >= 56320 and u[i + 1] <= 57343 {
            out.push(65536 + (c - 55296).shl(10) + u[i + 1] - 56320)
            i = i + 2
        } else {
            out.push(if c >= 55296 and c <= 57343 { 65533 } else { c })
            i = i + 1
        }
    }
    return out.map(|c| c.to_char()).join("")
}

fn decode(nm: str, bits: i64) -> i64 ! JavaNumberError {
    let u = units(nm)
    if u.len() == 0 {
        fail(JavaNumberError("Zero length string"))
    }
    var index = 0
    var radix = 10
    let negative = u[0] == 45
    if u[0] == 45 or u[0] == 43 {
        index = 1
    }
    if unit(u, index) == 48 and (unit(u, index + 1) == 120 or unit(u, index + 1) == 88) {
        index = index + 2
        radix = 16
    } else if unit(u, index) == 35 {
        index = index + 1
        radix = 16
    } else if unit(u, index) == 48 and u.len() > 1 + index {
        index = index + 1
        radix = 8
    }
    if unit(u, index) == 45 or unit(u, index) == 43 {
        fail(JavaNumberError("Sign character in wrong position"))
    }
    let rest = text_of(u.slice(index, u.len()))
    return match parse_signed(rest, radix, bits) {
        Ok(v) -> if negative { if bits == 32 { wrap32(0 - v) } else { 0 - v } } else { v }
        Err(_e) -> try parse_signed(if negative { "-" + rest } else { rest }, radix, bits)
    }
}

fn unit(u: [i64], k: i64) -> i64 {
    return if k < u.len() { u[k] } else { 0 - 1 }
}

fn wrap32(v: i64) -> i64 {
    let low = v.bit_and(4294967295)
    return if low >= 2147483648 { low - 4294967296 } else { low }
}

/// `Integer.decode(nm)`.
pub fn decode_int(nm: str) -> i64 ! JavaNumberError {
    return try decode(nm, 32)
}

/// `Long.decode(nm)`.
pub fn decode_long(nm: str) -> i64 ! JavaNumberError {
    return try decode(nm, 64)
}

fn digits_of(v0: i64, radix: i64) -> str {
    let digits = "0123456789abcdefghijklmnopqrstuvwxyz"
    var rev: [i64] = []
    var v = v0
    while true {
        let (q, r) = udivmod(v, radix)
        rev.push(digits.code_at(r))
        v = q
        if v == 0 {
            break
        }
    }
    var out = ""
    var k = rev.len() - 1
    while k >= 0 {
        out = out + rev[k].to_char()
        k = k - 1
    }
    return out
}

/// Unsigned 64-bit division by a small radix.
fn udivmod(u: i64, b: i64) -> (i64, i64) {
    if u >= 0 {
        return (u / b, u % b)
    }
    var q = (u.ushr(1) / b).shl(1)
    var r = u - q * b
    while r >= b {
        q = q + 1
        r = r - b
    }
    return (q, r)
}

fn clamp_radix(radix: i64) -> i64 {
    return if radix < 2 or radix > 36 { 10 } else { radix }
}

/// `Integer.toString(i, radix)` and `Long.toString(i, radix)`.
pub fn to_string(i: i64, radix: i64) -> str {
    let r = clamp_radix(radix)
    if i < 0 {
        let magnitude = 0 - i
        return "-" + digits_of(magnitude, r)
    }
    return digits_of(i, r)
}

/// `Integer.toUnsignedString(i, radix)` (`bits` 32) and
/// `Long.toUnsignedString(i, radix)` (`bits` 64).
pub fn to_unsigned_string(i: i64, radix: i64, bits: i64) -> str {
    let v = if bits == 32 { i.bit_and(4294967295) } else { i }
    return digits_of(v, clamp_radix(radix))
}

pub fn to_hex_string(i: i64, bits: i64) -> str {
    return to_unsigned_string(i, 16, bits)
}

pub fn to_octal_string(i: i64, bits: i64) -> str {
    return to_unsigned_string(i, 8, bits)
}

pub fn to_binary_string(i: i64, bits: i64) -> str {
    return to_unsigned_string(i, 2, bits)
}
