// Python's `str` methods, as CPython 3.13 runs them on Unicode text:
// splitting, stripping, padding, searching, replacing and changing case.
//
// Code that has to produce the same strings as a Python program -- a
// port, a formatter, a tool that reads what a Python script wrote -- needs
// Python's rules, and they are not the obvious ones:
//
//   - `split()` with no separator splits on runs of Unicode whitespace
//     (`isspace`, which includes U+001C..U+001F and U+0085) and drops
//     empty pieces; with a separator it keeps them, and `maxsplit` leaves
//     the rest whole (`rsplit` counts from the right). `splitlines` breaks
//     at `\n`, `\r`, `\r\n`, `\v`, `\f`, U+001C..U+001E, U+0085, U+2028
//     and U+2029.
//   - `strip()` removes Unicode whitespace; `strip(chars)` any of the
//     characters given. `expandtabs` counts columns in code points and
//     restarts only after `\n` and `\r`.
//   - `center` puts the odd space on the left when the width is odd
//     (`marg // 2 + (marg & width & 1)`); `zfill` keeps a leading `+` or
//     `-` in front.
//   - `find`, `rfind`, `index`, `rindex`, `count`, `startswith` and
//     `endswith` take `start` and `end` as slice bounds, negative ones
//     counted from the end, and an empty substring is found where the
//     slice allows (`"abc".find("", 3)` is 3, `.find("", 4)` is -1).
//     `replace` with an empty `old` inserts between characters.
//   - `upper`, `lower`, `title`, `capitalize` and `swapcase` use full case
//     mappings (`ß` uppercases to `SS`, `ﬁ` titlecases to `Fi`, `İ`
//     lowercases to `i̇`), and a capital sigma lowercases to `ς` at the
//     end of a word, read through case-ignorable characters, as CPython
//     reads it. `title` starts a word after any character that is not
//     cased, so `"they're"` becomes `"They'Re"`; `capitalize` titlecases
//     the first character (since 3.8) and lowercases the rest.
//
// The predicates (`isalpha`, `isdigit`, `isspace`, `isidentifier`, ...)
// are `pycharclass`'s, which this uses for whitespace.
//
// The case tables at the end are generated from CPython 3.13's own str
// methods (Unicode 15.1) by gen_tables.py. Python strings may hold lone
// surrogates; Grasm text cannot, so they are outside this.

import pycharclass

/// Python's exception: ValueError or TypeError, with its message.
type PyStrError = | PyStrValueError(msg: str) | PyStrTypeError(msg: str)

pub fn error_class(e: PyStrError) -> str {
    return match e {
        PyStrValueError(_m) -> "ValueError"
        PyStrTypeError(_m) -> "TypeError"
    }
}

pub fn error_text(e: PyStrError) -> str {
    return match e {
        PyStrValueError(m) -> m
        PyStrTypeError(m) -> m
    }
}

fn from_codes(cs: [i64]) -> str {
    return cs.map(|c| c.to_char()).join("")
}

fn sub_codes(cs: [i64], a: i64, b: i64) -> str {
    return from_codes(cs.slice(a, b))
}

fn is_space(c: i64) -> bool {
    return pycharclass.is_space(c)
}

/// `Py_UNICODE_ISLINEBREAK`.
pub fn is_line_break(c: i64) -> bool {
    return (c >= 10 and c <= 13) or (c >= 28 and c <= 30) or c == 133 or c == 8232 or c == 8233
}

// ---- splitting

fn empty_separator() -> PyStrError {
    return PyStrValueError("empty separator")
}

/// Whether the code points of `sep` start at `cs[i]`.
fn match_at(cs: [i64], i: i64, sep: [i64]) -> bool {
    if i < 0 or i + sep.len() > cs.len() {
        return false
    }
    for k in 0..sep.len() {
        if cs[i + k] != sep[k] {
            return false
        }
    }
    return true
}

/// The first match of `sep` in `cs[lo..hi]` at or after `lo`, or -1.
fn find_in(cs: [i64], sep: [i64], lo: i64, hi: i64) -> i64 {
    var i = lo
    while i + sep.len() <= hi {
        if match_at(cs, i, sep) {
            return i
        }
        i = i + 1
    }
    return 0 - 1
}

/// The last match of `sep` lying wholly in `cs[lo..hi]`, or -1.
fn rfind_in(cs: [i64], sep: [i64], lo: i64, hi: i64) -> i64 {
    var i = hi - sep.len()
    while i >= lo {
        if match_at(cs, i, sep) {
            return i
        }
        i = i - 1
    }
    return 0 - 1
}

fn split_whitespace(cs: [i64], maxsplit: i64) -> [str] {
    var out: [str] = []
    var left = if maxsplit < 0 { cs.len() + 1 } else { maxsplit }
    var i = 0
    let n = cs.len()
    while left > 0 {
        left = left - 1
        while i < n and is_space(cs[i]) {
            i = i + 1
        }
        if i == n {
            break
        }
        let j = i
        i = i + 1
        while i < n and not is_space(cs[i]) {
            i = i + 1
        }
        out.push(sub_codes(cs, j, i))
    }
    if i < n {
        while i < n and is_space(cs[i]) {
            i = i + 1
        }
        if i != n {
            out.push(sub_codes(cs, i, n))
        }
    }
    return out
}

/// `s.split(sep, maxsplit)`; None splits on whitespace.
pub fn split(s: str, sep: Option[str], maxsplit: i64) -> [str] ! PyStrError {
    let cs = s.codes()
    let sp = match sep {
        None -> return split_whitespace(cs, maxsplit)
        Some(t) -> t.codes()
    }
    if sp.len() == 0 {
        fail(empty_separator())
    }
    var out: [str] = []
    var left = if maxsplit < 0 { cs.len() + 1 } else { maxsplit }
    var i = 0
    while left > 0 {
        left = left - 1
        let pos = find_in(cs, sp, i, cs.len())
        if pos < 0 {
            break
        }
        out.push(sub_codes(cs, i, pos))
        i = pos + sp.len()
    }
    out.push(sub_codes(cs, i, cs.len()))
    return out
}

fn rsplit_whitespace(cs: [i64], maxsplit: i64) -> [str] {
    var out: [str] = []
    var left = if maxsplit < 0 { cs.len() + 1 } else { maxsplit }
    var i = cs.len() - 1
    while left > 0 {
        left = left - 1
        while i >= 0 and is_space(cs[i]) {
            i = i - 1
        }
        if i < 0 {
            break
        }
        let j = i
        i = i - 1
        while i >= 0 and not is_space(cs[i]) {
            i = i - 1
        }
        out.push(sub_codes(cs, i + 1, j + 1))
    }
    if i >= 0 {
        while i >= 0 and is_space(cs[i]) {
            i = i - 1
        }
        if i >= 0 {
            out.push(sub_codes(cs, 0, i + 1))
        }
    }
    return out.rev()
}

/// `s.rsplit(sep, maxsplit)`.
pub fn rsplit(s: str, sep: Option[str], maxsplit: i64) -> [str] ! PyStrError {
    let cs = s.codes()
    let sp = match sep {
        None -> return rsplit_whitespace(cs, maxsplit)
        Some(t) -> t.codes()
    }
    if sp.len() == 0 {
        fail(empty_separator())
    }
    var out: [str] = []
    var left = if maxsplit < 0 { cs.len() + 1 } else { maxsplit }
    var j = cs.len()
    while left > 0 {
        left = left - 1
        let pos = rfind_in(cs, sp, 0, j)
        if pos < 0 {
            break
        }
        out.push(sub_codes(cs, pos + sp.len(), j))
        j = pos
    }
    out.push(sub_codes(cs, 0, j))
    return out.rev()
}

/// `s.splitlines(keepends)`.
pub fn splitlines(s: str, keepends: bool) -> [str] {
    let cs = s.codes()
    let n = cs.len()
    var out: [str] = []
    var i = 0
    var j = 0
    while i < n {
        while i < n and not is_line_break(cs[i]) {
            i = i + 1
        }
        var eol = i
        if i < n {
            if cs[i] == 13 and i + 1 < n and cs[i + 1] == 10 {
                i = i + 2
            } else {
                i = i + 1
            }
            if keepends {
                eol = i
            }
        }
        out.push(sub_codes(cs, j, eol))
        j = i
    }
    return out
}

/// `s.partition(sep)`.
pub fn partition(s: str, sep: str) -> (str, str, str) ! PyStrError {
    let cs = s.codes()
    let sp = sep.codes()
    if sp.len() == 0 {
        fail(empty_separator())
    }
    let pos = find_in(cs, sp, 0, cs.len())
    if pos < 0 {
        return (s, "", "")
    }
    return (sub_codes(cs, 0, pos), sep, sub_codes(cs, pos + sp.len(), cs.len()))
}

/// `s.rpartition(sep)`.
pub fn rpartition(s: str, sep: str) -> (str, str, str) ! PyStrError {
    let cs = s.codes()
    let sp = sep.codes()
    if sp.len() == 0 {
        fail(empty_separator())
    }
    let pos = rfind_in(cs, sp, 0, cs.len())
    if pos < 0 {
        return ("", "", s)
    }
    return (sub_codes(cs, 0, pos), sep, sub_codes(cs, pos + sp.len(), cs.len()))
}

// ---- stripping and padding

fn strippable(c: i64, chars: Option[[i64]]) -> bool {
    return match chars {
        None -> is_space(c)
        Some(set) -> set.contains(c)
    }
}

fn strip_codes(s: str, chars: Option[str], left: bool, right: bool) -> str {
    let cs = s.codes()
    let set = match chars {
        Some(t) -> Some(t.codes())
        None -> None
    }
    var a = 0
    var b = cs.len()
    if left {
        while a < b and strippable(cs[a], set) {
            a = a + 1
        }
    }
    if right {
        while b > a and strippable(cs[b - 1], set) {
            b = b - 1
        }
    }
    return sub_codes(cs, a, b)
}

/// `s.strip(chars)`; None strips whitespace.
pub fn strip(s: str, chars: Option[str]) -> str {
    return strip_codes(s, chars, true, true)
}

pub fn lstrip(s: str, chars: Option[str]) -> str {
    return strip_codes(s, chars, true, false)
}

pub fn rstrip(s: str, chars: Option[str]) -> str {
    return strip_codes(s, chars, false, true)
}

/// `s.expandtabs(tabsize)`.
pub fn expandtabs(s: str, tabsize: i64) -> str {
    var out: [str] = []
    var col = 0
    for c in s.codes() {
        if c == 9 {
            if tabsize > 0 {
                let incr = tabsize - col % tabsize
                col = col + incr
                out.push(" ".repeat(incr))
            }
        } else {
            col = col + 1
            out.push(c.to_char())
            if c == 10 or c == 13 {
                col = 0
            }
        }
    }
    return out.join("")
}

fn fill_char(fill: str) -> str ! PyStrError {
    if fill.len() != 1 {
        fail(PyStrTypeError("The fill character must be exactly one character long"))
    }
    return fill
}

/// `s.center(width, fillchar)`.
pub fn center(s: str, width: i64, fillchar: str) -> str ! PyStrError {
    let f = try fill_char(fillchar)
    let n = s.len()
    if n >= width {
        return s
    }
    let marg = width - n
    let left = marg / 2 + marg.bit_and(width).bit_and(1)
    return f.repeat(left) + s + f.repeat(marg - left)
}

/// `s.ljust(width, fillchar)`.
pub fn ljust(s: str, width: i64, fillchar: str) -> str ! PyStrError {
    let f = try fill_char(fillchar)
    if s.len() >= width {
        return s
    }
    return s + f.repeat(width - s.len())
}

/// `s.rjust(width, fillchar)`.
pub fn rjust(s: str, width: i64, fillchar: str) -> str ! PyStrError {
    let f = try fill_char(fillchar)
    if s.len() >= width {
        return s
    }
    return f.repeat(width - s.len()) + s
}

/// `s.zfill(width)`.
pub fn zfill(s: str, width: i64) -> str {
    let n = s.len()
    if n >= width {
        return s
    }
    let pad = "0".repeat(width - n)
    if n > 0 and (s.code_at(0) == 43 or s.code_at(0) == 45) {
        return s.substr(0, 1) + pad + s.substr(1, n - 1)
    }
    return pad + s
}

// ---- searching

/// `ADJUST_INDICES`: slice bounds as Python clamps them.
fn adjust(start: Option[i64], end: Option[i64], n: i64) -> (i64, i64) {
    var a = start ?? 0
    var b = end ?? n
    if b > n {
        b = n
    } else if b < 0 {
        b = b + n
        if b < 0 {
            b = 0
        }
    }
    if a < 0 {
        a = a + n
        if a < 0 {
            a = 0
        }
    }
    return (a, b)
}

/// `s.find(sub, start, end)`: -1 when absent.
pub fn find(s: str, sub: str, start: Option[i64], end: Option[i64]) -> i64 {
    let cs = s.codes()
    let sp = sub.codes()
    let r = adjust(start, end, cs.len())
    if r.1 - r.0 < sp.len() {
        return 0 - 1
    }
    return find_in(cs, sp, r.0, r.1)
}

/// `s.rfind(sub, start, end)`.
pub fn rfind(s: str, sub: str, start: Option[i64], end: Option[i64]) -> i64 {
    let cs = s.codes()
    let sp = sub.codes()
    let r = adjust(start, end, cs.len())
    if r.1 - r.0 < sp.len() {
        return 0 - 1
    }
    return rfind_in(cs, sp, r.0, r.1)
}

/// `s.index(sub, start, end)`.
pub fn index(s: str, sub: str, start: Option[i64], end: Option[i64]) -> i64 ! PyStrError {
    let i = find(s, sub, start, end)
    if i < 0 {
        fail(PyStrValueError("substring not found"))
    }
    return i
}

/// `s.rindex(sub, start, end)`.
pub fn rindex(s: str, sub: str, start: Option[i64], end: Option[i64]) -> i64 ! PyStrError {
    let i = rfind(s, sub, start, end)
    if i < 0 {
        fail(PyStrValueError("substring not found"))
    }
    return i
}

/// `s.count(sub, start, end)`: matches that do not overlap.
pub fn count(s: str, sub: str, start: Option[i64], end: Option[i64]) -> i64 {
    let cs = s.codes()
    let sp = sub.codes()
    let r = adjust(start, end, cs.len())
    if r.1 - r.0 < sp.len() {
        return 0
    }
    if sp.len() == 0 {
        return r.1 - r.0 + 1
    }
    var n = 0
    var i = r.0
    while i + sp.len() <= r.1 {
        if match_at(cs, i, sp) {
            n = n + 1
            i = i + sp.len()
        } else {
            i = i + 1
        }
    }
    return n
}

fn tail_match(s: str, sub: str, start: Option[i64], end: Option[i64], at_end: bool) -> bool {
    let cs = s.codes()
    let sp = sub.codes()
    let r = adjust(start, end, cs.len())
    let last = r.1 - sp.len()
    if last < r.0 {
        return false
    }
    return match_at(cs, if at_end { last } else { r.0 }, sp)
}

/// `s.startswith(prefix, start, end)`.
pub fn startswith(s: str, prefix: str, start: Option[i64], end: Option[i64]) -> bool {
    return tail_match(s, prefix, start, end, false)
}

/// `s.endswith(suffix, start, end)`.
pub fn endswith(s: str, suffix: str, start: Option[i64], end: Option[i64]) -> bool {
    return tail_match(s, suffix, start, end, true)
}

/// `s.replace(old, new, count)`; a negative count replaces every match.
pub fn replace(s: str, old: str, new: str, count: i64) -> str {
    let cs = s.codes()
    let op = old.codes()
    var left = if count < 0 { cs.len() + 1 } else { count }
    var out: [str] = []
    var i = 0
    if op.len() == 0 {
        while i <= cs.len() {
            if left > 0 {
                out.push(new)
                left = left - 1
            }
            if i < cs.len() {
                out.push(cs[i].to_char())
            }
            i = i + 1
        }
        return out.join("")
    }
    while i < cs.len() {
        if left > 0 and match_at(cs, i, op) {
            out.push(new)
            left = left - 1
            i = i + op.len()
        } else {
            out.push(cs[i].to_char())
            i = i + 1
        }
    }
    return out.join("")
}

// ---- case

/// The run in a table of four-number runs that holds `cp`: its delta, or 0.
fn run_delta(runs: [i64], cp: i64) -> i64 {
    var lo = 0
    var hi = runs.len() / 4 - 1
    if hi < 0 or cp < runs[0] {
        return 0
    }
    while lo < hi {
        let mid = (lo + hi + 1) / 2
        if runs[mid * 4] <= cp {
            lo = mid
        } else {
            hi = mid - 1
        }
    }
    let at = lo * 4
    if cp > runs[at + 1] or (cp - runs[at]) % runs[at + 2] != 0 {
        return 0
    }
    return runs[at + 3]
}

/// A mapping longer than one character, or an empty list.
fn special(cp: i64, kind: i64) -> [i64] {
    let t = PYSTR_SPECIAL
    let key = cp * 4 + kind
    var lo = 0
    var hi = t.len() / 5 - 1
    while lo <= hi {
        let mid = (lo + hi) / 2
        let k = t[mid * 5]
        if k == key {
            return t.slice(mid * 5 + 2, mid * 5 + 2 + t[mid * 5 + 1])
        }
        if k < key {
            lo = mid + 1
        } else {
            hi = mid - 1
        }
    }
    return []
}

fn props(cp: i64) -> i64 {
    let starts = PYSTR_PROP_STARTS
    var lo = 0
    var hi = starts.len() - 1
    while lo < hi {
        let mid = (lo + hi + 1) / 2
        if starts[mid] <= cp {
            lo = mid
        } else {
            hi = mid - 1
        }
    }
    return PYSTR_PROP_VALUES[lo]
}

/// Unicode's Cased property, as CPython's `_PyUnicode_IsCased`.
pub fn is_cased(cp: i64) -> bool {
    return props(cp).bit_and(1) != 0
}

/// Unicode's Case_Ignorable property.
pub fn is_case_ignorable(cp: i64) -> bool {
    return props(cp).bit_and(2) != 0
}

/// The full mapping of one code point: kind 0 lower, 1 upper, 2 title.
pub fn case_mapping(cp: i64, kind: i64) -> [i64] {
    let s = special(cp, kind)
    if s.len() > 0 {
        return s
    }
    let runs = if kind == 0 { PYSTR_LOWER_RUNS } else if kind == 1 { PYSTR_UPPER_RUNS } else { PYSTR_TITLE_RUNS }
    return [cp + run_delta(runs, cp)]
}

/// `handle_capital_sigma`: ς at the end of a word, σ elsewhere.
fn sigma(cs: [i64], i: i64) -> i64 {
    var j = i - 1
    while j >= 0 and is_case_ignorable(cs[j]) {
        j = j - 1
    }
    var final_sigma = j >= 0 and is_cased(cs[j])
    if final_sigma and i < cs.len() - 1 {
        j = i + 1
        while j < cs.len() and is_case_ignorable(cs[j]) {
            j = j + 1
        }
        final_sigma = j == cs.len() or not is_cased(cs[j])
    }
    return if final_sigma { 962 } else { 963 }
}

/// `lower_ucs4`: the lower-case mapping of `cs[i]` in its context.
fn lower_at(cs: [i64], i: i64) -> [i64] {
    if cs[i] == 931 {
        return [sigma(cs, i)]
    }
    return case_mapping(cs[i], 0)
}

fn emit(inout out: [str], m: [i64]) {
    for c in m {
        out.push(c.to_char())
    }
}

/// `s.lower()`.
pub fn lower(s: str) -> str {
    let cs = s.codes()
    var out: [str] = []
    for i in 0..cs.len() {
        emit(out, lower_at(cs, i))
    }
    return out.join("")
}

/// `s.upper()`.
pub fn upper(s: str) -> str {
    var out: [str] = []
    for c in s.codes() {
        emit(out, case_mapping(c, 1))
    }
    return out.join("")
}

/// `s.title()`.
pub fn title(s: str) -> str {
    let cs = s.codes()
    var out: [str] = []
    var previous_is_cased = false
    for i in 0..cs.len() {
        emit(out, if previous_is_cased { lower_at(cs, i) } else { case_mapping(cs[i], 2) })
        previous_is_cased = is_cased(cs[i])
    }
    return out.join("")
}

/// `s.capitalize()`.
pub fn capitalize(s: str) -> str {
    let cs = s.codes()
    var out: [str] = []
    for i in 0..cs.len() {
        emit(out, if i == 0 { case_mapping(cs[0], 2) } else { lower_at(cs, i) })
    }
    return out.join("")
}

/// `s.swapcase()`.
pub fn swapcase(s: str) -> str {
    let cs = s.codes()
    var out: [str] = []
    for i in 0..cs.len() {
        let c = cs[i]
        let m = if pycharclass.is_upper(c) { lower_at(cs, i) } else if pycharclass.is_lower(c) { case_mapping(c, 1) } else { [c] }
        emit(out, m)
    }
    return out.join("")
}

// Generated by gen_tables.py from CPython 3.13's str methods (Unicode 15.1.0).
