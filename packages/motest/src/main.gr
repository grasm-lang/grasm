import gettextmo

fn from_hex(text: str) -> bytes {
    var out: [i64] = []
    var i = 1
    while i + 1 < text.len() {
        out.push(text.substr(i, 2).parse_int_base(16) ?? 0)
        i = i + 2
    }
    return bytes_of(out)
}

fn to_hex(text: str) -> str {
    let digits = "0123456789abcdef"
    let raw = text.to_bytes()
    var out = ""
    var i = 0
    while i < raw.len() {
        out = out + digits.substr(raw.at(i) / 16, 1) +
        digits.substr(raw.at(i) % 16, 1)
        i = i + 1
    }
    return out
}

fn main() / {io} {
    var i = 0
    while i + 2 < args().len() {
        let what = args()[i]
        if what == "rule" {
            // `rule <expression> <n>` does not need a catalogue.
            print(gettextmo.evaluate(from_hex(args()[i + 1]).to_str(),
                args()[i + 2].parse_int() ?? 0).to_str())
            i = i + 3
            continue
        }
        let catalogue: MoCatalogue ! MoError =
        gettextmo.decode(from_hex(args()[i + 1]))
        match catalogue {
            Err(_e) -> {
                print("error")
                i = i + 3
                continue
            }
            Ok(c) -> {
                if what == "get" {
                    print(to_hex(gettextmo.get(c,
                        from_hex(args()[i + 2]).to_str())))
                } else if what == "header" {
                    print(to_hex(gettextmo.header(c,
                        from_hex(args()[i + 2]).to_str()) ?? "-"))
                } else if what == "keys" {
                    print(gettextmo.keys(c).len().to_str())
                } else if what == "plural" {
                    // `plural <mo> <singular|plural|n>`
                    let parts = from_hex(args()[i + 2]).to_str().split("\u{1}")
                    print(to_hex(gettextmo.get_plural(c, parts[0], parts[1],
                        parts[2].parse_int() ?? 0)))
                } else {
                    let parts = from_hex(args()[i + 2]).to_str().split("\u{1}")
                    print(to_hex(gettextmo.get_in_context(c, parts[0],
                        parts[1])))
                }
            }
        }
        i = i + 3
    }
}
