// TOML.
//
// Grasm's own manifests are TOML, so a Grasm program reading configuration
// should not need a second format to learn. This is the subset a manifest and
// a configuration file use: tables, arrays of tables, inline tables, arrays,
// strings, integers, floats, booleans and dates-as-text.
//
// What it does not do: multi-line basic strings' line-ending backslash,
// literal multi-line strings, and offset datetimes as a *type* — a datetime
// comes back as the text it was written as, and `time.parse` is next door.
// Each of those is stated rather than silently mis-parsed.
//
// A value is reached by its dotted path, because that is how a configuration
// file is read: `package.name`, `dependencies.json.version`. Building the
// nested map a caller would otherwise walk is work the caller then repeats.

type TomlValue =
    | Text(s: str)
    | Int(n: i64)
    | Float(x: f64)
    | Bool(b: bool)
    | Array(items: [ref TomlValue])
    | Table(keys: [str], values: [ref TomlValue])

type TomlError = { why: str, line: i64 }

/// `keys[i]` is the dotted path of `values[i]`. `entries[i]` is the same path
/// with the entry of an array of tables it was written in: after the second
/// `[[bin]]`, `name = "b"` is `bin.name` in `keys` and `bin[1].name` here, so
/// a reader that needs to know which entry a key belongs to can.
type Doc = { keys: [str], values: [ref TomlValue], entries: [str], ok: bool, why: str, line: i64 }

fn refused(why: str, line: i64) -> Doc {
    Doc{ keys: [], values: [], entries: [], ok: false, why: why, line: line }
}

/// Every key in the document, flattened to a dotted path.
///
/// `[package]` then `name = "x"` is the one entry `package.name`. A reader
/// wanting the tree can still have it — `get_table` answers one — but the flat
/// form is what a configuration file is actually asked for.
pub fn parse(text: str) -> Doc {
    var keys: [str] = []
    var values: [ref TomlValue] = []
    var entries: [str] = []
    var prefix = ""
    // The same prefix with the entry of an array of tables, and how many
    // entries each array has had so far.
    var entry_prefix = ""
    var array_names: [str] = []
    var array_counts: [i64] = []
    var line_no = 0
    for raw in text.lines() {
        line_no = line_no + 1
        let line = strip_comment(raw).trim()
        if line.is_empty() {
            continue
        }
        if line.starts_with("[") {
            if not line.ends_with("]") {
                return refused("a table header with no closing bracket", line_no)
            }
            var inner = line.substr(1, line.len() - 2)
            // `[[a.b]]` is an array of tables. Every entry after it belongs to
            // the same path in `keys`, which is what a flat reader asks for;
            // `entries` says which entry.
            var array = false
            if inner.starts_with("[") and inner.ends_with("]") {
                inner = inner.substr(1, inner.len() - 2)
                array = true
            }
            let name = unquote_path(inner.trim())
            if name.is_empty() {
                return refused("a table header with no name", line_no)
            }
            prefix = name
            entry_prefix = name
            if array {
                var at = -1
                for i in 0..array_names.len() {
                    if array_names[i] == name {
                        at = i
                    }
                }
                if at < 0 {
                    array_names.push(name)
                    array_counts.push(0)
                    at = array_names.len() - 1
                }
                entry_prefix = name + "[{array_counts[at]}]"
                array_counts[at] = array_counts[at] + 1
            }
            continue
        }
        match line.index_of("=") {
            None -> return refused("a line that is neither a header nor an assignment", line_no)
            Some(at) -> {
                let key = unquote_path(line.substr(0, at).trim())
                let rest = line.substr(at + 1, line.len() - at - 1).trim()
                if key.is_empty() {
                    return refused("an assignment with no key", line_no)
                }
                match read_value(rest, line_no) {
                    Err(e) -> return refused(e.why, e.line)
                    Ok(v) -> {
                        let full = if prefix.is_empty() { key } else { prefix + "." + key }
                        let placed = if entry_prefix.is_empty() { key } else { entry_prefix + "." + key }
                        keys.push(full)
                        values.push(v)
                        entries.push(placed)
                        // An inline table is also reachable by its members'
                        // dotted paths, which is what makes
                        // `dependencies.json.version` work whether the file
                        // wrote it inline or as a header.
                        flatten_into(full, placed, v, keys, values, entries)
                    }
                }
            }
        }
    }
    Doc{ keys: keys, values: values, entries: entries, ok: true, why: "", line: 0 }
}

fn flatten_into(prefix: str, placed: str, v: ref TomlValue, inout keys: [str], inout values: [ref TomlValue], inout entries: [str]) {
    match v {
        Table(ks, vs) -> {
            for i in 0..ks.len() {
                let full = prefix + "." + ks[i]
                keys.push(full)
                values.push(vs[i])
                entries.push(placed + "." + ks[i])
                flatten_into(full, placed + "." + ks[i], vs[i], keys, values, entries)
            }
        }
        _ -> {}
    }
}

fn strip_comment(line: str) -> str {
    var out = ""
    var quoted = false
    var quote = ""
    for c in line.chars() {
        if quoted {
            out = out + c
            if c == quote {
                quoted = false
            }
            continue
        }
        if c == "\"" or c == "'" {
            quoted = true
            quote = c
            out = out + c
            continue
        }
        if c == "#" {
            return out
        }
        out = out + c
    }
    out
}

fn unquote_path(s: str) -> str {
    var parts: [str] = []
    for p in s.split(".") {
        var t = p.trim()
        if (t.starts_with("\"") and t.ends_with("\"") and t.len() >= 2) or
        (t.starts_with("'") and t.ends_with("'") and t.len() >= 2) {
            t = t.substr(1, t.len() - 2)
        }
        parts.push(t)
    }
    parts.join(".")
}

fn read_value(text: str, line_no: i64) -> ref TomlValue ! TomlError {
    let t = text.trim()
    if t.is_empty() {
        fail(TomlError{ why: "an assignment with no value", line: line_no })
    }
    if t == "true" {
        return ref(Bool(true))
    }
    if t == "false" {
        return ref(Bool(false))
    }
    if t.starts_with("\"") or t.starts_with("'") {
        return ref(Text(try read_string(t, line_no)))
    }
    if t.starts_with("[") {
        return try read_array(t, line_no)
    }
    if t.starts_with("\{") {
        return try read_inline_table(t, line_no)
    }
    let plain = t.replace("_", "")
    match plain.parse_int() {
        Some(n) -> return ref(Int(n))
        None -> {}
    }
    match plain.parse_float() {
        Some(x) -> return ref(Float(x))
        None -> {}
    }
    // A bare date, a bare time, or anything else unquoted: kept as the text it
    // was written as. Guessing at a datetime type here would answer confidently
    // for input this package has not been taught to read.
    ref(Text(t))
}

fn read_string(t: str, line_no: i64) -> str ! TomlError {
    let quote = t.substr(0, 1)
    if t.len() < 2 or not t.ends_with(quote) {
        fail(TomlError{ why: "a string with no closing quote", line: line_no })
    }
    let body = t.substr(1, t.len() - 2)
    if quote == "'" {
        // A literal string: no escapes at all, which is the point of it.
        return body
    }
    var out = ""
    let cs = body.chars()
    var i = 0
    while i < cs.len() {
        if cs[i] != "\\" {
            out = out + cs[i]
            i = i + 1
            continue
        }
        if i + 1 >= cs.len() {
            fail(TomlError{ why: "a string ending in a backslash", line: line_no })
        }
        let c = cs[i + 1]
        i = i + 2
        if c == "n" { out = out + "\n" }
        else if c == "t" { out = out + "\t" }
        else if c == "r" { out = out + "\r" }
        else if c == "\"" { out = out + "\"" }
        else if c == "\\" { out = out + "\\" }
        else if c == "0" { out = out + "\{0.to_char()}" }
        else if c == "u" {
            var n = 0
            var read = 0
            while read < 4 and i < cs.len() {
                let d = cs[i].to_lower().parse_int_base(16) ?? -1
                if d < 0 {
                    fail(TomlError{ why: "a \\u escape with fewer than four hex digits", line: line_no })
                }
                n = n * 16 + d
                read = read + 1
                i = i + 1
            }
            if read < 4 {
                fail(TomlError{ why: "a \\u escape with fewer than four hex digits", line: line_no })
            }
            out = out + n.to_char()
        }
        else {
            fail(TomlError{ why: "an unknown escape \\{c}", line: line_no })
        }
    }
    out
}

// Splitting on the separator at depth zero, so a comma inside a nested array
// or an inline table does not end the element.
fn split_top(body: str) -> [str] {
    var parts: [str] = []
    var depth = 0
    var quoted = false
    var quote = ""
    var current = ""
    for c in body.chars() {
        if quoted {
            current = current + c
            if c == quote {
                quoted = false
            }
            continue
        }
        if c == "\"" or c == "'" {
            quoted = true
            quote = c
            current = current + c
            continue
        }
        if c == "[" or c == "\{" {
            depth = depth + 1
        } else if c == "]" or c == "}" {
            depth = depth - 1
        }
        if c == "," and depth == 0 {
            parts.push(current)
            current = ""
            continue
        }
        current = current + c
    }
    if not current.trim().is_empty() {
        parts.push(current)
    }
    parts
}

fn read_array(t: str, line_no: i64) -> ref TomlValue ! TomlError {
    if not t.ends_with("]") {
        fail(TomlError{ why: "an array with no closing bracket", line: line_no })
    }
    let body = t.substr(1, t.len() - 2).trim()
    var items: [ref TomlValue] = []
    if body.is_empty() {
        return ref(Array(items))
    }
    for part in split_top(body) {
        items.push(try read_value(part.trim(), line_no))
    }
    ref(Array(items))
}

fn read_inline_table(t: str, line_no: i64) -> ref TomlValue ! TomlError {
    if not t.ends_with("}") {
        fail(TomlError{ why: "an inline table with no closing brace", line: line_no })
    }
    let body = t.substr(1, t.len() - 2).trim()
    var keys: [str] = []
    var values: [ref TomlValue] = []
    if body.is_empty() {
        return ref(Table(keys, values))
    }
    for part in split_top(body) {
        let p = part.trim()
        match p.index_of("=") {
            None -> fail(TomlError{ why: "an inline table entry with no `=`", line: line_no })
            Some(at) -> {
                keys.push(unquote_path(p.substr(0, at).trim()))
                values.push(try read_value(p.substr(at + 1, p.len() - at - 1).trim(), line_no))
            }
        }
    }
    ref(Table(keys, values))
}

// --- reading a document ----------------------------------------------------

pub fn get(d: Doc, path: str) -> Option[ref TomlValue] {
    for i in 0..d.keys.len() {
        if d.keys[i] == path {
            return Some(d.values[i])
        }
    }
    None
}

pub fn text_of(d: Doc, path: str, fallback: str) -> str {
    match get(d, path) {
        Some(v) -> match v {
            Text(s) -> s
            _ -> fallback
        }
        None -> fallback
    }
}

pub fn int_of(d: Doc, path: str, fallback: i64) -> i64 {
    match get(d, path) {
        Some(v) -> match v {
            Int(n) -> n
            _ -> fallback
        }
        None -> fallback
    }
}

pub fn float_of(d: Doc, path: str, fallback: f64) -> f64 {
    match get(d, path) {
        Some(v) -> match v {
            Float(x) -> x
            Int(n) -> n.as_f64()
            _ -> fallback
        }
        None -> fallback
    }
}

pub fn bool_of(d: Doc, path: str, fallback: bool) -> bool {
    match get(d, path) {
        Some(v) -> match v {
            Bool(b) -> b
            _ -> fallback
        }
        None -> fallback
    }
}

/// The strings in an array, skipping anything that is not one.
pub fn texts_of(d: Doc, path: str) -> [str] {
    var out: [str] = []
    match get(d, path) {
        Some(v) -> match v {
            Array(items) -> {
                for it in items {
                    match it {
                        Text(s) -> out.push(s)
                        _ -> {}
                    }
                }
            }
            _ -> {}
        }
        None -> {}
    }
    out
}

/// The names one level under a path.
///
/// The *first segment* of each deeper key, not only the keys that stop there:
/// `[dependencies.json]` writes `dependencies.json.path` and nothing named
/// `dependencies.json`, so skipping tails that contain a dot answered "no
/// members" for a table that plainly has one.
pub fn keys_under(d: Doc, path: str) -> [str] {
    let want = path + "."
    var out: [str] = []
    for k in d.keys {
        if not k.starts_with(want) {
            continue
        }
        let tail = k.substr(want.len(), k.len() - want.len())
        let head = match tail.index_of(".") {
            Some(at) -> tail.substr(0, at)
            None -> tail
        }
        if not head.is_empty() and not out.contains(head) {
            out.push(head)
        }
    }
    out
}

pub fn kind(v: ref TomlValue) -> str {
    match v {
        Text(s) -> "string"
        Int(n) -> "integer"
        Float(x) -> "float"
        Bool(b) -> "bool"
        Array(items) -> "array"
        Table(ks, vs) -> "table"
    }
}

pub fn render_value(v: ref TomlValue) -> str {
    match v {
        Text(s) -> "\"" + s.replace("\\", "\\\\").replace("\"", "\\\"")
            .replace("\n", "\\n").replace("\t", "\\t") + "\""
        Int(n) -> "{n}"
        Float(x) -> "{x}"
        Bool(b) -> if b { "true" } else { "false" }
        Array(items) -> {
            var parts: [str] = []
            for it in items {
                parts.push(render_value(it))
            }
            "[" + parts.join(", ") + "]"
        }
        Table(ks, vs) -> {
            var parts: [str] = []
            for i in 0..ks.len() {
                parts.push(ks[i] + " = " + render_value(vs[i]))
            }
            "\{ " + parts.join(", ") + " }"
        }
    }
}
