// The Porter2 stemmer for English — Martin Porter's Snowball revision of his
// own 1980 algorithm.
//
// A search for `connecting` should find `connection`, and the cheapest way to
// arrange that is to reduce both to `connect` before the index sees them.
// That is all a stemmer is: a function that maps a family of words onto one
// token, without a dictionary and without knowing what any of them mean.
//
// ## What it is not
//
// **Not a lemmatiser.** A lemma is a real word; a stem need not be. `ugly`
// stems to `ugli` and `argument` to `argument` while `arguing` becomes
// `argu`. That is fine for an index, where the only thing that matters is
// that two forms of one word land on the same token, and useless for showing
// anyone the result.
//
// **Not reversible, and not injective.** `universe` and `university` both
// stem to `univers`. Every stemmer trades precision for recall and this one
// is tuned for a search box, where missing a document is worse than showing
// one extra.
//
// **Porter2, not Porter.** The original 1980 algorithm is still in use and
// gives different answers; Porter himself replaced it in 2002 because a few
// of its rules were wrong, and asked people to stop calling the new one
// "Porter". An index built with one and queried with the other will quietly
// miss things, so packages that name the version are worth preferring.
//
// ## The shape of it
//
// Two regions, R1 and R2, mark how far into the word the suffix rules may
// reach: R1 begins after the first consonant that follows a vowel, and R2 is
// the same rule applied again inside R1. A suffix is stripped only when it
// starts inside the region its rule names, which is what stops `red` losing
// its `ed` — R1 for `red` is empty, so no step 1b rule can reach.
//
// ## Two references, and where they part
//
// Checked against both of the implementations people actually use, on 20,000
// words from the system dictionary: 19,945 stems agree with *both*, and not
// one word disagrees with both. The 55 that split are worth knowing about.
//
// Fifty are `-ologist` words, where Snowball 3.1.1 — the current English
// stemmer, which has moved on from the 2002 description — strips `ist` and
// Porter2 does not: `necrologist` becomes `necrolog` there and stays whole
// here. The other five are NLTK leaving a final `e` that Porter2's step 5
// removes, which Snowball agrees with this on. So this is Porter2 as
// published, and the divergence is between the two references rather than
// with either.

fn is_vowel(c: str) -> bool {
    return c == "a" or c == "e" or c == "i" or c == "o" or c == "u" or
    c == "y"
}

fn vowel_at(letters: [str], i: i64) -> bool {
    if i < 0 or i >= letters.len() {
        return false
    }
    return is_vowel(letters[i])
}

/// Where R1 starts: after the first consonant that follows a vowel.
///
/// Three prefixes are special-cased because the general rule puts R1 too
/// early in them and the results were wrong: `gener`, `commun`, `arsen`.
/// That is the kind of patch a real algorithm accumulates, and leaving it out
/// is how an implementation passes casual tests and fails the vocabulary.
fn r1_of(word: str, letters: [str]) -> i64 {
    if word.starts_with("gener") or word.starts_with("arsen") {
        return 5
    }
    if word.starts_with("commun") {
        return 6
    }
    return region_after(letters, 0)
}

fn region_after(letters: [str], from: i64) -> i64 {
    var i = from
    while i + 1 < letters.len() {
        if vowel_at(letters, i) and not vowel_at(letters, i + 1) {
            return i + 2
        }
        i = i + 1
    }
    return letters.len()
}

/// Whether a suffix beginning at `at` lies inside the region starting at `r`.
fn within(at: i64, r: i64) -> bool {
    return at >= r
}

/// A short syllable: a vowel between two consonants, with the one after not
/// `w`, `x` or a capital `Y`; or a vowel opening the word before a consonant.
fn ends_short_syllable(letters: [str]) -> bool {
    let n = letters.len()
    if n >= 3 {
        let a = letters[n - 3]
        let b = letters[n - 2]
        let c = letters[n - 1]
        if not is_vowel(a) and is_vowel(b) and not is_vowel(c) and
        c != "w" and c != "x" and c != "Y" {
            return true
        }
    }
    if n == 2 {
        return is_vowel(letters[0]) and not is_vowel(letters[1])
    }
    return false
}

/// A word is short when it ends in a short syllable and R1 is empty.
fn is_short(letters: [str], r1: i64) -> bool {
    return r1 >= letters.len() and ends_short_syllable(letters)
}

fn ends_with(letters: [str], suffix: str) -> bool {
    return join(letters).ends_with(suffix)
}

fn join(letters: [str]) -> str {
    return letters.join("")
}

fn drop(letters: [str], n: i64) -> [str] {
    return letters.slice(0, letters.len() - n)
}

fn plus(letters: [str], text: str) -> [str] {
    var out = letters
    for c in text.chars() {
        out.push(c)
    }
    return out
}

fn contains_vowel(letters: [str]) -> bool {
    for c in letters {
        if is_vowel(c) {
            return true
        }
    }
    return false
}

fn is_double(letters: [str]) -> bool {
    let n = letters.len()
    if n < 2 {
        return false
    }
    let a = letters[n - 2]
    if a != letters[n - 1] {
        return false
    }
    let doubles = ["b", "d", "f", "g", "m", "n", "p", "r", "t"]
    return doubles.contains(a)
}

/// Words the algorithm is told to leave alone or to map by hand.
///
/// Every one of them is a word the rules get wrong. `news` would lose its
/// `s`, `atlas` would look like a plural, and `skis` and `skies` would land
/// on different stems despite being the same word.
fn special(word: str) -> str {
    let from = ["skis", "skies", "dying", "lying", "tying", "idly", "gently",
        "ugly", "early", "only", "singly", "sky", "news", "howe", "atlas",
        "cosmos", "bias", "andes"]
    let to = ["ski", "sky", "die", "lie", "tie", "idl", "gentl", "ugli",
        "earli", "onli", "singl", "sky", "news", "howe", "atlas", "cosmos",
        "bias", "andes"]
    var i = 0
    while i < from.len() {
        if word == from[i] {
            return to[i]
        }
        i = i + 1
    }
    return ""
}

/// Words that stop after step 1a rather than continuing.
fn stops_after_1a(word: str) -> bool {
    let words = ["inning", "outing", "canning", "herring", "earring",
        "proceed", "exceed", "succeed"]
    return words.contains(word)
}

/// The stem of one word, which must already be lowercase.
pub fn stem(input: str) -> str {
    let word = input
    if word.len() <= 2 {
        return word
    }
    let fixed = special(word)
    if fixed != "" {
        return fixed
    }

    var letters = word.chars()
    if letters[0] == "'" {
        letters = letters.slice(1, letters.len())
    }
    if letters.len() <= 2 {
        return join(letters)
    }

    // A `y` that begins a word or follows a vowel is a consonant, and is
    // marked so the vowel tests below do not see it as one. It goes back at
    // the end.
    if letters[0] == "y" {
        letters[0] = "Y"
    }
    var i = 1
    while i < letters.len() {
        if letters[i] == "y" and vowel_at(letters, i - 1) {
            letters[i] = "Y"
        }
        i = i + 1
    }

    let marked = join(letters)
    let r1 = r1_of(marked, letters)
    let r2 = region_after(letters, r1)

    letters = step0(letters)
    letters = step1a(letters)
    if stops_after_1a(join(letters).to_lower()) {
        return unmark(letters)
    }
    letters = step1b(letters, r1)
    letters = step1c(letters)
    letters = step2(letters, r1)
    letters = step3(letters, r1, r2)
    letters = step4(letters, r2)
    letters = step5(letters, r1, r2)
    return unmark(letters)
}

fn unmark(letters: [str]) -> str {
    var out = ""
    for c in letters {
        if c == "Y" {
            out = out + "y"
        } else {
            out = out + c
        }
    }
    return out
}

/// Possessives, longest first.
fn step0(letters: [str]) -> [str] {
    if ends_with(letters, "'s'") {
        return drop(letters, 3)
    }
    if ends_with(letters, "'s") {
        return drop(letters, 2)
    }
    if ends_with(letters, "'") {
        return drop(letters, 1)
    }
    return letters
}

fn step1a(letters: [str]) -> [str] {
    if ends_with(letters, "sses") {
        return plus(drop(letters, 4), "ss")
    }
    if ends_with(letters, "ied") or ends_with(letters, "ies") {
        // `ties` has one letter before the suffix and becomes `tie`;
        // `cries` has two and becomes `cri`.
        if letters.len() > 4 {
            return plus(drop(letters, 3), "i")
        }
        return plus(drop(letters, 3), "ie")
    }
    if ends_with(letters, "us") or ends_with(letters, "ss") {
        return letters
    }
    if ends_with(letters, "s") {
        // The vowel has to be further back than the letter before the `s`,
        // which is what keeps `gas` and `this` whole.
        if contains_vowel(letters.slice(0, letters.len() - 2)) {
            return drop(letters, 1)
        }
    }
    return letters
}

fn step1b(letters: [str], r1: i64) -> [str] {
    if ends_with(letters, "eedly") {
        if within(letters.len() - 5, r1) {
            return plus(drop(letters, 5), "ee")
        }
        return letters
    }
    if ends_with(letters, "eed") {
        if within(letters.len() - 3, r1) {
            return plus(drop(letters, 3), "ee")
        }
        return letters
    }
    let suffixes = ["ingly", "edly", "ing", "ed"]
    for suffix in suffixes {
        if not ends_with(letters, suffix) {
            continue
        }
        let stem_part = drop(letters, suffix.len())
        if not contains_vowel(stem_part) {
            return letters
        }
        if ends_with(stem_part, "at") or ends_with(stem_part, "bl") or
        ends_with(stem_part, "iz") {
            return plus(stem_part, "e")
        }
        if is_double(stem_part) {
            return drop(stem_part, 1)
        }
        if is_short(stem_part, r1) {
            return plus(stem_part, "e")
        }
        return stem_part
    }
    return letters
}

fn step1c(letters: [str]) -> [str] {
    let n = letters.len()
    if n < 3 {
        return letters
    }
    let last = letters[n - 1]
    if last != "y" and last != "Y" {
        return letters
    }
    if vowel_at(letters, n - 2) {
        return letters
    }
    var out = letters
    out[n - 1] = "i"
    return out
}

fn replace_in(letters: [str], r: i64, suffix: str, with_text: str) -> [str] {
    if not ends_with(letters, suffix) {
        return letters
    }
    if not within(letters.len() - suffix.len(), r) {
        return letters
    }
    return plus(drop(letters, suffix.len()), with_text)
}

fn step2(letters: [str], r1: i64) -> [str] {
    let from = ["ational", "tional", "enci", "anci", "abli", "entli", "izer",
        "ization", "ation", "ator", "alism", "aliti", "alli", "fulness",
        "ousli", "ousness", "iveness", "iviti", "biliti", "bli", "fulli",
        "lessli"]
    let to = ["ate", "tion", "ence", "ance", "able", "ent", "ize", "ize",
        "ate", "ate", "al", "al", "al", "ful", "ous", "ous", "ive", "ive",
        "ble", "ble", "ful", "less"]
    // Longest match wins, so the table is searched by length rather than in
    // the order written.
    var best = 0 - 1
    var i = 0
    while i < from.len() {
        if ends_with(letters, from[i]) and
        (best < 0 or from[i].len() > from[best].len()) {
            best = i
        }
        i = i + 1
    }
    if best >= 0 {
        let n = from[best].len()
        if within(letters.len() - n, r1) {
            return plus(drop(letters, n), to[best])
        }
        return letters
    }
    if ends_with(letters, "ogi") and letters.len() >= 4 and
    letters[letters.len() - 4] == "l" {
        if within(letters.len() - 3, r1) {
            return drop(letters, 1)
        }
        return letters
    }
    if ends_with(letters, "li") and letters.len() >= 3 {
        // `li` goes only after a letter that can carry it; `bali` keeps it.
        let before = letters[letters.len() - 3]
        let valid = ["c", "d", "e", "g", "h", "k", "m", "n", "r", "t"]
        if valid.contains(before) and within(letters.len() - 2, r1) {
            return drop(letters, 2)
        }
    }
    return letters
}

fn step3(letters: [str], r1: i64, r2: i64) -> [str] {
    if ends_with(letters, "ational") {
        return replace_in(letters, r1, "ational", "ate")
    }
    if ends_with(letters, "tional") {
        return replace_in(letters, r1, "tional", "tion")
    }
    if ends_with(letters, "alize") {
        return replace_in(letters, r1, "alize", "al")
    }
    if ends_with(letters, "icate") {
        return replace_in(letters, r1, "icate", "ic")
    }
    if ends_with(letters, "iciti") {
        return replace_in(letters, r1, "iciti", "ic")
    }
    if ends_with(letters, "ical") {
        return replace_in(letters, r1, "ical", "ic")
    }
    if ends_with(letters, "ness") {
        return replace_in(letters, r1, "ness", "")
    }
    if ends_with(letters, "ful") {
        return replace_in(letters, r1, "ful", "")
    }
    if ends_with(letters, "ative") {
        // The only rule in this step that reaches into R2 instead of R1.
        return replace_in(letters, r2, "ative", "")
    }
    return letters
}

fn step4(letters: [str], r2: i64) -> [str] {
    let suffixes = ["ement", "ance", "ence", "able", "ible", "ment", "ant",
        "ent", "ism", "ate", "iti", "ous", "ive", "ize", "al", "er", "ic"]
    var best = 0 - 1
    var i = 0
    while i < suffixes.len() {
        if ends_with(letters, suffixes[i]) and
        (best < 0 or suffixes[i].len() > suffixes[best].len()) {
            best = i
        }
        i = i + 1
    }
    if best >= 0 {
        return replace_in(letters, r2, suffixes[best], "")
    }
    if ends_with(letters, "ion") and letters.len() >= 4 {
        let before = letters[letters.len() - 4]
        if (before == "s" or before == "t") and
        within(letters.len() - 3, r2) {
            return drop(letters, 3)
        }
    }
    return letters
}

fn step5(letters: [str], r1: i64, r2: i64) -> [str] {
    let n = letters.len()
    if n > 0 and letters[n - 1] == "e" {
        if within(n - 1, r2) {
            return drop(letters, 1)
        }
        if within(n - 1, r1) and not ends_short_syllable(drop(letters, 1)) {
            return drop(letters, 1)
        }
        return letters
    }
    if n > 1 and letters[n - 1] == "l" and letters[n - 2] == "l" and
    within(n - 1, r2) {
        return drop(letters, 1)
    }
    return letters
}

/// The stems of many words, which is what an indexer actually calls.
pub fn stem_all(words: [str]) -> [str] {
    var out: [str] = []
    for w in words {
        out.push(stem(w))
    }
    return out
}

/// Whether two words share a stem — the question a search box is asking.
pub fn same_stem(a: str, b: str) -> bool {
    return stem(a) == stem(b)
}
