// DER, which is the encoding every certificate arrives in.
//
// A DER document is a tree of (tag, length, value) triples, and the only two
// things that make it awkward are that lengths come in two forms and that the
// tree is easier to use flat. So this parses to a flat list in document order,
// each node carrying its depth — walking children is then "the following nodes
// one deeper", and no recursion is needed to find anything.
//
// What it refuses is as important as what it reads. A length that runs past
// the end of the document, an indefinite length (BER, not DER), and a document
// with trailing bytes are all errors rather than a shorter answer, because a
// parser that silently truncates is one an attacker chooses the truncation
// point for.

/// Universal tags, as they appear in the identifier octet.
pub let BOOLEAN = 1
pub let INTEGER = 2
pub let BIT_STRING = 3
pub let OCTET_STRING = 4
pub let NULL = 5
pub let OID = 6
pub let UTF8_STRING = 12
pub let SEQUENCE = 48
pub let SET = 49
pub let PRINTABLE_STRING = 19
pub let IA5_STRING = 22
pub let UTC_TIME = 23
pub let GENERALIZED_TIME = 24

type DerNode = {
    /// The identifier octet as written: `48` for SEQUENCE, `0xA0` for `[0]`.
    tag: i64,
    /// Byte offset of the identifier octet.
    at: i64,
    /// Byte offset of the first content octet.
    body: i64,
    /// Length of the content, in bytes.
    len: i64,
    /// How deep in the tree, with the outermost node at 0.
    depth: i64,
}

type Asn1Error =
    | Truncated(at: i64)
    | Indefinite(at: i64)
    | LengthTooLarge(at: i64)
    | Trailing(at: i64)

/// Every node of the document, outermost first, in the order it is written.
pub fn parse(der: bytes) -> [DerNode] ! Asn1Error {
    var out: [DerNode] = []
    try walk(der, 0, der.len(), 0, out)
    return out
}

/// One level, then each child. `stop` is one past the last byte of this level.
fn walk(der: bytes, from: i64, stop: i64, depth: i64, inout out: [DerNode]) ! Asn1Error {
    var i = from
    while i < stop {
        if i + 2 > stop {
            fail(Truncated(i))
        }
        let tag = der.at(i)
        let first = der.at(i + 1)
        var body = i + 2
        var len = first
        if first == 128 {
            // 0x80 is "length follows the content", which BER allows and DER
            // does not. Accepting it would mean scanning for a terminator that
            // an attacker also controls.
            fail(Indefinite(i))
        }
        if first > 128 {
            let count = first - 128
            if count > 4 {
                fail(LengthTooLarge(i))
            }
            if i + 2 + count > stop {
                fail(Truncated(i))
            }
            len = 0
            for k in 0..count {
                len = len * 256 + der.at(i + 2 + k)
            }
            body = i + 2 + count
        }
        if body + len > stop {
            fail(Truncated(i))
        }
        out.push(DerNode{ tag: tag, at: i, body: body, len: len, depth: depth })
        // Bit 6 of the identifier octet says the content is itself a document.
        if (tag / 32) % 2 == 1 {
            try walk(der, body, body + len, depth + 1, out)
        }
        i = body + len
    }
}

/// The content octets of a node.
pub fn value(der: bytes, n: DerNode) -> bytes {
    return der.slice(n.body, n.body + n.len)
}

/// The nodes directly inside `nodes[i]`.
///
/// A child is a node one deeper that appears before the next node at the
/// parent's own depth — which is what "directly inside" means once the tree is
/// flat.
pub fn children(nodes: [DerNode], i: i64) -> [DerNode] {
    var out: [DerNode] = []
    let parent = nodes[i]
    var k = i + 1
    while k < nodes.len() {
        let n = nodes[k]
        if n.depth <= parent.depth {
            return out
        }
        if n.depth == parent.depth + 1 {
            out.push(n)
        }
        k = k + 1
    }
    return out
}

/// The same, as indices into `nodes` rather than as nodes.
///
/// A caller walking a nested document needs to descend, and descending needs
/// an index. Returning the nodes themselves means finding them again by
/// offset — which every reader of a certificate ends up writing, so it is
/// here once instead.
pub fn child_indices(nodes: [DerNode], i: i64) -> [i64] {
    var out: [i64] = []
    let parent = nodes[i]
    var k = i + 1
    while k < nodes.len() {
        let n = nodes[k]
        if n.depth <= parent.depth {
            return out
        }
        if n.depth == parent.depth + 1 {
            out.push(k)
        }
        k = k + 1
    }
    return out
}

/// The whole of a node including its tag and length octets.
///
/// This is what a signature covers and what a re-encoder must reproduce, so
/// it is taken from the original bytes rather than rebuilt.
pub fn raw(der: bytes, n: DerNode) -> bytes {
    return der.slice(n.at, n.body + n.len)
}

/// An INTEGER's value, for the small ones. DER writes them big-endian and
/// two's complement, with a leading zero where the top bit would otherwise
/// make a positive number look negative.
/// An INTEGER, two's complement as DER writes it, so `-1` reads as -1.
///
/// Built with shifts rather than `v * 256`: a CRL number may be twenty
/// octets (RFC 5280, 5.2.3), and multiplying that out overflowed -- which a
/// debug build turns into a trap. A value wider than 64 bits comes back as
/// its low 64 bits; read `value` for the whole of one.
pub fn integer_of(der: bytes, n: DerNode) -> i64 {
    var v = 0
    if n.len > 0 and der.at(n.body) >= 128 {
        v = -1
    }
    for k in 0..n.len {
        v = v.shl(8).bit_or(der.at(n.body + k))
    }
    return v
}

/// An OBJECT IDENTIFIER in dotted form.
///
/// The first byte holds two arcs at once (`40 * a + b`), and every later arc is
/// base-128 with the top bit set on all but the last byte.
pub fn oid_of(der: bytes, n: DerNode) -> str {
    if n.len == 0 {
        return ""
    }
    let first = der.at(n.body)
    var parts: [str] = ["{first / 40}", "{first % 40}"]
    var acc = 0
    for k in 1..n.len {
        let b = der.at(n.body + k)
        acc = acc * 128 + (b % 128)
        if b < 128 {
            parts.push("{acc}")
            acc = 0
        }
    }
    return parts.join(".")
}

/// A UTCTime or GeneralizedTime as seconds since 1970.
///
/// The two differ in the year: UTCTime writes two digits and reads them as
/// 1950 to 2049, GeneralizedTime writes four. RFC 5280 requires both to be
/// Zulu with seconds, and this refuses anything else by returning `None`
/// rather than guessing a timezone — a certificate whose expiry is off by an
/// offset is worse than one that will not parse.
pub fn time_of(der: bytes, n: DerNode) -> Option[i64] {
    let text = value(der, n).to_str()
    if not text.ends_with("Z") {
        return None
    }
    var digits = text.substr(0, text.len() - 1)
    if n.tag == UTC_TIME {
        if digits.len() != 12 {
            return None
        }
        let yy = two_of(digits, 0)
        // 1950..2049, which is the whole range two digits can name.
        let century = if yy >= 50 { 1900 } else { 2000 }
        return Some(seconds_of(century + yy, two_of(digits, 2),
            two_of(digits, 4), two_of(digits, 6), two_of(digits, 8),
            two_of(digits, 10)))
    }
    if n.tag == GENERALIZED_TIME {
        if digits.len() != 14 {
            return None
        }
        let year = two_of(digits, 0) * 100 + two_of(digits, 2)
        return Some(seconds_of(year, two_of(digits, 4), two_of(digits, 6),
            two_of(digits, 8), two_of(digits, 10), two_of(digits, 12)))
    }
    return None
}

fn two_of(text: str, at: i64) -> i64 {
    return text.substr(at, 2).parse_int() ?? 0
}

/// Seconds since 1970 for a civil date, with the era starting in March.
///
/// Shifting the year to start in March puts the leap day at the end of it,
/// which removes February from the arithmetic entirely — no table of month
/// lengths and no special case for a leap year.
pub fn seconds_of(year: i64, month: i64, day: i64, hour: i64, minute: i64,
    second: i64) -> i64 {
    var y = year
    if month <= 2 {
        y = y - 1
    }
    var era = y / 400
    if y < 0 {
        era = (y - 399) / 400
    }
    let yoe = y - era * 400
    let mp = (month + 9) % 12
    let doy = (153 * mp + 2) / 5 + day - 1
    let doe = yoe * 365 + yoe / 4 - yoe / 100 + doy
    let days = era * 146097 + doe - 719468
    return days * 86400 + hour * 3600 + minute * 60 + second
}

/// The content of a node as text.
pub fn text_of(der: bytes, n: DerNode) -> str {
    return value(der, n).to_str()
}
