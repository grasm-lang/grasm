// Ruby's `Shellwords`, as Ruby 2.6 splits and escapes: `split`, `escape`
// and `join`, and `String#inspect` for the message `split` raises.
//
// Ruby tools -- Rake tasks, Homebrew formulae, Capistrano and Bundler --
// split and build command lines with these, and they are neither the
// POSIX shell's rules (`packages/shlex`) nor Python's (`pyshlex`):
//
//   - A word is a run of anything but whitespace, `\`, `'` and `"`;
//     single quotes take everything literally; double quotes honour `\`
//     before `$`, a backquote, `"`, `\` and a newline, and keep every
//     other backslash; a bare `\` escapes the next character -- except a
//     newline, which it keeps (backslash and all).
//   - A quote with no partner is "Unmatched double quote: " and the line
//     as `inspect` prints it -- even when the quote is a single one.
//   - `escape` puts a backslash before everything but letters, digits,
//     `_-.,:/@` and newline (so `é` becomes `\é` and `+` becomes `\+`),
//     writes a newline as `'\n'`, and gives `''` for the empty string.
//   - `inspect` escapes `"`, `\`, `#` before `{`, `$` or `@`, the C
//     control escapes, and whatever Ruby 2.6 (Unicode 12.1) does not print
//     as `\uXXXX`; the table of what it prints is generated from Ruby by
//     scripts/lib/b52/rubyshellwords/gen_tables.rb.

type ShellwordsError = | ShellwordsArgumentError(msg: str)

pub fn error_text(e: ShellwordsError) -> str {
    return match e {
        ShellwordsArgumentError(m) -> m
    }
}

fn printable(cp: i64) -> bool {
    let starts = PRINT_STARTS
    let ends = PRINT_ENDS
    var lo = 0
    var hi = starts.len() - 1
    if cp < starts[0] {
        return false
    }
    while lo < hi {
        let mid = (lo + hi + 1) / 2
        if starts[mid] <= cp {
            lo = mid
        } else {
            hi = mid - 1
        }
    }
    return cp < ends[lo]
}

fn hex_upper(n: i64, width: i64) -> str {
    let digits = "0123456789ABCDEF"
    var out = ""
    var v = n
    while v > 0 {
        out = digits.substr(v % 16, 1) + out
        v = v / 16
    }
    while out.len() < width {
        out = "0" + out
    }
    return out
}

/// `String#inspect` for a UTF-8 string, with UTF-8 the default external
/// encoding.
pub fn inspect(s: str) -> str {
    let cs = s.codes()
    var out = "\""
    for i in 0..cs.len() {
        let c = cs[i]
        let next = if i + 1 < cs.len() { cs[i + 1] } else { 0 - 1 }
        if c == 34 or c == 92 or (c == 35 and (next == 36 or next == 64 or next == 123)) {
            out = out + "\\" + c.to_char()
            continue
        }
        let letter = [10, 13, 9, 12, 11, 8, 7, 27].position(c)
        if letter >= 0 {
            out = out + "\\" + ["n", "r", "t", "f", "v", "b", "a", "e"][letter]
            continue
        }
        if printable(c) {
            out = out + c.to_char()
        } else if c < 65536 {
            out = out + "\\u" + hex_upper(c, 4)
        } else {
            out = out + "\\u\{" + hex_upper(c, 1) + "}"
        }
    }
    return out + "\""
}

fn position(xs: [i64], x: i64) -> i64 {
    for i in 0..xs.len() {
        if xs[i] == x {
            return i
        }
    }
    return 0 - 1
}

/// Ruby's `\s`: the six ASCII whitespace characters.
fn space(c: i64) -> bool {
    return c == 32 or c == 9 or c == 10 or c == 11 or c == 12 or c == 13
}

/// `Shellwords.split(line)`.
pub fn split(line: str) -> [str] ! ShellwordsError {
    let cs = line.codes()
    var words: [str] = []
    var field: [i64] = []
    var i = 0
    while true {
        var j = i
        while j < cs.len() and space(cs[j]) {
            j = j + 1
        }
        if j >= cs.len() {
            break
        }
        let c = cs[j]
        var k = j
        if not space(c) and c != 92 and c != 39 and c != 34 {
            while k < cs.len() and not space(cs[k]) and cs[k] != 92 and cs[k] != 39 and cs[k] != 34 {
                k = k + 1
            }
            field = field + cs.slice(j, k)
        } else if c == 39 and closing(cs, j + 1, 39) >= 0 {
            k = closing(cs, j + 1, 39)
            field = field + cs.slice(j + 1, k)
            k = k + 1
        } else if c == 34 and dq_end(cs, j + 1) >= 0 {
            k = dq_end(cs, j + 1)
            field = field + dq_unescape(cs.slice(j + 1, k))
            k = k + 1
        } else if c == 92 {
            // `\\.?`, the dot taking a newline too; the gsub that follows
            // does not, so a backslash before a newline is kept.
            if j + 1 < cs.len() {
                k = j + 2
                if cs[j + 1] == 10 {
                    field = field + [92, 10]
                } else {
                    field.push(cs[j + 1])
                }
            } else {
                k = j + 1
                field.push(92)
            }
        } else {
            fail(ShellwordsArgumentError("Unmatched double quote: " + inspect(line)))
        }
        // `(\s|\z)?`: a separator ends the word.
        if k < cs.len() and space(cs[k]) {
            words.push(field.map(|x| x.to_char()).join(""))
            field = []
            k = k + 1
        } else if k >= cs.len() {
            words.push(field.map(|x| x.to_char()).join(""))
            field = []
        }
        i = k
    }
    return words
}

fn closing(cs: [i64], from: i64, q: i64) -> i64 {
    var k = from
    while k < cs.len() and cs[k] != q {
        k = k + 1
    }
    return if k < cs.len() { k } else { 0 - 1 }
}

/// The end of `"((?:[^"\\]|\\.)*)"`'s body, or -1.
fn dq_end(cs: [i64], from: i64) -> i64 {
    var k = from
    while k < cs.len() {
        if cs[k] == 34 {
            return k
        }
        if cs[k] == 92 {
            if k + 1 >= cs.len() {
                return 0 - 1
            }
            k = k + 2
        } else {
            k = k + 1
        }
    }
    return 0 - 1
}

/// `gsub(/\\([$`"\\\n])/, '\1')`.
fn dq_unescape(body: [i64]) -> [i64] {
    var out: [i64] = []
    var k = 0
    while k < body.len() {
        if body[k] == 92 and k + 1 < body.len() and (body[k + 1] == 36 or body[k + 1] == 96 or body[k + 1] == 34 or body[k + 1] == 92 or body[k + 1] == 10) {
            out.push(body[k + 1])
            k = k + 2
        } else {
            out.push(body[k])
            k = k + 1
        }
    }
    return out
}

fn safe(c: i64) -> bool {
    return (c >= 65 and c <= 90) or (c >= 97 and c <= 122) or (c >= 48 and c <= 57) or "_-.,:/@\n".codes().contains(c)
}

/// `Shellwords.escape(str)`.
pub fn escape(s: str) -> str {
    if s.len() == 0 {
        return "''"
    }
    var out = ""
    for c in s.codes() {
        if c == 10 {
            out = out + "'\n'"
        } else if safe(c) {
            out = out + c.to_char()
        } else {
            out = out + "\\" + c.to_char()
        }
    }
    return out
}

/// `Shellwords.join(args)`.
pub fn join(args: [str]) -> str {
    return args.map(|a| escape(a)).join(" ")
}

