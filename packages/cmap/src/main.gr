// The table that turns a character into a glyph.
//
// A font does not contain letters. It contains *glyphs* numbered from zero,
// and `cmap` is the lookup from Unicode to those numbers. Everything about
// text rendering that looks like magic starts here, and so does everything
// that looks like a bug: a missing character is a codepoint with no entry,
// and the box it draws is glyph 0, which every font has and which is called
// `.notdef`.
//
// ## Why there are several tables and not one
//
// A `cmap` holds several *subtables*, each tagged with a platform and an
// encoding, because the format is from 1990 and had to serve Macintosh and
// Windows at once. The ones that matter now:
//
//   * **(3, 1) format 4** — Unicode up to U+FFFF. Every font has it and
//     everything reads it.
//   * **(3, 10) format 12** — the full Unicode range, needed for anything
//     above U+FFFF: emoji, historic scripts, most CJK extensions.
//   * **(1, 0) format 0** — MacRoman, 256 entries. Obsolete and still
//     present, and reading it *first* is how a tool ends up unable to render
//     anything outside Latin-1.
//
// The rule is to prefer the widest: format 12 if there is one, then format 4.
//
// ## Format 4's segments, and the delta that wraps
//
// Format 4 stores ranges of codepoints as parallel arrays, and the glyph is
// usually `codepoint + idDelta` modulo 65536. The modulo is not decoration —
// a delta is stored as an unsigned 16-bit number and is routinely a large
// value standing for a small negative one. An implementation that does the
// addition in 32 bits gets glyph numbers in the tens of thousands for a font
// with three hundred glyphs.
//
// The other half of the format is `idRangeOffset`, which when non-zero makes
// the lookup an index into a shared array *from the position of the offset
// itself*. It is a pointer written as a distance, in a format with no
// pointers, and it is the single most awkward thing in the file.
//
// Checked against `fontTools.ttLib`'s own cmap for the character-to-glyph
// mapping of system fonts, and by building a format 4 subtable that
// fontTools reads back unchanged.

import sfnt

type CmapSubtable = {
    platform: i64,
    encoding: i64,
    format: i64,
    offset: i64,
    length: i64,
}

type CmapError =
    | TooShort()
    | NoSubtable()
    | UnsupportedFormat(format: i64)
    | NotSorted(at: i64)

fn read16(data: bytes, at: i64) -> i64 {
    if at + 2 > data.len() {
        return 0
    }
    return data.at(at).shl(8).bit_or(data.at(at + 1))
}

fn read32(data: bytes, at: i64) -> i64 {
    if at + 4 > data.len() {
        return 0
    }
    return data.at(at).shl(24).bit_or(data.at(at + 1).shl(16))
        .bit_or(data.at(at + 2).shl(8)).bit_or(data.at(at + 3))
}

/// The subtables a `cmap` holds, in the order listed.
pub fn subtables(data: bytes) -> [CmapSubtable] ! CmapError {
    if data.len() < 4 {
        fail(TooShort())
    }
    let count = read16(data, 2)
    var out: [CmapSubtable] = []
    var i = 0
    while i < count {
        let at = 4 + i * 8
        if at + 8 > data.len() {
            fail(TooShort())
        }
        let offset = read32(data, at + 4)
        if offset + 4 > data.len() {
            fail(TooShort())
        }
        out.push(CmapSubtable{
            platform: read16(data, at),
            encoding: read16(data, at + 2),
            format: read16(data, offset),
            offset: offset,
            length: subtable_length(data, offset),
        })
        i = i + 1
    }
    return out
}

fn subtable_length(data: bytes, offset: i64) -> i64 {
    let format = read16(data, offset)
    // Formats 8, 10, 12 and 13 have a 32-bit length four bytes further in,
    // because a 16-bit one could not hold a full Unicode table.
    if format >= 8 {
        return read32(data, offset + 4)
    }
    return read16(data, offset + 2)
}

/// The subtable to read, preferring the widest coverage.
///
/// Format 12 over format 4 over anything else, and a Unicode platform over a
/// Macintosh one. Reading the first subtable instead is how a tool ends up
/// unable to render emoji.
pub fn best_subtable(data: bytes) -> CmapSubtable ! CmapError {
    let all = try subtables(data)
    var best = 0 - 1
    var best_score = 0 - 1
    var i = 0
    while i < all.len() {
        let score = score_of(all[i])
        if score > best_score {
            best_score = score
            best = i
        }
        i = i + 1
    }
    if best < 0 {
        fail(NoSubtable())
    }
    return all[best]
}

fn score_of(t: CmapSubtable) -> i64 {
    var score = 0
    if t.format == 12 {
        score = 40
    }
    if t.format == 4 {
        score = 30
    }
    if t.format == 6 {
        score = 20
    }
    if t.format == 0 {
        score = 10
    }
    // Windows Unicode, then any Unicode platform, then the rest.
    if t.platform == 3 and (t.encoding == 10 or t.encoding == 1) {
        score = score + 4
    }
    if t.platform == 0 {
        score = score + 2
    }
    return score
}

/// The glyph for a codepoint, or 0 for `.notdef`.
pub fn glyph_for(data: bytes, subtable: CmapSubtable,
    codepoint: i64) -> i64 ! CmapError {
    if subtable.format == 4 {
        return lookup_format4(data, subtable.offset, codepoint)
    }
    if subtable.format == 12 {
        return lookup_format12(data, subtable.offset, codepoint)
    }
    if subtable.format == 6 {
        return lookup_format6(data, subtable.offset, codepoint)
    }
    if subtable.format == 0 {
        if codepoint < 0 or codepoint > 255 {
            return 0
        }
        return data.at(subtable.offset + 6 + codepoint)
    }
    fail(UnsupportedFormat(subtable.format))
}

/// The glyph for a codepoint, choosing the subtable itself.
pub fn glyph_of(data: bytes, codepoint: i64) -> i64 ! CmapError {
    let subtable = try best_subtable(data)
    return try glyph_for(data, subtable, codepoint)
}

fn lookup_format4(data: bytes, offset: i64, codepoint: i64) -> i64 {
    if codepoint > 0xFFFF or codepoint < 0 {
        return 0
    }
    let segments = read16(data, offset + 6) / 2
    let ends = offset + 14
    let starts = ends + segments * 2 + 2
    let deltas = starts + segments * 2
    let range_offsets = deltas + segments * 2
    var i = 0
    while i < segments {
        let end = read16(data, ends + i * 2)
        if codepoint <= end {
            let start = read16(data, starts + i * 2)
            if codepoint < start {
                return 0
            }
            let delta = read16(data, deltas + i * 2)
            let range_offset = read16(data, range_offsets + i * 2)
            if range_offset == 0 {
                // The wrap is the point: a delta is unsigned sixteen bits
                // and stands for a signed value.
                return (codepoint + delta).bit_and(0xFFFF)
            }
            // A distance from the offset's own position into a shared array.
            let at = range_offsets + i * 2 + range_offset +
            (codepoint - start) * 2
            let glyph = read16(data, at)
            if glyph == 0 {
                return 0
            }
            return (glyph + delta).bit_and(0xFFFF)
        }
        i = i + 1
    }
    return 0
}

fn lookup_format12(data: bytes, offset: i64, codepoint: i64) -> i64 {
    let groups = read32(data, offset + 12)
    var low = 0
    var high = groups - 1
    // Binary search: a format 12 table can have tens of thousands of groups
    // and a linear scan of it is visible in a page's rendering time.
    while low <= high {
        let middle = (low + high) / 2
        let at = offset + 16 + middle * 12
        let start = read32(data, at)
        let end = read32(data, at + 4)
        if codepoint < start {
            high = middle - 1
        } else {
            if codepoint > end {
                low = middle + 1
            } else {
                return read32(data, at + 8) + (codepoint - start)
            }
        }
    }
    return 0
}

fn lookup_format6(data: bytes, offset: i64, codepoint: i64) -> i64 {
    let first = read16(data, offset + 6)
    let count = read16(data, offset + 8)
    if codepoint < first or codepoint >= first + count {
        return 0
    }
    return read16(data, offset + 10 + (codepoint - first) * 2)
}

/// Every codepoint the subtable maps, with its glyph.
///
/// For a format 12 table over a CJK font that is a hundred thousand pairs, so
/// this is for inspection and conversion rather than for lookup — `glyph_for`
/// is the one to call per character.
pub fn all_mappings(data: bytes,
    subtable: CmapSubtable) -> [(i64, i64)] ! CmapError {
    var out: [(i64, i64)] = []
    if subtable.format == 4 {
        let segments = read16(data, subtable.offset + 6) / 2
        let ends = subtable.offset + 14
        let starts = ends + segments * 2 + 2
        var i = 0
        while i < segments {
            let start = read16(data, starts + i * 2)
            let end = read16(data, ends + i * 2)
            var c = start
            while c <= end and c <= 0xFFFF {
                let glyph = lookup_format4(data, subtable.offset, c)
                if glyph != 0 {
                    out.push((c, glyph))
                }
                if c == 0xFFFF {
                    break
                }
                c = c + 1
            }
            i = i + 1
        }
        return out
    }
    if subtable.format == 12 {
        let groups = read32(data, subtable.offset + 12)
        var i = 0
        while i < groups {
            let at = subtable.offset + 16 + i * 12
            let start = read32(data, at)
            let end = read32(data, at + 4)
            let glyph = read32(data, at + 8)
            var c = start
            while c <= end {
                out.push((c, glyph + (c - start)))
                c = c + 1
            }
            i = i + 1
        }
        return out
    }
    fail(UnsupportedFormat(subtable.format))
}

/// Whether the font has a glyph for every character of a string.
///
/// The check worth running before rendering: a missing character is not an
/// error anywhere, it is a box, and the box appears on a user's screen rather
/// than in a log.
pub fn missing_characters(data: bytes, text: str) -> [i64] {
    var out: [i64] = []
    let subtable = best_subtable(data) ?? CmapSubtable{ platform: 0,
        encoding: 0, format: 0, offset: 0, length: 0 }
    if subtable.format == 0 and subtable.length == 0 {
        return out
    }
    for c in text.codes() {
        let glyph = glyph_for(data, subtable, c) ?? 0
        if glyph == 0 {
            out.push(c)
        }
    }
    return out
}

// ------------------------------------------------------------- building

/// A format 4 subtable from a sorted list of `(codepoint, glyph)` pairs.
///
/// Consecutive codepoints mapping to consecutive glyphs become one segment
/// with a delta and no range offset, which is the compact case and the one
/// worth producing. The final segment mapping 0xFFFF to nothing is required
/// by the specification and its absence crashes several renderers.
pub fn build_format4(mappings: [(i64, i64)]) -> bytes ! CmapError {
    var segments: [(i64, i64, i64)] = []
    var i = 0
    while i < mappings.len() {
        if i > 0 and mappings[i].0 <= mappings[i - 1].0 {
            fail(NotSorted(i))
        }
        let start = mappings[i].0
        let first_glyph = mappings[i].1
        var end = start
        var k = i + 1
        while k < mappings.len() and mappings[k].0 == end + 1 and
        mappings[k].1 == first_glyph + (mappings[k].0 - start) {
            end = mappings[k].0
            k = k + 1
        }
        segments.push((start, end, (first_glyph - start).bit_and(0xFFFF)))
        i = k
    }
    segments.push((0xFFFF, 0xFFFF, 1))

    let count = segments.len()
    var entry_selector = 0
    while (1).shl(entry_selector + 1) <= count {
        entry_selector = entry_selector + 1
    }
    let search_range = (1).shl(entry_selector) * 2
    let length = 16 + count * 8
    var out: [i64] = []
    push16(out, 4)
    push16(out, length)
    push16(out, 0)
    push16(out, count * 2)
    push16(out, search_range)
    push16(out, entry_selector)
    push16(out, count * 2 - search_range)
    for s in segments {
        push16(out, s.1)
    }
    push16(out, 0)
    for s in segments {
        push16(out, s.0)
    }
    for s in segments {
        push16(out, s.2)
    }
    for _s in segments {
        push16(out, 0)
    }
    return bytes_of(out)
}

fn push16(inout out: [i64], value: i64) {
    out.push(value.ushr(8).bit_and(255))
    out.push(value.bit_and(255))
}

/// A whole `cmap` table holding one subtable, tagged Windows Unicode.
pub fn build_table(subtable: bytes) -> bytes {
    var out: [i64] = []
    push16(out, 0)
    push16(out, 1)
    push16(out, 3)
    push16(out, 1)
    for b in sfnt.write32(12).to_list() {
        out.push(b)
    }
    for b in subtable.to_list() {
        out.push(b)
    }
    return bytes_of(out)
}
