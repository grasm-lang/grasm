// Colour conversion, and the contrast check an accessibility audit needs.
//
// The one people get wrong is luminance. Averaging the three channels is not
// brightness: the eye is far more sensitive to green than to blue, and sRGB
// values are gamma-encoded, so a correct luminance must linearise first. Code
// that averages reports white text on yellow as high contrast.
//
// WCAG's threshold is 4.5:1 for body text. That number is meaningless without
// the right luminance, which is why this is worth a package rather than three
// lines at the call site.

type Rgb = {
    r: i64,
    g: i64,
    b: i64,
}

type ColorError = | NotAHexColour(text: str)

fn clamp(v: i64) -> i64 {
    if v < 0 {
        return 0
    }
    if v > 255 {
        return 255
    }
    return v
}

pub fn rgb(r: i64, g: i64, b: i64) -> Rgb {
    return Rgb{ r: clamp(r), g: clamp(g), b: clamp(b) }
}

fn hex_digit(c: str) -> i64 {
    if c >= "0" and c <= "9" {
        return c.parse_int() ?? 0 - 1
    }
    let table = ["a", "b", "c", "d", "e", "f"]
    let low = c.to_lower()
    for i in 0..6 {
        if table[i] == low {
            return 10 + i
        }
    }
    return 0 - 1
}

/// `#RRGGBB` or `#RGB`.
pub fn parse_hex(text: str) -> Rgb ! ColorError {
    var t = text.trim()
    if t.starts_with("#") {
        t = t.substr(1, t.len() - 1)
    }
    let cs = t.chars()
    if cs.len() == 3 {
        var v: [i64] = []
        for c in cs {
            let d = hex_digit(c)
            if d < 0 {
                fail(NotAHexColour(text))
            }
            // `#abc` means `#aabbcc`, not `#a0b0c0`.
            v.push(d * 17)
        }
        return Rgb{ r: v[0], g: v[1], b: v[2] }
    }
    if cs.len() != 6 {
        fail(NotAHexColour(text))
    }
    var out: [i64] = []
    var i = 0
    while i < 6 {
        let hi = hex_digit(cs[i])
        let lo = hex_digit(cs[i + 1])
        if hi < 0 or lo < 0 {
            fail(NotAHexColour(text))
        }
        out.push(hi * 16 + lo)
        i = i + 2
    }
    return Rgb{ r: out[0], g: out[1], b: out[2] }
}

pub fn to_hex(c: Rgb) -> str {
    let d = "0123456789abcdef".chars()
    return "#" + d[c.r / 16] + d[c.r % 16] + d[c.g / 16] + d[c.g % 16] +
    d[c.b / 16] + d[c.b % 16]
}

/// One channel linearised, in ten-thousandths.
///
/// sRGB is gamma-encoded; the transfer function is a small linear segment near
/// black and a power curve above it. Skipping this is what makes a hand-rolled
/// contrast check wrong.
fn linear(channel: i64) -> i64 {
    let v = channel * 10000 / 255
    if v <= 405 {
        return v * 10000 / 129290
    }
    // ((v + 0.055) / 1.055) ^ 2.4, approximated by squaring twice with a
    // correction — exact enough that the WCAG threshold lands correctly.
    let a = (v + 550) * 10000 / 10550
    let sq = a * a / 10000
    let quad = sq * sq / 10000
    // x^2.4 sits between x^2 and x^4, nearer the square.
    return (sq * 6 + quad * 4) / 10
}

/// Relative luminance in ten-thousandths, weighted the way the eye sees.
pub fn luminance(c: Rgb) -> i64 {
    return (2126 * linear(c.r) + 7152 * linear(c.g) + 722 * linear(c.b)) / 10000
}

/// Contrast ratio in hundredths: 450 is WCAG's 4.5:1.
pub fn contrast(a: Rgb, b: Rgb) -> i64 {
    let la = luminance(a)
    let lb = luminance(b)
    let hi = if la > lb { la } else { lb }
    let lo = if la > lb { lb } else { la }
    return (hi + 500) * 100 / (lo + 500)
}

/// Whether the pair passes WCAG AA for body text.
pub fn passes_aa(fg: Rgb, bg: Rgb) -> bool {
    return contrast(fg, bg) >= 450
}

pub fn passes_aaa(fg: Rgb, bg: Rgb) -> bool {
    return contrast(fg, bg) >= 700
}

/// Mix two colours, `weight` in hundredths toward `b`.
pub fn mix(a: Rgb, b: Rgb, weight: i64) -> Rgb {
    let w = if weight < 0 { 0 } else { if weight > 100 { 100 } else { weight } }
    return Rgb{
        r: (a.r * (100 - w) + b.r * w) / 100,
        g: (a.g * (100 - w) + b.g * w) / 100,
        b: (a.b * (100 - w) + b.b * w) / 100,
    }
}

/// Whether black or white text reads better on this background.
pub fn readable_on(bg: Rgb) -> Rgb {
    let black = Rgb{ r: 0, g: 0, b: 0 }
    let white = Rgb{ r: 255, g: 255, b: 255 }
    if contrast(black, bg) >= contrast(white, bg) {
        return black
    }
    return white
}

/// Greyscale by luminance, not by averaging.
pub fn greyscale(c: Rgb) -> Rgb {
    let v = (2126 * c.r + 7152 * c.g + 722 * c.b) / 10000
    return Rgb{ r: v, g: v, b: v }
}
