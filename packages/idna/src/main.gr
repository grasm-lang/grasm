fn table_b2() -> str {
    return table_b2_0() +
    table_b2_1() +
    table_b2_2() +
    table_b2_3() +
    table_b2_4() +
    table_b2_5() +
    table_b2_6() +
    table_b2_7() +
    table_b2_8()
}


type IdnaError =
    | IdnaProhibited(code: i64)
    | IdnaBidi(why: str)
    | IdnaTooLong(length: i64)
    | IdnaAlreadyEncoded(label: str)
    | IdnaNotPunycode(label: str)
    | IdnaNoRoundTrip(label: str)

let B1: [i64] = load_ranges(table_b1())
let PROHIBITED: [i64] = load_ranges(table_prohibited())
let D1: [i64] = load_ranges(table_d1())
let D2: [i64] = load_ranges(table_d2())
let B2: Map[i64, str] = load_map(table_b2())

/// Ranges packed as `lo-hi`, flattened into pairs.
fn load_ranges(packed: str) -> [i64] {
    var out: [i64] = []
    for entry in packed.split(" ") {
        if entry.len() == 0 {
            continue
        }
        let cut = entry.index_of("-") ?? -1
        if cut < 0 {
            continue
        }
        out.push(entry.substr(0, cut).parse_int_base(16) ?? 0)
        out.push(entry.substr(cut + 1, entry.len() - cut - 1)
                .parse_int_base(16) ?? 0)
    }
    return out
}

fn load_map(packed: str) -> Map[i64, str] {
    var out: Map[i64, str] = {}
    for entry in packed.split(" ") {
        if entry.len() == 0 {
            continue
        }
        let cut = entry.index_of(":") ?? -1
        if cut < 0 {
            continue
        }
        var text = ""
        for piece in entry.substr(cut + 1, entry.len() - cut - 1).split(",") {
            text = text + (piece.parse_int_base(16) ?? 63).to_char()
        }
        out.set(entry.substr(0, cut).parse_int_base(16) ?? 0, text)
    }
    return out
}

/// Whether `code` falls in one of the ranges, by binary search.
fn in_ranges(ranges: [i64], code: i64) -> bool {
    var low = 0
    var high = ranges.len() / 2 - 1
    while low <= high {
        let middle = (low + high) / 2
        if code < ranges[middle * 2] {
            high = middle - 1
        } else if code > ranges[middle * 2 + 1] {
            low = middle + 1
        } else {
            return true
        }
    }
    return false
}

/// A label prepared for encoding: mapped, normalised and checked.
pub fn nameprep(label: str) -> str ! IdnaError {
    var mapped = ""
    for code in label.codes() {
        if in_ranges(B1, code) {
            continue
        }
        match B2.get(code) {
            Some(text) -> mapped = mapped + text
            None -> mapped = mapped + code.to_char()
        }
    }
    let normalised = unicodenorm.nfkc(mapped)
    var any_rtl = false
    var any_ltr = false
    for code in normalised.codes() {
        if in_ranges(PROHIBITED, code) {
            fail(IdnaProhibited(code))
        }
        if in_ranges(D1, code) {
            any_rtl = true
        }
        if in_ranges(D2, code) {
            any_ltr = true
        }
    }
    if any_rtl {
        // A label may not mix directions, and one that is right-to-left has
        // to start and end that way — otherwise how it renders depends on
        // what is next to it.
        if any_ltr {
            fail(IdnaBidi("a label mixes directions"))
        }
        let codes = normalised.codes()
        if codes.len() > 0 and (not in_ranges(D1, codes[0]) or
            not in_ranges(D1, codes[codes.len() - 1])) {
            fail(IdnaBidi("a right-to-left label must begin and end so"))
        }
    }
    return normalised
}

fn is_ascii(text: str) -> bool {
    for code in text.codes() {
        if code >= 128 {
            return false
        }
    }
    return true
}

/// One label to its ASCII form.
pub fn to_ascii(label: str) -> str ! IdnaError {
    if is_ascii(label) {
        if label.len() == 0 or label.len() >= 64 {
            fail(IdnaTooLong(label.len()))
        }
        return label
    }
    let prepared = try nameprep(label)
    if is_ascii(prepared) {
        if prepared.len() == 0 or prepared.len() >= 64 {
            fail(IdnaTooLong(prepared.len()))
        }
        return prepared
    }
    if prepared.to_lower().starts_with("xn--") {
        fail(IdnaAlreadyEncoded(prepared))
    }
    let encoded = "xn--" + punycode.encode(prepared)
    if encoded.len() == 0 or encoded.len() >= 64 {
        fail(IdnaTooLong(encoded.len()))
    }
    return encoded
}

/// One label back to text.
///
/// The last step is the one that matters: whatever comes out of the decoder
/// is encoded again, and if it does not come back to what was there, the
/// label is refused. Without that check two different ASCII labels can
/// decode to the same name, which is exactly the confusion the encoding
/// exists to prevent.
pub fn to_unicode(label: str) -> str ! IdnaError {
    if label.len() > 1024 {
        fail(IdnaTooLong(label.len()))
    }
    var text = label
    if not is_ascii(text) {
        text = try nameprep(text)
        if not is_ascii(text) {
            fail(IdnaProhibited(0))
        }
    }
    if not text.to_lower().starts_with("xn--") {
        return text
    }
    let body = text.substr(4, text.len() - 4)
    var decoded = ""
    match punycode.decode(body) {
        Ok(result) -> decoded = result
        Err(_e) -> fail(IdnaNotPunycode(label))
    }
    let again = try to_ascii(decoded)
    if again.to_lower() != text.to_lower() {
        fail(IdnaNoRoundTrip(label))
    }
    return decoded
}

/// The separators a domain may use. Three of them are not a full stop.
fn is_separator(code: i64) -> bool {
    return code == 46 or code == 12290 or code == 65294 or code == 65377
}

fn split_labels(domain: str) -> [str] {
    var out: [str] = []
    var current = ""
    for code in domain.codes() {
        if is_separator(code) {
            out.push(current)
            current = ""
        } else {
            current = current + code.to_char()
        }
    }
    out.push(current)
    return out
}

/// A whole domain to its ASCII form.
///
/// A trailing dot is kept: `example.com.` is the fully qualified name and
/// means something slightly different from `example.com`.
pub fn encode_domain(domain: str) -> str ! IdnaError {
    if domain.len() == 0 {
        // Nothing is not a name and is not an error either; the codec every
        // other implementation was written against returns it unchanged.
        return ""
    }
    var labels = split_labels(domain)
    var trailing = false
    if labels.len() > 1 and labels[labels.len() - 1].len() == 0 {
        trailing = true
        labels.pop()
    }
    var out: [str] = []
    for label in labels {
        out.push(try to_ascii(label))
    }
    var joined = out.join(".")
    if trailing {
        joined = joined + "."
    }
    return joined
}

/// A whole domain back to text.
pub fn decode_domain(domain: str) -> str ! IdnaError {
    var labels = split_labels(domain)
    var trailing = false
    if labels.len() > 1 and labels[labels.len() - 1].len() == 0 {
        trailing = true
        labels.pop()
    }
    var out: [str] = []
    for label in labels {
        out.push(try to_unicode(label))
    }
    var joined = out.join(".")
    if trailing {
        joined = joined + "."
    }
    return joined
}

/// Whether a name survives the round trip, which is the question to ask
/// before showing a decoded name to a person.
pub fn round_trips(domain: str) -> bool {
    match encode_domain(domain) {
        Ok(ascii) -> {
            match decode_domain(ascii) {
                Ok(back) -> return back == domain.to_lower()
                Err(_e) -> return false
            }
        }
        Err(_e) -> return false
    }
}
