// Stop word lists, for seven languages, and an argument about using them.
//
// ## A stop word list is a choice, not a fact
//
// There is no set of English words that carry no meaning. "To be or not to
// be" is six words and every one of them is on the list below; removing them
// leaves nothing. "Not" is a stop word in almost every published list, and
// dropping it turns a review from a complaint into a recommendation.
//
// Removing them was originally about *space*: a 1970s index could not afford
// posting lists for `the`. That reason is gone — the index is cheap now — and
// modern search engines keep stop words so that phrase queries, quoted
// searches and negation still work. So the honest default is not to remove
// them, and the honest use of this package is narrower: as a filter for
// keyword extraction, topic modelling, and word clouds, where the frequent
// words genuinely are noise.
//
// ## The lists disagree, so which one matters
//
// NLTK's English list has 198 entries, Snowball's 174, scikit-learn's 318 —
// and scikit-learn's contains `computer`, `system` and `interest`, which are
// content words in most corpora and which it will silently delete from
// yours. This ships NLTK's lists, which are the Snowball ones plus contracted
// forms, and says so, because a list whose provenance is unrecorded is one
// nobody can reason about.
//
// A caller who knows their corpus should build their own: the words that
// carry no information *here* are the ones that appear in nearly every
// document, and `by_document_frequency` finds them from the corpus rather
// than from a list somebody wrote in 1971.
//
// Checked word for word against NLTK's `stopwords` corpus for all seven
// languages.

type StopwordSet = {
    present: Map[str, bool],
    language: str,
}

type StopwordError = | NoSuchLanguage(name: str)

pub fn languages() -> [str] {
    return ["english", "spanish", "french", "german", "italian",
        "portuguese", "dutch"]
}

/// NLTK's list for a language, as a sorted list of words.
pub fn words_for(language: str) -> [str] ! StopwordError {
    if language == "english" {
        return english_words().split(" ")
    }
    if language == "spanish" {
        return spanish_words().split(" ")
    }
    if language == "french" {
        return french_words().split(" ")
    }
    if language == "german" {
        return german_words().split(" ")
    }
    if language == "italian" {
        return italian_words().split(" ")
    }
    if language == "portuguese" {
        return portuguese_words().split(" ")
    }
    if language == "dutch" {
        return dutch_words().split(" ")
    }
    fail(NoSuchLanguage(language))
}

pub fn english() -> [str] {
    return english_words().split(" ")
}

/// The two dozen words nearly every list agrees on.
///
/// For a caller who wants the frequent function words gone and is not willing
/// to lose `not`, `no` or `only` — all of which the full lists remove and all
/// of which change what a sentence means.
pub fn minimal() -> [str] {
    return ["a", "an", "and", "are", "as", "at", "be", "by", "for", "from",
        "has", "he", "in", "is", "it", "its", "of", "on", "that", "the",
        "to", "was", "were", "will", "with"]
}

pub fn build(words: [str]) -> StopwordSet {
    var present = map()
    for w in words {
        if w != "" {
            present.set(w.to_lower(), true)
        }
    }
    return StopwordSet{ present: present, language: "" }
}

pub fn for_language(language: str) -> StopwordSet ! StopwordError {
    var out = build(try words_for(language))
    out.language = language
    return out
}

pub fn size(set: StopwordSet) -> i64 {
    return set.present.len()
}

pub fn is_stopword(set: StopwordSet, word: str) -> bool {
    return set.present.has(word.to_lower())
}

/// The same set with more words in it.
pub fn with_extra(set: StopwordSet, more: [str]) -> StopwordSet {
    var out = set
    var present = out.present
    for w in more {
        present.set(w.to_lower(), true)
    }
    out.present = present
    return out
}

/// The same set with some words taken out — the call to make before removing
/// `not` from a corpus about opinions.
pub fn without(set: StopwordSet, fewer: [str]) -> StopwordSet {
    var out = set
    var present = out.present
    for w in fewer {
        let _gone = present.delete(w.to_lower())
    }
    out.present = present
    return out
}

pub fn remove_from(set: StopwordSet, words: [str]) -> [str] {
    var out: [str] = []
    for w in words {
        if not is_stopword(set, w) {
            out.push(w)
        }
    }
    return out
}

pub fn only_stopwords(set: StopwordSet, words: [str]) -> [str] {
    var out: [str] = []
    for w in words {
        if is_stopword(set, w) {
            out.push(w)
        }
    }
    return out
}

/// What fraction of these words the set would remove.
///
/// Worth looking at before removing anything: a passage that is 70% stop
/// words has almost nothing left, and the number says so before the damage
/// is done.
pub fn coverage(set: StopwordSet, words: [str]) -> f64 {
    if words.len() == 0 {
        return 0.0
    }
    var hits = 0
    for w in words {
        if is_stopword(set, w) {
            hits = hits + 1
        }
    }
    return hits.as_f64() / words.len().as_f64()
}

/// Words appearing in at least `fraction` of the documents.
///
/// This is the list worth using: a word that is in nine documents out of ten
/// separates nothing, whatever a general-purpose list thinks of it, and a
/// word this finds is noise *in this corpus* rather than in somebody else's.
pub fn by_document_frequency(documents: [[str]], fraction: f64) -> [str] {
    if documents.len() == 0 {
        return []
    }
    var counts = map()
    for doc in documents {
        var seen = map()
        for w in doc {
            let key = w.to_lower()
            if not seen.has(key) {
                seen.set(key, true)
                counts.set(key, (counts.get(key) ?? 0) + 1)
            }
        }
    }
    let threshold = fraction * documents.len().as_f64()
    var out: [str] = []
    for entry in counts.entries() {
        if entry.1.as_f64() >= threshold {
            out.push(entry.0)
        }
    }
    out.sort()
    return out
}

/// Split text into lowercase words, which is what everything above expects.
///
/// An apostrophe stays inside a word, because the lists contain `don't` and
/// `it's` and splitting them first would leave `t` and `s` behind.
pub fn tokenize(text: str) -> [str] {
    var out: [str] = []
    var current = ""
    for c in text.to_lower().chars() {
        let letter = (c >= "a" and c <= "z") or (c >= "0" and c <= "9") or
        c == "'"
        if letter {
            current = current + c
        } else {
            if current != "" {
                out.push(current)
                current = ""
            }
        }
    }
    if current != "" {
        out.push(current)
    }
    return out
}
