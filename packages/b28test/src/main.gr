// The Grasm side of scripts/b28_diff.py: Windows paths against Python's
// ntpath, and txtar, httpproxy, bpf, the PROXY protocol and map tiles
// against the Go modules in scripts/lib/gomods. Arguments are separated by
// U+001F; byte strings travel as hex.
import winpath
import txtar
import httpproxy
import bpf
import proxyproto
import maptile

fn unit() -> str {
    "\u{1f}"
}

fn from_hex(text: str) -> bytes {
    var out: [i64] = []
    var i = 0
    while i + 1 < text.len() {
        out.push(text.substr(i, 2).parse_int_base(16) ?? 0)
        i = i + 2
    }
    bytes_of(out)
}

fn hex(raw: bytes) -> str {
    let digits = "0123456789abcdef"
    var out = ""
    for i in 0..raw.len() {
        out = out + digits.substr(raw.at(i) / 16, 1) + digits.substr(raw.at(i) % 16, 1)
    }
    out
}

fn show_err[T](r: T ! WinPathError, f: fn(T) -> str) -> str {
    match r {
        Ok(v) -> f(v)
        Err(_) -> "ERR"
    }
}

fn answer_win(what: str, args: [str]) -> str {
    let a = args[0]
    let u = unit()
    if what == "win.splitroot" {
        let (d, r, t) = winpath.splitroot(a)
        return d + u + r + u + t
    }
    if what == "win.split" {
        let (h, t) = winpath.split(a)
        return h + u + t
    }
    if what == "win.splitext" {
        let (h, t) = winpath.splitext(a)
        return h + u + t
    }
    if what == "win.splitdrive" {
        let (h, t) = winpath.splitdrive(a)
        return h + u + t
    }
    if what == "win.isabs" {
        return "{winpath.isabs(a)}"
    }
    if what == "win.join" {
        return winpath.join(args)
    }
    if what == "win.normpath" {
        return winpath.normpath(a)
    }
    if what == "win.normcase" {
        return winpath.normcase(a)
    }
    if what == "win.basename" {
        return winpath.basename(a) + u + winpath.dirname(a)
    }
    if what == "win.isreserved" {
        return "{winpath.isreserved(a)}"
    }
    if what == "win.commonpath" {
        return show_err(winpath.commonpath(args), |s| s)
    }
    show_err(winpath.relpath(a, args[1]), |s| s)
}

fn answer_txtar(data: bytes) -> str {
    let a = txtar.parse(data)
    var parts: [str] = [hex(a.comment)]
    for f in a.files {
        parts.push(hex(f.name.to_bytes()) + ":" + hex(f.data))
    }
    parts.join("|") + "/" + hex(txtar.format(a))
}

fn answer_proxy(cfg_text: str, urls: str) -> str {
    let f = cfg_text.split(unit())
    let cfg = ProxyConfig{ http_proxy: f[0], https_proxy: f[1], no_proxy: f[2], cgi: f[3] == "1" }
    var out: [str] = []
    for u in urls.split(unit()) {
        out.push(match httpproxy.proxy_for(cfg, u) {
            Err(_) -> "ERR"
            Ok(None) -> "-"
            Ok(Some(p)) -> p
        })
    }
    out.join(" ")
}

fn answer_bpf(program: str, packets: str) -> str {
    match bpf.decode(from_hex(program)) {
        Err(_) -> "BADLEN"
        Ok(prog) -> {
            let texts = prog.map(|i| bpf.text(i)).join(";")
            var runs: [str] = []
            let valid = match bpf.validate(prog) {
                Ok(_) -> true
                Err(_) -> false
            }
            if packets.len() > 0 {
                for p in packets.split(",") {
                    if not valid {
                        runs.push("INVALID")
                    } else {
                        runs.push(match bpf.run(prog, from_hex(p)) {
                            Ok(n) -> "{n}"
                            Err(_) -> "ERR"
                        })
                    }
                }
            }
            texts + "/" + runs.join(",")
        }
    }
}

fn answer_pp(data: bytes) -> str {
    match proxyproto.read(data) {
        Err(_) -> "ERR"
        Ok((h, used)) -> {
            let tl = match proxyproto.tlvs(h) {
                Ok(list) -> list.map(|t| "{t.kind}:" + hex(t.value)).join(",")
                Err(_) -> "TLVERR"
            }
            "v{h.version} c{h.command} t{h.transport} {hex(h.source)} {hex(h.destination)} {h.source_port} " +
            "{h.destination_port} {hex(h.source_path.to_bytes())} {hex(h.destination_path.to_bytes())} {tl} {used} " +
            hex(proxyproto.format(h))
        }
    }
}

fn tile_text(t: MapTile) -> str {
    "{t.x}.{t.y}.{t.z}"
}

fn answer_tile(text: str) -> str {
    let n = text.split(",")
    let lon = n[0].parse_float() ?? 0.0
    let lat = n[1].parse_float() ?? 0.0
    let z = n[2].parse_int() ?? 0
    let t = maptile.tile_at(lon, lat, z)
    let b = maptile.bounds(t)
    let (cx, cy) = maptile.center(t)
    let (lo, hi) = maptile.range(t, z + 2)
    let (up, _) = maptile.range(t, z / 2)
    let other = maptile.tile_at(0.0 - lon / 3.0, lat / 2.0, z)
    let qk = maptile.quadkey_number(t)
    let back = maptile.from_quadkey_number(qk, z)
    let quad = maptile.quadkey(t)
    let round = match maptile.from_quadkey(quad) {
        Ok(r) -> r == t
        Err(_) -> false
    }
    "{tile_text(t)} {b.west},{b.south},{b.east},{b.north} {cx},{cy} {tile_text(maptile.parent(t))} " +
    maptile.children(t).map(|c| tile_text(c)).join(",") + " {tile_text(lo)}-{tile_text(hi)} {tile_text(up)} " +
    "{tile_text(maptile.shared_parent(t, other))} {qk} {tile_text(back)} q{quad} {maptile.contains(t, other)} {round}"
}

fn answer(what: str, a: str, b: str) -> str {
    if what.starts_with("win.") {
        return answer_win(what, a.split(unit()))
    }
    if what == "txtar" {
        return answer_txtar(from_hex(a))
    }
    if what == "proxy" {
        return answer_proxy(a, b)
    }
    if what == "bpf" {
        return answer_bpf(a, b)
    }
    if what == "pp" {
        return answer_pp(from_hex(a))
    }
    answer_tile(a)
}

fn main() / {io} {
    let argv = args()
    var i = 0
    while i + 2 < argv.len() {
        print(answer(argv[i], argv[i + 1], argv[i + 2]))
        i = i + 3
    }
}
