// JSON.
//
// Project 13's parser, extracted, then given the half a library needs that a
// program does not: a way to reach into a document and a way to build one.
// Parsing and rendering were always here; `get`, `at`, `as_str` and their
// neighbours are what the six programs using this were writing by hand.
//
// It declares no capability. Text in, a value out — it opens no file, dials
// nothing, starts no process — so a program that depends on it does not
// acquire the ability to do any of those by depending on it ([T-CAPABILITY]).
//
// A parsed value is a `ref Json`, so a document shares its parts rather than
// copying them: an object holding the same list twice holds one list.

type Json =
    | JNull
    | JBool(b: bool)
    | JNum(n: f64)
    | JStr(s: str)
    | JList(items: [ref Json])
    | JObj(keys: [str], values: [ref Json])

type JsonError = { why: str, at: i64 }

// The reader works on the UTF-8 bytes, not on `chars()`: a list of one-letter
// strings is an allocation per character before parsing starts, and that made
// a 50 MB document take five seconds. Every byte the grammar cares about is
// ASCII, and UTF-8 never uses an ASCII byte inside a longer character, so the
// text between two of them is cut out whole and is still valid text.
//
// `JsonError.at` is a byte offset into the source.
type JsonReader = { b: bytes, i: i64 }

/// The byte at the cursor, or -1 at the end.
fn peek(p: JsonReader) -> i64 {
    if p.i < p.b.len() { p.b.at(p.i) } else { -1 }
}

fn shown(c: i64) -> str {
    if c < 0 { "end of input" } else if c < 32 or c > 126 { "byte {c}" } else { "`{c.to_char()}`" }
}

fn skip_ws(inout p: JsonReader) {
    while p.i < p.b.len() {
        let c = p.b.at(p.i)
        if c == 32 or c == 10 or c == 9 or c == 13 {
            p.i = p.i + 1
        } else {
            break
        }
    }
}

fn expect(inout p: JsonReader, c: i64) -> bool ! JsonError {
    if peek(p) != c {
        fail(JsonError{ why: "expected `{c.to_char()}` but found {shown(peek(p))}", at: p.i })
    }
    p.i = p.i + 1
    true
}

/// The literal `word` at the cursor -- `true`, `false` or `null`.
fn expect_word(inout p: JsonReader, word: str) -> bool ! JsonError {
    for c in word.codes() {
        let _e = try expect(p, c)
    }
    true
}

/// Four hex digits after `\u`, starting at `at`.
fn hex4(p: JsonReader, at: i64) -> i64 ! JsonError {
    if at + 4 > p.b.len() {
        fail(JsonError{ why: "truncated \\u escape", at: at })
    }
    var code = 0
    for k in 0..4 {
        let h = p.b.at(at + k)
        var v = 0
        if h >= 48 and h <= 57 { v = h - 48 }
        else if h >= 97 and h <= 102 { v = h - 87 }
        else if h >= 65 and h <= 70 { v = h - 55 }
        else { fail(JsonError{ why: "bad hex digit in \\u escape", at: at + k }) }
        code = code * 16 + v
    }
    code
}

fn parse_string(inout p: JsonReader) -> str ! JsonError {
    let _ok = try expect(p, 34)
    // Runs of plain text are cut out whole; only an escape is decoded.
    var pieces: [str] = []
    var run = p.i
    while true {
        if p.i >= p.b.len() {
            fail(JsonError{ why: "unterminated string", at: p.i })
        }
        let c = p.b.at(p.i)
        if c == 34 {
            let tail = p.b.slice(run, p.i).to_str()
            p.i = p.i + 1
            // The usual string has no escape, and is the one cut.
            if pieces.is_empty() {
                return tail
            }
            pieces.push(tail)
            break
        }
        if c < 32 {
            fail(JsonError{ why: "unescaped control character in a string", at: p.i })
        }
        if c != 92 {
            p.i = p.i + 1
            continue
        }
        pieces.push(p.b.slice(run, p.i).to_str())
        p.i = p.i + 1
        if p.i >= p.b.len() {
            fail(JsonError{ why: "unterminated escape", at: p.i })
        }
        let e = p.b.at(p.i)
        if e == 110 { pieces.push("\n") }
        else if e == 116 { pieces.push("\t") }
        else if e == 114 { pieces.push("\r") }
        else if e == 98 { pieces.push(8.to_char()) }
        else if e == 102 { pieces.push(12.to_char()) }
        else if e == 34 { pieces.push("\"") }
        else if e == 92 { pieces.push("\\") }
        else if e == 47 { pieces.push("/") }
        else if e == 117 {
            var code = try hex4(p, p.i + 1)
            p.i = p.i + 4
            // A character outside the first 65,536 is written as two escapes,
            // a high surrogate then a low one, and is one character: an emoji
            // is `😀`. Read one at a time, the first half is not a
            // character at all and converting it panicked. A half with no
            // partner is replaced by U+FFFD, as a decoder of UTF-16 does,
            // rather than refusing a document over one bad character.
            if code >= 55296 and code <= 56319 {
                let pair = p.i + 2 < p.b.len() and p.b.at(p.i + 1) == 92 and
                p.b.at(p.i + 2) == 117
                let lo = if pair {
                    try hex4(p, p.i + 3)
                } else {
                    -1
                }
                if lo >= 56320 and lo <= 57343 {
                    code = 65536 + (code - 55296) * 1024 + (lo - 56320)
                    p.i = p.i + 6
                } else {
                    code = 65533
                }
            } else if code >= 56320 and code <= 57343 {
                code = 65533
            }
            pieces.push(code.to_char())
        }
        else { fail(JsonError{ why: "unknown escape `\\{e.to_char()}`", at: p.i }) }
        p.i = p.i + 1
        run = p.i
    }
    pieces.join("")
}

fn is_digit(c: i64) -> bool {
    c >= 48 and c <= 57
}

fn parse_number(inout p: JsonReader) -> f64 ! JsonError {
    let start = p.i
    if peek(p) == 45 {
        p.i = p.i + 1
    }
    var digits = 0
    while p.i < p.b.len() {
        let c = p.b.at(p.i)
        if is_digit(c) {
            digits = digits + 1
            p.i = p.i + 1
        } else if c == 46 or c == 101 or c == 69 {
            p.i = p.i + 1
        } else if (c == 43 or c == 45) and p.i > start {
            let prev = p.b.at(p.i - 1)
            if prev == 101 or prev == 69 {
                p.i = p.i + 1
            } else {
                break
            }
        } else {
            break
        }
    }
    if digits == 0 {
        fail(JsonError{ why: "expected a number", at: start })
    }
    let text = p.b.slice(start, p.i).to_str()
    match text.parse_float() {
        Some(v) -> v
        None -> fail(JsonError{ why: "`{text}` is not a number", at: start })
    }
}

/// Gives back what a parse that failed part-way had already built.
fn free_all(vs: [ref Json]) {
    for v in vs {
        free(v)
    }
}

fn parse_value(inout p: JsonReader) -> ref Json ! JsonError {
    skip_ws(p)
    let c = peek(p)
    if c < 0 {
        fail(JsonError{ why: "unexpected end of input", at: p.i })
    }
    // A failure part-way through a list or an object releases the members
    // already read: they are references ([T-REF-GENERATIONAL]), and nothing
    // reaches them once the parse has failed, so nobody else could.
    if c == 123 {
        p.i = p.i + 1
        var keys: [str] = []
        var values: [ref Json] = []
        skip_ws(p)
        if peek(p) == 125 {
            p.i = p.i + 1
            return ref(JObj(keys, values))
        }
        var going = true
        while going {
            skip_ws(p)
            let k = match parse_string(p) {
                Ok(s) -> s
                Err(e) -> {
                    free_all(values)
                    fail(e)
                }
            }
            skip_ws(p)
            if peek(p) != 58 {
                free_all(values)
                fail(JsonError{ why: "expected `:` but found {shown(peek(p))}", at: p.i })
            }
            p.i = p.i + 1
            let v = match parse_value(p) {
                Ok(v) -> v
                Err(e) -> {
                    free_all(values)
                    fail(e)
                }
            }
            keys.push(k)
            values.push(v)
            skip_ws(p)
            if peek(p) == 44 {
                p.i = p.i + 1
            } else {
                going = false
            }
        }
        skip_ws(p)
        if peek(p) != 125 {
            free_all(values)
            fail(JsonError{ why: "expected `\}` but found {shown(peek(p))}", at: p.i })
        }
        p.i = p.i + 1
        return ref(JObj(keys, values))
    }
    if c == 91 {
        p.i = p.i + 1
        var items: [ref Json] = []
        skip_ws(p)
        if peek(p) == 93 {
            p.i = p.i + 1
            return ref(JList(items))
        }
        var going = true
        while going {
            let v = match parse_value(p) {
                Ok(v) -> v
                Err(e) -> {
                    free_all(items)
                    fail(e)
                }
            }
            items.push(v)
            skip_ws(p)
            if peek(p) == 44 {
                p.i = p.i + 1
            } else {
                going = false
            }
        }
        skip_ws(p)
        if peek(p) != 93 {
            free_all(items)
            fail(JsonError{ why: "expected `]` but found {shown(peek(p))}", at: p.i })
        }
        p.i = p.i + 1
        return ref(JList(items))
    }
    if c == 34 {
        let s = try parse_string(p)
        return ref(JStr(s))
    }
    if c == 116 {
        let _e = try expect_word(p, "true")
        return ref(JBool(true))
    }
    if c == 102 {
        let _e = try expect_word(p, "false")
        return ref(JBool(false))
    }
    if c == 110 {
        let _e = try expect_word(p, "null")
        return ref(JNull)
    }
    let n = try parse_number(p)
    ref(JNum(n))
}

/// A document, from its text.
///
/// A parsed document is references, and references are given back by the
/// program rather than collected ([T-REF-GENERATIONAL]): call `free` on the
/// document when done with it, or every parse holds its memory until the
/// program exits. A parse that fails gives back whatever it had built.
pub fn parse(src: str) -> ref Json ! JsonError {
    var p = JsonReader{ b: src.to_bytes(), i: 0 }
    let v = try parse_value(p)
    skip_ws(p)
    if p.i < p.b.len() {
        free(v)
        fail(JsonError{ why: "trailing input after the value", at: p.i })
    }
    v
}

/// Gives back a document and everything in it. Reading it afterwards panics
/// ([T-REF-STALE]) rather than reading freed memory -- so free a document only
/// once nothing still uses it, including a document built from parts of it
/// with `with_key` or `with_item`, which shares those parts.
pub fn free(v: ref Json) {
    if not alive(v) {
        return
    }
    match v {
        JList(items) -> free_all(items)
        JObj(keys, values) -> free_all(values)
        _ -> {}
    }
    release(v)
}

fn hex_digit(d: i64) -> str {
    if d < 10 { (48 + d).to_char() } else { (87 + d).to_char() }
}

/// The text of `s` as a JSON string body. Control characters are escaped too:
/// a raw one is not allowed inside a JSON string, so writing one out produced
/// a document no parser -- this one included -- would read back.
pub fn escape(s: str) -> str {
    let b = s.to_bytes()
    var plain = true
    for i in 0..b.len() {
        let c = b.at(i)
        if c < 32 or c == 34 or c == 92 {
            plain = false
            break
        }
    }
    if plain {
        return s
    }
    var pieces: [str] = []
    var run = 0
    for i in 0..b.len() {
        let c = b.at(i)
        if c < 32 or c == 34 or c == 92 {
            pieces.push(b.slice(run, i).to_str())
            run = i + 1
            if c == 34 { pieces.push("\\\"") }
            else if c == 92 { pieces.push("\\\\") }
            else if c == 10 { pieces.push("\\n") }
            else if c == 9 { pieces.push("\\t") }
            else if c == 13 { pieces.push("\\r") }
            else {
                pieces.push("\\u00" + hex_digit(c / 16) + hex_digit(c % 16))
            }
        }
    }
    pieces.push(b.slice(run, b.len()).to_str())
    pieces.join("")
}

/// A number that is a whole value prints without its `.0`, which is what makes
/// the round trip textually stable as well as structurally equal.
pub fn number_text(n: f64) -> str {
    if n == n.as_i64().as_f64() {
        return "{n.as_i64()}"
    }
    "{n}"
}

pub fn render(v: ref Json) -> str {
    match v {
        JNull -> "null"
        JBool(b) -> if b { "true" } else { "false" }
        JNum(n) -> number_text(n)
        JStr(s) -> "\"" + escape(s) + "\""
        JList(items) -> {
            var parts: [str] = []
            for it in items {
                parts.push(render(it))
            }
            "[" + parts.join(",") + "]"
        }
        JObj(keys, values) -> {
            var parts: [str] = []
            for i in 0..keys.len() {
                parts.push("\"" + escape(keys[i]) + "\":" + render(values[i]))
            }
            "\{" + parts.join(",") + "\}"
        }
    }
}

/// Whether two documents are the same *value*.
///
/// An object is an unordered collection, so `\{"a":1,"b":2\}` and
/// `\{"b":2,"a":1\}` are equal even though `render` writes them differently.
/// Comparing members by position instead would be faster and would make a
/// JSON Patch `test` fail against a server that reordered a response — which
/// servers do, because nothing tells them not to.
///
/// A duplicate key is compared against the first member of that name, which
/// is the one `parse` kept and the one `get` answers with.
pub fn equal(a: ref Json, b: ref Json) -> bool {
    match a {
        JNull -> match b { JNull -> true _ -> false }
        JBool(x) -> match b { JBool(y) -> x == y _ -> false }
        JNum(x) -> match b { JNum(y) -> x == y _ -> false }
        JStr(x) -> match b { JStr(y) -> x == y _ -> false }
        JList(xs) -> match b {
            JList(ys) -> {
                if xs.len() != ys.len() {
                    return false
                }
                for i in 0..xs.len() {
                    if not equal(xs[i], ys[i]) {
                        return false
                    }
                }
                true
            }
            _ -> false
        }
        JObj(xk, xv) -> match b {
            JObj(yk, yv) -> {
                if xk.len() != yk.len() {
                    return false
                }
                for i in 0..xk.len() {
                    var found = false
                    for j in 0..yk.len() {
                        if yk[j] == xk[i] {
                            found = equal(xv[i], yv[j])
                            break
                        }
                    }
                    if not found {
                        return false
                    }
                }
                true
            }
            _ -> false
        }
    }
}


// --- reaching into a document --------------------------------------------
//
// Every one of these answers `Option`, and none of them panics. A document is
// input somebody else chose: asking an object for a key it does not have, or a
// list for an index past its end, is an ordinary thing for a correct program to
// do and is not a bug in it.

/// What kind of value this is, as text: `null`, `bool`, `number`, `string`,
/// `list` or `object`.
pub fn kind(v: ref Json) -> str {
    match v {
        JNull -> "null"
        JBool(b) -> "bool"
        JNum(n) -> "number"
        JStr(s) -> "string"
        JList(items) -> "list"
        JObj(keys, values) -> "object"
    }
}

pub fn is_null(v: ref Json) -> bool {
    match v {
        JNull -> true
        _ -> false
    }
}

/// A member of an object. `None` when this is not an object, or has no such
/// key. A duplicate key answers with the first, which is what the parser kept.
pub fn get(v: ref Json, key: str) -> Option[ref Json] {
    match v {
        JObj(keys, values) -> {
            for i in 0..keys.len() {
                if keys[i] == key {
                    return Some(values[i])
                }
            }
            None
        }
        _ -> None
    }
}

/// An element of a list. `None` when this is not a list, or the index is
/// outside it. A negative index counts from the end.
pub fn at(v: ref Json, i: i64) -> Option[ref Json] {
    match v {
        JList(items) -> {
            let n = if i < 0 { items.len() + i } else { i }
            if n < 0 or n >= items.len() {
                return None
            }
            Some(items[n])
        }
        _ -> None
    }
}

/// A value several steps down, written `user.address.city`, with a number for
/// a list index: `items.0.name`.
///
/// A key containing a dot cannot be reached this way. That is the price of the
/// spelling, and `get` is the way to reach one.
pub fn path(v: ref Json, dotted: str) -> Option[ref Json] {
    var here = v
    for step in dotted.split(".") {
        if step.is_empty() {
            return None
        }
        let next = match step.parse_int() {
            Some(n) -> at(here, n)
            None -> get(here, step)
        }
        match next {
            Some(w) -> here = w
            None -> return None
        }
    }
    Some(here)
}

pub fn as_str(v: ref Json) -> Option[str] {
    match v {
        JStr(s) -> Some(s)
        _ -> None
    }
}

pub fn as_num(v: ref Json) -> Option[f64] {
    match v {
        JNum(n) -> Some(n)
        _ -> None
    }
}

/// A number that is a whole value, as an `i64`. `1.5` is `None` rather than
/// `1`: JSON has one number type and silently truncating is how a quantity
/// becomes a different quantity.
///
/// Numbers are held as `f64`, as JavaScript holds them, so a whole number of
/// 2^53 or more may not be the one the document wrote: `9007199254740993`
/// reads as `...992`. Past 2^53 - 1, the largest JavaScript calls safe, the
/// answer is `None` too, for the same reason.
pub fn as_int(v: ref Json) -> Option[i64] {
    match v {
        JNum(n) -> {
            if n != n.as_i64().as_f64() or n.abs() > 9007199254740991.0 {
                return None
            }
            Some(n.as_i64())
        }
        _ -> None
    }
}

pub fn as_bool(v: ref Json) -> Option[bool] {
    match v {
        JBool(b) -> Some(b)
        _ -> None
    }
}

/// How many elements a list has, or members an object has. Zero for anything
/// else — a scalar has no length, and `Option[i64]` for a question this common
/// costs every caller a `??` for a case none of them mean differently.
pub fn count(v: ref Json) -> i64 {
    match v {
        JList(items) -> items.len()
        JObj(keys, values) -> keys.len()
        _ -> 0
    }
}

/// An object's keys, in the order the document wrote them. Empty for anything
/// else.
pub fn keys_of(v: ref Json) -> [str] {
    match v {
        JObj(keys, values) -> keys
        _ -> []
    }
}

/// A list's elements, in order. Empty for anything else.
pub fn items_of(v: ref Json) -> [ref Json] {
    match v {
        JList(items) -> items
        _ -> []
    }
}

// --- building one ---------------------------------------------------------

pub fn null() -> ref Json {
    ref(JNull)
}

pub fn boolean(b: bool) -> ref Json {
    ref(JBool(b))
}

pub fn number(n: f64) -> ref Json {
    ref(JNum(n))
}

pub fn text(s: str) -> ref Json {
    ref(JStr(s))
}

pub fn list(items: [ref Json]) -> ref Json {
    ref(JList(items))
}

/// An object from parallel keys and values. A key with no value, or a value
/// with no key, is the caller having lost track of one of the two lists, so
/// the shorter one decides how many members there are.
pub fn object(keys: [str], values: [ref Json]) -> ref Json {
    var ks: [str] = []
    var vs: [ref Json] = []
    for i in 0..keys.len().min(values.len()) {
        ks.push(keys[i])
        vs.push(values[i])
    }
    ref(JObj(ks, vs))
}

/// An object with one member added or replaced. Answers a new value; the one
/// passed in is unchanged, which is what makes it safe to hand a document to
/// two callers.
///
/// A replaced key keeps its place. Dropping it and appending would be one line
/// shorter and would move the member to the end -- and since `render` writes
/// members in the order the object holds them, that changes the document's
/// text for a caller who only meant to change one value.
pub fn with_key(v: ref Json, key: str, value: ref Json) -> ref Json {
    var ks: [str] = []
    var vs: [ref Json] = []
    var replaced = false
    match v {
        JObj(keys, values) -> {
            for i in 0..keys.len() {
                ks.push(keys[i])
                if keys[i] == key {
                    vs.push(value)
                    replaced = true
                } else {
                    vs.push(values[i])
                }
            }
        }
        _ -> {}
    }
    if not replaced {
        ks.push(key)
        vs.push(value)
    }
    ref(JObj(ks, vs))
}

/// A list with one element on the end. Answers a new value, for the reason
/// `with_key` does.
pub fn with_item(v: ref Json, item: ref Json) -> ref Json {
    var items = match v {
        JList(xs) -> xs
        _ -> []
    }
    items.push(item)
    ref(JList(items))
}
