// Python's `urllib.parse`, as Python 3.13 splits, joins, quotes and
// unquotes, errors included.
//
// Python's URL functions are not RFC 3986 and say so: they keep
// compatibility with RFC 1808 and 2396 where code depends on it. A Python
// service's routing, its signed URLs and its form handling run through
// them, so a tool that checks or produces what that service reads has to
// split URLs the same way:
//
//   - A scheme is recognised only if it starts with an ASCII letter, and
//     `urlsplit` lowercases it; leading C0 controls and spaces are
//     stripped and tab, CR and LF removed anywhere, but trailing spaces
//     kept.
//   - `urlparse` splits `;params` off the last path segment, and only for
//     the schemes in Python's `uses_params` list; `urljoin` resolves only
//     for schemes in `uses_relative`, and returns the reference untouched
//     otherwise.
//   - A bracketed host is checked with `ipaddress` (or as an IPvFuture
//     literal), and a netloc whose NFKC form introduces `/?#@:` is
//     refused, Python's defence against `℀`-style confusables.
//   - `unquote` decodes only ASCII runs, each on its own, with UTF-8 and
//     U+FFFD for what does not decode; `quote` keeps `_.-~` and whatever
//     ASCII `safe` adds.
//   - `parse_qsl` drops blank values unless asked, honours a custom
//     separator and a field limit, and in strict mode refuses a field with
//     no `=`.
//
// Error texts embed Python's `repr` of a string, and `repr` needs to know
// which characters Python prints as they are; that table (Unicode 15.1)
// is generated from Python itself and checked against it by the gate.

import unicodenorm

type PySplit = { scheme: str, netloc: str, path: str, query: str, fragment: str }

type PyParse = { scheme: str, netloc: str, path: str, params: str, query: str, fragment: str }

/// Python's `ValueError`, its message whole.
type PyUrlError = | PyValueError(text: str)

// ---- repr

fn unprintable(c: i64) -> bool {
    let r = unprintable_ranges()
    var lo = 0
    var hi = r.len() / 2
    while lo < hi {
        let mid = (lo + hi) / 2
        if r[2 * mid + 1] < c {
            lo = mid + 1
        } else {
            hi = mid
        }
    }
    return lo < r.len() / 2 and r[2 * lo] <= c
}

fn hex_digits(v: i64, width: i64) -> str {
    let digits = "0123456789abcdef"
    var out = ""
    var x = v
    for _k in 0..width {
        out = digits.substr(x.bit_and(15), 1) + out
        x = x.ushr(4)
    }
    return out
}

/// Python's `repr` of a string.
pub fn py_repr(s: str) -> str {
    let cs = s.codes()
    let quote = if cs.contains(39) and not cs.contains(34) { 34 } else { 39 }
    var out = quote.to_char()
    for c in cs {
        if c == quote or c == 92 {
            out = out + "\\" + c.to_char()
        } else if c == 9 {
            out = out + "\\t"
        } else if c == 10 {
            out = out + "\\n"
        } else if c == 13 {
            out = out + "\\r"
        } else if c < 32 or c == 127 {
            out = out + "\\x" + hex_digits(c, 2)
        } else if c < 127 or not unprintable(c) {
            out = out + c.to_char()
        } else if c <= 255 {
            out = out + "\\x" + hex_digits(c, 2)
        } else if c <= 65535 {
            out = out + "\\u" + hex_digits(c, 4)
        } else {
            out = out + "\\U" + hex_digits(c, 8)
        }
    }
    return out + quote.to_char()
}

// ---- ipaddress.ip_address, as a yes or no

fn all_digits(s: str) -> bool {
    return s.len() > 0 and s.codes().all(|c| c >= 48 and c <= 57)
}

fn ipv4_ok(s: str) -> bool {
    let octets = s.split(".")
    if octets.len() != 4 {
        return false
    }
    for o in octets {
        if not all_digits(o) or o.len() > 3 or (o != "0" and o.starts_with("0")) or (o.parse_int() ?? 999) > 255 {
            return false
        }
    }
    return true
}

fn hextet_ok(h: str) -> bool {
    return h.len() > 0 and h.len() <= 4 and h.codes().all(|c| (c >= 48 and c <= 57) or (c >= 97 and c <= 102) or (c >= 65 and c <= 70))
}

fn ipv6_ok(s0: str) -> bool {
    var s = s0
    let pct = s.index_of("%") ?? (0 - 1)
    if pct >= 0 {
        let scope = s.substr(pct + 1, s.len() - pct - 1)
        if scope.len() == 0 or scope.contains("%") {
            return false
        }
        s = s.substr(0, pct)
    }
    if s.len() == 0 {
        return false
    }
    var parts = s.split(":")
    if parts.len() < 3 {
        return false
    }
    if parts[parts.len() - 1].contains(".") {
        if not ipv4_ok(parts[parts.len() - 1]) {
            return false
        }
        parts.pop()
        parts.push("0")
        parts.push("0")
    }
    if parts.len() > 9 {
        return false
    }
    var skip = 0 - 1
    for i in 1..(parts.len() - 1) {
        if parts[i].len() == 0 {
            if skip >= 0 {
                return false
            }
            skip = i
        }
    }
    var hi = parts.len()
    var lo = 0
    if skip >= 0 {
        hi = skip
        lo = parts.len() - skip - 1
        if parts[0].len() == 0 {
            hi = hi - 1
            if hi != 0 {
                return false
            }
        }
        if parts[parts.len() - 1].len() == 0 {
            lo = lo - 1
            if lo != 0 {
                return false
            }
        }
        if 8 - (hi + lo) < 1 {
            return false
        }
    } else if parts.len() != 8 or parts[0].len() == 0 or parts[parts.len() - 1].len() == 0 {
        return false
    }
    for i in 0..hi {
        if not hextet_ok(parts[i]) {
            return false
        }
    }
    for i in (parts.len() - lo)..parts.len() {
        if not hextet_ok(parts[i]) {
            return false
        }
    }
    return true
}

// ---- splitting

fn scheme_char(c: i64) -> bool {
    return (c >= 97 and c <= 122) or (c >= 65 and c <= 90) or (c >= 48 and c <= 57) or c == 43 or c == 45 or c == 46
}

fn c0_or_space(c: i64) -> bool {
    return c <= 32
}

fn find_from(s: str, c: str, from: i64) -> i64 {
    let cs = s.codes()
    let t = c.codes()[0]
    for i in from..cs.len() {
        if cs[i] == t {
            return i
        }
    }
    return 0 - 1
}

fn slice_text(s: str, a: i64, b: i64) -> str {
    let cs = s.codes()
    return cs.slice(a, b).map(|c| c.to_char()).join("")
}

fn char_len(s: str) -> i64 {
    return s.codes().len()
}

fn check_bracketed_host(h: str) ! PyUrlError {
    if h.starts_with("v") {
        let cs = h.codes()
        var i = 1
        while i < cs.len() and ((cs[i] >= 48 and cs[i] <= 57) or (cs[i] >= 97 and cs[i] <= 102) or (cs[i] >= 65 and cs[i] <= 70)) {
            i = i + 1
        }
        if i == 1 or i >= cs.len() or cs[i] != 46 or i + 1 >= cs.len() {
            fail(PyValueError("IPvFuture address is invalid"))
        }
        return
    }
    if ipv4_ok(h) {
        fail(PyValueError("An IPv4 address cannot be in brackets"))
    }
    if not ipv6_ok(h) {
        fail(PyValueError(py_repr(h) + " does not appear to be an IPv4 or IPv6 address"))
    }
}

fn check_netloc(netloc: str) ! PyUrlError {
    if netloc.len() == 0 or netloc.codes().all(|c| c < 128) {
        return
    }
    let n = netloc.replace("@", "").replace(":", "").replace("#", "").replace("?", "")
    let n2 = unicodenorm.nfkc(n)
    if n == n2 {
        return
    }
    for c in ["/", "?", "#", "@", ":"] {
        if n2.contains(c) {
            fail(PyValueError("netloc '" + netloc + "' contains invalid characters under NFKC normalization"))
        }
    }
}

/// `urlsplit(url, scheme, allow_fragments)`.
pub fn urlsplit(url0: str, default_scheme: str, allow_fragments: bool) -> PySplit ! PyUrlError {
    let cs0 = url0.codes()
    var a = 0
    while a < cs0.len() and c0_or_space(cs0[a]) {
        a = a + 1
    }
    var url = cs0.slice(a, cs0.len()).filter(|c| c != 9 and c != 10 and c != 13).map(|c| c.to_char()).join("")
    var scheme = default_scheme.codes().filter(|c| c != 9 and c != 10 and c != 13).map(|c| c.to_char()).join("")
    let sc = scheme.codes()
    var s0 = 0
    var s1 = sc.len()
    while s0 < s1 and c0_or_space(sc[s0]) {
        s0 = s0 + 1
    }
    while s1 > s0 and c0_or_space(sc[s1 - 1]) {
        s1 = s1 - 1
    }
    scheme = slice_text(scheme, s0, s1)
    var netloc = ""
    var query = ""
    var fragment = ""
    let uc = url.codes()
    let i = find_from(url, ":", 0)
    if i > 0 and uc[0] < 128 and ((uc[0] >= 97 and uc[0] <= 122) or (uc[0] >= 65 and uc[0] <= 90)) and uc.slice(0, i).all(|c| scheme_char(c)) {
        scheme = slice_text(url, 0, i).to_lower()
        url = slice_text(url, i + 1, uc.len())
    }
    if url.starts_with("//") {
        var delim = char_len(url)
        for c in ["/", "?", "#"] {
            let w = find_from(url, c, 2)
            if w >= 0 {
                delim = delim.min(w)
            }
        }
        netloc = slice_text(url, 2, delim)
        url = slice_text(url, delim, char_len(url))
        if netloc.contains("[") != netloc.contains("]") {
            fail(PyValueError("Invalid IPv6 URL"))
        }
        if netloc.contains("[") and netloc.contains("]") {
            let after = slice_text(netloc, find_from(netloc, "[", 0) + 1, char_len(netloc))
            let close = find_from(after, "]", 0)
            try check_bracketed_host(if close < 0 { after } else { slice_text(after, 0, close) })
        }
    }
    if allow_fragments and url.contains("#") {
        let h = find_from(url, "#", 0)
        fragment = slice_text(url, h + 1, char_len(url))
        url = slice_text(url, 0, h)
    }
    if url.contains("?") {
        let q = find_from(url, "?", 0)
        query = slice_text(url, q + 1, char_len(url))
        url = slice_text(url, 0, q)
    }
    try check_netloc(netloc)
    return PySplit{ scheme: scheme, netloc: netloc, path: url, query: query, fragment: fragment }
}

fn uses_params() -> [str] {
    return ["", "ftp", "hdl", "prospero", "http", "imap", "https", "shttp", "rtsp", "rtsps", "rtspu", "sip", "sips", "mms", "sftp", "tel"]
}

fn uses_relative() -> [str] {
    return ["", "ftp", "http", "gopher", "nntp", "imap", "wais", "file", "https", "shttp", "mms", "prospero", "rtsp", "rtsps", "rtspu", "sftp", "svn",
        "svn+ssh", "ws", "wss"]
}

fn uses_netloc() -> [str] {
    return ["", "ftp", "http", "gopher", "nntp", "telnet", "imap", "wais", "file", "mms", "https", "shttp", "snews", "prospero", "rtsp", "rtsps", "rtspu",
        "rsync", "svn", "svn+ssh", "sftp", "nfs", "git", "git+ssh", "ws", "wss", "itms-services"]
}

fn rfind(s: str, c: str) -> i64 {
    let cs = s.codes()
    let t = c.codes()[0]
    var i = cs.len() - 1
    while i >= 0 {
        if cs[i] == t {
            return i
        }
        i = i - 1
    }
    return 0 - 1
}

/// `urlparse(url, scheme, allow_fragments)`: urlsplit, then `;params` off
/// the last segment for the schemes that have them.
pub fn urlparse(url: str, default_scheme: str, allow_fragments: bool) -> PyParse ! PyUrlError {
    let sp = try urlsplit(url, default_scheme, allow_fragments)
    var path = sp.path
    var params = ""
    if uses_params().contains(sp.scheme) and path.contains(";") {
        let i = if path.contains("/") { find_from(path, ";", rfind(path, "/")) } else { find_from(path, ";", 0) }
        if i >= 0 {
            params = slice_text(path, i + 1, char_len(path))
            path = slice_text(path, 0, i)
        }
    }
    return PyParse{ scheme: sp.scheme, netloc: sp.netloc, path: path, params: params, query: sp.query, fragment: sp.fragment }
}

/// `urlunsplit(parts)`.
pub fn urlunsplit(p: PySplit) -> str {
    var url = p.path
    if p.netloc.len() > 0 {
        if url.len() > 0 and not url.starts_with("/") {
            url = "/" + url
        }
        url = "//" + p.netloc + url
    } else if url.starts_with("//") {
        url = "//" + url
    } else if p.scheme.len() > 0 and uses_netloc().contains(p.scheme) and (url.len() == 0 or url.starts_with("/")) {
        url = "//" + url
    }
    if p.scheme.len() > 0 {
        url = p.scheme + ":" + url
    }
    if p.query.len() > 0 {
        url = url + "?" + p.query
    }
    if p.fragment.len() > 0 {
        url = url + "#" + p.fragment
    }
    return url
}

/// `urlunparse(parts)`.
pub fn urlunparse(p: PyParse) -> str {
    let path = if p.params.len() > 0 { p.path + ";" + p.params } else { p.path }
    return urlunsplit(PySplit{ scheme: p.scheme, netloc: p.netloc, path: path, query: p.query, fragment: p.fragment })
}

/// `urljoin(base, url, allow_fragments)`.
pub fn urljoin(base: str, url: str, allow_fragments: bool) -> str ! PyUrlError {
    if base.len() == 0 {
        return url
    }
    if url.len() == 0 {
        return base
    }
    let b = try urlparse(base, "", allow_fragments)
    var r = try urlparse(url, b.scheme, allow_fragments)
    if r.scheme != b.scheme or not uses_relative().contains(r.scheme) {
        return url
    }
    if uses_netloc().contains(r.scheme) {
        if r.netloc.len() > 0 {
            return urlunparse(r)
        }
        r.netloc = b.netloc
    }
    if r.path.len() == 0 and r.params.len() == 0 {
        r.path = b.path
        r.params = b.params
        if r.query.len() == 0 {
            r.query = b.query
        }
        return urlunparse(r)
    }
    var base_parts = b.path.split("/")
    if base_parts[base_parts.len() - 1] != "" {
        base_parts.pop()
    }
    var segments: [str] = []
    if r.path.starts_with("/") {
        segments = r.path.split("/")
    } else {
        let joined = base_parts + r.path.split("/")
        segments = [joined[0]]
        for k in 1..(joined.len() - 1) {
            if joined[k].len() > 0 {
                segments.push(joined[k])
            }
        }
        if joined.len() > 1 {
            segments.push(joined[joined.len() - 1])
        }
    }
    var resolved: [str] = []
    for seg in segments {
        if seg == ".." {
            if resolved.len() > 0 {
                resolved.pop()
            }
        } else if seg != "." {
            resolved.push(seg)
        }
    }
    let last = segments[segments.len() - 1]
    if last == "." or last == ".." {
        resolved.push("")
    }
    let path = resolved.join("/")
    r.path = if path.len() == 0 { "/" } else { path }
    return urlunparse(r)
}

/// `urldefrag(url)`: the URL without its fragment, and the fragment.
pub fn urldefrag(url: str) -> (str, str) ! PyUrlError {
    if not url.contains("#") {
        return (url, "")
    }
    var p = try urlparse(url, "", true)
    let frag = p.fragment
    p.fragment = ""
    return (urlunparse(p), frag)
}

/// The `username`, `password` of a netloc, `None` when absent.
pub fn userinfo(netloc: str) -> (Option[str], Option[str]) {
    let at = rfind(netloc, "@")
    if at < 0 {
        return (None, None)
    }
    let info = slice_text(netloc, 0, at)
    let colon = find_from(info, ":", 0)
    if colon < 0 {
        return (Some(info), None)
    }
    return (Some(slice_text(info, 0, colon)), Some(slice_text(info, colon + 1, char_len(info))))
}

fn hostinfo(netloc: str) -> (str, Option[str]) {
    let at = rfind(netloc, "@")
    let host = slice_text(netloc, at + 1, char_len(netloc))
    var name = ""
    var port = ""
    let open = find_from(host, "[", 0)
    if open >= 0 {
        let bracketed = slice_text(host, open + 1, char_len(host))
        let close = find_from(bracketed, "]", 0)
        name = if close < 0 { bracketed } else { slice_text(bracketed, 0, close) }
        let after = if close < 0 { "" } else { slice_text(bracketed, close + 1, char_len(bracketed)) }
        let colon = find_from(after, ":", 0)
        port = if colon < 0 { "" } else { slice_text(after, colon + 1, char_len(after)) }
    } else {
        let colon = find_from(host, ":", 0)
        name = if colon < 0 { host } else { slice_text(host, 0, colon) }
        port = if colon < 0 { "" } else { slice_text(host, colon + 1, char_len(host)) }
    }
    return (name, if port.len() == 0 { None } else { Some(port) })
}

/// `.hostname`: lowercased, but not the zone after `%`.
pub fn hostname(netloc: str) -> Option[str] {
    let (name, _p) = hostinfo(netloc)
    if name.len() == 0 {
        return None
    }
    let pct = find_from(name, "%", 0)
    if pct < 0 {
        return Some(name.to_lower())
    }
    return Some(slice_text(name, 0, pct).to_lower() + slice_text(name, pct, char_len(name)))
}

/// `.port`: an int, None, or Python's ValueError.
pub fn port(netloc: str) -> Option[i64] ! PyUrlError {
    let (_n, p) = hostinfo(netloc)
    let text = match p {
        Some(t) -> t
        None -> return None
    }
    if not text.codes().all(|c| c >= 48 and c <= 57) {
        fail(PyValueError("Port could not be cast to integer value as " + py_repr(text)))
    }
    let v = text.parse_int() ?? 99999999
    if v > 65535 {
        fail(PyValueError("Port out of range 0-65535"))
    }
    return Some(v)
}
// ---- quoting

fn always_safe(c: i64) -> bool {
    return (c >= 97 and c <= 122) or (c >= 65 and c <= 90) or (c >= 48 and c <= 57) or c == 95 or c == 46 or c == 45 or c == 126
}

/// `quote_from_bytes(bs, safe)`: safe is ASCII only, as Python keeps it.
pub fn quote_from_bytes(bs: bytes, safe: str) -> str {
    let extra = safe.codes().filter(|c| c < 128)
    let digits = "0123456789ABCDEF"
    return bs.to_list().map(|b| if b < 128 and (always_safe(b) or extra.contains(b)) { b.to_char() } else {
        "%" + digits.substr(b.ushr(4), 1) + digits.substr(b.bit_and(15), 1)
    }).join("")
}

/// `quote(s, safe)`, UTF-8.
pub fn quote(s: str, safe: str) -> str {
    return quote_from_bytes(s.to_bytes(), safe)
}

/// `quote_plus(s, safe)`: spaces become `+`.
pub fn quote_plus(s: str, safe: str) -> str {
    if not s.contains(" ") {
        return quote(s, safe)
    }
    return quote(s, safe + " ").replace(" ", "+")
}

fn hex_val(c: i64) -> i64 {
    return if c >= 48 and c <= 57 { c - 48 } else if c >= 97 and c <= 102 { c - 87 } else if c >= 65 and c <= 70 { c - 55 } else { 0 - 1 }
}

/// `unquote_to_bytes(s)`: each `%XX` with two hex digits becomes its byte;
/// anything else after a `%` stays.
pub fn unquote_to_bytes(s: str) -> bytes {
    let b = s.to_bytes().to_list()
    var out: [i64] = []
    var i = 0
    while i < b.len() {
        if b[i] == 37 and i + 2 < b.len() + 0 and hex_val(b[i + 1]) >= 0 and hex_val(b[i + 2]) >= 0 {
            out.push(hex_val(b[i + 1]) * 16 + hex_val(b[i + 2]))
            i = i + 3
        } else {
            out.push(b[i])
            i = i + 1
        }
    }
    return bytes_of(out)
}

/// `unquote(s)`: ASCII runs unquoted and decoded as UTF-8 one at a time,
/// U+FFFD where they do not decode; other characters left as they are.
pub fn unquote(s: str) -> str {
    if not s.contains("%") {
        return s
    }
    var out = ""
    var run = ""
    for c in s.codes() {
        if c < 128 {
            run = run + c.to_char()
        } else {
            if run.len() > 0 {
                out = out + unquote_to_bytes(run).to_str()
                run = ""
            }
            out = out + c.to_char()
        }
    }
    if run.len() > 0 {
        out = out + unquote_to_bytes(run).to_str()
    }
    return out
}

/// `unquote_plus(s)`.
pub fn unquote_plus(s: str) -> str {
    return unquote(s.replace("+", " "))
}

/// The options of `parse_qsl`.
type PyQueryOptions = { keep_blank_values: bool, strict_parsing: bool, max_num_fields: i64, separator: str }

pub fn default_query_options() -> PyQueryOptions {
    return PyQueryOptions{ keep_blank_values: false, strict_parsing: false, max_num_fields: 0 - 1, separator: "&" }
}

/// `parse_qsl(qs, ...)`: the pairs in order. A negative `max_num_fields`
/// is Python's `None`.
pub fn parse_qsl(qs: str, o: PyQueryOptions) -> [(str, str)] ! PyUrlError {
    if o.separator.len() == 0 {
        fail(PyValueError("Separator must be of type string or bytes."))
    }
    if qs.len() == 0 {
        return []
    }
    let fields = qs.split(o.separator)
    if o.max_num_fields >= 0 and o.max_num_fields < fields.len() {
        fail(PyValueError("Max number of fields exceeded"))
    }
    var out: [(str, str)] = []
    for nv in fields {
        if nv.len() == 0 and not o.strict_parsing {
            continue
        }
        let eq = find_from(nv, "=", 0)
        if eq < 0 and o.strict_parsing {
            fail(PyValueError("bad query field: " + py_repr(nv)))
        }
        let name = if eq < 0 { nv } else { slice_text(nv, 0, eq) }
        let value = if eq < 0 { "" } else { slice_text(nv, eq + 1, char_len(nv)) }
        if value.len() > 0 or o.keep_blank_values {
            out.push((unquote_plus(name), unquote_plus(value)))
        }
    }
    return out
}

/// `parse_qs(qs, ...)`: names in first-seen order, each with its values.
pub fn parse_qs(qs: str, o: PyQueryOptions) -> [(str, [str])] ! PyUrlError {
    var out: [(str, [str])] = []
    for p in try parse_qsl(qs, o) {
        var found = false
        for i in 0..out.len() {
            if not found and out[i].0 == p.0 {
                var vs = out[i].1
                vs.push(p.1)
                out[i] = (p.0, vs)
                found = true
            }
        }
        if not found {
            out.push((p.0, [p.1]))
        }
    }
    return out
}

/// `urlencode(pairs, doseq=True)` over string values: each value of a
/// name its own field, everything through `quote_plus`.
pub fn urlencode(pairs: [(str, [str])], safe: str) -> str {
    var parts: [str] = []
    for p in pairs {
        let k = quote_plus(p.0, safe)
        for v in p.1 {
            parts.push(k + "=" + quote_plus(v, safe))
        }
    }
    return parts.join("&")
}

