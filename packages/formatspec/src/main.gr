// Python's format specification, the part after the colon in `{n:>8,d}`.
//
// Every templating layer eventually needs this. `packages/template` can
// substitute a value into a string and `packages/numfmt` can group digits,
// and between them sits the thing people actually write: a compact spec
// saying how wide, which way aligned, padded with what, in which base, with
// which separator. It is not a big grammar and it is a precisely defined
// one, which makes "close enough" a bad answer — a report whose columns are
// one character narrower than another tool's is a report that does not line
// up.
//
// The grammar, in order, all parts optional:
//
//     [[fill]align][sign][#][0][width][grouping][.precision][type]
//
// The two details that catch people out:
//
//   - **Fill is only recognised when an alignment follows it.** In `{:*<8}`
//     the fill is `*`; in `{:*8}` there is no alignment, so `*` is read as
//     the start of the width and the whole spec is invalid. The parser has
//     to look two characters ahead.
//   - **A leading `0` is not a width digit.** `{:08}` means "pad with zeros,
//     aligned after the sign", which is `{:0=8}` — so `-42` becomes
//     `-0000042` and not `000000-42`. Treating the zero as part of the width
//     gives 8, which is the same number and the wrong padding.
//
// Floats were left out of this until `packages/shortestfloat` existed,
// because doing them means correctly-rounded decimal conversion and
// claiming it without doing it would be worse than leaving it out. They are
// here now, and the presentation types are where the remaining surprises
// live:
//
//   `f`   fixed, six places unless told otherwise
//   `e`   scientific, six places, and the exponent always at least two
//         digits — `1e+05`, never `1e+5`
//   `g`   whichever of the two is shorter, by a rule about the exponent,
//         and then with the trailing zeros taken off
//   `%`   multiplied by a hundred and formatted as `f`, with a `%` after
//   ``    no type at all, which is `repr` and not `g`
//
// `g` is the one worth reading twice. Its precision counts *significant*
// digits rather than places, a precision of zero means one, and the choice
// between fixed and scientific is made on the exponent of the value after
// rounding — so `{:.2g}` of 99.9 is `1e+02`, because rounding to two digits
// moved the exponent.
//
// Checked against Python's `format()`.

import shortestfloat

type SpecError =
    | SpecInvalid(spec: str)
    | SpecUnknownType(kind: str)
    | SpecNotAllowed(why: str)

/// A parsed specification.
type FormatSpec = {
    fill: str,
    /// `<`, `>`, `^`, `=`, or empty for the type's default.
    align: str,
    /// `+`, `-`, ` `, or empty.
    sign: str,
    /// The `#` that puts `0b`, `0o` or `0x` in front.
    alternate: bool,
    /// A bare leading `0`. For a number that means `0=`; for a string it
    /// means the fill is `0` and the alignment is still the default, which
    /// is why it cannot be stored as an alignment.
    zero: bool,
    /// `,` or `_`, or empty.
    grouping: str,
    width: i64,
    /// -1 for "not given".
    precision: i64,
    kind: str,
}

fn is_digit(c: str) -> bool {
    return c >= "0" and c <= "9"
}

fn is_align(c: str) -> bool {
    return c == "<" or c == ">" or c == "^" or c == "="
}

/// The specification `text` describes.
pub fn parse(text: str) -> FormatSpec ! SpecError {
    var spec = FormatSpec{
        fill: " ",
        align: "",
        sign: "",
        alternate: false,
        zero: false,
        grouping: "",
        width: 0,
        precision: 0 - 1,
        kind: "",
    }
    var i = 0
    // Fill is whatever precedes an alignment, and is only a fill because an
    // alignment follows it.
    if text.len() >= 2 and is_align(text.substr(1, 1)) {
        spec.fill = text.substr(0, 1)
        spec.align = text.substr(1, 1)
        i = 2
    } else if text.len() >= 1 and is_align(text.substr(0, 1)) {
        spec.align = text.substr(0, 1)
        i = 1
    }
    if i < text.len() {
        let c = text.substr(i, 1)
        if c == "+" or c == "-" or c == " " {
            spec.sign = c
            i = i + 1
        }
    }
    if i < text.len() and text.substr(i, 1) == "#" {
        spec.alternate = true
        i = i + 1
    }
    if i < text.len() and text.substr(i, 1) == "0" {
        // Not a width digit. For a number this is `0=` written shorter; for
        // a string it is only a fill, and `0=` spelled out is refused.
        if spec.align == "" {
            spec.fill = "0"
            spec.zero = true
        }
        i = i + 1
    }
    var digits = ""
    while i < text.len() and is_digit(text.substr(i, 1)) {
        digits = digits + text.substr(i, 1)
        i = i + 1
    }
    if digits.len() > 0 {
        spec.width = digits.parse_int() ?? 0
    }
    if i < text.len() {
        let c = text.substr(i, 1)
        if c == "," or c == "_" {
            spec.grouping = c
            i = i + 1
        }
    }
    if i < text.len() and text.substr(i, 1) == "." {
        i = i + 1
        var places = ""
        while i < text.len() and is_digit(text.substr(i, 1)) {
            places = places + text.substr(i, 1)
            i = i + 1
        }
        if places.len() == 0 {
            fail(SpecInvalid(text))
        }
        spec.precision = places.parse_int() ?? 0
    }
    if i < text.len() {
        spec.kind = text.substr(i, 1)
        i = i + 1
    }
    if i != text.len() {
        fail(SpecInvalid(text))
    }
    return spec
}

fn digits_for(kind: str) -> str {
    if kind == "X" {
        return "0123456789ABCDEF"
    }
    return "0123456789abcdef"
}

fn base_for(kind: str) -> i64 {
    if kind == "b" {
        return 2
    }
    if kind == "o" {
        return 8
    }
    if kind == "x" or kind == "X" {
        return 16
    }
    return 10
}

fn prefix_for(kind: str) -> str {
    if kind == "b" {
        return "0b"
    }
    if kind == "o" {
        return "0o"
    }
    if kind == "x" {
        return "0x"
    }
    if kind == "X" {
        return "0X"
    }
    return ""
}

/// The digits of `value` in `base`, without a sign.
fn digits_of(value: i64, base: i64, kind: str) -> str {
    if value == 0 {
        return "0"
    }
    let table = digits_for(kind)
    var out = ""
    var left = value
    while left > 0 {
        out = table.substr(left % base, 1) + out
        left = left / base
    }
    return out
}

/// `text` with `separator` every three digits from the right — or every four
/// for `_` in a base that is not ten, which is what Python does.
fn grouped(text: str, separator: str, every: i64) -> str {
    if separator == "" {
        return text
    }
    var out = ""
    var seen = 0
    var i = text.len() - 1
    while i >= 0 {
        if seen > 0 and seen % every == 0 {
            out = separator + out
        }
        out = text.substr(i, 1) + out
        seen = seen + 1
        i = i - 1
    }
    return out
}

fn pad(body: str, sign: str, spec: FormatSpec) -> str {
    let whole = sign + body
    if whole.len() >= spec.width {
        return whole
    }
    let missing = spec.width - whole.len()
    if spec.align == "=" {
        return sign + repeat(spec.fill, missing) + body
    }
    if spec.align == "<" {
        return whole + repeat(spec.fill, missing)
    }
    if spec.align == "^" {
        let left = missing / 2
        return repeat(spec.fill, left) + whole +
        repeat(spec.fill, missing - left)
    }
    return repeat(spec.fill, missing) + whole
}

fn repeat(text: str, times: i64) -> str {
    var out = ""
    var i = 0
    while i < times {
        out = out + text
        i = i + 1
    }
    return out
}

/// `value` formatted by `text`, which must be a specification for a number.
pub fn format_int(value: i64, text: str) -> str ! SpecError {
    var spec = try parse(text)
    if spec.kind == "s" {
        fail(SpecNotAllowed("`s` is for strings"))
    }
    if spec.precision >= 0 {
        fail(SpecNotAllowed("precision means nothing for an integer"))
    }
    if spec.align == "" {
        // Numbers are right-aligned unless told otherwise, and a bare `0`
        // means the padding goes after the sign.
        spec.align = if spec.zero { "=" } else { ">" }
    }
    if spec.kind == "c" {
        if spec.sign != "" {
            fail(SpecNotAllowed("a sign means nothing for `c`"))
        }
        if spec.grouping != "" {
            fail(SpecNotAllowed("grouping means nothing for `c`"))
        }
        if spec.alternate {
            fail(SpecNotAllowed("`#` means nothing for `c`"))
        }
        if value < 0 or value > 1114111 or
        (value >= 55296 and value <= 57343) {
            fail(SpecNotAllowed("not a character"))
        }
        return pad(value.to_char(), "", spec)
    }
    if spec.kind == "n" and spec.grouping != "" {
        // `n` is `d` with the locale's own separator. There is no locale
        // here, so it is `d` — but it still brings its own separator, and
        // asking for a second one is refused.
        fail(SpecNotAllowed("`n` brings its own separator"))
    }
    let base = base_for(spec.kind)
    if spec.kind != "" and spec.kind != "d" and spec.kind != "n" and
    base == 10 {
        fail(SpecUnknownType(spec.kind))
    }
    if spec.grouping == "," and base != 10 {
        fail(SpecNotAllowed("`,` needs a decimal presentation"))
    }
    var magnitude = value
    var sign = ""
    if value < 0 {
        magnitude = 0 - value
        sign = "-"
    } else if spec.sign == "+" {
        sign = "+"
    } else if spec.sign == " " {
        sign = " "
    }
    var digits = digits_of(magnitude, base, spec.kind)
    var prefix = ""
    if spec.alternate {
        prefix = prefix_for(spec.kind)
    }
    let every = if base == 10 { 3 } else { 4 }
    if spec.align != "=" {
        return pad(prefix + grouped(digits, spec.grouping, every), sign,
            spec)
    }
    // `=` puts the padding between the sign and the digits, and the prefix
    // counts as part of the sign for that purpose: `0x0000ff`, never
    // `0000 0xff`.
    let head = sign + prefix
    let target = spec.width - head.len()
    if spec.fill != "0" or spec.grouping == "" {
        var body = grouped(digits, spec.grouping, every)
        if body.len() >= target {
            return head + body
        }
        if spec.fill == "0" {
            return head + repeat("0", target - body.len()) + body
        }
        return head + repeat(spec.fill, target - body.len()) + body
    }
    // Zero padding under a separator is itself separated, so `{:012,}` of
    // nothing is `0,000,000,000` — thirteen characters for a width of
    // twelve, because a group is never left short and a leading separator is
    // never written.
    while grouped(digits, spec.grouping, every).len() < target {
        digits = "0" + digits
    }
    return head + grouped(digits, spec.grouping, every)
}

/// `value` formatted by `text`, which must be a specification for a string.
pub fn format_str(value: str, text: str) -> str ! SpecError {
    var spec = try parse(text)
    if spec.kind != "" and spec.kind != "s" {
        fail(SpecUnknownType(spec.kind))
    }
    if spec.sign != "" {
        fail(SpecNotAllowed("a sign means nothing for a string"))
    }
    if spec.grouping != "" {
        fail(SpecNotAllowed("grouping means nothing for a string"))
    }
    if spec.alternate {
        fail(SpecNotAllowed("`#` means nothing for a string"))
    }
    if spec.align == "=" {
        fail(SpecNotAllowed("`=` means nothing for a string"))
    }
    var body = value
    if spec.precision >= 0 and body.len() > spec.precision {
        body = body.substr(0, spec.precision)
    }
    if spec.align == "" {
        spec.align = "<"
    }
    return pad(body, "", spec)
}

/// Whether `text` is a specification this understands at all.
pub fn is_valid(text: str) -> bool {
    match parse(text) {
        Ok(_spec) -> return true
        Err(_e) -> return false
    }
}

/// The digits of `value` laid out as fixed notation with `places` after the
/// point, without a sign.
fn fixed_body(value: f64, places: i64) -> str {
    let text = shortestfloat.fixed(value, places)
    if text.starts_with("-") {
        return text.substr(1, text.len() - 1)
    }
    return text
}

/// The exponent part: `e`, a sign, and at least two digits.
fn exponent_text(power: i64, marker: str) -> str {
    var value = power
    var sign = "+"
    if value < 0 {
        sign = "-"
        value = 0 - value
    }
    var digits = value.to_str()
    if digits.len() < 2 {
        digits = "0" + digits
    }
    return marker + sign + digits
}

/// `value` in scientific notation with `places` digits after the point.
fn scientific_body(value: f64, places: i64, marker: str) -> str {
    let found = shortestfloat.significant(value, places + 1)
    var body = found.digits.substr(0, 1)
    if places > 0 {
        body = body + "." + found.digits.substr(1, places)
    }
    return body + exponent_text(found.point - 1, marker)
}

/// The `g` rule: significant digits, and the choice between the two
/// notations made on the exponent *after* rounding.
///
/// `ceiling` is the exponent at which it switches to scientific. It is the
/// precision for `g` and one less for a specification with a precision and
/// no type at all, which is why `{:.1}` of zero is `0e+00` and `{:.1g}` is
/// `0`.
fn general_body(value: f64, precision: i64, marker: str, alternate: bool,
    ceiling: i64) -> str {
    var digits = precision
    if digits < 1 {
        digits = 1
    }
    let found = shortestfloat.significant(value, digits)
    let power = found.point - 1
    if power < 0 - 4 or power >= ceiling {
        let body = scientific_body(value, digits - 1, marker)
        if alternate {
            return body
        }
        return strip_zeros_before(body, marker)
    }
    let body = fixed_body(value, digits - 1 - power)
    if alternate {
        return body
    }
    return strip_zeros_before(body, "")
}

/// Trailing zeros after the point taken off, and the point with them —
/// which `g` does and `#g` does not.
fn strip_zeros_before(text: str, marker: str) -> str {
    var head = text
    var tail = ""
    if marker.len() > 0 {
        let at = head.index_of(marker) ?? -1
        if at >= 0 {
            tail = head.substr(at, head.len() - at)
            head = head.substr(0, at)
        }
    }
    if (head.index_of(".") ?? -1) < 0 {
        return head + tail
    }
    var end = head.len()
    while end > 0 and head.substr(end - 1, 1) == "0" {
        end = end - 1
    }
    if end > 0 and head.substr(end - 1, 1) == "." {
        end = end - 1
    }
    return head.substr(0, end) + tail
}

fn is_special(value: f64) -> str {
    let found = shortestfloat.parts(value)
    if found.special == "-inf" {
        return "inf"
    }
    return found.special
}

/// `value` formatted by `text`, which must be a specification for a number.
pub fn format_float(value: f64, text: str) -> str ! SpecError {
    var spec = try parse(text)
    if spec.kind == "s" or spec.kind == "c" or spec.kind == "b" or
    spec.kind == "o" or spec.kind == "x" or spec.kind == "X" or
    spec.kind == "d" {
        fail(SpecNotAllowed("`" + spec.kind + "` is for integers"))
    }
    if spec.align == "" {
        spec.align = if spec.zero { "=" } else { ">" }
    }
    var sign = ""
    if shortestfloat.parts(value).negative {
        sign = "-"
    } else if spec.sign == "+" {
        sign = "+"
    } else if spec.sign == " " {
        sign = " "
    }
    let special = is_special(value)
    if special != "" {
        var word = special
        if spec.kind == "E" or spec.kind == "F" or spec.kind == "G" {
            word = word.to_upper()
        }
        if spec.kind == "%" {
            word = word + "%"
        }
        return place(word, sign, spec)
    }
    var body = ""
    var magnitude = value
    if sign == "-" {
        magnitude = 0.0 - value
    }
    if spec.kind == "f" or spec.kind == "F" {
        body = fixed_body(magnitude, default_precision(spec, 6))
    } else if spec.kind == "e" {
        body = scientific_body(magnitude, default_precision(spec, 6), "e")
    } else if spec.kind == "E" {
        body = scientific_body(magnitude, default_precision(spec, 6), "E")
    } else if spec.kind == "%" {
        body = fixed_body(magnitude * 100.0,
            default_precision(spec, 6)) + "%"
    } else if spec.kind == "g" or spec.kind == "n" {
        let places = default_precision(spec, 6)
        body = general_body(magnitude, places, "e", spec.alternate,
            larger(places, 1))
    } else if spec.kind == "G" {
        let places = default_precision(spec, 6)
        body = general_body(magnitude, places, "E", spec.alternate,
            larger(places, 1))
    } else if spec.kind == "" {
        if spec.precision >= 0 {
            // A precision with no type is `g` that switches to an exponent
            // one step sooner and keeps at least one digit after the point.
            body = with_point(general_body(magnitude, spec.precision, "e",
                spec.alternate, larger(spec.precision, 1) - 1))
        } else {
            // No type and no precision is `repr`.
            body = shortestfloat.repr(magnitude)
        }
    } else {
        fail(SpecUnknownType(spec.kind))
    }
    if spec.alternate {
        // The alternate form keeps the point even with nothing after it.
        body = with_bare_point(body)
    }
    if spec.grouping != "" {
        body = grouped_before_point(body, spec.grouping)
    }
    return place(body, sign, spec)
}

fn larger(a: i64, b: i64) -> i64 {
    return if a > b { a } else { b }
}

/// A body with `.0` after it when it has no point at all, which a
/// specification with a precision and no type asks for.
fn with_point(body: str) -> str {
    if (body.index_of(".") ?? -1) >= 0 or (body.index_of("e") ?? -1) >= 0 {
        return body
    }
    return body + ".0"
}

/// A body with a bare `.` after its digits when it has none, which `#`
/// asks for.
fn with_bare_point(body: str) -> str {
    let split = split_at_suffix(body)
    if (split.0.index_of(".") ?? -1) >= 0 {
        return body
    }
    return split.0 + "." + split.1
}

/// A body split into its digits and whatever follows them — an exponent, a
/// percent sign, or nothing.
fn split_at_suffix(body: str) -> (str, str) {
    var at = body.len()
    var i = 0
    while i < body.len() {
        let c = body.substr(i, 1)
        if c == "e" or c == "E" or c == "%" {
            at = i
            i = body.len()
        }
        i = i + 1
    }
    return (body.substr(0, at), body.substr(at, body.len() - at))
}

/// The body, its sign, and the padding — with zero fill under a separator
/// grouped along with the digits, as it is for an integer.
fn place(body: str, sign: str, spec: FormatSpec) -> str {
    if spec.align != "=" {
        return pad(body, sign, spec)
    }
    let target = spec.width - sign.len()
    // An infinity has no digits to group, so its padding is plain zeros.
    if spec.fill != "0" or spec.grouping == "" or not has_digit(body) {
        if body.len() >= target {
            return sign + body
        }
        return sign + repeat(spec.fill, target - body.len()) + body
    }
    var whole = ""
    var rest = body
    let point = body.index_of(".") ?? -1
    let suffix = split_at_suffix(body)
    var digits = suffix.0
    var tail = suffix.1
    if point >= 0 {
        digits = body.substr(0, point)
        tail = body.substr(point, suffix.0.len() - point) + suffix.1
    }
    // The digits arrive already separated; the padding has to be grouped
    // together with them, so the separators come out and go back in once.
    whole = without(digits, spec.grouping)
    rest = tail
    while grouped(whole, spec.grouping, 3).len() + rest.len() < target {
        whole = "0" + whole
    }
    return sign + grouped(whole, spec.grouping, 3) + rest
}

fn default_precision(spec: FormatSpec, fallback: i64) -> i64 {
    if spec.precision < 0 {
        return fallback
    }
    return spec.precision
}

/// A separator every three digits, in the whole part only.
fn grouped_before_point(body: str, separator: str) -> str {
    var end = body.len()
    var i = 0
    while i < body.len() {
        let c = body.substr(i, 1)
        if c == "." or c == "e" or c == "E" or c == "%" {
            end = i
            i = body.len()
        }
        i = i + 1
    }
    return grouped(body.substr(0, end), separator, 3) +
    body.substr(end, body.len() - end)
}

fn has_digit(text: str) -> bool {
    var i = 0
    while i < text.len() {
        if is_digit(text.substr(i, 1)) {
            return true
        }
        i = i + 1
    }
    return false
}

fn without(text: str, separator: str) -> str {
    if separator.len() == 0 {
        return text
    }
    var out = ""
    var i = 0
    while i < text.len() {
        let c = text.substr(i, 1)
        if c != separator {
            out = out + c
        }
        i = i + 1
    }
    return out
}

/// Whether a specification is one a float can be formatted by.
pub fn is_float_spec(text: str) -> bool {
    match parse(text) {
        Err(_e) -> return false
        Ok(spec) -> {
            return spec.kind == "" or spec.kind == "f" or
            spec.kind == "F" or spec.kind == "e" or spec.kind == "E" or
            spec.kind == "g" or spec.kind == "G" or
            spec.kind == "n" or spec.kind == "%"
        }
    }
}
