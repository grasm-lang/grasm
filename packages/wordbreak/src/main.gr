fn class_other() -> i64 { return 0 }
fn class_cr() -> i64 { return 1 }
fn class_lf() -> i64 { return 2 }
fn class_newline() -> i64 { return 3 }
fn class_extend() -> i64 { return 4 }
fn class_zwj() -> i64 { return 5 }
fn class_format() -> i64 { return 6 }
fn class_regional() -> i64 { return 7 }
fn class_katakana() -> i64 { return 8 }
fn class_hebrew() -> i64 { return 9 }
fn class_letter() -> i64 { return 10 }
fn class_single_quote() -> i64 { return 11 }
fn class_double_quote() -> i64 { return 12 }
fn class_mid_num_let() -> i64 { return 13 }
fn class_mid_letter() -> i64 { return 14 }
fn class_mid_num() -> i64 { return 15 }
fn class_numeric() -> i64 { return 16 }
fn class_extend_num_let() -> i64 { return 17 }
fn class_wseg_space() -> i64 { return 18 }

/// The Word_Break class of a code point.
pub fn class_of(code: i64) -> i64 {
    var low = 0
    var high = WB_RUNS.len() / 3 - 1
    while low <= high {
        let middle = (low + high) / 2
        if code < WB_RUNS[middle * 3] {
            high = middle - 1
        } else if code > WB_RUNS[middle * 3 + 1] {
            low = middle + 1
        } else {
            return WB_RUNS[middle * 3 + 2]
        }
    }
    return class_other()
}

/// A letter, of either alphabet the rules name.
fn is_ah(kind: i64) -> bool {
    return kind == class_letter() or kind == class_hebrew()
}

/// The separators that may appear inside a word, and inside a number.
fn is_mid_letterish(kind: i64) -> bool {
    return kind == class_mid_letter() or kind == class_mid_num_let() or
    kind == class_single_quote()
}

fn is_mid_numish(kind: i64) -> bool {
    return kind == class_mid_num() or kind == class_mid_num_let() or
    kind == class_single_quote()
}

/// The classes rule WB4 looks through.
fn is_ignored(kind: i64) -> bool {
    return kind == class_extend() or kind == class_format() or
    kind == class_zwj()
}

fn is_line_ending(kind: i64) -> bool {
    return kind == class_cr() or kind == class_lf() or
    kind == class_newline()
}

/// The index of the previous character the rules can see, or -1.
fn previous_visible(kinds: [i64], from: i64) -> i64 {
    var i = from
    while i >= 0 {
        if not is_ignored(kinds[i]) {
            return i
        }
        i = i - 1
    }
    return 0 - 1
}

/// The index of the next character the rules can see, or -1.
fn next_visible(kinds: [i64], from: i64) -> i64 {
    var i = from
    while i < kinds.len() {
        if not is_ignored(kinds[i]) {
            return i
        }
        i = i + 1
    }
    return 0 - 1
}

fn kind_at(kinds: [i64], at: i64) -> i64 {
    if at < 0 {
        return class_other()
    }
    return kinds[at]
}

/// How many regional indicators the rules can see immediately before
/// `before`, which decides whether the next pair starts a flag or finishes
/// one.
fn regionals_before(kinds: [i64], before: i64) -> i64 {
    var count = 0
    var i = previous_visible(kinds, before)
    while i >= 0 and kinds[i] == class_regional() {
        count = count + 1
        i = previous_visible(kinds, i - 1)
    }
    return count
}

/// Whether a word boundary falls before index `i`.
fn breaks_at(codes: [i64], kinds: [i64], i: i64) -> bool {
    let raw_left = kinds[i - 1]
    let right = kinds[i]
    // WB3, WB3a, WB3b: a line ending stands alone.
    if raw_left == class_cr() and right == class_lf() {
        return false
    }
    if is_line_ending(raw_left) or is_line_ending(right) {
        return true
    }
    // WB3c and WB3d, which look at the raw character before rather than
    // the one the rules can see.
    if raw_left == class_zwj() and graphemes.is_pictographic(codes[i]) {
        return false
    }
    if raw_left == class_wseg_space() and right == class_wseg_space() {
        return false
    }
    // WB4: a mark or a format character joins what it follows.
    if is_ignored(right) {
        return false
    }
    let left_at = previous_visible(kinds, i - 1)
    if left_at < 0 {
        return true
    }
    let left = kinds[left_at]
    let before_at = previous_visible(kinds, left_at - 1)
    let before = kind_at(kinds, before_at)
    let after_at = next_visible(kinds, i + 1)
    let after = kind_at(kinds, after_at)
    // WB5 through WB13b: letters, numbers and the separators inside them.
    if is_ah(left) and is_ah(right) {
        return false
    }
    if is_ah(left) and (is_mid_letterish(right) or
        right == class_mid_num_let()) and is_ah(after) {
        return false
    }
    if is_ah(before) and is_mid_letterish(left) and is_ah(right) {
        return false
    }
    if left == class_hebrew() and right == class_single_quote() {
        return false
    }
    if left == class_hebrew() and right == class_double_quote() and
    after == class_hebrew() {
        return false
    }
    if before == class_hebrew() and left == class_double_quote() and
    right == class_hebrew() {
        return false
    }
    if left == class_numeric() and right == class_numeric() {
        return false
    }
    if is_ah(left) and right == class_numeric() {
        return false
    }
    if left == class_numeric() and is_ah(right) {
        return false
    }
    if before == class_numeric() and is_mid_numish(left) and
    right == class_numeric() {
        return false
    }
    if left == class_numeric() and is_mid_numish(right) and
    after == class_numeric() {
        return false
    }
    if left == class_katakana() and right == class_katakana() {
        return false
    }
    if (is_ah(left) or left == class_numeric() or
        left == class_katakana() or left == class_extend_num_let()) and
    right == class_extend_num_let() {
        return false
    }
    if left == class_extend_num_let() and (is_ah(right) or
        right == class_numeric() or right == class_katakana()) {
        return false
    }
    // WB15 and WB16: regional indicators pair off.
    if left == class_regional() and right == class_regional() and
    regionals_before(kinds, left_at - 1) % 2 == 0 {
        return false
    }
    return true
}

fn classes_of(codes: [i64]) -> [i64] {
    var out: [i64] = []
    for code in codes {
        out.push(class_of(code))
    }
    return out
}

/// The code point offsets a string's words begin at, including 0 and the
/// length.
pub fn boundaries(text: str) -> [i64] {
    var codes: [i64] = []
    for character in text.chars() {
        codes.push(character.code_at(0))
    }
    return boundaries_of(codes)
}

/// The same, for code points a caller already has.
pub fn boundaries_of(codes: [i64]) -> [i64] {
    var out = [0]
    if codes.len() == 0 {
        return out
    }
    let kinds = classes_of(codes)
    var i = 1
    while i < codes.len() {
        if breaks_at(codes, kinds, i) {
            out.push(i)
        }
        i = i + 1
    }
    out.push(codes.len())
    return out
}

/// Every piece between two boundaries, spaces and punctuation included.
pub fn segments(text: str) -> [str] {
    let characters = text.chars()
    let marks = boundaries(text)
    var out: [str] = []
    var i = 0
    while i + 1 < marks.len() {
        var piece = ""
        var j = marks[i]
        while j < marks[i + 1] {
            piece = piece + characters[j]
            j = j + 1
        }
        out.push(piece)
        i = i + 1
    }
    return out
}

/// The pieces that are words: the ones that start with a letter or a
/// digit.
///
/// The boundary rules say where the pieces are and deliberately do not say
/// which are words — a run of spaces is a segment too. This is the usual
/// answer to that second question, and a caller wanting a different one
/// can use `segments`.
///
/// Han and Hiragana are `Other` in the property file, so a Chinese
/// sentence comes back as no words at all rather than as wrong ones.
/// UAX #29 says plainly that those scripts need a dictionary, and
/// answering anyway would be answering a question this package cannot.
pub fn words(text: str) -> [str] {
    var out: [str] = []
    for piece in segments(text) {
        if piece.len() == 0 {
            continue
        }
        let kind = class_of(piece.chars()[0].code_at(0))
        if is_ah(kind) or kind == class_numeric() or
        kind == class_katakana() or kind == class_extend_num_let() {
            out.push(piece)
        }
    }
    return out
}
