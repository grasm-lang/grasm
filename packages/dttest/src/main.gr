import difftext

fn from_hex(text: str) -> str {
    var out: [i64] = []
    var i = 1
    while i + 1 < text.len() {
        out.push(text.substr(i, 2).parse_int_base(16) ?? 0)
        i = i + 2
    }
    return bytes_of(out).to_str()
}

fn to_hex(text: str) -> str {
    let digits = "0123456789abcdef"
    let raw = text.to_bytes()
    var out = ""
    var i = 0
    while i < raw.len() {
        out = out + digits.substr(raw.at(i) / 16, 1) +
        digits.substr(raw.at(i) % 16, 1)
        i = i + 1
    }
    return out
}

/// Lines arrive joined by `\u{1}` so that their own endings survive.
fn lines_of(text: str) -> [str] {
    if text.len() == 0 {
        return []
    }
    return text.split("\u{1}")
}

fn main() / {io} {
    var i = 0
    while i + 3 < args().len() {
        let what = args()[i]
        let a = lines_of(from_hex(args()[i + 1]))
        let b = lines_of(from_hex(args()[i + 2]))
        let context = args()[i + 3].parse_int() ?? 3
        var out: [str] = []
        if what == "unified" {
            out = difftext.unified(a, b, "a", "b", context, "\n")
        } else if what == "context" {
            out = difftext.context(a, b, "a", "b", context, "\n")
        } else {
            var parts: [str] = []
            for code in difftext.opcodes(a, b) {
                parts.push(code.tag + " " + code.a_from.to_str() + " " +
                    code.a_to.to_str() + " " + code.b_from.to_str() + " " +
                    code.b_to.to_str())
            }
            out = parts
        }
        print(to_hex(out.join("\u{1}")))
        i = i + 4
    }
}
