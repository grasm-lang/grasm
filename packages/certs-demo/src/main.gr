fn certificate_bundle_der() -> bytes {
    let hex = "3082034706092a864886f70d010702a0820338308203340201013100300b0609" +
    "2a864886f70d010701a082031c3082018730820139a00302010202145e6b296c" +
    "c52b24df0f9e4a73f6d2cef1a841c75d300506032b65703039310b3009060355" +
    "04061302474231133011060355040a0c0a4578616d706c652043413115301306" +
