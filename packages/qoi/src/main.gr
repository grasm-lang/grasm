// QOI, the Quite OK Image format (Dominic Szablewski, 2021, spec 1.0).
//
// Lossless RGB and RGBA in a format whose whole specification fits on a
// page: each pixel is written as the cheapest of six chunks -- a run of
// the previous pixel, an index into a 64-entry table of recently seen
// pixels (hashed by r*3 + g*5 + b*7 + a*11), a small difference from the
// previous pixel in two sizes, or the pixel in full -- with no entropy
// coding at all. It compresses about as well as PNG at many times the
// speed, which is why game engines, emulators, screen recorders and
// asset pipelines adopted it.
//
// Encoding is deterministic: `encode` makes the same choices as the
// reference encoder, so its output is byte for byte what every other
// conforming encoder writes. The header's colorspace byte (sRGB or
// linear) is carried through but does not change the pixels.
//
// Checked against Pillow's QOI reader and writer.

type QoiImage = { width: i64, height: i64, channels: i64, colorspace: i64, pixels: bytes }

type QoiError =
    | QoiNotQoi
    | QoiBadHeader(why: str)
    | QoiTruncated

fn be32(b: bytes, at: i64) -> i64 {
    return b.at(at).shl(24).bit_or(b.at(at + 1).shl(16)).bit_or(b.at(at + 2).shl(8)).bit_or(b.at(at + 3))
}

fn hash(r: i64, g: i64, b: i64, a: i64) -> i64 {
    return (r * 3 + g * 5 + b * 7 + a * 11) % 64
}

fn remember(inout index: [i64], r: i64, g: i64, b: i64, a: i64) {
    let hp = hash(r, g, b, a)
    index[4 * hp] = r
    index[4 * hp + 1] = g
    index[4 * hp + 2] = b
    index[4 * hp + 3] = a
}

pub fn decode(data: bytes) -> QoiImage ! QoiError {
    if data.len() < 14 or data.slice(0, 4).to_str() != "qoif" {
        fail(QoiNotQoi)
    }
    let w = be32(data, 4)
    let h = be32(data, 8)
    let ch = data.at(12)
    let cs = data.at(13)
    if ch != 3 and ch != 4 {
        fail(QoiBadHeader("channels must be 3 or 4"))
    }
    if cs > 1 {
        fail(QoiBadHeader("colorspace must be 0 or 1"))
    }
    if w == 0 or h == 0 or w * h > 400000000 {
        fail(QoiBadHeader("an empty or oversized image"))
    }
    var index: [i64] = []
    for _i in 0..256 {
        index.push(0)
    }
    var r = 0
    var g = 0
    var b = 0
    var a = 255
    var out: [i64] = []
    var at = 14
    var run = 0
    let end = data.len() - 8
    for _p in 0..(w * h) {
        if run > 0 {
            run = run - 1
        } else {
            if at >= end {
                fail(QoiTruncated)
            }
            let b1 = data.at(at)
            at = at + 1
            if b1 == 254 {
                r = data.at(at)
                g = data.at(at + 1)
                b = data.at(at + 2)
                at = at + 3
            } else if b1 == 255 {
                r = data.at(at)
                g = data.at(at + 1)
                b = data.at(at + 2)
                a = data.at(at + 3)
                at = at + 4
            } else if b1 < 64 {
                r = index[4 * b1]
                g = index[4 * b1 + 1]
                b = index[4 * b1 + 2]
                a = index[4 * b1 + 3]
            } else if b1 < 128 {
                r = (r + b1.ushr(4).bit_and(3) - 2).bit_and(255)
                g = (g + b1.ushr(2).bit_and(3) - 2).bit_and(255)
                b = (b + b1.bit_and(3) - 2).bit_and(255)
            } else if b1 < 192 {
                let b2 = data.at(at)
                at = at + 1
                let dg = b1.bit_and(63) - 32
                r = (r + dg + b2.ushr(4) - 8).bit_and(255)
                g = (g + dg).bit_and(255)
                b = (b + dg + b2.bit_and(15) - 8).bit_and(255)
            } else {
                run = b1.bit_and(63)
            }
            remember(index, r, g, b, a)
        }
        for item in (if ch == 4 { [r, g, b, a] } else { [r, g, b] }) {
            out.push(item)
        }
    }
    return QoiImage{ width: w, height: h, channels: ch, colorspace: cs, pixels: bytes_of(out) }
}

fn signed(v: i64) -> i64 {
    let x = v.bit_and(255)
    return if x >= 128 { x - 256 } else { x }
}

fn be32_out(v: i64) -> [i64] {
    return [v.ushr(24).bit_and(255), v.ushr(16).bit_and(255), v.ushr(8).bit_and(255), v.bit_and(255)]
}

/// The image as the reference encoder writes it.
pub fn encode(img: QoiImage) -> bytes ! QoiError {
    let ch = img.channels
    if ch != 3 and ch != 4 {
        fail(QoiBadHeader("channels must be 3 or 4"))
    }
    if img.width * img.height * ch != img.pixels.len() or img.width == 0 or img.height == 0 {
        fail(QoiBadHeader("pixels that do not fill the image"))
    }
    var out = "qoif".to_bytes().to_list() + be32_out(img.width) + be32_out(img.height) + [ch, img.colorspace]
    var index: [i64] = []
    for _i in 0..256 {
        index.push(0)
    }
    var pr = 0
    var pg = 0
    var pb = 0
    var pa = 255
    var run = 0
    let n = img.width * img.height
    for p in 0..n {
        let r = img.pixels.at(p * ch)
        let g = img.pixels.at(p * ch + 1)
        let b = img.pixels.at(p * ch + 2)
        let a = if ch == 4 { img.pixels.at(p * ch + 3) } else { pa }
        if r == pr and g == pg and b == pb and a == pa {
            run = run + 1
            if run == 62 or p == n - 1 {
                out.push(191 + run)
                run = 0
            }
        } else {
            if run > 0 {
                out.push(191 + run)
                run = 0
            }
            let hp = hash(r, g, b, a)
            if index[4 * hp] == r and index[4 * hp + 1] == g and index[4 * hp + 2] == b and index[4 * hp + 3] == a {
                out.push(hp)
            } else {
                index[4 * hp] = r
                index[4 * hp + 1] = g
                index[4 * hp + 2] = b
                index[4 * hp + 3] = a
                if a == pa {
                    let vr = signed(r - pr)
                    let vg = signed(g - pg)
                    let vb = signed(b - pb)
                    let vgr = vr - vg
                    let vgb = vb - vg
                    if vr > -3 and vr < 2 and vg > -3 and vg < 2 and vb > -3 and vb < 2 {
                        out.push(64 + (vr + 2).shl(4) + (vg + 2).shl(2) + (vb + 2))
                    } else if vgr > -9 and vgr < 8 and vg > -33 and vg < 32 and vgb > -9 and vgb < 8 {
                        for item in [128 + vg + 32, (vgr + 8).shl(4) + (vgb + 8)] {
                            out.push(item)
                        }
                    } else {
                        for item in [254, r, g, b] {
                            out.push(item)
                        }
                    }
                } else {
                    for item in [255, r, g, b, a] {
                        out.push(item)
                    }
                }
            }
        }
        pr = r
        pg = g
        pb = b
        pa = a
    }
    return bytes_of(out + [0, 0, 0, 0, 0, 0, 0, 1])
}
