fn row_of(code: i64) -> i64 {
    var low = 0
    var high = NUMERIC_ROWS.len() / 4 - 1
    while low <= high {
        let middle = (low + high) / 2
        if code < NUMERIC_ROWS[middle * 4] {
            high = middle - 1
        } else if code > NUMERIC_ROWS[middle * 4] {
            low = middle + 1
        } else {
            return middle
        }
    }
    return 0 - 1
}

/// Whether a code point is a positional decimal digit.
pub fn is_decimal_digit(code: i64) -> bool {
    let row = row_of(code)
    return row >= 0 and NUMERIC_ROWS[row * 4 + 1] == 3
}

/// Whether it looks like a digit, positional or not.
pub fn is_digit(code: i64) -> bool {
    let row = row_of(code)
    return row >= 0 and NUMERIC_ROWS[row * 4 + 1] >= 2
}

/// Whether it has a numeric value at all.
pub fn is_numeric(code: i64) -> bool {
    return row_of(code) >= 0
}

/// The value of a decimal digit, or -1.
pub fn decimal_value(code: i64) -> i64 {
    if not is_decimal_digit(code) {
        return 0 - 1
    }
    return NUMERIC_ROWS[row_of(code) * 4 + 2]
}

/// The value as a fraction: numerator and denominator, or (0, 0) when the
/// character is not numeric.
pub fn numeric_value(code: i64) -> (i64, i64) {
    let row = row_of(code)
    if row < 0 {
        return (0, 0)
    }
    return (NUMERIC_ROWS[row * 4 + 2], NUMERIC_ROWS[row * 4 + 3])
}

/// Read a run of decimal digits in any alphabet as a number.
///
/// Refuses a string that mixes alphabets — `١2٣` is not a number in any
/// language, and accepting it is how a validator and a database disagree
/// about what was submitted.
pub fn parse_decimal(text: str) -> Option[i64] {
    var value = 0
    var base = 0 - 1
    var any = false
    for character in text.chars() {
        let code = character.code_at(0)
        if not is_decimal_digit(code) {
            return None
        }
        let digit = decimal_value(code)
        let zero = code - digit
        if base < 0 {
            base = zero
        } else if base != zero {
            return None
        }
        value = value * 10 + digit
        any = true
    }
    if not any {
        return None
    }
    return Some(value)
}

/// The same digits written in ASCII, for handing on to something that only
/// knows `0` to `9`.
pub fn to_ascii_digits(text: str) -> str {
    var out = ""
    for character in text.chars() {
        let code = character.code_at(0)
        if is_decimal_digit(code) {
            out = out + (48 + decimal_value(code)).to_char()
        } else {
            out = out + character
        }
    }
    return out
}
