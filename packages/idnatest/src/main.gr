import idna

fn from_hex(text: str) -> str {
    var out: [i64] = []
    var i = 1
    while i + 1 < text.len() {
        out.push(text.substr(i, 2).parse_int_base(16) ?? 0)
        i = i + 2
    }
    return bytes_of(out).to_str()
}

fn to_hex(text: str) -> str {
    let digits = "0123456789abcdef"
    let raw = text.to_bytes()
    var out = ""
    var i = 0
    while i < raw.len() {
        out = out + digits.substr(raw.at(i) / 16, 1) +
        digits.substr(raw.at(i) % 16, 1)
        i = i + 1
    }
    return out
}

fn main() / {io} {
    var i = 0
    while i + 1 < args().len() {
        let body = from_hex(args()[i + 1])
        if args()[i] == "encode" {
            print(to_hex(idna.encode_domain(body) ?? "?refused?"))
        } else if args()[i] == "decode" {
            print(to_hex(idna.decode_domain(body) ?? "?refused?"))
        } else {
            print(to_hex(idna.nameprep(body) ?? "?refused?"))
        }
        i = i + 2
    }
}
