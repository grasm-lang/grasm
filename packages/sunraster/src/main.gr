// Sun raster images (.ras, .sun, .im1, .im8, .im24, .im32).
//
// A 32-byte big-endian header (magic 0x59A66A95, width, height, depth,
// length, type, colour-map type and length), an optional colour map stored
// as all its reds, then greens, then blues, and the pixels, each row
// padded to 16 bits. Depths are 1 (a set bit black), 8 (grey or indexed),
// 24 (BGR, or RGB in type 3) and 32 (BGRX, or RGBX in type 3, as Pillow
// reads them). Type 2 run-length encodes the
// bytes with 0x80 as escape: `80 00` is a single 0x80, `80 n v` is n + 1
// copies of v, over the padded rows as the format, ImageMagick and Netpbm
// have it (Pillow leaves the padding out when decoding RLE, so the two
// agree only when rows need none). SunOS's screendump and xv, and many
// older scientific archives, wrote these.
//
// `decode` returns grey (1 channel) or RGB (3), colour maps resolved.
// `encode` writes grey or RGB, plain or run-length encoded.
//
// Checked against Pillow's Sun raster reader.

type RasImage = { width: i64, height: i64, channels: i64, pixels: bytes }

type RasError =
    | RasMalformed(why: str)
    | RasUnsupported(what: str)
    | RasTruncated

fn be32(b: bytes, at: i64) -> i64 {
    return b.at(at).shl(24).bit_or(b.at(at + 1).shl(16)).bit_or(b.at(at + 2).shl(8)).bit_or(b.at(at + 3))
}

fn unrle(data: bytes, from: i64, need: i64) -> [i64] ! RasError {
    var out: [i64] = []
    var at = from
    while out.len() < need {
        if at >= data.len() {
            fail(RasTruncated)
        }
        let b = data.at(at)
        if b != 128 {
            out.push(b)
            at = at + 1
        } else {
            if at + 1 >= data.len() {
                fail(RasTruncated)
            }
            let n = data.at(at + 1)
            if n == 0 {
                out.push(128)
                at = at + 2
            } else {
                if at + 2 >= data.len() {
                    fail(RasTruncated)
                }
                for _k in 0..(n + 1) {
                    out.push(data.at(at + 2))
                }
                at = at + 3
            }
        }
    }
    return out
}

pub fn decode(data: bytes) -> RasImage ! RasError {
    if data.len() < 32 or be32(data, 0) != 1504078485 {
        fail(RasMalformed("not a Sun raster"))
    }
    let w = be32(data, 4)
    let h = be32(data, 8)
    let depth = be32(data, 12)
    let kind = be32(data, 20)
    let map_type = be32(data, 24)
    let map_len = be32(data, 28)
    if w < 1 or h < 1 or w * h > 400000000 {
        fail(RasMalformed("an empty or oversized image"))
    }
    if depth != 1 and depth != 8 and depth != 24 and depth != 32 or kind > 3 or map_type > 1 {
        fail(RasUnsupported("depth {depth}, type {kind}, colour map {map_type}"))
    }
    let map = if map_type == 1 { data.slice(32, 32 + map_len) } else { bytes_of([]) }
    if 32 + map_len > data.len() {
        fail(RasTruncated)
    }
    let start = 32 + map_len
    let row = ((w * depth + 15) / 16) * 2
    let raw = if kind == 2 { try unrle(data, start, row * h) } else {
        if start + row * h > data.len() {
            fail(RasTruncated)
        }
        data.slice(start, start + row * h).to_list()
    }
    let colours = map.len() / 3
    var out: [i64] = []
    for y in 0..h {
        let r = y * row
        for x in 0..w {
            if depth == 1 {
                out.push(if raw[r + x / 8].ushr(7 - x % 8).bit_and(1) == 1 { 0 } else { 255 })
            } else if depth == 8 {
                let v = raw[r + x]
                if colours > 0 {
                    // An index past the colour map is black, as Pillow
                    // reads it.
                    let e = if v < colours { [map.at(v), map.at(colours + v), map.at(2 * colours + v)] } else { [0, 0, 0] }
                    for item in e {
                        out.push(item)
                    }
                } else {
                    out.push(v)
                }
            } else {
                let p = r + x * (depth / 8)
                for item in (if kind == 3 { [raw[p], raw[p + 1], raw[p + 2]] } else { [raw[p + 2], raw[p + 1], raw[p]] }) {
                    out.push(item)
                }
            }
        }
    }
    let channels = if depth == 1 or depth == 8 and colours == 0 { 1 } else { 3 }
    return RasImage{ width: w, height: h, channels: channels, pixels: bytes_of(out) }
}

fn be(v: i64) -> [i64] {
    return [v.ushr(24).bit_and(255), v.ushr(16).bit_and(255), v.ushr(8).bit_and(255), v.bit_and(255)]
}

fn rle(raw: [i64]) -> [i64] {
    var out: [i64] = []
    var i = 0
    while i < raw.len() {
        var run = 1
        while i + run < raw.len() and run < 256 and raw[i + run] == raw[i] {
            run = run + 1
        }
        if run >= 3 or raw[i] == 128 {
            if raw[i] == 128 and run == 1 {
                for item in [128, 0] {
                    out.push(item)
                }
            } else {
                for item in [128, run - 1, raw[i]] {
                    out.push(item)
                }
            }
        } else {
            for _k in 0..run {
                out.push(raw[i])
            }
        }
        i = i + run
    }
    return out
}

/// Grey (8-bit) or RGB (24-bit, stored BGR), run-length encoded if asked.
pub fn encode(img: RasImage, compress: bool) -> bytes ! RasError {
    let c = img.channels
    if c != 1 and c != 3 or img.pixels.len() != img.width * img.height * c or img.width < 1 or img.height < 1 {
        fail(RasMalformed("pixels that do not fill the image"))
    }
    let depth = 8 * c
    let row = ((img.width * depth + 15) / 16) * 2
    var raw: [i64] = []
    for y in 0..img.height {
        var line: [i64] = []
        for x in 0..img.width {
            let p = (y * img.width + x) * c
            for item in (if c == 1 { [img.pixels.at(p)] } else { [img.pixels.at(p + 2), img.pixels.at(p + 1), img.pixels.at(p)] }) {
                line.push(item)
            }
        }
        while line.len() < row {
            line.push(0)
        }
        for item in line {
            raw.push(item)
        }
    }
    let body = if compress { rle(raw) } else { raw }
    return bytes_of(be(1504078485) + be(img.width) + be(img.height) + be(depth) + be(body.len()) + be(if compress { 2 } else { 1 }) + be(0) + be(0) + body)
}
