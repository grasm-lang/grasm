// The other half of `scripts/crypto_diff.sh`.
//
// A published vector proves a primitive agrees with its specification at the
// handful of points somebody chose to write down. It does not prove agreement
// anywhere else, and the bugs that survive a vector list are exactly the ones
// that only show up on inputs nobody thought to pick — a carry that only
// propagates past a certain limb, a block boundary at an unusual length.
//
// So this reads a file of randomly generated cases, computes each one, and
// prints the answer. An independent implementation in `scripts/crypto_diff.py`
// computes the same cases and the two are diffed. That one shares no structure
// with this one: it uses Python's arbitrary-precision integers, so it has no
// limbs and no carry chain at all, and a bug in the ten-limb arithmetic here
// cannot be present in both.
//
// With no arguments it prints nothing and exits 0, which is what the corpus
// gates run it as.

import blake2s
import noise
import grasmwire
import x25519
import chachapoly
import bytes_codec

fn unhex(s: str) -> bytes {
    match bytes_codec.decode_hex(s) {
        Some(b) -> b
        None -> panic("not hex: {s}")
    }
}

fn to_int(s: str) -> i64 {
    var n = 0
    for ch in s.chars() {
        n = n * 10 + (ch.to_bytes().at(0) - 48)
    }
    n
}

fn main() / {io} {
    let argv = args()
    if argv.len() == 0 {
        return
    }
    let path = argv[0]
    let text = match read_file(path) {
        Ok(t) -> t
        Err(_e) -> panic("cannot read {path}")
    }
    for line in text.lines() {
        if line.len() > 0 {
            let parts = line.split(" ")
            let kind = parts[0]
            if kind == "hash" {
                print(bytes_codec.encode_hex(blake2s.hash(unhex(parts[1]))))
            } else if kind == "keyed" {
                print(bytes_codec.encode_hex(blake2s.keyed(unhex(parts[1]), unhex(parts[2]), 32)))
            } else if kind == "hmac" {
                print(bytes_codec.encode_hex(blake2s.hmac(unhex(parts[1]), unhex(parts[2]))))
            } else if kind == "dh" {
                print(bytes_codec.encode_hex(x25519.scalarmult(unhex(parts[1]), unhex(parts[2]))))
            } else if kind == "pub" {
                print(bytes_codec.encode_hex(x25519.public_key(unhex(parts[1]))))
            } else if kind == "handshake" {
                // The whole exchange from five fixed keys, so an independent
                // reading of the protocol can be compared against this one.
                let started: Initiation ! HandshakeError = noise.initiate(
                    unhex(parts[1]), x25519.public_key(unhex(parts[1])),
                    x25519.public_key(unhex(parts[2])), unhex(parts[3]),
                    unhex(parts[5]), 1)
                match started {
                    Ok(init) -> {
                        match noise.consume_initiation(unhex(parts[2]),
                            x25519.public_key(unhex(parts[2])), init.message) {
                            Ok(incoming) -> {
                                match noise.respond(incoming, unhex(parts[4]), unhex(parts[6]), 2) {
                                    Ok(reply) -> {
                                        match noise.consume_response(init.state, reply.message, unhex(parts[6])) {
                                            Ok(done) -> {
                                                let k = noise.split(done, true)
                                                print(bytes_codec.encode_hex(noise.transcript(done)))
                                                print(bytes_codec.encode_hex(k.sending))
                                                print(bytes_codec.encode_hex(k.receiving))
                                            }
                                            Err(_e) -> print("the initiator could not finish")
                                        }
                                    }
                                    Err(_e) -> print("no reply")
                                }
                            }
                            Err(_e) -> print("the first message was refused")
                        }
                    }
                    Err(_e) -> print("no first message")
                }
            } else if kind == "xseal" {
                print(bytes_codec.encode_hex(chachapoly.xseal(
                    unhex(parts[1]), unhex(parts[2]), unhex(parts[3]), unhex(parts[4]))))
            } else if kind == "replay" {
                // A whole sequence of counters through one window, answered
                // with one character each. The window is where an off-by-one
                // either drops a genuine packet or accepts a replayed one, and
                // hand-picked edges only find the edges somebody thought of.
                var window = grasmwire.replay_new()
                var answer = ""
                for c in parts[1].split(",") {
                    if grasmwire.replay_accept(window, to_int(c)) {
                        answer = answer + "y"
                    } else {
                        answer = answer + "n"
                    }
                }
                print(answer)
            } else if kind == "seal" {
                print(bytes_codec.encode_hex(chachapoly.seal_combined(
                    unhex(parts[1]), unhex(parts[2]), unhex(parts[3]), unhex(parts[4]))))
            }
        }
    }
}
