// Compiled terminfo entries: what a terminal can do, in ncurses' binary form.
//
// Every curses program, `tput`, `less`, `vim` and a good many shells look up
// `$TERM` in `/usr/share/terminfo` to learn how to move the cursor, what the
// arrow keys send and how many colors there are. The files there are not
// text: `tic` compiles each description into a header, the names, a run of
// booleans, a run of 16-bit numbers and a table of string offsets, with the
// capabilities identified only by their position — and, since ncurses 5,
// an extended section after that for capabilities named in the file, like
// `AX`, `XT` and the `kDC3` keys. A program that wants a terminal's
// capabilities without linking ncurses has to read that format, and one that
// shows them has to print them the way `infocmp` does, or nobody can compare
// its output with anything.
//
// - Positions map to names through ncurses' own table, which is not typed
//   here: `scripts/gen_terminfo_caps.py` builds entries that set every
//   position to a value naming it and reads the names back from `infocmp`.
// - A number or string can be absent or explicitly cancelled, and a
//   cancelled one is printed `name@` — except that ncurses reads no strings
//   at all from an entry whose string table is empty, cancellations included.
// - `infocmp` sorts `acsc` by pairs before printing it, and writes strings
//   with its own escapes: `\E` for escape, `^X` for a control character in
//   a short string or one followed by a digit, `\ooo` otherwise, `\s` for a
//   space at the start or end, and `\,`, `\:` and `\^` for the characters
//   that would end or change a capability.
// - Without `-x`, the obsolete termcap capabilities (`OTbs` and the rest) and
//   the extended section are not shown.
//
// The format ncurses 6.1 added for 32-bit numbers (magic `01036`) is
// refused rather than read: nothing on this machine writes it, so nothing
// here could be checked against it.
//
// Checked against `infocmp -1` and `infocmp -1 -x` over every entry in the
// system's terminfo directory.

// BEGIN GENERATED by scripts/gen_terminfo_caps.py from ncurses 6.0.20150808
let BOOLEAN_NAMES = ("" +
    "bw,am,xsb,xhp,xenl,eo,gn,hc,km,hs,in,da,db,mir,msgr,os,eslok,xt,hz,ul," +
    "xon,nxon,mc5i,chts,nrrmc,npc,ndscr,ccc,bce,hls,xhpa,crxm,daisy,xvpa,sa" +
    "m,cpix,lpix,OTbs,OTns,OTnc,OTMT,OTNL,OTpt,OTxr")
    .split(",")
let NUMBER_NAMES = ("" +
    "cols,it,lines,lm,xmc,pb,vt,wsl,nlab,lh,lw,ma,wnum,colors,pairs,ncv,buf" +
    "sz,spinv,spinh,maddr,mjump,mcs,mls,npins,orc,orl,orhi,orvi,cps,widcs,b" +
    "tns,bitwin,bitype,OTug,OTdC,OTdN,OTdB,OTdT,OTkn")
    .split(",")
let STRING_NAMES = ("" +
    "cbt,bel,cr,csr,tbc,clear,el,ed,hpa,cmdch,cup,cud1,home,civis,cub1,mrcu" +
    "p,cnorm,cuf1,ll,cuu1,cvvis,dch1,dl1,dsl,hd,smacs,blink,bold,smcup,smdc" +
    ",dim,smir,invis,prot,rev,smso,smul,ech,rmacs,sgr0,rmcup,rmdc,rmir,rmso" +
    ",rmul,flash,ff,fsl,is1,is2,is3,if,ich1,il1,ip,kbs,ktbc,kclr,kctab,kdch" +
    "1,kdl1,kcud1,krmir,kel,ked,kf0,kf1,kf10,kf2,kf3,kf4,kf5,kf6,kf7,kf8,kf" +
    "9,khome,kich1,kil1,kcub1,kll,knp,kpp,kcuf1,kind,kri,khts,kcuu1,rmkx,sm" +
    "kx,lf0,lf1,lf10,lf2,lf3,lf4,lf5,lf6,lf7,lf8,lf9,rmm,smm,nel,pad,dch,dl" +
    ",cud,ich,indn,il,cub,cuf,rin,cuu,pfkey,pfloc,pfx,mc0,mc4,mc5,rep,rs1,r" +
    "s2,rs3,rf,rc,vpa,sc,ind,ri,sgr,hts,wind,ht,tsl,uc,hu,iprog,ka1,ka3,kb2" +
    ",kc1,kc3,mc5p,rmp,acsc,pln,kcbt,smxon,rmxon,smam,rmam,xonc,xoffc,enacs" +
    ",smln,rmln,kbeg,kcan,kclo,kcmd,kcpy,kcrt,kend,kent,kext,kfnd,khlp,kmrk" +
    ",kmsg,kmov,knxt,kopn,kopt,kprv,kprt,krdo,kref,krfr,krpl,krst,kres,ksav" +
    ",kspd,kund,kBEG,kCAN,kCMD,kCPY,kCRT,kDC,kDL,kslt,kEND,kEOL,kEXT,kFND,k" +
    "HLP,kHOM,kIC,kLFT,kMSG,kMOV,kNXT,kOPT,kPRV,kPRT,kRDO,kRPL,kRIT,kRES,kS" +
    "AV,kSPD,kUND,rfi,kf11,kf12,kf13,kf14,kf15,kf16,kf17,kf18,kf19,kf20,kf2" +
    "1,kf22,kf23,kf24,kf25,kf26,kf27,kf28,kf29,kf30,kf31,kf32,kf33,kf34,kf3" +
    "5,kf36,kf37,kf38,kf39,kf40,kf41,kf42,kf43,kf44,kf45,kf46,kf47,kf48,kf4" +
    "9,kf50,kf51,kf52,kf53,kf54,kf55,kf56,kf57,kf58,kf59,kf60,kf61,kf62,kf6" +
    "3,el1,mgc,smgl,smgr,fln,sclk,dclk,rmclk,cwin,wingo,hup,dial,qdial,tone" +
    ",pulse,hook,pause,wait,u0,u1,u2,u3,u4,u5,u6,u7,u8,u9,op,oc,initc,initp" +
    ",scp,setf,setb,cpi,lpi,chr,cvr,defc,swidm,sdrfq,sitm,slm,smicm,snlq,sn" +
    "rmq,sshm,ssubm,ssupm,sum,rwidm,ritm,rlm,rmicm,rshm,rsubm,rsupm,rum,mhp" +
    "a,mcud1,mcub1,mcuf1,mvpa,mcuu1,porder,mcud,mcub,mcuf,mcuu,scs,smgb,smg" +
    "bp,smglp,smgrp,smgt,smgtp,sbim,scsd,rbim,rcsd,subcs,supcs,docr,zerom,c" +
    "snm,kmous,minfo,reqmp,getm,setaf,setab,pfxl,devt,csin,s0ds,s1ds,s2ds,s" +
    "3ds,smglr,smgtb,birep,binel,bicr,colornm,defbi,endbi,setcolor,slines,d" +
    "ispc,smpch,rmpch,smsc,rmsc,pctrm,scesc,scesa,ehhlm,elhlm,elohlm,erhlm," +
    "ethlm,evhlm,sgr1,slength,OTi2,OTrs,OTnl,OTbc,OTko,OTma,OTG2,OTG3,OTG1," +
    "OTG4,OTGR,OTGL,OTGU,OTGD,OTGH,OTGV,OTGC,meml,memu,box1")
    .split(",")
// END GENERATED

type TerminfoError =
    | TerminfoTruncated(at: i64)
    | TerminfoBadMagic(magic: i64)

/// One capability: `kind` is `bool`, `num` or `str`; `state` is `set` or
/// `cancelled`. A number's value is in `number`, a string's in `text`.
type TerminfoCap = {
    name: str,
    kind: str,
    state: str,
    number: i64,
    text: bytes,
    extended: bool,
}

type TerminfoEntry = {
    names: str,
    caps: [TerminfoCap],
}

fn short_at(data: bytes, at: i64) -> i64 ! TerminfoError {
    if at + 2 > data.len() {
        fail(TerminfoTruncated(at))
    }
    let v = data.at(at) + data.at(at + 1) * 256
    return if v >= 32768 { v - 65536 } else { v }
}

fn need(data: bytes, at: i64) -> () ! TerminfoError {
    if at > data.len() {
        fail(TerminfoTruncated(at))
    }
}

/// The NUL-terminated string at `offset` in `table`, or `None` when it runs
/// off the end.
fn string_in(table: bytes, offset: i64) -> Option[bytes] {
    var i = offset
    while i < table.len() {
        if table.at(i) == 0 {
            return Some(table.slice(offset, i))
        }
        i = i + 1
    }
    return None
}

fn string_cap(name: str, offset: i64, table: bytes, extended: bool) -> Option[TerminfoCap] {
    if offset == -2 {
        return Some(TerminfoCap{ name: name, kind: "str", state: "cancelled",
            number: 0, text: bytes_of([]), extended: extended })
    }
    if offset < 0 or offset >= table.len() {
        return None
    }
    match string_in(table, offset) {
        Some(value) -> return Some(TerminfoCap{ name: name, kind: "str",
            state: "set", number: 0, text: value, extended: extended })
        None -> return None
    }
}

fn number_cap(name: str, value: i64, extended: bool) -> Option[TerminfoCap] {
    if value == -1 {
        return None
    }
    return Some(TerminfoCap{ name: name, kind: "num",
        state: if value == -2 { "cancelled" } else { "set" }, number: value,
        text: bytes_of([]), extended: extended })
}

fn bool_cap(name: str, value: i64, extended: bool) -> Option[TerminfoCap] {
    if value == 1 or value == 254 {
        return Some(TerminfoCap{ name: name, kind: "bool",
            state: if value == 1 { "set" } else { "cancelled" }, number: 0,
            text: bytes_of([]), extended: extended })
    }
    return None
}

/// A compiled entry, standard and extended capabilities both.
pub fn parse(data: bytes) -> TerminfoEntry ! TerminfoError {
    let magic = try short_at(data, 0)
    if magic != 282 {
        fail(TerminfoBadMagic(magic))
    }
    let name_size = try short_at(data, 2)
    let bools = try short_at(data, 4)
    let nums = try short_at(data, 6)
    let strs = try short_at(data, 8)
    let table_size = try short_at(data, 10)
    var at = 12
    try need(data, at + name_size)
    let names = data.slice(at, at + name_size)
    at = at + name_size
    var caps: [TerminfoCap] = []
    var i = 0
    try need(data, at + bools)
    while i < bools {
        if i < BOOLEAN_NAMES.len() {
            match bool_cap(BOOLEAN_NAMES[i], data.at(at + i), false) {
                Some(c) -> caps.push(c)
                None -> {}
            }
        }
        i = i + 1
    }
    at = at + bools
    if (name_size + bools) % 2 == 1 {
        at = at + 1
    }
    i = 0
    while i < nums {
        match number_cap(if i < NUMBER_NAMES.len() { NUMBER_NAMES[i] } else {
            "" }, try short_at(data, at + 2 * i), false) {
            Some(c) -> caps.push(c)
            None -> {}
        }
        i = i + 1
    }
    at = at + 2 * nums
    let offsets_at = at
    at = at + 2 * strs
    try need(data, at + table_size)
    let table = data.slice(at, at + table_size)
    // ncurses reads the offsets only when there is a table for them to point
    // into, so an entry of nothing but cancellations has no strings at all.
    i = if table_size == 0 { strs } else { 0 }
    while i < strs {
        let offset = try short_at(data, offsets_at + 2 * i)
        match string_cap(if i < STRING_NAMES.len() { STRING_NAMES[i] } else {
            "" }, offset, table, false) {
            Some(c) -> caps.push(c)
            None -> {}
        }
        i = i + 1
    }
    at = at + table_size
    let name_text = match string_in(names, 0) {
        Some(n) -> n.to_str()
        None -> names.to_str()
    }
    var entry = TerminfoEntry{ names: name_text, caps: caps }
    if at % 2 == 1 {
        at = at + 1
    }
    if at + 10 <= data.len() {
        entry = try extended(data, at, entry)
    }
    return entry
}

/// The extended section: counts, values, and the names of the capabilities
/// after the string values in its table.
fn extended(data: bytes, start: i64, entry: TerminfoEntry) -> TerminfoEntry ! TerminfoError {
    var out = entry
    let bools = try short_at(data, start)
    let nums = try short_at(data, start + 2)
    let strs = try short_at(data, start + 4)
    let items = try short_at(data, start + 6)
    let table_size = try short_at(data, start + 8)
    var at = start + 10
    try need(data, at + bools)
    let bool_values = data.slice(at, at + bools)
    at = at + bools
    if bools % 2 == 1 {
        at = at + 1
    }
    let nums_at = at
    at = at + 2 * nums
    let offsets_at = at
    at = at + 2 * items
    try need(data, at + table_size)
    let table = data.slice(at, at + table_size)
    // Names are stored after the string values; their offsets count from
    // the end of the last value.
    var base = 0
    var i = 0
    while i < strs {
        let offset = try short_at(data, offsets_at + 2 * i)
        if offset >= 0 {
            match string_in(table, offset) {
                Some(v) -> base = base + v.len() + 1
                None -> {}
            }
        }
        i = i + 1
    }
    var names: [str] = []
    i = strs
    while i < items {
        let offset = try short_at(data, offsets_at + 2 * i)
        names.push(match string_in(table, base + offset) {
            Some(n) -> n.to_str()
            None -> ""
        })
        i = i + 1
    }
    i = 0
    while i < bools and i < names.len() {
        match bool_cap(names[i], bool_values.at(i), true) {
            Some(c) -> out.caps.push(c)
            None -> {}
        }
        i = i + 1
    }
    i = 0
    while i < nums and bools + i < names.len() {
        match number_cap(names[bools + i], try short_at(data, nums_at + 2 * i),
            true) {
            Some(c) -> out.caps.push(c)
            None -> {}
        }
        i = i + 1
    }
    i = 0
    while i < strs and bools + nums + i < names.len() {
        match string_cap(names[bools + nums + i], try short_at(data,
            offsets_at + 2 * i), table, true) {
            Some(c) -> out.caps.push(c)
            None -> {}
        }
        i = i + 1
    }
    return out
}

/// A capability by name.
pub fn find(entry: TerminfoEntry, name: str) -> Option[TerminfoCap] {
    for c in entry.caps {
        if c.name == name and c.state == "set" {
            return Some(c)
        }
    }
    return None
}

fn is_digit(b: i64) -> bool {
    return b >= 48 and b <= 57
}

fn is_print(b: i64) -> bool {
    return b >= 32 and b < 127
}

fn octal(b: i64) -> str {
    return "\\" + "{b / 64}{b / 8 % 8}{b % 8}"
}

/// `acsc` as `infocmp` prints it: when its pairs are out of order by their
/// first character, rebuilt in order, a later pair for the same character
/// winning, and an odd last character kept at the end.
pub fn repair_acsc(value: bytes) -> bytes {
    var ordered = true
    var last = -1
    var i = 0
    while i < value.len() {
        if i % 2 == 0 {
            if value.at(i) < last {
                ordered = false
            }
            last = value.at(i)
        }
        i = i + 1
    }
    if ordered {
        return value
    }
    var mapped: [i64] = []
    var k = 0
    while k < 256 {
        mapped.push(0)
        k = k + 1
    }
    var extra = 0
    i = 0
    while i < value.len() {
        if i + 1 < value.len() {
            mapped[value.at(i)] = value.at(i + 1)
            i = i + 2
        } else {
            extra = value.at(i)
            i = i + 1
        }
    }
    var out: [i64] = []
    k = 0
    while k < 256 {
        if mapped[k] != 0 {
            out.push(k)
            out.push(mapped[k])
        }
        k = k + 1
    }
    if extra != 0 {
        out.push(extra)
    }
    return bytes_of(out)
}

fn trailing_spaces(value: bytes, from: i64) -> bool {
    var i = from
    while i < value.len() {
        if value.at(i) != 32 {
            return false
        }
        i = i + 1
    }
    return true
}

/// A string capability's value with `infocmp`'s escapes, `_nc_tic_expand`.
pub fn expand(value: bytes) -> str {
    let long = value.len() > 3
    var out = ""
    var i = 0
    while i < value.len() {
        let c = value.at(i)
        let next = if i + 1 < value.len() { value.at(i + 1) } else { 0 }
        if c == 37 and is_print(next) {
            // The character after a `%` is copied as it is, whatever it is.
            out = out + "%" + next.to_char()
            i = i + 1
        } else if c == 128 {
            out = out + "\\0"
        } else if c == 27 {
            out = out + "\\E"
        } else if c == 92 and (i == 0 or value.at(i - 1) != 94) {
            out = out + "\\\\"
        } else if c == 32 and (i == 0 or trailing_spaces(value, i)) {
            out = out + "\\s"
        } else if c == 44 or c == 58 or c == 94 {
            out = out + "\\" + c.to_char()
        } else if is_print(c) {
            out = out + c.to_char()
        } else if c == 13 and (long or (value.len() > 2 and i == value.len() - 1)) {
            out = out + "\\r"
        } else if c == 10 and long {
            out = out + "\\n"
        } else if c < 32 and (not long or is_digit(next)) {
            out = out + "^" + (c + 64).to_char()
        } else {
            out = out + octal(c)
        }
        i = i + 1
    }
    return out
}

fn line_of(c: TerminfoCap) -> str {
    if c.state == "cancelled" {
        return "\t" + c.name + "@,"
    }
    if c.kind == "bool" {
        return "\t" + c.name + ","
    }
    if c.kind == "num" {
        return "\t" + c.name + "#{c.number},"
    }
    let value = if c.name == "acsc" { repair_acsc(c.text) } else { c.text }
    return "\t" + c.name + "=" + expand(value) + ","
}

fn section(entry: TerminfoEntry, kind: str, extended: bool, show_obsolete: bool) -> [str] {
    var picked: [TerminfoCap] = []
    for c in entry.caps {
        if c.kind == kind and c.extended == extended and
        (show_obsolete or not c.name.starts_with("OT")) {
            picked.push(c)
        }
    }
    picked.sort_by(|c| c.name)
    var out: [str] = []
    for c in picked {
        out.push(line_of(c))
    }
    return out
}

/// What `infocmp -1` prints for the entry, `-x` included when `extended`.
pub fn render(entry: TerminfoEntry, path: str, extended: bool) -> str {
    var lines = ["#\tReconstructed via infocmp from file: " + path,
        entry.names + ","]
    for kind in ["bool", "num", "str"] {
        lines = lines + section(entry, kind, false, extended)
        if extended {
            lines = lines + section(entry, kind, true, true)
        }
    }
    return lines.join("\n") + "\n"
}
