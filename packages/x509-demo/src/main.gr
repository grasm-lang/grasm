// Verify a DER certificate's signature, and prove the check is real by
// breaking the certificate and watching it fail.
import x509
import bytes_codec


/// A real certificate, so this program proves something when run with no
/// arguments — which is how every engine runs it in the agreement gates.
///
/// Generated by OpenSSL: a self-signed P-256 certificate for `grasm.test`.
/// Embedded rather than read from disk because three of the four engines have
/// no filesystem, and a check only two of them can run is not an agreement.
fn sample() -> bytes {
    let hex = "3082019f30820145a0030201020214537c727e632819016d17dcf151af7d641c" +
    "75da67300a06082a8648ce3d04030230253113301106035504030c0a67726173" +
    "6d2e74657374310e300c060355040a0c05477261736d301e170d323630383330" +
    "3233333935355a170d3336303832373233333935355a30253113301106035504" +
    "030c0a677261736d2e74657374310e300c060355040a0c05477261736d305930" +
    "1306072a8648ce3d020106082a8648ce3d030107034200043f3dcc5ab8b9ed51" +
    "e2491c297f186942da421d016632f16778501a0a0a9ac3686f6e85697397aaa0" +
    "8e6faf2ac287c105f75ef414fa262fb093c2c4f8f69cb277a3533051301d0603" +
    "551d0e0416041406e6f6d697733fc6076d0cde67c5fd1e5e8b842a301f060355" +
    "1d2304183016801406e6f6d697733fc6076d0cde67c5fd1e5e8b842a300f0603" +
    "551d130101ff040530030101ff300a06082a8648ce3d04030203480030450221" +
    "00f5bf7114c8ae5ee226fef90343d88d21000814c70e1843a919308eb66109b8" +
    "2902202f2920fd9b8e1efd627544be482a4dc140f9e1d537256f1e90a98ed6bf" +
    "a2667d"
    return bytes_codec.decode_hex(hex) ?? bytes_of([])
}

fn main() / {io} {
    let a = args()
    let der = if a.len() > 0 {
        match read_bytes(a[0]) {
            Err(_e) -> bytes_of([])
            Ok(b) -> b
        }
    } else {
        sample()
    }
    if der.len() == 0 {
        print("cannot read the certificate")
    } else {
        {
            match x509.verify_self_signed(der) {
                Err(_e) -> print("not a certificate this understands")
                Ok(ok) -> {
                    print("signature verifies: {ok}")
                    // One byte of the signed region, changed. A verifier that
                    // says `true` here is not verifying anything.
                    var flipped: [i64] = []
                    for i in 0..der.len() {
                        if i == 40 {
                            flipped.push((der.at(i) + 1) % 256)
                        } else {
                            flipped.push(der.at(i))
                        }
                    }
                    match x509.verify_self_signed(bytes_of(flipped)) {
                        Err(_e) -> print("tampered certificate: refused before verifying")
                        Ok(bad) -> print("tampered certificate verifies: {bad}")
                    }
                }
            }
        }
    }
}
