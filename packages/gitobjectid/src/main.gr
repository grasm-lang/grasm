// Object names, and how short one may be written.
//
// A git object is named by the hash of its contents, and nobody types forty
// characters. `git log` prints seven, `git rev-parse --short` prints as many
// as it needs, and both are doing the same thing: finding the shortest
// prefix that names one object in *this* repository and no other.
//
// That is why an abbreviation is not portable. `a4b2c27` names one commit in
// a repository of a hundred objects and several in a repository of ten
// million, so a tool that stores a short id has stored something that will
// stop working. The rule git uses — the minimum unique length, and never
// fewer than seven — is here because a tool printing ids beside git's own
// should print the same ones.
//
// ## Two hash lengths
//
// A SHA-1 object id is forty hexadecimal characters and a SHA-256 one is
// sixty-four. Repositories of both kinds exist and git tells them apart by
// length, so anything validating an id has to accept both — and anything
// storing one has to leave room for the longer.
//
// The all-zero id is not an object. It is git's way of writing "nothing":
// the parent of a root commit, the old value in a reflog entry that created
// a ref, the `before` side of a newly added file. Treating it as a hash and
// looking it up is a lookup that always fails, usually somewhere unhelpful.

let SHORTEST = 7

fn is_hex(c: str) -> bool {
    return (c >= "0" and c <= "9") or (c >= "a" and c <= "f") or
    (c >= "A" and c <= "F")
}

/// Whether every character is a hexadecimal digit.
pub fn is_hexadecimal(text: str) -> bool {
    if text.len() == 0 {
        return false
    }
    var i = 0
    while i < text.len() {
        if not is_hex(text.substr(i, 1)) {
            return false
        }
        i = i + 1
    }
    return true
}

/// Whether `text` is a full object id: forty characters for SHA-1, or
/// sixty-four for SHA-256.
pub fn is_full(text: str) -> bool {
    return (text.len() == 40 or text.len() == 64) and is_hexadecimal(text)
}

/// Whether `text` could be the front of one.
pub fn is_abbreviation(text: str) -> bool {
    return text.len() > 0 and text.len() < 64 and is_hexadecimal(text)
}

/// Which hash a full id came from: 1 for SHA-1, 256 for SHA-256, 0 for
/// something that is neither.
pub fn hash_size(text: str) -> i64 {
    if not is_hexadecimal(text) {
        return 0
    }
    if text.len() == 40 {
        return 1
    }
    if text.len() == 64 {
        return 256
    }
    return 0
}

/// The all-zero id, which is how git writes "no object at all".
pub fn null_id(bits: i64) -> str {
    var out = ""
    let length = if bits == 256 { 64 } else { 40 }
    var i = 0
    while i < length {
        out = out + "0"
        i = i + 1
    }
    return out
}

/// Whether an id is the all-zero one.
///
/// It is not a hash and looking it up always fails, so the check belongs
/// before the lookup rather than after it.
pub fn is_null(text: str) -> bool {
    if text.len() == 0 {
        return false
    }
    var i = 0
    while i < text.len() {
        if text.substr(i, 1) != "0" {
            return false
        }
        i = i + 1
    }
    return true
}

fn lowered(text: str) -> str {
    return text.to_lower()
}

/// How many ids in `known` start with `prefix`.
pub fn matches(known: [str], prefix: str) -> i64 {
    let front = lowered(prefix)
    var count = 0
    for id in known {
        if lowered(id).starts_with(front) {
            count = count + 1
        }
    }
    return count
}

/// The full id an abbreviation names, when it names exactly one.
///
/// An abbreviation matching several objects is ambiguous and gets nothing,
/// which is what git does rather than picking one.
pub fn expand(known: [str], prefix: str) -> Option[str] {
    let front = lowered(prefix)
    var found = ""
    var count = 0
    for id in known {
        if lowered(id).starts_with(front) {
            found = id
            count = count + 1
        }
    }
    if count == 1 {
        return Some(found)
    }
    return None
}

/// The shortest prefix of `id` that names it and nothing else in `known` —
/// never shorter than seven characters, which is git's own floor.
pub fn abbreviate(known: [str], id: str) -> str {
    var length = SHORTEST
    if length > id.len() {
        length = id.len()
    }
    while length < id.len() {
        if matches(known, id.substr(0, length)) <= 1 {
            return id.substr(0, length)
        }
        length = length + 1
    }
    return id
}

/// The same with a floor the caller chooses, which is what `core.abbrev`
/// sets.
pub fn abbreviate_to(known: [str], id: str, shortest: i64) -> str {
    var length = shortest
    if length < 1 {
        length = 1
    }
    if length > id.len() {
        length = id.len()
    }
    while length < id.len() {
        if matches(known, id.substr(0, length)) <= 1 {
            return id.substr(0, length)
        }
        length = length + 1
    }
    return id
}

/// Whether two ids or abbreviations could name the same object.
///
/// One may be short and the other full, which is the comparison a tool
/// reading user input actually needs.
pub fn same_object(a: str, b: str) -> bool {
    let left = lowered(a)
    let right = lowered(b)
    if left.len() <= right.len() {
        return right.starts_with(left)
    }
    return left.starts_with(right)
}
