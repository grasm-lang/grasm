// Ten readers and writers of object files, debug data, SQLite side files,
// machine code and Go source, each exercised once. scripts/b42_diff.sh
// holds them to nm, lipo, codesign, dyld_info, dwarfdump, SQLite, objdump
// and go/scanner.
import symtab
import machofat
import codesig
import exporttrie
import chainedfixups
import dwarfline
import sqlitewal
import sqlitejournal
import x86len
import goscanner

fn machine() {
    // push rbp; mov rbp, rsp; vpaddd zmm2, zmm1, [rax+64]; ret 8
    let code = bytes_of([85, 72, 137, 229, 98, 241, 117, 72, 254, 80, 1, 194, 8, 0])
    assert_eq(x86len.lengths(code) ?? [], [1, 3, 7, 3])
    let (toks, errs) = goscanner.tokens("x := 0x1F\nreturn /* a\nb */ y".to_bytes())
    assert_eq(errs, 0)
    assert_eq(toks.map(|t| t.tok), ["IDENT", ":=", "INT", ";", "return", "COMMENT", ";", "IDENT", ";", "EOF"])
    let (_t, bad) = goscanner.tokens("n := 08 + 0x1.0".to_bytes())
    assert_eq(bad, 2)
}

fn objects() {
    assert_eq(machofat.guess_align(4294967296, 3, 15), 15)
    assert_eq(machofat.guess_align(49152, 3, 15), 14)
    assert_eq(machofat.arch_name(16777228, 2), "arm64e")
    let not_fat = match machofat.slices("hello".to_bytes()) {
        Ok(_s) -> false
        Err(_e) -> true
    }
    assert(not_fat)
    assert_eq(codesig.flag_text(131074), "0x20002(adhoc,linker-signed)")
    let e = ExportEntry{ name: "_main", flags: 0, value: 16256, resolver: 0, import_name: "" }
    let t = exporttrie.encode([e, ExportEntry{ name: "_mainly", flags: 4, value: 16300, resolver: 0, import_name: "" }])
    let back = exporttrie.decode(t) ?? []
    assert_eq(back.map(|x| x.name), ["_main", "_mainly"])
    assert_eq(exporttrie.export_line(back[1], []), "0x00003FAC  _mainly [weak-def]")
    let unsigned = match codesig.signature("not mach-o".to_bytes(), 0) {
        Ok(_s) -> false
        Err(_e) -> true
    }
    assert(unsigned)
    let no_fixups = match chainedfixups.parse("x".to_bytes(), 0) {
        Ok(_p) -> false
        Err(_e) -> true
    }
    assert(no_fixups)
    let no_syms = match symtab.symbols("x".to_bytes(), 0) {
        Ok(_s) -> false
        Err(_e) -> true
    }
    assert(no_syms)
}

fn filled(v: i64, n: i64) -> bytes {
    var out: [i64] = []
    for _k in 0..n {
        out.push(v)
    }
    return bytes_of(out)
}

fn databases() {
    // One page changed in a two-page database, by a log written here.
    let page = filled(0, 512)
    let db = filled(1, 1024)
    let wal = sqlitewal.encode(512, 0, 7, 9, [(2, page)], 2) ?? bytes_of([])
    assert(sqlitewal.header_holds(wal))
    let after = sqlitewal.apply(db, wal) ?? bytes_of([])
    assert_eq(after.slice(512, 1024), page)
    assert_eq(after.slice(0, 512), db.slice(0, 512))
    assert_eq(sqlitejournal.record_checksum(5, filled(3, 1024)), 5 + 3 * 5)
    assert_eq(sqlitejournal.rollback(db, bytes_of([])) ?? bytes_of([]), db)
    // A line table of one sequence: two rows from four opcodes.
    let unit = bytes_of([48, 0, 0, 0, 4, 0, 27, 0, 0, 0, 1, 1, 1, 251, 14, 13, 0, 1, 1, 1, 1, 0, 0, 0, 1, 0, 0, 1, 0, 97, 46, 99, 0, 0, 0, 0, 0,
        0, 9, 2, 0, 16, 0, 0, 0, 0, 0, 0, 19, 0, 1, 1])
    let tables = dwarfline.tables(unit, bytes_of([]), bytes_of([])) ?? []
    assert_eq(tables.len(), 1)
    assert_eq(tables[0].files[1].name, "a.c")
    assert_eq(tables[0].rows.map(|r| (r.address, r.line, r.end_sequence)), [(4096, 2, false), (4096, 2, true)])
}

fn main() / {io} {
    machine()
    objects()
    databases()
    print("ten formats exercised")
}
