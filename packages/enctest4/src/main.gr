import base32hex
import filemode
import htmlentities

fn from_hex(text: str) -> bytes {
    var out: [i64] = []
    var i = 1
    while i + 1 < text.len() {
        out.push(text.substr(i, 2).parse_int_base(16) ?? 0)
        i = i + 2
    }
    return bytes_of(out)
}

fn to_hex(raw: bytes) -> str {
    let digits = "0123456789abcdef"
    var out = ""
    var i = 0
    while i < raw.len() {
        out = out + digits.substr(raw.at(i) / 16, 1) +
        digits.substr(raw.at(i) % 16, 1)
        i = i + 1
    }
    return out
}

fn main() / {io} {
    var i = 0
    while i + 1 < args().len() {
        let what = args()[i]
        let arg = args()[i + 1]
        if what == "b32h" {
            print(base32hex.encode(from_hex(arg)))
        } else if what == "b32hn" {
            print(base32hex.encode_unpadded(from_hex(arg)))
        } else if what == "b32hd" {
            match base32hex.decode(arg.substr(1, arg.len() - 1)) {
                Ok(raw) -> print(to_hex(raw))
                Err(_e) -> print("bad")
            }
        } else if what == "mode" {
            print(filemode.render(arg.parse_int() ?? 0))
        } else if what == "octal" {
            print(filemode.octal(arg.parse_int() ?? 0))
        } else if what == "unescape" {
            // Hex out as well as in: an unescaped `&#13;` is a bare
            // carriage return, which every layer between here and the
            // comparison would quietly turn into a newline.
            print(to_hex(htmlentities.unescape(from_hex(arg).to_str())
                    .to_bytes()))
        } else if what == "names" {
            print(htmlentities.name_count().to_str())
        }
        i = i + 2
    }
}
