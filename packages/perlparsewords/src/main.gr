// Perl's Text::ParseWords (3.30, Perl 5.34): `shellwords`, `quotewords`,
// `nested_quotewords`, `parse_line` and `old_shellwords`.
//
// Perl programs split command lines, CSV-ish records and config values
// with these, and a tool reading the same text has to cut it the same
// way:
//
//   - `parse_line` takes "..." and '...' (backslash escapes only inside
//     double quotes, unless the quotes are kept), backslash-escaped
//     characters outside quotes, and a delimiter that is a regular
//     expression; a word glued to a quoted part is one word, and a
//     delimiter at the end leaves an undefined last word.
//   - An unmatched quote, or a delimiter that matches nothing, makes the
//     whole answer an empty list -- as does a backslash at the very end.
//   - Keeping (`$keep` true) leaves the quotes and backslashes in;
//     `"delimiters"` also returns each delimiter as a word.
//   - `shellwords` strips leading whitespace, splits on `\s+` and drops a
//     trailing undefined word; `old_shellwords` is the older scanner.
//
// The delimiter is matched with packages/regex (no backreferences or
// lookaround), with `\s` widened to what Perl means by it on a character
// string: Unicode White_Space.
import regex

/// What `$keep` asks for.
type ParseWordsKeep = | KeepNothing | KeepQuotes | KeepDelimiters

/// A delimiter the regular-expression package refuses.
type ParseWordsError = | ParseWordsError(msg: str)

pub fn error_text(e: ParseWordsError) -> str {
    return match e {
        ParseWordsError(m) -> m
    }
}

/// Perl's `\s` on a character string: Unicode White_Space.
fn ws_chars() -> str {
    let codes = [9, 10, 11, 12, 13, 32, 133, 160, 5760, 8192, 8193, 8194, 8195, 8196, 8197, 8198, 8199, 8200, 8201, 8202, 8232, 8233, 8239, 8287, 12288]
    return codes.map(|c| c.to_char()).join("")
}

/// `\s` and `\S` written out as Perl means them.
fn perl_classes(pattern: str) -> str {
    let cs = pattern.chars()
    var out = ""
    var in_class = false
    var i = 0
    while i < cs.len() {
        let c = cs[i]
        if c == "\\" and i + 1 < cs.len() {
            let e = cs[i + 1]
            if e == "s" {
                out = out + (if in_class { ws_chars() } else { "[" + ws_chars() + "]" })
            } else if e == "S" and not in_class {
                out = out + "[^" + ws_chars() + "]"
            } else {
                out = out + c + e
            }
            i = i + 2
            continue
        }
        if c == "[" and not in_class {
            in_class = true
        } else if c == "]" and in_class {
            in_class = false
        }
        out = out + c
        i = i + 1
    }
    return out
}

fn compile(delimiter: str) -> Regex ! ParseWordsError {
    return match regex.compile("^(?:" + perl_classes(delimiter) + ")") {
        Ok(r) -> r
        Err(e) -> fail(ParseWordsError("bad delimiter: " + e.why))
    }
}

/// One match of parse_line's pattern at the start of `line` (characters):
/// (quote, quoted, unquoted, delimiter, characters used), or None.
fn match_piece(line: [str], delim: Regex) -> Option[(str, [str], [str], str, i64)] {
    let n = line.len()
    if n > 0 and (line[0] == "\"" or line[0] == "'") {
        let q = line[0]
        var i = 1
        while i < n and line[i] != q {
            if line[i] == "\\" {
                if i + 1 >= n {
                    break
                }
                i = i + 2
            } else {
                i = i + 1
            }
        }
        if i < n and line[i] == q {
            return Some((q, line.slice(1, i), [], "", i + 1))
        }
    }
    var q = 0
    while true {
        if q == n {
            return Some(("", [], line.slice(0, q), "", q))
        }
        match regex.find(delim, line.slice(q, n).join("")) {
            Some(m) -> return Some(("", [], line.slice(0, q), m.text, q + m.text.chars().len()))
            None -> {}
        }
        let c = line[q]
        if q > 0 and (c == "\"" or c == "'") {
            return Some(("", [], line.slice(0, q), "", q))
        }
        if c == "\"" or c == "'" {
            return None
        }
        if c == "\\" {
            if q + 1 >= n {
                return None
            }
            q = q + 2
        } else {
            q = q + 1
        }
    }
    return None
}

/// `s/\\(.)/$1/sg`.
fn unescape_all(cs: [str]) -> str {
    var out = ""
    var i = 0
    while i < cs.len() {
        if cs[i] == "\\" and i + 1 < cs.len() {
            out = out + cs[i + 1]
            i = i + 2
        } else {
            out = out + cs[i]
            i = i + 1
        }
    }
    return out
}

fn parse_with(delim: Regex, keep: ParseWordsKeep, text: str) -> [Option[str]] {
    var line = text.chars()
    var pieces: [Option[str]] = []
    var word: Option[str] = None
    let keeping = match keep {
        KeepNothing -> false
        _ -> true
    }
    while line.len() > 0 {
        let (quote, quoted, unquoted, d, used) = match match_piece(line, delim) {
            Some(m) -> m
            None -> return []
        }
        if quote.len() == 0 and unquoted.len() == 0 and d.len() == 0 {
            return []
        }
        var part = ""
        if quote.len() > 0 {
            part = if keeping { quote + quoted.join("") + quote } else if quote == "\"" { unescape_all(quoted) } else { quoted.join("") }
        } else {
            part = if keeping { unquoted.join("") } else { unescape_all(unquoted) }
        }
        word = Some((word ?? "") + part)
        if d.len() > 0 {
            pieces.push(word)
            match keep {
                KeepDelimiters -> pieces.push(Some(d))
                _ -> {}
            }
            word = None
        }
        line = line.slice(used, line.len())
        if line.len() == 0 {
            pieces.push(word)
        }
    }
    return pieces
}

/// `parse_line($delimiter, $keep, $line)`.
pub fn parse_line(delimiter: str, keep: ParseWordsKeep, line: str) -> [Option[str]] ! ParseWordsError {
    return parse_with(try compile(delimiter), keep, line)
}

/// `quotewords($delimiter, $keep, @lines)`.
pub fn quotewords(delimiter: str, keep: ParseWordsKeep, lines: [str]) -> [Option[str]] ! ParseWordsError {
    let d = try compile(delimiter)
    var all: [Option[str]] = []
    for l in lines {
        let words = parse_with(d, keep, l)
        if words.len() == 0 and l.len() > 0 {
            return []
        }
        all = all + words
    }
    return all
}

/// `nested_quotewords($delimiter, $keep, @lines)`.
pub fn nested_quotewords(delimiter: str, keep: ParseWordsKeep, lines: [str]) -> [[Option[str]]] ! ParseWordsError {
    let d = try compile(delimiter)
    var all: [[Option[str]]] = []
    for l in lines {
        let words = parse_with(d, keep, l)
        if words.len() == 0 and l.len() > 0 {
            return []
        }
        all.push(words)
    }
    return all
}

fn is_ws(c: str) -> bool {
    return ws_chars().contains(c)
}

fn strip_leading_ws(cs: [str]) -> [str] {
    var i = 0
    while i < cs.len() and is_ws(cs[i]) {
        i = i + 1
    }
    return cs.slice(i, cs.len())
}

/// `shellwords(@lines)`.
pub fn shellwords(lines: [str]) -> [Option[str]] {
    let d = compile("\\s+") ?? panic("\\s+ compiles")
    var all: [Option[str]] = []
    for l in lines {
        let line = strip_leading_ws(l.chars()).join("")
        var words = parse_with(d, KeepNothing, line)
        if words.len() > 0 and words[words.len() - 1].is_none() {
            words.pop()
        }
        if words.len() == 0 and line.len() > 0 {
            return []
        }
        all = all + words
    }
    return all
}

/// One quoted run for old_shellwords at `i` (a quote there): its text
/// with backslashes resolved and where it ends, or None if unmatched.
fn old_quoted(cs: [str], i: i64) -> Option[(str, i64)] {
    let q = cs[i]
    var j = i + 1
    while j < cs.len() and cs[j] != q {
        j = j + (if cs[j] == "\\" and j + 1 < cs.len() { 2 } else { 1 })
    }
    if j >= cs.len() {
        return None
    }
    return Some((unescape_all(cs.slice(i + 1, j)), j + 1))
}

/// `old_shellwords(@lines)` (the lines joined): None where a quote is
/// left open (Perl warns and returns nothing).
pub fn old_shellwords(lines: [str]) -> Option[[str]] {
    let cs = strip_leading_ws(lines.join("").chars())
    var words: [str] = []
    var i = 0
    while i < cs.len() {
        var field = ""
        while true {
            if i >= cs.len() {
                break
            }
            let c = cs[i]
            if c == "\"" or c == "'" {
                match old_quoted(cs, i) {
                    Some((t, next)) -> {
                        field = field + t
                        i = next
                    }
                    None -> return None
                }
            } else if c == "\\" {
                field = field + (if i + 1 < cs.len() { cs[i + 1] } else { "" })
                i = i + (if i + 1 < cs.len() { 2 } else { 1 })
            } else if not is_ws(c) {
                while i < cs.len() and not is_ws(cs[i]) and cs[i] != "\\" and cs[i] != "'" and cs[i] != "\"" {
                    field = field + cs[i]
                    i = i + 1
                }
            } else {
                while i < cs.len() and is_ws(cs[i]) {
                    i = i + 1
                }
                break
            }
        }
        words.push(field)
    }
    return Some(words)
}
