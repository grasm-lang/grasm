// Reading a SQLite database file directly, without SQLite.
//
// A `.db` file is a stack of fixed-size pages holding B-trees, and the whole
// format is documented and stable — stable enough that SQLite's own
// documentation promises files written today will be readable in 2050. That
// makes it a good archival format and a good thing to be able to read without
// linking a C library.
//
// This reads. It does not write, and the reason is worth stating: writing
// safely means the rollback journal or the write-ahead log, free-page
// management, and B-tree rebalancing on insert. A writer that skips any of
// those produces a file that looks fine until a crash, and then does not. A
// reader has none of that risk.
//
// What it handles: the file header, table B-trees both interior and leaf, the
// record format including all fourteen serial types, overflow pages for large
// values, and `sqlite_master` — so a file can be opened and its tables listed
// without being told what is in it.
//
// What it refuses rather than guessing:
//
// - **a file in WAL mode**, where the newest data is in a separate `-wal` file
//   and reading only the database returns a stale snapshot. That is a wrong
//   answer that looks like a right one, so the write-version byte is checked.
// - **an encrypted or corrupt file**, by the magic string.
// - **a page size that is not a power of two** in the legal range.
// - **index B-trees**, which are present in the file and are not what a
//   caller asking for rows wants.
//
// Checked against files written by Python's `sqlite3`.

import sqlparse

type SqlValue =
    | SqlNull
    | SqlInteger(n: i64)
    | SqlFloat(f: f64)
    | SqlText(s: str)
    | SqlBlob(data: bytes)

/// One row: its rowid and its column values.
type SqlRow = {
    rowid: i64,
    value: [SqlValue],
}

/// An entry in `sqlite_master`.
type SqlObject = {
    kind: str,
    name: str,
    table_name: str,
    root_page: i64,
    sql: str,
}

/// What the first hundred bytes say.
type SqlHeader = {
    page_size: i64,
    write_version: i64,
    read_version: i64,
    reserved: i64,
    page_count: i64,
    text_encoding: i64,
    schema_cookie: i64,
}

type SqliteError =
    | SqliteNotADatabase
    | SqliteWalMode
    | SqliteBadPageSize(size: i64)
    | SqliteBadPage(page: i64, kind: i64)
    | SqliteTruncated(at: i64)
    | SqliteUnsupportedEncoding(code: i64)
    | SqliteNoSuchTable(name: str)
    | SqliteCyclicPages(page: i64)
    | SqliteBadSerialType(code: i64)

fn be(data: bytes, at: i64, width: i64) -> i64 ! SqliteError {
    if at + width > data.len() {
        fail(SqliteTruncated(at))
    }
    var value = 0
    for i in 0..width {
        value = value.shl(8).bit_or(data.at(at + i))
    }
    return value
}

/// The header, checked.
pub fn header(file: bytes) -> SqlHeader ! SqliteError {
    if file.len() < 100 or
    file.slice(0, 16).to_str() != "SQLite format 3" + (0).to_char() {
        fail(SqliteNotADatabase)
    }
    var size = try be(file, 16, 2)
    // A page size of 1 means 65536, because the field is two bytes and the
    // largest legal size does not fit in them.
    if size == 1 {
        size = 65536
    }
    if size < 512 or size.bit_and(size - 1) != 0 {
        fail(SqliteBadPageSize(size))
    }
    let write_version = file.at(18)
    if write_version == 2 {
        fail(SqliteWalMode)
    }
    let encoding = try be(file, 56, 4)
    if encoding != 1 {
        fail(SqliteUnsupportedEncoding(encoding))
    }
    return SqlHeader{
        page_size: size,
        write_version: write_version,
        read_version: file.at(19),
        reserved: file.at(20),
        page_count: try be(file, 28, 4),
        text_encoding: encoding,
        schema_cookie: try be(file, 40, 4),
    }
}

/// The bytes a page can actually use, which is the page less its reserved tail.
fn usable(h: SqlHeader) -> i64 {
    return h.page_size - h.reserved
}

fn page_bytes(file: bytes, h: SqlHeader, page: i64) -> bytes ! SqliteError {
    let at = (page - 1) * h.page_size
    if page < 1 or at + h.page_size > file.len() {
        fail(SqliteTruncated(at))
    }
    return file.slice(at, at + h.page_size)
}

// ----------------------------------------------------------- the varint

/// A SQLite varint: up to nine bytes, big-endian, seven bits each — except
/// the ninth, which contributes all eight.
///
/// That last exception is the part hand-written readers get wrong: eight
/// groups of seven is 56 bits, so the ninth byte has to be whole for the type
/// to reach 64.
fn varint(data: bytes, at: i64) -> (i64, i64) ! SqliteError {
    var value = 0
    var i = 0
    while i < 8 {
        if at + i >= data.len() {
            fail(SqliteTruncated(at + i))
        }
        let b = data.at(at + i)
        value = value.shl(7).bit_or(b.bit_and(127))
        if b < 128 {
            return (value, at + i + 1)
        }
        i = i + 1
    }
    if at + 8 >= data.len() {
        fail(SqliteTruncated(at + 8))
    }
    return (value.shl(8).bit_or(data.at(at + 8)), at + 9)
}

// -------------------------------------------------------------- records

/// How many bytes a serial type occupies.
pub fn serial_width(code: i64) -> i64 {
    if code == 0 or code == 8 or code == 9 {
        return 0
    }
    if code >= 1 and code <= 4 {
        return code
    }
    if code == 5 {
        return 6
    }
    if code == 6 or code == 7 {
        return 8
    }
    if code >= 12 {
        return (code - 12) / 2
    }
    return 0
}

fn signed(data: bytes, at: i64, width: i64) -> i64 ! SqliteError {
    let raw = try be(data, at, width)
    let sign = (1).shl(width * 8 - 1)
    if width < 8 and raw >= sign {
        return raw - sign * 2
    }
    return raw
}

/// Decode one record: the header of serial types, then the values.
pub fn decode_record(payload: bytes) -> [SqlValue] ! SqliteError {
    let head = try varint(payload, 0)
    let header_size = head.0
    var at = head.1
    var codes: [i64] = []
    while at < header_size {
        let step = try varint(payload, at)
        codes.push(step.0)
        at = step.1
    }
    var out: [SqlValue] = []
    var body = header_size
    for code in codes {
        if code == 0 {
            out.push(SqlNull)
        } else {
            if code == 8 {
                out.push(SqlInteger(0))
            } else {
                if code == 9 {
                    out.push(SqlInteger(1))
                } else {
                    if code == 10 or code == 11 {
                        fail(SqliteBadSerialType(code))
                    } else {
                        out.push(try one_value(payload, body, code))
                    }
                }
            }
        }
        body = body + serial_width(code)
    }
    return out
}

fn one_value(payload: bytes, at: i64, code: i64) -> SqlValue ! SqliteError {
    if code >= 1 and code <= 6 {
        return SqlInteger(try signed(payload, at, serial_width(code)))
    }
    if code == 7 {
        return SqlFloat((try be(payload, at, 8)).from_bits())
    }
    let width = serial_width(code)
    if at + width > payload.len() {
        fail(SqliteTruncated(at))
    }
    let run = payload.slice(at, at + width)
    // Even is a blob and odd is text, from 12 up. One bit of the serial type
    // carries the whole distinction between a string and a byte run.
    if code % 2 == 0 {
        return SqlBlob(run)
    }
    return SqlText(run.to_str())
}

// ------------------------------------------------------------- B-trees

/// Where a page's B-tree header starts: page 1 shares its page with the file
/// header.
fn tree_offset(page: i64) -> i64 {
    if page == 1 {
        return 100
    }
    return 0
}

/// Every row of the table rooted at `root`.
pub fn rows_of(file: bytes, h: SqlHeader, root: i64) -> [SqlRow] ! SqliteError {
    var out: [SqlRow] = []
    var seen: [i64] = []
    try walk(file, h, root, out, seen, 0)
    return out
}

fn walk(file: bytes, h: SqlHeader, page: i64, inout out: [SqlRow],
    inout seen: [i64], depth: i64) ! SqliteError {
    if depth > 64 {
        fail(SqliteCyclicPages(page))
    }
    for s in seen {
        if s == page {
            fail(SqliteCyclicPages(page))
        }
    }
    seen.push(page)
    let raw = try page_bytes(file, h, page)
    let base = tree_offset(page)
    let kind = raw.at(base)
    if kind != 5 and kind != 13 {
        // 2 and 10 are index pages, which hold keys rather than rows.
        fail(SqliteBadPage(page, kind))
    }
    let cells = try be(raw, base + 3, 2)
    let pointers = base + (if kind == 5 { 12 } else { 8 })
    for i in 0..cells {
        let at = try be(raw, pointers + i * 2, 2)
        if kind == 13 {
            out.push(try leaf_cell(file, h, raw, at))
        } else {
            let child = try be(raw, at, 4)
            try walk(file, h, child, out, seen, depth + 1)
        }
    }
    if kind == 5 {
        let rightmost = try be(raw, base + 8, 4)
        try walk(file, h, rightmost, out, seen, depth + 1)
    }
}

/// One leaf cell: a payload size, a rowid, the payload, and maybe an overflow
/// chain.
fn leaf_cell(file: bytes, h: SqlHeader, raw: bytes,
    at: i64) -> SqlRow ! SqliteError {
    let sized = try varint(raw, at)
    let total = sized.0
    let keyed = try varint(raw, sized.1)
    let rowid = keyed.0
    let start = keyed.1
    let local = local_size(h, total)
    if start + local > raw.len() {
        fail(SqliteTruncated(start))
    }
    var payload = raw.slice(start, start + local)
    if local < total {
        let next = try be(raw, start + local, 4)
        payload = try follow_overflow(file, h, payload, next, total)
    }
    return SqlRow{ rowid: rowid, value: try decode_record(payload) }
}

/// How much of a payload stays on the leaf page.
///
/// The formula is SQLite's own, and it is not "as much as fits": a payload
/// that would leave a nearly empty page is split so that the local part is at
/// least `M`, which keeps the tree shallow. Getting this wrong reads the
/// overflow pointer from the middle of the data.
fn local_size(h: SqlHeader, total: i64) -> i64 {
    let u = usable(h)
    let x = u - 35
    if total <= x {
        return total
    }
    let m = ((u - 12) * 32 / 255) - 23
    let k = m + ((total - m) % (u - 4))
    if k <= x {
        return k
    }
    return m
}

fn follow_overflow(file: bytes, h: SqlHeader, first: bytes, page: i64,
    total: i64) -> bytes ! SqliteError {
    var out = first
    var next = page
    var guard = 0
    while next != 0 and out.len() < total {
        if guard > 100000 {
            fail(SqliteCyclicPages(next))
        }
        let raw = try page_bytes(file, h, next)
        next = try be(raw, 0, 4)
        var take = usable(h) - 4
        if out.len() + take > total {
            take = total - out.len()
        }
        out = out.concat(raw.slice(4, 4 + take))
        guard = guard + 1
    }
    return out
}

// ------------------------------------------------------------- schema

/// Everything in `sqlite_master`: tables, indexes, views and triggers.
pub fn objects(file: bytes) -> [SqlObject] ! SqliteError {
    let h = try header(file)
    var out: [SqlObject] = []
    for row in try rows_of(file, h, 1) {
        if row.value.len() >= 5 {
            out.push(SqlObject{
                kind: text_of(row.value[0]),
                name: text_of(row.value[1]),
                table_name: text_of(row.value[2]),
                root_page: int_of(row.value[3]),
                sql: text_of(row.value[4]),
            })
        }
    }
    return out
}

/// The names of the tables a user created.
///
/// `sqlite_` is a reserved prefix, so the internal objects are the ones with
/// it and they are left out here — a caller asking for the tables does not
/// mean `sqlite_sequence`.
pub fn table_names(file: bytes) -> [str] ! SqliteError {
    var out: [str] = []
    for o in try objects(file) {
        if o.kind == "table" and not o.name.starts_with("sqlite_") {
            out.push(o.name)
        }
    }
    return out
}

/// Every row of a named table.
pub fn table_rows(file: bytes, name: str) -> [SqlRow] ! SqliteError {
    let h = try header(file)
    for o in try objects(file) {
        if o.kind == "table" and o.name == name {
            if o.root_page == 0 {
                fail(SqliteNoSuchTable(name))
            }
            return try rows_of(file, h, o.root_page)
        }
    }
    fail(SqliteNoSuchTable(name))
}

/// The column names of a table, from the `CREATE TABLE` text it was made with.
///
/// From the SQL rather than from a catalogue, because SQLite has no catalogue
/// of columns — `PRAGMA table_info` parses the same string at run time. This
/// takes the names between the outermost parentheses, which is what that
/// pragma does.
pub fn column_names(file: bytes, name: str) -> [str] ! SqliteError {
    for o in try objects(file) {
        if o.kind == "table" and o.name == name {
            return columns_from_sql(o.sql)
        }
    }
    fail(SqliteNoSuchTable(name))
}

fn columns_from_sql(sql: str) -> [str] {
    let open = sql.index_of("(") ?? (0 - 1)
    if open < 0 {
        return []
    }
    var depth = 0
    var body = ""
    var i = open
    while i < sql.len() {
        let c = sql.substr(i, 1)
        if c == "(" {
            depth = depth + 1
            if depth == 1 {
                i = i + 1
                continue
            }
        }
        if c == ")" {
            depth = depth - 1
            if depth == 0 {
                break
            }
        }
        body = body + c
        i = i + 1
    }
    var out: [str] = []
    var current = ""
    var nesting = 0
    for c in body.chars() {
        if c == "(" {
            nesting = nesting + 1
        }
        if c == ")" {
            nesting = nesting - 1
        }
        if c == "," and nesting == 0 {
            push_column(out, current)
            current = ""
        } else {
            current = current + c
        }
    }
    push_column(out, current)
    return out
}

fn push_column(inout out: [str], text: str) {
    let trimmed = text.trim()
    if trimmed == "" {
        return
    }
    let first = trimmed.split(" ")[0]
    let upper = first.to_upper()
    // A table constraint is not a column, and it begins with a keyword.
    if upper == "PRIMARY" or upper == "UNIQUE" or upper == "CHECK" or
    upper == "FOREIGN" or upper == "CONSTRAINT" {
        return
    }
    out.push(sqlparse.unquote(first))
}

// ---------------------------------------------------------- accessors

pub fn value_kind(v: SqlValue) -> str {
    match v {
        SqlNull -> return "null"
        SqlInteger(_n) -> return "integer"
        SqlFloat(_f) -> return "real"
        SqlText(_s) -> return "text"
        SqlBlob(_d) -> return "blob"
    }
}

pub fn text_of(v: SqlValue) -> str {
    match v {
        SqlText(s) -> return s
        SqlInteger(n) -> return "{n}"
        SqlFloat(f) -> return "{f}"
        _ -> return ""
    }
}

pub fn int_of(v: SqlValue) -> i64 {
    match v {
        SqlInteger(n) -> return n
        SqlFloat(f) -> return f.as_i64()
        _ -> return 0
    }
}

pub fn float_of(v: SqlValue) -> f64 {
    match v {
        SqlFloat(f) -> return f
        SqlInteger(n) -> return n.as_f64()
        _ -> return 0.0
    }
}

pub fn blob_of(v: SqlValue) -> bytes {
    match v {
        SqlBlob(d) -> return d
        _ -> return "".to_bytes()
    }
}

pub fn is_null(v: SqlValue) -> bool {
    match v {
        SqlNull -> return true
        _ -> return false
    }
}

/// A row's value under a column name.
pub fn field(file: bytes, table: str, row: SqlRow,
    column: str) -> SqlValue ! SqliteError {
    let names = try column_names(file, table)
    for i in 0..names.len() {
        if names[i] == column and i < row.value.len() {
            // An `INTEGER PRIMARY KEY` column is the rowid and is stored as
            // NULL in the record, because the rowid already holds it. Reading
            // the record alone gives null for the primary key of every row.
            match row.value[i] {
                SqlNull -> return SqlInteger(row.rowid)
                _ -> return row.value[i]
            }
        }
    }
    fail(SqliteNoSuchTable(column))
}
