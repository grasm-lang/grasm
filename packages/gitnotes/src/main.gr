// Git notes: text attached to objects without changing them, kept in a
// tree under refs/notes/ -- review results (Gerrit), CI status, code
// review comments, `git notes` and `git log --notes`.
//
// A notes tree names each note by the id of the object it annotates. With
// many notes the names fan out into directories of two hex digits ("ab/"
// then "cdef..."), as many levels as needed; a reader joins the
// directories back into the id. Entries that are not notes are kept.
//
// Git decides the fanout from a 16-way trie of the ids, one hex digit a
// level: going down a note's path, at each even depth within the current
// fanout it looks at the 16 slots, and when every one holds two or more
// notes the fanout grows by one directory level. `write` builds the
// trees that way from the notes alone, as git does when it holds them all
// in memory.
//
// `combine_concatenate` and `combine_cat_sort_uniq` merge two notes as
// git's union and cat_sort_uniq strategies do.
//
// Checked against git 2.48: notes trees git writes, with thousands of
// notes and several fanout levels, read here as `git notes list` lists
// them; trees written here read by git; and `git notes merge` with both
// strategies.
import sha1

type NoteEntry = { object: str, blob: str }

type NotesTreeItem = { path: str, mode: str, id: str }

type NotesError =
    | NotesMalformed(why: str)
    | NotesMissing(id: str)

fn hex(b: bytes) -> str {
    let digits = "0123456789abcdef"
    var parts: [str] = []
    for i in 0..b.len() {
        parts.push(digits.substr(b.at(i) / 16, 1) + digits.substr(b.at(i) % 16, 1))
    }
    return parts.join("")
}

fn unhex(s: str) -> bytes {
    var out: [i64] = []
    var i = 0
    while i + 1 < s.len() {
        out.push(s.substr(i, 2).parse_int_base(16) ?? 0)
        i = i + 2
    }
    return bytes_of(out)
}

/// A tree object's entries: mode, name, id.
pub fn tree_entries(content: bytes) -> [(str, str, str)] ! NotesError {
    var out: [(str, str, str)] = []
    var i = 0
    while i < content.len() {
        var sp = i
        while sp < content.len() and content.at(sp) != 32 {
            sp = sp + 1
        }
        var nul = sp
        while nul < content.len() and content.at(nul) != 0 {
            nul = nul + 1
        }
        if nul + 21 > content.len() {
            fail(NotesMalformed("a tree entry cut short"))
        }
        out.push((content.slice(i, sp).to_str(), content.slice(sp + 1, nul).to_str(), hex(content.slice(nul + 1, nul + 21))))
        i = nul + 21
    }
    return out
}

fn is_hex(s: str) -> bool {
    return s.chars().all(|c| c >= "0" and c <= "9" or c >= "a" and c <= "f")
}

fn collect(lookup: fn(str) -> Option[bytes], tree: str, prefix: str, path: str, inout notes: [NoteEntry], inout other: [NotesTreeItem], depth: i64) -> () ! NotesError {
    if depth > 20 {
        fail(NotesMalformed("a notes tree too deep"))
    }
    let content = lookup(tree) ?? fail(NotesMissing(tree))
    for (mode, name, id) in try tree_entries(content) {
        let full = prefix + name
        let p = if path.len() == 0 { name } else { path + "/" + name }
        if mode == "40000" and name.len() == 2 and is_hex(name) and full.len() < 40 {
            try collect(lookup, id, full, p, notes, other, depth + 1)
        } else if mode != "40000" and full.len() == 40 and is_hex(full) {
            notes.push(NoteEntry{ object: full, blob: id })
        } else {
            other.push(NotesTreeItem{ path: p, mode: mode, id: id })
        }
    }
}

/// The notes in a notes tree, and the entries that are not notes.
pub fn read(lookup: fn(str) -> Option[bytes], tree: str) -> ([NoteEntry], [NotesTreeItem]) ! NotesError {
    var notes: [NoteEntry] = []
    var other: [NotesTreeItem] = []
    try collect(lookup, tree, "", "", notes, other, 0)
    notes.sort_by(|n| n.object)
    return (notes, other)
}

/// The note for an object, if any.
pub fn note_for(notes: [NoteEntry], object: str) -> Option[str] {
    for n in notes {
        if n.object == object {
            return Some(n.blob)
        }
    }
    return None
}

/// How many ids start with each prefix (of every length), so the trie's
/// shape can be read off without walking it.
pub fn prefix_counts(ids: [str]) -> Map[str, i64] {
    var m: Map[str, i64] = {}
    for id in ids {
        for n in 0..(id.len() + 1) {
            let p = id.substr(0, n)
            m.set(p, (m.get(p) ?? 0) + 1)
        }
    }
    return m
}

/// The fanout git gives a note: down its path through the trie, at each
/// node (a prefix two or more notes share) of even depth n with n at most
/// twice the fanout so far, the fanout grows by one when all 16 slots
/// below are nodes too.
pub fn fanout_for(counts: Map[str, i64], id: str) -> i64 {
    let digits = "0123456789abcdef"
    var fanout = 0
    var n = 0
    while n < id.len() {
        let prefix = id.substr(0, n)
        if n > 0 and (counts.get(prefix) ?? 0) < 2 {
            break
        }
        if n % 2 == 0 and n <= 2 * fanout {
            var full = true
            for k in 0..16 {
                if (counts.get(prefix + digits.substr(k, 1)) ?? 0) < 2 {
                    full = false
                }
            }
            if full {
                fanout = fanout + 1
            }
        }
        n = n + 1
    }
    return fanout
}

fn tree_object(entries: [(str, str, str)]) -> (str, bytes) {
    var body: [i64] = []
    for (mode, name, id) in entries {
        for x in (mode + " " + name).to_bytes().to_list() {
            body.push(x)
        }
        body.push(0)
        for x in unhex(id).to_list() {
            body.push(x)
        }
    }
    let content = bytes_of(body)
    let framed = bytes_of(("tree {content.len()}").to_bytes().to_list() + [0] + body)
    return (sha1.hex(framed), content)
}

fn build(notes: [(str, str, i64)], prefix: str, inout trees: [(str, bytes)]) -> str {
    let level = prefix.len() / 2
    var entries: [(str, str, str)] = []
    var dirs: [str] = []
    for (id, blob, fanout) in notes {
        if not id.starts_with(prefix) {
            continue
        }
        if fanout > level {
            let d = id.substr(prefix.len(), 2)
            if not dirs.any(|x| x == d) {
                dirs.push(d)
            }
        } else {
            entries.push(("100644", id.substr(prefix.len(), 40 - prefix.len()), blob))
        }
    }
    for d in dirs {
        let sub = build(notes, prefix + d, trees)
        entries.push(("40000", d, sub))
    }
    // Git sorts tree entries by name, a directory as if followed by "/".
    entries.sort_by(|e| if e.0 == "40000" { e.1 + "/" } else { e.1 })
    let (id, content) = tree_object(entries)
    trees.push((id, content))
    return id
}

/// The tree objects of a notes tree holding these notes, with git's
/// fanout: the root's id, and every tree (id and content).
pub fn write(notes: [NoteEntry]) -> (str, [(str, bytes)]) {
    let counts = prefix_counts(notes.map(|n| n.object))
    var with_fanout: [(str, str, i64)] = []
    for n in notes {
        with_fanout.push((n.object, n.blob, fanout_for(counts, n.object)))
    }
    var trees: [(str, bytes)] = []
    let root = build(with_fanout, "", trees)
    return (root, trees)
}

/// Two notes as git's "union" strategy joins them: the first without one
/// trailing newline, a blank line, the second; an empty one gives the
/// other.
pub fn combine_concatenate(current: str, incoming: str) -> str {
    if incoming.len() == 0 {
        return current
    }
    if current.len() == 0 {
        return incoming
    }
    let cur = if current.ends_with("\n") { current.substr(0, current.len() - 1) } else { current }
    return cur + "\n\n" + incoming
}

/// Two notes as git's "cat_sort_uniq" strategy joins them: every line of
/// both, empty lines dropped, sorted bytewise, each once, each ended with
/// a newline.
pub fn combine_cat_sort_uniq(current: str, incoming: str) -> str {
    var lines: [str] = []
    for x in current.split("\n") + incoming.split("\n") {
        if x.len() > 0 {
            lines.push(x)
        }
    }
    lines.sort()
    var out: [str] = []
    for x in lines {
        if out.len() == 0 or out[out.len() - 1] != x {
            out.push(x)
        }
    }
    return out.map(|x| x + "\n").join("")
}
