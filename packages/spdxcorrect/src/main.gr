// Fixing the `license` field people actually write: `MIT License`,
// `Apache 2`, `GPLv3`, `BSD 3 clause`, `New BSD`, `Attribution-NonCommercial`.
//
// npm runs every `license` through spdx-correct before it warns, and so do
// the tools that read package.json after it. It tries, in order: the text
// as it stands; without a trailing `+`; 27 small rewrites (upper case, no
// periods, no spaces, `v` for `-`, `-2.0` from a bare `2`, `-only` or
// `-or-later` for a GPL, `-Clause` for a BSD, `CC-` in front...), keeping
// the first that parses; the same after each of 35 common misspellings
// (`GLP`, `APGL` for `AGPL`, `GNU Lesser General Public License`),
// longest first; a substring guess (`APACHE` anywhere is Apache-2.0, any
// licence with a single version is that version); and the guess after a
// misspelling. A GPL family name without `-only` or `-or-later` is
// upgraded to the one it meant.
//
// What counts as parsing is spdx-expression-parse 3.0.1 (the copy
// spdx-correct carries), quirks included: its scanner looks for the next
// identifier anywhere ahead rather than at the cursor, so `#MIT` reads as
// `MIT` and then fails on the `T` it skipped back over; `+` after a space
// is refused; `()` and a dangling operator throw from inside the parser.
// The license and exception lists are spdx-license-ids 3.0.22 (deprecated
// identifiers included) and spdx-exceptions 2.5.0; the rewrite tables and
// their order (sorted by length, then by `localeCompare` of the upper
// case) are spdx-correct 3.2.0's, as Node sorts them.
//
// `correct` gives the corrected expression, None where nothing fits, or
// the TypeError spdx-correct throws (it does, for `+`: a rewrite reaches
// for the first character of an empty string).
import jsnumber

type SpdxTables = { licenses: [str], exceptions: [str], transpositions: [(str, str)], last_resorts: [(str, str)] }

type SpdxToken = { kind: str, text: str }

/// spdx-expression-parse threw.
type SpdxParseError =
    | SpdxParseFailed()

type SpdxCorrectError =
    | SpdxInvalidArgument()
    | SpdxTypeError(why: str)

