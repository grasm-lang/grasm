/// The lists, built once and passed down (a top-level list is rebuilt on
/// every read).
pub fn tables() -> SpdxTables {
    return SpdxTables{ licenses: LICENSE_IDS, exceptions: EXCEPTION_IDS, transpositions: TRANSPOSITIONS, last_resorts: LAST_RESORTS }
}

// --- spdx-expression-parse 3.0.1 --------------------------------------------

fn is_id_char(c: i64) -> bool {
    return c >= 65 and c <= 90 or c >= 97 and c <= 122 or c >= 48 and c <= 57 or c == 45 or c == 46
}

type SpdxScanner = { c: [i64], at: i64 }

fn starts_at(c: [i64], at: i64, s: str) -> bool {
    let w = s.codes()
    return at + w.len() <= c.len() and c.slice(at, at + w.len()) == w
}

/// `/[A-Za-z0-9-.]+/` matched against the rest of the text -- not
/// anchored: the first run anywhere ahead, while the cursor moves on by
/// the run's length from where it was.
fn idstring(inout s: SpdxScanner) -> Option[str] {
    var i = s.at
    while i < s.c.len() and not is_id_char(s.c[i]) {
        i = i + 1
    }
    if i >= s.c.len() {
        return None
    }
    var e = i
    while e < s.c.len() and is_id_char(s.c[e]) {
        e = e + 1
    }
    s.at = s.at + (e - i)
    return Some(s.c.slice(i, e).map(|x| x.to_char()).join(""))
}

fn next_token(t: SpdxTables, inout s: SpdxScanner) -> Option[SpdxToken] ! SpdxParseError {
    for op in ["WITH", "AND", "OR", "(", ")", ":", "+"] {
        if starts_at(s.c, s.at, op) {
            s.at = s.at + op.len()
            if op == "+" and s.at > 1 and s.c[s.at - 2] == 32 {
                fail(SpdxParseFailed())
            }
            return Some(SpdxToken{ kind: "OPERATOR", text: op })
        }
    }
    for (prefix, kind) in [("DocumentRef-", "DOCUMENTREF"), ("LicenseRef-", "LICENSEREF")] {
        if starts_at(s.c, s.at, prefix) {
            s.at = s.at + prefix.len()
            let id = idstring(s) ?? fail(SpdxParseFailed())
            return Some(SpdxToken{ kind: kind, text: id })
        }
    }
    let begin = s.at
    let id = match idstring(s) {
        Some(x) -> x
        None -> ""
    }
    if t.licenses.contains(id) {
        return Some(SpdxToken{ kind: "LICENSE", text: id })
    }
    if t.exceptions.contains(id) {
        return Some(SpdxToken{ kind: "EXCEPTION", text: id })
    }
    s.at = begin
    return None
}

fn scan(t: SpdxTables, text: str) -> [SpdxToken] ! SpdxParseError {
    var s = SpdxScanner{ c: text.codes(), at: 0 }
    var out: [SpdxToken] = []
    while s.at < s.c.len() {
        while s.at < s.c.len() and s.c[s.at] == 32 {
            s.at = s.at + 1
        }
        if s.at >= s.c.len() {
            break
        }
        match try next_token(t, s) {
            Some(tok) -> out.push(tok)
            None -> fail(SpdxParseFailed())
        }
    }
    return out
}

type SpdxParser = { toks: [SpdxToken], at: i64 }

fn operator_is(inout p: SpdxParser, op: str) -> bool {
    if p.at < p.toks.len() and p.toks[p.at].kind == "OPERATOR" and p.toks[p.at].text == op {
        p.at = p.at + 1
        return true
    }
    return false
}

/// Each parser returns whether it found something; a throw is `fail`.
fn parse_license_ref(inout p: SpdxParser) -> bool ! SpdxParseError {
    let begin = p.at
    // `token().type` on no token is a TypeError.
    if p.at >= p.toks.len() {
        fail(SpdxParseFailed())
    }
    if p.toks[p.at].kind == "DOCUMENTREF" {
        p.at = p.at + 1
        if not operator_is(p, ":") {
            fail(SpdxParseFailed())
        }
    }
    if p.at >= p.toks.len() {
        fail(SpdxParseFailed())
    }
    if p.toks[p.at].kind == "LICENSEREF" {
        p.at = p.at + 1
        return true
    }
    p.at = begin
    return false
}

fn parse_license(inout p: SpdxParser) -> bool ! SpdxParseError {
    if p.at < p.toks.len() and p.toks[p.at].kind == "LICENSE" {
        p.at = p.at + 1
        operator_is(p, "+")
        if operator_is(p, "WITH") {
            if p.at < p.toks.len() and p.toks[p.at].kind == "EXCEPTION" {
                p.at = p.at + 1
            } else {
                fail(SpdxParseFailed())
            }
        }
        return true
    }
    return false
}

/// `(expr)`; true only when the expression inside was something, though
/// the parentheses are consumed either way.
fn parse_paren(inout p: SpdxParser) -> bool ! SpdxParseError {
    if not operator_is(p, "(") {
        return false
    }
    let inner = try parse_binary(p, "OR")
    if not operator_is(p, ")") {
        fail(SpdxParseFailed())
    }
    return inner
}

fn parse_atom(inout p: SpdxParser) -> bool ! SpdxParseError {
    if try parse_paren(p) {
        return true
    }
    if try parse_license_ref(p) {
        return true
    }
    return try parse_license(p)
}

fn parse_binary(inout p: SpdxParser, op: str) -> bool ! SpdxParseError {
    let left = if op == "OR" { try parse_binary(p, "AND") } else { try parse_atom(p) }
    if not left {
        return false
    }
    if not operator_is(p, op) {
        return true
    }
    if not (try parse_binary(p, op)) {
        fail(SpdxParseFailed())
    }
    return true
}

/// Whether spdx-expression-parse accepts the text.
pub fn valid(t: SpdxTables, text: str) -> bool {
    let toks = match scan(t, text) {
        Ok(x) -> x
        Err(_e) -> return false
    }
    var p = SpdxParser{ toks: toks, at: 0 }
    return match parse_binary(p, "OR") {
        Ok(found) -> found and p.at >= p.toks.len()
        Err(_e) -> false
    }
}

// --- spdx-correct 3.2.0 -------------------------------------------------------

fn text_of(c: [i64]) -> str {
    return c.map(|x| x.to_char()).join("")
}

fn js_trim(s: str) -> str {
    let c = s.codes()
    var a = 0
    var b = c.len()
    while a < b and jsnumber.is_js_space(c[a]) {
        a = a + 1
    }
    while b > a and jsnumber.is_js_space(c[b - 1]) {
        b = b - 1
    }
    return text_of(c.slice(a, b))
}

fn is_digit(c: i64) -> bool {
    return c >= 48 and c <= 57
}

fn is_word(c: i64) -> bool {
    return c >= 65 and c <= 90 or c >= 97 and c <= 122 or is_digit(c) or c == 95
}

/// `s.replace(from, to)` with a string pattern: the first occurrence only.
fn replace_first(s: str, from: str, to: str) -> str {
    return match s.index_of(from) {
        Some(i) -> s.substr(0, i) + to + s.substr(i + from.len(), s.len())
        None -> s
    }
}

/// Replaces the span [a, b) of `c`.
fn splice(c: [i64], a: i64, b: i64, rep: str) -> str {
    return text_of(c.slice(0, a)) + rep + text_of(c.slice(b, c.len()))
}

fn skip_ws(c: [i64], at: i64) -> i64 {
    var i = at
    while i < c.len() and jsnumber.is_js_space(c[i]) {
        i = i + 1
    }
    return i
}

/// `/,?\s*(\d)/` -> the digit, given a template around it.
fn comma_digit(s: str, before: str, after: str) -> str {
    let c = s.codes()
    for p in 0..c.len() {
        let q = skip_ws(c, if c[p] == 44 { p + 1 } else { p })
        if q < c.len() and is_digit(c[q]) {
            return splice(c, p, q + 1, before + c[q].to_char() + after)
        }
    }
    return s
}

/// `/,?\s*(V\.|v\.|V|v|Version|version)\s*(\d)/`
fn version_digit(s: str, after: str) -> str {
    let c = s.codes()
    for p in 0..c.len() {
        let q = skip_ws(c, if c[p] == 44 { p + 1 } else { p })
        for alt in ["V.", "v.", "V", "v", "Version", "version"] {
            if starts_at(c, q, alt) {
                let r = skip_ws(c, q + alt.len())
                if r < c.len() and is_digit(c[r]) {
                    return splice(c, p, r + 1, "-" + c[r].to_char() + after)
                }
            }
        }
    }
    return s
}

/// `/\s*V\s*(\d)/`
fn big_v_digit(s: str) -> str {
    let c = s.codes()
    for p in 0..c.len() {
        let q = skip_ws(c, p)
        if q < c.len() and c[q] == 86 {
            let r = skip_ws(c, q + 1)
            if r < c.len() and is_digit(c[r]) {
                return splice(c, p, r + 1, "-" + c[r].to_char())
            }
        }
    }
    return s
}

/// `/(\d)$/`
fn last_digit(s: str, before: str, after: str) -> str {
    let c = s.codes()
    if c.len() > 0 and is_digit(c[c.len() - 1]) {
        return splice(c, c.len() - 1, c.len(), before + c[c.len() - 1].to_char() + after)
    }
    return s
}

/// `/(-| )?(\d)$/` -> `-$2-Clause`
fn clause_last(s: str) -> str {
    let c = s.codes()
    let n = c.len()
    if n >= 2 and (c[n - 2] == 45 or c[n - 2] == 32) and is_digit(c[n - 1]) {
        return splice(c, n - 2, n, "-" + c[n - 1].to_char() + "-Clause")
    }
    if n >= 1 and is_digit(c[n - 1]) {
        return splice(c, n - 1, n, "-" + c[n - 1].to_char() + "-Clause")
    }
    return s
}

/// `/(-| )clause(-| )(\d)/` -> `-$3-Clause`
fn clause_word(s: str) -> str {
    let c = s.codes()
    for p in 0..c.len() {
        if (c[p] == 45 or c[p] == 32) and starts_at(c, p + 1, "clause") and p + 8 < c.len() and (c[p + 7] == 45 or c[p + 7] == 32) and is_digit(c[p + 8]) {
            return splice(c, p, p + 9, "-" + c[p + 8].to_char() + "-Clause")
        }
    }
    return s
}

fn lower(c: i64) -> i64 {
    return if c >= 65 and c <= 90 { c + 32 } else { c }
}

/// An ASCII word, matched case-insensitively (`/i` without `u`).
fn ci_at(c: [i64], at: i64, w: str) -> bool {
    let x = w.codes()
    if at + x.len() > c.len() {
        return false
    }
    for i in 0..x.len() {
        if lower(c[at + i]) != lower(x[i]) {
            return false
        }
    }
    return true
}

/// `/\b(A|B)(-| )?BSD((-| )License)?/i` -> template, `$1` the word as written.
fn bsd(s: str, words: [str], template: str) -> str {
    let c = s.codes()
    for p in 0..c.len() {
        if p > 0 and is_word(c[p - 1]) {
            continue
        }
        for w in words {
            if not ci_at(c, p, w) {
                continue
            }
            let q = p + w.len()
            let tries = if q < c.len() and (c[q] == 45 or c[q] == 32) { [q + 1, q] } else { [q] }
            for q2 in tries {
                if ci_at(c, q2, "BSD") {
                    var r = q2 + 3
                    if r < c.len() and (c[r] == 45 or c[r] == 32) and ci_at(c, r + 1, "License") {
                        r = r + 8
                    }
                    return splice(c, p, r, template.replace("$1", text_of(c.slice(p, q))))
                }
            }
        }
    }
    return s
}

/// `/ ?International/` -> ''
fn drop_international(s: str) -> str {
    let c = s.codes()
    for p in 0..c.len() {
        if c[p] == 32 and starts_at(c, p + 1, "International") {
            return splice(c, p, p + 14, "")
        }
        if starts_at(c, p, "International") {
            return splice(c, p, p + 13, "")
        }
    }
    return s
}

/// `/ (\d)/` -> `-$1`
fn space_digit(s: str) -> str {
    let c = s.codes()
    for p in 0..c.len() {
        if c[p] == 32 and p + 1 < c.len() and is_digit(c[p + 1]) {
            return splice(c, p, p + 2, "-" + c[p + 1].to_char())
        }
    }
    return s
}

fn attribution(s: str) -> str {
    return drop_international(space_digit(replace_first(replace_first(replace_first(s, "Attribution", "BY"), "NonCommercial", "NC"), "NoDerivatives", "ND")))
}

fn strip_dots(s: str) -> str {
    return s.split(".").join("")
}

fn collapse_ws(s: str, rep: str) -> str {
    let c = s.codes()
    var out = ""
    var i = 0
    while i < c.len() {
        if jsnumber.is_js_space(c[i]) {
            i = skip_ws(c, i)
            out = out + rep
        } else {
            out = out + c[i].to_char()
            i = i + 1
        }
    }
    return out
}

/// The first character upper-cased, as `s[0].toUpperCase()` does: one
/// UTF-16 unit, so a character outside the BMP stays as it is.
fn capitalize(s: str) -> Option[str] {
    if s.len() == 0 {
        return None
    }
    let first = s.substr(0, 1)
    return Some((if first.code_at(0) > 65535 { first } else { first.to_upper() }) + s.substr(1, s.len()))
}

/// The k-th of the 27 rewrites; None where it throws.
fn transform(k: i64, a: str) -> Option[str] {
    let out = if k == 0 { a.to_upper() } else if k == 1 { js_trim(a) } else if k == 2 { strip_dots(a) } else if k == 3 { collapse_ws(a, "") }
    else if k == 4 { collapse_ws(a, "-") } else if k == 5 { replace_first(a, "v", "-") } else if k == 6 { comma_digit(a, "-", "") }
    else if k == 7 { comma_digit(a, "-", ".0") } else if k == 8 { version_digit(a, "") } else if k == 9 { version_digit(a, ".0") }
    else if k == 10 { return capitalize(a) } else if k == 11 { replace_first(a, "/", "-") } else if k == 12 { last_digit(big_v_digit(a), "", ".0") }
    else if k == 13 { a + if a.contains("3.0") { "-or-later" } else { "-only" } } else if k == 14 { a + "only" } else if k == 15 { last_digit(a, "-", ".0") }
    else if k == 16 { clause_last(a) } else if k == 17 { clause_word(a) } else if k == 18 { bsd(a, ["Modified", "New", "Revised"], "BSD-3-Clause") }
    else if k == 19 { bsd(a, ["Simplified"], "BSD-2-Clause") } else if k == 20 { bsd(a, ["Free", "Net"], "BSD-2-Clause-$1BSD") }
    else if k == 21 { bsd(a, ["Clear"], "BSD-3-Clause-Clear") } else if k == 22 { bsd(a, ["Old", "Original"], "BSD-4-Clause") } else if k == 23 { "CC-" + a }
    else if k == 24 { "CC-" + a + "-4.0" } else if k == 25 { attribution(a) } else { "CC-" + attribution(a) + "-4.0" }
    return Some(out)
}

fn valid_transformation(t: SpdxTables, id: str) -> Option[str] ! SpdxCorrectError {
    for k in 0..27 {
        let raw = transform(k, id) ?? fail(SpdxTypeError("Cannot read properties of undefined (reading 'toUpperCase')"))
        let out = js_trim(raw)
        if out != id and valid(t, out) {
            return Some(out)
        }
    }
    return None
}

fn valid_last_resort(t: SpdxTables, id: str) -> Option[str] {
    let up = id.to_upper()
    for (sub, ident) in t.last_resorts {
        if up.contains(sub) {
            return Some(ident)
        }
    }
    return None
}

/// Each misspelling found in the text, fixed once, then `check`ed: 0 is
/// "valid, or a valid rewrite", 1 is "a substring guess".
fn any_correction(t: SpdxTables, id: str, check: i64) -> Option[str] ! SpdxCorrectError {
    for (wrong, right) in t.transpositions {
        if id.contains(wrong) {
            let fixed = replace_first(id, wrong, right)
            let got = if check == 1 { valid_last_resort(t, fixed) } else if valid(t, fixed) { Some(fixed) } else { try valid_transformation(t, fixed) }
            if got != None {
                return got
            }
        }
    }
    return None
}

fn upgrade_gpls(v: str) -> str {
    if ["GPL-1.0", "LGPL-1.0", "AGPL-1.0", "GPL-2.0", "LGPL-2.0", "AGPL-2.0", "LGPL-2.1"].contains(v) {
        return v + "-only"
    }
    if ["GPL-1.0+", "GPL-2.0+", "GPL-3.0+", "LGPL-2.0+", "LGPL-2.1+", "LGPL-3.0+", "AGPL-1.0+", "AGPL-3.0+"].contains(v) {
        return v.substr(0, v.len() - 1) + "-or-later"
    }
    if ["GPL-3.0", "LGPL-3.0", "AGPL-3.0"].contains(v) {
        return v + "-or-later"
    }
    return v
}

fn finish(v: str, upgrade: bool) -> str {
    return if upgrade { upgrade_gpls(v) } else { v }
}

/// What spdx-correct makes of a license text: an expression that parses,
/// None when nothing fits, or the error it throws.
pub fn correct(t: SpdxTables, identifier: str, upgrade: bool) -> Option[str] ! SpdxCorrectError {
    let id = js_trim(identifier)
    if id.len() == 0 {
        fail(SpdxInvalidArgument())
    }
    if valid(t, id) {
        return Some(finish(id, upgrade))
    }
    let no_plus = js_trim(if id.ends_with("+") { id.substr(0, id.len() - 1) } else { id })
    if valid(t, no_plus) {
        return Some(finish(no_plus, upgrade))
    }
    var found = try valid_transformation(t, id)
    if found == None {
        found = try any_correction(t, id, 0)
    }
    if found == None {
        found = valid_last_resort(t, id)
    }
    if found == None {
        found = try any_correction(t, id, 1)
    }
    return match found {
        Some(v) -> Some(finish(v, upgrade))
        None -> None
    }
}
