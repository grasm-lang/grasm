        "zebra", "zero", "zone", "zoo",
    ]
}

/// Where a word sits in the list, or -1.
pub fn index_of(word: str) -> i64 {
    let words = wordlist()
    var low = 0
    var high = words.len() - 1
    while low <= high {
        let middle = (low + high) / 2
        if words[middle] < word {
            low = middle + 1
        } else if words[middle] > word {
            high = middle - 1
        } else {
            return middle
        }
    }
    return 0 - 1
}

/// The word at an index.
pub fn word_at(index: i64) -> str {
    return wordlist()[index]
}

fn bit_at(data: bytes, position: i64) -> i64 {
    return data.at(position / 8).ushr(7 - position % 8).bit_and(1)
}

/// Turn entropy into a phrase.
///
/// The entropy must be 128, 160, 192, 224 or 256 bits — sixteen to
/// thirty-two bytes in steps of four — because the checksum length and the
/// word count both fall out of it.
pub fn from_entropy(entropy: bytes) -> [str] ! MnemonicError {
    let bits = entropy.len() * 8
    if bits < 128 or bits > 256 or bits % 32 != 0 {
        fail(BadEntropyLength(bits))
    }
    let digest = crypto_hash.sha256_of(entropy)
    let checksum_bits = bits / 32
    var out: [str] = []
    var i = 0
    while i < (bits + checksum_bits) / 11 {
        var index = 0
        var j = 0
        while j < 11 {
            let position = i * 11 + j
            var bit = 0
            if position < bits {
                bit = bit_at(entropy, position)
            } else {
                bit = bit_at(digest, position - bits)
            }
            index = index * 2 + bit
            j = j + 1
        }
        out.push(word_at(index))
        i = i + 1
    }
    return out
}

/// The entropy a phrase carries, checking the checksum on the way.
pub fn to_entropy(words: [str]) -> bytes ! MnemonicError {
    if words.len() < 12 or words.len() > 24 or words.len() % 3 != 0 {
        fail(BadWordCount(words.len()))
    }
    let total_bits = words.len() * 11
    let checksum_bits = total_bits / 33
    let bits = total_bits - checksum_bits
    var flat: [i64] = []
    for word in words {
        let index = index_of(word)
        if index < 0 {
            fail(UnknownWord(word))
        }
        var j = 10
        while j >= 0 {
            flat.push(index.ushr(j).bit_and(1))
            j = j - 1
        }
    }
    var octets: [i64] = []
    var i = 0
    while i < bits {
        var byte = 0
        var j = 0
        while j < 8 {
            byte = byte * 2 + flat[i + j]
            j = j + 1
        }
        octets.push(byte)
        i = i + 8
    }
    let entropy = bytes_of(octets)
    let digest = crypto_hash.sha256_of(entropy)
    var k = 0
    while k < checksum_bits {
        if flat[bits + k] != bit_at(digest, k) {
            fail(BadChecksum())
        }
        k = k + 1
    }
    return entropy
}

/// Whether a phrase is well formed and its checksum holds.
pub fn is_valid(words: [str]) -> bool {
    match to_entropy(words) {
        Ok(_entropy) -> return true
        Err(_why) -> return false
    }
}

/// A phrase written as one line, which is how it is normally handled.
pub fn render(words: [str]) -> str {
    return words.join(" ")
}

/// The words of a written phrase.
pub fn split(phrase: str) -> [str] {
    var out: [str] = []
    for piece in phrase.split(" ") {
        if piece.len() > 0 {
            out.push(piece)
        }
    }
    return out
}

/// HMAC-SHA-512 with a counter appended, which is one block of PBKDF2.
fn pbkdf2_block(password: bytes, salt: bytes, iterations: i64,
    counter: i64) -> bytes {
    var seeded: [i64] = []
    var i = 0
    while i < salt.len() {
        seeded.push(salt.at(i))
        i = i + 1
    }
    seeded.push(counter.ushr(24).bit_and(255))
    seeded.push(counter.ushr(16).bit_and(255))
    seeded.push(counter.ushr(8).bit_and(255))
    seeded.push(counter.bit_and(255))
    var block = sha512.hmac_sha512(password, bytes_of(seeded))
    var out: [i64] = []
    var j = 0
    while j < block.len() {
        out.push(block.at(j))
        j = j + 1
    }
    var round = 1
    while round < iterations {
        block = sha512.hmac_sha512(password, block)
        var k = 0
        while k < block.len() {
            out[k] = out[k].bit_xor(block.at(k))
            k = k + 1
        }
        round = round + 1
    }
    return bytes_of(out)
}

/// The 64-byte seed a phrase and a passphrase derive to.
///
/// Both are normalised to NFKD first, which matters for the wordlists
/// whose words carry accents or are written in kana: two phrases that look
/// the same and are spelled differently must reach the same wallet.
pub fn to_seed(phrase: str, passphrase: str) -> bytes {
    let password = unicodenorm.nfkd(phrase).to_bytes()
    let salt = unicodenorm.nfkd("mnemonic" + passphrase).to_bytes()
    return pbkdf2_block(password, salt, 2048, 1)
}

/// The seed as hex, which is how every test vector is written.
pub fn seed_hex(phrase: str, passphrase: str) -> str {
    return sha512.hex(to_seed(phrase, passphrase))
}
