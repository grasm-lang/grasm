// The Grasm side of scripts/b30_diff.py. Each case is `<op> x<bytes>
// x<fields>`: the bytes are key, signature and message run together (the
// parameter set fixes the sizes), the fields `name|mode|ctx|extra`.
import mldsa
import slhdsa

fn from_hex(text: str) -> bytes {
    var out: [i64] = []
    var i = 1
    while i + 1 < text.len() {
        out.push(text.substr(i, 2).parse_int_base(16) ?? 0)
        i = i + 2
    }
    bytes_of(out)
}

fn unhex(text: str) -> bytes {
    from_hex(":" + text)
}

fn hex(raw: bytes) -> str {
    let digits = "0123456789abcdef"
    var out = ""
    var i = 0
    while i < raw.len() {
        out = out + digits.substr(raw.at(i) / 16, 1) + digits.substr(raw.at(i) % 16, 1)
        i = i + 1
    }
    out
}

fn flag(b: bool) -> str {
    if b { "true" } else { "false" }
}

fn answer_mldsa(what: str, a: bytes, f: [str]) -> str {
    let name = f[0]
    let (pk_size, sk_size, sig_size) = mldsa.sizes(name) ?? (0, 0, 0)
    if what == "mldsa.keygen" {
        return match mldsa.keygen(name, a) {
            Ok(k) -> hex(k.public) + "|" + hex(k.private)
            Err(_) -> "ERR"
        }
    }
    if what == "mldsa.sign" {
        let sk = a.slice(0, sk_size)
        let msg = a.slice(sk_size, a.len())
        let rnd = unhex(f[3])
        if f[1] == "internal" {
            return hex(mldsa.sign_internal(name, sk, msg, rnd) ?? bytes_of([]))
        }
        return hex(mldsa.sign(name, sk, msg, unhex(f[2]), rnd) ?? bytes_of([]))
    }
    let pk = a.slice(0, pk_size)
    let sig = a.slice(pk_size, pk_size + sig_size)
    let msg = a.slice(pk_size + sig_size, a.len())
    if f[1] == "internal" {
        return flag(mldsa.verify_internal(name, pk, msg, sig))
    }
    flag(mldsa.verify(name, pk, msg, unhex(f[2]), sig))
}

fn answer_slhdsa(what: str, a: bytes, f: [str]) -> str {
    let name = f[0]
    let p = match slhdsa.params(name) {
        Ok(x) -> x
        Err(_) -> return "ERR"
    }
    if what == "slhdsa.keygen" {
        return match slhdsa.keygen(name, a.slice(0, p.n), a.slice(p.n, 2 * p.n), a.slice(2 * p.n, 3 * p.n)) {
            Ok(k) -> hex(k.public) + "|" + hex(k.private)
            Err(_) -> "ERR"
        }
    }
    if what == "slhdsa.sign" {
        let sk = a.slice(0, 4 * p.n)
        let msg = a.slice(4 * p.n, a.len())
        let rnd = unhex(f[3])
        if f[1] == "internal" {
            return hex(slhdsa.sign_internal(name, sk, msg, rnd) ?? bytes_of([]))
        }
        if f[1] == "prehash" {
            return hex(slhdsa.sign_prehashed(name, sk, msg, unhex(f[2]), f[4], rnd) ?? bytes_of([]))
        }
        return hex(slhdsa.sign(name, sk, msg, unhex(f[2]), rnd) ?? bytes_of([]))
    }
    let size = slhdsa.signature_size(p)
    let pk = a.slice(0, 2 * p.n)
    let sig = a.slice(2 * p.n, 2 * p.n + size)
    let msg = a.slice(2 * p.n + size, a.len())
    if f[1] == "internal" {
        return flag(slhdsa.verify_internal(name, pk, msg, sig))
    }
    if f[1] == "prehash" {
        return flag(slhdsa.verify_prehashed(name, pk, msg, unhex(f[2]), f[4], sig))
    }
    flag(slhdsa.verify(name, pk, msg, unhex(f[2]), sig))
}

fn main() / {io} {
    let argv = args()
    var i = 0
    while i + 2 < argv.len() {
        let f = from_hex(argv[i + 2]).to_str().split("|")
        let a = from_hex(argv[i + 1])
        print(if argv[i].starts_with("mldsa") { answer_mldsa(argv[i], a, f) } else { answer_slhdsa(argv[i], a, f) })
        i = i + 3
    }
}
