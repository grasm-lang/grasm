// INI files, as `.gitconfig`, `.editorconfig` and desktop entries use them.
//
// There is no standard, so the choices here are stated rather than assumed:
// `;` and `#` both start a comment, keys outside any section live in `""`,
// a repeated key takes the last value, whitespace around `=` is trimmed but
// whitespace *inside* a value is kept, and a value may be quoted to protect
// its edges.

type IniFile = {
    /// Parallel: entry `i` is section[i].key[i] = value[i].
    section: [str],
    key: [str],
    value: [str],
}

pub fn parse(text: str) -> IniFile {
    var f = IniFile{ section: [], key: [], value: [] }
    var current = ""
    for raw in text.split("\n") {
        let line = raw.trim()
        if line.len() == 0 {
            continue
        }
        let first = line.substr(0, 1)
        if first == ";" or first == "#" {
            continue
        }
        if first == "[" {
            match line.index_of("]") {
                Some(at) -> current = line.substr(1, at - 1).trim()
                None -> {}
            }
            continue
        }
        match line.index_of("=") {
            None -> {}
            Some(at) -> {
                let k = line.substr(0, at).trim()
                var v = line.substr(at + 1, line.len() - at - 1).trim()
                if v.len() >= 2 and v.substr(0, 1) == "\"" and v.substr(v.len() - 1, 1) == "\"" {
                    v = v.substr(1, v.len() - 2)
                }
                set(f, current, k, v)
            }
        }
    }
    return f
}

fn find(f: IniFile, section: str, key: str) -> i64 {
    for i in 0..f.key.len() {
        if f.section[i] == section and f.key[i] == key {
            return i
        }
    }
    return 0 - 1
}

pub fn set(inout f: IniFile, section: str, key: str, value: str) {
    let at = find(f, section, key)
    if at >= 0 {
        f.value[at] = value
    } else {
        f.section.push(section)
        f.key.push(key)
        f.value.push(value)
    }
}

pub fn get(f: IniFile, section: str, key: str) -> Option[str] {
    let at = find(f, section, key)
    if at < 0 {
        return None
    }
    return Some(f.value[at])
}

pub fn get_int(f: IniFile, section: str, key: str) -> Option[i64] {
    match get(f, section, key) {
        None -> return None
        Some(v) -> return v.parse_int()
    }
}

/// `true`, `yes`, `on` and `1` are true; everything else is false.
pub fn get_bool(f: IniFile, section: str, key: str) -> bool {
    match get(f, section, key) {
        None -> return false
        Some(v) -> {
            let low = v.to_lower()
            return low == "true" or low == "yes" or low == "on" or low == "1"
        }
    }
}

pub fn sections(f: IniFile) -> [str] {
    var out: [str] = []
    for s in f.section {
        var seen = false
        for k in out {
            if k == s {
                seen = true
            }
        }
        if not seen {
            out.push(s)
        }
    }
    return out
}

pub fn keys_in(f: IniFile, section: str) -> [str] {
    var out: [str] = []
    for i in 0..f.key.len() {
        if f.section[i] == section {
            out.push(f.key[i])
        }
    }
    return out
}

pub fn render(f: IniFile) -> str {
    var out: [str] = []
    for s in sections(f) {
        if s != "" {
            out.push("[{s}]")
        }
        for i in 0..f.key.len() {
            if f.section[i] == s {
                out.push("{f.key[i]} = {f.value[i]}")
            }
        }
        out.push("")
    }
    return out.join("\n").trim() + "\n"
}
