// The Grasm side of scripts/pqc_diff.py: arguments in threes -- an
// operation, a variant name and a hex field with a leading `x` -- and one
// answer line each, in the form the driver builds from OpenSSL.
import mlkem

fn from_hex(text: str) -> bytes {
    var out: [i64] = []
    var i = 1
    while i + 1 < text.len() {
        out.push(text.substr(i, 2).parse_int_base(16) ?? 0)
        i = i + 2
    }
    bytes_of(out)
}

fn hex(raw: bytes) -> str {
    let digits = "0123456789abcdef"
    var out = ""
    var i = 0
    while i < raw.len() {
        out = out + digits.substr(raw.at(i) / 16, 1) + digits.substr(raw.at(i) % 16, 1)
        i = i + 1
    }
    out
}

fn decap_hex(variant: str, dk: bytes, c: bytes) -> str {
    match mlkem.decapsulate(variant, dk, c) {
        Ok(k) -> hex(k)
        Err(_) -> "ERR"
    }
}

/// Keys from `seed`, encapsulation with `m`, and decapsulation of the
/// result: `ek|shared|ciphertext|decapsulated`.
fn round_trip(variant: str, seed: bytes, m: bytes) -> str {
    match mlkem.keygen_from_seed(variant, seed) {
        Err(_) -> "ERR"
        Ok(keys) -> match mlkem.encapsulate_with(variant, keys.encapsulation, m) {
            Err(_) -> "ERR"
            Ok(e) -> hex(keys.encapsulation) + "|" + hex(e.shared) + "|" + hex(e.ciphertext) +
            "|" + decap_hex(variant, keys.decapsulation, e.ciphertext)
        }
    }
}

fn answer(what: str, variant: str, b: bytes) -> str {
    if what == "mlk" {
        return round_trip(variant, b.slice(0, 64), b.slice(64, b.len()))
    }
    if what == "mlkdec" {
        return match mlkem.keygen_from_seed(variant, b.slice(0, 64)) {
            Ok(keys) -> decap_hex(variant, keys.decapsulation, b.slice(64, b.len()))
            Err(_) -> "ERR"
        }
    }
    if what == "mlkenc" {
        let n = b.len() - 32
        return match mlkem.encapsulate_with(variant, b.slice(0, n), b.slice(n, b.len())) {
            Ok(e) -> hex(e.shared) + "|" + hex(e.ciphertext)
            Err(_) -> "ERR"
        }
    }
    "UNKNOWN {what}"
}

fn main() / {io} {
    let argv = args()
    var i = 0
    while i + 2 < argv.len() {
        print(answer(argv[i], argv[i + 1], from_hex(argv[i + 2])))
        i = i + 3
    }
}
