// `git status`, computed: what differs between HEAD, the index and the
// work tree, in git's porcelain v2 format.
//
// Three snapshots of the files: the commit HEAD points at (path, mode,
// blob id), the index (the same, with a stage: 0 normally, 1 to 3 for
// the base, ours and theirs of an unresolved merge), and the work tree
// (path, mode, the id its contents would have as a blob). Each tracked
// path gets two letters: the first compares the index with HEAD, the
// second the work tree with the index -- "." unchanged, M modified (a
// new blob or an executable bit), T type changed (file, link,
// submodule), A added, D deleted -- and an unresolved path gets one of
// git's seven conflict codes from which stages it has. Files in neither
// HEAD nor the index are untracked unless ignored. Editors, shell
// prompts and CI bots read this output; computing it without running
// git is what a library like this is for.
//
// `status` takes the snapshots and the ignore files (a .gitignore counts
// only while the work tree holds it as a regular file); `porcelain_v2`
// renders the lines in git's order: changed and unmerged paths sorted,
// then untracked ones.
//
// Checked against `git status --porcelain=v2 --untracked-files=all`
// (renames off) in git 2.48, on random repositories with edits, adds,
// deletes, mode and type changes, and merge conflicts.
import ignorewalk

type GsEntry = { path: str, mode: i64, id: str }

type GsIndexEntry = { path: str, mode: i64, id: str, stage: i64 }

type GsLine =
    | GsChanged(xy: str, head: GsEntry, index: GsEntry, work_mode: i64)
    | GsUnmerged(xy: str, stages: [GsEntry], work_mode: i64)
    | GsUntracked(path: str)

fn zero() -> str {
    return "0".repeat(40)
}

fn kind_of(mode: i64) -> i64 {
    return mode.ushr(12)
}

/// One side of a comparison: "." when the same, T when the type changed,
/// M when the content or the executable bit did.
fn compare(a: GsEntry, b: GsEntry) -> str {
    if kind_of(a.mode) != kind_of(b.mode) {
        return "T"
    }
    if a.id != b.id or a.mode != b.mode {
        return "M"
    }
    return "."
}

fn conflict_code(has1: bool, has2: bool, has3: bool) -> str {
    if has1 and not has2 and not has3 {
        return "DD"
    }
    if not has1 and has2 and not has3 {
        return "AU"
    }
    if has1 and not has2 and has3 {
        return "UD"
    }
    if not has1 and not has2 and has3 {
        return "UA"
    }
    if has1 and has2 and not has3 {
        return "DU"
    }
    if not has1 and has2 and has3 {
        return "AA"
    }
    return "UU"
}

/// The status lines, given the three snapshots, the .gitignore files
/// (path and contents), info/exclude and the global excludes file.
pub fn status(head: [GsEntry], index: [GsIndexEntry], work: [GsEntry], gitignores: [(str, str)], info_exclude: str, global: str) -> [GsLine] {
    let none = GsEntry{ path: "", mode: 0, id: zero() }
    var heads: Map[str, GsEntry] = {}
    for h in head {
        heads.set(h.path, h)
    }
    var works: Map[str, GsEntry] = {}
    for w in work {
        works.set(w.path, w)
    }
    // Per path: the stage-0 entry and stages 1 to 3, in index order.
    var order: [str] = []
    var stages: Map[str, [GsEntry]] = {}
    for e in index {
        var st = stages.get(e.path) ?? {
            order.push(e.path)
            [none, none, none, none]
        }
        st[e.stage] = GsEntry{ path: e.path, mode: e.mode, id: e.id }
        stages.set(e.path, st)
    }
    var out: [GsLine] = []
    for p in order {
        let st = stages.get(p) ?? [none, none, none, none]
        let w = works.get(p)
        let wmode = match w {
            Some(x) -> x.mode
            None -> 0
        }
        if st[1].mode != 0 or st[2].mode != 0 or st[3].mode != 0 {
            out.push(GsUnmerged(conflict_code(st[1].mode != 0, st[2].mode != 0, st[3].mode != 0), [st[1], st[2], st[3]], wmode))
            continue
        }
        let i = st[0]
        let h = heads.get(p)
        let x = match h {
            Some(he) -> compare(he, i)
            None -> "A"
        }
        let y = match w {
            Some(we) -> compare(i, we)
            None -> "D"
        }
        if x != "." or y != "." {
            out.push(GsChanged(x + y, h ?? none, i, wmode))
        }
    }
    for h in head {
        if stages.get(h.path).is_none() {
            out.push(GsChanged("D.", h, none, 0))
        }
    }
    var listing: [(str, bool)] = []
    for w in work {
        if stages.get(w.path).is_none() {
            listing.push((w.path, false))
        }
    }
    // Git reads ignore files from the work tree, and since 2.32 refuses one
    // that is a symbolic link ("unable to access ... Too many levels of
    // symbolic links"). A .gitignore that was deleted, or replaced by a
    // link, contributes no rules, whatever it held at HEAD.
    let readable = gitignores.filter(|g| match works.get(g.0) {
        Some(we) -> kind_of(we.mode) == 8
        None -> false
    })
    for (p, ign) in ignorewalk.walk(listing, readable, info_exclude, global) {
        if not ign {
            out.push(GsUntracked(p))
        }
    }
    return out
}

fn octal6(m: i64) -> str {
    var parts: [str] = []
    var x = m
    for _k in 0..6 {
        parts.push("{x % 8}")
        x = x / 8
    }
    var out: [str] = []
    var k = 5
    while k >= 0 {
        out.push(parts[k])
        k = k - 1
    }
    return out.join("")
}

fn line_path(l: GsLine) -> str {
    return match l {
        GsChanged(_xy, h, i, _w) -> if i.path.len() > 0 { i.path } else { h.path }
        GsUnmerged(_xy, s, _w) -> match s.filter(|e| e.path.len() > 0).first() {
            Some(e) -> e.path
            None -> ""
        }
        GsUntracked(p) -> p
    }
}

/// The lines as `git status --porcelain=v2` prints them: tracked changes
/// and conflicts in path order, then untracked files in path order.
pub fn porcelain_v2(lines: [GsLine]) -> [str] {
    var tracked = lines.filter(|l| match l {
        GsUntracked(_p) -> false
        _ -> true
    })
    tracked.sort_by(|l| line_path(l))
    var untracked = lines.filter(|l| match l {
        GsUntracked(_p) -> true
        _ -> false
    })
    untracked.sort_by(|l| line_path(l))
    var out: [str] = []
    for l in tracked + untracked {
        out.push(match l {
            GsChanged(xy, h, i, w) -> "1 " + xy + " N... " + octal6(h.mode) + " " + octal6(i.mode) + " " + octal6(w) + " " + h.id + " " + i.id + " " +
            line_path(l)
            GsUnmerged(xy, s, w) -> "u " + xy + " N... " + octal6(s[0].mode) + " " + octal6(s[1].mode) + " " + octal6(s[2].mode) + " " + octal6(w) +
            " " + s[0].id + " " + s[1].id + " " + s[2].id + " " + line_path(l)
            GsUntracked(p) -> "? " + p
        })
    }
    return out
}
