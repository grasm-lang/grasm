fn field_of(hex: str) -> ModField {
    match modarith.field(from_hex(hex)) {
        Ok(f) -> f
        Err(_) -> panic("a curve parameter is not an odd modulus")
    }
}

fn make_curve(row: str) -> EcCurve {
    let p = row.split("|")
    let f = field_of(p[1])
    let n = field_of(p[6])
    let a = modarith.enter(f, modarith.limbs_of(from_hex(p[2]), f.limbs))
    let b = modarith.enter(f, modarith.limbs_of(from_hex(p[3]), f.limbs))
    EcCurve{ name: p[0], f: f, n: n, a: a, b: b, b3: modarith.add(f, modarith.add(f, b, b), b),
        gx: modarith.enter(f, modarith.limbs_of(from_hex(p[4]), f.limbs)),
        gy: modarith.enter(f, modarith.limbs_of(from_hex(p[5]), f.limbs)) }
}

fn load_curves() -> [EcCurve] {
    var out: [EcCurve] = []
    for row in EC_PARAMS_PACKED.split(";") {
        out.push(make_curve(row))
    }
    out
}

let EC_CURVES = load_curves()

/// The curves by name: `P-256`, `P-384`, `P-521`, `secp256k1`,
/// `brainpoolP256r1`, `brainpoolP384r1`, `brainpoolP512r1`, `SM2`.
pub fn curve(name: str) -> EcCurve ! EcError {
    for c in EC_CURVES {
        if c.name == name {
            return c
        }
    }
    fail(UnknownCurve(name))
}

pub fn names() -> [str] {
    var out: [str] = []
    for c in EC_CURVES {
        out.push(c.name)
    }
    out
}

/// Bytes in a field element, and so in each coordinate of an encoded point.
pub fn field_size(c: EcCurve) -> i64 {
    c.f.size
}

/// Bytes in a scalar, and so in each half of a raw signature.
pub fn scalar_size(c: EcCurve) -> i64 {
    c.n.size
}

/// The order of the base point, `scalar_size` big-endian bytes.
pub fn order(c: EcCurve) -> bytes {
    modarith.bytes_of_limbs(c.n.m, c.n.size)
}

pub fn order_bits(c: EcCurve) -> i64 {
    c.n.bits
}

// ---------------------------------------------------------------------------
// Points

pub fn infinity(c: EcCurve) -> EcPoint {
    EcPoint{ x: modarith.zeros(c.f.limbs), y: c.f.one, z: modarith.zeros(c.f.limbs) }
}

pub fn generator(c: EcCurve) -> EcPoint {
    EcPoint{ x: c.gx, y: c.gy, z: c.f.one }
}

pub fn is_infinity(p: EcPoint) -> bool {
    modarith.is_zero(p.z)
}

/// `P + Q`, complete: right for doubling, for infinity, for `P + (-P)`,
/// with no case taken differently from another.
pub fn add(c: EcCurve, p: EcPoint, q: EcPoint) -> EcPoint {
    let f = c.f
    var t0 = modarith.mul(f, p.x, q.x)
    var t1 = modarith.mul(f, p.y, q.y)
    var t2 = modarith.mul(f, p.z, q.z)
    var t3 = modarith.mul(f, modarith.add(f, p.x, p.y), modarith.add(f, q.x, q.y))
    var t4 = modarith.add(f, t0, t1)
    t3 = modarith.sub(f, t3, t4)
    t4 = modarith.mul(f, modarith.add(f, p.x, p.z), modarith.add(f, q.x, q.z))
    var t5 = modarith.add(f, t0, t2)
    t4 = modarith.sub(f, t4, t5)
    t5 = modarith.mul(f, modarith.add(f, p.y, p.z), modarith.add(f, q.y, q.z))
    var x3 = modarith.add(f, t1, t2)
    t5 = modarith.sub(f, t5, x3)
    var z3 = modarith.mul(f, c.a, t4)
    x3 = modarith.mul(f, c.b3, t2)
    z3 = modarith.add(f, x3, z3)
    x3 = modarith.sub(f, t1, z3)
    z3 = modarith.add(f, t1, z3)
    var y3 = modarith.mul(f, x3, z3)
    t1 = modarith.add(f, modarith.add(f, t0, t0), t0)
    t2 = modarith.mul(f, c.a, t2)
    t4 = modarith.mul(f, c.b3, t4)
    t1 = modarith.add(f, t1, t2)
    t2 = modarith.mul(f, c.a, modarith.sub(f, t0, t2))
    t4 = modarith.add(f, t4, t2)
    t0 = modarith.mul(f, t1, t4)
    y3 = modarith.add(f, y3, t0)
    t0 = modarith.mul(f, t5, t4)
    x3 = modarith.sub(f, modarith.mul(f, t3, x3), t0)
    t0 = modarith.mul(f, t3, t1)
    z3 = modarith.add(f, modarith.mul(f, t5, z3), t0)
    EcPoint{ x: x3, y: y3, z: z3 }
}

pub fn negate(c: EcCurve, p: EcPoint) -> EcPoint {
    EcPoint{ x: p.x, y: modarith.neg(c.f, p.y), z: p.z }
}

fn swap_points(mask: i64, p: EcPoint, q: EcPoint) -> (EcPoint, EcPoint) {
    (EcPoint{ x: modarith.select(mask, q.x, p.x), y: modarith.select(mask, q.y, p.y), z: modarith.select(mask, q.z, p.z) },
        EcPoint{ x: modarith.select(mask, p.x, q.x), y: modarith.select(mask, p.y, q.y), z: modarith.select(mask, p.z, q.z) })
}

/// `k * P` for a big-endian scalar `k`, by a Montgomery ladder as long as
/// the order -- the same number of additions whatever `k` is. `k` is
/// reduced by nothing: a scalar of `n` or more is multiplied as it is.
pub fn mul(c: EcCurve, p: EcPoint, k: bytes) -> EcPoint {
    let bits = if modarith.bit_length(k) > c.n.bits { k.len() * 8 } else { c.n.bits }
    let kl = modarith.limbs_of(k, (bits + 25) / 26 + 1)
    var r0 = infinity(c)
    var r1 = p
    var i = bits - 1
    while i >= 0 {
        let bit = kl[i / 26].ushr(i % 26).bit_and(1)
        let swapped = swap_points(0 - bit, r0, r1)
        let sum = add(c, swapped.0, swapped.1)
        let twice = add(c, swapped.0, swapped.0)
        let back = swap_points(0 - bit, twice, sum)
        r0 = back.0
        r1 = back.1
        i = i - 1
    }
    r0
}

pub fn base_mul(c: EcCurve, k: bytes) -> EcPoint {
    mul(c, generator(c), k)
}

/// The affine coordinates, still in Montgomery form; `None` at infinity.
fn affine(c: EcCurve, p: EcPoint) -> Option[([i64], [i64])] {
    if modarith.is_zero(p.z) {
        return None
    }
    let zinv = modarith.inverse_prime(c.f, p.z)
    Some((modarith.mul(c.f, p.x, zinv), modarith.mul(c.f, p.y, zinv)))
}

/// The affine x coordinate as `field_size` big-endian bytes -- what ECDH
/// agrees on and what ECDSA's `r` is made from.
pub fn affine_x(c: EcCurve, p: EcPoint) -> Option[bytes] {
    match affine(c, p) {
        Some(xy) -> Some(modarith.to_bytes(c.f, xy.0))
        None -> None
    }
}

fn on_curve_mont(c: EcCurve, x: [i64], y: [i64]) -> bool {
    let f = c.f
    let rhs = modarith.add(f, modarith.mul(f, modarith.add(f, modarith.sqr(f, x), c.a), x), c.b)
    modarith.equal(modarith.sqr(f, y), rhs)
}

/// SEC 1 encoding: `04 || X || Y`, or `02`/`03 || X` compressed.
pub fn encode(c: EcCurve, p: EcPoint, compressed: bool) -> bytes ! EcError {
    match affine(c, p) {
        None -> fail(AtInfinity)
        Some(xy) -> {
            let x = modarith.to_bytes(c.f, xy.0)
            let y = modarith.to_bytes(c.f, xy.1)
            if compressed {
                let tag = 2 + y.at(y.len() - 1).bit_and(1)
                return bytes_of([tag]).concat(x)
            }
            bytes_of([4]).concat(x).concat(y)
        }
    }
}

/// `a < m`, both limbs.
fn below(a: [i64], m: [i64]) -> bool {
    modarith.sub_borrow(a, m).1 == 1
}

/// A SEC 1 point, checked: the coordinates in range and the point on the
/// curve. A compressed point needs a square root, which is taken as
/// `a^((p+1)/4)` -- every prime here is 3 mod 4.
pub fn decode(c: EcCurve, b: bytes) -> EcPoint ! EcError {
    let size = c.f.size
    if b.len() == 0 {
        fail(BadEncoding)
    }
    let tag = b.at(0)
    if tag == 4 and b.len() == 1 + 2 * size {
        let xl = modarith.limbs_of(b.slice(1, 1 + size), c.f.limbs)
        let yl = modarith.limbs_of(b.slice(1 + size, b.len()), c.f.limbs)
        if not below(xl, c.f.m) or not below(yl, c.f.m) {
            fail(BadEncoding)
        }
        let x = modarith.enter(c.f, xl)
        let y = modarith.enter(c.f, yl)
        if not on_curve_mont(c, x, y) {
            fail(NotOnCurve)
        }
        return EcPoint{ x: x, y: y, z: c.f.one }
    }
    if (tag == 2 or tag == 3) and b.len() == 1 + size {
        let xl = modarith.limbs_of(b.slice(1, b.len()), c.f.limbs)
        if not below(xl, c.f.m) {
            fail(BadEncoding)
        }
        let f = c.f
        let x = modarith.enter(f, xl)
        let rhs = modarith.add(f, modarith.mul(f, modarith.add(f, modarith.sqr(f, x), c.a), x), c.b)
        // (p + 1) / 4: p + 1 then two halvings, done on bytes.
        let e = shift_right2(modarith.add_carry(f.m, modarith.limbs_of(bytes_of([1]), f.limbs)).0)
        var y = modarith.pow(f, rhs, modarith.bytes_of_limbs(e, f.size + 1))
        if not modarith.equal(modarith.sqr(f, y), rhs) {
            fail(NotOnCurve)
        }
        let yb = modarith.to_bytes(f, y)
        let parity = yb.at(yb.len() - 1).bit_and(1)
        if parity != tag - 2 {
            y = modarith.neg(f, y)
        }
        return EcPoint{ x: x, y: y, z: f.one }
    }
    fail(BadEncoding)
}

fn shift_right2(a: [i64]) -> [i64] {
    var out = a
    for i in 0..a.len() {
        let high = if i + 1 < a.len() { a[i + 1].bit_and(3) } else { 0 }
        out[i] = a[i].ushr(2).bit_or(high.shl(24))
    }
    out
}

// ---------------------------------------------------------------------------
// Scalars, modulo the order

/// A big-endian value of any length, reduced modulo the order.
pub fn scalar_reduce(c: EcCurve, b: bytes) -> bytes {
    modarith.to_bytes(c.n, modarith.from_bytes(c.n, b))
}

/// Whether `k` is a usable private scalar: `1 <= k < n`.
pub fn scalar_valid(c: EcCurve, k: bytes) -> bool {
    if modarith.bit_length(k) > c.n.bits {
        return false
    }
    let kl = modarith.limbs_of(k, c.n.limbs)
    not modarith.is_zero(kl) and below(kl, c.n.m)
}

fn scalar_in(c: EcCurve, a: bytes) -> [i64] {
    modarith.enter(c.n, modarith.limbs_of(a, c.n.limbs))
}

fn scalar_out(c: EcCurve, a: [i64]) -> bytes {
    modarith.to_bytes(c.n, a)
}

/// `a * b mod n`; both already below `n`.
pub fn scalar_mul(c: EcCurve, a: bytes, b: bytes) -> bytes {
    scalar_out(c, modarith.mul(c.n, scalar_in(c, a), scalar_in(c, b)))
}

pub fn scalar_add(c: EcCurve, a: bytes, b: bytes) -> bytes {
    scalar_out(c, modarith.add(c.n, scalar_in(c, a), scalar_in(c, b)))
}

/// `a^-1 mod n`, by Fermat, as for the field.
pub fn scalar_inverse(c: EcCurve, a: bytes) -> bytes {
    scalar_out(c, modarith.inverse_prime(c.n, scalar_in(c, a)))
}

pub fn scalar_is_zero(a: bytes) -> bool {
    var acc = 0
    for i in 0..a.len() {
        acc = acc.bit_or(a.at(i))
    }
    acc == 0
}
