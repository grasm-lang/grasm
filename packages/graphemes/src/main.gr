fn class_other() -> i64 { return 0 }
fn class_cr() -> i64 { return 1 }
fn class_lf() -> i64 { return 2 }
fn class_control() -> i64 { return 3 }
fn class_extend() -> i64 { return 4 }
fn class_zwj() -> i64 { return 5 }
fn class_regional() -> i64 { return 6 }
fn class_prepend() -> i64 { return 7 }
fn class_spacing() -> i64 { return 8 }
fn class_l() -> i64 { return 9 }
fn class_v() -> i64 { return 10 }
fn class_t() -> i64 { return 11 }
fn class_lv() -> i64 { return 12 }
fn class_lvt() -> i64 { return 13 }

fn in_pairs(runs: [i64], code: i64) -> bool {
    var low = 0
    var high = runs.len() / 2 - 1
    while low <= high {
        let middle = (low + high) / 2
        if code < runs[middle * 2] {
            high = middle - 1
        } else if code > runs[middle * 2 + 1] {
            low = middle + 1
        } else {
            return true
        }
    }
    return false
}

/// The Grapheme_Cluster_Break class of a code point.
pub fn class_of(code: i64) -> i64 {
    // Hangul syllables: the block is laid out as 19 * 21 * 28, and a
    // syllable with no trailing consonant is LV.
    if code >= 44032 and code <= 55203 {
        if (code - 44032) % 28 == 0 {
            return class_lv()
        }
        return class_lvt()
    }
    var low = 0
    var high = GCB_RUNS.len() / 3 - 1
    while low <= high {
        let middle = (low + high) / 2
        if code < GCB_RUNS[middle * 3] {
            high = middle - 1
        } else if code > GCB_RUNS[middle * 3 + 1] {
            low = middle + 1
        } else {
            return GCB_RUNS[middle * 3 + 2]
        }
    }
    return class_other()
}

/// Whether a code point is Extended_Pictographic, which rule GB11 needs.
pub fn is_pictographic(code: i64) -> bool {
    return in_pairs(PICTOGRAPHIC_RUNS, code)
}

fn is_linker(code: i64) -> bool {
    return in_pairs(LINKER_RUNS, code)
}

fn is_consonant(code: i64) -> bool {
    return in_pairs(CONSONANT_RUNS, code)
}

fn is_incb_extend(code: i64) -> bool {
    return in_pairs(INCB_EXTEND_RUNS, code)
}

/// The state a break decision needs beyond the two code points either side
/// of it.
///
/// Three separate memories, because three rules look further back than one
/// character: how many regional indicators are in the run, whether a
/// pictograph reached the joiner we are standing on, and whether an Indic
/// consonant chain with a linker in it is still open.
type ClusterState = {
    regionals: i64,
    /// A pictograph followed by any number of Extend, ending here.
    pictographic_chain: bool,
    /// A pictograph chain followed by the joiner we just passed.
    joined: bool,
    /// A consonant followed by Extend and Linker, ending here.
    consonant_chain: bool,
    /// Whether that chain has a linker in it yet.
    linked: bool,
}

/// The state before anything has been read.
pub fn start_state() -> ClusterState {
    return ClusterState{ regionals: 0, pictographic_chain: false,
        joined: false, consonant_chain: false, linked: false }
}

/// The state after reading one more code point.
pub fn advance(state: ClusterState, code: i64) -> ClusterState {
    let kind = class_of(code)
    var regionals = 0
    if kind == class_regional() {
        regionals = state.regionals + 1
    }
    let chain = is_pictographic(code) or
    (state.pictographic_chain and kind == class_extend())
    let joined = state.pictographic_chain and kind == class_zwj()
    var consonant_chain = false
    var linked = false
    if is_consonant(code) {
        consonant_chain = true
    } else if state.consonant_chain and is_linker(code) {
        consonant_chain = true
        linked = true
    } else if state.consonant_chain and is_incb_extend(code) {
        consonant_chain = true
        linked = state.linked
    }
    return ClusterState{ regionals: regionals,
        pictographic_chain: chain, joined: joined,
        consonant_chain: consonant_chain, linked: linked }
}

/// Whether a cluster boundary falls between `before` and `code`, given the
/// state after reading everything up to and including `before`.
pub fn breaks_between(state: ClusterState, before: i64,
    code: i64) -> bool {
    let left = class_of(before)
    let right = class_of(code)
    // GB3, GB4, GB5: a line ending is one cluster and nothing joins it.
    if left == class_cr() and right == class_lf() {
        return false
    }
    if left == class_control() or left == class_cr() or left == class_lf() {
        return true
    }
    if right == class_control() or right == class_cr() or
    right == class_lf() {
        return true
    }
    // GB6, GB7, GB8: Hangul syllables assemble in a fixed order.
    if left == class_l() and (right == class_l() or right == class_v() or
        right == class_lv() or right == class_lvt()) {
        return false
    }
    if (left == class_lv() or left == class_v()) and
    (right == class_v() or right == class_t()) {
        return false
    }
    if (left == class_lvt() or left == class_t()) and
    right == class_t() {
        return false
    }
    // GB9, GB9a, GB9b: marks stay with what they mark.
    if right == class_extend() or right == class_zwj() {
        return false
    }
    if right == class_spacing() {
        return false
    }
    if left == class_prepend() {
        return false
    }
    // GB9c: a consonant chain held together by a linker.
    if state.consonant_chain and state.linked and is_consonant(code) {
        return false
    }
    // GB11: a pictograph, a joiner, and another pictograph.
    if state.joined and is_pictographic(code) {
        return false
    }
    // GB12 and GB13: regional indicators pair off, so the break depends on
    // how many came before rather than on these two alone.
    if left == class_regional() and right == class_regional() and
    state.regionals % 2 == 1 {
        return false
    }
    return true
}

/// The code point offsets a string's clusters begin at, including 0 and
/// the length.
pub fn boundaries(text: str) -> [i64] {
    let codes = code_points(text)
    var out = [0]
    if codes.len() == 0 {
        return out
    }
    var state = advance(start_state(), codes[0])
    var i = 1
    while i < codes.len() {
        if breaks_between(state, codes[i - 1], codes[i]) {
            out.push(i)
        }
        state = advance(state, codes[i])
        i = i + 1
    }
    out.push(codes.len())
    return out
}

fn code_points(text: str) -> [i64] {
    var out: [i64] = []
    for character in text.chars() {
        out.push(character.code_at(0))
    }
    return out
}

/// A string cut into clusters.
pub fn clusters(text: str) -> [str] {
    let characters = text.chars()
    let marks = boundaries(text)
    var out: [str] = []
    var i = 0
    while i + 1 < marks.len() {
        var piece = ""
        var j = marks[i]
        while j < marks[i + 1] {
            piece = piece + characters[j]
            j = j + 1
        }
        out.push(piece)
        i = i + 1
    }
    return out
}

/// How many clusters a string has: the number a reader would call its
/// length.
pub fn count(text: str) -> i64 {
    return boundaries(text).len() - 1
}
