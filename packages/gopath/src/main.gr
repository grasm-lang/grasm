// Go's slash-separated paths, as Go 1.25 computes them: `path.Clean`,
// `Join`, `Split`, `Base`, `Dir`, `Ext`, `IsAbs` and `Match`, and on Unix
// `filepath.Rel` and `filepath.SplitList`.
//
// Go tools name files, module paths and URL paths with these, and a tool
// that must produce the same keys or accept the same patterns needs Go's
// exact rules:
//
//   - `Clean` is lexical: one slash between elements, no `.`, a `..`
//     removing what it can, `..` at the root dropped; the empty path is
//     `.`.
//   - `Base` of "" is "."; of "/" is "/"; `Dir` is `Clean` of everything
//     up to the last slash; `Ext` is from the last dot of the last
//     element.
//   - `Match`'s `*` and `?` never cross a slash; `[^a-z]` negates; `\`
//     escapes; a malformed pattern is "syntax error in pattern" -- even
//     when the name has already failed to match, because Go checks the
//     rest of the pattern before saying no.
//   - `Rel` works lexically too and refuses ("Rel: can't make b relative
//     to a") when one path is rooted and the other is not, or when it
//     would need to climb out of a `..`.

type GoPathError = | GoPathBadPattern | GoPathRel(msg: str)

pub fn error_text(e: GoPathError) -> str {
    return match e {
        GoPathBadPattern -> "syntax error in pattern"
        GoPathRel(m) -> m
    }
}

fn bs(s: str) -> [i64] {
    return s.to_bytes().to_list()
}

fn text(b: [i64]) -> str {
    return bytes_of(b).to_str()
}

fn clean_bytes(path: [i64]) -> [i64] {
    let n = path.len()
    if n == 0 {
        return [46]
    }
    let rooted = path[0] == 47
    var out: [i64] = []
    var r = 0
    var dotdot = 0
    if rooted {
        out.push(47)
        r = 1
        dotdot = 1
    }
    while r < n {
        if path[r] == 47 {
            r = r + 1
        } else if path[r] == 46 and (r + 1 == n or path[r + 1] == 47) {
            r = r + 1
        } else if path[r] == 46 and path[r + 1] == 46 and (r + 2 == n or path[r + 2] == 47) {
            r = r + 2
            if out.len() > dotdot {
                var w = out.len() - 1
                while w > dotdot and out[w] != 47 {
                    w = w - 1
                }
                out = out.slice(0, w)
            } else if not rooted {
                if out.len() > 0 {
                    out.push(47)
                }
                out.push(46)
                out.push(46)
                dotdot = out.len()
            }
        } else {
            if (rooted and out.len() != 1) or (not rooted and out.len() != 0) {
                out.push(47)
            }
            while r < n and path[r] != 47 {
                out.push(path[r])
                r = r + 1
            }
        }
    }
    return if out.len() == 0 { [46] } else { out }
}

/// `path.Clean(p)`.
pub fn clean(p: str) -> str {
    return text(clean_bytes(bs(p)))
}

/// `path.Join(elem...)`: empty elements skipped, "" if all are.
pub fn join(elems: [str]) -> str {
    let kept = elems.filter(|e| e.len() > 0)
    if kept.len() == 0 {
        return ""
    }
    return clean(kept.join("/"))
}

/// `filepath.Join(elem...)` on Unix.
pub fn filepath_join(elems: [str]) -> str {
    var i = 0
    while i < elems.len() and elems[i].len() == 0 {
        i = i + 1
    }
    if i == elems.len() {
        return ""
    }
    return clean(elems.slice(i, elems.len()).join("/"))
}

fn last_slash(b: [i64]) -> i64 {
    var i = b.len() - 1
    while i >= 0 and b[i] != 47 {
        i = i - 1
    }
    return i
}

/// `path.Split(p)`: everything up to and including the last slash, and
/// the rest.
pub fn split(p: str) -> (str, str) {
    let b = bs(p)
    let i = last_slash(b)
    return (text(b.slice(0, i + 1)), text(b.slice(i + 1, b.len())))
}

/// `path.Ext(p)`.
pub fn ext(p: str) -> str {
    let b = bs(p)
    var i = b.len() - 1
    while i >= 0 and b[i] != 47 {
        if b[i] == 46 {
            return text(b.slice(i, b.len()))
        }
        i = i - 1
    }
    return ""
}

/// `path.Base(p)`.
pub fn base(p: str) -> str {
    var b = bs(p)
    if b.len() == 0 {
        return "."
    }
    while b.len() > 0 and b[b.len() - 1] == 47 {
        b = b.slice(0, b.len() - 1)
    }
    let i = last_slash(b)
    if i >= 0 {
        b = b.slice(i + 1, b.len())
    }
    return if b.len() == 0 { "/" } else { text(b) }
}

/// `path.IsAbs(p)`.
pub fn is_abs(p: str) -> bool {
    return p.starts_with("/")
}

/// `path.Dir(p)`.
pub fn dir(p: str) -> str {
    let b = bs(p)
    return text(clean_bytes(b.slice(0, last_slash(b) + 1)))
}

// ---- Match

/// scanChunk: whether stars lead, the chunk up to the next star outside
/// a class, and the rest.
fn scan_chunk(p: [i64]) -> (bool, [i64], [i64]) {
    var i = 0
    var star = false
    while i < p.len() and p[i] == 42 {
        i = i + 1
        star = true
    }
    let pat = p.slice(i, p.len())
    var inrange = false
    var j = 0
    while j < pat.len() {
        let c = pat[j]
        if c == 92 {
            if j + 1 < pat.len() {
                j = j + 1
            }
        } else if c == 91 {
            inrange = true
        } else if c == 93 {
            inrange = false
        } else if c == 42 and not inrange {
            break
        }
        j = j + 1
    }
    return (star, pat.slice(0, j), pat.slice(j, pat.len()))
}

/// utf8.DecodeRune: the rune and its width; invalid is U+FFFD, width 1.
fn decode_rune(b: [i64], i: i64) -> (i64, i64) {
    if i >= b.len() {
        return (65533, 0)
    }
    let c = b[i]
    if c < 128 {
        return (c, 1)
    }
    let n = if c >= 194 and c <= 223 { 2 } else if c >= 224 and c <= 239 { 3 } else if c >= 240 and c <= 244 { 4 } else { 0 }
    if n == 0 or i + n > b.len() {
        return (65533, 1)
    }
    let lo = if c == 224 { 160 } else if c == 240 { 144 } else { 128 }
    let hi = if c == 237 { 159 } else if c == 244 { 143 } else { 191 }
    if b[i + 1] < lo or b[i + 1] > hi {
        return (65533, 1)
    }
    var v = c.bit_and(if n == 2 { 31 } else if n == 3 { 15 } else { 7 })
    for k in 1..n {
        if b[i + k] < 128 or b[i + k] > 191 {
            return (65533, 1)
        }
        v = v.shl(6).bit_or(b[i + k].bit_and(63))
    }
    return (v, n)
}

/// getEsc: one character of a class, escaped or not, and the rest.
fn get_esc(chunk0: [i64]) -> (i64, [i64]) ! GoPathError {
    var chunk = chunk0
    if chunk.len() == 0 or chunk[0] == 45 or chunk[0] == 93 {
        fail(GoPathBadPattern)
    }
    if chunk[0] == 92 {
        chunk = chunk.slice(1, chunk.len())
        if chunk.len() == 0 {
            fail(GoPathBadPattern)
        }
    }
    let (r, n) = decode_rune(chunk, 0)
    if r == 65533 and n == 1 {
        fail(GoPathBadPattern)
    }
    let rest = chunk.slice(n, chunk.len())
    if rest.len() == 0 {
        fail(GoPathBadPattern)
    }
    return (r, rest)
}

/// matchChunk: what is left of `s` after the chunk, or None.
fn match_chunk(chunk0: [i64], s0: [i64]) -> Option[[i64]] ! GoPathError {
    var chunk = chunk0
    var s = s0
    var failed = false
    while chunk.len() > 0 {
        if not failed and s.len() == 0 {
            failed = true
        }
        let c = chunk[0]
        if c == 91 {
            var r = 0
            if not failed {
                let (rr, n) = decode_rune(s, 0)
                r = rr
                s = s.slice(n, s.len())
            }
            chunk = chunk.slice(1, chunk.len())
            var negated = false
            if chunk.len() > 0 and chunk[0] == 94 {
                negated = true
                chunk = chunk.slice(1, chunk.len())
            }
            var matched = false
            var nrange = 0
            while true {
                if chunk.len() > 0 and chunk[0] == 93 and nrange > 0 {
                    chunk = chunk.slice(1, chunk.len())
                    break
                }
                let (lo, rest) = try get_esc(chunk)
                chunk = rest
                var hi = lo
                if chunk[0] == 45 {
                    let (h, rest2) = try get_esc(chunk.slice(1, chunk.len()))
                    hi = h
                    chunk = rest2
                }
                if lo <= r and r <= hi {
                    matched = true
                }
                nrange = nrange + 1
            }
            if matched == negated {
                failed = true
            }
        } else if c == 63 {
            if not failed {
                if s[0] == 47 {
                    failed = true
                }
                let (_r, n) = decode_rune(s, 0)
                s = s.slice(n, s.len())
            }
            chunk = chunk.slice(1, chunk.len())
        } else {
            if c == 92 {
                chunk = chunk.slice(1, chunk.len())
                if chunk.len() == 0 {
                    fail(GoPathBadPattern)
                }
            }
            if not failed {
                if chunk[0] != s[0] {
                    failed = true
                }
                s = s.slice(1, s.len())
            }
            chunk = chunk.slice(1, chunk.len())
        }
    }
    return if failed { None } else { Some(s) }
}

fn has_slash(b: [i64]) -> bool {
    return b.contains(47)
}

/// After a failed match, the rest of the pattern must still be well
/// formed.
fn check_rest(p0: [i64]) -> () ! GoPathError {
    var p = p0
    while p.len() > 0 {
        let (_star, chunk, rest) = scan_chunk(p)
        p = rest
        try match_chunk(chunk, [])
    }
    return ()
}

/// `path.Match(pattern, name)`.
pub fn match_path(pattern: str, name: str) -> bool ! GoPathError {
    var pat = bs(pattern)
    var nm = bs(name)
    while pat.len() > 0 {
        let (star, chunk, rest) = scan_chunk(pat)
        pat = rest
        if star and chunk.len() == 0 {
            return not has_slash(nm)
        }
        let first = try match_chunk(chunk, nm)
        var advanced = false
        match first {
            Some(t) -> if t.len() == 0 or pat.len() > 0 {
                nm = t
                advanced = true
            }
            None -> {}
        }
        if advanced {
            continue
        }
        if star {
            var i = 0
            while i < nm.len() and nm[i] != 47 {
                match try match_chunk(chunk, nm.slice(i + 1, nm.len())) {
                    Some(t) -> if not (pat.len() == 0 and t.len() > 0) {
                        nm = t
                        advanced = true
                    }
                    None -> {}
                }
                if advanced {
                    break
                }
                i = i + 1
            }
        }
        if advanced {
            continue
        }
        try check_rest(pat)
        return false
    }
    return nm.len() == 0
}

// ---- filepath on Unix

/// `filepath.Rel(basepath, targpath)`.
pub fn rel(basepath: str, targpath: str) -> str ! GoPathError {
    var b = clean_bytes(bs(basepath))
    let t = clean_bytes(bs(targpath))
    if t == b {
        return "."
    }
    if b == [46] {
        b = []
    }
    let b_slashed = b.len() > 0 and b[0] == 47
    let t_slashed = t.len() > 0 and t[0] == 47
    let refuse = GoPathRel("Rel: can't make " + targpath + " relative to " + basepath)
    if b_slashed != t_slashed {
        fail(refuse)
    }
    let bl = b.len()
    let tl = t.len()
    var b0 = 0
    var bi = 0
    var t0 = 0
    var ti = 0
    while true {
        while bi < bl and b[bi] != 47 {
            bi = bi + 1
        }
        while ti < tl and t[ti] != 47 {
            ti = ti + 1
        }
        if t.slice(t0, ti) != b.slice(b0, bi) {
            break
        }
        if bi < bl {
            bi = bi + 1
        }
        if ti < tl {
            ti = ti + 1
        }
        b0 = bi
        t0 = ti
    }
    if b.slice(b0, bi) == [46, 46] {
        fail(refuse)
    }
    if b0 != bl {
        let seps = b.slice(b0, bl).filter(|c| c == 47).len()
        var out = [46, 46]
        for _k in 0..seps {
            out = out + [47, 46, 46]
        }
        if t0 != tl {
            out = out + [47] + t.slice(t0, tl)
        }
        return text(out)
    }
    return text(t.slice(t0, tl))
}

/// `filepath.SplitList(p)` on Unix.
pub fn split_list(p: str) -> [str] {
    return if p.len() == 0 { [] } else { p.split(":") }
}
