// `SHA256SUMS` files, in both of the shapes tools write them in.
//
//   GNU   e3b0c442...  filename
//   GNU   e3b0c442... *filename        binary mode, the star is not part
//                                      of the name
//   BSD   SHA256 (filename) = e3b0c442...
//
// A release is published with one of these beside it and everything that
// verifies a download reads it. The two formats are both common — GNU
// coreutils writes the first, `shasum` and the BSD tools write the third —
// and a verifier that knows one silently verifies nothing when handed the
// other, because it finds no lines it recognises and reports zero
// failures.
//
// ## The star is a mode flag
//
// `*filename` means the file was read as binary. It is not part of the
// name, and a verifier that keeps it looks for a file that does not
// exist. A name that genuinely begins with a star is written with the
// escaping below.
//
// ## Escaped names
//
// A name containing a newline or a backslash is written with `\n` and
// `\\`, and the line is prefixed with a backslash to say so. A reader
// that does not undo that reads one entry as two.

type ChecksumError =
    | NotAChecksumLine(line: i64)

    /// One entry.
type ChecksumEntry = {
    /// Lower-cased hex.
    digest: str,
    /// The algorithm, for a BSD-style line; empty for a GNU one.
    algorithm: str,
    name: str,
    /// Whether the file was read in binary mode.
    binary: bool,
    /// Whether the name was written with escapes.
    escaped: bool,
}

fn is_hex(character: str) -> bool {
    let byte = character.to_lower().to_bytes().at(0)
    return (byte >= 48 and byte <= 57) or (byte >= 97 and byte <= 102)
}

fn all_hex(text: str) -> bool {
    if text.len() == 0 {
        return false
    }
    var i = 0
    while i < text.len() {
        if not is_hex(text.substr(i, 1)) {
            return false
        }
        i = i + 1
    }
    return true
}

/// Undo the escapes a name carries when the line began with a backslash.
pub fn unescape_name(name: str) -> str {
    var out = ""
    var i = 0
    while i < name.len() {
        let here = name.substr(i, 1)
        if here == "\\" and i + 1 < name.len() {
            let next = name.substr(i + 1, 1)
            if next == "n" {
                out = out + "\n"
                i = i + 2
                continue
            }
            if next == "r" {
                out = out + "\r"
                i = i + 2
                continue
            }
            if next == "\\" {
                out = out + "\\"
                i = i + 2
                continue
            }
        }
        out = out + here
        i = i + 1
    }
    return out
}

/// Put them back, and say whether any were needed.
pub fn escape_name(name: str) -> (str, bool) {
    var out = ""
    var needed = false
    var i = 0
    while i < name.len() {
        let here = name.substr(i, 1)
        if here == "\n" {
            out = out + "\\n"
            needed = true
        } else if here == "\r" {
            out = out + "\\r"
            needed = true
        } else if here == "\\" {
            out = out + "\\\\"
            needed = true
        } else {
            out = out + here
        }
        i = i + 1
    }
    return (out, needed)
}

/// Read a checksum file. A line that is neither shape is skipped, which
/// is what the tools do — but `problems` will say how many were.
pub fn parse(text: str) -> [ChecksumEntry] {
    var out: [ChecksumEntry] = []
    for raw in text.split("\n") {
        var line = raw
        if line.ends_with("\r") {
            line = line.substr(0, line.len() - 1)
        }
        if line.trim().len() == 0 or line.trim().starts_with("#") {
            continue
        }
        match read_bsd(line) {
            Some(entry) -> {
                out.push(entry)
                continue
            }
            None -> {}
        }
        match read_gnu(line) {
            Some(entry) -> out.push(entry)
            None -> {}
        }
    }
    return out
}

/// `SHA256 (name) = digest`.
fn read_bsd(line: str) -> Option[ChecksumEntry] {
    var at = 0 - 1
    var i = 0
    while i + 2 <= line.len() {
        if line.substr(i, 2) == " (" {
            at = i
            i = line.len()
        } else {
            i = i + 1
        }
    }
    if at <= 0 {
        return None
    }
    let algorithm = line.substr(0, at)
    var close = 0 - 1
    var j = at + 2
    while j + 4 <= line.len() {
        if line.substr(j, 4) == ") = " {
            close = j
        }
        j = j + 1
    }
    if close < 0 {
        return None
    }
    let name = line.substr(at + 2, close - at - 2)
    let digest = line.substr(close + 4, line.len() - close - 4).trim()
    if not all_hex(digest) {
        return None
    }
    return Some(ChecksumEntry{ digest: digest.to_lower(),
        algorithm: algorithm, name: name, binary: false,
        escaped: false })
}

/// `digest  name` or `digest *name`, with an optional leading backslash.
fn read_gnu(line: str) -> Option[ChecksumEntry] {
    var body = line
    var escaped = false
    if body.starts_with("\\") {
        escaped = true
        body = body.substr(1, body.len() - 1)
    }
    var at = 0
    while at < body.len() and is_hex(body.substr(at, 1)) {
        at = at + 1
    }
    if at == 0 or at >= body.len() {
        return None
    }
    let digest = body.substr(0, at)
    if body.substr(at, 1) != " " {
        return None
    }
    at = at + 1
    var binary = false
    if at < body.len() and body.substr(at, 1) == "*" {
        binary = true
        at = at + 1
    } else if at < body.len() and body.substr(at, 1) == " " {
        at = at + 1
    }
    var name = body.substr(at, body.len() - at)
    if escaped {
        name = unescape_name(name)
    }
    return Some(ChecksumEntry{ digest: digest.to_lower(),
        algorithm: "", name: name, binary: binary, escaped: escaped })
}

/// Write an entry in the GNU shape.
pub fn render_gnu(entry: ChecksumEntry) -> str {
    let both = escape_name(entry.name)
    var out = ""
    if both.1 {
        out = "\\"
    }
    var mark = " "
    if entry.binary {
        mark = "*"
    }
    return out + entry.digest + " " + mark + both.0
}

/// Write an entry in the BSD shape.
pub fn render_bsd(entry: ChecksumEntry, algorithm: str) -> str {
    var name = algorithm
    if entry.algorithm.len() > 0 {
        name = entry.algorithm
    }
    return name + " (" + entry.name + ") = " + entry.digest
}

/// Which algorithm a digest length implies, or the empty string.
///
/// Not a guess a verifier should have to make — a file that says
/// `SHA256` has told you — but a GNU-style file does not say, and the
/// length is the only evidence there is.
pub fn algorithm_of(entry: ChecksumEntry) -> str {
    if entry.algorithm.len() > 0 {
        return entry.algorithm.to_upper()
    }
    if entry.digest.len() == 32 {
        return "MD5"
    }
    if entry.digest.len() == 40 {
        return "SHA1"
    }
    if entry.digest.len() == 56 {
        return "SHA224"
    }
    if entry.digest.len() == 64 {
        return "SHA256"
    }
    if entry.digest.len() == 96 {
        return "SHA384"
    }
    if entry.digest.len() == 128 {
        return "SHA512"
    }
    return ""
}

/// The entry for a name, or nothing.
pub fn entry_for(entries: [ChecksumEntry],
    name: str) -> Option[ChecksumEntry] {
    for entry in entries {
        if entry.name == name {
            return Some(entry)
        }
    }
    return None
}

/// The things wrong with a checksum file that make it verify nothing.
pub fn problems(text: str) -> [str] {
    var out: [str] = []
    let entries = parse(text)
    var lines = 0
    for raw in text.split("\n") {
        if raw.trim().len() > 0 and not raw.trim().starts_with("#") {
            lines = lines + 1
        }
    }
    if entries.len() == 0 and lines > 0 {
        out.push("no line is in either format")
    } else if entries.len() < lines {
        out.push("{lines - entries.len()} lines are in neither format")
    }
    var seen: [str] = []
    for entry in entries {
        for known in seen {
            if known == entry.name {
                out.push(entry.name + " is listed twice")
            }
        }
        seen.push(entry.name)
        if algorithm_of(entry).len() == 0 {
            out.push(entry.name + " has a digest of no known length")
        }
    }
    return out
}
