// JavaScript's `JSON.parse` and `JSON.stringify`, as V8 14 runs them in
// Node 25: the same values, the same key order, and the same error
// messages, positions included.
//
// JSON that went through JavaScript comes back reordered and reworded,
// and a tool that has to agree with it -- reproduce a signature over
// `JSON.stringify(JSON.parse(text))`, or report the error a browser
// would -- needs V8's rules:
//
//   - An object's keys come out with the array-index keys (`"0"` to
//     `"4294967294"`, written canonically) first in numeric order, then
//     the rest in the order first written; a repeated key keeps its first
//     place and its last value.
//   - Numbers are doubles and print as JavaScript prints them (`1e+21`,
//     `-0` as `0`); a number too large to hold is `Infinity`, which
//     prints as `null`.
//   - `stringify` escapes a lone surrogate as `\udXXX`; an indent is up to
//     ten spaces, or the first ten units of a string.
//   - Errors are V8's: `Unexpected token '}', "{"a":1,}" is not valid
//     JSON`, `Expected ',' or ']' after array element in JSON at position
//     4 (line 1 column 5)`, with up to ten units of context either side
//     when the text is 21 units or more, and `"NaN" is not valid JSON` for
//     the four strings V8 singles out.
//
// Text is UTF-16 code units, as JavaScript strings are; `units` and
// `text` convert.

import jsnumber

type JsJson =
    | JjNull
    | JjBool(b: bool)
    | JjNumber(n: f64)
    | JjString(us: [i64])
    | JjArray(items: [JsJson])
    | JjObject(keys: [[i64]], values: [JsJson])

/// A SyntaxError's message, as UTF-16 units (it can quote a lone
/// surrogate from the input).
type JsJsonError = | JsJsonSyntax(message: [i64])

pub fn units(s: str) -> [i64] {
    var out: [i64] = []
    for c in s.codes() {
        if c >= 65536 {
            out.push(55296 + (c - 65536).shr(10))
            out.push(56320 + (c - 65536).bit_and(1023))
        } else {
            out.push(c)
        }
    }
    return out
}

pub fn text(us: [i64]) -> str {
    var out: [str] = []
    var i = 0
    while i < us.len() {
        let u = us[i]
        if u >= 55296 and u <= 56319 and i + 1 < us.len() and us[i + 1] >= 56320 and us[i + 1] <= 57343 {
            out.push((65536 + (u - 55296).shl(10) + (us[i + 1] - 56320)).to_char())
            i = i + 2
        } else {
            out.push((if u >= 55296 and u <= 57343 { 65533 } else { u }).to_char())
            i = i + 1
        }
    }
    return out.join("")
}

pub fn error_units(e: JsJsonError) -> [i64] {
    return match e {
        JsJsonSyntax(m) -> m
    }
}

/// The message as text, a lone surrogate in it as U+FFFD.
pub fn error_text(e: JsJsonError) -> str {
    return text(error_units(e))
}

// ---- tokens, as V8 classifies one character

fn tok_number() -> i64 {
    return 0
}

fn tok_string() -> i64 {
    return 1
}

fn tok_eos() -> i64 {
    return 2
}

fn tok_other() -> i64 {
    return 3
}

fn token_of(c: i64) -> i64 {
    if c < 0 {
        return tok_eos()
    }
    if c == 34 {
        return tok_string()
    }
    if (c >= 48 and c <= 57) or c == 45 {
        return tok_number()
    }
    return tok_other()
}

// ---- errors

type JjParser = { src: [i64], at: i64 }

fn cur(p: JjParser) -> i64 {
    return if p.at < p.src.len() { p.src[p.at] } else { 0 - 1 }
}

fn digits_of(n: i64) -> [i64] {
    return units(n.to_str())
}

/// CalculateFileLocation: line and column of the cursor, `\r\n` one break.
fn location(p: JjParser) -> (i64, i64) {
    var line = 1
    var last = 0
    var i = 0
    while i < p.at {
        if p.src[i] == 13 and i < p.at - 1 and p.src[i + 1] == 10 {
            i = i + 1
        }
        if p.src[i] == 13 or p.src[i] == 10 {
            line = line + 1
            last = i + 1
        }
        i = i + 1
    }
    return (line, 1 + i - last)
}

fn positioned(p: JjParser, what: str) -> JsJsonError {
    return at_position(p, what + " in JSON")
}

fn at_position(p: JjParser, what: str) -> JsJsonError {
    let (line, col) = location(p)
    return JsJsonSyntax(units(what + " at position ") + digits_of(p.at) + units(" (line ") + digits_of(line) + units(" column ") + digits_of(col) +
        units(")"))
}

fn quoted(us: [i64]) -> [i64] {
    return [34] + us + [34]
}

fn special(src: [i64]) -> bool {
    return src == units("[object Object]") or src == units("undefined") or src == units("Infinity") or src == units("NaN")
}

/// ReportUnexpectedToken without a message of its own: what the token
/// at the cursor makes of it.
fn unexpected(p: JjParser, token: i64) -> JsJsonError {
    if token == tok_eos() {
        return JsJsonSyntax(units("Unexpected end of JSON input"))
    }
    if token == tok_number() {
        return positioned(p, "Unexpected number")
    }
    if token == tok_string() {
        return positioned(p, "Unexpected string")
    }
    if special(p.src) {
        return JsJsonSyntax(quoted(p.src) + units(" is not valid JSON"))
    }
    let tok = [39, p.src[p.at], 39]
    let n = p.src.len()
    let pos = p.at
    let head = units("Unexpected token ") + tok + units(", ")
    if n < 21 {
        return JsJsonSyntax(head + quoted(p.src) + units(" is not valid JSON"))
    }
    if pos < 10 {
        return JsJsonSyntax(head + quoted(p.src.slice(0, pos + 10)) + units("... is not valid JSON"))
    }
    if pos < n - 10 {
        return JsJsonSyntax(head + units("...") + quoted(p.src.slice(pos - 10, pos + 10)) + units("... is not valid JSON"))
    }
    return JsJsonSyntax(head + units("...") + quoted(p.src.slice(pos - 10, n)) + units(" is not valid JSON"))
}

/// ReportUnexpectedCharacter.
fn unexpected_char(p: JjParser) -> JsJsonError {
    let c = cur(p)
    return unexpected(p, if c < 0 { tok_eos() } else if c <= 255 { token_of(c) } else { tok_other() })
}

// ---- values

fn skip_ws(inout p: JjParser) {
    while p.at < p.src.len() and (p.src[p.at] == 32 or p.src[p.at] == 9 or p.src[p.at] == 10 or p.src[p.at] == 13) {
        p.at = p.at + 1
    }
}

fn is_digit(c: i64) -> bool {
    return c >= 48 and c <= 57
}

fn number_part(c: i64) -> bool {
    return is_digit(c) or c == 46 or c == 101 or c == 69 or c == 45 or c == 43
}

fn advance_digits(inout p: JjParser) {
    while is_digit(cur(p)) {
        p.at = p.at + 1
    }
}

/// ParseJsonNumberAsDoubleOrSmi.
fn parse_number(inout p: JjParser) -> f64 ! JsJsonError {
    let start = p.at
    var negative = false
    if cur(p) == 45 {
        negative = true
        p.at = p.at + 1
    }
    if cur(p) == 48 {
        p.at = p.at + 1
        let c = cur(p)
        if c >= 0 and c <= 255 and number_part(c) {
            if is_digit(c) {
                fail(unexpected(p, tok_number()))
            }
        } else if not negative {
            return 0.0
        }
    } else {
        let first = p.at
        while p.at < first + 9 and is_digit(cur(p)) {
            p.at = p.at + 1
        }
        if p.at == first {
            fail(positioned(p, "No number after minus sign"))
        }
        let c = cur(p)
        if not (c >= 0 and c <= 255 and number_part(c)) {
            return ((p.src.slice(start, p.at).map(|u| u.to_char()).join("")).parse_int() ?? 0).as_f64()
        }
        advance_digits(p)
    }
    if cur(p) == 46 {
        p.at = p.at + 1
        if not is_digit(cur(p)) {
            fail(positioned(p, "Unterminated fractional number"))
        }
        advance_digits(p)
    }
    if cur(p) == 101 or cur(p) == 69 {
        p.at = p.at + 1
        if cur(p) == 45 or cur(p) == 43 {
            p.at = p.at + 1
        }
        if not is_digit(cur(p)) {
            fail(positioned(p, "Exponent part is missing a number"))
        }
        advance_digits(p)
    }
    let t = p.src.slice(start, p.at).map(|u| u.to_char()).join("")
    return t.parse_float() ?? 0.0
}

fn hex_value(c: i64) -> i64 {
    return if c >= 48 and c <= 57 { c - 48 } else if c >= 97 and c <= 102 { c - 87 } else if c >= 65 and c <= 70 { c - 55 } else { 0 - 1 }
}

/// ScanJsonString, the cursor just past the opening quote.
fn parse_string(inout p: JjParser) -> [i64] ! JsJsonError {
    var out: [i64] = []
    while true {
        let c = cur(p)
        if c < 0 {
            fail(positioned(p, "Unterminated string"))
        }
        if c == 34 {
            p.at = p.at + 1
            return out
        }
        if c == 92 {
            p.at = p.at + 1
            let e = cur(p)
            if e < 0 or e > 255 {
                fail(unexpected_char(p))
            }
            let short = [34, 92, 47, 98, 102, 110, 114, 116].position(e)
            if short >= 0 {
                out.push([34, 92, 47, 8, 12, 10, 13, 9][short])
            } else if e == 117 {
                var v = 0
                for _k in 0..4 {
                    p.at = p.at + 1
                    let d = hex_value(cur(p))
                    if d < 0 {
                        fail(positioned(p, "Bad Unicode escape"))
                    }
                    v = v * 16 + d
                }
                out.push(v)
            } else {
                fail(positioned(p, "Bad escaped character"))
            }
            p.at = p.at + 1
            continue
        }
        if c < 32 {
            fail(positioned(p, "Bad control character in string literal"))
        }
        out.push(c)
        p.at = p.at + 1
    }
    return out
}

fn position(xs: [i64], x: i64) -> i64 {
    for i in 0..xs.len() {
        if xs[i] == x {
            return i
        }
    }
    return 0 - 1
}

/// A literal, the first character already matched: ScanLiteral.
fn literal(inout p: JjParser, word: str) -> () ! JsJsonError {
    let w = units(word)
    p.at = p.at + 1
    for k in 1..w.len() {
        if cur(p) < 0 {
            fail(unexpected(p, tok_eos()))
        }
        if cur(p) != w[k] {
            fail(unexpected_char(p))
        }
        p.at = p.at + 1
    }
    return ()
}

/// The array index a key names, or -1: "0", or digits without a leading
/// zero up to 4294967294.
fn array_index(k: [i64]) -> i64 {
    if k.len() == 0 or k.len() > 10 or not k.all(|c| is_digit(c)) or (k.len() > 1 and k[0] == 48) {
        return 0 - 1
    }
    let v = k.fold(0, |a, c| a * 10 + c - 48)
    return if v <= 4294967294 { v } else { 0 - 1 }
}

/// Adds a property as a JavaScript object orders it.
fn put(inout keys: [[i64]], inout values: [JsJson], k: [i64], v: JsJson) {
    for i in 0..keys.len() {
        if keys[i] == k {
            values[i] = v
            return
        }
    }
    let idx = array_index(k)
    var at = keys.len()
    if idx >= 0 {
        at = 0
        while at < keys.len() and array_index(keys[at]) >= 0 and array_index(keys[at]) < idx {
            at = at + 1
        }
    }
    keys = keys.slice(0, at) + [k] + keys.slice(at, keys.len())
    values = values.slice(0, at) + [v] + values.slice(at, values.len())
}

fn parse_object(inout p: JjParser) -> JsJson ! JsJsonError {
    p.at = p.at + 1
    var keys: [[i64]] = []
    var values: [JsJson] = []
    skip_ws(p)
    if cur(p) == 125 {
        p.at = p.at + 1
        return JjObject(keys, values)
    }
    var first = true
    while true {
        skip_ws(p)
        if cur(p) != 34 {
            fail(positioned(p, if first { "Expected property name or '}'" } else { "Expected double-quoted property name" }))
        }
        first = false
        p.at = p.at + 1
        let k = try parse_string(p)
        skip_ws(p)
        if cur(p) != 58 {
            fail(positioned(p, "Expected ':' after property name"))
        }
        p.at = p.at + 1
        let v = try parse_value(p)
        put(keys, values, k, v)
        skip_ws(p)
        if cur(p) != 44 {
            break
        }
        p.at = p.at + 1
    }
    if cur(p) != 125 {
        fail(positioned(p, "Expected ',' or '}' after property value"))
    }
    p.at = p.at + 1
    return JjObject(keys, values)
}

fn parse_array(inout p: JjParser) -> JsJson ! JsJsonError {
    p.at = p.at + 1
    var items: [JsJson] = []
    skip_ws(p)
    if cur(p) == 93 {
        p.at = p.at + 1
        return JjArray(items)
    }
    // V8 reads a run of leading numbers on a fast path, whose only
    // difference is where a missing `]` is reported.
    while token_of(cur(p)) == tok_number() {
        items.push(JjNumber(try parse_number(p)))
        skip_ws(p)
        if cur(p) == 44 {
            p.at = p.at + 1
            skip_ws(p)
            continue
        }
        if cur(p) != 93 {
            fail(positioned(p, "Expected ',' or ']' after array element"))
        }
        p.at = p.at + 1
        return JjArray(items)
    }
    items.push(try parse_value(p))
    while true {
        skip_ws(p)
        if cur(p) != 44 {
            break
        }
        p.at = p.at + 1
        items.push(try parse_value(p))
    }
    if cur(p) != 93 {
        fail(positioned(p, "Expected ',' or ']' after array element"))
    }
    p.at = p.at + 1
    return JjArray(items)
}

/// ParseJsonValueRecursive.
fn parse_value(inout p: JjParser) -> JsJson ! JsJsonError {
    skip_ws(p)
    let c = cur(p)
    if token_of(c) == tok_number() {
        return JjNumber(try parse_number(p))
    }
    if c == 34 {
        p.at = p.at + 1
        return JjString(try parse_string(p))
    }
    if c == 116 {
        try literal(p, "true")
        return JjBool(true)
    }
    if c == 102 {
        try literal(p, "false")
        return JjBool(false)
    }
    if c == 110 {
        try literal(p, "null")
        return JjNull
    }
    if c == 123 {
        return try parse_object(p)
    }
    if c == 91 {
        return try parse_array(p)
    }
    fail(unexpected_char(p))
}

/// `JSON.parse(text)`, the text as UTF-16 code units.
pub fn parse(src: [i64]) -> JsJson ! JsJsonError {
    var p = JjParser{ src: src, at: 0 }
    let v = try parse_value(p)
    skip_ws(p)
    if p.at < src.len() {
        fail(at_position(p, "Unexpected non-whitespace character after JSON"))
    }
    return v
}

/// `JSON.parse(text)`.
pub fn parse_text(s: str) -> JsJson ! JsJsonError {
    return try parse(units(s))
}

// ---- stringify

/// Appends in place: `out = out + xs` would copy all of `out` each time.
fn extend(inout out: [i64], xs: [i64]) {
    for x in xs {
        out.push(x)
    }
}

fn hex4(n: i64) -> [i64] {
    let digits = "0123456789abcdef".codes()
    return [digits[n.shr(12).bit_and(15)], digits[n.shr(8).bit_and(15)], digits[n.shr(4).bit_and(15)], digits[n.bit_and(15)]]
}

/// QuoteJSONString: a lone surrogate written as an escape.
pub fn quote(us: [i64]) -> [i64] {
    var out = [34]
    var i = 0
    while i < us.len() {
        let c = us[i]
        let short = [34, 92, 8, 12, 10, 13, 9].position(c)
        if short >= 0 {
            out.push(92)
            out.push([34, 92, 98, 102, 110, 114, 116][short])
        } else if c < 32 {
            extend(out, [92, 117] + hex4(c))
        } else if c >= 55296 and c <= 56319 and i + 1 < us.len() and us[i + 1] >= 56320 and us[i + 1] <= 57343 {
            out.push(c)
            out.push(us[i + 1])
            i = i + 1
        } else if c >= 55296 and c <= 57343 {
            extend(out, [92, 117] + hex4(c))
        } else {
            out.push(c)
        }
        i = i + 1
    }
    out.push(34)
    return out
}

/// The gap a numeric `space` argument gives: up to ten spaces.
pub fn gap_of_number(n: f64) -> [i64] {
    let k = if n >= 10.0 { 10 } else if n >= 1.0 { n.as_i64() } else { 0 }
    return (0..k).to_list().map(|_x| 32)
}

/// The gap a string `space` argument gives: its first ten units.
pub fn gap_of_string(s: [i64]) -> [i64] {
    return if s.len() > 10 { s.slice(0, 10) } else { s }
}

fn number_text(n: f64) -> [i64] {
    if n != n or n == 1.0 / 0.0 or n == -1.0 / 0.0 {
        return units("null")
    }
    return units(jsnumber.to_string(n))
}

fn write(inout out: [i64], v: JsJson, gap: [i64], indent: [i64]) {
    match v {
        JjNull -> extend(out, units("null"))
        JjBool(b) -> extend(out, units(if b { "true" } else { "false" }))
        JjNumber(n) -> extend(out, number_text(n))
        JjString(us) -> extend(out, quote(us))
        JjArray(items) -> {
            if items.len() == 0 {
                extend(out, [91, 93])
                return
            }
            let inner = indent + gap
            out.push(91)
            for k in 0..items.len() {
                if k > 0 {
                    out.push(44)
                }
                if gap.len() > 0 {
                    extend(out, [10] + inner)
                }
                write(out, items[k], gap, inner)
            }
            if gap.len() > 0 {
                extend(out, [10] + indent)
            }
            out.push(93)
        }
        JjObject(keys, values) -> {
            if keys.len() == 0 {
                extend(out, [123, 125])
                return
            }
            let inner = indent + gap
            out.push(123)
            for k in 0..keys.len() {
                if k > 0 {
                    out.push(44)
                }
                if gap.len() > 0 {
                    extend(out, [10] + inner)
                }
                extend(out, quote(keys[k]) + [58])
                if gap.len() > 0 {
                    out.push(32)
                }
                write(out, values[k], gap, inner)
            }
            if gap.len() > 0 {
                extend(out, [10] + indent)
            }
            out.push(125)
        }
    }
}

/// `JSON.stringify(v, null, space)`, with the gap `space` makes.
pub fn stringify(v: JsJson, gap: [i64]) -> [i64] {
    var out: [i64] = []
    write(out, v, gap, [])
    return out
}
