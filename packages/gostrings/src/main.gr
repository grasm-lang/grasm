// Go's `strings` package where its byte-level and Unicode rules decide the
// answer, as Go 1.25 computes it: `Fields`, `EqualFold`, `ToUpper`,
// `ToLower`, `ToTitle`, `Title`, `ToValidUTF8`, `Split`, `SplitN`,
// `SplitAfter`, `SplitAfterN`, `Cut`, `CutPrefix`, `CutSuffix`, `Count`,
// `Index`, `LastIndex`, `IndexRune`, `IndexAny`, `LastIndexAny`,
// `ContainsRune`, `ContainsAny`, `Replace`, `ReplaceAll`, `Trim`,
// `TrimLeft`, `TrimRight`, `TrimSpace`, `TrimPrefix`, `TrimSuffix` and
// `NewReplacer` with `Replacer.Replace`; and the rune mappings under them,
// `unicode.ToUpper`, `ToLower`, `ToTitle` and `SimpleFold`.
//
// A Go string is bytes, so these take and return `bytes`, and a program
// that must give the answers a Go program gives needs Go's exact rules:
//
//   - A byte that does not start a valid UTF-8 sequence reads as U+FFFD,
//     one byte at a time; the case mappings and `Title` write it back as
//     U+FFFD's three bytes, while `Split` with an empty separator keeps it
//     as the byte it was. `EqualFold` treats any two such bytes as equal.
//   - Case mapping is Unicode 15.0's simple mapping (`ß` stays `ß`, `ǆ`
//     titles as `ǅ`), and `EqualFold` follows `SimpleFold` orbits, so `K`
//     (U+212A) equals `k` and `ſ` equals `S`.
//   - `Count(s, "")` is the number of runes plus one, and `Replace` with an
//     empty `old` inserts at rune boundaries; but a `Replacer` with an empty
//     old string inserts between every byte, even inside a character, and at
//     each position takes the first old string, in argument order, that
//     matches there -- not the longest.
//   - `Fields` and `TrimSpace` split on Unicode white space (U+0085,
//     U+00A0, U+3000 and the rest); `Title` capitalizes after anything but
//     a letter, a digit or `_`, as Go's deprecated `Title` does.
//   - `SplitN` with `n == 0` gives no pieces, and with `n < 0` all of them;
//     `IndexAny` and `LastIndexAny` look for U+FFFD where a set holds a
//     single non-ASCII byte; `IndexRune` of an invalid rune is -1.
//
// Not here: the functions that take a function (`Map`, `FieldsFunc`,
// `TrimFunc`, `IndexFunc` and the rest), the iterator forms (`Lines`,
// `SplitSeq` ...), `Builder` and `Reader`.

type GoReplacer = { olds: [[i64]], news: [[i64]] }

type GoUnicodeTables = { letters: [i64], digits: [i64], cases: [i64], orbit: [i64] }

fn tables() -> GoUnicodeTables {
    return GoUnicodeTables{ letters: letter_ranges(), digits: digit_ranges(), cases: case_ranges(), orbit: fold_orbit() }
}

// ---- UTF-8 as Go decodes and encodes it

/// `utf8.DecodeRune` of `b` from `i`: the rune and its width, U+FFFD and
/// 1 for a byte that does not start a valid sequence.
fn decode(b: [i64], i: i64) -> (i64, i64) {
    let c0 = b[i]
    if c0 < 128 {
        return (c0, 1)
    }
    let n = b.len() - i
    let bad = (65533, 1)
    if c0 < 194 or c0 > 244 {
        return bad
    }
    if c0 < 224 {
        if n < 2 or b[i + 1] < 128 or b[i + 1] > 191 {
            return bad
        }
        return (c0.bit_and(31).shl(6).bit_or(b[i + 1].bit_and(63)), 2)
    }
    let lo = if c0 == 224 { 160 } else if c0 == 240 { 144 } else { 128 }
    let hi = if c0 == 237 { 159 } else if c0 == 244 { 143 } else { 191 }
    if n < 2 or b[i + 1] < lo or b[i + 1] > hi {
        return bad
    }
    if n < 3 or b[i + 2] < 128 or b[i + 2] > 191 {
        return bad
    }
    if c0 < 240 {
        return (c0.bit_and(15).shl(12).bit_or(b[i + 1].bit_and(63).shl(6)).bit_or(b[i + 2].bit_and(63)), 3)
    }
    if n < 4 or b[i + 3] < 128 or b[i + 3] > 191 {
        return bad
    }
    return (c0.bit_and(7).shl(18).bit_or(b[i + 1].bit_and(63).shl(12)).bit_or(b[i + 2].bit_and(63).shl(6)).bit_or(b[i + 3].bit_and(63)), 4)
}

/// `utf8.DecodeLastRune` of `b[..end]`.
fn decode_last(b: [i64], end: i64) -> (i64, i64) {
    var start = end - 1
    if b[start] < 128 {
        return (b[start], 1)
    }
    let lim = (end - 4).max(0)
    start = start - 1
    while start >= lim {
        if b[start] < 128 or b[start] >= 192 {
            break
        }
        start = start - 1
    }
    start = start.max(0)
    let (r, size) = decode(b.slice(start, end), 0)
    if start + size != end {
        return (65533, 1)
    }
    return (r, size)
}

fn valid_rune(r: i64) -> bool {
    return r >= 0 and r <= 1114111 and (r < 55296 or r > 57343)
}

/// The UTF-8 encoding of `r`, U+FFFD's for a value that is not a rune.
fn encode(r: i64) -> [i64] {
    if r >= 0 and r < 128 {
        return [r]
    }
    if r >= 0 and r < 2048 {
        return [192 + r.shr(6), 128 + r.bit_and(63)]
    }
    if not valid_rune(r) {
        return [239, 191, 189]
    }
    if r < 65536 {
        return [224 + r.shr(12), 128 + r.shr(6).bit_and(63), 128 + r.bit_and(63)]
    }
    return [240 + r.shr(18), 128 + r.shr(12).bit_and(63), 128 + r.shr(6).bit_and(63), 128 + r.bit_and(63)]
}

fn rune_count(b: [i64]) -> i64 {
    var n = 0
    var i = 0
    while i < b.len() {
        i = i + decode(b, i).1
        n = n + 1
    }
    return n
}

fn out(b: [i64]) -> bytes {
    return bytes_of(b)
}

// ---- Unicode tables

fn in_ranges(t: [i64], r: i64) -> bool {
    var lo = 0
    var hi = t.len() / 2 - 1
    while lo <= hi {
        let mid = (lo + hi) / 2
        if r < t[2 * mid] {
            hi = mid - 1
        } else if r > t[2 * mid + 1] {
            lo = mid + 1
        } else {
            return true
        }
    }
    return false
}

/// `unicode.IsSpace`.
fn is_space(r: i64) -> bool {
    if r < 256 {
        return (r >= 9 and r <= 13) or r == 32 or r == 133 or r == 160
    }
    return r == 5760 or (r >= 8192 and r <= 8202) or r == 8232 or r == 8233 or r == 8239 or r == 8287 or r == 12288
}

/// `unicode.To(c, r)` for c = 0 (upper), 1 (lower), 2 (title), from Go's
/// `CaseRanges`.
fn to_case(t: GoUnicodeTables, c: i64, r: i64) -> i64 {
    if r < 128 {
        if c == 1 {
            return if r >= 65 and r <= 90 { r + 32 } else { r }
        }
        return if r >= 97 and r <= 122 { r - 32 } else { r }
    }
    let cr = t.cases
    var lo = 0
    var hi = cr.len() / 5
    while lo < hi {
        let m = (lo + hi) / 2
        let first = cr[5 * m]
        if first <= r and r <= cr[5 * m + 1] {
            let delta = cr[5 * m + 2 + c]
            if delta > 1114111 {
                return first + (r - first).bit_and(0 - 2).bit_or(c.bit_and(1))
            }
            return r + delta
        }
        if r < first {
            hi = m
        } else {
            lo = m + 1
        }
    }
    return r
}

fn fold(t: GoUnicodeTables, r: i64) -> i64 {
    if r < 0 or r > 1114111 {
        return r
    }
    let o = t.orbit
    var lo = 0
    var hi = o.len() / 2 - 1
    while lo <= hi {
        let mid = (lo + hi) / 2
        if r < o[2 * mid] {
            hi = mid - 1
        } else if r > o[2 * mid] {
            lo = mid + 1
        } else {
            return o[2 * mid + 1]
        }
    }
    let l = to_case(t, 1, r)
    return if l != r { l } else { to_case(t, 0, r) }
}

/// `unicode.ToUpper`.
pub fn unicode_to_upper(r: i64) -> i64 {
    return to_case(tables(), 0, r)
}

/// `unicode.ToLower`.
pub fn unicode_to_lower(r: i64) -> i64 {
    return to_case(tables(), 1, r)
}

/// `unicode.ToTitle`.
pub fn unicode_to_title(r: i64) -> i64 {
    return to_case(tables(), 2, r)
}

/// `unicode.SimpleFold`: the next rune, upwards and round again, that
/// folds to the same thing as `r`.
pub fn unicode_simple_fold(r: i64) -> i64 {
    return fold(tables(), r)
}

// ---- searching

fn find(s: [i64], sep: [i64], from: i64) -> i64 {
    let n = sep.len()
    var i = from
    while i + n <= s.len() {
        var k = 0
        while k < n and s[i + k] == sep[k] {
            k = k + 1
        }
        if k == n {
            return i
        }
        i = i + 1
    }
    return 0 - 1
}

fn count_list(s: [i64], sep: [i64]) -> i64 {
    if sep.len() == 0 {
        return rune_count(s) + 1
    }
    var n = 0
    var i = find(s, sep, 0)
    while i >= 0 {
        n = n + 1
        i = find(s, sep, i + sep.len())
    }
    return n
}

/// `strings.Count`: non-overlapping instances of `sep`; runes plus one when
/// `sep` is empty.
pub fn count(s: bytes, sep: bytes) -> i64 {
    return count_list(s.to_list(), sep.to_list())
}

/// `strings.Index`.
pub fn index(s: bytes, sep: bytes) -> i64 {
    return find(s.to_list(), sep.to_list(), 0)
}

/// `strings.LastIndex`.
pub fn last_index(s: bytes, sep: bytes) -> i64 {
    let a = s.to_list()
    let b = sep.to_list()
    var i = a.len() - b.len()
    while i >= 0 {
        if a.slice(i, i + b.len()) == b {
            return i
        }
        i = i - 1
    }
    return 0 - 1
}

fn index_rune_list(s: [i64], r: i64) -> i64 {
    if r >= 0 and r < 128 {
        return find(s, [r], 0)
    }
    if r == 65533 {
        var i = 0
        while i < s.len() {
            let (c, w) = decode(s, i)
            if c == 65533 {
                return i
            }
            i = i + w
        }
        return 0 - 1
    }
    if not valid_rune(r) {
        return 0 - 1
    }
    return find(s, encode(r), 0)
}

/// `strings.IndexRune`: where `r` first appears; U+FFFD also finds a byte
/// that is not UTF-8; an invalid rune is never found.
pub fn index_rune(s: bytes, r: i64) -> i64 {
    return index_rune_list(s.to_list(), r)
}

/// `strings.ContainsRune`.
pub fn contains_rune(s: bytes, r: i64) -> bool {
    return index_rune(s, r) >= 0
}

/// `strings.IndexAny`.
pub fn index_any(s: bytes, chars: bytes) -> i64 {
    let a = s.to_list()
    let set = chars.to_list()
    if set.len() == 0 {
        return 0 - 1
    }
    if set.len() == 1 {
        return index_rune_list(a, if set[0] >= 128 { 65533 } else { set[0] })
    }
    var i = 0
    while i < a.len() {
        let (c, w) = decode(a, i)
        if index_rune_list(set, c) >= 0 {
            return i
        }
        i = i + w
    }
    return 0 - 1
}

/// `strings.ContainsAny`.
pub fn contains_any(s: bytes, chars: bytes) -> bool {
    return index_any(s, chars) >= 0
}

/// `strings.LastIndexAny`.
pub fn last_index_any(s: bytes, chars: bytes) -> i64 {
    let a = s.to_list()
    let set = chars.to_list()
    if set.len() == 0 {
        return 0 - 1
    }
    var i = a.len()
    while i > 0 {
        let (r, size) = decode_last(a, i)
        i = i - size
        if index_rune_list(set, r) >= 0 {
            return i
        }
    }
    return 0 - 1
}

// ---- splitting

fn explode(s: [i64], n0: i64) -> [bytes] {
    let l = rune_count(s)
    let n = if n0 < 0 or n0 > l { l } else { n0 }
    var parts: [bytes] = []
    var at = 0
    for _k in 0..(n - 1).max(0) {
        let w = decode(s, at).1
        parts.push(out(s.slice(at, at + w)))
        at = at + w
    }
    if n > 0 {
        parts.push(out(s.slice(at, s.len())))
    }
    return parts
}

fn gen_split(s: [i64], sep: [i64], save: i64, n0: i64) -> [bytes] {
    if n0 == 0 {
        return []
    }
    if sep.len() == 0 {
        return explode(s, n0)
    }
    var n = if n0 < 0 { count_list(s, sep) + 1 } else { n0 }
    n = n.min(s.len() + 1) - 1
    var parts: [bytes] = []
    var at = 0
    while parts.len() < n {
        let m = find(s, sep, at)
        if m < 0 {
            break
        }
        parts.push(out(s.slice(at, m + save)))
        at = m + sep.len()
    }
    parts.push(out(s.slice(at, s.len())))
    return parts
}

/// `strings.SplitN`: at most `n` pieces (all when `n < 0`, none when 0);
/// an empty `sep` splits after each rune.
pub fn split_n(s: bytes, sep: bytes, n: i64) -> [bytes] {
    return gen_split(s.to_list(), sep.to_list(), 0, n)
}

/// `strings.SplitAfterN`: as `SplitN`, each piece keeping its separator.
pub fn split_after_n(s: bytes, sep: bytes, n: i64) -> [bytes] {
    return gen_split(s.to_list(), sep.to_list(), sep.len(), n)
}

/// `strings.Split`.
pub fn split(s: bytes, sep: bytes) -> [bytes] {
    return split_n(s, sep, 0 - 1)
}

/// `strings.SplitAfter`.
pub fn split_after(s: bytes, sep: bytes) -> [bytes] {
    return split_after_n(s, sep, 0 - 1)
}

/// `strings.Fields`: the runs between Unicode white space.
pub fn fields(s: bytes) -> [bytes] {
    let a = s.to_list()
    var parts: [bytes] = []
    var start = 0 - 1
    var i = 0
    while i < a.len() {
        let (r, w) = decode(a, i)
        if is_space(r) {
            if start >= 0 {
                parts.push(out(a.slice(start, i)))
                start = 0 - 1
            }
        } else if start < 0 {
            start = i
        }
        i = i + w
    }
    if start >= 0 {
        parts.push(out(a.slice(start, a.len())))
    }
    return parts
}

/// `strings.Cut`: before and after the first `sep`, and whether it was there.
pub fn cut(s: bytes, sep: bytes) -> (bytes, bytes, bool) {
    let i = index(s, sep)
    if i < 0 {
        return (s, out([]), false)
    }
    return (s.slice(0, i), s.slice(i + sep.len(), s.len()), true)
}

fn has_prefix(s: bytes, p: bytes) -> bool {
    return s.len() >= p.len() and s.slice(0, p.len()) == p
}

fn has_suffix(s: bytes, p: bytes) -> bool {
    return s.len() >= p.len() and s.slice(s.len() - p.len(), s.len()) == p
}

/// `strings.CutPrefix`.
pub fn cut_prefix(s: bytes, prefix: bytes) -> (bytes, bool) {
    return if has_prefix(s, prefix) { (s.slice(prefix.len(), s.len()), true) } else { (s, false) }
}

/// `strings.CutSuffix`.
pub fn cut_suffix(s: bytes, suffix: bytes) -> (bytes, bool) {
    return if has_suffix(s, suffix) { (s.slice(0, s.len() - suffix.len()), true) } else { (s, false) }
}

/// `strings.TrimPrefix`.
pub fn trim_prefix(s: bytes, prefix: bytes) -> bytes {
    return cut_prefix(s, prefix).0
}

/// `strings.TrimSuffix`.
pub fn trim_suffix(s: bytes, suffix: bytes) -> bytes {
    return cut_suffix(s, suffix).0
}

// ---- case

fn map_case(s: bytes, c: i64) -> bytes {
    let t = tables()
    let a = s.to_list()
    var o: [i64] = []
    var i = 0
    while i < a.len() {
        let (r, w) = decode(a, i)
        for x in encode(to_case(t, c, r)) {
            o.push(x)
        }
        i = i + w
    }
    return out(o)
}

/// `strings.ToUpper`.
pub fn to_upper(s: bytes) -> bytes {
    return map_case(s, 0)
}

/// `strings.ToLower`.
pub fn to_lower(s: bytes) -> bytes {
    return map_case(s, 1)
}

/// `strings.ToTitle`.
pub fn to_title(s: bytes) -> bytes {
    return map_case(s, 2)
}

fn is_separator(t: GoUnicodeTables, r: i64) -> bool {
    if r < 128 {
        return not ((r >= 48 and r <= 57) or (r >= 97 and r <= 122) or (r >= 65 and r <= 90) or r == 95)
    }
    if in_ranges(t.letters, r) or in_ranges(t.digits, r) {
        return false
    }
    return is_space(r)
}

/// `strings.Title`: each rune after a separator in title case.
pub fn title(s: bytes) -> bytes {
    let t = tables()
    let a = s.to_list()
    var o: [i64] = []
    var prev = 32
    var i = 0
    while i < a.len() {
        let (r, w) = decode(a, i)
        let m = if is_separator(t, prev) { to_case(t, 2, r) } else { r }
        prev = r
        for x in encode(m) {
            o.push(x)
        }
        i = i + w
    }
    return out(o)
}

/// `strings.EqualFold`: equal under simple Unicode case folding.
pub fn equal_fold(s: bytes, u: bytes) -> bool {
    let t = tables()
    let a = s.to_list()
    let b = u.to_list()
    var i = 0
    var j = 0
    while i < a.len() {
        if j >= b.len() {
            return false
        }
        let (r1, w1) = decode(a, i)
        let (r2, w2) = decode(b, j)
        i = i + w1
        j = j + w2
        if r1 != r2 {
            let sr = r1.min(r2)
            let tr = r1.max(r2)
            if tr < 128 {
                if not (sr >= 65 and sr <= 90 and tr == sr + 32) {
                    return false
                }
            } else {
                var r = fold(t, sr)
                while r != sr and r < tr {
                    r = fold(t, r)
                }
                if r != tr {
                    return false
                }
            }
        }
    }
    return j == b.len()
}

/// `strings.ToValidUTF8`: each run of bytes that are not UTF-8 replaced by
/// `replacement`, once.
pub fn to_valid_utf8(s: bytes, replacement: bytes) -> bytes {
    let a = s.to_list()
    var o: [i64] = []
    var invalid = false
    var i = 0
    while i < a.len() {
        let w = decode(a, i).1
        if a[i] >= 128 and w == 1 {
            if not invalid {
                invalid = true
                for x in replacement.to_list() {
                    o.push(x)
                }
            }
            i = i + 1
        } else {
            invalid = false
            for k in 0..w {
                o.push(a[i + k])
            }
            i = i + w
        }
    }
    return out(o)
}

// ---- trimming

fn trim_left_list(a: [i64], set: [i64]) -> [i64] {
    var i = 0
    while i < a.len() {
        let (r, n) = decode(a, i)
        if index_rune_list(set, r) < 0 {
            break
        }
        i = i + n
    }
    return a.slice(i, a.len())
}

fn trim_right_list(a: [i64], set: [i64]) -> [i64] {
    var end = a.len()
    while end > 0 {
        let (r, n) = decode_last(a, end)
        if index_rune_list(set, r) < 0 {
            break
        }
        end = end - n
    }
    return a.slice(0, end)
}

/// `strings.Trim`: runes in `cutset` removed from both ends.
pub fn trim(s: bytes, cutset: bytes) -> bytes {
    if s.len() == 0 or cutset.len() == 0 {
        return s
    }
    let set = cutset.to_list()
    return out(trim_left_list(trim_right_list(s.to_list(), set), set))
}

/// `strings.TrimLeft`.
pub fn trim_left(s: bytes, cutset: bytes) -> bytes {
    if s.len() == 0 or cutset.len() == 0 {
        return s
    }
    return out(trim_left_list(s.to_list(), cutset.to_list()))
}

/// `strings.TrimRight`.
pub fn trim_right(s: bytes, cutset: bytes) -> bytes {
    if s.len() == 0 or cutset.len() == 0 {
        return s
    }
    return out(trim_right_list(s.to_list(), cutset.to_list()))
}

/// `strings.TrimSpace`: Unicode white space removed from both ends.
pub fn trim_space(s: bytes) -> bytes {
    let a = s.to_list()
    var i = 0
    while i < a.len() {
        let (r, n) = decode(a, i)
        if not is_space(r) {
            break
        }
        i = i + n
    }
    var end = a.len()
    while end > i {
        let (r, n) = decode_last(a, end)
        if not is_space(r) {
            break
        }
        end = end - n
    }
    return out(a.slice(i, end))
}

// ---- replacing

/// `strings.Replace`: the first `n` non-overlapping `old` replaced (all when
/// `n < 0`); an empty `old` matches at the start and after each rune.
pub fn replace(s: bytes, old: bytes, new: bytes, n: i64) -> bytes {
    let a = s.to_list()
    let o = old.to_list()
    if o == new.to_list() or n == 0 {
        return s
    }
    let m = count_list(a, o)
    if m == 0 {
        return s
    }
    let times = if n < 0 or m < n { m } else { n }
    var res: [i64] = []
    var start = 0
    for k in 0..times {
        var j = start
        if o.len() == 0 {
            if k > 0 and start < a.len() {
                j = j + decode(a, start).1
            }
        } else {
            j = find(a, o, start)
        }
        for x in a.slice(start, j) {
            res.push(x)
        }
        for x in new.to_list() {
            res.push(x)
        }
        start = j + o.len()
    }
    for x in a.slice(start, a.len()) {
        res.push(x)
    }
    return out(res)
}

/// `strings.ReplaceAll`.
pub fn replace_all(s: bytes, old: bytes, new: bytes) -> bytes {
    return replace(s, old, new, 0 - 1)
}

/// `strings.NewReplacer(old1, new1, old2, new2, ...)`, from the pairs.
pub fn new_replacer(pairs: [(bytes, bytes)]) -> GoReplacer {
    return GoReplacer{ olds: pairs.map(|p| p.0.to_list()), news: pairs.map(|p| p.1.to_list()) }
}

fn starts_at(s: [i64], at: i64, p: [i64]) -> bool {
    if at + p.len() > s.len() {
        return false
    }
    for k in 0..p.len() {
        if s[at + k] != p[k] {
            return false
        }
    }
    return true
}

/// `Replacer.Replace`: left to right, a byte at a time; at each position
/// the first pair (in argument order) whose old string starts there, and
/// an empty old string at most once per position.
pub fn replacer_replace(r: GoReplacer, s: bytes) -> bytes {
    let a = s.to_list()
    var res: [i64] = []
    var last = 0
    var prev_empty = false
    var i = 0
    while i <= a.len() {
        var hit = 0 - 1
        for k in 0..r.olds.len() {
            if hit < 0 and not (prev_empty and r.olds[k].len() == 0) and starts_at(a, i, r.olds[k]) {
                hit = k
            }
        }
        prev_empty = hit >= 0 and r.olds[hit].len() == 0
        if hit >= 0 {
            for x in a.slice(last, i) {
                res.push(x)
            }
            for x in r.news[hit] {
                res.push(x)
            }
            i = i + r.olds[hit].len()
            last = i
        } else {
            i = i + 1
        }
    }
    for x in a.slice(last, a.len()) {
        res.push(x)
    }
    return out(res)
}

