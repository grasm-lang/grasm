// Node's `path.posix`, as Node 25 computes it: `normalize`, `join`,
// `resolve`, `relative`, `dirname`, `basename`, `extname`, `parse`,
// `format` and `isAbsolute`.
//
// Bundlers, test runners, linters and package managers built on Node
// compute their paths with these, and a tool that has to agree with them
// -- on a cache key, a module id, a manifest entry -- needs Node's rules,
// which are textual and particular:
//
//   - Nothing touches the disk; `..` cancels the segment before it, and
//     above the root it is dropped (absolute) or kept (relative).
//   - `normalize` keeps one trailing slash and gives `.` or `./` for
//     nothing; `join` skips empty arguments.
//   - `dirname("//a")` is `//`; `basename` strips a suffix only when
//     something is left; `extname(".x")` is empty, `extname("a.")` is
//     `.`, and `..` has no extension.
//   - `resolve` and `relative` work from the current directory, which is
//     an argument here: `cwd`, what `process.cwd()` would return (it is
//     returned as it is when it is all `resolve` has to go on).
//
// Strings are worked on in UTF-16 code units, as JavaScript does.

/// What `path.parse` returns; `path.format` reads the same fields, an
/// empty string standing for a missing one.
type NodePathParts = { root: str, dir: str, base: str, ext: str, name: str }

fn units(s: str) -> [i64] {
    var out: [i64] = []
    for c in s.codes() {
        if c >= 65536 {
            out.push(55296 + (c - 65536).shr(10))
            out.push(56320 + (c - 65536).bit_and(1023))
        } else {
            out.push(c)
        }
    }
    return out
}

fn text(us: [i64]) -> str {
    var out: [str] = []
    var i = 0
    while i < us.len() {
        let u = us[i]
        if u >= 55296 and u <= 56319 and i + 1 < us.len() and us[i + 1] >= 56320 and us[i + 1] <= 57343 {
            out.push((65536 + (u - 55296).shl(10) + (us[i + 1] - 56320)).to_char())
            i = i + 2
        } else {
            out.push((if u >= 55296 and u <= 57343 { 65533 } else { u }).to_char())
            i = i + 1
        }
    }
    return out.join("")
}

fn last_slash(res: [i64]) -> i64 {
    var k = res.len() - 1
    while k >= 0 and res[k] != 47 {
        k = k - 1
    }
    return k
}

/// normalizeString with `/` as the separator.
fn normalize_string(path: [i64], above_root: bool) -> [i64] {
    var res: [i64] = []
    var last_len = 0
    var last = 0 - 1
    var dots = 0
    var code = 0
    for i in 0..(path.len() + 1) {
        if i < path.len() {
            code = path[i]
        } else if code == 47 {
            break
        } else {
            code = 47
        }
        if code == 47 {
            if last == i - 1 or dots == 1 {
                // An empty segment or `.`: nothing.
            } else if dots == 2 {
                let n = res.len()
                if n < 2 or last_len != 2 or res[n - 1] != 46 or res[n - 2] != 46 {
                    if n > 2 {
                        let cut = n - last_len - 1
                        if cut == 0 - 1 {
                            res = []
                            last_len = 0
                        } else {
                            res = res.slice(0, cut)
                            last_len = res.len() - 1 - last_slash(res)
                        }
                        last = i
                        dots = 0
                        continue
                    } else if n != 0 {
                        res = []
                        last_len = 0
                        last = i
                        dots = 0
                        continue
                    }
                }
                if above_root {
                    res = if res.len() > 0 { res + [47, 46, 46] } else { [46, 46] }
                    last_len = 2
                }
            } else {
                let seg = path.slice(last + 1, i)
                res = if res.len() > 0 { res + [47] + seg } else { seg }
                last_len = i - last - 1
            }
            last = i
            dots = 0
        } else if code == 46 and dots != 0 - 1 {
            dots = dots + 1
        } else {
            dots = 0 - 1
        }
    }
    return res
}

fn normalize_units(p: [i64]) -> [i64] {
    if p.len() == 0 {
        return [46]
    }
    let absolute = p[0] == 47
    let trailing = p[p.len() - 1] == 47
    var out = normalize_string(p, not absolute)
    if out.len() == 0 {
        return if absolute { [47] } else if trailing { [46, 47] } else { [46] }
    }
    if trailing {
        out.push(47)
    }
    return if absolute { [47] + out } else { out }
}

/// `path.posix.normalize(p)`.
pub fn normalize(p: str) -> str {
    return text(normalize_units(units(p)))
}

/// `path.posix.isAbsolute(p)`.
pub fn is_absolute(p: str) -> bool {
    return p.starts_with("/")
}

/// `path.posix.join(...parts)`.
pub fn join(parts: [str]) -> str {
    let kept = parts.filter(|p| p.len() > 0)
    if kept.len() == 0 {
        return "."
    }
    return normalize(kept.join("/"))
}

fn resolve_units(cwd: [i64], args: [[i64]]) -> [i64] {
    if args.len() == 0 or (args.len() == 1 and (args[0].len() == 0 or args[0] == [46])) {
        if cwd.len() > 0 and cwd[0] == 47 {
            return cwd
        }
    }
    var resolved: [i64] = []
    var absolute = false
    var i = args.len() - 1
    while i >= 0 and not absolute {
        let p = args[i]
        if p.len() > 0 {
            resolved = p + [47] + resolved
            absolute = p[0] == 47
        }
        i = i - 1
    }
    if not absolute {
        resolved = cwd + [47] + resolved
        absolute = cwd.len() > 0 and cwd[0] == 47
    }
    let out = normalize_string(resolved, not absolute)
    if absolute {
        return [47] + out
    }
    return if out.len() > 0 { out } else { [46] }
}

/// `path.posix.resolve(...parts)` with `process.cwd()` being `cwd`.
pub fn resolve(cwd: str, parts: [str]) -> str {
    return text(resolve_units(units(cwd), parts.map(|p| units(p))))
}

/// `path.posix.relative(from, to)` with `process.cwd()` being `cwd`.
pub fn relative(cwd: str, from_text: str, to_text: str) -> str {
    if from_text == to_text {
        return ""
    }
    let from = resolve_units(units(cwd), [units(from_text)])
    let to = resolve_units(units(cwd), [units(to_text)])
    if from == to {
        return ""
    }
    let from_len = from.len() - 1
    let to_len = to.len() - 1
    let length = if from_len < to_len { from_len } else { to_len }
    var common = 0 - 1
    var i = 0
    while i < length {
        let c = from[1 + i]
        if c != to[1 + i] {
            break
        } else if c == 47 {
            common = i
        }
        i = i + 1
    }
    if i == length {
        if to_len > length {
            if to[1 + i] == 47 {
                return text(to.slice(2 + i, to.len()))
            }
            if i == 0 {
                return text(to.slice(1 + i, to.len()))
            }
        } else if from_len > length {
            if from[1 + i] == 47 {
                common = i
            } else if i == 0 {
                common = 0
            }
        }
    }
    var out: [i64] = []
    for k in (2 + common)..(from.len() + 1) {
        if k == from.len() or from[k] == 47 {
            out = out + if out.len() == 0 { [46, 46] } else { [47, 46, 46] }
        }
    }
    return text(out + to.slice(1 + common, to.len()))
}

/// `path.posix.dirname(p)`.
pub fn dirname(p: str) -> str {
    let path = units(p)
    if path.len() == 0 {
        return "."
    }
    let root = path[0] == 47
    var end = 0 - 1
    var matched = true
    var i = path.len() - 1
    while i >= 1 {
        if path[i] == 47 {
            if not matched {
                end = i
                break
            }
        } else {
            matched = false
        }
        i = i - 1
    }
    if end == 0 - 1 {
        return if root { "/" } else { "." }
    }
    if root and end == 1 {
        return "//"
    }
    return text(path.slice(0, end))
}

/// `path.posix.basename(p, suffix)`.
pub fn basename(p: str, suffix: Option[str]) -> str {
    let path = units(p)
    var start = 0
    var end = 0 - 1
    var matched = true
    let sfx = units(suffix ?? "")
    if sfx.len() > 0 and sfx.len() <= path.len() {
        if sfx == path {
            return ""
        }
        var ext = sfx.len() - 1
        var first_end = 0 - 1
        var i = path.len() - 1
        while i >= 0 {
            let code = path[i]
            if code == 47 {
                if not matched {
                    start = i + 1
                    break
                }
            } else {
                if first_end == 0 - 1 {
                    matched = false
                    first_end = i + 1
                }
                if ext >= 0 {
                    if code == sfx[ext] {
                        ext = ext - 1
                        if ext == 0 - 1 {
                            end = i
                        }
                    } else {
                        ext = 0 - 1
                        end = first_end
                    }
                }
            }
            i = i - 1
        }
        if start == end {
            end = first_end
        } else if end == 0 - 1 {
            end = path.len()
        }
        return text(path.slice(start, end))
    }
    var i = path.len() - 1
    while i >= 0 {
        if path[i] == 47 {
            if not matched {
                start = i + 1
                break
            }
        } else if end == 0 - 1 {
            matched = false
            end = i + 1
        }
        i = i - 1
    }
    if end == 0 - 1 {
        return ""
    }
    return text(path.slice(start, end))
}

/// The scan `extname` and `parse` share, from the end back to `stop`:
/// where the last part starts, its last dot, its end, and whether the dot
/// makes an extension.
fn scan_ext(path: [i64], stop: i64) -> (i64, i64, i64, bool) {
    var start_dot = 0 - 1
    var start_part = 0
    var end = 0 - 1
    var matched = true
    var pre_dot = 0
    var i = path.len() - 1
    while i >= stop {
        let c = path[i]
        if c == 47 {
            if not matched {
                start_part = i + 1
                break
            }
            i = i - 1
            continue
        }
        if end == 0 - 1 {
            matched = false
            end = i + 1
        }
        if c == 46 {
            if start_dot == 0 - 1 {
                start_dot = i
            } else if pre_dot != 1 {
                pre_dot = 1
            }
        } else if start_dot != 0 - 1 {
            pre_dot = 0 - 1
        }
        i = i - 1
    }
    let none = start_dot == 0 - 1 or end == 0 - 1 or pre_dot == 0 or (pre_dot == 1 and start_dot == end - 1 and start_dot == start_part + 1)
    return (start_part, start_dot, end, not none)
}

/// `path.posix.extname(p)`.
pub fn extname(p: str) -> str {
    let path = units(p)
    let (_part, dot, end, has) = scan_ext(path, 0)
    return if has { text(path.slice(dot, end)) } else { "" }
}

/// `path.posix.parse(p)`.
pub fn parse(p: str) -> NodePathParts {
    let path = units(p)
    if path.len() == 0 {
        return NodePathParts{ root: "", dir: "", base: "", ext: "", name: "" }
    }
    let absolute = path[0] == 47
    let (part, dot, end, has) = scan_ext(path, if absolute { 1 } else { 0 })
    var base = ""
    var name = ""
    var ext = ""
    if end != 0 - 1 {
        let start = if part == 0 and absolute { 1 } else { part }
        base = text(path.slice(start, end))
        if has {
            name = text(path.slice(start, dot))
            ext = text(path.slice(dot, end))
        } else {
            name = base
        }
    }
    let dir = if part > 0 { text(path.slice(0, part - 1)) } else if absolute { "/" } else { "" }
    return NodePathParts{ root: if absolute { "/" } else { "" }, dir: dir, base: base, ext: ext, name: name }
}

/// `path.posix.format(parts)`.
pub fn format(parts: NodePathParts) -> str {
    let dir = if parts.dir.len() > 0 { parts.dir } else { parts.root }
    let ext = if parts.ext.len() == 0 { "" } else if parts.ext.starts_with(".") { parts.ext } else { "." + parts.ext }
    let base = if parts.base.len() > 0 { parts.base } else { parts.name + ext }
    if dir.len() == 0 {
        return base
    }
    return if dir == parts.root { dir + base } else { dir + "/" + base }
}
