// Lua's `utf8` library, as Lua 5.5 has it: `utf8.char`, `charpattern`,
// `codes`, `codepoint`, `len` and `offset`, strict and lax.
//
// Lua strings are bytes, and Lua code that walks text character by
// character -- editors, game UIs, parsers embedded in C programs -- does
// it with these; a peer has to count and cut the same way:
//
//   - Lua's UTF-8 reaches past Unicode: up to six bytes and 0x7FFFFFFF.
//     Strict mode (the default) refuses surrogates and code points past
//     U+10FFFF; lax mode takes them. Overlong forms are refused in both.
//   - `len` answers the count, or fails with the position of the first
//     bad byte; `codepoint` and `codes` raise "invalid UTF-8 code", and
//     `codes` refuses a character followed by a stray continuation byte.
//   - Positions are 1-based and may count from the end; `offset` answers
//     where the n-th character starts and ends (Lua 5.5), or fails.
//   - Errors are Lua's text: `bad argument #2 to 'utf8.len' (initial
//     position out of bounds)`.

/// The error Lua raises, with its message.
type LuaUtf8Error = | LuaUtf8Error(msg: str)

pub fn error_text(e: LuaUtf8Error) -> str {
    return match e {
        LuaUtf8Error(m) -> m
    }
}

/// What `len` answers: the count, or failure at a position.
type Utf8Len = | Utf8Count(n: i64) | Utf8BadAt(position: i64)

fn arg_error(func: str, arg: i64, msg: str) -> LuaUtf8Error {
    return LuaUtf8Error("bad argument #" + arg.to_str() + " to 'utf8." + func + "' (" + msg + ")")
}

fn invalid() -> LuaUtf8Error {
    return LuaUtf8Error("invalid UTF-8 code")
}

fn at(s: [i64], i: i64) -> i64 {
    return if i >= 0 and i < s.len() { s[i] } else { 0 }
}

fn is_cont(c: i64) -> bool {
    return c.bit_and(192) == 128
}

/// `utf8.charpattern`.
pub fn charpattern() -> bytes {
    return bytes_of([91, 0, 45, 127, 194, 45, 253, 93, 91, 128, 45, 191, 93, 42])
}

/// The bytes of one code point up to 0x7FFFFFFF, as `%U` writes them.
fn encode(x0: i64) -> [i64] {
    if x0 < 128 {
        return [x0]
    }
    var x = x0
    var mfb = 63
    var rev: [i64] = []
    while true {
        rev.push(128 + x.bit_and(63))
        x = x.shr(6)
        mfb = mfb.shr(1)
        if x <= mfb {
            break
        }
    }
    rev.push(mfb.bit_xor(255).shl(1).bit_and(255).bit_or(x))
    var out: [i64] = []
    var k = rev.len() - 1
    while k >= 0 {
        out.push(rev[k])
        k = k - 1
    }
    return out
}

/// `utf8.char(...)`.
pub fn char(codes: [i64]) -> bytes ! LuaUtf8Error {
    var out: [i64] = []
    for k in 0..codes.len() {
        let c = codes[k]
        if c < 0 or c > 2147483647 {
            fail(arg_error("char", k + 1, "value out of range"))
        }
        out = out + encode(c)
    }
    return bytes_of(out)
}

/// utf8_decode at `i`: (code point, next position), or None for an
/// invalid sequence (and, strict, for surrogates and values past
/// U+10FFFF).
fn decode(s: [i64], i: i64, strict: bool) -> Option[(i64, i64)] {
    let limits = [0 - 1, 128, 2048, 65536, 2097152, 67108864]
    var c = at(s, i)
    var res = 0
    var next = i + 1
    if c >= 128 {
        if c >= 254 {
            return None
        }
        var count = 0
        while c.bit_and(64) != 0 {
            count = count + 1
            let cc = at(s, i + count)
            if not is_cont(cc) {
                return None
            }
            res = res.shl(6).bit_or(cc.bit_and(63))
            c = c.shl(1)
        }
        res = res.bit_or(c.bit_and(127).shl(count * 5))
        if res > 2147483647 or count == 0 or res < limits[count] {
            return None
        }
        next = i + count + 1
    } else {
        res = c
    }
    if strict and (res > 1114111 or (res >= 55296 and res <= 57343)) {
        return None
    }
    return Some((res, next))
}

/// u_posrelat.
fn posrelat(pos: i64, len: i64) -> i64 {
    if pos >= 0 {
        return pos
    }
    return if 0 - pos > len { 0 } else { len + pos + 1 }
}

/// `utf8.len(s, i, j, lax)`.
pub fn len(s: bytes, i: i64, j: i64, lax: bool) -> Utf8Len ! LuaUtf8Error {
    let b = s.to_list()
    var posi = posrelat(i, b.len())
    var posj = posrelat(j, b.len())
    if not (1 <= posi and posi - 1 <= b.len()) {
        fail(arg_error("len", 2, "initial position out of bounds"))
    }
    posi = posi - 1
    posj = posj - 1
    if not (posj < b.len()) {
        fail(arg_error("len", 3, "final position out of bounds"))
    }
    var n = 0
    while posi <= posj {
        match decode(b, posi, not lax) {
            Some((_c, next)) -> posi = next
            None -> return Utf8BadAt(posi + 1)
        }
        n = n + 1
    }
    return Utf8Count(n)
}

/// `utf8.codepoint(s, i, j, lax)`; `j` defaults to `i` (made absolute).
pub fn codepoint(s: bytes, i: i64, j: Option[i64], lax: bool) -> [i64] ! LuaUtf8Error {
    let b = s.to_list()
    let posi = posrelat(i, b.len())
    let pose = posrelat(j ?? posi, b.len())
    if posi < 1 {
        fail(arg_error("codepoint", 2, "out of bounds"))
    }
    if pose > b.len() {
        fail(arg_error("codepoint", 3, "out of bounds"))
    }
    var out: [i64] = []
    var p = posi - 1
    while p < pose {
        match decode(b, p, not lax) {
            Some((c, next)) -> {
                out.push(c)
                p = next
            }
            None -> fail(invalid())
        }
    }
    return out
}

/// `for p, c in utf8.codes(s, lax)`: every (position, code point).
pub fn codes(s: bytes, lax: bool) -> [(i64, i64)] ! LuaUtf8Error {
    let b = s.to_list()
    if is_cont(at(b, 0)) {
        fail(arg_error("codes", 1, "invalid UTF-8 code"))
    }
    var out: [(i64, i64)] = []
    var n = 0
    while true {
        if n < b.len() {
            while is_cont(at(b, n)) {
                n = n + 1
            }
        }
        if n >= b.len() {
            return out
        }
        match decode(b, n, not lax) {
            Some((c, next)) -> {
                if is_cont(at(b, next)) {
                    fail(invalid())
                }
                out.push((n + 1, c))
                n = n + 1
            }
            None -> fail(invalid())
        }
    }
    return out
}

/// `utf8.offset(s, n, i)`: where the n-th character from `i` starts and
/// ends, or None.
pub fn offset(s: bytes, n0: i64, i: Option[i64]) -> Option[(i64, i64)] ! LuaUtf8Error {
    let b = s.to_list()
    let len = b.len()
    var n = n0
    var posi = posrelat(i ?? (if n >= 0 { 1 } else { len + 1 }), len)
    if not (1 <= posi and posi - 1 <= len) {
        fail(arg_error("offset", 3, "position out of bounds"))
    }
    posi = posi - 1
    if n == 0 {
        while posi > 0 and is_cont(at(b, posi)) {
            posi = posi - 1
        }
    } else {
        if is_cont(at(b, posi)) {
            fail(LuaUtf8Error("initial position is a continuation byte"))
        }
        if n < 0 {
            while n < 0 and posi > 0 {
                posi = posi - 1
                while posi > 0 and is_cont(at(b, posi)) {
                    posi = posi - 1
                }
                n = n + 1
            }
        } else {
            n = n - 1
            while n > 0 and posi < len {
                posi = posi + 1
                while is_cont(at(b, posi)) {
                    posi = posi + 1
                }
                n = n - 1
            }
        }
    }
    if n != 0 {
        return None
    }
    let start = posi + 1
    if at(b, posi).bit_and(128) != 0 {
        if is_cont(at(b, posi)) {
            fail(LuaUtf8Error("initial position is a continuation byte"))
        }
        while is_cont(at(b, posi + 1)) {
            posi = posi + 1
        }
    }
    return Some((start, posi + 1))
}
