// RIPEMD-160, the 160-bit hash of Dobbertin, Bosselaers and Preneel (1996,
// ISO/IEC 10118-3).
//
// Two parallel lines of five 16-step rounds over each 512-bit block, each
// line with its own word order, rotations, Boolean functions and
// constants, combined at the end; the second line was the designers'
// answer to the attacks that broke RIPEMD and MD4. It is still in daily
// use because Bitcoin addresses are RIPEMD-160 of SHA-256 of a public key
// ("HASH160"), as are Bitcoin script hashes, and OpenPGP v4 and old X.509
// and PGP signatures name it.
//
// The word-order and rotation tables are read from golang.org/x/crypto's
// implementation by scripts/gen_hash_tables.py.
//
// Checked against OpenSSL's RIPEMD160 and HMAC-RIPEMD160.

let M32 = 4294967295

fn rotl(x: i64, n: i64) -> i64 {
    return x.shl(n).bit_or(x.ushr(32 - n)).bit_and(M32)
}

/// Round r's Boolean function, by line: the second line uses them in the
/// reverse order.
fn f(round: i64, x: i64, y: i64, z: i64) -> i64 {
    if round == 0 {
        return x.bit_xor(y).bit_xor(z)
    }
    if round == 1 {
        return x.bit_and(y).bit_or(x.bit_not().bit_and(M32).bit_and(z))
    }
    if round == 2 {
        return x.bit_or(y.bit_not().bit_and(M32)).bit_xor(z)
    }
    if round == 3 {
        return x.bit_and(z).bit_or(y.bit_and(z.bit_not().bit_and(M32)))
    }
    return x.bit_xor(y.bit_or(z.bit_not().bit_and(M32)))
}

pub fn hash(message: bytes) -> bytes {
    let n1 = RIPEMD_N
    let r1 = RIPEMD_R
    let n2 = RIPEMD_N2
    let r2 = RIPEMD_R2
    let k1 = [0, 0x5A827999, 0x6ED9EBA1, 0x8F1BBCDC, 0xA953FD4E]
    let k2 = [0x50A28BE6, 0x5C4DD124, 0x6D703EF3, 0x7A6D76E9, 0]
    var s = RIPEMD_IV
    var data = message.to_list()
    data.push(128)
    while data.len() % 64 != 56 {
        data.push(0)
    }
    let bits = message.len() * 8
    for i in 0..8 {
        data.push(bits.ushr(8 * i).bit_and(255))
    }
    var at = 0
    while at < data.len() {
        var x: [i64] = []
        for i in 0..16 {
            let p = at + 4 * i
            x.push(data[p].bit_or(data[p + 1].shl(8)).bit_or(data[p + 2].shl(16)).bit_or(data[p + 3].shl(24)))
        }
        var a = s[0]
        var b = s[1]
        var c = s[2]
        var d = s[3]
        var e = s[4]
        var aa = a
        var bb = b
        var cc = c
        var dd = d
        var ee = e
        for i in 0..80 {
            let round = i / 16
            let t = (rotl((a + f(round, b, c, d) + x[n1[i]] + k1[round]).bit_and(M32), r1[i]) + e).bit_and(M32)
            a = e
            e = d
            d = rotl(c, 10)
            c = b
            b = t
            let tt = (rotl((aa + f(4 - round, bb, cc, dd) + x[n2[i]] + k2[round]).bit_and(M32), r2[i]) + ee).bit_and(M32)
            aa = ee
            ee = dd
            dd = rotl(cc, 10)
            cc = bb
            bb = tt
        }
        let t = (s[1] + c + dd).bit_and(M32)
        s[1] = (s[2] + d + ee).bit_and(M32)
        s[2] = (s[3] + e + aa).bit_and(M32)
        s[3] = (s[4] + a + bb).bit_and(M32)
        s[4] = (s[0] + b + cc).bit_and(M32)
        s[0] = t
        at = at + 64
    }
    var out: [i64] = []
    for w in s {
        for i in 0..4 {
            out.push(w.ushr(8 * i).bit_and(255))
        }
    }
    return bytes_of(out)
}

