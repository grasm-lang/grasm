// Single-byte code pages: the text that arrived before UTF-8 and never left.
//
// Every byte from 0x80 to 0xFF meant something different depending on which
// country the machine was sold in, and the file never said which. That is the
// whole problem: a code page is not written down anywhere in the data, so
// text encoded in one and read in another produces mojibake — Cyrillic read
// as Greek, an accented e read as a box — and there is no way to detect it
// from the bytes alone with certainty.
//
// This still matters. A ZIP file's member names have no encoding field and
// are conventionally CP437 or the creating machine's ANSI page. A CSV
// exported from Excel on a Western Windows machine is CP1252 and calls itself
// nothing. A DOS-era archive, a `.nfo` file, an old MUD log, an EDI feed, a
// legacy database column: all of them are bytes and a convention.
//
// ## Why CP1252 is not Latin-1, and why it matters
//
// ISO 8859-1 leaves 0x80 to 0x9F as control characters. Windows put printable
// characters there instead: the curly quotes, the em dash, the euro sign.
// Software that labels CP1252 text as Latin-1 — which is most software that
// ever labelled anything — produces text where every curly quote is a control
// character. HTML5 gives up and *specifies* that a document declaring
// ISO-8859-1 must be decoded as CP1252, because that is what the documents
// actually are.
//
// ## The box-drawing pages
//
// CP437 is the IBM PC's own page: the top half is box-drawing characters,
// which is how every DOS program drew a window. CP850 replaced half of them
// with accented letters for Western Europe, which is why a French DOS program
// drew broken boxes on a US machine.
//
// ## Round-tripping
//
// Decoding always succeeds. Most of these pages define all 256 bytes; the
// Windows ones leave a few undefined — CP1250 and CP1252 leave five each,
// CP1255 twenty-three, CP874 thirty-one — and those become U+FFFD, the
// replacement character, rather than an error. That is what a decoder is
// for: text that arrives with a hole in it is still text, and refusing the
// whole file because one byte was never assigned helps nobody.
//
// Encoding is the direction that fails, because a page holds 256 characters
// and Unicode holds rather more. It says which character it could not write
// and where, so a caller can name the character in a message rather than
// saying "encoding failed".
//
// The tables are Python's `codecs` module's, which carry the Unicode
// Consortium's published mappings. All nineteen agree with Python on every
// one of their 256 bytes.

type CodepageError =
    | UnknownPage(name: str)
    | Unencodable(at: i64, codepoint: i64)

/// The pages this knows, by the names people write in configuration files.
pub fn names() -> [str] {
    return ["cp437", "cp850", "cp852", "cp866", "cp1250", "cp1251", "cp1252", "cp1253", "cp1254", "cp1255", "cp1256", "cp1257", "latin1", "latin2", "latin9", "koi8r", "koi8u", "macroman", "cp874"]
}

fn tables() -> [str] {
    return [
        "",
        "",
        "",
        "",
        "",
        "",
        "",
        "",
        "",
        "",
        "",
        "",
        "",
        "",
        "",
        "",
        "",
        "",
        "",
    ]
}

/// Whether a name is one of the pages this knows.
pub fn is_known(name: str) -> bool {
    return index_of(name) >= 0
}

fn index_of(name: str) -> i64 {
    let wanted = normalise(name)
    var i = 0
    for candidate in names() {
        if candidate == wanted {
            return i
        }
        i = i + 1
    }
    return 0 - 1
}

/// A page name as this package spells it.
///
/// `windows-1252`, `Windows 1252`, `CP1252` and `cp_1252` are the same page,
/// and a configuration file will contain all four spellings eventually.
pub fn normalise(name: str) -> str {
    var out = ""
    for code in name.to_lower().codes() {
        // Hyphen, underscore, space and full stop: the four ways a
        // configuration file separates a page's name from its number.
        if code == 45 or code == 95 or code == 32 or code == 46 {
            continue
        }
        out = out + code.to_char()
    }
    if out.starts_with("windows") {
        out = "cp" + out.substr(7, out.len() - 7)
    }
    if out.starts_with("iso8859") {
        out = "latin" + latin_number(out.substr(7, out.len() - 7))
    }
    if out == "ascii" or out == "usascii" {
        return "latin1"
    }
    return out
}

fn latin_number(part: str) -> str {
    // ISO 8859-1 is Latin-1 and 8859-15 is Latin-9, because the numbering ran
    // out of order once Latin-1 had already been named.
    if part == "15" {
        return "9"
    }
    if part == "1" or part == "2" {
        return part
    }
    return part
}

/// The code point a byte stands for in a page.
pub fn decode_byte(page: str, byte: i64) -> i64 ! CodepageError {
    let at = index_of(page)
    if at < 0 {
        fail(UnknownPage(page))
    }
    if byte < 128 {
        return byte
    }
    let hex = tables()[at].substr((byte - 128) * 4, 4)
    return hex.parse_int_base(16) ?? 65533
}

/// Bytes to text.
///
/// Never fails once the page is known. A byte the page leaves undefined
/// becomes U+FFFD; every other byte means something, which is exactly why
/// mojibake is silent — the wrong page still decodes.
pub fn decode(page: str, data: bytes) -> str ! CodepageError {
    let at = index_of(page)
    if at < 0 {
        fail(UnknownPage(page))
    }
    let table = tables()[at]
    var out = ""
    for i in 0..data.len() {
        let byte = data.at(i)
        if byte < 128 {
            out = out + byte.to_char()
            continue
        }
        out = out + (table.substr((byte - 128) * 4, 4).parse_int_base(16) ??
            65533).to_char()
    }
    return out
}

/// Text to bytes, saying which character it could not write and where.
pub fn encode(page: str, text: str) -> bytes ! CodepageError {
    let at = index_of(page)
    if at < 0 {
        fail(UnknownPage(page))
    }
    let table = tables()[at]
    var out: [i64] = []
    var position = 0
    for point in text.codes() {
        if point < 128 {
            out.push(point)
            position = position + 1
            continue
        }
        let byte = reverse_lookup(table, point)
        if byte < 0 {
            fail(Unencodable(position, point))
        }
        out.push(byte)
        position = position + 1
    }
    return bytes_of(out)
}

fn reverse_lookup(table: str, point: i64) -> i64 {
    // U+FFFD is what an undefined byte decodes to, and several bytes may
    // decode to it. Encoding it back would pick one of them arbitrarily and
    // turn a decode-then-encode round trip into a silent corruption, so a
    // replacement character is refused like any other unencodable one.
    if point == 65533 {
        return 0 - 1
    }
    for i in 0..128 {
        if (table.substr(i * 4, 4).parse_int_base(16) ?? 0) == point {
            return i + 128
        }
    }
    return 0 - 1
}

/// Whether every character of a string can be written in a page.
pub fn is_encodable(page: str, text: str) -> bool {
    match encode(page, text) {
        Ok(_v) -> return true
        Err(_e) -> return false
    }
}

/// The first character that cannot be written, or -1.
pub fn unencodable_at(page: str, text: str) -> i64 {
    match encode(page, text) {
        Ok(_v) -> return 0 - 1
        Err(e) -> {
            match e {
                Unencodable(at, _point) -> return at
                UnknownPage(_name) -> return 0 - 1
            }
        }
    }
}

/// The bytes a page leaves as control characters where Windows put
/// printable ones.
///
/// The difference between ISO 8859-1 and CP1252, and the reason a curly quote
/// arrives as a control character so often that HTML5 gave up and specified
/// that a document declaring the former must be read as the latter.
pub fn differs_from_latin1(page: str) -> [i64] {
    var out: [i64] = []
    for byte in 128..256 {
        let mine = decode_byte(page, byte) ?? 0 - 1
        if mine != byte {
            out.push(byte)
        }
    }
    return out
}
