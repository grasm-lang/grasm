/// A 2048-bit public key, and a message with two signatures over it — one
/// PKCS#1 v1.5 and one PSS, both produced by an outside implementation.
fn key_spki_base64() -> str {
    return "MIIBIjANBgkqhkiG9w0BAQEFAAOCAQ8AMIIBCgKCAQEA1Pv28rihidkpG3uzkI10" +
    "GVRojLISPms0ooVdaoye3/Z4iAa/SAaIBseAj1xtDt/ArPanp9bOYpc+cR+hPfZf" +
    "IVh5iRktQJxi0TRcF+4rUBJoX1Ibsta5/1Oj4dB3RMdFUJZX04Rz/76309yMZai5" +
    "/ypny9cuV+BEDifetqUWZkYyd9o6d6fWxkRZU8RNKuA+0Xrw92L4x4Sw090teqce" +
    "hKS76NiI6MHrrP5bo9gX3p77dWQQ8YN6dLgNVUwHz/Cg6zg2qrjaXfNYtHcqNuFw" +
    "CiD/FWoUcWnt1byYtMFfb2u56P+2SJ2c6ewQDuVNwcxrASOIpnKu5qaxqGJwEXiN" +
    "YwIDAQAB"
}

fn signed_message() -> str {
    return "the message that was signed\n"
}

