// The half of TLS that is not cryptography, and the half that is.
//
// `docs/ecosystem-roadmap.md` names a TLS client as the thing blocking about
// 120 packages, and lists what was missing: chain building and a trust store,
// RSA signature verification, hostname verification, expiry checks. This is
// those four, and every certificate below was produced by an outside
// implementation rather than by anything here.
//
// What is still missing is the handshake over a socket, which cannot be
// asserted against without a server to talk to. The parts that *can* be
// checked offline are checked offline, exactly.
import rsa
import pemfile
import hostmatch
import certchain

fn say(inout f: i64, name: str, held: bool) / {io} {
    if held {
        print("  ok    {name}")
    } else {
        print("  FAIL  {name}")
        f = f + 1
    }
}

