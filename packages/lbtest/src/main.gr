// The client end of the `linebreak_diff.sh` gate: code points in, the
// offsets a line may be broken before out.
import linebreak

fn main() / {io} {
    var i = 0
    while i < args().len() {
        var codes: [i64] = []
        for piece in args()[i].split(",") {
            if piece.len() > 0 {
                codes.push(piece.parse_int_base(16) ?? 0)
            }
        }
        var out = ""
        var first = true
        for mark in linebreak.boundaries_of(codes) {
            if not first {
                out = out + ","
            }
            first = false
            out = out + "{mark}"
        }
        print(out)
        i = i + 1
    }
}
