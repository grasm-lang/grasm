// Whirlpool, the 512-bit hash of Barreto and Rijmen (ISO/IEC 10118-3).
//
// A block cipher W built like AES on an 8x8 byte state -- an S-box on each
// byte, each column rotated down by its index, each row multiplied by a
// circulant MDS matrix over GF(2^8), a round key added -- with ten rounds
// and its own key schedule, run in the Miyaguchi-Preneel construction: each
// 512-bit block is encrypted under the chaining value, and the block and
// the chaining value are XORed into the result. Messages are padded to an
// odd number of 256-bit halves and end with their length in 256 bits.
//
// Whirlpool is NESSIE's hash and in ISO/IEC 10118-3; VeraCrypt and
// TrueCrypt derive header keys with it, and FreeOTFE, GnuPG and old
// archive tools offer it.
//
// The S-box is found in OpenSSL's libcrypto by scripts/gen_hash_tables.py
// and checked there against a model of the whole hash. The round constants
// are the S-box's own first 80 entries.
//
// Checked against OpenSSL's WHIRLPOOL.

/// Products of every byte with a constant in GF(2^8) mod x^8+x^4+x^3+x^2+1.
fn times(c: i64) -> [i64] {
    var out: [i64] = []
    for x in 0..256 {
        var a = x
        var b = c
        var r = 0
        while b > 0 {
            if b % 2 == 1 {
                r = r.bit_xor(a)
            }
            a = a.shl(1)
            if a >= 256 {
                a = a.bit_xor(285)
            }
            b = b / 2
        }
        out.push(r)
    }
    return out
}

type WhirlpoolTables = { sbox: [i64], mul: [[i64]] }

/// One round: substitute, rotate columns, mix rows, add the key.
fn rho(t: WhirlpoolTables, a: [i64], k: [i64]) -> [i64] {
    // The circulant row (1, 1, 4, 1, 8, 5, 2, 9), as indices into t.mul.
    let row = [0, 0, 1, 0, 2, 3, 4, 5]
    var p: [i64] = []
    for i in 0..8 {
        for j in 0..8 {
            p.push(t.sbox[a[8 * ((i - j + 8) % 8) + j]])
        }
    }
    var out: [i64] = []
    for i in 0..8 {
        for j in 0..8 {
            var v = 0
            for q in 0..8 {
                v = v.bit_xor(t.mul[row[(j - q + 8) % 8]][p[8 * i + q]])
            }
            out.push(v.bit_xor(k[8 * i + j]))
        }
    }
    return out
}

fn cipher(t: WhirlpoolTables, key: [i64], block: [i64]) -> [i64] {
    var k = key
    var s: [i64] = []
    for i in 0..64 {
        s.push(block[i].bit_xor(k[i]))
    }
    for r in 1..11 {
        var rc: [i64] = []
        for j in 0..64 {
            rc.push(if j < 8 { t.sbox[8 * (r - 1) + j] } else { 0 })
        }
        k = rho(t, k, rc)
        s = rho(t, s, k)
    }
    return s
}

pub fn hash(message: bytes) -> bytes {
    let t = WhirlpoolTables{ sbox: WHIRLPOOL_SBOX, mul: [times(1), times(4), times(8), times(5), times(2), times(9)] }
    var data = message.to_list()
    data.push(128)
    while data.len() % 64 != 32 {
        data.push(0)
    }
    // The length in bits as a 256-bit big-endian number.
    let bits = message.len() * 8
    for i in 0..32 {
        data.push(if i < 24 { 0 } else { bits.ushr(8 * (31 - i)).bit_and(255) })
    }
    var h: [i64] = []
    for _i in 0..64 {
        h.push(0)
    }
    var at = 0
    while at < data.len() {
        let m = data.slice(at, at + 64)
        let w = cipher(t, h, m)
        var next: [i64] = []
        for i in 0..64 {
            next.push(w[i].bit_xor(h[i]).bit_xor(m[i]))
        }
        h = next
        at = at + 64
    }
    return bytes_of(h)
}

