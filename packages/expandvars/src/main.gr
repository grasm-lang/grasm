// `$HOME/bin` and `~/.config`, expanded the way a POSIX path is.
//
// Configuration files write paths with variables in them, and a program that
// reads one has to expand them the same way the shell, Python and every
// other tool would — or a path that works in a terminal fails in the
// program. This is not a shell. It does not run anything, it does not do
// `$(...)` or arithmetic or defaults like `${X:-y}`, and that restraint is
// the point: expanding a path from a config file must never execute it.
//
// What it does, following `os.path.expandvars` and `expanduser`:
//
//   - `$NAME` and `${NAME}`, where a name is letters, digits and
//     underscores. A digit may start one: `$1` looks up a variable called
//     `1`, which does not exist, so it is left alone.
//   - A variable that is not set is left exactly as written. Not replaced
//     with nothing — `rm -rf $UNSET/` becoming `rm -rf /` is the reason.
//   - `~` and `~/...` at the very start become the home directory; `~user`
//     becomes that user's, when the caller can say what it is. A `~`
//     anywhere else is just a character.
//
// Nothing here reads the environment or the password database. The caller
// hands them in, so the same expansion runs against a process's own
// environment, a container's, or a test's.
//
// Checked against Python's `posixpath.expandvars` and `expanduser`.

fn is_name_char(c: str) -> bool {
    return (c >= "a" and c <= "z") or (c >= "A" and c <= "Z") or
    (c >= "0" and c <= "9") or c == "_"
}

fn lookup(names: [str], values: [str], name: str) -> Option[str] {
    var i = 0
    while i < names.len() {
        if names[i] == name {
            return Some(values[i])
        }
        i = i + 1
    }
    return None
}

/// `$NAME` and `${NAME}` replaced from the given variables, and every
/// reference to a variable that is not set left as written.
pub fn expand_vars(text: str, names: [str], values: [str]) -> str {
    if (text.index_of("$") ?? -1) < 0 {
        return text
    }
    var out = ""
    var i = 0
    while i < text.len() {
        let c = text.substr(i, 1)
        if c != "$" or i + 1 >= text.len() {
            out = out + c
            i = i + 1
            continue
        }
        let next = text.substr(i + 1, 1)
        if next == "\{" {
            let close = find_from(text, "\}", i + 2)
            if close < 0 {
                out = out + c
                i = i + 1
                continue
            }
            let name = text.substr(i + 2, close - i - 2)
            match lookup(names, values, name) {
                Some(value) -> out = out + value
                None -> out = out + text.substr(i, close - i + 1)
            }
            i = close + 1
            continue
        }
        if not is_name_char(next) {
            out = out + c
            i = i + 1
            continue
        }
        var end = i + 1
        while end < text.len() and is_name_char(text.substr(end, 1)) {
            end = end + 1
        }
        let name = text.substr(i + 1, end - i - 1)
        match lookup(names, values, name) {
            Some(value) -> out = out + value
            None -> out = out + text.substr(i, end - i)
        }
        i = end
    }
    return out
}

fn find_from(text: str, needle: str, from: i64) -> i64 {
    var i = from
    while i < text.len() {
        if text.substr(i, 1) == needle {
            return i
        }
        i = i + 1
    }
    return 0 - 1
}

/// A leading `~` or `~user` replaced with a home directory.
///
/// `home` is the current user's; `user_homes` names other users' and may be
/// empty, in which case `~someone` is left alone. A trailing slash on the
/// home directory is not doubled.
pub fn expand_user(text: str, home: str, user_names: [str],
    user_homes: [str]) -> str {
    if not text.starts_with("~") {
        return text
    }
    var end = 1
    while end < text.len() and text.substr(end, 1) != "/" {
        end = end + 1
    }
    let who = text.substr(1, end - 1)
    var base = ""
    if who.len() == 0 {
        base = home
    } else {
        match lookup(user_names, user_homes, who) {
            Some(value) -> base = value
            None -> return text
        }
    }
    // Every trailing slash comes off, so a home of `/home/u/` does not give
    // `//`, and a home of `/` becomes nothing — which the rest of the path
    // then supplies, or the fallback below does.
    while base.ends_with("/") {
        base = base.substr(0, base.len() - 1)
    }
    let rest = text.substr(end, text.len() - end)
    let expanded = base + rest
    if expanded.len() == 0 {
        return "/"
    }
    return expanded
}

/// Both, in the order a shell would do them: the user's home first, then
/// the variables.
pub fn expand(text: str, home: str, names: [str], values: [str]) -> str {
    return expand_vars(expand_user(text, home, [], []), names, values)
}

/// The names a string refers to, set or not, in order.
pub fn references(text: str) -> [str] {
    var out: [str] = []
    var i = 0
    while i < text.len() {
        if text.substr(i, 1) != "$" or i + 1 >= text.len() {
            i = i + 1
            continue
        }
        let next = text.substr(i + 1, 1)
        if next == "\{" {
            let close = find_from(text, "\}", i + 2)
            if close < 0 {
                i = i + 1
                continue
            }
            out.push(text.substr(i + 2, close - i - 2))
            i = close + 1
            continue
        }
        var end = i + 1
        while end < text.len() and is_name_char(text.substr(end, 1)) {
            end = end + 1
        }
        if end > i + 1 {
            out.push(text.substr(i + 1, end - i - 1))
        }
        i = if end > i + 1 { end } else { i + 1 }
    }
    return out
}
