// Every command is `<name> <hex argument> <hex argument>`, three words, so
// one process answers a corpus of any size.
import cformat
import configparser
import pytokenize
import querystring
import shlex

fn from_hex_bytes(text: str) -> bytes {
    var out: [i64] = []
    var i = 1
    while i + 1 < text.len() {
        out.push(text.substr(i, 2).parse_int_base(16) ?? 0)
        i = i + 2
    }
    return bytes_of(out)
}

fn hex(raw: bytes) -> str {
    let digits = "0123456789abcdef"
    var out = ""
    var i = 0
    while i < raw.len() {
        out = out + digits.substr(raw.at(i) / 16, 1) +
        digits.substr(raw.at(i) % 16, 1)
        i = i + 1
    }
    return out
}

fn th(text: str) -> str {
    return hex(text.to_bytes())
}

fn parts(text: str) -> [str] {
    if text.len() == 0 {
        return []
    }
    return text.split("\u{1}")
}

fn run_shlex(what: str, a: str) -> str {
    if what == "sq" {
        return th(shlex.quote(a))
    }
    if what == "sj" {
        return th(shlex.join(parts(a)))
    }
    let comments = what == "ssc"
    return th(match shlex.split(a, comments) {
        Ok(words) -> words.join("\u{1}")
        Err(e) -> "?" + shlex.message_of(e)
    })
}

fn run_query(what: str, a: str) -> str {
    if what == "qesc" {
        return th(querystring.escape(a))
    }
    if what == "qune" {
        return th(querystring.unescape(a))
    }
    let pairs = querystring.parse(a)
    if what == "qstr" {
        return th(querystring.stringify(pairs))
    }
    var out: [str] = []
    for pair in pairs {
        out.push(pair.key + "=" + pair.values.join(","))
    }
    return th(out.join("\u{1}"))
}

/// A format and its arguments: each argument is `i:`, `f:` or `s:` so the
/// kind is the corpus's decision rather than a guess from the text.
fn run_cformat(template: str, given: str) -> str {
    var args: [Arg] = []
    for piece in parts(given) {
        let kind = piece.substr(0, 2)
        let rest = piece.substr(2, piece.len() - 2)
        if kind == "i:" {
            args.push(Int(rest.parse_int() ?? 0))
        } else if kind == "f:" {
            args.push(Float((rest.parse_int() ?? 0).from_bits()))
        } else {
            args.push(Text(rest))
        }
    }
    return th(match cformat.format(template, args) {
        Ok(text) -> text
        Err(e) -> "?" + cformat.message_of(e)
    })
}

fn run_config(what: str, a: str, b: str) -> str {
    let extended = what.ends_with("x")
    let config = match configparser.read(a, true, extended) {
        Ok(c) -> c
        Err(e) -> return th("?" + configparser.message_of(e))
    }
    if what.starts_with("cget") {
        let cut = b.index_of("\u{1}") ?? 0
        let section = b.substr(0, cut)
        let key = b.substr(cut + 1, b.len() - cut - 1)
        return th(match configparser.get(config, section, key) {
            Ok(v) -> v
            Err(e) -> "?" + configparser.message_of(e)
        })
    }
    if what.starts_with("ckeys") {
        return th(configparser.keys(config, b).join("\u{1}"))
    }
    return th(configparser.sections(config).join("\u{1}"))
}

fn run_tokenize(a: str) -> str {
    return th(match pytokenize.tokenize(a) {
        Ok(tokens) -> pytokenize.describe(tokens)
        Err(e) -> "?" + pytokenize.message_of(e)
    })
}

fn main() / {io} {
    var i = 0
    while i + 2 < args().len() {
        let what = args()[i]
        let a = from_hex_bytes(args()[i + 1]).to_str()
        let b = from_hex_bytes(args()[i + 2]).to_str()
        if what.starts_with("s") {
            print(run_shlex(what, a))
        } else if what.starts_with("q") {
            print(run_query(what, a))
        } else if what.starts_with("f") {
            print(run_cformat(a, b))
        } else if what.starts_with("c") {
            print(run_config(what, a, b))
        } else {
            print(run_tokenize(a))
        }
        i = i + 3
    }
}
