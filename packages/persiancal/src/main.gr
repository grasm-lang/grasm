// The Persian (Solar Hijri) calendar: Iran's and Afghanistan's official
// calendar.
//
// Years count from the Hijra, 622, but run with the sun: the year starts
// at the March equinox (1 Farvardin, Nowruz); six months of 31 days, five
// of 30, and Esfand with 29, or 30 in a leap year. The official calendar
// fixes Nowruz by observation; this is ICU's arithmetic approximation of
// it -- a leap year when (25 y + 11) mod 33 < 8 -- which agrees with it for
// many centuries around now and is what ICU, Java and Python's libraries
// compute.

type PersianDate = {
    year: i64,
    month: i64,
    day: i64,
}

fn floor_div(a: i64, b: i64) -> i64 {
    let q = a / b
    if a % b != 0 and ((a < 0) != (b < 0)) { q - 1 } else { q }
}

/// 1 Farvardin 1 AP as a Julian Day.
fn epoch() -> i64 {
    1948320
}

fn cumulative() -> [i64] {
    [0, 31, 62, 93, 124, 155, 186, 216, 246, 276, 306, 336]
}

pub fn is_leap_year(year: i64) -> bool {
    let r = (25 * year + 11) % 33
    (if r < 0 { r + 33 } else { r }) < 8
}

pub fn from_unix_day(d: i64) -> PersianDate {
    let since = d + 2440588 - epoch()
    let year = 1 + floor_div(33 * since + 3, 12053)
    let farvardin1 = 365 * (year - 1) + floor_div(8 * year + 21, 33)
    let doy = since - farvardin1
    let month = if doy < 216 { doy / 31 } else { (doy - 6) / 30 }
    PersianDate{ year: year, month: month + 1, day: doy - cumulative()[month] + 1 }
}

pub fn to_unix_day(p: PersianDate) -> i64 {
    epoch() - 2440588 + 365 * (p.year - 1) + floor_div(8 * p.year + 21, 33) + cumulative()[p.month - 1] + p.day - 1
}
