// Dense matrices of f64, stored row-major in one flat list.
//
// Row-major and flat rather than a list of lists: a list of lists is a pointer
// chase per row and allocates once per row, and the multiply below touches
// every element of both operands. One contiguous run is the difference between
// a cache hit and a miss on every access.

type Mat = {
    rows: i64,
    cols: i64,
    cell: [f64],
}

type MatError =
    | ShapeMismatch(a: str, b: str)
    | NotSquare(n: i64)
    | Singular

pub fn zeros(rows: i64, cols: i64) -> Mat {
    var c: [f64] = []
    for _i in 0..(rows * cols) {
        c.push(0.0)
    }
    return Mat{ rows: rows, cols: cols, cell: c }
}

pub fn identity(n: i64) -> Mat {
    var m = zeros(n, n)
    for i in 0..n {
        m.cell[i * n + i] = 1.0
    }
    return m
}

pub fn of(rows: i64, cols: i64, cells: [f64]) -> Mat {
    return Mat{ rows: rows, cols: cols, cell: cells }
}

pub fn at(m: Mat, r: i64, c: i64) -> f64 {
    return m.cell[r * m.cols + c]
}

pub fn set(inout m: Mat, r: i64, c: i64, v: f64) {
    m.cell[r * m.cols + c] = v
}

pub fn shape(m: Mat) -> str {
    return "{m.rows}x{m.cols}"
}

pub fn add(a: Mat, b: Mat) -> Mat ! MatError {
    if a.rows != b.rows or a.cols != b.cols {
        fail(ShapeMismatch(shape(a), shape(b)))
    }
    var out = zeros(a.rows, a.cols)
    for i in 0..a.cell.len() {
        out.cell[i] = a.cell[i] + b.cell[i]
    }
    return out
}

pub fn scale(m: Mat, k: f64) -> Mat {
    var out = zeros(m.rows, m.cols)
    for i in 0..m.cell.len() {
        out.cell[i] = m.cell[i] * k
    }
    return out
}

pub fn multiply(a: Mat, b: Mat) -> Mat ! MatError {
    if a.cols != b.rows {
        fail(ShapeMismatch(shape(a), shape(b)))
    }
    var out = zeros(a.rows, b.cols)
    for i in 0..a.rows {
        for k in 0..a.cols {
            let av = a.cell[i * a.cols + k]
            if av != 0.0 {
                for j in 0..b.cols {
                    out.cell[i * b.cols + j] = out.cell[i * b.cols + j] +
                    av * b.cell[k * b.cols + j]
                }
            }
        }
    }
    return out
}

pub fn transpose(m: Mat) -> Mat {
    var out = zeros(m.cols, m.rows)
    for i in 0..m.rows {
        for j in 0..m.cols {
            out.cell[j * m.rows + i] = m.cell[i * m.cols + j]
        }
    }
    return out
}

/// The determinant, by elimination rather than by cofactors.
///
/// Cofactor expansion is O(n!) and the textbook way to write it; elimination
/// is O(n^3) and the only one that finishes on anything real.
pub fn determinant(m: Mat) -> f64 ! MatError {
    if m.rows != m.cols {
        fail(NotSquare(m.rows))
    }
    let n = m.rows
    var work = m
    var det = 1.0
    for col in 0..n {
        var pivot = 0 - 1
        var r = col
        while r < n and pivot < 0 {
            if abs_of(work.cell[r * n + col]) > 0.000000001 {
                pivot = r
            }
            r = r + 1
        }
        if pivot < 0 {
            return 0.0
        }
        if pivot != col {
            for j in 0..n {
                let t = work.cell[col * n + j]
                work.cell[col * n + j] = work.cell[pivot * n + j]
                work.cell[pivot * n + j] = t
            }
            det = 0.0 - det
        }
        let p = work.cell[col * n + col]
        det = det * p
        for r in (col + 1)..n {
            let factor = work.cell[r * n + col] / p
            for j in col..n {
                work.cell[r * n + j] = work.cell[r * n + j] - factor * work.cell[col * n + j]
            }
        }
    }
    return det
}

fn abs_of(v: f64) -> f64 {
    if v < 0.0 {
        return 0.0 - v
    }
    return v
}
