type SaslError =
    | SaslProhibited(code: i64)
    | SaslUnassigned(code: i64)
    | SaslBidi(why: str)

let SPACE: [i64] = load(table_space())
let DELETE: [i64] = load(table_delete())
let PROHIBITED: [i64] = load(table_prohibited())
let UNASSIGNED: [i64] = load(table_unassigned())
let RTL: [i64] = load(table_rtl())
let LTR: [i64] = load(table_ltr())

fn load(packed: str) -> [i64] {
    var out: [i64] = []
    for entry in packed.split(" ") {
        if entry.len() == 0 {
            continue
        }
        let cut = entry.index_of("-") ?? -1
        if cut < 0 {
            continue
        }
        out.push(entry.substr(0, cut).parse_int_base(16) ?? 0)
        out.push(entry.substr(cut + 1, entry.len() - cut - 1)
                .parse_int_base(16) ?? 0)
    }
    return out
}

fn in_ranges(ranges: [i64], code: i64) -> bool {
    var low = 0
    var high = ranges.len() / 2 - 1
    while low <= high {
        let middle = (low + high) / 2
        if code < ranges[middle * 2] {
            high = middle - 1
        } else if code > ranges[middle * 2 + 1] {
            low = middle + 1
        } else {
            return true
        }
    }
    return false
}

/// A password or username prepared for hashing or comparison.
///
/// `stored` says whether this is a value being written down — which may not
/// contain an unassigned code point — or one being checked against a stored
/// value, which may.
pub fn prepare(text: str, stored: bool) -> str ! SaslError {
    var mapped = ""
    for code in text.codes() {
        if in_ranges(DELETE, code) {
            continue
        }
        if in_ranges(SPACE, code) {
            // Every kind of space becomes the ordinary one, so a password
            // typed with a non-breaking space still matches.
            mapped = mapped + " "
            continue
        }
        mapped = mapped + code.to_char()
    }
    let normalised = unicodenorm.nfkc(mapped)
    var any_rtl = false
    var any_ltr = false
    for code in normalised.codes() {
        // ASCII control characters are prohibited here where nameprep
        // leaves them alone.
        if code < 32 or code == 127 {
            fail(SaslProhibited(code))
        }
        if in_ranges(PROHIBITED, code) {
            fail(SaslProhibited(code))
        }
        if stored and in_ranges(UNASSIGNED, code) {
            fail(SaslUnassigned(code))
        }
        if in_ranges(RTL, code) {
            any_rtl = true
        }
        if in_ranges(LTR, code) {
            any_ltr = true
        }
    }
    if any_rtl {
        if any_ltr {
            fail(SaslBidi("a string mixes directions"))
        }
        let codes = normalised.codes()
        if codes.len() > 0 and (not in_ranges(RTL, codes[0]) or
            not in_ranges(RTL, codes[codes.len() - 1])) {
            fail(SaslBidi("a right-to-left string must begin and end so"))
        }
    }
    return normalised
}

/// A password, which is a query string: unassigned code points are allowed
/// so that one stored before a Unicode update still verifies after it.
pub fn password(text: str) -> str ! SaslError {
    return try prepare(text, false)
}

/// A username, which is stored and therefore may not carry an unassigned
/// code point.
pub fn username(text: str) -> str ! SaslError {
    return try prepare(text, true)
}

/// Whether `text` survives preparation at all.
pub fn is_preparable(text: str, stored: bool) -> bool {
    match prepare(text, stored) {
        Ok(_result) -> return true
        Err(_e) -> return false
    }
}

/// Whether two strings are the same password once prepared, which is the
/// comparison a server actually wants.
pub fn same(a: str, b: str) -> bool {
    match prepare(a, false) {
        Ok(left) -> {
            match prepare(b, false) {
                Ok(right) -> return left == right
                Err(_e) -> return false
            }
        }
        Err(_e) -> return false
    }
}
