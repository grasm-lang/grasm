import netrc

fn from_hex(text: str) -> str {
    var out: [i64] = []
    var i = 0
    while i + 1 < text.len() {
        out.push(text.substr(i, 2).parse_int_base(16) ?? 0)
        i = i + 2
    }
    return bytes_of(out).to_str()
}

fn to_hex(text: str) -> str {
    let digits = "0123456789abcdef"
    let raw = text.to_bytes()
    var out = ""
    var i = 0
    while i < raw.len() {
        out = out + digits.substr(raw.at(i) / 16, 1) +
        digits.substr(raw.at(i) % 16, 1)
        i = i + 1
    }
    return out
}

fn main() / {io} {
    var i = 0
    while i < args().len() {
        var out = ""
        for entry in netrc.parse(from_hex(args()[i])) {
            var name = entry.machine
            if entry.is_default {
                name = "default"
            }
            out = out + name + "\u{2}" + entry.login + "\u{2}" +
            entry.account + "\u{2}" + entry.password + "\u{1}"
        }
        print(to_hex(out))
        i = i + 1
    }
}
