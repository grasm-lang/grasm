// An image editor's shell: a photograph, a layer list, and live adjustments.
//
// Seven packages, no new builtin, and nothing retained between frames except
// the four values the palette is editing -- which is the whole argument for
// immediate mode in a language with no mutable globals.
//
//     pcedit <file.jpg> [frames]
//
// `SDL_VIDEODRIVER=dummy` runs it with no display.
import jpeg
import pcframe
import pcfont
import pcui
import sdl
import sdlevent

let PALETTE = 150

/// Brightness and contrast over a byte, the way an adjustment layer does it.
fn adjust(src: bytes, inout dst: bytes, bright: i64, contrast: i64, mono: bool) {
    let n = src.len()
    var i = 0
    while i + 2 < n {
        var sum = 0
        var k = 0
        while k < 3 {
            var v = src.at(i + k)
            v = (v - 128) * contrast / 100 + 128 + bright
            if v < 0 {
                v = 0
            }
            if v > 255 {
                v = 255
            }
            dst.set(i + k, v)
            sum = sum + v
            k = k + 1
        }
        if mono {
            let g = sum / 3
            dst.set(i, g)
            dst.set(i + 1, g)
            dst.set(i + 2, g)
        }
        dst.set(i + 3, 255)
        i = i + 4
    }
}

/// Fill an `Input` from everything SDL has queued this frame.
fn gather(inout ev: bytes, inout mx: i64, inout my: i64, inout down: bool,
    inout pressed: bool, inout quit: bool) / {io, unsafe} {
    pressed = false
    while sdl.poll_event(ev) {
        let e = sdlevent.decode(ev)
        match e {
            Quit -> quit = true
            KeyDown(sym) -> {
                if sym == 27 {
                    quit = true
                }
            }
            MouseMotion(x, y) -> {
                mx = x
                my = y
            }
            MouseDown(_b, x, y) -> {
                mx = x
                my = y
                down = true
                pressed = true
            }
            MouseUp(_b, x, y) -> {
                mx = x
                my = y
                down = false
            }
            _ -> {}
        }
    }
}

/// Everything the palette edits, in one value so it can be threaded.
///
/// Immediate mode keeps no widget, so this is the only thing that crosses a
/// frame -- which is what makes a session replayable: the whole UI is a
/// function of these five numbers and this frame's input.
type Edits = {
    layer: i64,
    bright: i64,
    contrast: i64,
    mono: bool,
    quit: bool,
}

/// Draw the palette and take this frame's changes.
fn palette(inout ui: Ui, inout e: Edits, img_w: i64, win_h: i64) {
    pcui.panel(ui, PcRect{ x: img_w, y: 0, w: PALETTE, h: win_h })
    pcui.stack(ui, img_w + 10, 10, PALETTE - 20)

    let _t = pcui.label(ui, img_w + 10, 0, 24, "LAYERS")
    pcui.space(ui, 18)
    var n = 0
    while n < 3 {
        if pcui.list_item(ui, pcui.row(ui, 20), "Layer", e.layer == n) {
            e.layer = n
        }
        n = n + 1
    }
    pcui.space(ui, 10)
    let _b = pcui.label(ui, img_w + 10, pcui.row(ui, 0).y, 16, "BRIGHT")
    e.bright = pcui.slider(ui, pcui.row(ui, 20), e.bright, 0 - 100, 100)
    let _c = pcui.label(ui, img_w + 10, pcui.row(ui, 0).y, 16, "CONTRAST")
    e.contrast = pcui.slider(ui, pcui.row(ui, 20), e.contrast, 10, 300)
    e.mono = pcui.checkbox(ui, pcui.row(ui, 20), "MONO", e.mono)
    pcui.space(ui, 10)
    if pcui.button(ui, pcui.row(ui, 24), "RESET") {
        e.bright = 0
        e.contrast = 100
        e.mono = false
    }
    if pcui.button(ui, pcui.row(ui, 24), "QUIT") {
        e.quit = true
    }
}

fn main() -> () ! (JpegPixelError | SdlError | SfntError | MetricsError) / {io, unsafe} {
    let a = args()
    let img_path = a.get(0) ?? ""
    let font_path = a.get(1) ?? "scripts/fixtures/font/shapes.ttf"
    let limit = match a.get(2) {
        Some(n) -> n.parse_int() ?? 0
        None -> 0
    }

    let img = try jpeg.decode(read_bytes(img_path) ?? bytes_of([]))
    let base = if img.comps == 1 {
        pcframe.from_gray(img.pixels, img.width, img.height)
    } else {
        pcframe.from_rgb(img.pixels, img.width, img.height)
    }
    let font = try pcfont.load(read_bytes(font_path) ?? bytes_of([]))

    let win_w = img.width + PALETTE
    let win_h = img.height
    try sdl.init_video()
    let win = try sdl.create_window("Grasm", win_w, win_h)
    let ren = try sdl.create_renderer(win)
    let tex = try sdl.create_texture(ren, win_w, win_h)

    // The only state that crosses a frame.
    var edits = Edits{ layer: 0, bright: 0, contrast: 100, mono: false, quit: false }

    var ev = sdl.event_buffer()
    var mx = 0 - 1
    var my = 0 - 1
    var down = false
    var pressed = false
    var quit = false
    var frames = 0
    var canvas = pcframe.new(win_w, win_h)
    var adjusted = pcframe.new(img.width, img.height)

    while not quit {
        gather(ev, mx, my, down, pressed, quit)

        // The image, adjusted, on the left.
        var dst = pcframe.pixels(adjusted)
        adjust(pcframe.pixels(base), dst, edits.bright, edits.contrast, edits.mono)
        let _ok = pcframe.set_pixels(adjusted, dst)
        pcframe.blit(canvas, adjusted, pcframe.whole(adjusted), 0, 0)

        // The palette, on the right.
        var ui = pcui.begin(
            canvas, font,
            Input{ mx: mx, my: my, down: down, pressed: pressed, released: false },
            11, pcui.dark(),
        )
        palette(ui, edits, img.width, win_h)
        if edits.quit {
            quit = true
        }
        canvas = pcui.surface_of(ui)

        try sdl.update_texture(tex, pcframe.pixels(canvas), pcframe.pitch(canvas))
        try sdl.render_clear(ren)
        try sdl.render_copy(ren, tex)
        sdl.render_present(ren)
        frames = frames + 1
        if limit > 0 and frames >= limit {
            quit = true
        }
    }

    // A fourth argument writes the last frame out, so a gate can check that
    // the palette drew rather than only that the loop ran.
    match a.get(3) {
        Some(out) -> {
            match write_bytes(out, pcframe.pixels(canvas)) {
                Err(_e) -> print("could not write {out}")
                Ok(_w) -> {}
            }
        }
        None -> {}
    }
    sdl.destroy_texture(tex)
    sdl.destroy_renderer(ren)
    sdl.destroy_window(win)
    sdl.quit()
    print("{win_w}x{win_h}, {frames} frames, layer {edits.layer} bright {edits.bright} contrast {edits.contrast}")
}
