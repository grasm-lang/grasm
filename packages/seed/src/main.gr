// SEED, the Korean block cipher of RFC 4269 (KISA, 1998).
//
// A 128-bit block and key, 16 rounds of a Feistel network on 64-bit
// halves. The round function splits its half into two 32-bit words and
// runs them through G three times with additions between; G is two 8-bit
// S-boxes, applied to alternate bytes, whose outputs are masked and mixed
// into all four bytes of the result. The key schedule rotates the key's
// halves by a byte each round and adds constants drawn from the golden
// ratio.
//
// SEED secured Korean online banking and e-commerce through the 2000s
// (every browser there carried an ActiveX plug-in for it), and has TLS
// suites (RFC 4162), S/MIME (RFC 4010) and SRTP. It is here so that what
// was written with it can be read. Modes come from `blockmodes`.
//
// Checked against OpenSSL's SEED.

type SeedCipher = { s1: [i64], s2: [i64], k: [i64] }

type SeedError =
    | SeedBadKey(length: i64)

let M32 = 4294967295

fn word(b: bytes, at: i64) -> i64 {
    return b.at(at).shl(24).bit_or(b.at(at + 1).shl(16)).bit_or(b.at(at + 2).shl(8)).bit_or(b.at(at + 3))
}

/// G of section 2.2: S1 on the even bytes, S2 on the odd, and each output
/// byte a masked mix of all four.
fn g(s1: [i64], s2: [i64], x: i64) -> i64 {
    let y0 = s1[x.bit_and(255)]
    let y1 = s2[x.ushr(8).bit_and(255)]
    let y2 = s1[x.ushr(16).bit_and(255)]
    let y3 = s2[x.ushr(24).bit_and(255)]
    let m0 = 252
    let m1 = 243
    let m2 = 207
    let m3 = 63
    let z3 = y0.bit_and(m3).bit_xor(y1.bit_and(m0)).bit_xor(y2.bit_and(m1)).bit_xor(y3.bit_and(m2))
    let z2 = y0.bit_and(m2).bit_xor(y1.bit_and(m3)).bit_xor(y2.bit_and(m0)).bit_xor(y3.bit_and(m1))
    let z1 = y0.bit_and(m1).bit_xor(y1.bit_and(m2)).bit_xor(y2.bit_and(m3)).bit_xor(y3.bit_and(m0))
    let z0 = y0.bit_and(m0).bit_xor(y1.bit_and(m1)).bit_xor(y2.bit_and(m2)).bit_xor(y3.bit_and(m3))
    return z3.shl(24).bit_or(z2.shl(16)).bit_or(z1.shl(8)).bit_or(z0)
}

pub fn new_cipher(key: bytes) -> SeedCipher ! SeedError {
    if key.len() != 16 {
        fail(SeedBadKey(key.len()))
    }
    let s1 = SEED_S1
    let s2 = SEED_S2
    var a = word(key, 0)
    var b = word(key, 4)
    var c = word(key, 8)
    var d = word(key, 12)
    var k: [i64] = []
    // KC_i is the golden-ratio constant 0x9E3779B9 rotated left i bits.
    var kc = 0x9E3779B9
    for i in 0..16 {
        k.push(g(s1, s2, (a + c - kc).bit_and(M32)))
        k.push(g(s1, s2, (b - d + kc).bit_and(M32)))
        if i % 2 == 0 {
            // A || B rotated right by a byte.
            let t = a
            a = a.ushr(8).bit_or(b.shl(24)).bit_and(M32)
            b = b.ushr(8).bit_or(t.shl(24)).bit_and(M32)
        } else {
            // C || D rotated left by a byte.
            let t = c
            c = c.shl(8).bit_or(d.ushr(24)).bit_and(M32)
            d = d.shl(8).bit_or(t.ushr(24)).bit_and(M32)
        }
        kc = kc.shl(1).bit_or(kc.ushr(31)).bit_and(M32)
    }
    return SeedCipher{ s1: s1, s2: s2, k: k }
}

fn f(c: SeedCipher, round: i64, r0: i64, r1: i64) -> (i64, i64) {
    var c0 = r0.bit_xor(c.k[2 * round])
    var c1 = r1.bit_xor(c.k[2 * round + 1])
    c1 = g(c.s1, c.s2, c1.bit_xor(c0))
    c0 = g(c.s1, c.s2, (c0 + c1).bit_and(M32))
    c1 = g(c.s1, c.s2, (c1 + c0).bit_and(M32))
    c0 = (c0 + c1).bit_and(M32)
    return (c0, c1)
}

fn run(c: SeedCipher, block: bytes, forward: bool) -> bytes {
    if block.len() != 16 {
        panic("SEED works on 16-byte blocks")
    }
    var l0 = word(block, 0)
    var l1 = word(block, 4)
    var r0 = word(block, 8)
    var r1 = word(block, 12)
    for i in 0..16 {
        let (t0, t1) = f(c, if forward { i } else { 15 - i }, r0, r1)
        l0 = l0.bit_xor(t0)
        l1 = l1.bit_xor(t1)
        if i < 15 {
            let (a, b) = (l0, l1)
            l0 = r0
            l1 = r1
            r0 = a
            r1 = b
        }
    }
    var out: [i64] = []
    for w in [l0, l1, r0, r1] {
        out = out + [w.ushr(24).bit_and(255), w.ushr(16).bit_and(255), w.ushr(8).bit_and(255), w.bit_and(255)]
    }
    return bytes_of(out)
}

/// One 16-byte block.
pub fn encrypt_block(c: SeedCipher, block: bytes) -> bytes {
    return run(c, block, true)
}

pub fn decrypt_block(c: SeedCipher, block: bytes) -> bytes {
    return run(c, block, false)
}

