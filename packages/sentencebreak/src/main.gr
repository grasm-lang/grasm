fn class_other() -> i64 { return 0 }
fn class_cr() -> i64 { return 1 }
fn class_lf() -> i64 { return 2 }
fn class_sep() -> i64 { return 3 }
fn class_extend() -> i64 { return 4 }
fn class_format() -> i64 { return 5 }
fn class_space() -> i64 { return 6 }
fn class_lower() -> i64 { return 7 }
fn class_upper() -> i64 { return 8 }
fn class_oletter() -> i64 { return 9 }
fn class_numeric() -> i64 { return 10 }
fn class_aterm() -> i64 { return 11 }
fn class_scontinue() -> i64 { return 12 }
fn class_sterm() -> i64 { return 13 }
fn class_close() -> i64 { return 14 }

/// The Sentence_Break class of a code point.
pub fn class_of(code: i64) -> i64 {
    var low = 0
    var high = SB_RUNS.len() / 3 - 1
    while low <= high {
        let middle = (low + high) / 2
        if code < SB_RUNS[middle * 3] {
            high = middle - 1
        } else if code > SB_RUNS[middle * 3 + 1] {
            low = middle + 1
        } else {
            return SB_RUNS[middle * 3 + 2]
        }
    }
    return class_other()
}

fn is_ignored(kind: i64) -> bool {
    return kind == class_extend() or kind == class_format()
}

fn is_para(kind: i64) -> bool {
    return kind == class_sep() or kind == class_cr() or kind == class_lf()
}

fn is_terminator(kind: i64) -> bool {
    return kind == class_aterm() or kind == class_sterm()
}

fn previous_visible(kinds: [i64], from: i64) -> i64 {
    var i = from
    while i >= 0 {
        if not is_ignored(kinds[i]) {
            return i
        }
        i = i - 1
    }
    return 0 - 1
}

fn kind_at(kinds: [i64], at: i64) -> i64 {
    if at < 0 {
        return class_other()
    }
    return kinds[at]
}

/// Walk back over `Sp*` then `Close*` and answer where the terminator that
/// started this run is, or -1.
///
/// Also answers whether any `Sp` was passed, because three of the rules
/// distinguish `ATerm Close*` from `ATerm Close* Sp*`.
fn terminator_before(kinds: [i64], from: i64) -> (i64, bool) {
    var i = previous_visible(kinds, from)
    var passed_space = false
    while i >= 0 and kinds[i] == class_space() {
        passed_space = true
        i = previous_visible(kinds, i - 1)
    }
    while i >= 0 and kinds[i] == class_close() {
        i = previous_visible(kinds, i - 1)
    }
    if i >= 0 and is_terminator(kinds[i]) {
        return (i, passed_space)
    }
    return (0 - 1, passed_space)
}

/// Rule SB8's forward look: from `at`, skip everything that is not one of
/// the characters that stop the search, and answer whether a lower-case
/// letter turns up first.
fn lower_ahead(kinds: [i64], at: i64) -> bool {
    var i = at
    while i < kinds.len() {
        let kind = kinds[i]
        if kind == class_lower() {
            return true
        }
        if kind == class_oletter() or kind == class_upper() or
        is_para(kind) or is_terminator(kind) or kind == class_space() {
            return false
        }
        i = i + 1
    }
    return false
}

/// Whether a sentence boundary falls before index `i`.
fn breaks_at(kinds: [i64], i: i64) -> bool {
    let raw_left = kinds[i - 1]
    let right = kinds[i]
    // SB3, SB4: a paragraph separator ends a sentence, and CR LF is one.
    if raw_left == class_cr() and right == class_lf() {
        return false
    }
    if is_para(raw_left) {
        return true
    }
    // SB5: marks and format characters attach to what they follow.
    if is_ignored(right) {
        return false
    }
    let left_at = previous_visible(kinds, i - 1)
    if left_at < 0 {
        return false
    }
    let left = kinds[left_at]
    // SB6: a full stop between digits is a decimal point.
    if left == class_aterm() and right == class_numeric() {
        return false
    }
    // SB7: `U.S.` — an initial, not an ending.
    let before = kind_at(kinds, previous_visible(kinds, left_at - 1))
    if left == class_aterm() and right == class_upper() and
    (before == class_upper() or before == class_lower()) {
        return false
    }
    let found = terminator_before(kinds, i - 1)
    if found.0 >= 0 {
        let terminator = kinds[found.0]
        // SB8: a full stop followed, eventually, by a lower-case letter is
        // in the middle of a sentence.
        if terminator == class_aterm() and lower_ahead(kinds, i) {
            return false
        }
        // SB8a: a terminator followed by one that continues.
        if right == class_scontinue() or is_terminator(right) {
            return false
        }
        // SB9 and SB10: the closing brackets and the spaces belong to the
        // sentence that is ending.
        if right == class_close() and not found.1 {
            return false
        }
        if right == class_space() or is_para(right) {
            return false
        }
        // SB11: and then it ends.
        return true
    }
    // SB998: everything else is the middle of a sentence.
    return false
}

fn classes_of(codes: [i64]) -> [i64] {
    var out: [i64] = []
    for code in codes {
        out.push(class_of(code))
    }
    return out
}

/// The code point offsets a string's sentences begin at, including 0 and
/// the length.
pub fn boundaries(text: str) -> [i64] {
    var codes: [i64] = []
    for character in text.chars() {
        codes.push(character.code_at(0))
    }
    return boundaries_of(codes)
}

/// The same, for code points a caller already has.
pub fn boundaries_of(codes: [i64]) -> [i64] {
    var out = [0]
    if codes.len() == 0 {
        return out
    }
    let kinds = classes_of(codes)
    var i = 1
    while i < codes.len() {
        if breaks_at(kinds, i) {
            out.push(i)
        }
        i = i + 1
    }
    out.push(codes.len())
    return out
}

/// A string cut into sentences, each including the punctuation and the
/// space that follow it.
pub fn sentences(text: str) -> [str] {
    let characters = text.chars()
    let marks = boundaries(text)
    var out: [str] = []
    var i = 0
    while i + 1 < marks.len() {
        var piece = ""
        var j = marks[i]
        while j < marks[i + 1] {
            piece = piece + characters[j]
            j = j + 1
        }
        out.push(piece)
        i = i + 1
    }
    return out
}

/// How many sentences a string has.
pub fn count(text: str) -> i64 {
    return boundaries(text).len() - 1
}
