// Batch B58's libraries, each run once on inputs whose answers came from
// the tool it is held to -- Go 1.25 or Java 17. scripts/b58_diff.sh holds
// them to those tools on thousands more.
import gobuildconstraint
import goversion
import gostrings
import gonetmail
import gotimefmt
import javaurlencoder
import javadatetimeformatter
import gohtml
import gohttpcookie
import javasimpledateformat

fn constraint_error(line: str) -> (str, i64) {
    return match gobuildconstraint.parse(line) {
        Ok(_x) -> ("", 0 - 1)
        Err(e) -> (gobuildconstraint.error_text(e), gobuildconstraint.error_offset(e))
    }
}

fn build_constraints() {
    let x = gobuildconstraint.parse("//go:build (linux || darwin) && !cgo && go1.21") ?? GoConstraintTag("")
    assert_eq(gobuildconstraint.to_str(x), "(linux || darwin) && !cgo && go1.21")
    assert_eq(gobuildconstraint.go_version(x), "go1.21")
    assert_eq(gobuildconstraint.plus_build_lines(x) ?? [], ["// +build linux darwin", "// +build !cgo", "// +build go1.21"])
    assert(gobuildconstraint.eval(x, ["linux", "go1.21"]))
    assert_eq(constraint_error("//go:build linux && (cgo"), ("missing close paren", 9))
    assert_eq(constraint_error("//go:build !!linux").0, "double negation not allowed")
    let y = gobuildconstraint.parse("// +build linux,!cgo darwin") ?? GoConstraintTag("")
    assert_eq(gobuildconstraint.to_str(y), "(linux && !cgo) || darwin")
    print("gobuildconstraint: Go's go/build/constraint")
}

fn go_versions() {
    assert_eq(goversion.compare("go1.21rc1", "go1.21.0"), 0 - 1)
    assert_eq(goversion.compare("go1.21", "go1.21rc1"), 0 - 1)
    assert_eq(goversion.compare("go1.20", "go1.20.0"), 0)
    assert_eq(goversion.compare("go1.9", "go1.10"), 0 - 1)
    assert_eq(goversion.compare("bogus", "x"), 0)
    assert_eq(goversion.compare("bogus", "go1"), 0 - 1)
    assert_eq([goversion.lang("go1.21.3"), goversion.lang("go1.0.5"), goversion.lang("go2"), goversion.lang("go1.21rc2-bigcorp")], ["go1.21", "go1", "go2.0", "go1.21"])
    assert(not goversion.is_valid("go1.021"))
    assert(goversion.is_valid("go1.21beta"))
    print("goversion: Go's go/version")
}

fn b(s: str) -> bytes {
    return s.to_bytes()
}

fn go_strings() {
    assert_eq(gostrings.fields(b(" a\u{a0}b\u{3000}c ")).map(|x| x.to_str()), ["a", "b", "c"])
    assert(gostrings.equal_fold(b("\u{212a}elvin"), b("kelvin")))
    assert(gostrings.equal_fold(b("ſ"), b("S")))
    assert(not gostrings.equal_fold(b("ß"), b("SS")))
    assert_eq(gostrings.to_upper(b("ǆ ß")).to_str(), "Ǆ ß")
    assert_eq(gostrings.to_title(b("ǆ")).to_str(), "ǅ")
    assert_eq(gostrings.title(b("hello wörld_x 9ab")).to_str(), "Hello Wörld_x 9ab")
    assert_eq(gostrings.to_valid_utf8(bytes_of([97, 255, 254, 98]), b("?")).to_str(), "a?b")
    assert_eq(gostrings.replacer_replace(gostrings.new_replacer([(b(""), b("-"))]), b("é")).to_list(), [45, 195, 45, 169, 45])
    assert_eq(gostrings.replacer_replace(gostrings.new_replacer([(b("a"), b("1")), (b("aa"), b("2"))]), b("aaa")).to_str(), "111")
    assert_eq(gostrings.count(b("héllo"), b("")), 6)
    assert_eq(gostrings.replace(b("héllo"), b(""), b("-"), 3).to_str(), "-h-é-llo")
    assert_eq(gostrings.split_n(b("a,b,c"), b(","), 2).map(|x| x.to_str()), ["a", "b,c"])
    assert_eq(gostrings.index_any(bytes_of([120, 255, 195, 169]), bytes_of([233])), 1)
    print("gostrings: Go's strings")
}

fn mail_error(text: str) -> str {
    return match gonetmail.parse_address_text(text) {
        Ok(_a) -> ""
        Err(e) -> gonetmail.error_text(e)
    }
}

fn mail_text(a: GoMailAddress) -> str {
    return gonetmail.address_string(a).to_str()
}

fn go_mail() {
    let empty = GoMailAddress{ name: bytes_of([]), address: bytes_of([]) }
    let a = gonetmail.parse_address_text("=?utf-8?q?J=C3=B6rg?= =?utf-8?q?_M?= <jorg@example.com>") ?? empty
    assert_eq(a.name.to_str(), "Jörg M")
    assert_eq(mail_text(a), "=?utf-8?q?J=C3=B6rg_M?= <jorg@example.com>")
    let c = gonetmail.parse_address_text("john.doe@example.com (John Doe)") ?? empty
    assert_eq(mail_text(c), "\"John Doe\" <john.doe@example.com>")
    let list = gonetmail.parse_address_list("Team: a@x, b@y;, \"Doe, J\" <j@[1.2.3.4]>".to_bytes()) ?? []
    assert_eq(list.map(|x| mail_text(x)), ["<a@x>", "<b@y>", "\"Doe, J\" <j@[1.2.3.4]>"])
    assert_eq(mail_error("=?koi8-r?q?x?= <a@b>"), "mail: missing word in phrase: charset not supported: \"koi8-r\"")
    assert_eq(mail_error("a@b c"), "mail: expected single address, got \"c\"")
    let t = gonetmail.parse_date("Fri, 21 Nov 1997 09:55:06 -0600 (MDT)".to_bytes()) ?? gotimefmt.new_time(0, 0, 0, "")
    assert_eq((t.unix, t.zone, t.offset), (880127706, "", 0 - 21600))
    let bad = match gonetmail.parse_date("21 Nov 97 09:55\r06 GMT".to_bytes()) {
        Ok(_t) -> ""
        Err(e) -> gonetmail.error_text(e)
    }
    assert_eq(bad, "mail: header has a CR without LF")
    assert_eq(mail_text(GoMailAddress{ name: "Jörg.".to_bytes(), address: "a.@x".to_bytes() }), "=?utf-8?b?SsO2cmcu?= <\"a.\"@x>")
    print("gonetmail: Go's net/mail")
}

fn url_decoded(text: str) -> str {
    return match javaurlencoder.decode(text) {
        Ok(t) -> t
        Err(e) -> "E: " + javaurlencoder.error_text(e)
    }
}

fn java_url() {
    assert_eq(javaurlencoder.encode("a b~*é'"), "a+b%7E*%C3%A9%27")
    assert_eq(url_decoded("%C3%A9+%E2%82%AC%+F%-0").codes(), [233, 32, 8364, 15, 0])
    assert_eq(url_decoded("%ED%A0%80|%E2%82").codes(), [65533, 124, 65533])
    assert_eq(url_decoded("%\u{664}\u{661}"), "A")
    assert_eq(url_decoded("%zz"), "E: URLDecoder: Illegal hex characters in escape (%) pattern - Error at index 0 in: \"zz\"")
    assert_eq(url_decoded("%-1"), "E: URLDecoder: Illegal hex characters in escape (%) pattern - negative value")
    assert_eq(url_decoded("%4"), "E: URLDecoder: Incomplete trailing escape (%) pattern")
    print("javaurlencoder: Java's URLEncoder and URLDecoder")
}

fn dtf(pattern: str, t: JavaTemporal) -> str {
    return match javadatetimeformatter.of_pattern(pattern) {
        Err(e) -> javadatetimeformatter.error_class(e) + ": " + javadatetimeformatter.error_text(e)
        Ok(f) -> match javadatetimeformatter.format(f, t) {
            Ok(s) -> s
            Err(e) -> javadatetimeformatter.error_class(e) + ": " + javadatetimeformatter.error_text(e)
        }
    }
}

fn java_formatter() {
    let t = javadatetimeformatter.local_date_time(2024, 12, 29, 12, 0, 5, 120000000)
    assert_eq(dtf("EEEE, MMMM d, uuuu h:mm a", t), "Sunday, December 29, 2024 12:00 PM")
    assert_eq(dtf("YYYY-'W'ww-e", t), "2025-W01-1")
    assert_eq(dtf("yyyy-MM-dd'T'HH:mm:ss.SSS", t), "2024-12-29T12:00:05.120")
    assert_eq(dtf("B, QQQQ, GGGG", t), "noon, 4th quarter, Anno Domini")
    assert_eq(dtf("[yyyy-MM-dd ]HH:mm", javadatetimeformatter.local_time(9, 30, 0, 0)), "09:30")
    assert_eq(dtf("ppd|ppM", t), "29|12")
    assert(dtf("ppHmm", t).starts_with("java.lang.ClassCastException: class java.time.format.DateTimeFormatterBuilder$PadPrinterParserDecorator cannot be cast"))
    assert_eq(dtf("HH:mm", javadatetimeformatter.local_date(2024, 1, 1)), "java.time.temporal.UnsupportedTemporalTypeException: Unsupported field: HourOfDay")
    assert_eq(dtf("uuuu", javadatetimeformatter.local_date(12345, 1, 1)), "+12345")
    assert_eq(dtf("dddd", t), "java.lang.IllegalArgumentException: Too many pattern letters: d")
    assert_eq(dtf("yyyy z", t), "java.time.DateTimeException: Unable to extract ZoneId from temporal 2024-12-29T12:00:05.120")
    print("javadatetimeformatter: Java's DateTimeFormatter")
}

fn go_html() {
    assert_eq(gohtml.escape_string("<a href=\"x\">Tom & Jerry's</a>"), "&lt;a href=&#34;x&#34;&gt;Tom &amp; Jerry&#39;s&lt;/a&gt;")
    let text = "&ampx &notit; &#5x &#55x &#4294967361; &#150; &nGt; &NotEqualTilde; &#x;"
    assert_eq(gohtml.unescape_string(text), "&x ¬it; &#5x 7x A \u{2013} &nGt; \u{2242}\u{338} \u{fffd}")
    print("gohtml: Go's html")
}

fn go_cookies() {
    let cs = gohttpcookie.parse_cookie("a=1; b=\"x y\"; c=".to_bytes()) ?? []
    assert_eq(cs.map(|c| gohttpcookie.cookie_string(c)), ["a=1", "b=\"x y\"", "c="])
    assert(cs[1].quoted)
    let bad = match gohttpcookie.parse_cookie("a=1; b".to_bytes()) {
        Ok(_cs) -> ""
        Err(e) -> gohttpcookie.error_text(e)
    }
    assert_eq(bad, "http: '=' not found in cookie")
    let line = "sid=abc; Path=/; Domain=.example.com; Max-Age=010; Expires=Wed, 21 Oct 2015 07:28:00 GMT; SameSite=lax; HttpOnly; Foo=bar"
    let c = gohttpcookie.parse_set_cookie(line.to_bytes()) ?? gohttpcookie.new_cookie("", "")
    assert_eq((c.path, c.domain, c.max_age, c.same_site, c.http_only), ("/", ".example.com", 0, 2, true))
    assert_eq((c.expires ?? (0, 0)).0, 1445412480)
    assert_eq(c.unparsed.map(|u| u.to_str()), ["Max-Age=010", "Foo=bar"])
    assert_eq(gohttpcookie.cookie_string(c), "sid=abc; Path=/; Domain=example.com; Expires=Wed, 21 Oct 2015 07:28:00 GMT; HttpOnly; SameSite=Lax")
    var d = gohttpcookie.new_cookie("x", "a\"b")
    d.partitioned = true
    assert_eq(gohttpcookie.cookie_string(d), "x=ab; Partitioned")
    let why = match gohttpcookie.cookie_valid(d) {
        Ok(_u) -> ""
        Err(e) -> gohttpcookie.error_text(e)
    }
    assert_eq(why, "http: invalid byte '\"' in Cookie.Value")
    print("gohttpcookie: Go's net/http cookies")
}

fn sdf(pattern: str, millis: i64) -> str {
    return match javasimpledateformat.compile(pattern) {
        Err(e) -> "E: " + javasimpledateformat.error_text(e)
        Ok(f) -> match javasimpledateformat.format(f, millis) {
            Ok(s) -> s
            Err(e) -> "E: " + javasimpledateformat.error_text(e)
        }
    }
}

fn java_simple_date_format() {
    assert_eq(sdf("yyyy-MM-dd'T'HH:mm:ss.SSSZ", 1729425600123), "2024-10-20T12:00:00.123+0000")
    assert_eq(sdf("EEE, d MMM yy hh:mm a zzzz", 1729425600123), "Sun, 20 Oct 24 12:00 PM Greenwich Mean Time")
    assert_eq(sdf("YYYY-'W'ww-u", 1735430400000), "2025-W01-7")
    assert_eq(sdf("kk:mm 'o''clock' X", 0), "24:00 o'clock Z")
    assert_eq(sdf("XXXXb", 0), "E: Illegal pattern character 'b'")
    assert_eq(sdf("'unclosed", 0), "E: Unterminated quote")
    print("javasimpledateformat: Java's SimpleDateFormat")
}

fn main() / {io} {
    build_constraints()
    go_versions()
    go_strings()
    go_mail()
    java_url()
    java_formatter()
    go_html()
    go_cookies()
    java_simple_date_format()
}
