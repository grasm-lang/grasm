// Quoted-printable as CPython 3.13 writes and reads it: `binascii.b2a_qp`
// and `binascii.a2b_qp`, the C code under `quopri.encodestring`,
// `quopri.decodestring` and the email package's body and header
// encodings.
//
// The format has more freedom than one encoder uses, so a peer that has
// to produce the same bytes as Python (for a signature, a cache key, a
// test fixture) must make Python's choices:
//
//   - Lines break softly before 76 columns; a byte that would reach the
//     limit moves to the next line, except before a newline or at the
//     end.
//   - `=`, bytes above 126, controls other than CR and LF, a `.` alone at
//     the start of a line, and a space or tab at the end of the data are
//     escaped, in upper-case hex; with `quotetabs` every space and tab is,
//     with `header` `_` is and a space becomes `_`.
//   - A space or tab before a line break is escaped after the fact (which
//     can make that line longer than 76).
//   - The first LF decides the line ending: if a CR comes before it,
//     every line break written is CRLF, otherwise LF; with `istext` off,
//     CR and LF are data and escaped.
//
// Decoding is forgiving: a soft break may be `=\n`, `=\r\n` or `=` and
// anything up to the next LF; `==` is `=`; a `=` not followed by two hex
// digits stays; a `=` at the very end is dropped; with `header`, `_` is
// a space.

fn hex_digit(c: i64) -> i64 {
    return if c >= 48 and c <= 57 { c - 48 } else if c >= 65 and c <= 70 { c - 55 } else if c >= 97 and c <= 102 { c - 87 } else { 0 - 1 }
}

/// `binascii.a2b_qp(data, header)`.
pub fn decode(data: bytes, header: bool) -> bytes {
    let b = data.to_list()
    let n = b.len()
    var out: [i64] = []
    var i = 0
    while i < n {
        if b[i] == 61 {
            i = i + 1
            if i >= n {
                break
            }
            if b[i] == 10 or b[i] == 13 {
                if b[i] != 10 {
                    while i < n and b[i] != 10 {
                        i = i + 1
                    }
                }
                if i < n {
                    i = i + 1
                }
            } else if b[i] == 61 {
                out.push(61)
                i = i + 1
            } else if i + 1 < n and hex_digit(b[i]) >= 0 and hex_digit(b[i + 1]) >= 0 {
                out.push(hex_digit(b[i]) * 16 + hex_digit(b[i + 1]))
                i = i + 2
            } else {
                out.push(61)
            }
        } else if header and b[i] == 95 {
            out.push(32)
            i = i + 1
        } else {
            out.push(b[i])
            i = i + 1
        }
    }
    return bytes_of(out)
}

fn push_hex(inout out: [i64], c: i64) {
    let d = "0123456789ABCDEF".codes()
    out.push(d[c.shr(4)])
    out.push(d[c.bit_and(15)])
}

fn soft_break(inout out: [i64], crlf: bool) {
    out.push(61)
    if crlf {
        out.push(13)
    }
    out.push(10)
}

/// Whether byte `i` must be written as `=XX`.
fn needs_escape(b: [i64], i: i64, linelen: i64, quotetabs: bool, istext: bool, header: bool) -> bool {
    let c = b[i]
    let last = i + 1 == b.len()
    if c > 126 or c == 61 or (header and c == 95) {
        return true
    }
    if c == 46 and linelen == 0 and (last or b[i + 1] == 10 or b[i + 1] == 13 or b[i + 1] == 0) {
        return true
    }
    if not istext and (c == 13 or c == 10) {
        return true
    }
    if (c == 9 or c == 32) and last {
        return true
    }
    return c < 33 and c != 13 and c != 10 and (quotetabs or (c != 9 and c != 32))
}

/// `binascii.b2a_qp(data, quotetabs, istext, header)`.
pub fn encode(data: bytes, quotetabs: bool, istext: bool, header: bool) -> bytes {
    let b = data.to_list()
    let n = b.len()
    var crlf = false
    for i in 0..n {
        if b[i] == 10 {
            crlf = i > 0 and b[i - 1] == 13
            break
        }
    }
    var out: [i64] = []
    var linelen = 0
    var i = 0
    while i < n {
        if needs_escape(b, i, linelen, quotetabs, istext, header) {
            if linelen + 3 >= 76 {
                soft_break(out, crlf)
                linelen = 0
            }
            out.push(61)
            push_hex(out, b[i])
            i = i + 1
            linelen = linelen + 3
        } else if istext and (b[i] == 10 or (i + 1 < n and b[i] == 13 and b[i + 1] == 10)) {
            linelen = 0
            let k = out.len()
            if k > 0 and (out[k - 1] == 32 or out[k - 1] == 9) {
                let ch = out[k - 1]
                out[k - 1] = 61
                push_hex(out, ch)
            }
            if crlf {
                out.push(13)
            }
            out.push(10)
            i = i + if b[i] == 13 { 2 } else { 1 }
        } else {
            if i + 1 != n and b[i + 1] != 10 and linelen + 1 >= 76 {
                soft_break(out, crlf)
                linelen = 0
            }
            linelen = linelen + 1
            out.push(if header and b[i] == 32 { 95 } else { b[i] })
            i = i + 1
        }
    }
    return bytes_of(out)
}
