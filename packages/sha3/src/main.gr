// SHA-3 and SHAKE, on Keccak-f[1600].
//
// SHA-3 is not a faster SHA-2. It is a different construction — a sponge —
// chosen after SHA-1 fell and the worry was that SHA-2, built the same way,
// might follow. A sponge absorbs the message into a large state and squeezes
// output back out, so the same permutation gives a fixed digest and an
// arbitrary-length one with no separate design.
//
// That second half is why SHAKE is here. A stream of digest bytes of any
// length you ask for is what a key derivation, a mask generation function and
// a deterministic random string all need, and SHA-2 cannot give it without a
// counter construction bolted on top.
//
// Every operation in Keccak is a rotation, an XOR, an AND or a NOT — no
// addition at all. So unlike SHA-512 next door, an `i64` holds a lane
// directly and there is nothing to do about overflow.

let KECCAK_RC = [
    1, 32898, -9223372036854742902, -9223372034707259392, 32907, 2147483649,
    -9223372034707259263, -9223372036854743031, 138, 136, 2147516425,
    2147483658, 2147516555, -9223372036854775669, -9223372036854742903,
    -9223372036854743037, -9223372036854743038, -9223372036854775680, 32778,
    -9223372034707292150, -9223372034707259263, -9223372036854742912,
    2147483649, -9223372034707259384,
]

/// How far each lane rotates in the rho step, indexed `x + 5 * y`.
let KECCAK_RHO = [
    0, 1, 62, 28, 27, 36, 44, 6, 55, 20, 3, 10, 43, 25, 39, 41, 45, 15, 21,
    8, 18, 2, 61, 56, 14,
]

fn rotl(x: i64, n: i64) -> i64 {
    if n == 0 {
        return x
    }
    return x.shl(n).bit_or(x.ushr(64 - n))
}

/// Keccak-f[1600]: 24 rounds of theta, rho, pi, chi and iota.
///
/// The round constants and rotations come in as arguments: a top-level
/// `let` read inside a function is built again on every read, and reading
/// the tables in place rebuilt them some 600 times per permutation, which
/// was nine-tenths of what hashing cost.
fn permute(inout lane: [i64], rc: [i64], rho: [i64]) {
    var parity = [0, 0, 0, 0, 0]
    var moved: [i64] = []
    for _i in 0..25 {
        moved.push(0)
    }
    var row = [0, 0, 0, 0, 0]
    for round in 0..24 {
        // Theta: each column's parity is folded into every lane of the two
        // columns beside it, which is what makes one flipped bit reach the
        // whole state within two rounds.
        for x in 0..5 {
            parity[x] = lane[x].bit_xor(lane[x + 5]).bit_xor(lane[x + 10])
                .bit_xor(lane[x + 15]).bit_xor(lane[x + 20])
        }
        for x in 0..5 {
            let d = parity[(x + 4) % 5].bit_xor(rotl(parity[(x + 1) % 5], 1))
            for y in 0..5 {
                lane[x + 5 * y] = lane[x + 5 * y].bit_xor(d)
            }
        }
        // Rho and pi together: rotate each lane, then move it.
        for x in 0..5 {
            for y in 0..5 {
                let to_x = y
                let to_y = (2 * x + 3 * y) % 5
                moved[to_x + 5 * to_y] = rotl(lane[x + 5 * y], rho[x + 5 * y])
            }
        }
        // Chi: the only non-linear step in the whole permutation.
        for y in 0..5 {
            for x in 0..5 {
                row[x] = moved[x + 5 * y]
            }
            for x in 0..5 {
                lane[x + 5 * y] = row[x].bit_xor(
                    row[(x + 1) % 5].bit_not().bit_and(row[(x + 2) % 5]))
            }
        }
        // Iota: break the symmetry between rounds.
        lane[0] = lane[0].bit_xor(rc[round])
    }
}

/// The sponge: absorb `rate` bytes at a time, then squeeze `want` back.
///
/// `pad` is what separates the functions from each other — 0x06 for SHA-3 and
/// 0x1F for SHAKE. Without that byte SHA3-256 of a message would be a prefix
/// of SHAKE256 of the same message, and one function's output would be the
/// other's.
fn sponge(message: bytes, rate: i64, pad: i64, want: i64) -> bytes {
    let rc = KECCAK_RC
    let rho = KECCAK_RHO
    var lane: [i64] = []
    for _i in 0..25 {
        lane.push(0)
    }
    var block: [i64] = []
    for i in 0..message.len() {
        block.push(message.at(i))
    }
    block.push(pad)
    while block.len() % rate != 0 {
        block.push(0)
    }
    // The last byte of the last block carries the high padding bit.
    block[block.len() - 1] = block[block.len() - 1].bit_or(128)
    var at = 0
    while at < block.len() {
        for i in 0..(rate / 8) {
            var word = 0
            for j in 0..8 {
                // Lanes are little-endian, unlike every SHA-2 word.
                word = word.bit_or(block[at + i * 8 + j].shl(j * 8))
            }
            lane[i] = lane[i].bit_xor(word)
        }
        permute(lane, rc, rho)
        at = at + rate
    }
    var out: [i64] = []
    while out.len() < want {
        for i in 0..(rate / 8) {
            if out.len() >= want {
                break
            }
            for j in 0..8 {
                if out.len() >= want {
                    break
                }
                out.push(lane[i].ushr(j * 8).bit_and(255))
            }
        }
        if out.len() < want {
            permute(lane, rc, rho)
        }
    }
    return bytes_of(out)
}

pub fn sha3_224(message: bytes) -> bytes {
    return sponge(message, 144, 6, 28)
}

pub fn sha3_256(message: bytes) -> bytes {
    return sponge(message, 136, 6, 32)
}

pub fn sha3_384(message: bytes) -> bytes {
    return sponge(message, 104, 6, 48)
}

pub fn sha3_512(message: bytes) -> bytes {
    return sponge(message, 72, 6, 64)
}

/// SHAKE128, extendable to whatever length is asked for.
pub fn shake128(message: bytes, want: i64) -> bytes {
    return sponge(message, 168, 31, want)
}

pub fn shake256(message: bytes, want: i64) -> bytes {
    return sponge(message, 136, 31, want)
}

// --- SP 800-185 ---------------------------------------------------------------
//
// cSHAKE is SHAKE with a function name and a customisation string absorbed
// first, so KMAC, TupleHash and an application's own uses of SHAKE give
// unrelated outputs for the same input. The strings are framed with the
// encodings below, which make every framing unambiguous: a length always
// says how many bytes its own number takes.

/// x as its byte count followed by its big-endian bytes (at least one).
pub fn left_encode(x: i64) -> bytes {
    let body = encode_bytes(x)
    return bytes_of([body.len()]).concat(body)
}

/// x as its big-endian bytes followed by their count.
pub fn right_encode(x: i64) -> bytes {
    let body = encode_bytes(x)
    return body.concat(bytes_of([body.len()]))
}

fn encode_bytes(x: i64) -> bytes {
    var out: [i64] = []
    var v = x
    while v > 0 {
        out = [v.bit_and(255)] + out
        v = v.ushr(8)
    }
    if out.len() == 0 {
        out.push(0)
    }
    return bytes_of(out)
}

/// A string preceded by its length in bits.
pub fn encode_string(s: bytes) -> bytes {
    return left_encode(s.len() * 8).concat(s)
}

/// x preceded by w's encoding and padded with zeros to a multiple of w.
pub fn bytepad(x: bytes, w: i64) -> bytes {
    var out = left_encode(w).concat(x).to_list()
    while out.len() % w != 0 {
        out.push(0)
    }
    return bytes_of(out)
}

fn cshake(message: bytes, rate: i64, want: i64, name: bytes, custom: bytes) -> bytes {
    if name.len() == 0 and custom.len() == 0 {
        return sponge(message, rate, 31, want)
    }
    let prefix = bytepad(encode_string(name).concat(encode_string(custom)), rate)
    return sponge(prefix.concat(message), rate, 4, want)
}

/// cSHAKE128 with a function name and a customisation string; with both
/// empty it is SHAKE128.
pub fn cshake128(message: bytes, want: i64, name: bytes, custom: bytes) -> bytes {
    return cshake(message, 168, want, name, custom)
}

pub fn cshake256(message: bytes, want: i64, name: bytes, custom: bytes) -> bytes {
    return cshake(message, 136, want, name, custom)
}

/// The original Keccak padding, which is what Ethereum's `keccak256` uses.
///
/// It is here because the difference is a single byte and mistaking one for
/// the other has cost real money: `keccak256` and `sha3_256` are different
/// functions with identical-looking names.
pub fn keccak256(message: bytes) -> bytes {
    return sponge(message, 136, 1, 32)
}

pub fn hex(data: bytes) -> str {
    var out = ""
    for i in 0..data.len() {
        let b = data.at(i)
        out = out + b.ushr(4).to_base(16) + b.bit_and(15).to_base(16)
    }
    return out
}

pub fn sha3_256_hex(message: bytes) -> str {
    return hex(sha3_256(message))
}

pub fn sha3_512_hex(message: bytes) -> str {
    return hex(sha3_512(message))
}

pub fn shake256_hex(message: bytes, want: i64) -> str {
    return hex(shake256(message, want))
}

pub fn keccak256_hex(message: bytes) -> str {
    return hex(keccak256(message))
}

/// The rate in bytes for a given digest size, which is `200 - 2 * size`.
///
/// Exposed because it is the number that decides how much of the state an
/// attacker never sees, and the reason SHA3-512 is slower than SHA3-256.
pub fn rate_for(digest_bytes: i64) -> i64 {
    return 200 - 2 * digest_bytes
}
