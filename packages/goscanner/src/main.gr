// Go's lexical scanner, token for token as go/scanner scans.
//
// Every Go tool starts here: gofmt, vet, a language server, a code search
// index, a syntax highlighter. Go's grammar puts semicolons between
// statements, but nobody writes them: the scanner inserts one at a
// newline (or the end of the file) when the line's last token is an
// identifier, a literal, one of the keywords break, continue, fallthrough
// and return, `++`, `--`, `)`, `]` or `}` -- with the comment rules that
// go with it (a /*...*/ comment holding a newline counts as one, and the
// semicolon is placed at that newline, after the comment).
//
// Numbers are taken whole and then checked (a stray digit, a misplaced
// `_` or a missing exponent is an error, but the literal is still one
// token), carriage returns are dropped from raw strings and comments,
// letters and digits beyond ASCII are Unicode's (as of Go's Unicode
// 15.0), and invalid UTF-8 reads as U+FFFD -- all as go/scanner does,
// error for error.
//
// `tokens` scans a whole file with comments, returning (offset, token,
// literal) triples and the number of errors go/scanner would report.

type GoToken = { offset: i64, tok: str, lit: bytes }

type GoScanner = {
    src: bytes,
    ch: i64,
    offset: i64,
    rd: i64,
    insert_semi: bool,
    nl_pos: i64,
    errors: i64,
    letters: [i64],
    digits: [i64],
}

fn in_ranges(t: [i64], r: i64) -> bool {
    var lo = 0
    var hi = t.len() / 2 - 1
    while lo <= hi {
        let mid = (lo + hi) / 2
        if r < t[2 * mid] {
            hi = mid - 1
        } else if r > t[2 * mid + 1] {
            lo = mid + 1
        } else {
            return true
        }
    }
    return false
}

fn lower(ch: i64) -> i64 {
    return ch.bit_or(32)
}

fn is_decimal(ch: i64) -> bool {
    return ch >= 48 and ch <= 57
}

fn is_hex(ch: i64) -> bool {
    return is_decimal(ch) or (lower(ch) >= 97 and lower(ch) <= 102)
}

fn is_letter(s: GoScanner, ch: i64) -> bool {
    return (lower(ch) >= 97 and lower(ch) <= 122) or ch == 95 or (ch >= 128 and in_ranges(s.letters, ch))
}

fn is_digit(s: GoScanner, ch: i64) -> bool {
    return is_decimal(ch) or (ch >= 128 and in_ranges(s.digits, ch))
}

fn cont(src: bytes, i: i64, lo: i64, hi: i64) -> bool {
    return i < src.len() and src.at(i) >= lo and src.at(i) <= hi
}

/// utf8.DecodeRune: (rune, width), (0xFFFD, 1) for anything invalid.
fn decode_rune(src: bytes, i: i64) -> (i64, i64) {
    let b = src.at(i)
    if b < 128 {
        return (b, 1)
    }
    if b >= 194 and b <= 223 and cont(src, i + 1, 128, 191) {
        return (b.bit_and(31).shl(6).bit_or(src.at(i + 1).bit_and(63)), 2)
    }
    if b >= 224 and b <= 239 {
        let lo = if b == 224 { 160 } else { 128 }
        let hi = if b == 237 { 159 } else { 191 }
        if cont(src, i + 1, lo, hi) and cont(src, i + 2, 128, 191) {
            return (b.bit_and(15).shl(12).bit_or(src.at(i + 1).bit_and(63).shl(6)).bit_or(src.at(i + 2).bit_and(63)), 3)
        }
    }
    if b >= 240 and b <= 244 {
        let lo = if b == 240 { 144 } else { 128 }
        let hi = if b == 244 { 143 } else { 191 }
        if cont(src, i + 1, lo, hi) and cont(src, i + 2, 128, 191) and cont(src, i + 3, 128, 191) {
            return (b.bit_and(7).shl(18).bit_or(src.at(i + 1).bit_and(63).shl(12)).bit_or(src.at(i + 2).bit_and(63).shl(6)).bit_or(src.at(i + 3).bit_and(63)), 4)
        }
    }
    return (65533, 1)
}

fn next(inout s: GoScanner) {
    if s.rd >= s.src.len() {
        s.offset = s.src.len()
        s.ch = 0 - 1
        return
    }
    s.offset = s.rd
    var (r, w) = (s.src.at(s.rd), 1)
    if r == 0 {
        s.errors = s.errors + 1
    } else if r >= 128 {
        let (r2, w2) = decode_rune(s.src, s.rd)
        r = r2
        w = w2
        if r == 65533 and w == 1 {
            s.errors = s.errors + 1
            let b0 = s.src.at(s.rd)
            let b1 = if s.rd + 1 < s.src.len() { s.src.at(s.rd + 1) } else { 0 - 1 }
            if s.offset == 0 and ((b0 == 255 and b1 == 254) or (b0 == 254 and b1 == 255)) {
                // UTF-16: everything is consumed to avoid a cascade.
                w = s.src.len() - s.rd
            }
        } else if r == 65279 and s.offset > 0 {
            s.errors = s.errors + 1
        }
    }
    s.rd = s.rd + w
    s.ch = r
}

fn peek(s: GoScanner) -> i64 {
    return if s.rd < s.src.len() { s.src.at(s.rd) } else { 0 }
}

fn utf8_of(r: i64) -> [i64] {
    if r < 128 {
        return [r]
    }
    if r < 2048 {
        return [192 + r.ushr(6), 128 + r.bit_and(63)]
    }
    if r < 65536 {
        return [224 + r.ushr(12), 128 + r.ushr(6).bit_and(63), 128 + r.bit_and(63)]
    }
    return [240 + r.ushr(18), 128 + r.ushr(12).bit_and(63), 128 + r.ushr(6).bit_and(63), 128 + r.bit_and(63)]
}

/// Drops carriage returns, keeping one that ends a /*...*/ comment
/// right before its "*/".
fn strip_cr(b: bytes, comment: bool) -> bytes {
    var out: [i64] = []
    for j in 0..b.len() {
        let ch = b.at(j)
        if ch != 13 or (comment and out.len() > 2 and out[out.len() - 1] == 42 and j + 1 < b.len() and b.at(j + 1) == 47) {
            out.push(ch)
        }
    }
    return bytes_of(out)
}

fn scan_comment(inout s: GoScanner) -> (bytes, i64) {
    let offs = s.offset - 1
    var cr = 0
    var nl = 0
    if s.ch == 47 {
        next(s)
        while s.ch != 10 and s.ch >= 0 {
            if s.ch == 13 {
                cr = cr + 1
            }
            next(s)
        }
    } else {
        next(s)
        var closed = false
        while s.ch >= 0 {
            let ch = s.ch
            if ch == 13 {
                cr = cr + 1
            } else if ch == 10 and nl == 0 {
                nl = s.offset
            }
            next(s)
            if ch == 42 and s.ch == 47 {
                next(s)
                closed = true
                break
            }
        }
        if not closed {
            s.errors = s.errors + 1
        }
    }
    var lit = s.src.slice(offs, s.offset)
    if cr > 0 and lit.len() >= 2 and lit.at(1) == 47 and lit.at(lit.len() - 1) == 13 {
        lit = lit.slice(0, lit.len() - 1)
        cr = cr - 1
    }
    if cr > 0 {
        lit = strip_cr(lit, lit.at(1) == 42)
    }
    return (lit, nl)
}

fn digit_run(inout s: GoScanner, base: i64, inout invalid: i64) -> i64 {
    var sep = 0
    if base <= 10 {
        while is_decimal(s.ch) or s.ch == 95 {
            var ds = 1
            if s.ch == 95 {
                ds = 2
            } else if s.ch >= 48 + base and invalid < 0 {
                invalid = s.offset
            }
            sep = sep.bit_or(ds)
            next(s)
        }
    } else {
        while is_hex(s.ch) or s.ch == 95 {
            sep = sep.bit_or(if s.ch == 95 { 2 } else { 1 })
            next(s)
        }
    }
    return sep
}

/// Where a literal's `_` fails to sit between two digits, or -1.
fn invalid_sep(x: bytes) -> i64 {
    var x1 = 32
    var d = 46
    var i = 0
    if x.len() >= 2 and x.at(0) == 48 {
        x1 = lower(x.at(1))
        if x1 == 120 or x1 == 111 or x1 == 98 {
            d = 48
            i = 2
        }
    }
    while i < x.len() {
        let p = d
        d = x.at(i)
        if d == 95 {
            if p != 48 {
                return i
            }
        } else if is_decimal(d) or (x1 == 120 and is_hex(d)) {
            d = 48
        } else {
            if p == 95 {
                return i - 1
            }
            d = 46
        }
        i = i + 1
    }
    return if d == 95 { x.len() - 1 } else { 0 - 1 }
}

fn scan_number(inout s: GoScanner) -> (str, bytes) {
    let offs = s.offset
    var tok = "ILLEGAL"
    var base = 10
    var prefix = 0
    var sep = 0
    var invalid = 0 - 1
    if s.ch != 46 {
        tok = "INT"
        if s.ch == 48 {
            next(s)
            let l = lower(s.ch)
            if l == 120 or l == 111 or l == 98 {
                next(s)
                base = if l == 120 { 16 } else if l == 111 { 8 } else { 2 }
                prefix = l
            } else {
                base = 8
                prefix = 48
                sep = 1
            }
        }
        sep = sep.bit_or(digit_run(s, base, invalid))
    }
    if s.ch == 46 {
        tok = "FLOAT"
        if prefix == 111 or prefix == 98 {
            s.errors = s.errors + 1
        }
        next(s)
        sep = sep.bit_or(digit_run(s, base, invalid))
    }
    if sep.bit_and(1) == 0 {
        s.errors = s.errors + 1
    }
    let e = lower(s.ch)
    if e == 101 or e == 112 {
        if (e == 101 and prefix != 0 and prefix != 48) or (e == 112 and prefix != 120) {
            s.errors = s.errors + 1
        }
        next(s)
        tok = "FLOAT"
        if s.ch == 43 or s.ch == 45 {
            next(s)
        }
        var none = 0 - 1
        let ds = digit_run(s, 10, none)
        sep = sep.bit_or(ds)
        if ds.bit_and(1) == 0 {
            s.errors = s.errors + 1
        }
    } else if prefix == 120 and tok == "FLOAT" {
        s.errors = s.errors + 1
    }
    if s.ch == 105 {
        tok = "IMAG"
        next(s)
    }
    let lit = s.src.slice(offs, s.offset)
    if tok == "INT" and invalid >= 0 {
        s.errors = s.errors + 1
    }
    if sep.bit_and(2) != 0 and invalid_sep(lit) >= 0 {
        s.errors = s.errors + 1
    }
    return (tok, lit)
}

fn digit_val(ch: i64) -> i64 {
    if is_decimal(ch) {
        return ch - 48
    }
    if lower(ch) >= 97 and lower(ch) <= 102 {
        return lower(ch) - 87
    }
    return 16
}

fn scan_escape(inout s: GoScanner, quote: i64) -> bool {
    let c = s.ch
    var n = 0
    var base = 0
    var max = 0
    if c == quote or c == 97 or c == 98 or c == 102 or c == 110 or c == 114 or c == 116 or c == 118 or c == 92 {
        next(s)
        return true
    } else if c >= 48 and c <= 55 {
        n = 3
        base = 8
        max = 255
    } else if c == 120 or c == 117 or c == 85 {
        next(s)
        n = if c == 120 { 2 } else if c == 117 { 4 } else { 8 }
        base = 16
        max = if c == 120 { 255 } else { 1114111 }
    } else {
        s.errors = s.errors + 1
        return false
    }
    var x = 0
    while n > 0 {
        let d = digit_val(s.ch)
        if d >= base {
            s.errors = s.errors + 1
            return false
        }
        x = x * base + d
        next(s)
        n = n - 1
    }
    if x > max or (x >= 55296 and x < 57344) {
        s.errors = s.errors + 1
        return false
    }
    return true
}

fn scan_rune(inout s: GoScanner) -> bytes {
    let offs = s.offset - 1
    var valid = true
    var n = 0
    while true {
        let ch = s.ch
        if ch == 10 or ch < 0 {
            if valid {
                s.errors = s.errors + 1
                valid = false
            }
            break
        }
        next(s)
        if ch == 39 {
            break
        }
        n = n + 1
        if ch == 92 and not scan_escape(s, 39) {
            valid = false
        }
    }
    if valid and n != 1 {
        s.errors = s.errors + 1
    }
    return s.src.slice(offs, s.offset)
}

fn scan_string(inout s: GoScanner) -> bytes {
    let offs = s.offset - 1
    while true {
        let ch = s.ch
        if ch == 10 or ch < 0 {
            s.errors = s.errors + 1
            break
        }
        next(s)
        if ch == 34 {
            break
        }
        if ch == 92 {
            scan_escape(s, 34)
        }
    }
    return s.src.slice(offs, s.offset)
}

fn scan_raw(inout s: GoScanner) -> bytes {
    let offs = s.offset - 1
    var cr = false
    while true {
        let ch = s.ch
        if ch < 0 {
            s.errors = s.errors + 1
            break
        }
        next(s)
        if ch == 96 {
            break
        }
        if ch == 13 {
            cr = true
        }
    }
    let lit = s.src.slice(offs, s.offset)
    return if cr { strip_cr(lit, false) } else { lit }
}

fn keyword(lit: str) -> bool {
    for k in ["break", "case", "chan", "const", "continue", "default", "defer", "else", "fallthrough", "for", "func", "go", "goto", "if", "import",
        "interface", "map", "package", "range", "return", "select", "struct", "switch", "type", "var"] {
        if k == lit {
            return true
        }
    }
    return false
}

/// The operator starting with `first` (already consumed): (token, sets
/// insert_semi).
fn operator(inout s: GoScanner, first: i64) -> (str, bool) {
    let c = first.to_char()
    // Each operator is its first character, then at most two more drawn
    // from the forms Go has.
    let forms = ["+=", "++", "-=", "--", "*=", "/=", "%=", "^=", "<-", "<<=", "<<", "<=", ">>=", ">>", ">=", "==", "!=", "&^=", "&^", "&=", "&&", "|=",
        "||", ":=", "..."]
    var best = c
    for f in forms {
        if f.starts_with(c) and f.len() > best.len() {
            var ok = true
            for k in 1..f.len() {
                let want = f.to_bytes().at(k)
                let have = if k == 1 { s.ch } else if s.rd + k - 2 < s.src.len() { s.src.at(s.rd + k - 2) } else { 0 - 1 }
                if have != want {
                    ok = false
                }
            }
            if ok {
                best = f
            }
        }
    }
    for _k in 1..best.len() {
        next(s)
    }
    return (best, best == "++" or best == "--" or best == ")" or best == "]" or best == "}")
}

fn skip_space(inout s: GoScanner) {
    while s.ch == 32 or s.ch == 9 or (s.ch == 10 and not s.insert_semi) or s.ch == 13 {
        next(s)
    }
}

fn token(offset: i64, tok: str, lit: bytes) -> GoToken {
    return GoToken{ offset: offset, tok: tok, lit: lit }
}

/// One token: go/scanner's Scan.
fn scan(inout s: GoScanner) -> GoToken {
    if s.nl_pos >= 0 {
        let at = s.nl_pos
        s.nl_pos = 0 - 1
        return token(at, ";", "\n".to_bytes())
    }
    skip_space(s)
    let pos = s.offset
    let ch = s.ch
    var semi = false
    var out = token(pos, "", bytes_of([]))
    if is_letter(s, ch) {
        let from = s.offset
        while is_letter(s, s.ch) or is_digit(s, s.ch) {
            next(s)
        }
        let lit = s.src.slice(from, s.offset)
        let word = lit.to_str()
        let kw = lit.len() > 1 and keyword(word)
        semi = not kw or word == "break" or word == "continue" or word == "fallthrough" or word == "return"
        out = token(pos, if kw { word } else { "IDENT" }, lit)
    } else if is_decimal(ch) or (ch == 46 and is_decimal(peek(s))) {
        semi = true
        let (tok, lit) = scan_number(s)
        out = token(pos, tok, lit)
    } else {
        next(s)
        if ch < 0 {
            if s.insert_semi {
                s.insert_semi = false
                return token(pos, ";", "\n".to_bytes())
            }
            out = token(pos, "EOF", bytes_of([]))
        } else if ch == 10 {
            s.insert_semi = false
            return token(pos, ";", "\n".to_bytes())
        } else if ch == 34 {
            semi = true
            out = token(pos, "STRING", scan_string(s))
        } else if ch == 39 {
            semi = true
            out = token(pos, "CHAR", scan_rune(s))
        } else if ch == 96 {
            semi = true
            out = token(pos, "STRING", scan_raw(s))
        } else if ch == 59 {
            out = token(pos, ";", ";".to_bytes())
        } else if ch == 47 and (s.ch == 47 or s.ch == 42) {
            let (lit, nl) = scan_comment(s)
            if s.insert_semi and nl != 0 {
                s.nl_pos = nl
                s.insert_semi = false
            } else {
                semi = s.insert_semi
            }
            out = token(pos, "COMMENT", lit)
        } else if ch < 128 and "+-*/%^<>=!&|:.,()[]\{\}~".contains(ch.to_char()) {
            let (op, sets) = operator(s, ch)
            semi = sets
            out = token(pos, op, bytes_of([]))
        } else {
            if ch != 65279 {
                s.errors = s.errors + 1
            }
            semi = s.insert_semi
            out = token(pos, "ILLEGAL", bytes_of(utf8_of(ch)))
        }
    }
    s.insert_semi = semi
    return out
}

/// Every token of a Go source file, comments included, ending with EOF;
/// and how many errors go/scanner reports on the way.
pub fn tokens(src: bytes) -> ([GoToken], i64) {
    var s = GoScanner{ src: src, ch: 32, offset: 0, rd: 0, insert_semi: false, nl_pos: 0 - 1, errors: 0, letters: letter_ranges(), digits: digit_ranges() }
    next(s)
    if s.ch == 65279 {
        next(s)
    }
    var out: [GoToken] = []
    while true {
        let t = scan(s)
        out.push(t)
        if t.tok == "EOF" {
            break
        }
    }
    return (out, s.errors)
}

fn letter_ranges() -> [i64] {
    return [
        170, 170, 181, 181, 186, 186, 192, 214, 216, 246, 248, 705, 710, 721, 736, 740, 748, 748, 750, 750, 880, 884, 886, 887, 890, 893,
        895, 895, 902, 902, 904, 906, 908, 908, 910, 929, 931, 1013, 1015, 1153, 1162, 1327, 1329, 1366, 1369, 1369, 1376, 1416, 1488, 1514,
        1519, 1522, 1568, 1610, 1646, 1647, 1649, 1747, 1749, 1749, 1765, 1766, 1774, 1775, 1786, 1788, 1791, 1791, 1808, 1808, 1810, 1839,
        1869, 1957, 1969, 1969, 1994, 2026, 2036, 2037, 2042, 2042, 2048, 2069, 2074, 2074, 2084, 2084, 2088, 2088, 2112, 2136, 2144, 2154,
