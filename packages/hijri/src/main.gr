// END GENERATED

let UMALQURA = umalqura_starts()

fn floor_div(a: i64, b: i64) -> i64 {
    let q = a / b
    if a % b != 0 and ((a < 0) != (b < 0)) { q - 1 } else { q }
}

fn ceil_div(a: i64, b: i64) -> i64 {
    0 - floor_div(0 - a, b)
}

fn epoch(k: HijriKind) -> i64 {
    match k {
        Tabular -> 1948439
        _ -> 1948440
    }
}

fn year_start(year: i64) -> i64 {
    (year - 1) * 354 + floor_div(3 + 11 * year, 30)
}

fn month_start(year: i64, month0: i64) -> i64 {
    ceil_div(59 * month0, 2) + year_start(year)
}

fn arithmetic(k: HijriKind, d: i64) -> HijriDate {
    let days = d + 2440588 - epoch(k)
    let year = floor_div(30 * days + 10646, 10631)
    let month0 = ceil_div(2 * (days - 29 - year_start(year)), 59).min(11)
    HijriDate{ year: year, month: month0 + 1, day: days - month_start(year, month0) + 1 }
}

pub fn from_unix_day(k: HijriKind, d: i64) -> HijriDate {
    match k {
        UmmAlQura -> {
            let t = UMALQURA
            if t.len() == 0 or d < t[0] or d >= t[t.len() - 1] {
                return arithmetic(Civil, d)
            }
            var lo = 0
            var hi = t.len() - 1
            while hi - lo > 1 {
                let mid = (lo + hi) / 2
                if t[mid] <= d { lo = mid } else { hi = mid }
            }
            HijriDate{ year: 1300 + lo / 12, month: lo % 12 + 1, day: d - t[lo] + 1 }
        }
        _ -> arithmetic(k, d)
    }
}

pub fn to_unix_day(k: HijriKind, h: HijriDate) -> i64 {
    match k {
        UmmAlQura -> {
            let i = (h.year - 1300) * 12 + h.month - 1
            if h.year >= 1300 and h.year <= 1600 and UMALQURA.len() > i {
                return UMALQURA[i] + h.day - 1
            }
            to_unix_day(Civil, h)
        }
        _ -> month_start(h.year, h.month - 1) + h.day - 1 + epoch(k) - 2440588
    }
}

/// The number of days in a month.
pub fn month_length(k: HijriKind, year: i64, month: i64) -> i64 {
    let next = if month == 12 { HijriDate{ year: year + 1, month: 1, day: 1 } } else {
        HijriDate{ year: year, month: month + 1, day: 1 }
    }
    to_unix_day(k, next) - to_unix_day(k, HijriDate{ year: year, month: month, day: 1 })
}
