fn header_refuses(data: bytes) -> bool {
    match sqlitefile.header(data) {
        Ok(_v) -> return false
        Err(_e) -> return true
    }
}

fn check_sqlite(inout f: i64) / {io} {
    print("-- sqlitefile: pages, B-trees and serial types, without SQLite")
    let file = from_hex(tiny_database())
    let h = sqlitefile.header(file) ??
    SqlHeader{ page_size: 0, write_version: 0, read_version: 0,
        reserved: 0, page_count: 0, text_encoding: 0, schema_cookie: 0 }
    say(f, "the header gives the page size and the page count",
        h.page_size == 512 and h.page_count == 8)
    say(f, "and the text encoding, which has to be UTF-8 here",
        h.text_encoding == 1)
    say(f, "something that is not a database is refused",
        header_refuses("not a database at all, not even close!".to_bytes()))
    let objects = sqlitefile.objects(file) ?? []
    say(f, "sqlite_master lists both tables",
        objects.len() >= 2)
    say(f, "and the user tables can be named",
        (sqlitefile.table_names(file) ?? []) == ["notes", "empty"])
    say(f, "columns come from the CREATE TABLE text, as PRAGMA does",
        (sqlitefile.column_names(file, "notes") ?? []) ==
        ["id", "name", "score", "tag", "body"])
    let rows = sqlitefile.table_rows(file, "notes") ?? []
    say(f, "every row is read, across an interior page", rows.len() == 43)
    say(f, "an empty table has no rows",
        (sqlitefile.table_rows(file, "empty") ?? []).len() == 0)
    check_sqlite_values(f, file, rows)
}

fn check_sqlite_values(inout f: i64, file: bytes, rows: [SqlRow]) / {io} {
    say(f, "the serial types come back as themselves",
        sqlitefile.value_kind(rows[0].value[1]) == "text" and
        sqlitefile.value_kind(rows[0].value[2]) == "real" and
        sqlitefile.value_kind(rows[0].value[3]) == "blob" and
        sqlitefile.value_kind(rows[0].value[4]) == "null")
    say(f, "text is UTF-8, whatever is in it",
        sqlitefile.text_of(rows[1].value[1]) == "caf\u{e9} \u{4e2d}\u{6587}")
    say(f, "a float is a float", sqlitefile.float_of(rows[0].value[2]) == 1.5)
    say(f, "and a negative one keeps its sign",
        sqlitefile.float_of(rows[1].value[2]) == 0.0 - 0.25)
    say(f, "a blob keeps its bytes",
        sqlitefile.blob_of(rows[0].value[3]).to_list() == [1, 2, 255])
    say(f, "an empty blob is empty, not null",
        sqlitefile.blob_of(rows[1].value[3]).len() == 0 and
        not sqlitefile.is_null(rows[1].value[3]))
    // The overflow path.
    say(f, "a value too large for its page is reassembled from the overflow " +
        "chain",
        sqlitefile.text_of(rows[2].value[4]).len() == 1200)
    say(f, "and every byte of it is right",
        sqlitefile.text_of(rows[2].value[4]) == "x".repeat(1200))
    // The rowid trick.
    say(f, "an INTEGER PRIMARY KEY is stored as null in the record",
        sqlitefile.is_null(rows[0].value[0]))
    say(f, "because the rowid already holds it", rows[0].rowid == 1)
    say(f, "and reading it by name gives the rowid back",
        sqlitefile.int_of(sqlitefile.field(file, "notes", rows[2], "id") ??
            SqlNull) == 3)
    say(f, "the rows come out in rowid order",
        rows[0].rowid == 1 and rows[rows.len() - 1].rowid == 43)
    say(f, "and the last one is the last row inserted",
        sqlitefile.text_of(rows[rows.len() - 1].value[1]) == "n039")
    // The serial-type table.
    say(f, "the serial type widths are the format's",
        sqlitefile.serial_width(0) == 0 and sqlitefile.serial_width(5) == 6 and
        sqlitefile.serial_width(7) == 8 and sqlitefile.serial_width(14) == 1 and
        sqlitefile.serial_width(15) == 1)
    say(f, "a missing table is refused",
        rows_refuse(file, "nosuchtable"))
}

fn rows_refuse(file: bytes, name: str) -> bool {
    match sqlitefile.table_rows(file, name) {
        Ok(_v) -> return false
        Err(_e) -> return true
    }
}

fn main() / {io} {
    var f = 0

    check_escape(f)
    check_build(f)
    check_parse(f)
    check_schema(f)
    check_sqlite(f)

    if f == 0 {
        print("sql: every claim held")
    } else {
        print("sql: {f} failed")
    }
}
