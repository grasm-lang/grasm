// Go's build constraints, as Go 1.25's `go/build/constraint` reads them:
// `Parse` of `//go:build` and `// +build` lines, `Expr.String`, `Eval`,
// `PlusBuildLines`, `IsGoBuild`, `IsPlusBuild` and `GoVersion`.
//
// Every Go file can carry a `//go:build` line, and anything that decides
// which files a Go build would compile -- a build system, a linter, a
// code search index, a tool that keeps `// +build` lines in step -- needs
// Go's exact reading:
//
//   - `//go:build` must be followed by space (or nothing) and the
//     expression is `||`, `&&`, `!` and parentheses over tags made of
//     letters, digits, `_` and `.` (Unicode letters and digits as of Go's
//     Unicode 15.0). `!!x` is refused, and so is anything after a full
//     expression. Errors are Go's texts with Go's byte offsets into the
//     trimmed expression: `unexpected end of expression`, `missing close
//     paren`, `unexpected token X`, `invalid syntax at X`, `double
//     negation not allowed`, `build expression too large` (over 1000
//     terms).
//   - A `// +build` line is space-separated OR of comma-separated AND
//     clauses; a malformed word or `!!x` reads as the tag `ignore`, an
//     empty line is `ignore`, and more than 100 operators is `expression
//     too complex for // +build lines`.
//   - `String` parenthesizes only an `||` inside `&&` or `!`, and an
//     `&&` inside `||` or `!`.
//   - `Eval` asks about every tag, left to right, even when the answer is
//     already decided; `eval_trace` returns those questions in order.
//   - `PlusBuildLines` pushes negations down to tags and writes one line
//     per AND-term (all on one line when no term has an OR), or refuses
//     with `expression too complex for // +build lines`.
//   - `GoVersion` is the minimum `go1.N` the expression implies, read
//     from the first `go1.` in a tag with Go's `strconv.Atoi`, "" if none.
//
// Lines are Go strings: `parse_bytes` takes bytes that need not be UTF-8,
// where a bad byte reads as U+FFFD as Go's decoder reads it.

type GoConstraint =
    | GoConstraintTag(name: str)
    | GoConstraintNot(x: GoConstraint)
    | GoConstraintAnd(x: GoConstraint, y: GoConstraint)
    | GoConstraintOr(x: GoConstraint, y: GoConstraint)

type GoConstraintError =
    | GoConstraintSyntax(offset: i64, message: str)
    | GoConstraintNotConstraint
    | GoConstraintTooComplex

/// The error's text, as Go's `Error()` gives it.
pub fn error_text(e: GoConstraintError) -> str {
    return match e {
        GoConstraintSyntax(_o, m) -> m
        GoConstraintNotConstraint -> "not a build constraint"
        GoConstraintTooComplex -> "expression too complex for // +build lines"
    }
}

/// A syntax error's byte offset into the expression; -1 for the others.
pub fn error_offset(e: GoConstraintError) -> i64 {
    return match e {
        GoConstraintSyntax(o, _m) -> o
        GoConstraintNotConstraint -> 0 - 1
        GoConstraintTooComplex -> 0 - 1
    }
}

fn in_ranges(t: [i64], r: i64) -> bool {
    var lo = 0
    var hi = t.len() / 2 - 1
    while lo <= hi {
        let mid = (lo + hi) / 2
        if r < t[2 * mid] {
            hi = mid - 1
        } else if r > t[2 * mid + 1] {
            lo = mid + 1
        } else {
            return true
        }
    }
    return false
}

/// `unicode.IsSpace`.
fn is_space(r: i64) -> bool {
    if r < 256 {
        return (r >= 9 and r <= 13) or r == 32 or r == 133 or r == 160
    }
    return r == 5760 or (r >= 8192 and r <= 8202) or r == 8232 or r == 8233 or r == 8239 or r == 8287 or r == 12288
}

/// `utf8.DecodeRune` at `i`: the rune and its width; U+FFFD and 1 for a
/// byte that does not start a valid sequence.
fn decode(b: [i64], i: i64) -> (i64, i64) {
    let c0 = b[i]
    if c0 < 128 {
        return (c0, 1)
    }
    let n = b.len() - i
    let bad = (65533, 1)
    if c0 < 194 or c0 > 244 {
        return bad
    }
    if c0 < 224 {
        if n < 2 or b[i + 1] < 128 or b[i + 1] > 191 {
            return bad
        }
        return (c0.bit_and(31).shl(6).bit_or(b[i + 1].bit_and(63)), 2)
    }
    let lo = if c0 == 224 { 160 } else if c0 == 240 { 144 } else { 128 }
    let hi = if c0 == 237 { 159 } else if c0 == 244 { 143 } else { 191 }
    if n < 2 or b[i + 1] < lo or b[i + 1] > hi {
        return bad
    }
    if n < 3 or b[i + 2] < 128 or b[i + 2] > 191 {
        return bad
    }
    if c0 < 240 {
        return (c0.bit_and(15).shl(12).bit_or(b[i + 1].bit_and(63).shl(6)).bit_or(b[i + 2].bit_and(63)), 3)
    }
    if n < 4 or b[i + 3] < 128 or b[i + 3] > 191 {
        return bad
    }
    return (c0.bit_and(7).shl(18).bit_or(b[i + 1].bit_and(63).shl(12)).bit_or(b[i + 2].bit_and(63).shl(6)).bit_or(b[i + 3].bit_and(63)), 4)
}

fn text(b: [i64]) -> str {
    return bytes_of(b).to_str()
}

/// The bytes of `b` from `lo` up to `hi`, trimmed of `unicode.IsSpace`
/// at both ends, as `strings.TrimSpace` does.
fn trim_space(b: [i64]) -> [i64] {
    var lo = 0
    while lo < b.len() {
        let (r, w) = decode(b, lo)
        if not is_space(r) {
            break
        }
        lo = lo + w
    }
    var hi = b.len()
    while hi > lo {
        // Walk back to the start of the last rune, as DecodeLastRune does.
        var start = hi - 1
        var k = 0
        while start > lo and k < 3 and b[start] >= 128 and b[start] < 192 {
            start = start - 1
            k = k + 1
        }
        let (r, w) = decode(b, start)
        let (rr, ww) = if start + w == hi { (r, w) } else { (65533, 1) }
        if not is_space(rr) {
            break
        }
        hi = hi - ww
    }
    return b.slice(lo, hi)
}

fn has_prefix(b: [i64], p: str) -> bool {
    let pb = p.to_bytes().to_list()
    return b.len() >= pb.len() and b.slice(0, pb.len()) == pb
}

fn one_line(line: [i64]) -> Option[[i64]] {
    var b = line
    if b.len() > 0 and b[b.len() - 1] == 10 {
        b = b.slice(0, b.len() - 1)
    }
    if b.contains(10) {
        return None
    }
    return Some(b)
}

/// The expression after a `//go:build` prefix, `None` if the line is not one.
fn split_go_build(line: [i64]) -> Option[[i64]] {
    let b = one_line(line) ?? [0 - 1]
    if b == [0 - 1] or not has_prefix(b, "//go:build") {
        return None
    }
    let rest = trim_space(b).slice(10, b.len())
    let trim = trim_space(rest)
    if rest.len() == trim.len() and rest.len() > 0 {
        return None
    }
    return Some(trim)
}

/// The expression after a `// +build` prefix, `None` if the line is not one.
fn split_plus_build(line: [i64]) -> Option[[i64]] {
    let b = one_line(line) ?? [0 - 1]
    if b == [0 - 1] or not has_prefix(b, "//") {
        return None
    }
    let body = trim_space(b.slice(2, b.len()))
    if not has_prefix(body, "+build") {
        return None
    }
    let rest = body.slice(6, body.len())
    let trim = trim_space(rest)
    if rest.len() == trim.len() and rest.len() > 0 {
        return None
    }
    return Some(trim)
}

/// `constraint.IsGoBuild`.
pub fn is_go_build_bytes(line: bytes) -> bool {
    return split_go_build(line.to_list()).is_some()
}

/// `constraint.IsGoBuild`.
pub fn is_go_build(line: str) -> bool {
    return is_go_build_bytes(line.to_bytes())
}

/// `constraint.IsPlusBuild`.
pub fn is_plus_build_bytes(line: bytes) -> bool {
    return split_plus_build(line.to_list()).is_some()
}

/// `constraint.IsPlusBuild`.
pub fn is_plus_build(line: str) -> bool {
    return is_plus_build_bytes(line.to_bytes())
}

// ---- the //go:build expression parser

type GoConstraintParser = {
    s: [i64],
    i: i64,
    tok: str,
    is_tag: bool,
    pos: i64,
    size: i64,
    letters: [i64],
    digits: [i64],
}

fn tag_char(p: GoConstraintParser, c: i64) -> bool {
    if c < 128 {
        return (c >= 48 and c <= 57) or (c >= 65 and c <= 90) or (c >= 97 and c <= 122) or c == 95 or c == 46
    }
    return in_ranges(p.letters, c) or in_ranges(p.digits, c)
}

fn syntax(offset: i64, message: str) -> GoConstraintError {
    return GoConstraintSyntax(offset, message)
}

fn lex(inout p: GoConstraintParser) -> () ! GoConstraintError {
    p.is_tag = false
    while p.i < p.s.len() and (p.s[p.i] == 32 or p.s[p.i] == 9) {
        p.i = p.i + 1
    }
    if p.i >= p.s.len() {
        p.tok = ""
        p.pos = p.i
        return
    }
    let c = p.s[p.i]
    if c == 40 or c == 41 or c == 33 {
        p.pos = p.i
        p.i = p.i + 1
        p.tok = c.to_char()
        return
    }
    if c == 38 or c == 124 {
        if p.i + 1 >= p.s.len() or p.s[p.i + 1] != c {
            fail(syntax(p.i, "invalid syntax at " + c.to_char()))
        }
        p.pos = p.i
        p.i = p.i + 2
        p.tok = c.to_char() + c.to_char()
        return
    }
    var j = p.i
    while j < p.s.len() {
        let (r, w) = decode(p.s, j)
        if not tag_char(p, r) {
            break
        }
        j = j + w
    }
    if j == p.i {
        let (r, _w) = decode(p.s, p.i)
        fail(syntax(p.i, "invalid syntax at " + r.to_char()))
    }
    p.pos = p.i
    p.tok = text(p.s.slice(p.i, j))
    p.i = j
    p.is_tag = true
}

fn parse_or(inout p: GoConstraintParser) -> GoConstraint ! GoConstraintError {
    var x = try parse_and(p)
    while p.tok == "||" {
        let y = try parse_and(p)
        x = GoConstraintOr(x, y)
    }
    return x
}

fn parse_and(inout p: GoConstraintParser) -> GoConstraint ! GoConstraintError {
    var x = try parse_not(p)
    while p.tok == "&&" {
        let y = try parse_not(p)
        x = GoConstraintAnd(x, y)
    }
    return x
}

fn parse_not(inout p: GoConstraintParser) -> GoConstraint ! GoConstraintError {
    p.size = p.size + 1
    if p.size > 1000 {
        fail(syntax(p.pos, "build expression too large"))
    }
    try lex(p)
    if p.tok == "!" {
        try lex(p)
        if p.tok == "!" {
            fail(syntax(p.pos, "double negation not allowed"))
        }
        let x = try parse_atom(p)
        return GoConstraintNot(x)
    }
    return try parse_atom(p)
}

/// Go turns an "unexpected end of expression" inside parentheses into
/// "missing close paren", keeping its offset.
fn in_paren(e: GoConstraintError) -> GoConstraintError {
    return match e {
        GoConstraintSyntax(o, m) -> if m == "unexpected end of expression" { GoConstraintSyntax(o, "missing close paren") } else { e }
        GoConstraintNotConstraint -> e
        GoConstraintTooComplex -> e
    }
}

fn parse_paren(inout p: GoConstraintParser) -> GoConstraint ! GoConstraintError {
    let pos = p.pos
    let x = try parse_or(p)
    if p.tok != ")" {
        fail(syntax(pos, "missing close paren"))
    }
    try lex(p)
    return x
}

fn parse_atom(inout p: GoConstraintParser) -> GoConstraint ! GoConstraintError {
    if p.tok == "(" {
        return match parse_paren(p) {
            Ok(x) -> x
            Err(e) -> fail(in_paren(e))
        }
    }
    if not p.is_tag {
        if p.tok == "" {
            fail(syntax(p.pos, "unexpected end of expression"))
        }
        fail(syntax(p.pos, "unexpected token " + p.tok))
    }
    let t = p.tok
    try lex(p)
    return GoConstraintTag(t)
}

fn parse_expr(s: [i64]) -> GoConstraint ! GoConstraintError {
    var p = GoConstraintParser{ s: s, i: 0, tok: "", is_tag: false, pos: 0, size: 0, letters: letter_ranges(), digits: digit_ranges() }
    let x = try parse_or(p)
    if p.tok != "" {
        fail(syntax(p.pos, "unexpected token " + p.tok))
    }
    return x
}

// ---- the // +build expression

fn valid_tag(word: [i64], letters: [i64], digits: [i64]) -> bool {
    if word.len() == 0 {
        return false
    }
    let p = GoConstraintParser{ s: [], i: 0, tok: "", is_tag: false, pos: 0, size: 0, letters: letters, digits: digits }
    var j = 0
    while j < word.len() {
        let (r, w) = decode(word, j)
        if not tag_char(p, r) {
            return false
        }
        j = j + w
    }
    return true
}

/// `strings.Fields`: the runs between `unicode.IsSpace` runes.
fn fields(b: [i64]) -> [[i64]] {
    var out: [[i64]] = []
    var start = 0 - 1
    var j = 0
    while j < b.len() {
        let (r, w) = decode(b, j)
        if is_space(r) {
            if start >= 0 {
                out.push(b.slice(start, j))
                start = 0 - 1
            }
        } else if start < 0 {
            start = j
        }
        j = j + w
    }
    if start >= 0 {
        out.push(b.slice(start, b.len()))
    }
    return out
}

fn split_commas(b: [i64]) -> [[i64]] {
    var out: [[i64]] = []
    var start = 0
    for j in 0..b.len() {
        if b[j] == 44 {
            out.push(b.slice(start, j))
            start = j + 1
        }
    }
    out.push(b.slice(start, b.len()))
    return out
}

fn plus_literal(lit: [i64], letters: [i64], digits: [i64]) -> GoConstraint {
    if has_prefix(lit, "!!") or lit == [33] {
        return GoConstraintTag("ignore")
    }
    let neg = has_prefix(lit, "!")
    let word = if neg { lit.slice(1, lit.len()) } else { lit }
    let z = if valid_tag(word, letters, digits) { GoConstraintTag(text(word)) } else { GoConstraintTag("ignore") }
    return if neg { GoConstraintNot(z) } else { z }
}

fn parse_plus(s: [i64]) -> GoConstraint ! GoConstraintError {
    let letters = letter_ranges()
    let digits = digit_ranges()
    var size = 0
    var x: Option[GoConstraint] = None
    for clause in fields(s) {
        var y: Option[GoConstraint] = None
        for lit in split_commas(clause) {
            let z = plus_literal(lit, letters, digits)
            y = match y {
                None -> Some(z)
                Some(prev) -> {
                    size = size + 1
                    if size > 100 {
                        fail(GoConstraintTooComplex)
                    }
                    Some(GoConstraintAnd(prev, z))
                }
            }
        }
        let yy = y ?? GoConstraintTag("ignore")
        x = match x {
            None -> Some(yy)
            Some(prev) -> {
                size = size + 1
                if size > 100 {
                    fail(GoConstraintTooComplex)
                }
                Some(GoConstraintOr(prev, yy))
            }
        }
    }
    return x ?? GoConstraintTag("ignore")
}

/// `constraint.Parse` of a line that may hold any bytes.
pub fn parse_bytes(line: bytes) -> GoConstraint ! GoConstraintError {
    let b = line.to_list()
    match split_go_build(b) {
        Some(t) -> return try parse_expr(t)
        None -> {}
    }
    match split_plus_build(b) {
        Some(t) -> return try parse_plus(t)
        None -> {}
    }
    fail(GoConstraintNotConstraint)
}

/// `constraint.Parse`: a `//go:build` or `// +build` line, with or
/// without its trailing newline.
pub fn parse(line: str) -> GoConstraint ! GoConstraintError {
    return try parse_bytes(line.to_bytes())
}

// ---- what an expression says

/// `Expr.String`.
pub fn to_str(x: GoConstraint) -> str {
    return match x {
        GoConstraintTag(t) -> t
        GoConstraintNot(y) -> "!" + match y {
            GoConstraintAnd(_a, _b) -> "(" + to_str(y) + ")"
            GoConstraintOr(_a, _b) -> "(" + to_str(y) + ")"
            GoConstraintTag(_t) -> to_str(y)
            GoConstraintNot(_z) -> to_str(y)
        }
        GoConstraintAnd(a, b) -> and_arg(a) + " && " + and_arg(b)
        GoConstraintOr(a, b) -> or_arg(a) + " || " + or_arg(b)
    }
}

fn and_arg(x: GoConstraint) -> str {
    return match x {
        GoConstraintOr(_a, _b) -> "(" + to_str(x) + ")"
        GoConstraintAnd(_a, _b) -> to_str(x)
        GoConstraintTag(_t) -> to_str(x)
        GoConstraintNot(_y) -> to_str(x)
    }
}

fn or_arg(x: GoConstraint) -> str {
    return match x {
        GoConstraintAnd(_a, _b) -> "(" + to_str(x) + ")"
        GoConstraintOr(_a, _b) -> to_str(x)
        GoConstraintTag(_t) -> to_str(x)
        GoConstraintNot(_y) -> to_str(x)
    }
}

fn trace(x: GoConstraint, tags: [str], inout asked: [str]) -> bool {
    return match x {
        GoConstraintTag(t) -> {
            asked.push(t)
            tags.contains(t)
        }
        GoConstraintNot(y) -> not trace(y, tags, asked)
        GoConstraintAnd(a, b) -> {
            let l = trace(a, tags, asked)
            let r = trace(b, tags, asked)
            l and r
        }
        GoConstraintOr(a, b) -> {
            let l = trace(a, tags, asked)
            let r = trace(b, tags, asked)
            l or r
        }
    }
}

/// `Expr.Eval` with `ok` answering whether a tag is in `tags`, and the
/// tags `ok` was asked about, in order: Go evaluates both sides of every
/// `&&` and `||`.
pub fn eval_trace(x: GoConstraint, tags: [str]) -> (bool, [str]) {
    var asked: [str] = []
    let v = trace(x, tags, asked)
    return (v, asked)
}

/// `Expr.Eval` with `ok` answering whether a tag is in `tags`.
pub fn eval(x: GoConstraint, tags: [str]) -> bool {
    return eval_trace(x, tags).0
}

fn push_not(x: GoConstraint, negate: bool) -> GoConstraint {
    return match x {
        GoConstraintNot(y) -> match y {
            GoConstraintTag(_t) -> if negate { y } else { x }
            GoConstraintNot(_z) -> push_not(y, not negate)
            GoConstraintAnd(_a, _b) -> push_not(y, not negate)
            GoConstraintOr(_a, _b) -> push_not(y, not negate)
        }
        GoConstraintTag(_t) -> if negate { GoConstraintNot(x) } else { x }
        GoConstraintAnd(a, b) -> if negate { GoConstraintOr(push_not(a, true), push_not(b, true)) } else { GoConstraintAnd(push_not(a, false), push_not(b, false)) }
        GoConstraintOr(a, b) -> if negate { GoConstraintAnd(push_not(a, true), push_not(b, true)) } else { GoConstraintOr(push_not(a, false), push_not(b, false)) }
    }
}

fn split_and(x: GoConstraint, inout out: [GoConstraint]) {
    match x {
        GoConstraintAnd(a, b) -> {
            split_and(a, out)
            split_and(b, out)
        }
        GoConstraintOr(_a, _b) -> out.push(x)
        GoConstraintTag(_t) -> out.push(x)
        GoConstraintNot(_y) -> out.push(x)
    }
}

fn split_or(x: GoConstraint, inout out: [GoConstraint]) {
    match x {
        GoConstraintOr(a, b) -> {
            split_or(a, out)
            split_or(b, out)
        }
        GoConstraintAnd(_a, _b) -> out.push(x)
        GoConstraintTag(_t) -> out.push(x)
        GoConstraintNot(_y) -> out.push(x)
    }
}

fn is_literal(x: GoConstraint) -> bool {
    return match x {
        GoConstraintTag(_t) -> true
        GoConstraintNot(_y) -> true
        GoConstraintAnd(_a, _b) -> false
        GoConstraintOr(_a, _b) -> false
    }
}

fn clause_text(lits: [GoConstraint]) -> str {
    return lits.map(|l| to_str(l)).join(",")
}

/// `constraint.PlusBuildLines`: the `// +build` lines that say what `x`
/// says, or `GoConstraintTooComplex` when an OR sits inside an AND inside
/// an OR.
pub fn plus_build_lines(x: GoConstraint) -> [str] ! GoConstraintError {
    var ands: [GoConstraint] = []
    split_and(push_not(x, false), ands)
    var split: [[[GoConstraint]]] = []
    var max_or = 0
    for a in ands {
        var ors: [GoConstraint] = []
        split_or(a, ors)
        var terms: [[GoConstraint]] = []
        for o in ors {
            var lits: [GoConstraint] = []
            split_and(o, lits)
            if not lits.all(|l| is_literal(l)) {
                fail(GoConstraintTooComplex)
            }
            terms.push(lits)
        }
        max_or = max_or.max(terms.len())
        split.push(terms)
    }
    if max_or == 1 {
        var all: [GoConstraint] = []
        for terms in split {
            for l in terms[0] {
                all.push(l)
            }
        }
        return ["// +build " + clause_text(all)]
    }
    return split.map(|terms| "// +build" + terms.map(|t| " " + clause_text(t)).join(""))
}

fn atoi(s: str) -> Option[i64] {
    if s.len() == 0 {
        return None
    }
    var v = 0
    for c in s.codes() {
        if c < 48 or c > 57 {
            return None
        }
        if v > (9223372036854775807 - (c - 48)) / 10 {
            return None
        }
        v = v * 10 + (c - 48)
    }
    return Some(v)
}

fn min_version(x: GoConstraint, sign: i64) -> i64 {
    return match x {
        GoConstraintAnd(a, b) -> {
            let l = min_version(a, sign)
            let r = min_version(b, sign)
            if sign < 0 { l.min(r) } else { l.max(r) }
        }
        GoConstraintOr(a, b) -> {
            let l = min_version(a, sign)
            let r = min_version(b, sign)
            if sign < 0 { l.max(r) } else { l.min(r) }
        }
        GoConstraintNot(y) -> min_version(y, 0 - sign)
        GoConstraintTag(t) -> tag_version(t, sign)
    }
}

fn tag_version(t: str, sign: i64) -> i64 {
    if sign < 0 {
        return 0 - 1
    }
    if t == "go1" {
        return 0
    }
    let v = match t.index_of("go1.") {
        Some(at) -> t.substr(at + 4, t.len())
        None -> ""
    }
    return atoi(v) ?? (0 - 1)
}

/// `constraint.GoVersion`: the oldest Go version `x` allows, `go1` or
/// `go1.N`, or "" when it names none.
pub fn go_version(x: GoConstraint) -> str {
    let v = min_version(x, 1)
    if v < 0 {
        return ""
    }
    if v == 0 {
        return "go1"
    }
    return "go1." + v.to_str()
}

// ---- Go's unicode.IsLetter and unicode.IsDigit beyond ASCII (Unicode 15.0)

fn letter_ranges() -> [i64] {
