// CP932: the Shift-JIS Windows actually writes.
//
// `packages/shiftjis` is Shift-JIS as JIS defined it. Almost no file in the
// world that calls itself Shift-JIS is that. Windows has written CP932
// since the 1990s, macOS and Linux tools read it under the same name, and
// the HTML standard says a page labelled `shift_jis` is to be decoded as
// this. A reader that follows the JIS table instead gets two things wrong,
// and both show up in real documents.
//
// **The extensions.** CP932 adds NEC's row 13 — circled numbers, Roman
// numerals, unit symbols like ㍉ and ㌔ — and IBM's extended kanji, several
// hundred characters that appear in Japanese business documents constantly.
// JIS Shift-JIS has no bytes for them; a strict reader refuses the file.
//
// **Six characters that map differently.** JIS maps `0x8160` to WAVE DASH
// (U+301C); Microsoft maps it to FULLWIDTH TILDE (U+FF5E). The same split
// happens for the double vertical line, the minus sign, and ¢ £ ¬. So text
// round-tripped through one table and read with the other acquires the
// wrong character — invisibly in most fonts, which is why the "wave dash
// problem" has its own Wikipedia article. The encoder here accepts both
// spellings and writes the bytes Windows writes, because that is what
// Python's own codec does.
//
// The tables are generated by `scripts/gen_dbcs.py` from Python's `cp932`
// codec, not typed out, and the gate checks every character both ways.

type Cp932Error =
    | Cp932Invalid(at: i64, byte: i64)
    | Cp932Truncated(at: i64)
    | Cp932Unencodable(at: i64, codepoint: i64)

/// A prepared reverse table, built once for a document rather than
/// searched for every character.
type Cp932Encoder = { map: Map[i64, i64] }

let WIDTH = 4

fn leads() -> [i64] {
    return [129, 130, 131, 132, 135, 136, 137, 138, 139, 140, 141, 142, 143, 144, 145, 146, 147, 148, 149, 150, 151, 152, 153, 154, 155, 156, 157, 158, 159, 224, 225, 226, 227, 228, 229, 230, 231, 232, 233, 234, 237, 238, 240, 241, 242, 243, 244, 245, 246, 247, 248, 249, 250, 251, 252]
}

/// One row per lead byte, one entry per trail byte from 0x40 to 0xFF,
/// 4 hexadecimal digits each, 0 where the pair is not a character.
fn rows() -> [str] {
    return [
        "",
        "",
        "",
        "",
        "",
        "",
        "",
        "",
        "",
        "",
        "",
        "",
        "",
        "",
        "",
        "",
        "",
        "",
        "",
        "",
        "",
        "",
        "",
        "",
        "",
        "",
        "",
        "",
        "",
        "",
        "",
        "",
        "",
        "",
        "",
        "",
        "",
        "",
        "",
        "",
        "",
        "",
        "",
        "",
        "",
        "",
        "",
        "",
        "",
        "",
        "",
        "",
        "",
        "",
        "",
    ]
}

/// The bytes that are a character on their own above 0x7F, as
/// `byte:codepoint` in hexadecimal.
fn packed_singles() -> str {
    return "80:80 a0:f8f0 a1:ff61 a2:ff62 a3:ff63 a4:ff64 a5:ff65 " +
    "a6:ff66 a7:ff67 a8:ff68 a9:ff69 aa:ff6a ab:ff6b ac:ff6c " +
    "ad:ff6d ae:ff6e af:ff6f b0:ff70 b1:ff71 b2:ff72 b3:ff73 " +
    "b4:ff74 b5:ff75 b6:ff76 b7:ff77 b8:ff78 b9:ff79 ba:ff7a " +
    "bb:ff7b bc:ff7c bd:ff7d be:ff7e bf:ff7f c0:ff80 c1:ff81 " +
    "c2:ff82 c3:ff83 c4:ff84 c5:ff85 c6:ff86 c7:ff87 c8:ff88 " +
    "c9:ff89 ca:ff8a cb:ff8b cc:ff8c cd:ff8d ce:ff8e cf:ff8f " +
    "d0:ff90 d1:ff91 d2:ff92 d3:ff93 d4:ff94 d5:ff95 d6:ff96 " +
    "d7:ff97 d8:ff98 d9:ff99 da:ff9a db:ff9b dc:ff9c dd:ff9d " +
    "de:ff9e df:ff9f fd:f8f1 fe:f8f2 ff:f8f3 "
}

/// Pairs that decode to more than one code point, as
/// `pair:codepoint,codepoint`.
fn packed_sequences() -> str {
    return ""
}

/// Code points whose encoding is not the first pair that decodes to
/// them, taken from what the reference encoder actually writes, as
/// `codepoint:pair`.
fn packed_preferred() -> str {
    return "a2:8191 a3:8192 ac:81ca 2016:8161 2212:817c 301c:8160 "
}


fn hex_value(text: str) -> i64 {
    return text.parse_int_base(16) ?? 0
}

fn load_pairs(packed: str) -> Map[i64, i64] {
    var out: Map[i64, i64] = {}
    for entry in packed.split(" ") {
        let cut = entry.index_of(":") ?? -1
        if cut < 0 {
            continue
        }
        out.set(hex_value(entry.substr(0, cut)),
            hex_value(entry.substr(cut + 1, entry.len() - cut - 1)))
    }
    return out
}

fn load_sequences(packed: str) -> Map[i64, [i64]] {
    var out: Map[i64, [i64]] = {}
    for entry in packed.split(" ") {
        let cut = entry.index_of(":") ?? -1
        if cut < 0 {
            continue
        }
        var codes: [i64] = []
        for piece in entry.substr(cut + 1, entry.len() - cut - 1).split(",") {
            codes.push(hex_value(piece))
        }
        out.set(hex_value(entry.substr(0, cut)), codes)
    }
    return out
}

let SINGLES: Map[i64, i64] = load_pairs(packed_singles())
let SEQUENCES: Map[i64, [i64]] = load_sequences(packed_sequences())
let PREFERRED: Map[i64, i64] = load_pairs(packed_preferred())

fn lead_index(lead: i64) -> i64 {
    var i = 0
    for candidate in leads() {
        if candidate == lead {
            return i
        }
        i = i + 1
    }
    return 0 - 1
}

/// Whether a byte starts a two-byte character.
pub fn is_lead(byte: i64) -> bool {
    return lead_index(byte) >= 0
}

/// The code point a lead and trail byte stand for, or -1.
pub fn pair_to_code(lead: i64, trail: i64) -> i64 {
    let row = lead_index(lead)
    if row < 0 or trail < 64 or trail > 255 {
        return 0 - 1
    }
    let column = trail - 64
    let code = hex_value(rows()[row].substr(column * WIDTH, WIDTH))
    if code == 0 {
        return 0 - 1
    }
    return code
}

/// Bytes to text.
pub fn decode(data: bytes) -> str ! Cp932Error {
    var out = ""
    var at = 0
    while at < data.len() {
        let b = data.at(at)
        if b < 128 {
            out = out + b.to_char()
            at = at + 1
            continue
        }
        match SINGLES.get(b) {
            Some(code) -> {
                out = out + code.to_char()
                at = at + 1
                continue
            }
            None -> {}
        }
        if not is_lead(b) {
            fail(Cp932Invalid(at, b))
        }
        if at + 1 >= data.len() {
            fail(Cp932Truncated(at))
        }
        let trail = data.at(at + 1)
        match SEQUENCES.get(b * 256 + trail) {
            Some(codes) -> {
                for code in codes {
                    out = out + code.to_char()
                }
                at = at + 2
                continue
            }
            None -> {}
        }
        let code = pair_to_code(b, trail)
        if code < 0 {
            fail(Cp932Invalid(at, b))
        }
        out = out + code.to_char()
        at = at + 2
    }
    return out
}

/// A reverse table, built once: the first pair in table order for each code
/// point, then the reference encoder's own preferences on top.
pub fn encoder() -> Cp932Encoder {
    var out: Map[i64, i64] = {}
    var row = 0
    for text in rows() {
        let lead = leads()[row]
        var column = 0
        while column * WIDTH < text.len() {
            let code = hex_value(text.substr(column * WIDTH, WIDTH))
            if code != 0 and not out.has(code) {
                out.set(code, lead * 256 + 64 + column)
            }
            column = column + 1
        }
        row = row + 1
    }
    for entry in SINGLES.entries() {
        if not out.has(entry.1) {
            out.set(entry.1, entry.0)
        }
    }
    for entry in PREFERRED.entries() {
        out.set(entry.0, entry.1)
    }
    return Cp932Encoder{ map: out }
}

/// The pair a two-code-point sequence encodes to, when there is one.
fn sequence_pair(first: i64, second: i64) -> i64 {
    for entry in SEQUENCES.entries() {
        if entry.1.len() == 2 and entry.1[0] == first and
        entry.1[1] == second {
            return entry.0
        }
    }
    return 0 - 1
}

/// Text to bytes, with a prepared table.
pub fn encode_with(table: Cp932Encoder, text: str) -> bytes ! Cp932Error {
    var out: [i64] = []
    let codes = text.codes()
    var at = 0
    while at < codes.len() {
        let code = codes[at]
        if code < 128 {
            out.push(code)
            at = at + 1
            continue
        }
        // A base letter and a combining mark may have a pair of their own,
        // which wins over encoding the two separately.
        if at + 1 < codes.len() {
            let joined = sequence_pair(code, codes[at + 1])
            if joined >= 0 {
                out.push(joined / 256)
                out.push(joined % 256)
                at = at + 2
                continue
            }
        }
        match table.map.get(code) {
            Some(packed) -> {
                if packed < 256 {
                    out.push(packed)
                } else {
                    out.push(packed / 256)
                    out.push(packed % 256)
                }
            }
            None -> fail(Cp932Unencodable(at, code))
        }
        at = at + 1
    }
    return bytes_of(out)
}

/// Text to bytes, building the table first.
pub fn encode(text: str) -> bytes ! Cp932Error {
    return try encode_with(encoder(), text)
}

/// Whether every character can be written.
pub fn is_encodable(text: str) -> bool {
    match encode(text) {
        Ok(_data) -> return true
        Err(_e) -> return false
    }
}

/// Whether every byte sequence is a valid character.
pub fn is_valid(data: bytes) -> bool {
    match decode(data) {
        Ok(_text) -> return true
        Err(_e) -> return false
    }
}

/// How many two-byte characters the table holds.
pub fn table_size() -> i64 {
    var count = 0
    for text in rows() {
        var column = 0
        while column * WIDTH < text.len() {
            if hex_value(text.substr(column * WIDTH, WIDTH)) != 0 {
                count = count + 1
            }
            column = column + 1
        }
    }
    return count
}
