// END GENERATED

let CHINA = chinese_months()
let KOREA = korean_months()

fn table(k: LunisolarKind) -> [i64] {
    match k {
        China -> CHINA
        Korea -> KOREA
    }
}

pub fn from_unix_day(k: LunisolarKind, d: i64) -> Option[ChineseDate] {
    let t = table(k)
    let n = t.len() / 4
    if n < 2 or d < t[0] or d >= t[4 * (n - 1)] {
        return None
    }
    var lo = 0
    var hi = n - 1
    while hi - lo > 1 {
        let mid = (lo + hi) / 2
        if t[4 * mid] <= d { lo = mid } else { hi = mid }
    }
    Some(ChineseDate{ related_year: t[4 * lo + 1], month: t[4 * lo + 2], leap: t[4 * lo + 3] == 1, day: d - t[4 * lo] + 1 })
}

pub fn to_unix_day(k: LunisolarKind, c: ChineseDate) -> Option[i64] {
    let t = table(k)
    for i in 0..t.len() / 4 - 1 {
        if t[4 * i + 1] == c.related_year and t[4 * i + 2] == c.month and (t[4 * i + 3] == 1) == c.leap {
            return Some(t[4 * i] + c.day - 1)
        }
    }
    None
}
