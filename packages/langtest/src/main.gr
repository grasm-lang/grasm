import jsnumber
import tcllist
import luaformat
import rubymarshal
import perlpack
import bigint

fn from_hex_bytes(text: str) -> bytes {
    var out: [i64] = []
    var i = 1
    while i + 1 < text.len() {
        out.push(text.substr(i, 2).parse_int_base(16) ?? 0)
        i = i + 2
    }
    return bytes_of(out)
}

fn hex(raw: bytes) -> str {
    let digits = "0123456789abcdef"
    var out = ""
    var i = 0
    while i < raw.len() {
        out = out + digits.substr(raw.at(i) / 16, 1) +
        digits.substr(raw.at(i) % 16, 1)
        i = i + 1
    }
    return out
}

fn th(text: str) -> str {
    return hex(text.to_bytes())
}

fn parts(text: str) -> [str] {
    if text.len() == 0 {
        return []
    }
    return text.split("\u{1}")
}

fn number(text: str) -> i64 {
    return text.parse_int() ?? 0
}

fn run_js(what: str, a: str, b: str) -> str {
    let x = number(a).from_bits()
    if what == "jsstr" {
        return th(jsnumber.to_string(x))
    }
    if what == "jsfix" {
        return th(jsnumber.to_fixed(x, number(b)) ?? "?")
    }
    if what == "jsexp" {
        return th(jsnumber.to_exponential(x, number(b)) ?? "?")
    }
    if what == "jsprec" {
        return th(jsnumber.to_precision(x, number(b)) ?? "?")
    }
    if what == "jspf" {
        return "{jsnumber.parse_float(a).to_bits()}"
    }
    return "{jsnumber.number(a).to_bits()}"
}

fn run_tcl(what: str, a: str) -> str {
    if what == "tlist" {
        return th(tcllist.merge(parts(a)))
    }
    return th(match tcllist.split(a) {
        Ok(elements) -> elements.join("\u{1}")
        Err(e) -> "?" + tcllist.message_of(e)
    })
}

fn run_lua(what: str, raw: bytes, a: str) -> str {
    if what == "lq" {
        return hex(luaformat.quote_string(raw))
    }
    if what == "lqi" {
        return th(luaformat.quote_integer(number(a)))
    }
    if what == "lqf" {
        return th(luaformat.quote_float(number(a).from_bits()))
    }
    if what == "lts" {
        return th(luaformat.tostring_float(number(a).from_bits()))
    }
    if what == "lread" {
        return match luaformat.read_string(raw) {
            Ok(value) -> hex(value)
            Err(_e) -> th("?")
        }
    }
    return th(match luaformat.tonumber(a) {
        Some(n) -> if n.is_integer { "i:{n.integer}" } else {
            "f:{n.float.to_bits()}" }
        None -> "?"
    })
}

fn describe(value: ref RubyValue) -> str {
    match value {
        RubyNil -> return "nil"
        RubyBool(b) -> return if b { "true" } else { "false" }
        RubyInteger(n) -> return "i" + bigint.to_str(n)
        RubyFloat(x) -> return "f{x.to_bits()}"
        RubyString(d, e) -> return "s(" + e + ")" + hex(d)
        RubySymbol(name) -> return ":" + name
        RubyArray(items) -> return "[" + describe_all(items) + "]"
        RubyHash(keys, values, default) -> {
            var out = "\{"
            var i = 0
            while i < keys.len() {
                out = out + describe(keys[i]) + "=>" + describe(values[i]) + ","
                i = i + 1
            }
            if default.len() > 0 {
                out = out + "default=" + describe(default[0])
            }
            return out + "\}"
        }
        RubyObject(c, names, values) -> return "o:" + c + "(" +
        describe_pairs(names, values) + ")"
        RubyStruct(c, names, values) -> return "S:" + c + "(" +
        describe_pairs(names, values) + ")"
        RubyRegexp(s, o, e) -> return "r(" + e + "," + "{o}" + ")" + hex(s)
        RubyClass(name) -> return "c:" + name
        RubyModule(name) -> return "m:" + name
        RubyUserDefined(c, d, e) -> return "u:" + c + "(" + e + ")" + hex(d)
        RubyUserMarshal(c, inner) -> return "U:" + c + "(" + describe(inner) + ")"
        RubySubclass(c, inner) -> return "C:" + c + "(" + describe(inner) + ")"
    }
}

fn describe_all(items: [ref RubyValue]) -> str {
    var out: [str] = []
    for item in items {
        out.push(describe(item))
    }
    return out.join(",")
}

fn describe_pairs(names: [str], values: [ref RubyValue]) -> str {
    var out: [str] = []
    var i = 0
    while i < names.len() {
        out.push(names[i] + "=" + describe(values[i]))
        i = i + 1
    }
    return out.join(",")
}

fn run_ruby(what: str, raw: bytes) -> str {
    match rubymarshal.load(raw) {
        Ok(value) -> {
            if what == "rdump" {
                return hex(rubymarshal.dump(value))
            }
            return th(describe(value))
        }
        Err(_e) -> return th("?")
    }
}

fn run_perl(what: str, raw: bytes, a: str, b: str) -> str {
    if what == "ppack" {
        return match perlpack.pack(a, parts(b)) {
            Ok(data) -> hex(data)
            Err(_e) -> th("?")
        }
    }
    return th(match perlpack.unpack(b, raw) {
        Ok(values) -> values.join("\u{1}")
        Err(_e) -> "?"
    })
}

// Every command is `<name> <hex argument> <hex argument>`, three words.
fn main() / {io} {
    var i = 0
    while i + 2 < args().len() {
        let what = args()[i]
        let raw = from_hex_bytes(args()[i + 1])
        let a = raw.to_str()
        let b = from_hex_bytes(args()[i + 2]).to_str()
        if what.starts_with("js") {
            print(run_js(what, a, b))
        } else if what.starts_with("t") {
            print(run_tcl(what, a))
        } else if what.starts_with("l") {
            print(run_lua(what, raw, a))
        } else if what.starts_with("r") {
            print(run_ruby(what, raw))
        } else {
            print(run_perl(what, raw, a, b))
        }
        i = i + 3
    }
}
