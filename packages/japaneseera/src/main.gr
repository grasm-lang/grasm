let STARTS = era_starts()
let FIRST_YEARS = era_first_years()
let NAMES = era_names()

fn era_index(d: i64) -> i64 {
    var lo = 0
    var hi = STARTS.len()
    while hi - lo > 1 {
        let mid = (lo + hi) / 2
        if STARTS[mid] <= d { lo = mid } else { hi = mid }
    }
    lo
}

pub fn from_unix_day(d: i64) -> JapaneseDate {
    let c = buddhistcal.civil_of(d)
    let k = era_index(d)
    JapaneseDate{ era: NAMES[k], year: c.year - FIRST_YEARS[k] + 1, month: c.month, day: c.day }
}

/// The day number of a date in a named era, or `None` for an unknown era.
pub fn to_unix_day(j: JapaneseDate) -> Option[i64] {
    for k in 0..NAMES.len() {
        if NAMES[k] == j.era {
            return Some(buddhistcal.day_of(CivilDay{ year: FIRST_YEARS[k] + j.year - 1, month: j.month, day: j.day }))
        }
    }
    None
}

pub fn eras() -> [str] {
    NAMES
}
