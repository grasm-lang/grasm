// MIME types as browsers parse them (the MIME Sniffing Standard).
//
// `Content-Type: text/html; charset="utf-8"; charset=latin1` is one
// type, `text/html`, with the first charset; a parameter whose name or
// value holds a character outside its grammar is dropped, not the whole
// header; a quoted value keeps its backslash escapes' characters; and
// names and the type are lowercased, values never. That is how `fetch`,
// `<script type>`, `Blob.type` and a data: URL read a type, and Node's
// `util.MIMEType` does the same.
//
// `parse` gives the record (or None: no `/`, an empty or non-token type
// or subtype), `serialize` writes it back with values quoted only when
// they must be, and `essence` is `type/subtype`.

type MimeType = { kind: str, subtype: str, params: [(str, str)] }

fn is_space(c: i64) -> bool {
    return c == 9 or c == 10 or c == 13 or c == 32
}

fn is_token(c: i64) -> bool {
    return (c >= 48 and c <= 57) or (c >= 65 and c <= 90) or (c >= 97 and c <= 122) or "!#$%&'*+-.^_`|~".to_bytes().to_list().contains(c)
}

fn all_token(cs: [i64]) -> bool {
    for c in cs {
        if not is_token(c) {
            return false
        }
    }
    return cs.len() > 0
}

fn quoted_ok(cs: [i64]) -> bool {
    for c in cs {
        if not (c == 9 or (c >= 32 and c <= 126) or (c >= 128 and c <= 255)) {
            return false
        }
    }
    return true
}

fn lower(cs: [i64]) -> [i64] {
    return cs.map(|c| if c >= 65 and c <= 90 { c + 32 } else { c })
}

fn text(cs: [i64]) -> str {
    var out: [i64] = []
    for c in cs {
        if c < 128 {
            out.push(c)
        } else if c < 2048 {
            out.push(192 + c.ushr(6))
            out.push(128 + c.bit_and(63))
        } else if c < 65536 {
            out.push(224 + c.ushr(12))
            out.push(128 + c.ushr(6).bit_and(63))
            out.push(128 + c.bit_and(63))
        } else {
            out.push(240 + c.ushr(18))
            out.push(128 + c.ushr(12).bit_and(63))
            out.push(128 + c.ushr(6).bit_and(63))
            out.push(128 + c.bit_and(63))
        }
    }
    return bytes_of(out).to_str()
}

fn trim_end(cs: [i64]) -> [i64] {
    var n = cs.len()
    while n > 0 and is_space(cs[n - 1]) {
        n = n - 1
    }
    return cs.slice(0, n)
}

/// An HTTP quoted string starting at `p` (a `"`): its value, and where
/// the scan stopped.
fn quoted(cs: [i64], p0: i64) -> ([i64], i64) {
    var p = p0 + 1
    var v: [i64] = []
    while true {
        while p < cs.len() and cs[p] != 34 and cs[p] != 92 {
            v.push(cs[p])
            p = p + 1
        }
        if p >= cs.len() {
            break
        }
        let q = cs[p]
        p = p + 1
        if q == 92 {
            if p >= cs.len() {
                v.push(92)
                break
            }
            v.push(cs[p])
            p = p + 1
        } else {
            break
        }
    }
    return (v, p)
}

fn params(cs: [i64], p0: i64) -> [(str, str)] {
    var out: [(str, str)] = []
    var p = p0
    while p < cs.len() {
        p = p + 1
        while p < cs.len() and is_space(cs[p]) {
            p = p + 1
        }
        var name: [i64] = []
        while p < cs.len() and cs[p] != 59 and cs[p] != 61 {
            name.push(cs[p])
            p = p + 1
        }
        name = lower(name)
        if p < cs.len() {
            if cs[p] == 59 {
                continue
            }
            p = p + 1
        }
        if p >= cs.len() {
            break
        }
        var value: [i64] = []
        if cs[p] == 34 {
            let (v, q) = quoted(cs, p)
            value = v
            p = q
            while p < cs.len() and cs[p] != 59 {
                p = p + 1
            }
        } else {
            while p < cs.len() and cs[p] != 59 {
                value.push(cs[p])
                p = p + 1
            }
            value = trim_end(value)
            if value.len() == 0 {
                continue
            }
        }
        let n = text(name)
        if all_token(name) and quoted_ok(value) and out.filter(|kv| kv.0 == n).len() == 0 {
            out.push((n, text(value)))
        }
    }
    return out
}

/// Parses a MIME type; None when it is not one.
pub fn parse(input: str) -> Option[MimeType] {
    var cs = input.codes()
    var a = 0
    var b = cs.len()
    while a < b and is_space(cs[a]) {
        a = a + 1
    }
    while b > a and is_space(cs[b - 1]) {
        b = b - 1
    }
    cs = cs.slice(a, b)
    var p = 0
    var kind: [i64] = []
    while p < cs.len() and cs[p] != 47 {
        kind.push(cs[p])
        p = p + 1
    }
    if not all_token(kind) or p >= cs.len() {
        return None
    }
    p = p + 1
    var sub: [i64] = []
    while p < cs.len() and cs[p] != 59 {
        sub.push(cs[p])
        p = p + 1
    }
    sub = trim_end(sub)
    if not all_token(sub) {
        return None
    }
    return Some(MimeType{ kind: text(lower(kind)), subtype: text(lower(sub)), params: params(cs, p) })
}

pub fn essence(m: MimeType) -> str {
    return m.kind + "/" + m.subtype
}

/// The MIME type serialiser: values quoted (with `"` and `\` escaped)
/// when empty or not a token.
pub fn serialize(m: MimeType) -> str {
    var out = essence(m)
    for (name, value) in m.params {
        let cs = value.codes()
        var v = value
        if not all_token(cs) {
            var q: [i64] = [34]
            for c in cs {
                if c == 34 or c == 92 {
                    q.push(92)
                }
                q.push(c)
            }
            q.push(34)
            v = text(q)
        }
        out = out + ";" + name + "=" + v
    }
    return out
}
