import picklefile

fn from_hex(text: str) -> bytes {
    var out: [i64] = []
    var i = 1
    while i + 1 < text.len() {
        out.push(text.substr(i, 2).parse_int_base(16) ?? 0)
        i = i + 2
    }
    return bytes_of(out)
}

fn to_hex(text: str) -> str {
    let digits = "0123456789abcdef"
    let raw = text.to_bytes()
    var out = ""
    var i = 0
    while i < raw.len() {
        out = out + digits.substr(raw.at(i) / 16, 1) +
        digits.substr(raw.at(i) % 16, 1)
        i = i + 1
    }
    return out
}

fn main() / {io} {
    var i = 0
    while i + 1 < args().len() {
        let what = args()[i]
        match picklefile.decode(from_hex(args()[i + 1])) {
            Err(_e) -> print("error")
            Ok(value) -> {
                if what == "kind" {
                    print(picklefile.kind(value))
                } else {
                    print(to_hex(picklefile.render(value)))
                }
            }
        }
        i = i + 2
    }
}
