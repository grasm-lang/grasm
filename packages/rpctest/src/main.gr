import xmlrpcwire

fn from_hex(text: str) -> str {
    var out: [i64] = []
    var i = 1
    while i + 1 < text.len() {
        out.push(text.substr(i, 2).parse_int_base(16) ?? 0)
        i = i + 2
    }
    return bytes_of(out).to_str()
}

fn to_hex(text: str) -> str {
    let digits = "0123456789abcdef"
    let raw = text.to_bytes()
    var out = ""
    var i = 0
    while i < raw.len() {
        out = out + digits.substr(raw.at(i) / 16, 1) +
        digits.substr(raw.at(i) % 16, 1)
        i = i + 1
    }
    return out
}

/// A document as a flat description, so two readers can be compared without
/// agreeing on a value type first.
fn describe(value: ref RpcValue) -> str {
    match value {
        RpcArray(items) -> {
            var parts: [str] = []
            for item in items {
                parts.push(describe(item))
            }
            return "array(" + parts.join(", ") + ")"
        }
        RpcStruct(names, values) -> {
            var parts: [str] = []
            var i = 0
            while i < names.len() {
                parts.push(names[i] + "=" + describe(values[i]))
                i = i + 1
            }
            return "struct(" + parts.join(", ") + ")"
        }
        RpcInt(n) -> return "int:" + n.to_str()
        RpcBool(b) -> return "boolean:" + (if b { "1" } else { "0" })
        RpcStr(text) -> return "string:" + text
        RpcDouble(x) -> return "double:" + x.to_str()
        RpcDate(text) -> return "date:" + text
        RpcBase64(raw) -> return "base64:" + to_hex(raw.to_str())
        RpcNil -> return "nil"
    }
}

/// A value built from the same flat description the reader prints, so a
/// document can be written from a description Python produced.
fn build(text: str) -> ref RpcValue {
    if text.starts_with("array(") {
        var items: [ref RpcValue] = []
        for piece in split_top(text.substr(6, text.len() - 7)) {
            items.push(build(piece))
        }
        return ref(RpcArray(items))
    }
    if text.starts_with("struct(") {
        var names: [str] = []
        var values: [ref RpcValue] = []
        for piece in split_top(text.substr(7, text.len() - 8)) {
            let cut = piece.index_of("=") ?? -1
            names.push(piece.substr(0, cut))
            values.push(build(piece.substr(cut + 1, piece.len() - cut - 1)))
        }
        return ref(RpcStruct(names, values))
    }
    if text == "nil" {
        return ref(RpcNil)
    }
    let cut = text.index_of(":") ?? -1
    let kind = text.substr(0, cut)
    let body = text.substr(cut + 1, text.len() - cut - 1)
    if kind == "int" {
        return ref(RpcInt(body.parse_int() ?? 0))
    }
    if kind == "boolean" {
        return ref(RpcBool(body == "1"))
    }
    if kind == "double" {
        return ref(RpcDouble(body.parse_float() ?? 0.0))
    }
    if kind == "date" {
        return ref(RpcDate(body))
    }
    if kind == "base64" {
        return ref(RpcBase64(from_hex(":" + body).to_bytes()))
    }
    return ref(RpcStr(body))
}

/// Split on the commas that are not inside a nested parenthesis.
fn split_top(text: str) -> [str] {
    var out: [str] = []
    var depth = 0
    var current = ""
    var i = 0
    while i < text.len() {
        let c = text.substr(i, 1)
        if c == "(" {
            depth = depth + 1
        } else if c == ")" {
            depth = depth - 1
        }
        if c == "," and depth == 0 {
            out.push(current.trim())
            current = ""
        } else {
            current = current + c
        }
        i = i + 1
    }
    if current.trim().len() > 0 {
        out.push(current.trim())
    }
    return out
}

fn main() / {io} {
    var i = 0
    while i + 1 < args().len() {
        if args()[i] == "call" {
            // `call <method|description of each param>`
            let parts = from_hex(args()[i + 1]).split("|")
            var params: [ref RpcValue] = []
            var k = 1
            while k < parts.len() {
                if parts[k].len() > 0 {
                    params.push(build(parts[k]))
                }
                k = k + 1
            }
            print(to_hex(xmlrpcwire.render_call(parts[0], params)))
            i = i + 2
            continue
        }
        if args()[i] == "reply" {
            print(to_hex(xmlrpcwire.render_response(
                build(from_hex(args()[i + 1])))))
            i = i + 2
            continue
        }
        if args()[i] == "fault" {
            let parts = from_hex(args()[i + 1]).split("|")
            print(to_hex(xmlrpcwire.render_fault(parts[0].parse_int() ?? 0,
                parts[1])))
            i = i + 2
            continue
        }
        let body = from_hex(args()[i + 1])
        match xmlrpcwire.decode(body) {
            Err(_e) -> print("error")
            Ok(document) -> {
                var parts: [str] = []
                for value in document.params {
                    parts.push(describe(value))
                }
                var head = document.method
                if document.fault {
                    head = "fault"
                }
                print(to_hex(head + "|" + parts.join(" ")))
            }
        }
        i = i + 2
    }
}
