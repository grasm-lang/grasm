// --------------------------------------------------------- the framing

fn check_framing(inout f: i64) / {io} {
    print("-- tlshandshake: three lengths, all different")
    // A record is a type, a version and two bytes of length.
    let record = tlshandshake.record_of(22, 769, hex("0102")) ??
    bytes_of([])
    say(f, "a record header is five bytes and the payload follows",
        tlshandshake.to_hex(record) == "160301000201" + "02")
    say(f, "a handshake message header is four, with a three-byte length",
        tlshandshake.to_hex(tlshandshake.message_of(1, hex("0102")) ??
            bytes_of([])) == "010000020102")
    // A partial record is not an error: a socket has half of one more often
    // than not.
    let split = tlshandshake.split_records(concat(record, hex("1603"))) ??
    ([], 0)
    say(f, "a partial record at the end is left for the next read",
        split.0.len() == 1 and split.1 == 7)
    say(f, "and several messages can share one record",
        (tlshandshake.split_messages(hex("0100000101020000020304")) ??
            ([], 0)).0.len() == 2)
    // The inner content type, which is what hides a handshake record from
    // an observer.
    let inner = tlshandshake.inner_plaintext(22, hex("abcd"), 3)
    say(f, "the real content type goes inside the encryption, then padding",
        tlshandshake.to_hex(inner) == "abcd16000000")
    let stripped = tlshandshake.strip_inner(inner) ?? (0, bytes_of([]))
    say(f, "and it is the last byte that is not padding",
        stripped.0 == 22 and tlshandshake.to_hex(stripped.1) == "abcd")
    say(f, "a record of nothing but zeros has no content type at all",
        inner_refused("000000"))
}

fn inner_refused(text: str) -> bool {
    match tlshandshake.strip_inner(hex(text)) {
        Ok(_v) -> return false
        Err(_e) -> return true
    }
}

// ------------------------------------------------- the RFC 8448 trace

fn check_hello(inout f: i64) / {io} {
    print("-- the ClientHello RFC 8448 publishes, rebuilt from its parts")
    let published = hex(rfc_client_hello())
    let body = (tlshandshake.split_messages(published) ?? ([], 0)).0[0].body
    // The extensions, read back in the order the RFC wrote them.
    let extensions = tlshandshake.read_extensions(body, 45) ?? []
    say(f, "the nine extensions come out in the order they were written",
        extensions.len() == 9 and extensions[0].kind == 0 and
        extensions[4].kind == 51 and extensions[8].kind == 28)
    var parts = ClientHelloParts{ random: slice(body, 2, 32),
        session_id: bytes_of([]), cipher_suites: [4865, 4867, 4866],
        extensions: extensions }
    let rebuilt = tlshandshake.message_of(1,
        tlshandshake.client_hello(parts) ?? bytes_of([])) ?? bytes_of([])
    say(f, "and the message rebuilds byte for byte", same(rebuilt,
        published))
    say(f, "the version field says TLS 1.2 whatever is really being asked",
        body.at(0) == 3 and body.at(1) == 3)
    // The extension builders produce the same bytes as the RFC's.
    say(f, "the server name extension is a list of one name, typed",
        tlshandshake.to_hex(tlshandshake.server_name_extension("server")
                .body) == "000900000673657276657" + "2")
    say(f, "supported_versions names 0x0304, which is where 1.3 really is",
        tlshandshake.to_hex(tlshandshake.supported_versions_extension(
            [772]).body) == "020304")
    say(f, "and a key share carries the group beside the bytes",
        tlshandshake.to_hex(tlshandshake.key_share_extension(29,
            hex("aabb")).body) == "0006001d0002aabb")
    say(f, "alpn is a list of length-prefixed names inside one more length",
        tlshandshake.to_hex(tlshandshake.alpn_extension(["h2",
            "http/1.1"]).body) == "000c02683208687474702f312e31")
}

fn slice(data: bytes, at: i64, length: i64) -> bytes {
    var out: [i64] = []
    var i = 0
    while i < length {
        out.push(data.at(at + i))
        i = i + 1
    }
    return bytes_of(out)
}

fn check_schedule(inout f: i64) / {io} {
    print("-- the whole 1-RTT handshake, against the published trace")
    let shared = x25519.shared_secret(hex(rfc_client_private()),
        hex(rfc_server_public())) ?? bytes_of([])
    say(f, "the two halves of the key exchange make the shared secret",
        tlshandshake.to_hex(shared) ==
        "8bd4054fb55b9d63fdfbacf9f04b9f0d35e6d63f537563efd46272900f89492d")
    let schedule = tls13.schedule_of(tls13.zeros(), shared)
    say(f, "which extracts to the handshake secret the RFC records",
        same(schedule.handshake, hex(rfc_handshake_secret())))
    // Every secret is bound to the transcript, so the hash comes first.
    let transcript = concat(hex(rfc_client_hello()), hex(rfc_server_hello()))
    let hash = crypto_hash.sha256_of(transcript)
    say(f, "the transcript is the two hellos, unencrypted, in order",
        tlshandshake.to_hex(hash) ==
        "860c06edc07858ee8e78f0e7428c58edd6b43f2ca3e6e95f02ed063cf0e1cad8")
    let traffic = tls13.handshake_traffic(schedule, hash)
    say(f, "and both handshake traffic secrets fall out of it",
        same(traffic.0, hex(rfc_client_hs())) and
        same(traffic.1, hex(rfc_server_hs())))
    let keys = tls13.traffic_keys(traffic.1)
    say(f, "the server's record key and nonce are derived from its secret",
        same(keys.key, hex(rfc_server_key())) and
        same(keys.iv, hex(rfc_server_iv())))
    // The whole encrypted flight, opened.
    let opened = tls13.open_record(keys, 0, hex(rfc_flight_record())) ??
    (0, bytes_of([]))
    say(f, "and the server's encrypted flight decrypts to what it sent",
        opened.0 == 22 and same(opened.1, hex(rfc_flight_plain())))
    let messages = (tlshandshake.split_messages(opened.1) ?? ([], 0)).0
    say(f, "which is four messages: extensions, certificate, proof, finish",
        messages.len() == 4 and messages[0].kind == 8 and
        messages[1].kind == 11 and messages[2].kind == 15 and
        messages[3].kind == 20)
    // The certificate chain and the signature over the transcript.
    let chain = tlshandshake.certificate_chain(messages[1].body) ?? []
    say(f, "the certificate message carries a chain, leaf first",
        chain.len() == 1 and chain[0].len() == 432)
    let signature = tlshandshake.certificate_verify(messages[2].body) ??
    (0, bytes_of([]))
    say(f, "and the proof names its scheme beside the signature",
        signature.0 == tlshandshake.scheme_rsa_pss_rsae_sha256() and
        signature.1.len() == 128)
}

fn check_verify_content(inout f: i64) / {io} {
    print("-- what the signature is over, and why it is not the transcript")
    let content = tlshandshake.verify_content(hex(rfc_cv_hash()), true)
    say(f, "sixty-four spaces come first, so a 1.2 signature cannot fit",
        content.len() == 130 and content.at(0) == 32 and
        content.at(63) == 32)
    say(f, "then the context string, which keeps client and server apart",
        tlshandshake.to_hex(slice(content, 64, 33)) ==
        tlshandshake.to_hex("TLS 1.3, server CertificateVerify".to_bytes()))
    say(f, "a zero byte separates it from the hash that follows",
        content.at(97) == 0 and same(slice(content, 98, 32),
            hex(rfc_cv_hash())))
    let client_side = tlshandshake.verify_content(hex(rfc_cv_hash()), false)
    say(f, "and the client's differs in one word, which is the whole point",
        not same(content, client_side) and client_side.len() == 130)
}

// ------------------------------------------------------ the three checks

fn check_verification(inout f: i64) / {io} {
    print("-- tlsverify: chain, name, signature, and none of them optional")
    let leaf = hex(rfc_leaf())
    let hash = hex(rfc_cv_hash())
    let message = hex(rfc_cv_message())
    let body = (tlshandshake.split_messages(message) ?? ([], 0)).0[0].body
    let signature = tlshandshake.certificate_verify(body) ??
    (0, bytes_of([]))
    // The RFC's own certificate has a 1024-bit key, which no policy written
    // this decade accepts. Refusing it is the correct answer and the reason
    // the signature in the published trace cannot be checked here.
    say(f, "a key below the minimum is refused before it is used",
        signature_refused(leaf, signature.0, signature.1, hash))
    // Which scheme goes with which digest, and which have a verifier.
    say(f, "each scheme names its digest, spelled the rsa package's way",
        (tlsverify.hash_for_scheme(2052) ?? "") == "SHA256" and
        (tlsverify.hash_for_scheme(2053) ?? "") == "SHA384" and
        (tlsverify.hash_for_scheme(2054) ?? "") == "SHA512" and
        (tlsverify.hash_for_scheme(1027) ?? "") == "SHA256")
    say(f, "a scheme with no verifier is an error rather than a false",
        scheme_refused(2055) and scheme_refused(513))
    say(f, "the three PSS schemes are recognised as such",
        tlsverify.is_pss(2052) and tlsverify.is_pss(2054) and
        not tlsverify.is_pss(1027) and not tlsverify.is_pss(1025))
    // A client should offer only what it can check.
    say(f, "and the handshake layer agrees about which those are",
        tlshandshake.scheme_is_verifiable(2052) and
        tlshandshake.scheme_is_verifiable(1027) and
        not tlshandshake.scheme_is_verifiable(2055))
    // Each of the three checks refuses on its own.
    let empty: [bytes] = []
    say(f, "no certificate at all is refused, and says so",
        tlsverify.describe(empty, [], "example.com", 2052, bytes_of([]),
            hash, 1788000000).reason.contains("no certificate"))
    say(f, "a certificate that is not one is refused before anything else",
        not tlsverify.describe([hex("3003020101")], [], "example.com",
            2052, bytes_of([]), hash, 1788000000).trusted)
    say(f, "and a chain with no root to reach is refused as untrusted",
        tlsverify.describe([leaf], [], "example.com", 2052, bytes_of([]),
            hash, 1788000000).reason.contains("trusted root"))
    // The RFC's own certificate is `CN=rsa` with no subject alternative
    // name at all, so it matches no host: the Common Name is not read here,
    // which browsers stopped doing in 2017 and which is why this refuses a
    // certificate whose subject is the very name being asked for.
    let by_name = tlsverify.describe([leaf], [leaf], "rsa", 2052,
        bytes_of([]), hash, 1471000000)
    say(f, "a certificate with no SAN matches nothing, Common Name or not",
        not by_name.trusted and
        by_name.reason.contains("does not carry rsa"))
    // The order of the three checks shows in which refusal comes back: the
    // name is checked before the signature, so a certificate that fails
    // both says so about the name.
    say(f, "and the first failure is the one reported, in check order",
        not by_name.reason.contains("signature"))
}

fn signature_refused(leaf: bytes, scheme: i64, signature: bytes,
    hash: bytes) -> bool {
    match tlsverify.check_signature(leaf, scheme, signature, hash) {
        Ok(_v) -> return false
        Err(_e) -> return true
    }
}

fn scheme_refused(scheme: i64) -> bool {
    match tlsverify.hash_for_scheme(scheme) {
        Ok(_v) -> return false
        Err(_e) -> return true
    }
}

fn main() / {io} {
    var f = 0
    check_framing(f)
    check_hello(f)
    check_schedule(f)
    check_verify_content(f)
    check_verification(f)
    if f == 0 {
        print("tls: every claim held")
    } else {
        print("tls: {f} claims failed")
    }
}
