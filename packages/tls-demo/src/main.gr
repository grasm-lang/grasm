import tlshandshake
import tlsverify
import tls13
import x25519
import crypto_hash

fn say(inout f: i64, name: str, held: bool) / {io} {
    if held {
        print("  ok    {name}")
    } else {
        print("  FAIL  {name}")
        f = f + 1
    }
}

fn hex(text: str) -> bytes {
    return tlshandshake.from_hex(text)
}

fn same(a: bytes, b: bytes) -> bool {
    if a.len() != b.len() {
        return false
    }
    var i = 0
    while i < a.len() {
        if a.at(i) != b.at(i) {
            return false
        }
        i = i + 1
    }
    return true
}

fn concat(a: bytes, b: bytes) -> bytes {
    var out: [i64] = []
    var i = 0
    while i < a.len() {
        out.push(a.at(i))
        i = i + 1
    }
    var j = 0
    while j < b.len() {
        out.push(b.at(j))
        j = j + 1
    }
    return bytes_of(out)
}
