import formatspec

fn from_hex(text: str) -> str {
    var out: [i64] = []
    var i = 1
    while i + 1 < text.len() {
        out.push(text.substr(i, 2).parse_int_base(16) ?? 0)
        i = i + 2
    }
    return bytes_of(out).to_str()
}

fn to_hex(text: str) -> str {
    let digits = "0123456789abcdef"
    let raw = text.to_bytes()
    var out = ""
    var i = 0
    while i < raw.len() {
        out = out + digits.substr(raw.at(i) / 16, 1) +
        digits.substr(raw.at(i) % 16, 1)
        i = i + 1
    }
    return out
}

fn main() / {io} {
    var i = 0
    while i + 2 < args().len() {
        let spec = from_hex(args()[i + 2])
        if args()[i] == "int" {
            match formatspec.format_int(args()[i + 1].parse_int() ?? 0,
                spec) {
                Ok(text) -> print(to_hex(text))
                Err(_e) -> print("error")
            }
        } else {
            match formatspec.format_str(from_hex(args()[i + 1]), spec) {
                Ok(text) -> print(to_hex(text))
                Err(_e) -> print("error")
            }
        }
        i = i + 3
    }
}
