/// Whether a code point falls inside a table of first-last pairs.
fn in_runs(runs: [i64], code: i64) -> bool {
    var low = 0
    var high = runs.len() / 2 - 1
    while low <= high {
        let middle = (low + high) / 2
        if code < runs[middle * 2] {
            high = middle - 1
        } else if code > runs[middle * 2 + 1] {
            low = middle + 1
        } else {
            return true
        }
    }
    return false
}

/// The columns one code point takes: 0, 1, 2, or -1 for a control.
pub fn code_width(code: i64) -> i64 {
    if code == 0 {
        return 0
    }
    if code < 32 or (code >= 127 and code < 160) {
        return 0 - 1
    }
    if in_runs(ZERO_RUNS, code) {
        return 0
    }
    if in_runs(WIDE_RUNS, code) {
        return 2
    }
    return 1
}

/// The columns a string takes, or -1 if it contains a control character.
///
/// One control poisons the whole answer on purpose: a caller laying out a
/// table needs to know that the string cannot be laid out, and a total
/// that quietly skipped the control would be wrong by however far the
/// terminal moves the cursor.
pub fn width(text: str) -> i64 {
    var total = 0
    for character in text.chars() {
        let one = code_width(character.code_at(0))
        if one < 0 {
            return 0 - 1
        }
        total = total + one
    }
    return total
}

/// The columns a string takes, counting controls as nothing.
///
/// For a caller that has already stripped or replaced them and wants a
/// number rather than a refusal.
pub fn width_ignoring_controls(text: str) -> i64 {
    var total = 0
    for character in text.chars() {
        let one = code_width(character.code_at(0))
        if one > 0 {
            total = total + one
        }
    }
    return total
}

/// The longest prefix that fits in `columns`.
///
/// A double-width character that would straddle the edge is left out
/// rather than half-drawn, so the result is never wider than asked for.
/// Combining marks follow the character they belong to, so a truncation
/// does not leave an accent on its own.
pub fn truncate(text: str, columns: i64) -> str {
    var out = ""
    var used = 0
    for character in text.chars() {
        let one = code_width(character.code_at(0))
        if one < 0 {
            return out
        }
        if used + one > columns {
            return out
        }
        used = used + one
        out = out + character
    }
    return out
}

/// Pad on the right to a column count, for a table cell.
pub fn pad_right(text: str, columns: i64) -> str {
    let used = width_ignoring_controls(text)
    if used >= columns {
        return text
    }
    return text + " ".repeat(columns - used)
}

/// Pad on the left, for a right-aligned column.
pub fn pad_left(text: str, columns: i64) -> str {
    let used = width_ignoring_controls(text)
    if used >= columns {
        return text
    }
    return " ".repeat(columns - used) + text
}
