import emailaddr

fn from_hex(text: str) -> str {
    var out: [i64] = []
    var i = 0
    while i + 1 < text.len() {
        out.push(text.substr(i, 2).parse_int_base(16) ?? 0)
        i = i + 2
    }
    return bytes_of(out).to_str()
}

fn to_hex(text: str) -> str {
    let digits = "0123456789abcdef"
    let raw = text.to_bytes()
    var out = ""
    var i = 0
    while i < raw.len() {
        out = out + digits.substr(raw.at(i) / 16, 1) +
        digits.substr(raw.at(i) % 16, 1)
        i = i + 1
    }
    return out
}

fn main() / {io} {
    var i = 0
    while i < args().len() {
        var pieces: [str] = []
        for one in emailaddr.parse_list(from_hex(args()[i])) {
            pieces.push(one.display_name + "\u{3}" + one.address)
        }
        print(to_hex(pieces.join("\u{1}")))
        i = i + 1
    }
}
