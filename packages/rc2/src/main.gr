// RC2, Ron Rivest's 64-bit block cipher (RFC 2268).
//
// RC2 works on four 16-bit words: sixteen "mixing" rounds of additions,
// ANDs and rotations, with two "mashing" rounds that index the key table by
// the data. Its key expansion stretches a key of 1 to 128 bytes through a
// table of pi's digits, then cuts the result down to an "effective key
// length" -- the knob that let 1990s software ship 40-bit export-grade
// encryption from a longer key.
//
// It is here for what was written with it: PKCS#12 files from Windows and
// older OpenSSL (pbeWithSHAAnd40BitRC2-CBC is the default certificate
// encryption in many of them), S/MIME messages, and old Kerberos and SSL
// data. Nothing new should use it. Modes come from `blockmodes`.
//
// The effective key length is a separate argument (1 to 1024 bits); RFC
// 2268 and PKCS#12 both name it, and OpenSSL calls it `keybits`.
//
// Checked against OpenSSL's RC2-*.

type Rc2Cipher = { k: [i64] }

type Rc2Error =
    | Rc2BadKey(length: i64)
    | Rc2BadEffectiveBits(bits: i64)

pub fn new_cipher(key: bytes, effective_bits: i64) -> Rc2Cipher ! Rc2Error {
    let t = key.len()
    if t < 1 or t > 128 {
        fail(Rc2BadKey(t))
    }
    if effective_bits < 1 or effective_bits > 1024 {
        fail(Rc2BadEffectiveBits(effective_bits))
    }
    let pi = RC2_PITABLE
    var l = key.to_list()
    for i in t..128 {
        l.push(pi[(l[i - 1] + l[i - t]).bit_and(255)])
    }
    let t8 = (effective_bits + 7) / 8
    let tm = 255.ushr(8 * t8 - effective_bits)
    l[128 - t8] = pi[l[128 - t8].bit_and(tm)]
    var i = 127 - t8
    while i >= 0 {
        l[i] = pi[l[i + 1].bit_xor(l[i + t8])]
        i = i - 1
    }
    var k: [i64] = []
    for j in 0..64 {
        k.push(l[2 * j] + 256 * l[2 * j + 1])
    }
    return Rc2Cipher{ k: k }
}

let M16 = 65535

fn rol16(x: i64, n: i64) -> i64 {
    return x.shl(n).bit_or(x.ushr(16 - n)).bit_and(M16)
}

fn ror16(x: i64, n: i64) -> i64 {
    return x.ushr(n).bit_or(x.shl(16 - n)).bit_and(M16)
}

fn words(block: bytes) -> [i64] {
    if block.len() != 8 {
        panic("RC2 works on 8-byte blocks")
    }
    return [block.at(0) + 256 * block.at(1), block.at(2) + 256 * block.at(3), block.at(4) + 256 * block.at(5),
        block.at(6) + 256 * block.at(7)]
}

fn unwords(r: [i64]) -> bytes {
    var out: [i64] = []
    for w in r {
        out = out + [w.bit_and(255), w.ushr(8)]
    }
    return bytes_of(out)
}

/// One 8-byte block: five mixing rounds, a mash, six mixing rounds, a mash,
/// five mixing rounds.
pub fn encrypt_block(c: Rc2Cipher, block: bytes) -> bytes {
    var r = words(block)
    let shifts = [1, 2, 3, 5]
    var j = 0
    for round in 0..16 {
        for i in 0..4 {
            let m = r[i] + c.k[j] + r[(i + 3) % 4].bit_and(r[(i + 2) % 4]) + r[(i + 3) % 4].bit_not().bit_and(M16).bit_and(r[(i + 1) % 4])
            r[i] = rol16(m.bit_and(M16), shifts[i])
            j = j + 1
        }
        if round == 4 or round == 10 {
            for i in 0..4 {
                r[i] = (r[i] + c.k[r[(i + 3) % 4].bit_and(63)]).bit_and(M16)
            }
        }
    }
    return unwords(r)
}

pub fn decrypt_block(c: Rc2Cipher, block: bytes) -> bytes {
    var r = words(block)
    let shifts = [1, 2, 3, 5]
    var j = 63
    var round = 15
    while round >= 0 {
        var i = 3
        while i >= 0 {
            let m = ror16(r[i], shifts[i]) - c.k[j] - r[(i + 3) % 4].bit_and(r[(i + 2) % 4]) - r[(i + 3) % 4].bit_not().bit_and(M16).bit_and(r[(i + 1) % 4])
            r[i] = m.bit_and(M16)
            j = j - 1
            i = i - 1
        }
        if round == 5 or round == 11 {
            i = 3
            while i >= 0 {
                r[i] = (r[i] - c.k[r[(i + 3) % 4].bit_and(63)]).bit_and(M16)
                i = i - 1
            }
        }
        round = round - 1
    }
    return unwords(r)
}

