// The Grasm side of scripts/packet_diff.py for routing, link and LAN
// protocols: `<proto>` decodes what scapy built and prints its fields,
// `<proto>.rt` decodes and re-encodes it.
import igmp
import mpls
import lldp
import stp
import cdp
import rip
import vrrp
import hsrp
import bfd
import nsh
import erspan
import l2tp
import pppoe

fn from_hex(text: str) -> bytes {
    var out: [i64] = []
    var i = 1
    while i + 1 < text.len() {
        out.push(text.substr(i, 2).parse_int_base(16) ?? 0)
        i = i + 2
    }
    bytes_of(out)
}

fn hex(raw: bytes) -> str {
    let digits = "0123456789abcdef"
    var out = ""
    var i = 0
    while i < raw.len() {
        out = out + digits.substr(raw.at(i) / 16, 1) + digits.substr(raw.at(i) % 16, 1)
        i = i + 1
    }
    out
}

fn flag(b: bool) -> str {
    if b { "1" } else { "0" }
}

fn routing(what: str, a: bytes, b: bytes) -> str {
    let rt = what.ends_with(".rt")
    if what.starts_with("igmp") {
        return match igmp.decode(a) {
            Err(_) -> "ERR"
            Ok(m) -> if rt { hex(igmp.encode(m)) } else {
                "type={m.kind};mrcode={m.mrcode};chksum={m.checksum};gaddr={hex(m.group)};rest={hex(m.rest)};ok=" +
                flag(igmp.checksum_holds(a))
            }
        }
    }
    if what.starts_with("mpls") {
        return match mpls.decode(a) {
            Err(_) -> "ERR"
            Ok(st) -> {
                if rt {
                    return hex(mpls.encode(st.0).concat(a.slice(st.1, a.len())))
                }
                var parts: [str] = []
                for e in st.0 {
                    parts.push("{e.label}:{e.cos}:{e.s}:{e.ttl}")
                }
                "stack=" + parts.join("|") + ";payload_at={st.1}"
            }
        }
    }
    if what.starts_with("rip") {
        return match rip.decode(a) {
            Err(_) -> "ERR"
            Ok(p) -> {
                if rt {
                    return hex(rip.encode(p))
                }
                var parts: [str] = []
                for e in p.entries {
                    parts.push("{e.af}:{e.route_tag}:{hex(e.addr)}:{hex(e.mask)}:{hex(e.next_hop)}:{e.metric}")
                }
                "cmd={p.cmd};version={p.version};entries=" + parts.join("|")
            }
        }
    }
    if what.starts_with("vrrp") {
        let n = if what.starts_with("vrrp6") { 16 } else { 4 }
        return match vrrp.decode(a, n) {
            Err(_) -> "ERR"
            Ok(m) -> {
                if rt {
                    return hex(vrrp.encode(m, b.slice(0, n), b.slice(n, 2 * n)))
                }
                var addrs: [str] = []
                for x in m.addresses {
                    addrs.push(hex(x))
                }
                "version={m.version};type={m.kind};vrid={m.vrid};priority={m.priority};authtype={m.authtype};" +
                "adv={m.adv};chksum={m.checksum};addrs=" + addrs.join(",") + ";auth={hex(m.auth)}"
            }
        }
    }
    if what.starts_with("bfd") {
        return match bfd.decode(a) {
            Err(_) -> "ERR"
            Ok(p) -> if rt { hex(bfd.encode(p)) } else {
                "version={p.version};diag={p.diag};sta={p.state};flags={p.flags};detect_mult={p.detect_mult};" +
                "len={p.length};my={p.my_discriminator};your={p.your_discriminator};tx={p.min_tx_interval};" +
                "rx={p.min_rx_interval};echo={p.echo_rx_interval};auth={hex(p.auth)}"
            }
        }
    }
    match hsrp.decode(a) {
        Err(_) -> "ERR"
        Ok(m) -> if rt { hex(hsrp.encode(m)) } else {
            "version={m.version};opcode={m.opcode};state={m.state};hello={m.hellotime};hold={m.holdtime};" +
            "priority={m.priority};group={m.group};auth={hex(m.auth)};vip={hex(m.virtual_ip)}"
        }
    }
}

fn links(what: str, a: bytes) -> str {
    let rt = what.ends_with(".rt")
    if what.starts_with("lldp") {
        return match lldp.decode(a) {
            Err(_) -> "ERR"
            Ok(list) -> {
                if rt {
                    return hex(lldp.encode(list))
                }
                var parts: [str] = []
                for t in list {
                    parts.push("{t.kind}:{hex(t.value)}")
                }
                let ok = match lldp.check(list) {
                    Ok(_) -> "1"
                    Err(_) -> "0"
                }
                "tlvs=" + parts.join("|") + ";ok=" + ok + ";ttl={lldp.ttl_seconds(list)}"
            }
        }
    }
    if what.starts_with("stp") {
        return match stp.decode(a) {
            Err(_) -> "ERR"
            Ok(p) -> if rt { hex(stp.encode(p)) } else {
                "proto={p.proto};version={p.version};bpdutype={p.bpdutype};flags={p.bpduflags};rootid={p.rootid};" +
                "rootmac={hex(p.rootmac)};pathcost={p.pathcost};bridgeid={p.bridgeid};bridgemac={hex(p.bridgemac)};" +
                "portid={p.portid};age={p.age};maxage={p.maxage};hello={p.hellotime};fwd={p.fwddelay};rest={hex(p.rest)}"
            }
        }
    }
    if what.starts_with("cdp") {
        return match cdp.decode(a) {
            Err(_) -> "ERR"
            Ok(p) -> {
                if rt {
                    return hex(cdp.encode(p))
                }
                var parts: [str] = []
                for t in p.tlvs {
                    parts.push("{t.kind}:{hex(t.value)}")
                }
                "vers={p.version};ttl={p.ttl};cksum={p.checksum};ok=" + flag(cdp.checksum_holds(a)) + ";tlvs=" +
                parts.join("|")
            }
        }
    }
    if what.starts_with("nsh") {
        return match nsh.decode(a) {
            Err(_) -> "ERR"
            Ok(h) -> if rt { hex(nsh.encode(h)) } else {
                "ver={h.ver};oam={h.oam};ttl={h.ttl};mdtype={h.mdtype};nextproto={h.nextproto};spi={h.spi};si={h.si};" +
                "context={hex(h.context)};payload={hex(h.payload)}"
            }
        }
    }
    if what.starts_with("erspan") {
        return match erspan.decode(a) {
            Err(_) -> "ERR"
            Ok(h) -> if rt { hex(erspan.encode(h)) } else {
                "ver={h.ver};vlan={h.vlan};cos={h.cos};en={h.en};t={h.t};session={h.session_id};index={h.index};" +
                "ts={h.timestamp};sgt={h.sgt};p={h.p};ft={h.ft};hw={h.hw};d={h.d};gra={h.gra};o={h.o};" +
                "platform={hex(h.platform)};payload={hex(h.payload)}"
            }
        }
    }
    if what.starts_with("l2tp") {
        return match l2tp.decode(a) {
            Err(_) -> "ERR"
            Ok(h) -> if rt { hex(l2tp.encode(h)) } else {
                "flags={h.flags};version={h.version};len={h.length};tunnel={h.tunnel_id};session={h.session_id};" +
                "ns={h.ns};nr={h.nr};offset={h.offset};payload={hex(h.payload)}"
            }
        }
    }
    match pppoe.decode(a) {
        Err(_) -> "ERR"
        Ok(p) -> {
            if rt {
                return hex(pppoe.encode(p))
            }
            var parts: [str] = []
            if p.code != 0 {
                match pppoe.tags(p) {
                    Ok(list) -> {
                        for t in list {
                            parts.push("{t.kind}:{hex(t.value)}")
                        }
                    }
                    Err(_) -> parts.push("ERR")
                }
            }
            "version={p.version};type={p.kind};code={p.code};session={p.session_id};len={p.length};" +
            "payload={hex(p.payload)};tags=" + parts.join("|")
        }
    }
}

fn answer(what: str, a: bytes, b: bytes) -> str {
    if what.starts_with("igmp") or what.starts_with("mpls") or what.starts_with("rip") or
    what.starts_with("vrrp") or what.starts_with("bfd") or what.starts_with("hsrp") {
        return routing(what, a, b)
    }
    links(what, a)
}

fn main() / {io} {
    let argv = args()
    var i = 0
    while i + 2 < argv.len() {
        print(answer(argv[i], from_hex(argv[i + 1]), from_hex(argv[i + 2])))
        i = i + 3
    }
}
