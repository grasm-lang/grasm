// The Grasm side of scripts/packet_diff.py for routing, link and LAN
// protocols: `<proto>` decodes what scapy built and prints its fields,
// `<proto>.rt` decodes and re-encodes it.
import igmp
import mpls
import lldp
import stp
import cdp
import rip
import vrrp
import hsrp
import bfd
import nsh
import erspan
import l2tp
import pppoe
import ospf
import bgp
import eigrp
import pim
import isis
import eap
import radiotap
import canframe
import usbpcap
import hci

fn from_hex(text: str) -> bytes {
    var out: [i64] = []
    var i = 1
    while i + 1 < text.len() {
        out.push(text.substr(i, 2).parse_int_base(16) ?? 0)
        i = i + 2
    }
    bytes_of(out)
}

fn hex(raw: bytes) -> str {
    let digits = "0123456789abcdef"
    var out = ""
    var i = 0
    while i < raw.len() {
        out = out + digits.substr(raw.at(i) / 16, 1) + digits.substr(raw.at(i) % 16, 1)
        i = i + 1
    }
    out
}

fn flag(b: bool) -> str {
    if b { "1" } else { "0" }
}

fn routing(what: str, a: bytes, b: bytes) -> str {
    let rt = what.ends_with(".rt")
    if what.starts_with("igmp") {
        return match igmp.decode(a) {
            Err(_) -> "ERR"
            Ok(m) -> if rt { hex(igmp.encode(m)) } else {
                "type={m.kind};mrcode={m.mrcode};chksum={m.checksum};gaddr={hex(m.group)};rest={hex(m.rest)};ok=" +
                flag(igmp.checksum_holds(a))
            }
        }
    }
    if what.starts_with("mpls") {
        return match mpls.decode(a) {
            Err(_) -> "ERR"
            Ok(st) -> {
                if rt {
                    return hex(mpls.encode(st.0).concat(a.slice(st.1, a.len())))
                }
                var parts: [str] = []
                for e in st.0 {
                    parts.push("{e.label}:{e.cos}:{e.s}:{e.ttl}")
                }
                "stack=" + parts.join("|") + ";payload_at={st.1}"
            }
        }
    }
    if what.starts_with("rip") {
        return match rip.decode(a) {
            Err(_) -> "ERR"
            Ok(p) -> {
                if rt {
                    return hex(rip.encode(p))
                }
                var parts: [str] = []
                for e in p.entries {
                    parts.push("{e.af}:{e.route_tag}:{hex(e.addr)}:{hex(e.mask)}:{hex(e.next_hop)}:{e.metric}")
                }
                "cmd={p.cmd};version={p.version};entries=" + parts.join("|")
            }
        }
    }
    if what.starts_with("vrrp") {
        let n = if what.starts_with("vrrp6") { 16 } else { 4 }
        return match vrrp.decode(a, n) {
            Err(_) -> "ERR"
            Ok(m) -> {
                if rt {
                    return hex(vrrp.encode(m, b.slice(0, n), b.slice(n, 2 * n)))
                }
                var addrs: [str] = []
                for x in m.addresses {
                    addrs.push(hex(x))
                }
                "version={m.version};type={m.kind};vrid={m.vrid};priority={m.priority};authtype={m.authtype};" +
                "adv={m.adv};chksum={m.checksum};addrs=" + addrs.join(",") + ";auth={hex(m.auth)}"
            }
        }
    }
    if what.starts_with("bfd") {
        return match bfd.decode(a) {
            Err(_) -> "ERR"
            Ok(p) -> if rt { hex(bfd.encode(p)) } else {
                "version={p.version};diag={p.diag};sta={p.state};flags={p.flags};detect_mult={p.detect_mult};" +
                "len={p.length};my={p.my_discriminator};your={p.your_discriminator};tx={p.min_tx_interval};" +
                "rx={p.min_rx_interval};echo={p.echo_rx_interval};auth={hex(p.auth)}"
            }
        }
    }
    match hsrp.decode(a) {
        Err(_) -> "ERR"
        Ok(m) -> if rt { hex(hsrp.encode(m)) } else {
            "version={m.version};opcode={m.opcode};state={m.state};hello={m.hellotime};hold={m.holdtime};" +
            "priority={m.priority};group={m.group};auth={hex(m.auth)};vip={hex(m.virtual_ip)}"
        }
    }
}

fn links(what: str, a: bytes) -> str {
    let rt = what.ends_with(".rt")
    if what.starts_with("lldp") {
        return match lldp.decode(a) {
            Err(_) -> "ERR"
            Ok(list) -> {
                if rt {
                    return hex(lldp.encode(list))
                }
                var parts: [str] = []
                for t in list {
                    parts.push("{t.kind}:{hex(t.value)}")
                }
                let ok = match lldp.check(list) {
                    Ok(_) -> "1"
                    Err(_) -> "0"
                }
                "tlvs=" + parts.join("|") + ";ok=" + ok + ";ttl={lldp.ttl_seconds(list)}"
            }
        }
    }
    if what.starts_with("stp") {
        return match stp.decode(a) {
            Err(_) -> "ERR"
            Ok(p) -> if rt { hex(stp.encode(p)) } else {
                "proto={p.proto};version={p.version};bpdutype={p.bpdutype};flags={p.bpduflags};rootid={p.rootid};" +
                "rootmac={hex(p.rootmac)};pathcost={p.pathcost};bridgeid={p.bridgeid};bridgemac={hex(p.bridgemac)};" +
                "portid={p.portid};age={p.age};maxage={p.maxage};hello={p.hellotime};fwd={p.fwddelay};rest={hex(p.rest)}"
            }
        }
    }
    if what.starts_with("cdp") {
        return match cdp.decode(a) {
            Err(_) -> "ERR"
            Ok(p) -> {
                if rt {
                    return hex(cdp.encode(p))
                }
                var parts: [str] = []
                for t in p.tlvs {
                    parts.push("{t.kind}:{hex(t.value)}")
                }
                "vers={p.version};ttl={p.ttl};cksum={p.checksum};ok=" + flag(cdp.checksum_holds(a)) + ";tlvs=" +
                parts.join("|")
            }
        }
    }
    if what.starts_with("nsh") {
        return match nsh.decode(a) {
            Err(_) -> "ERR"
            Ok(h) -> if rt { hex(nsh.encode(h)) } else {
                "ver={h.ver};oam={h.oam};ttl={h.ttl};mdtype={h.mdtype};nextproto={h.nextproto};spi={h.spi};si={h.si};" +
                "context={hex(h.context)};payload={hex(h.payload)}"
            }
        }
    }
    if what.starts_with("erspan") {
        return match erspan.decode(a) {
            Err(_) -> "ERR"
            Ok(h) -> if rt { hex(erspan.encode(h)) } else {
                "ver={h.ver};vlan={h.vlan};cos={h.cos};en={h.en};t={h.t};session={h.session_id};index={h.index};" +
                "ts={h.timestamp};sgt={h.sgt};p={h.p};ft={h.ft};hw={h.hw};d={h.d};gra={h.gra};o={h.o};" +
                "platform={hex(h.platform)};payload={hex(h.payload)}"
            }
        }
    }
    if what.starts_with("l2tp") {
        return match l2tp.decode(a) {
            Err(_) -> "ERR"
            Ok(h) -> if rt { hex(l2tp.encode(h)) } else {
                "flags={h.flags};version={h.version};len={h.length};tunnel={h.tunnel_id};session={h.session_id};" +
                "ns={h.ns};nr={h.nr};offset={h.offset};payload={hex(h.payload)}"
            }
        }
    }
    match pppoe.decode(a) {
        Err(_) -> "ERR"
        Ok(p) -> {
            if rt {
                return hex(pppoe.encode(p))
            }
            var parts: [str] = []
            if p.code != 0 {
                match pppoe.tags(p) {
                    Ok(list) -> {
                        for t in list {
                            parts.push("{t.kind}:{hex(t.value)}")
                        }
                    }
                    Err(_) -> parts.push("ERR")
                }
            }
            "version={p.version};type={p.kind};code={p.code};session={p.session_id};len={p.length};" +
            "payload={hex(p.payload)};tags=" + parts.join("|")
        }
    }
}

fn pfx(list: [BgpPrefix]) -> str {
    var parts: [str] = []
    for p in list {
        parts.push("{p.length}/{hex(p.prefix)}")
    }
    parts.join(",")
}

fn interior(what: str, a: bytes) -> str {
    let rt = what.ends_with(".rt")
    if what.starts_with("ospf") {
        return match ospf.decode(a) {
            Err(_) -> "ERR"
            Ok(p) -> {
                if rt {
                    return hex(ospf.encode(p))
                }
                var extra = ""
                if p.kind == 1 {
                    extra = match ospf.hello(p) {
                        Ok(h) -> ";hello={hex(h.mask)}/{h.interval}/{h.options}/{h.priority}/{h.dead_interval}/" +
                        "{hex(h.dr)}/{hex(h.bdr)}/{h.neighbors.len()}"
                        Err(_) -> ";hello=ERR"
                    }
                }
                if p.kind == 4 or p.kind == 5 {
                    extra = match ospf.lsa_headers(p) {
                        Ok(list) -> {
                            var parts: [str] = []
                            for h in list {
                                parts.push("{h.age}/{h.kind}/{hex(h.id)}/{h.seq}/{h.checksum}/{h.length}")
                            }
                            ";lsas=" + parts.join(",")
                        }
                        Err(_) -> ";lsas=ERR"
                    }
                }
                "version={p.version};type={p.kind};len={p.length};src={hex(p.router_id)};area={hex(p.area)};" +
                "chksum={p.checksum};authtype={p.autype}" + extra
            }
        }
    }
    if what.starts_with("lsack") {
        return "{ospf.lsa_checksum(a)}"
    }
    if what.starts_with("bgp") {
        return match bgp.decode(a) {
            Err(_) -> "ERR"
            Ok(got) -> {
                let m = got.0
                if rt {
                    return hex(bgp.encode(m))
                }
                var extra = ""
                if m.kind == 1 {
                    extra = match bgp.open(m) {
                        Ok(o) -> ";open={o.version}/{o.my_as}/{o.hold_time}/{hex(o.bgp_id)}/{o.params.len()}"
                        Err(_) -> ";open=ERR"
                    }
                }
                if m.kind == 2 {
                    extra = match bgp.update(m) {
                        Ok(u) -> {
                            var attrs: [str] = []
                            for x in u.attributes {
                                attrs.push("{x.flags}/{x.code}/{hex(x.value)}")
                            }
                            ";withdrawn=" + pfx(u.withdrawn) + ";attrs=" + attrs.join(",") + ";nlri=" + pfx(u.nlri)
                        }
                        Err(_) -> ";update=ERR"
                    }
                }
                "type={m.kind};len={got.1}" + extra
            }
        }
    }
    if what.starts_with("eigrp") {
        return match eigrp.decode(a) {
            Err(_) -> "ERR"
            Ok(p) -> {
                if rt {
                    return hex(eigrp.encode(p))
                }
                var parts: [str] = []
                for t in p.tlvs {
                    parts.push("{t.kind}:{hex(t.value)}")
                }
                "ver={p.version};opcode={p.opcode};chksum={p.checksum};flags={p.flags};seq={p.seq};ack={p.ack};" +
                "asn={p.asn};tlvs=" + parts.join("|")
            }
        }
    }
    if what.starts_with("pim") {
        return match pim.decode(a) {
            Err(_) -> "ERR"
            Ok(m) -> {
                if rt {
                    return hex(pim.encode(m))
                }
                var opts = ""
                if m.kind == 0 {
                    opts = match pim.hello_options(m) {
                        Ok(list) -> {
                            var parts: [str] = []
                            for o in list {
                                parts.push("{o.0}:{hex(o.1)}")
                            }
                            parts.join("|")
                        }
                        Err(_) -> "ERR"
                    }
                }
                "version={m.version};type={m.kind};chksum={m.checksum};body={hex(m.body)};opts=" + opts
            }
        }
    }
    match isis.decode(a) {
        Err(_) -> "ERR"
        Ok(p) -> {
            if rt {
                return hex(isis.encode(p))
            }
            var parts: [str] = []
            for t in p.tlvs {
                parts.push("{t.kind}:{hex(t.value)}")
            }
            "nlpid={p.nlpid};hdrlen={p.hdrlen};pdutype={p.pdutype};fixed={hex(p.fixed)};tlvs=" + parts.join("|")
        }
    }
}

fn wireless(what: str, a: bytes) -> str {
    let rt = what.ends_with(".rt")
    if what.starts_with("eapol") {
        return match eap.decode_eapol(a) {
            Err(_) -> "ERR"
            Ok(f) -> {
                if rt {
                    return hex(eap.encode_eapol(f))
                }
                var extra = ""
                if f.kind == 3 {
                    extra = match eap.key_frame(f) {
                        Ok(k) -> ";key={k.descriptor}/{k.info}/{k.key_length}/{hex(k.replay_counter)}/{hex(k.nonce)}/" +
                        "{hex(k.mic)}/{hex(k.data)}"
                        Err(_) -> ";key=ERR"
                    }
                }
                if f.kind == 0 {
                    extra = match eap.decode_eap(f.body) {
                        Ok(e) -> ";eap={e.code}/{e.id}/{e.length}/{e.method}/{hex(e.data)}"
                        Err(_) -> ";eap=ERR"
                    }
                }
                "version={f.version};type={f.kind};len={f.length}" + extra
            }
        }
    }
    if what.starts_with("radiotap") {
        return match radiotap.decode(a) {
            Err(_) -> "ERR"
            Ok(h) -> {
                if rt {
                    return hex(radiotap.encode(h))
                }
                var parts: [str] = []
                for f in h.fields {
                    parts.push("{f.bit}:{hex(f.value)}")
                }
                "len={h.length};present={h.presents[0]};fields=" + parts.join("|") + ";frame={hex(h.frame)}"
            }
        }
    }
    if what.starts_with("can") {
        return match canframe.decode(a) {
            Err(_) -> "ERR"
            Ok(f) -> if rt { hex(canframe.encode(f)) } else {
                "ext=" + flag(f.extended) + ";rtr=" + flag(f.remote) + ";err=" + flag(f.error) +
                ";id={f.id};len={f.length};data={hex(f.data)}"
            }
        }
    }
    if what.starts_with("usbpcap") {
        return match usbpcap.decode(a) {
            Err(_) -> "ERR"
            Ok(h) -> if rt { hex(usbpcap.encode(h)) } else {
                "hlen={h.header_len};irp={hex(h.irp_id)};status={h.status};function={h.function};info={h.info};" +
                "bus={h.bus};device={h.device};endpoint={h.endpoint};transfer={h.transfer};dlen={h.data_length};" +
                "data={hex(h.data)}"
            }
        }
    }
    match hci.decode(a) {
        Err(_) -> "ERR"
        Ok(p) -> if rt { hex(hci.encode(p)) } else {
            "type={p.kind};ogf={hci.ogf(p.opcode)};ocf={hci.ocf(p.opcode)};handle={p.handle};pb={p.pb};bc={p.bc};" +
            "code={p.code};payload={hex(p.payload)}"
        }
    }
}

fn answer(what: str, a: bytes, b: bytes) -> str {
    if what.starts_with("ospf") or what.starts_with("lsack") or what.starts_with("bgp") or
    what.starts_with("eigrp") or what.starts_with("pim") or what.starts_with("isis") {
        return interior(what, a)
    }
    if what.starts_with("eapol") or what.starts_with("radiotap") or what.starts_with("can") or
    what.starts_with("usbpcap") or what.starts_with("hci") {
        return wireless(what, a)
    }
    if what.starts_with("igmp") or what.starts_with("mpls") or what.starts_with("rip") or
    what.starts_with("vrrp") or what.starts_with("bfd") or what.starts_with("hsrp") {
        return routing(what, a, b)
    }
    links(what, a)
}

fn main() / {io} {
    let argv = args()
    var i = 0
    while i + 2 < argv.len() {
        print(answer(argv[i], from_hex(argv[i + 1]), from_hex(argv[i + 2])))
        i = i + 3
    }
}
