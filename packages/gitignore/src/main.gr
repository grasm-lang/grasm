// `.gitignore`, as git reads it.
//
// Every tool that walks a source tree needs this — a formatter, a linter, a
// bundler, a file watcher — and every one of them that writes its own gets
// it subtly wrong, which shows up as a tool that reformats `node_modules`
// or a watcher that wakes on every build artefact.
//
// ## Four rules that are not obvious
//
//   1. **The last matching pattern wins**, not the first. So `!keep.log`
//      after `*.log` re-includes it, and `*.log` after `!keep.log` does
//      not.
//   2. **A pattern with a slash in it is anchored**; one without is not.
//      `doc/x` matches only at the top, `x` matches at any depth. The
//      trailing slash of `build/` does not count as "having a slash": it
//      means directories only.
//   3. **A file under an ignored directory cannot be re-included.** Git
//      does not descend into an ignored directory, so a later `!` for
//      something inside it has nothing to match against. This is the rule
//      people spend the most time being surprised by.
//   4. **`*` does not cross a slash and `**` does.** `a/*/c` is one
//      directory deep; `a/**/c` is any number, including zero.
//
// ## What is not here
//
// Reading the files. Which `.gitignore` files apply to a path, and the
// global and repository-level ones beside them, is the caller's business —
// this matches a path against patterns it is given, and stays a pure
// function that a test can drive.

/// One line of a `.gitignore`, taken apart.
type IgnoreRule = {
    /// The pattern with its `!` and trailing `/` removed.
    pattern: str,
    /// Whether the line began with `!`.
    negated: bool,
    /// Whether the line ended with `/`, so it matches directories only.
    directory_only: bool,
    /// Whether the pattern is fixed to the top of the tree, which it is
    /// when it contains a slash anywhere but the end.
    anchored: bool,
}

/// Read a `.gitignore`'s lines into rules, skipping blanks and comments.
pub fn parse(text: str) -> [IgnoreRule] {
    var out: [IgnoreRule] = []
    for line in text.split("\n") {
        match rule_of(line) {
            Some(rule) -> out.push(rule)
            None -> {}
        }
    }
    return out
}

/// One line. `None` for a blank line or a comment, which match nothing.
pub fn rule_of(line: str) -> Option[IgnoreRule] {
    var text = trim_end(line)
    if text.len() == 0 {
        return None
    }
    if text.starts_with("#") {
        return None
    }
    var negated = false
    if text.starts_with("!") {
        negated = true
        text = text.substr(1, text.len() - 1)
    } else if text.starts_with("\\#") or text.starts_with("\\!") {
        // A backslash makes the first character literal, and the
        // backslash itself is not part of the pattern.
        text = text.substr(1, text.len() - 1)
    }
    var directory_only = false
    if text.ends_with("/") and text.len() > 1 {
        directory_only = true
        text = text.substr(0, text.len() - 1)
    }
    if text.len() == 0 {
        return None
    }
    let anchored = has_slash(text)
    if text.starts_with("/") {
        text = text.substr(1, text.len() - 1)
    }
    if text.len() == 0 {
        return None
    }
    return Some(IgnoreRule{ pattern: text, negated: negated,
        directory_only: directory_only, anchored: anchored })
}

/// Trailing spaces are not part of a pattern unless the last one is
/// escaped, which is the only way to write a name that ends in a space.
fn trim_end(line: str) -> str {
    var end = line.len()
    while end > 0 and line.substr(end - 1, 1) == " " {
        if end >= 2 and line.substr(end - 2, 1) == "\\" {
            return line.substr(0, end - 2) + " "
        }
        end = end - 1
    }
    return line.substr(0, end)
}

fn has_slash(text: str) -> bool {
    var i = 0
    while i < text.len() {
        if text.substr(i, 1) == "/" {
            return true
        }
        i = i + 1
    }
    return false
}

fn split_path(path: str) -> [str] {
    var out: [str] = []
    for piece in path.split("/") {
        if piece.len() > 0 {
            out.push(piece)
        }
    }
    return out
}

/// Whether one rule matches a path.
///
/// `path` is relative to the directory the `.gitignore` sits in, with `/`
/// separators and no leading slash.
pub fn rule_matches(rule: IgnoreRule, path: str, is_dir: bool) -> bool {
    return matches_as(rule, path, is_dir, true)
}

/// `own_path` is true when `path` is the path being asked about, and false
/// when it is an ancestor being tested to see whether the whole subtree is
/// out. The difference is the trailing `**`: `a/**` names the contents of
/// `a`, so asking about `a` itself answers yes, while asking whether `a` is
/// an excluded *directory* — which would stop `!a/b` from bringing a file
/// back — answers no. Git draws the line in the same place.
fn matches_as(rule: IgnoreRule, path: str, is_dir: bool,
    own_path: bool) -> bool {
    if rule.directory_only and not is_dir {
        return false
    }
    let parts = split_path(path)
    if parts.len() == 0 {
        return false
    }
    let pattern = split_path(rule.pattern)
    if rule.anchored {
        return segments_match(pattern, parts, 0, 0, is_dir and own_path)
    }
    // Unanchored: the pattern is a name, and it matches that name
    // wherever it appears.
    return glob_matches(rule.pattern, parts[parts.len() - 1])
}

/// Match pattern segments against path segments from a given point, with
/// `**` free to span any number of them.
///
/// `bare_tail` says whether a trailing `**` may match nothing at all,
/// which it may when the path is a directory being asked about in its own
/// right: `a/b/**` matches `a/b/`, but not a *file* called `a/b`.
fn segments_match(pattern: [str], parts: [str], p: i64, q: i64,
    bare_tail: bool) -> bool {
    var i = p
    var j = q
    while i < pattern.len() {
        if pattern[i] == "**" {
            if i + 1 == pattern.len() {
                return j < parts.len() or bare_tail
            }
            var k = j
            while k <= parts.len() {
                if segments_match(pattern, parts, i + 1, k, bare_tail) {
                    return true
                }
                k = k + 1
            }
            return false
        }
        if j >= parts.len() {
            return false
        }
        if not glob_matches(pattern[i], parts[j]) {
            return false
        }
        i = i + 1
        j = j + 1
    }
    // The pattern names a path, and only that path. A file *under* an
    // ignored directory is ignored because the directory is, which
    // `is_ignored` works out by asking about the directory — not because
    // the pattern reaches down into it. Letting it reach would make a
    // negated pattern re-include a whole subtree it never named.
    return j == parts.len()
}

/// One segment of a pattern against one segment of a path. `*` and `?` do
/// not cross a slash, which they cannot here because there is none left.
pub fn glob_matches(pattern: str, name: str) -> bool {
    return glob_from(pattern, name, 0, 0)
}

fn glob_from(pattern: str, name: str, p: i64, n: i64) -> bool {
    var i = p
    var j = n
    while i < pattern.len() {
        let here = pattern.substr(i, 1)
        if here == "*" {
            var k = j
            while k <= name.len() {
                if glob_from(pattern, name, i + 1, k) {
                    return true
                }
                k = k + 1
            }
            return false
        }
        if here == "?" {
            if j >= name.len() {
                return false
            }
            i = i + 1
            j = j + 1
        } else if here == "[" {
            let after = class_matches(pattern, name, i, j)
            if after < 0 {
                return false
            }
            i = after
            j = j + 1
        } else if here == "\\" and i + 1 < pattern.len() {
            if j >= name.len() or
            name.substr(j, 1) != pattern.substr(i + 1, 1) {
                return false
            }
            i = i + 2
            j = j + 1
        } else {
            if j >= name.len() or name.substr(j, 1) != here {
                return false
            }
            i = i + 1
            j = j + 1
        }
    }
    return j == name.len()
}

/// A `[...]` class against one character. Answers the index just past the
/// class, or -1 when it did not match.
fn class_matches(pattern: str, name: str, at: i64, j: i64) -> i64 {
    if j >= name.len() {
        return 0 - 1
    }
    var i = at + 1
    var negated = false
    if i < pattern.len() and (pattern.substr(i, 1) == "!" or
        pattern.substr(i, 1) == "^") {
        negated = true
        i = i + 1
    }
    let character = name.substr(j, 1)
    var hit = false
    var first = true
    while i < pattern.len() {
        if pattern.substr(i, 1) == "]" and not first {
            if hit != negated {
                return i + 1
            }
            return 0 - 1
        }
        first = false
        var low = pattern.substr(i, 1)
        if low == "\\" and i + 1 < pattern.len() {
            i = i + 1
            low = pattern.substr(i, 1)
        }
        if i + 2 < pattern.len() and pattern.substr(i + 1, 1) == "-" and
        pattern.substr(i + 2, 1) != "]" {
            let high = pattern.substr(i + 2, 1)
            if character >= low and character <= high {
                hit = true
            }
            i = i + 3
        } else {
            if character == low {
                hit = true
            }
            i = i + 1
        }
    }
    // An unclosed class is a literal `[`, which is what git does with it.
    return 0 - 1
}

/// Whether a path is ignored.
///
/// The ancestors are tested first and in order, because git does not
/// descend into an ignored directory: once a parent is ignored, nothing
/// below it can be brought back.
pub fn is_ignored(rules: [IgnoreRule], path: str, is_dir: bool) -> bool {
    let parts = split_path(path)
    var prefix = ""
    var i = 0
    while i + 1 < parts.len() {
        if i > 0 {
            prefix = prefix + "/"
        }
        prefix = prefix + parts[i]
        if decide(rules, prefix, true, false) {
            return true
        }
        i = i + 1
    }
    return decide(rules, path, is_dir, true)
}

/// The last rule that matches decides. Nothing matching means not ignored.
fn decide(rules: [IgnoreRule], path: str, is_dir: bool,
    own_path: bool) -> bool {
    var ignored = false
    for rule in rules {
        if matches_as(rule, path, is_dir, own_path) {
            ignored = not rule.negated
        }
    }
    return ignored
}
