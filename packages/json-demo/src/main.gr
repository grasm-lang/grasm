// The `json` package: parse, reach in, build, render.
//
// Every case here is text in and text out, so three engines are held to the
// same bytes. The awkward inputs are deliberate: a document is something
// somebody else wrote, and a parser that only ever sees documents its own
// author typed is a parser with one test.
import json

fn parsed(label: str, src: str) {
    match json.parse(src) {
        Ok(v) -> print("{label}: {json.kind(v)} -> {json.render(v)}")
        Err(e) -> print("{label}: refused -- {e.why} at {e.at}")
    }
}

fn reach(label: str, doc: ref Json, p: str) {
    match json.path(doc, p) {
        Some(v) -> print("  {label} {p} -> {json.render(v)}")
        None -> print("  {label} {p} -> (absent)")
    }
}

// A type of the program's own, read straight out of the text with the pull
// API: no tree is built, members may come in any order, one it does not know
// is skipped (and still checked), a repeated key keeps its first value as
// `get` would, and one that never came is an error of the program's own.
type Pin = { name: str, at: [i64], note: Option[str] }

fn read_pin(src: str) -> Pin ! JsonError {
    var r = json.reader(src)
    var name: Option[str] = None
    var at: Option[[i64]] = None
    var note: Option[str] = None
    var seen_note = false
    try json.open_object(r)
    var going = true
    while going {
        match try json.next_key(r) {
            None -> going = false
            Some(k) -> {
                if k == "name" and name.is_none() {
                    name = Some(try json.read_str(r))
                } else if k == "at" and at.is_none() {
                    var xs: [i64] = []
                    try json.open_list(r)
                    while try json.next_item(r) {
                        xs.push(try json.read_int(r))
                    }
                    at = Some(xs)
                } else if k == "note" and not seen_note {
                    seen_note = true
                    if not try json.read_null(r) {
                        note = Some(try json.read_str(r))
                    }
                } else {
                    try json.skip(r)
                }
            }
        }
    }
    try json.finish(r)
    match name {
        None -> fail(JsonError{ why: "missing `name`", at: r.i })
        Some(n) -> match at {
            None -> fail(JsonError{ why: "missing `at`", at: r.i })
            Some(xs) -> Pin{ name: n, at: xs, note: note }
        }
    }
}

fn pin(label: str, src: str) {
    match read_pin(src) {
        Ok(p) -> print("{label}: {p.name} at {p.at} note {p.note ?? "(none)"}")
        Err(e) -> print("{label}: refused -- {e.why} at {e.at}")
    }
}

fn int_read(label: str, src: str) {
    var r = json.reader(src)
    match json.read_int(r) {
        Ok(n) -> print("  {label}: {n}")
        Err(e) -> print("  {label}: refused -- {e.why} at {e.at}")
    }
}

fn kinds(src: str) -> str ! JsonError {
    var r = json.reader(src)
    var out: [str] = []
    try json.open_list(r)
    while try json.next_item(r) {
        out.push(try json.peek_kind(r))
        try json.skip(r)
    }
    try json.finish(r)
    out.join(" ")
}

fn skip_all(src: str) -> () ! JsonError {
    var r = json.reader(src)
    try json.skip(r)
    try json.finish(r)
}

fn skipped(label: str, src: str) {
    match skip_all(src) {
        Ok(_u) -> print("  {label}: fine")
        Err(e) -> print("  {label}: refused -- {e.why} at {e.at}")
    }
}

fn main() {
    print("-- parsing")
    parsed("null", "null")
    parsed("true", "true")
    parsed("number", "-4.5")
    parsed("whole number", "3.0")
    parsed("big number", "1e3")
    parsed("string", "\"hi\"")
    parsed("escapes", "\"a\\nb\\tc\\\"d\"")
    parsed("list", "[1, 2, 3]")
    parsed("object", "\{\"b\": 2, \"a\": 1}")
    parsed("nested", "\{\"xs\": [true, \{\"k\": null}]}")
    parsed("space everywhere", "  \{ \"a\" : [ 1 , 2 ] } ")
    parsed("empty list", "[]")
    parsed("empty object", "\{}")
    parsed("truncated", "[1, 2")
    parsed("no value", "\{\"k\": }")
    parsed("two values", "1 2")
    parsed("nothing", "")

    print("-- reaching in")
    let src = "\{\"user\": \{\"name\": \"ada\", \"age\": 36, \"tags\": [\"x\", \"y\"]}, \"ok\": true}"
    match json.parse(src) {
        Err(e) -> print("  could not parse: {e.why}")
        Ok(doc) -> {
            reach("path", doc, "user.name")
            reach("path", doc, "user.tags.1")
            reach("path", doc, "user.tags.-1")
            reach("path", doc, "user.missing")
            reach("path", doc, "user.tags.9")
            reach("path", doc, "")
            print("  keys -> {json.keys_of(doc)}")
            print("  count of the object -> {json.count(doc)}")
            let tags = json.path(doc, "user.tags") ?? json.null()
            print("  count of the list -> {json.count(tags)}")
            print("  count of a string -> {json.count(json.text("abc"))}")

            let name = json.path(doc, "user.name") ?? json.null()
            let age = json.path(doc, "user.age") ?? json.null()
            print("  as_str(name) -> {json.as_str(name) ?? "(not a string)"}")
            print("  as_str(age) -> {json.as_str(age) ?? "(not a string)"}")
            print("  as_int(age) -> {json.as_int(age) ?? -1}")
            print("  as_num(age) -> {json.as_num(age) ?? 0.0}")
            print("  as_int(3.5) -> {json.as_int(json.number(3.5)) ?? -1}")
            print("  as_bool(ok) -> {json.as_bool(json.path(doc, "ok") ?? json.null()) ?? false}")
            print("  is_null(missing) -> {json.is_null(json.path(doc, "nope") ?? json.null())}")

            print("-- and back out")
            print("  round trip -> {json.render(doc)}")
            print("  stable -> {json.render(json.parse(json.render(doc)) ?? json.null()) == json.render(doc)}")
        }
    }

    print("-- building")
    let built = json.object(
        ["name", "count", "tags", "ok", "nothing"],
        [json.text("ada"), json.number(2.0),
            json.list([json.text("x"), json.text("y")]),
            json.boolean(true), json.null()])
    print("  {json.render(built)}")
    print("  a key added -> {json.render(json.with_key(built, "extra", json.number(1.0)))}")
    print("  a key replaced -> {json.render(json.with_key(built, "name", json.text("bob")))}")
    print("  the original is unchanged -> {json.render(built)}")
    print("  an item added -> {json.render(json.with_item(json.list([json.number(1.0)]), json.number(2.0)))}")
    print("  keys and values of different lengths -> {json.render(json.object(["a", "b"], [json.number(1.0)]))}")
    print("  escaped on the way out -> {json.render(json.text("quote \" newline \n done"))}")
    print("  equal to itself -> {json.equal(built, built)}")
    print("  equal to a rebuild -> {json.equal(built, json.parse(json.render(built)) ?? json.null())}")
    print("  equal to something else -> {json.equal(built, json.number(1.0))}")

    print("-- text outside the first 65,536 characters")
    parsed("a surrogate pair", "\"\\ud83d\\ude00!\"")
    parsed("a lone high half", "\"a\\ud83db\"")
    parsed("a lone low half", "\"\\ude00\"")
    parsed("a raw multi-byte character", "\"caf\u{e9} \u{1f600}\"")
    parsed("a truncated pair", "\"\\ud83d\\ude")
    print("  control characters round trip -> {json.render(json.text("bell " + 7.to_char() + " end"))}")
    let back = json.parse(json.render(json.text("tab\tnul-ish " + 1.to_char()))) ?? json.null()
    print("  and read back -> {json.as_str(back) ?? "(refused)"}")
    parsed("a raw control character", "\"a" + 1.to_char() + "b\"")

    print("-- numbers past 2^53")
    let big = json.parse("9007199254740993") ?? json.null()
    print("  as_int(9007199254740993) -> {json.as_int(big) ?? -1}")
    print("  as_int(9007199254740991) -> {json.as_int(json.parse("9007199254740991") ?? json.null()) ?? -1}")

    print("-- giving a document back")
    let doc = json.parse("\{\"a\": [1, \{\"b\": 2}], \"c\": \"d\"}") ?? json.null()
    let inner = json.path(doc, "a.1") ?? json.null()
    json.free(doc)
    print("  the document -> {alive(doc)}")
    print("  a part of it -> {alive(inner)}")
    json.free(doc)
    print("  freed twice -> fine")

    print("-- reading without a tree")
    pin("in order", "\{\"name\": \"dock\", \"at\": [3, -4], \"note\": \"by the \\u00e9cluse\"}")
    pin("any order", "\{\"at\": [], \"note\": null, \"name\": \"caf\u{e9}\"}")
    pin("unknown members", "\{\"x\": \{\"y\": [1.5, true, null, \"\\u00e9\"]}, \"name\": \"a\", \"at\": [1]}")
    pin("a repeated key", "\{\"name\": \"first\", \"at\": [1], \"name\": \"second\"}")
    pin("a repeated key, broken the second time", "\{\"name\": \"first\", \"at\": [1], \"name\": tru}")
    pin("missing", "\{\"name\": \"a\"}")
    pin("wrong type", "\{\"name\": 7, \"at\": [1]}")
    pin("a fraction where a whole number goes", "\{\"name\": \"a\", \"at\": [1.5]}")
    pin("not an object", "[1]")
    pin("trailing comma", "\{\"name\": \"a\", \"at\": [1],}")
    pin("trailing comma in a list", "\{\"name\": \"a\", \"at\": [1,]}")
    pin("missing comma", "\{\"name\": \"a\" \"at\": [1]}")
    pin("missing colon", "\{\"name\" \"a\"}")
    pin("broken unknown member", "\{\"name\": \"a\", \"at\": [1], \"x\": [1, \"\\q\"]}")
    pin("truncated", "\{\"name\": \"a\", \"at\": [1")
    pin("trailing input", "\{\"name\": \"a\", \"at\": [1]} x")
    pin("nothing", "")
    let every_kind = kinds("[null, true, 1, -2.5, \"s\", [], \{}]") ?? "(refused)"
    print("  kinds -> {every_kind}")
    print("  kinds of garbage -> {kinds("[1, @]") ?? "(refused)"}")

    print("-- whole numbers, read exactly")
    int_read("9007199254740993", "9007199254740993")
    int_read("i64 max", "9223372036854775807")
    int_read("i64 min", "-9223372036854775808")
    int_read("one past i64 max", "9223372036854775808")
    int_read("twenty digits", "99999999999999999999")
    int_read("1.0", "1.0")
    int_read("1e3", "1e3")
    int_read("a lone minus", "-")
    int_read("a string", "\"1\"")

    print("-- skipping")
    skipped("a nested document", " \{\"a\": [1, \{\"b\": \"\\ud83d\\ude00\"}], \"c\": false} ")
    skipped("a bad escape", "[\"\\x\"]")
    skipped("a raw control character", "\"a" + 1.to_char() + "b\"")
    skipped("an unclosed object", "\{\"a\": 1")
    skipped("a bad number", "[1.2.3]")
    skipped("two values", "1 2")
}
