fn class_ak() -> i64 { return 38 }
fn class_ap() -> i64 { return 39 }
fn class_as() -> i64 { return 40 }
fn class_vf() -> i64 { return 41 }
fn class_vi() -> i64 { return 42 }
fn class_hh() -> i64 { return 43 }
fn class_ri() -> i64 { return 44 }

fn run_of(code: i64) -> i64 {
    var low = 0
    var high = LB_RUNS.len() / 4 - 1
    while low <= high {
        let middle = (low + high) / 2
        if code < LB_RUNS[middle * 4] {
            high = middle - 1
        } else if code > LB_RUNS[middle * 4 + 1] {
            low = middle + 1
        } else {
            return middle
        }
    }
    return 0 - 1
}

/// The Line_Break class of a code point, after the substitutions rule LB1
/// asks for: the classes that exist to be tailored are already resolved.
pub fn class_of(code: i64) -> i64 {
    let run = run_of(code)
    if run < 0 {
        return class_al()
    }
    return LB_RUNS[run * 4 + 2]
}

fn flags_of(code: i64) -> i64 {
    let run = run_of(code)
    if run < 0 {
        return 0
    }
    return LB_RUNS[run * 4 + 3]
}

fn is_initial_quote(code: i64) -> bool {
    return flags_of(code).bit_and(1) == 1
}

fn is_final_quote(code: i64) -> bool {
    return flags_of(code).bit_and(2) == 2
}

fn is_east_asian(code: i64) -> bool {
    return flags_of(code).bit_and(4) == 4
}

fn is_unassigned_pictograph(code: i64) -> bool {
    return flags_of(code).bit_and(8) == 8
}

fn is_dotted_circle(code: i64) -> bool {
    return flags_of(code).bit_and(16) == 16
}

/// The classes a combining mark may not attach to.
fn is_hard(kind: i64) -> bool {
    return kind == class_bk() or kind == class_cr() or
    kind == class_lf() or kind == class_nl() or
    kind == class_sp() or kind == class_zw()
}

/// The state of one position after rules LB9 and LB10 have been applied.
type LbCells = {
    /// The class each position acts as. A combining mark that attached
    /// takes its base's class; one that could not becomes `AL`.
    kinds: [i64],
    /// Whether the position is a mark attached to what came before, and so
    /// can never be broken at.
    attached: [bool],
    /// The raw class, which two rules need to see through the attachment.
    raw: [i64],
}

fn cells_of(codes: [i64]) -> LbCells {
    var raw: [i64] = []
    for code in codes {
        raw.push(class_of(code))
    }
    var kinds: [i64] = []
    var attached: [bool] = []
    var i = 0
    while i < raw.len() {
        let here = raw[i]
        if here == class_cm() or here == class_zwj() {
            if i > 0 and not is_hard(raw[i - 1]) {
                kinds.push(kinds[i - 1])
                attached.push(true)
            } else {
                // LB10: a mark with nothing to attach to is a letter.
                kinds.push(class_al())
                attached.push(false)
            }
        } else {
            kinds.push(here)
            attached.push(false)
        }
        i = i + 1
    }
    return LbCells{ kinds: kinds, attached: attached, raw: raw }
}

/// Walk back over spaces from `from` and answer where the run of them
/// starts, or `from + 1` when there are none.
fn before_spaces(cells: LbCells, from: i64) -> i64 {
    var i = from
    while i >= 0 and cells.kinds[i] == class_sp() {
        i = i - 1
    }
    return i
}

/// The class at a position, or `XX` when there is none — before the start
/// and past the end both answer with a class no rule names, which is what
/// lets the lookaheads be written without a bounds check at every use.
fn kind_at(cells: LbCells, at: i64) -> i64 {
    if at < 0 or at >= cells.kinds.len() {
        return class_xx()
    }
    return cells.kinds[at]
}

/// Whether what precedes `at`, ignoring spaces, is one of two classes.
fn spaced_back_is(cells: LbCells, at: i64, first: i64, second: i64) -> bool {
    let found = kind_at(cells, before_spaces(cells, at))
    return found == first or found == second
}

/// Whether `NU (SY | IS)*` ends at `at`: the body of a number, which the
/// separators inside it are part of.
fn number_body_before(cells: LbCells, at: i64) -> bool {
    var i = at
    while i >= 0 {
        let kind = cells.kinds[i]
        if kind == class_nu() {
            return true
        }
        if kind != class_sy() and kind != class_is() {
            return false
        }
        i = i - 1
    }
    return false
}

/// How many regional indicators end at `at`.
fn regionals_before(cells: LbCells, at: i64) -> i64 {
    var count = 0
    var i = at
    while i >= 0 and cells.kinds[i] == class_ri() {
        // A combining mark on an indicator is part of it, not another
        // one: two flags with an accent between them are still two.
        if not cells.attached[i] {
            count = count + 1
        }
        i = i - 1
    }
    return count
}

fn is_brahmic(kind: i64, code: i64) -> bool {
    return kind == class_ak() or kind == class_as() or
    is_dotted_circle(code)
}

/// Whether a line may be broken between `i - 1` and `i`.
///
/// The rules are applied in the order UAX #14 numbers them, and the first
/// one that matches decides. That order is the specification: several
/// rules match many pairs and only the earliest is meant to.
fn breaks_at(codes: [i64], cells: LbCells, i: i64) -> bool {
    let early = early_rules(codes, cells, i)
    if early != 0 {
        return early == 1
    }
    return late_rules(codes, cells, i)
}

/// Rules LB9 through LB18, which are the ones that reach backwards past
/// spaces. Answers 1 for a break, 2 for none, and 0 for undecided.
fn early_rules(codes: [i64], cells: LbCells, i: i64) -> i64 {
    // LB9: a mark is part of what it attaches to.
    if cells.attached[i] {
        return 2
    }
    let left = cells.kinds[i - 1]
    let right = cells.kinds[i]
    // LB4, LB5: a mandatory break, and the pair that is one break.
    if left == class_bk() {
        return 1
    }
    if left == class_cr() and right == class_lf() {
        return 2
    }
    if left == class_cr() or left == class_lf() or left == class_nl() {
        return 1
    }
    // LB6: never before one.
    if right == class_bk() or right == class_cr() or
    right == class_lf() or right == class_nl() {
        return 2
    }
    // LB7: never before a space or a zero-width space.
    if right == class_sp() or right == class_zw() {
        return 2
    }
    // LB8: after a zero-width space, past any spaces, always.
    let past_spaces = before_spaces(cells, i - 1)
    if kind_at(cells, past_spaces) == class_zw() {
        return 1
    }
    // LB8a: a joiner joins.
    if cells.raw[i - 1] == class_zwj() {
        return 2
    }
    // LB11: a word joiner joins on both sides.
    if right == class_wj() or left == class_wj() {
        return 2
    }
    // LB12, LB12a: non-breaking glue.
    if left == class_gl() {
        return 2
    }
    if right == class_gl() and left != class_sp() and
    left != class_ba() and left != class_hy() and left != class_hh() {
        return 2
    }
    // LB13: never before a closing bracket, an exclamation or a symbol.
    if right == class_cl() or right == class_cp() or
    right == class_ex() or right == class_sy() {
        return 2
    }
    // LB14: after an opening bracket, past any spaces.
    if kind_at(cells, past_spaces) == class_op() {
        return 2
    }
    // LB15a and LB15b: the quotes that open and close.
    if quote_opens(codes, cells, past_spaces) {
        return 2
    }
    if is_final_quote(codes[i]) and right == class_qu() and
    closes_after(cells, i) {
        return 2
    }
    // LB15c and LB15d: a full stop that starts a number.
    if left == class_sp() and right == class_is() and
    kind_at(cells, i + 1) == class_nu() {
        return 1
    }
    if right == class_is() {
        return 2
    }
    // LB16, LB17: a closing bracket and then a small kana, and the em
    // dash pair, both past spaces.
    if right == class_ns() and
    spaced_back_is(cells, i - 1, class_cl(), class_cp()) {
        return 2
    }
    if right == class_b2() and
    spaced_back_is(cells, i - 1, class_b2(), class_b2()) {
        return 2
    }
    // LB18: after a space, always.
    if left == class_sp() {
        return 1
    }
    return 0
}

/// Rules LB19 through LB31, which are pairs and runs.
fn late_rules(codes: [i64], cells: LbCells, i: i64) -> bool {
    let left = cells.kinds[i - 1]
    let right = cells.kinds[i]
    // LB19: quotes, other than the ones the two rules above handled.
    if right == class_qu() and not is_initial_quote(codes[i]) {
        return false
    }
    if left == class_qu() and not is_final_quote(codes[i - 1]) {
        return false
    }
    // LB19a: a quote beside something that is not East Asian.
    if right == class_qu() and not is_east_asian(codes[i - 1]) {
        return false
    }
    // A quote at the very end of the text counts as one with nothing
    // East Asian after it, which is what `eot` means in the rule.
    if right == class_qu() and (i + 1 >= codes.len() or
        not is_east_asian(codes[i + 1])) {
        return false
    }
    if left == class_qu() and not is_east_asian(codes[i]) {
        return false
    }
    if left == class_qu() and (i < 2 or
        not is_east_asian(codes[i - 2])) {
        return false
    }
    // LB20: a break is allowed either side of a contingent break.
    if right == class_cb() or left == class_cb() {
        return true
    }
    // LB20a: a hyphen at the start of a word joins to the word.
    if (left == class_hy() or left == class_hh()) and
    (right == class_al() or right == class_hl()) and
    starts_word(cells, base_index(cells, i - 1)) {
        return false
    }
    // LB21: the break-after and break-before classes.
    if right == class_ba() or right == class_hy() or
    right == class_hh() or right == class_ns() or left == class_bb() {
        return false
    }
    // LB21a: a Hebrew letter holds its hyphen to what follows.
    //
    // A hyphen, not any break-after character: the maqaf used to be
    // classed with the general break-after set and now has a class of its
    // own, so naming that set here would keep a Hebrew word joined to
    // whatever followed a mathematical space.
    if i >= 2 and cells.kinds[base_index(cells, i - 2)] == class_hl() and
    (left == class_hy() or left == class_hh()) and
    right != class_hl() {
        return false
    }
    // LB21b: a symbol before a Hebrew letter.
    if left == class_sy() and right == class_hl() {
        return false
    }
    // LB22: never before an inseparable.
    if right == class_in() {
        return false
    }
    // LB23: letters and digits do not part.
    if (left == class_al() or left == class_hl()) and
    right == class_nu() {
        return false
    }
    if left == class_nu() and (right == class_al() or
        right == class_hl()) {
        return false
    }
    // LB23a: an ideograph and its prefix or suffix.
    if left == class_pr() and (right == class_id() or
        right == class_eb() or right == class_em()) {
        return false
    }
    if (left == class_id() or left == class_eb() or
        left == class_em()) and right == class_po() {
        return false
    }
    // LB24: a currency symbol and a letter.
    if (left == class_pr() or left == class_po()) and
    (right == class_al() or right == class_hl()) {
        return false
    }
    if (left == class_al() or left == class_hl()) and
    (right == class_pr() or right == class_po()) {
        return false
    }
    return final_rules(codes, cells, i, left, right)
}

/// Rules LB25 through LB31: numbers, Hangul, letters and the emoji pairs.
fn final_rules(codes: [i64], cells: LbCells, i: i64, left: i64,
    right: i64) -> bool {
    // LB25: a number, with its sign, its separators and its bracket.
    if number_joins(cells, i, left, right) {
        return false
    }
    // LB26, LB27: Hangul syllables and their affixes.
    if left == class_jl() and (right == class_jl() or
        right == class_jv() or right == class_h2() or right == class_h3()) {
        return false
    }
    if (left == class_jv() or left == class_h2()) and
    (right == class_jv() or right == class_jt()) {
        return false
    }
    if (left == class_jt() or left == class_h3()) and
    right == class_jt() {
        return false
    }
    if is_hangul(left) and right == class_po() {
        return false
    }
    if left == class_pr() and is_hangul(right) {
        return false
    }
    // LB28: two letters.
    if (left == class_al() or left == class_hl()) and
    (right == class_al() or right == class_hl()) {
        return false
    }
    // LB28a: the Brahmic clusters.
    if brahmic_joins(codes, cells, i, left, right) {
        return false
    }
    // LB29: a full stop and a letter.
    if left == class_is() and (right == class_al() or
        right == class_hl()) {
        return false
    }
    // LB30: brackets that are not East Asian, beside letters and digits.
    if (left == class_al() or left == class_hl() or
        left == class_nu()) and right == class_op() and
    not is_east_asian(codes[i]) {
        return false
    }
    if left == class_cp() and not is_east_asian(codes[i - 1]) and
    (right == class_al() or right == class_hl() or
        right == class_nu()) {
        return false
    }
    // LB30a: regional indicators pair off into flags.
    if left == class_ri() and right == class_ri() and
    regionals_before(cells, i - 1) % 2 == 1 {
        return false
    }
    // LB30b: an emoji base and its modifier.
    if left == class_eb() and right == class_em() {
        return false
    }
    if is_unassigned_pictograph(codes[base_index(cells, i - 1)]) and
    right == class_em() {
        return false
    }
    // LB31: anything else may break.
    return true
}

fn is_hangul(kind: i64) -> bool {
    return kind == class_jl() or kind == class_jv() or
    kind == class_jt() or kind == class_h2() or kind == class_h3()
}

/// LB15a: an initial quote that itself follows an opening context.
fn quote_opens(codes: [i64], cells: LbCells, past_spaces: i64) -> bool {
    if past_spaces < 0 {
        return false
    }
    // The quote may be carrying combining marks; it is the quote itself
    // that has to be an initial one, not the accent on the end of it.
    let quote = base_index(cells, past_spaces)
    if cells.kinds[quote] != class_qu() or
    not is_initial_quote(codes[quote]) {
        return false
    }
    if quote == 0 {
        return true
    }
    let before = cells.kinds[quote - 1]
    return before == class_bk() or before == class_cr() or
    before == class_lf() or before == class_nl() or
    before == class_op() or before == class_qu() or
    before == class_gl() or before == class_sp() or
    before == class_zw()
}

/// LB15b: a final quote followed by something that closes.
fn closes_after(cells: LbCells, at: i64) -> bool {
    if at + 1 >= cells.kinds.len() {
        return true
    }
    let after = cells.kinds[at + 1]
    return after == class_sp() or after == class_gl() or
    after == class_wj() or after == class_cl() or
    after == class_qu() or after == class_cp() or
    after == class_ex() or after == class_is() or
    after == class_sy() or after == class_bk() or
    after == class_cr() or after == class_lf() or
    after == class_nl() or after == class_zw()
}

/// The base a position belongs to: a combining mark answers with the
/// character it attached to, which is what the rules that look at context
/// mean by "the character before".
fn base_index(cells: LbCells, at: i64) -> i64 {
    var i = at
    while i > 0 and cells.attached[i] {
        i = i - 1
    }
    return i
}

/// LB20a's left-hand context: the hyphen begins a word.
fn starts_word(cells: LbCells, at: i64) -> bool {
    if at == 0 {
        return true
    }
    let before = cells.kinds[at - 1]
    return before == class_bk() or before == class_cr() or
    before == class_lf() or before == class_nl() or
    before == class_sp() or before == class_zw() or
    before == class_cb() or before == class_gl()
}

/// LB25, written out as the pairs the specification decomposes it into.
///
/// The list is exactly the one in UAX #14, which is longer than the
/// regular expression it replaced and is the only form that can be applied
/// one pair at a time. `IS × NU` is the surprising member: a full stop
/// followed by digits is the start of a number even with a letter in front
/// of it, so `a.2` does not break and `equals .35` breaks before the stop
/// rather than after it.
fn number_joins(cells: LbCells, i: i64, left: i64, right: i64) -> bool {
    // NU ( SY | IS )* × ( NU | PO | PR )
    if number_body_before(cells, i - 1) and (right == class_nu() or
        right == class_po() or right == class_pr()) {
        return true
    }
    // NU ( SY | IS )* ( CL | CP ) × ( PO | PR )
    if (left == class_cl() or left == class_cp()) and i >= 2 and
    number_body_before(cells, i - 2) and (right == class_po() or
        right == class_pr()) {
        return true
    }
    // ( PO | PR ) × NU, and past an opening bracket and a full stop.
    if left == class_po() or left == class_pr() {
        if right == class_nu() {
            return true
        }
        if right == class_op() {
            if kind_at(cells, i + 1) == class_nu() {
                return true
            }
            if kind_at(cells, i + 1) == class_is() and
            kind_at(cells, i + 2) == class_nu() {
                return true
            }
        }
    }
    // HY × NU and IS × NU.
    if (left == class_hy() or left == class_is()) and
    right == class_nu() {
        return true
    }
    return false
}

/// LB28a, the Brahmic consonant clusters.
fn brahmic_joins(codes: [i64], cells: LbCells, i: i64, left: i64,
    right: i64) -> bool {
    // The dotted circle stands in for a consonant, and a mark riding on
    // one of these is part of it — so every test here is against the base
    // rather than against the character immediately to the left.
    let left_base = base_index(cells, i - 1)
    let left_cluster = is_brahmic(left, codes[left_base])
    let right_cluster = is_brahmic(right, codes[i])
    if left == class_ap() and (right_cluster or right == class_as()) {
        return true
    }
    if (left_cluster or left == class_as()) and
    (right == class_vf() or right == class_vi()) {
        return true
    }
    if left == class_vi() and left_base > 0 {
        let before = base_index(cells, left_base - 1)
        if is_brahmic(cells.kinds[before], codes[before]) and
        (right_cluster or right == class_ak()) {
            return true
        }
    }
    if left_cluster and right_cluster and
    kind_at(cells, i + 1) == class_vf() {
        return true
    }
    return false
}

/// The code point offsets a line may be broken before, not counting the
/// start, and always including the end.
pub fn boundaries_of(codes: [i64]) -> [i64] {
    var out: [i64] = []
    if codes.len() == 0 {
        return out
    }
    let cells = cells_of(codes)
    var i = 1
    while i < codes.len() {
        if breaks_at(codes, cells, i) {
            out.push(i)
        }
        i = i + 1
    }
    out.push(codes.len())
    return out
}

/// The same, for a string.
pub fn boundaries(text: str) -> [i64] {
    var codes: [i64] = []
    for character in text.chars() {
        codes.push(character.code_at(0))
    }
    return boundaries_of(codes)
}

/// A string cut at every place it may be broken.
pub fn pieces(text: str) -> [str] {
    let characters = text.chars()
    var out: [str] = []
    var start = 0
    for mark in boundaries(text) {
        var piece = ""
        var i = start
        while i < mark {
            piece = piece + characters[i]
            i = i + 1
        }
        out.push(piece)
        start = mark
    }
    return out
}
