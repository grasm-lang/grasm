// The pflog header: what OpenBSD's and FreeBSD's packet filter put before
// each packet it logs (`tcpdump -i pflog0`, link type 117).
//
// The rule that matched, the action taken (pass, block, scrub...), the
// reason, the interface and ruleset names, the user and process that owned
// the socket, the direction, and -- when NAT rewrote the packet -- the
// addresses and ports before rewriting. The header's own first byte says
// its length, so a log from a newer pf with a longer header still parses:
// the fields this knows are read, and the payload starts where the header
// says it ends.
//
// Each address is a `pf_addr`, a sixteen-byte union whatever the family:
// an IPv4 address is its first four bytes and the rest is zeros, so the
// header is 100 bytes either way. `saddr` and `daddr` are the address
// itself -- four bytes or sixteen.

type PflogHeader = {
    hdrlen: i64,
    addrfamily: i64,
    action: i64,
    reason: i64,
    iface: str,
    ruleset: str,
    rulenumber: i64,
    subrulenumber: i64,
    uid: i64,
    pid: i64,
    ruleuid: i64,
    rulepid: i64,
    direction: i64,
    rewritten: i64,
    naddrfamily: i64,
    pad: i64,
    saddr: bytes,
    daddr: bytes,
    sport: i64,
    dport: i64,
    payload: bytes,
}

type PflogError =
    | TooShort(found: i64)

fn s32(b: bytes, at: i64) -> i64 {
    let v = b.at(at).shl(24).bit_or(b.at(at + 1).shl(16)).bit_or(b.at(at + 2).shl(8)).bit_or(b.at(at + 3))
    if v >= 2147483648 { v - 4294967296 } else { v }
}

fn u32(b: bytes, at: i64) -> i64 {
    b.at(at).shl(24).bit_or(b.at(at + 1).shl(16)).bit_or(b.at(at + 2).shl(8)).bit_or(b.at(at + 3))
}

fn be32(v: i64) -> bytes {
    bytes_of([v.ushr(24).bit_and(255), v.ushr(16).bit_and(255), v.ushr(8).bit_and(255),
        v.bit_and(255)])
}

fn text16(b: bytes, at: i64) -> str {
    var end = at
    while end < at + 16 and b.at(end) != 0 {
        end = end + 1
    }
    b.slice(at, end).to_str()
}

fn addr_len(family: i64) -> i64 {
    if family == 24 or family == 28 or family == 30 { 16 } else { 4 }
}

/// The header (the 64-byte OpenBSD layout, with addresses sized by the
/// family) and the payload after `hdrlen` bytes.
pub fn decode(data: bytes) -> PflogHeader ! PflogError {
    let n = addr_len(data.at(1))
    let fixed = 100
    if data.len() < fixed {
        fail(TooShort(data.len()))
    }
    let hdrlen = data.at(0)
    let start = if hdrlen > fixed { hdrlen } else { fixed }
    PflogHeader{ hdrlen: hdrlen, addrfamily: data.at(1), action: data.at(2), reason: data.at(3),
        iface: text16(data, 4), ruleset: text16(data, 20), rulenumber: s32(data, 36),
        subrulenumber: s32(data, 40), uid: s32(data, 44), pid: u32(data, 48),
        ruleuid: s32(data, 52), rulepid: u32(data, 56), direction: data.at(60),
        rewritten: data.at(61), naddrfamily: data.at(62), pad: data.at(63),
        saddr: data.slice(64, 64 + n), daddr: data.slice(80, 80 + n),
        sport: data.at(96) * 256 + data.at(97), dport: data.at(98) * 256 + data.at(99),
        payload: data.slice(if start <= data.len() { start } else { data.len() }, data.len()) }
}

fn name16(s: str) -> bytes {
    let b = s.to_bytes()
    if b.len() >= 16 { b.slice(0, 16) } else { b.concat(bytes_filled(16 - b.len(), 0)) }
}

fn fit(b: bytes, n: i64) -> bytes {
    if b.len() >= n { b.slice(0, n) } else { b.concat(bytes_filled(n - b.len(), 0)) }
}

pub fn encode(h: PflogHeader) -> bytes {
    bytes_of([h.hdrlen.bit_and(255), h.addrfamily.bit_and(255), h.action.bit_and(255),
        h.reason.bit_and(255)]).concat(name16(h.iface)).concat(name16(h.ruleset))
        .concat(be32(h.rulenumber)).concat(be32(h.subrulenumber)).concat(be32(h.uid))
        .concat(be32(h.pid)).concat(be32(h.ruleuid)).concat(be32(h.rulepid))
        .concat(bytes_of([h.direction.bit_and(255), h.rewritten.bit_and(255),
        h.naddrfamily.bit_and(255), h.pad.bit_and(255)]))
        .concat(fit(h.saddr, 16)).concat(fit(h.daddr, 16))
        .concat(bytes_of([h.sport.ushr(8).bit_and(255), h.sport.bit_and(255), h.dport.ushr(8).bit_and(255),
        h.dport.bit_and(255)])).concat(h.payload)
}

/// pf's actions by number: pass, block, scrub, no scrub, nat, no nat...
pub fn action_name(a: i64) -> str {
    let names = ["pass", "block", "scrub", "noscrub", "nat", "nonat", "binat", "nobinat", "rdr",
        "nordr", "synproxy-drop", "defer", "match", "divert", "rt", "afrt"]
    if a >= 0 and a < names.len() { names[a] } else { "unknown" }
}
