// k nearest neighbours: the model is the training set.
//
// There is no fitting. To classify a point, find the k training points
// closest to it and take a vote. That is the whole algorithm, and it is
// worth having for three reasons: it is the baseline every other classifier
// has to beat, its decision boundary can be any shape at all, and when it
// wins it says something real about the problem — that similar inputs have
// similar answers, which not every problem satisfies.
//
// ## What it costs
//
// Nothing to train and everything to predict: one distance per training
// point per query. A million training rows means a million distances for
// every prediction, which is why the practical versions are all about the
// index — a k-d tree, a ball tree, or an approximate one.
//
// ## Why scaling is not optional
//
// The distance sums the features, so a feature measured in metres and one
// measured in kilometres contribute in a ratio of a million to one. The
// model then depends entirely on the units somebody happened to record.
// Standardising is not a refinement here; without it the answer is
// arbitrary, and `standardise` is in this package for that reason.
//
// ## The curse, said concretely
//
// In high dimensions every point is about the same distance from every
// other, so "nearest" stops meaning anything. With uniform random points in
// 100 dimensions the ratio between the farthest and the nearest neighbour
// is about 1.03. The neighbours are still returned and the votes still
// counted and the answer is noise.

type KnnError =
    | NoPoints()
    | LengthMismatch(rows: i64, labels: i64)
    | RaggedRows(row: i64, width: i64)
    | BadNeighbourCount(k: i64)
    | NoVariation(column: i64)

/// One neighbour: which training row, and how far.
type Neighbour = {
    index: i64,
    distance: f64,
}

fn check_data(rows: [[f64]]) -> i64 ! KnnError {
    if rows.len() == 0 {
        fail(NoPoints())
    }
    let width = rows[0].len()
    var i = 0
    while i < rows.len() {
        if rows[i].len() != width {
            fail(RaggedRows(i, width))
        }
        i = i + 1
    }
    return width
}

/// The Euclidean distance.
pub fn euclidean(a: [f64], b: [f64]) -> f64 {
    var total = 0.0
    var i = 0
    while i < a.len() and i < b.len() {
        let gap = a[i] - b[i]
        total = total + gap * gap
        i = i + 1
    }
    return total.sqrt()
}

/// The Manhattan distance, which is the right one when the features are
/// counts rather than positions.
pub fn manhattan(a: [f64], b: [f64]) -> f64 {
    var total = 0.0
    var i = 0
    while i < a.len() and i < b.len() {
        total = total + (a[i] - b[i]).abs()
        i = i + 1
    }
    return total
}

/// The Minkowski distance of order `p`, which is Manhattan at 1 and
/// Euclidean at 2.
pub fn minkowski(a: [f64], b: [f64], p: f64) -> f64 {
    if p == 1.0 {
        return manhattan(a, b)
    }
    if p == 2.0 {
        return euclidean(a, b)
    }
    var total = 0.0
    var i = 0
    while i < a.len() and i < b.len() {
        let gap = (a[i] - b[i]).abs()
        if gap > 0.0 {
            total = total + (p * gap.ln()).exp()
        }
        i = i + 1
    }
    if total == 0.0 {
        return 0.0
    }
    return (total.ln() / p).exp()
}

/// The `k` nearest training rows, nearest first.
///
/// Ties in distance are broken by the training row's own index, which is
/// what makes the answer reproducible; without a rule the vote depends on
/// the order the rows happened to be read in.
pub fn neighbours_of(rows: [[f64]], query: [f64],
    k: i64) -> [Neighbour] ! KnnError {
    let _width = try check_data(rows)
    if k < 1 or k > rows.len() {
        fail(BadNeighbourCount(k))
    }
    var found: [Neighbour] = []
    var i = 0
    while i < rows.len() {
        found.push(Neighbour{ index: i, distance: euclidean(query,
            rows[i]) })
        i = i + 1
    }
    var a = 1
    while a < found.len() {
        let value = found[a]
        var b = a - 1
        while b >= 0 and after(found[b], value) {
            found[b + 1] = found[b]
            b = b - 1
        }
        found[b + 1] = value
        a = a + 1
    }
    var out: [Neighbour] = []
    var j = 0
    while j < k {
        out.push(found[j])
        j = j + 1
    }
    return out
}

fn after(left: Neighbour, right: Neighbour) -> bool {
    if left.distance != right.distance {
        return left.distance > right.distance
    }
    return left.index > right.index
}

/// The class the neighbours vote for.
///
/// A tie between classes goes to the lowest label, which is what
/// scikit-learn does and is worth saying out loud: with an even `k` on a
/// two-class problem, ties happen constantly and the choice is not
/// arbitrary once it is written down.
pub fn classify(rows: [[f64]], labels: [i64], query: [f64], k: i64,
    classes: i64) -> i64 ! KnnError {
    if rows.len() != labels.len() {
        fail(LengthMismatch(rows.len(), labels.len()))
    }
    let near = try neighbours_of(rows, query, k)
    var votes: [i64] = []
    var c = 0
    while c < classes {
        votes.push(0)
        c = c + 1
    }
    for one in near {
        votes[labels[one.index]] = votes[labels[one.index]] + 1
    }
    var best = 0
    var i = 1
    while i < classes {
        if votes[i] > votes[best] {
            best = i
        }
        i = i + 1
    }
    return best
}

/// The same, with each neighbour weighted by one over its distance.
///
/// A neighbour sitting exactly on the query has an infinite weight, so it
/// wins outright — which is the behaviour anybody would want and is a
/// special case every implementation has to write.
pub fn classify_weighted(rows: [[f64]], labels: [i64], query: [f64],
    k: i64, classes: i64) -> i64 ! KnnError {
    if rows.len() != labels.len() {
        fail(LengthMismatch(rows.len(), labels.len()))
    }
    let near = try neighbours_of(rows, query, k)
    var weights: [f64] = []
    var c = 0
    while c < classes {
        weights.push(0.0)
        c = c + 1
    }
    var exact = false
    for one in near {
        if one.distance == 0.0 {
            exact = true
        }
    }
    for one in near {
        if exact {
            if one.distance == 0.0 {
                weights[labels[one.index]] = weights[labels[one.index]] + 1.0
            }
        } else {
            weights[labels[one.index]] = weights[labels[one.index]] +
            1.0 / one.distance
        }
    }
    var best = 0
    var i = 1
    while i < classes {
        if weights[i] > weights[best] {
            best = i
        }
        i = i + 1
    }
    return best
}

/// The mean of the neighbours' values: k nearest neighbours as a regressor.
pub fn regress(rows: [[f64]], values: [f64], query: [f64],
    k: i64) -> f64 ! KnnError {
    if rows.len() != values.len() {
        fail(LengthMismatch(rows.len(), values.len()))
    }
    let near = try neighbours_of(rows, query, k)
    var total = 0.0
    for one in near {
        total = total + values[one.index]
    }
    return total / k.as_f64()
}

/// The columns' means and standard deviations, with the population divisor.
///
/// The population divisor rather than the sample one, because this is
/// scaling rather than inference and because it is what scikit-learn's
/// StandardScaler uses — a difference of one part in `n` that shows up in
/// the sixth decimal of every scaled value if you get it wrong.
pub fn scaling_of(rows: [[f64]]) -> ([f64], [f64]) ! KnnError {
    let width = try check_data(rows)
    var means: [f64] = []
    var deviations: [f64] = []
    var column = 0
    while column < width {
        var total = 0.0
        var i = 0
        while i < rows.len() {
            total = total + rows[i][column]
            i = i + 1
        }
        let mean = total / rows.len().as_f64()
        var spread = 0.0
        var j = 0
        while j < rows.len() {
            let gap = rows[j][column] - mean
            spread = spread + gap * gap
            j = j + 1
        }
        let deviation = (spread / rows.len().as_f64()).sqrt()
        means.push(mean)
        // A column that never varies would divide by zero. Scaling it by one
        // leaves it as a column of zeros after centring, which is what
        // StandardScaler does and is the only answer that does not produce
        // infinities downstream.
        if deviation == 0.0 {
            deviations.push(1.0)
        } else {
            deviations.push(deviation)
        }
        column = column + 1
    }
    return (means, deviations)
}

/// Rows centred and scaled by a scaling computed from the training set.
///
/// The scaling must come from the training rows and be applied to the test
/// rows: computing it over both together lets the test set influence the
/// model, which is the commonest way a reported accuracy turns out to be
/// wrong.
pub fn standardise(rows: [[f64]], means: [f64],
    deviations: [f64]) -> [[f64]] ! KnnError {
    let width = try check_data(rows)
    if means.len() != width or deviations.len() != width {
        fail(LengthMismatch(width, means.len()))
    }
    var out: [[f64]] = []
    var i = 0
    while i < rows.len() {
        var row: [f64] = []
        var column = 0
        while column < width {
            row.push((rows[i][column] - means[column]) /
                deviations[column])
            column = column + 1
        }
        out.push(row)
        i = i + 1
    }
    return out
}
