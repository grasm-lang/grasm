import deflate
import zlib

fn from_hex(text: str) -> bytes {
    var out: [i64] = []
    var i = 1
    while i + 1 < text.len() {
        out.push(text.substr(i, 2).parse_int_base(16) ?? 0)
        i = i + 2
    }
    return bytes_of(out)
}

fn to_hex(raw: bytes) -> str {
    let digits = "0123456789abcdef"
    var out = ""
    var i = 0
    while i < raw.len() {
        out = out + digits.substr(raw.at(i) / 16, 1) +
        digits.substr(raw.at(i) % 16, 1)
        i = i + 1
    }
    return out
}

fn main() / {io} {
    var i = 0
    while i + 1 < args().len() {
        let what = args()[i]
        let raw = from_hex(args()[i + 1])
        if what == "deflate" {
            print(to_hex(deflate.compress(raw)))
        } else if what == "zlib" {
            print(to_hex(deflate.compress_zlib(raw, zlib.adler32(raw))))
        } else if what == "roundtrip" {
            // Our own reader has to accept our own writer.
            let back = zlib.inflate(deflate.compress(raw), 1000000) ??
            "".to_bytes()
            print(to_hex(back))
        } else if what == "matched" {
            print(deflate.matched_bytes(raw).to_str())
        }
        i = i + 2
    }
}
