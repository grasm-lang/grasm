    "Unlicense Unlicense-libtelnet Unlicense-libwhirlpool VOSTROM VSL-1.0 " +
    "Vim W3C W3C-19980720 W3C-20150513 WTFPL " +
    "Watcom-1.0 Widget-Workshop Wsuipa X11 X11-distribute-modifications-variant " +
    "X11-swapped XFree86-1.1 XSkat Xdebug-1.03 Xerox " +
