// SPDX license expressions, and the register they name.
//
// `MIT`, `Apache-2.0 OR MIT`, `GPL-2.0-only WITH Classpath-exception-2.0` —
// the little grammar every package manifest now carries in its `license`
// field, and the reason a build can answer "may we ship this" without a
// lawyer reading every dependency.
//
// ## What makes it worth parsing rather than comparing as text
//
// **`OR` is a choice and `AND` is an obligation.** `Apache-2.0 OR MIT` means
// take either; `Apache-2.0 AND MIT` means comply with both. A policy engine
// that treats the field as a string cannot tell those apart, and they are
// opposite answers to the only question anyone asks it.
//
// **The identifiers are a closed set.** `MIT-License`, `Apache2`, `BSD` and
// `Apache License 2.0` are all things people write in that field and none of
// them are SPDX identifiers. Checking against the register turns a typo into
// an error instead of into an unlicensed dependency nobody noticed.
//
// **The old spellings still mean something.** `GPL-2.0` was replaced by
// `GPL-2.0-only` in 2018 because the old one was ambiguous between "version
// 2" and "version 2 or later" — the difference that decides GPL-3
// compatibility. Every manifest written before then still says `GPL-2.0`, so
// this resolves it rather than rejecting it, and says that it did.
//
// ## What this is not
//
// Legal advice, and not a compatibility matrix. It parses, validates,
// normalises, and answers "is this expression satisfied by the licenses we
// accept" — which is a question about *your* policy list, not about what any
// licence permits. There is no `is_compatible_with` here because there is no
// honest one.
//
// Checked against Python's `license-expression`, which is the library the
// SPDX tooling itself uses: the normalised form of every expression below is
// the string it produces.

type SpdxNode = {
    /// `license`, `and`, or `or`.
    kind: str,
    /// The identifier, for a license node.
    id: str,
    /// The exception after `WITH`, or empty.
    exception: str,
    /// Indices of the operands, for an operator node.
    left: i64,
    right: i64,
}

type SpdxError =
    | Empty()
    | UnknownLicense(id: str)
    | UnknownException(id: str)
    | UnexpectedToken(text: str)
    | UnclosedParenthesis()
    | TrailingInput(text: str)

fn split_words(text: str) -> [str] {
    var out: [str] = []
    for w in text.split(" ") {
        if w != "" {
            out.push(w)
        }
    }
    return out
}

fn lookup(list: str, id: str) -> str {
    let wanted = id.to_lower()
    for known in split_words(list) {
        if known.to_lower() == wanted {
            return known
        }
    }
    return ""
}

/// Whether the identifier is on the register, in any casing.
///
/// SPDX identifiers are compared case-insensitively and written in one
/// canonical case, which is why `canonical_id` exists and why comparing the
/// field as text finds `mit` and `MIT` to be different licenses.
pub fn is_license_id(id: str) -> bool {
    return lookup(license_ids(), strip_plus(id)) != "" or
    alias_for(strip_plus(id)) != ""
}

pub fn is_exception_id(id: str) -> bool {
    return lookup(exception_ids(), id) != ""
}

fn strip_plus(id: str) -> str {
    if id.ends_with("+") {
        return id.substr(0, id.len() - 1)
    }
    return id
}

fn alias_for(id: str) -> str {
    let wanted = id.to_lower()
    for pair in split_words(alias_pairs()) {
        let at = pair.index_of("=") ?? (0 - 1)
        if at < 0 {
            continue
        }
        if pair.substr(0, at).to_lower() == wanted {
            return pair.substr(at + 1, pair.len() - at - 1)
        }
    }
    return ""
}

/// The register's own spelling of an identifier, resolving a withdrawn one.
///
/// `gpl-2.0` and `GPL-2.0` and `GPL-2.0-only` all come back as
/// `GPL-2.0-only`, and `GPL-2.0+` as `GPL-2.0-or-later` — the `+` suffix is
/// the old way of writing "or later" and means exactly that.
pub fn canonical_id(id: str) -> str ! SpdxError {
    let alias = alias_for(id)
    if alias != "" {
        return alias
    }
    let direct = lookup(license_ids(), id)
    if direct != "" {
        return direct
    }
    fail(UnknownLicense(id))
}

pub fn canonical_exception(id: str) -> str ! SpdxError {
    let direct = lookup(exception_ids(), id)
    if direct != "" {
        return direct
    }
    fail(UnknownException(id))
}

/// Whether the identifier is one the register has withdrawn.
pub fn is_deprecated(id: str) -> bool {
    return alias_for(id) != "" or lookup(deprecated_ids(), id) != ""
}

// ------------------------------------------------------------- parsing

fn tokenize(text: str) -> [str] {
    var out: [str] = []
    var current = ""
    for c in text.chars() {
        if c == "(" or c == ")" {
            if current != "" {
                out.push(current)
                current = ""
            }
            out.push(c)
            continue
        }
        if c == " " or c == "\t" or c == "\n" {
            if current != "" {
                out.push(current)
                current = ""
            }
            continue
        }
        current = current + c
    }
    if current != "" {
        out.push(current)
    }
    return out
}

/// The expression as a tree, held as a list with the root last.
///
/// `AND` binds tighter than `OR` and `WITH` tighter than both, which is the
/// precedence the specification gives and the one a reader assumes: `A AND B
/// OR C` is `(A AND B) OR C`, an obligation or an alternative, and not an
/// obligation to satisfy A together with a choice.
pub fn parse(text: str) -> [SpdxNode] ! SpdxError {
    let tokens = tokenize(text)
    if tokens.len() == 0 {
        fail(Empty())
    }
    var nodes: [SpdxNode] = []
    var at = 0
    let root = try parse_or(tokens, at, nodes)
    if at < tokens.len() {
        fail(TrailingInput(tokens[at]))
    }
    if root != nodes.len() - 1 {
        fail(UnexpectedToken(text))
    }
    return nodes
}

fn parse_or(tokens: [str], inout at: i64,
    inout nodes: [SpdxNode]) -> i64 ! SpdxError {
    var left = try parse_and(tokens, at, nodes)
    while at < tokens.len() and tokens[at].to_upper() == "OR" {
        at = at + 1
        let right = try parse_and(tokens, at, nodes)
        nodes.push(SpdxNode{ kind: "or", id: "", exception: "", left: left,
            right: right })
        left = nodes.len() - 1
    }
    return left
}

fn parse_and(tokens: [str], inout at: i64,
    inout nodes: [SpdxNode]) -> i64 ! SpdxError {
    var left = try parse_simple(tokens, at, nodes)
    while at < tokens.len() and tokens[at].to_upper() == "AND" {
        at = at + 1
        let right = try parse_simple(tokens, at, nodes)
        nodes.push(SpdxNode{ kind: "and", id: "", exception: "", left: left,
            right: right })
        left = nodes.len() - 1
    }
    return left
}

fn parse_simple(tokens: [str], inout at: i64,
    inout nodes: [SpdxNode]) -> i64 ! SpdxError {
    if at >= tokens.len() {
        fail(Empty())
    }
    if tokens[at] == "(" {
        at = at + 1
        let inner = try parse_or(tokens, at, nodes)
        if at >= tokens.len() or tokens[at] != ")" {
            fail(UnclosedParenthesis())
        }
        at = at + 1
        return inner
    }
    let word = tokens[at]
    let upper = word.to_upper()
    if upper == "AND" or upper == "OR" or upper == "WITH" or word == ")" {
        fail(UnexpectedToken(word))
    }
    at = at + 1
    let id = try canonical_id(word)
    var exception = ""
    if at + 1 < tokens.len() and tokens[at].to_upper() == "WITH" {
        exception = try canonical_exception(tokens[at + 1])
        at = at + 2
    }
    nodes.push(SpdxNode{ kind: "license", id: id, exception: exception,
        left: 0 - 1, right: 0 - 1 })
    return nodes.len() - 1
}

pub fn is_valid(text: str) -> bool {
    match parse(text) {
        Ok(_n) -> {
            return true
        }
        Err(_e) -> {
            return false
        }
    }
}

// ---------------------------------------------------------- rendering

/// The expression in the register's canonical spelling.
///
/// Redundant parentheses go, needed ones stay, operators are uppercased and
/// every identifier is canonical — so two manifests saying the same thing in
/// different words compare equal afterwards.
pub fn normalise(text: str) -> str ! SpdxError {
    let nodes = try parse(text)
    return render(nodes, nodes.len() - 1, "")
}

fn render(nodes: [SpdxNode], at: i64, parent: str) -> str {
    let node = nodes[at]
    if node.kind == "license" {
        if node.exception != "" {
            return node.id + " WITH " + node.exception
        }
        return node.id
    }
    let op = if node.kind == "and" { " AND " } else { " OR " }
    let inner = render(nodes, node.left, node.kind) + op +
    render(nodes, node.right, node.kind)
    // An operand whose operator differs from its parent's needs brackets,
    // because the precedence that made the tree is not visible in the text.
    if parent != "" and parent != node.kind {
        return "(" + inner + ")"
    }
    return inner
}

/// Every license identifier the expression names, sorted, without repeats.
pub fn licenses(text: str) -> [str] ! SpdxError {
    let nodes = try parse(text)
    var seen = map()
    for n in nodes {
        if n.kind == "license" {
            seen.set(n.id, true)
        }
    }
    var out: [str] = []
    for k in seen.keys() {
        out.push(k)
    }
    return out
}

pub fn exceptions(text: str) -> [str] ! SpdxError {
    let nodes = try parse(text)
    var seen = map()
    for n in nodes {
        if n.kind == "license" and n.exception != "" {
            seen.set(n.exception, true)
        }
    }
    var out: [str] = []
    for k in seen.keys() {
        out.push(k)
    }
    return out
}

/// Whether the expression is satisfied by a list of licenses a policy allows.
///
/// This is the question a build asks, and it is a question about the policy
/// rather than about the licenses: `OR` is satisfied when *either* side is,
/// `AND` when both are. A dependency under `Apache-2.0 OR MIT` passes a
/// policy that allows only MIT; the same dependency under `Apache-2.0 AND
/// MIT` does not.
pub fn satisfied_by(text: str, allowed: [str]) -> bool ! SpdxError {
    let nodes = try parse(text)
    var canonical: [str] = []
    for a in allowed {
        let one = canonical_id(a) ?? a
        canonical.push(one)
    }
    return holds(nodes, nodes.len() - 1, canonical)
}

fn holds(nodes: [SpdxNode], at: i64, allowed: [str]) -> bool {
    let node = nodes[at]
    if node.kind == "license" {
        return allowed.contains(node.id)
    }
    let left = holds(nodes, node.left, allowed)
    let right = holds(nodes, node.right, allowed)
    if node.kind == "and" {
        return left and right
    }
    return left or right
}

/// The licenses in the expression that a policy does not allow.
///
/// The list a build should print when it refuses: "satisfied_by said no" is
/// not actionable and "GPL-3.0-only is not on the allow list" is.
pub fn disallowed(text: str, allowed: [str]) -> [str] ! SpdxError {
    var out: [str] = []
    for id in try licenses(text) {
        var found = false
        for a in allowed {
            if (canonical_id(a) ?? a) == id {
                found = true
            }
        }
        if not found {
            out.push(id)
        }
    }
    return out
}

/// How many identifiers the register holds — one licence list, one exception
/// list, and the withdrawn spellings that map into them.
pub fn register_size() -> (i64, i64, i64) {
    return (split_words(license_ids()).len(),
        split_words(exception_ids()).len(),
        split_words(alias_pairs()).len())
}
/// Every SPDX license identifier, in the register's own spelling.
