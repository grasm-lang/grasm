    "Zimbra-1.3 Zimbra-1.4 Zlib any-OSI any-OSI-perl-modules " +
    "bcrypt-Solar-Designer blessing bzip2-1.0.6 check-cvs checkmk " +
    "copyleft-next-0.3.0 copyleft-next-0.3.1 curl cve-tou diffmark " +
    "dtoa dvipdfm eGenix etalab-2.0 fwlw " +
