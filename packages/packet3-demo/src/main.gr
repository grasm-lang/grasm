// Enterprise protocols, asserted against published answers and bytes scapy
// built. scripts/packet_diff.sh holds them to scapy and OpenSSL case for
// case; this is the short version every engine runs.
import md4
import modbus
import snmp
import radius

fn hex(raw: bytes) -> str {
    let digits = "0123456789abcdef"
    var out = ""
    var i = 0
    while i < raw.len() {
        out = out + digits.substr(raw.at(i) / 16, 1) + digits.substr(raw.at(i) % 16, 1)
        i = i + 1
    }
    out
}

fn main() / {io} {
    // RFC 1320's test suite.
    assert_eq(hex(md4.hash("abc".to_bytes())), "a448017aaf21d8525fc10ae87aa6729d")
    assert_eq(hex(md4.hash(bytes_of([]))), "31d6cfe0d16ae931b73c59d7e0c089c0")

    // CRC-16/MODBUS's check value, and a frame that survives a round trip.
    assert_eq(modbus.crc16("123456789".to_bytes()), 19255)
    let frame = modbus.encode_rtu(17, 3, modbus.read_request(107, 3))
    match modbus.decode_rtu(frame) {
        Ok(m) -> assert_eq(m.function, 3)
        Err(_) -> panic("modbus refused its own frame")
    }

    // A GetRequest for sysDescr.0, as scapy writes it.
    let get = SnmpMessage{ version: 1, community: "public".to_bytes(), pdu_type: snmp.get_request(), request_id: 7,
        error_status: 0, error_index: 0, varbinds: [SnmpVarbind{ oid: "1.3.6.1.2.1.1.1.0", tag: 5, value: bytes_of([]) }],
        trap_body: bytes_of([]) }
    match snmp.encode(get) {
        Ok(b) -> assert_eq(hex(b),
            "302602010104067075626c6963a019020107020100020100300e300c06082b060102010101000500")
        Err(_) -> panic("snmp could not encode a GetRequest")
    }

    // A hidden password comes back as it went in.
    let secret = "s3cret".to_bytes()
    let ra = bytes_filled(16, 9)
    let hidden = radius.hide_password("correct horse".to_bytes(), secret, ra)
    assert_eq(hidden.len(), 16)
    assert_eq(radius.reveal_password(hidden, secret, ra).to_str(), "correct horse")
    print("packet3: ok")
}
