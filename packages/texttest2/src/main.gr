import z85
import stringtemplate
import expandvars
import formatfield
import ndiff

fn from_hex(text: str) -> bytes {
    var out: [i64] = []
    var i = 1
    while i + 1 < text.len() {
        out.push(text.substr(i, 2).parse_int_base(16) ?? 0)
        i = i + 2
    }
    return bytes_of(out)
}

fn hex(raw: bytes) -> str {
    let digits = "0123456789abcdef"
    var out = ""
    var i = 0
    while i < raw.len() {
        out = out + digits.substr(raw.at(i) / 16, 1) +
        digits.substr(raw.at(i) % 16, 1)
        i = i + 1
    }
    return out
}

fn text_hex(text: str) -> str {
    return hex(text.to_bytes())
}

/// `name=value` pairs joined by `\u{1}`.
fn pairs(text: str) -> ([str], [str]) {
    var names: [str] = []
    var values: [str] = []
    if text.len() == 0 {
        return (names, values)
    }
    for pair in text.split("\u{1}") {
        let cut = pair.index_of("=") ?? -1
        if cut < 0 {
            continue
        }
        names.push(pair.substr(0, cut))
        values.push(pair.substr(cut + 1, pair.len() - cut - 1))
    }
    return (names, values)
}

fn lines_of(text: str) -> [str] {
    if text.len() == 0 {
        return []
    }
    return text.split("\u{1}")
}

fn describe(pieces: [FormatPiece]) -> str {
    var parts: [str] = []
    for piece in pieces {
        if piece.has_field {
            parts.push(piece.literal + "\u{2}" + piece.name + "\u{2}" +
                piece.spec + "\u{2}" + piece.conversion)
        } else {
            parts.push(piece.literal + "\u{2}-")
        }
    }
    return parts.join("\u{3}")
}

// Every command is `<name> <hex argument> <hex argument>`, three words.
fn main() / {io} {
    var i = 0
    while i + 2 < args().len() {
        let what = args()[i]
        let first = from_hex(args()[i + 1])
        let second = from_hex(args()[i + 2]).to_str()
        if what == "z85enc" {
            print(text_hex(z85.encode(first)))
        } else if what == "z85dec" {
            print(hex(z85.decode(first.to_str()) ?? "?refused?".to_bytes()))
        } else if what == "tsub" {
            let p = pairs(second)
            print(text_hex(stringtemplate.substitute(first.to_str(), p.0,
                p.1) ?? "?refused?"))
        } else if what == "tsafe" {
            let p = pairs(second)
            print(text_hex(stringtemplate.safe_substitute(first.to_str(),
                p.0, p.1)))
        } else if what == "tids" {
            print(text_hex(stringtemplate.identifiers(first.to_str())
                    .join(",")))
        } else if what == "tvalid" {
            print(if stringtemplate.is_valid(first.to_str()) { "yes" } else {
                "no" })
        } else if what == "evars" {
            let p = pairs(second)
            print(text_hex(expandvars.expand_vars(first.to_str(), p.0, p.1)))
        } else if what == "euser" {
            print(text_hex(expandvars.expand_user(first.to_str(), second, [],
                [])))
        } else if what == "ndiff" {
            let a = lines_of(first.to_str())
            let b = lines_of(second)
            print(text_hex(ndiff.compare(a, b).join("\u{1}")))
        } else if what == "nrestore" {
            let delta = lines_of(first.to_str())
            print(text_hex(ndiff.restore(delta, second.parse_int() ?? 1)
                    .join("\u{1}")))
        } else if what == "fparse" {
            match formatfield.parse(first.to_str()) {
                Ok(pieces) -> print(text_hex(describe(pieces)))
                Err(_e) -> print(text_hex("?refused?"))
            }
        } else {
            // `fformat <template> <positional \u{4} named pairs>`
            let halves = second.split("\u{4}")
            var positional: [str] = []
            if halves[0].len() > 0 {
                positional = halves[0].split("\u{1}")
            }
            let p = pairs(if halves.len() > 1 { halves[1] } else { "" })
            print(text_hex(formatfield.format(first.to_str(), positional,
                p.0, p.1) ?? "?refused?"))
        }
        i = i + 3
    }
}
