// Punycode (RFC 3492) — how a Unicode domain becomes DNS-safe ASCII.
//
// `münchen.de` travels as `xn--mnchen-3ya.de`. DNS carries a restricted ASCII
// set, so every internationalised domain is encoded before it is looked up.
//
// This matters for security as much as for reach: `аpple.com` with a Cyrillic
// `а` is a *different domain* that renders identically. `is_confusable` below
// answers the question a browser address bar has to ask.

fn base() -> i64 { return 36 }
fn tmin() -> i64 { return 1 }
fn tmax() -> i64 { return 26 }
fn skew() -> i64 { return 38 }
fn damp() -> i64 { return 700 }
fn initial_bias() -> i64 { return 72 }
fn initial_n() -> i64 { return 128 }

type PunyError = | NotPunycode(text: str)

fn digit_char(d: i64) -> str {
    return "abcdefghijklmnopqrstuvwxyz0123456789".chars()[d]
}

fn char_digit(c: str) -> i64 {
    let a = "abcdefghijklmnopqrstuvwxyz0123456789".chars()
    for i in 0..a.len() {
        if a[i] == c.to_lower() {
            return i
        }
    }
    return 0 - 1
}

fn adapt(delta: i64, count: i64, first: bool) -> i64 {
    var d = if first { delta / damp() } else { delta / 2 }
    d = d + d / count
    var k = 0
    while d > (base() - tmin()) * tmax() / 2 {
        d = d / (base() - tmin())
        k = k + base()
    }
    return k + (base() - tmin() + 1) * d / (d + skew())
}

/// A label to punycode, without the `xn--` prefix.
pub fn encode(label: str) -> str {
    let codes = label.codes()
    var out = ""
    var basic = 0
    for c in codes {
        if c < 128 {
            out = out + bytes_of([c]).to_str()
            basic = basic + 1
        }
    }
    // The delimiter follows the basic code points whether or not any
    // others come after it. A label that is all ASCII still ends in `-`,
    // and a decoder handed one without it reads the whole thing as encoded
    // digits and produces three characters nobody asked for.
    if basic > 0 {
        out = out + "-"
    }
    if basic == codes.len() {
        return out
    }
    var n = initial_n()
    var delta = 0
    var bias = initial_bias()
    var handled = basic
    while handled < codes.len() {
        // The smallest code point not yet handled.
        var m = 1114112
        for c in codes {
            if c >= n and c < m {
                m = c
            }
        }
        delta = delta + (m - n) * (handled + 1)
        n = m
        for c in codes {
            if c < n {
                delta = delta + 1
            }
            if c == n {
                var q = delta
                var k = base()
                var writing = true
                while writing {
                    var t = k - bias
                    if t < tmin() {
                        t = tmin()
                    }
                    if t > tmax() {
                        t = tmax()
                    }
                    if q < t {
                        writing = false
                    } else {
                        out = out + digit_char(t + (q - t) % (base() - t))
                        q = (q - t) / (base() - t)
                        k = k + base()
                    }
                }
                out = out + digit_char(q)
                bias = adapt(delta, handled + 1, handled == basic)
                delta = 0
                handled = handled + 1
            }
        }
        delta = delta + 1
        n = n + 1
    }
    return out
}

/// A whole domain, prefixing each label that needed encoding.
pub fn encode_domain(domain: str) -> str {
    var parts: [str] = []
    for label in domain.split(".") {
        var ascii = true
        for c in label.codes() {
            if c >= 128 {
                ascii = false
            }
        }
        if ascii {
            parts.push(label)
        } else {
            parts.push("xn--" + encode(label))
        }
    }
    return parts.join(".")
}

/// Whether a domain carries any non-ASCII character at all.
pub fn needs_encoding(domain: str) -> bool {
    for c in domain.codes() {
        if c >= 128 {
            return true
        }
    }
    return false
}

/// Whether a label mixes scripts in a way that renders like ASCII.
///
/// `аpple.com` with a Cyrillic `а` looks exactly like `apple.com`. A browser
/// showing the decoded form without this check is showing a lie, which is the
/// entire homograph attack.
pub fn is_confusable(label: str) -> bool {
    var has_latin = false
    var has_other = false
    for c in label.codes() {
        if (c >= 97 and c <= 122) or (c >= 65 and c <= 90) {
            has_latin = true
        } else {
            // Cyrillic and Greek carry the lookalikes that matter.
            if (c >= 1024 and c <= 1279) or (c >= 880 and c <= 1023) {
                has_other = true
            }
        }
    }
    return has_latin and has_other
}

/// Punycode back to a label, without the `xn--` prefix.
///
/// The decoder is the encoder run backwards, and the one thing it must not
/// do is trust its input: a crafted label can name a code point far outside
/// Unicode, or ask for an insertion position past the end of what has been
/// decoded. Both are refused rather than wrapped or clamped.
pub fn decode(text: str) -> str ! PunyError {
    var output: [i64] = []
    var at = 0
    // Everything before the last hyphen is literal ASCII.
    var split = 0 - 1
    var i = 0
    while i < text.len() {
        if text.substr(i, 1) == "-" {
            split = i
        }
        i = i + 1
    }
    if split >= 0 {
        for code in text.substr(0, split).codes() {
            if code >= 128 {
                fail(NotPunycode(text))
            }
            output.push(code)
        }
        at = split + 1
    }
    var n = initial_n()
    var bias = initial_bias()
    var position = 0
    while at < text.len() {
        let previous = position
        var weight = 1
        var k = base()
        var going = true
        while going {
            if at >= text.len() {
                fail(NotPunycode(text))
            }
            let digit = char_digit(text.substr(at, 1))
            at = at + 1
            if digit < 0 {
                fail(NotPunycode(text))
            }
            position = position + digit * weight
            var threshold = tmin()
            if k > bias + tmax() {
                threshold = tmax()
            } else if k > bias {
                threshold = k - bias
            }
            if digit < threshold {
                going = false
            } else {
                weight = weight * (base() - threshold)
                k = k + base()
            }
            if position > 1114111 * 100 {
                fail(NotPunycode(text))
            }
        }
        bias = adapt(position - previous, output.len() + 1, previous == 0)
        n = n + position / (output.len() + 1)
        position = position % (output.len() + 1)
        if n > 1114111 or (n >= 55296 and n <= 57343) {
            fail(NotPunycode(text))
        }
        var rebuilt: [i64] = []
        var j = 0
        while j < output.len() {
            if j == position {
                rebuilt.push(n)
            }
            rebuilt.push(output[j])
            j = j + 1
        }
        if position >= output.len() {
            rebuilt.push(n)
        }
        output = rebuilt
        position = position + 1
    }
    var out = ""
    for code in output {
        out = out + code.to_char()
    }
    return out
}

/// A whole domain from its `xn--` labels back to text.
pub fn decode_domain(domain: str) -> str ! PunyError {
    var parts: [str] = []
    for label in domain.split(".") {
        if label.to_lower().starts_with("xn--") {
            parts.push(try decode(label.substr(4, label.len() - 4)))
        } else {
            parts.push(label)
        }
    }
    return parts.join(".")
}
