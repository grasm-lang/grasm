// The harness scripts/b49_diff.sh drives: each argument pair is an
// operation and a file of cases, one per line; each answer is one line.
import gostrconv
import gonetip
import gourl
import gomime
import pyurlparse
import pyrandom
import pymath
import pystatistics

fn unhex(h: str) -> str {
    if h == "-" {
        return ""
    }
    var out: [i64] = []
    let b = h.to_bytes()
    var i = 0
    while i + 1 < b.len() {
        let hi = b.at(i)
        let lo = b.at(i + 1)
        out.push((if hi >= 97 { hi - 87 } else { hi - 48 }) * 16 + (if lo >= 97 { lo - 87 } else { lo - 48 }))
        i = i + 2
    }
    return bytes_of(out).to_str()
}

fn hex_text(t: str) -> str {
    let digits = "0123456789abcdef"
    let h = t.to_bytes().to_list().map(|x| digits.substr(x.ushr(4), 1) + digits.substr(x.bit_and(15), 1)).join("")
    return if h.len() == 0 { "-" } else { h }
}

fn hex_u64(h: str) -> i64 {
    var v = 0
    for c in h.codes() {
        let d = if c >= 97 { c - 87 } else if c >= 65 { c - 55 } else { c - 48 }
        v = v.shl(4).bit_or(d)
    }
    return v
}

fn err_hex(e: Option[GoNumError]) -> str {
    return match e {
        Some(x) -> hex_text(gostrconv.error_text(x))
        None -> "-"
    }
}

fn num(f: [str], k: i64) -> i64 {
    return f[k].parse_int() ?? 0
}

fn strconv_line(f: [str]) -> str {
    let op = f[0]
    if op == "ff" {
        return hex_text(gostrconv.format_float(hex_u64(f[1]).from_bits(), f[2], num(f, 3), num(f, 4)))
    }
    if op == "pf" {
        let (v, e) = gostrconv.parse_float(unhex(f[1]), num(f, 2))
        return gostrconv.format_uint(v.to_bits(), 16) + " " + err_hex(e)
    }
    if op == "pi" or op == "pu" or op == "ai" {
        let (v, e) = if op == "pi" { gostrconv.parse_int(unhex(f[1]), num(f, 2), num(f, 3)) } else if op == "pu" { gostrconv.parse_uint(unhex(f[1]), num(f, 2), num(f, 3)) } else {
            gostrconv.atoi(unhex(f[1]))
        }
        return (if op == "pu" { gostrconv.format_uint(v, 10) } else { v.to_str() }) + " " + err_hex(e)
    }
    if op == "pb" {
        let (b, e) = gostrconv.parse_bool(unhex(f[1]))
        return gostrconv.format_bool(b) + " " + err_hex(e)
    }
    if op == "fi" {
        return gostrconv.format_int(num(f, 1), num(f, 2))
    }
    let (u, _e) = gostrconv.parse_uint(f[1], 10, 64)
    return gostrconv.format_uint(u, num(f, 2))
}

fn b(x: bool) -> str {
    return if x { "true" } else { "false" }
}

fn addr_desc(a: NetAddr) -> str {
    let digits = "0123456789abcdef"
    let slice = gonetip.as_slice(a).map(|x| digits.substr(x.ushr(4), 1) + digits.substr(x.bit_and(15), 1)).join("")
    let flags = b(gonetip.is_loopback(a)) + " " + b(gonetip.is_multicast(a)) + " " + b(gonetip.is_link_local_unicast(a)) + " " +
    b(gonetip.is_link_local_multicast(a)) + " " + b(gonetip.is_interface_local_multicast(a)) + " " + b(gonetip.is_global_unicast(a)) + " " +
    b(gonetip.is_private(a)) + " " + b(gonetip.is_unspecified(a))
    let fields = [gonetip.to_string(a), gonetip.string_expanded(a), gonetip.zone(a), gonetip.bit_len(a).to_str(),
        b(gonetip.is4(a)) + " " + b(gonetip.is6(a)) + " " + b(gonetip.is4in6(a)), gonetip.to_string(gonetip.unmap(a)), flags,
        gonetip.to_string(gonetip.next(a)), gonetip.to_string(gonetip.prev(a)), slice]
    return fields.map(|t| hex_text(t)).join(",")
}

fn netip_err(e: NetipError) -> str {
    return match e {
        NetipFailed(t) -> "E " + hex_text(t)
    }
}

fn netip_line(f: [str]) -> str {
    let op = f[0]
    if op == "pa" {
        return match gonetip.parse_addr(unhex(f[1])) {
            Ok(a) -> addr_desc(a)
            Err(e) -> netip_err(e)
        }
    }
    if op == "pp" {
        return match gonetip.parse_prefix(unhex(f[1])) {
            Ok(p) -> hex_text(gonetip.prefix_string(p)) + " " + hex_text(gonetip.prefix_string(gonetip.masked(p))) + " " + b(gonetip.is_single_ip(p)) + " " +
            gonetip.prefix_bits(p).to_str() + " " + hex_text(gonetip.to_string(p.addr))
            Err(e) -> netip_err(e)
        }
    }
    if op == "pap" {
        return match gonetip.parse_addr_port(unhex(f[1])) {
            Ok(p) -> hex_text(gonetip.addr_port_string(p)) + " " + p.port.to_str()
            Err(e) -> netip_err(e)
        }
    }
    let a = gonetip.parse_addr(unhex(f[1])) ?? gonetip.invalid()
    let p = gonetip.parse_prefix(unhex(f[1])) ?? NetPrefix{ addr: gonetip.invalid(), bits_plus_one: 0 }
    if op == "cmp" {
        let c = gonetip.compare(a, gonetip.parse_addr(unhex(f[2])) ?? gonetip.invalid())
        return c.to_str() + " " + b(c == 0 - 1)
    }
    if op == "con" {
        return b(gonetip.contains(p, gonetip.parse_addr(unhex(f[2])) ?? gonetip.invalid()))
    }
    if op == "ov" {
        return b(gonetip.overlaps(p, gonetip.parse_prefix(unhex(f[2])) ?? NetPrefix{ addr: gonetip.invalid(), bits_plus_one: 0 }))
    }
    return match gonetip.prefix(a, num(f, 2)) {
        Ok(x) -> hex_text(gonetip.prefix_string(x))
        Err(e) -> netip_err(e)
    }
}

fn hex_raw(b: bytes) -> str {
    let digits = "0123456789abcdef"
    let h = b.to_list().map(|x| digits.substr(x.ushr(4), 1) + digits.substr(x.bit_and(15), 1)).join("")
    return if h.len() == 0 { "-" } else { h }
}

fn raw_arg(h: str) -> bytes {
    var out: [i64] = []
    if h != "-" {
        let b = h.to_bytes()
        var i = 0
        while i + 1 < b.len() {
            let hi = b.at(i)
            let lo = b.at(i + 1)
            out.push((if hi >= 97 { hi - 87 } else { hi - 48 }) * 16 + (if lo >= 97 { lo - 87 } else { lo - 48 }))
            i = i + 2
        }
    }
    return bytes_of(out)
}

fn url_desc(u: GoUrl) -> str {
    let (user, name, pass) = match u.user {
        Some(ui) -> (hex_text(gourl.user_string(ui)), hex_raw(ui.username), hex_raw(ui.password) + b(ui.password_set))
        None -> ("~", "~", "~")
    }
    let fields = [hex_text(u.scheme), hex_raw(u.opaque), user, name, pass, hex_raw(u.host), hex_raw(u.path), hex_raw(u.raw_path),
        b(u.omit_host) + " " + b(u.force_query), hex_raw(u.raw_query), hex_raw(u.fragment), hex_raw(u.raw_fragment), hex_text(gourl.to_string(u)),
        hex_text(gourl.redacted(u)), hex_text(gourl.escaped_path(u)), hex_text(gourl.escaped_fragment(u)), hex_raw(gourl.hostname(u)),
        hex_text(gourl.port(u)), hex_text(gourl.request_uri(u)), b(gourl.is_abs(u)), hex_text(gourl.encode_query(gourl.query(u)))]
    return fields.join(",")
}

fn url_err(e: GoUrlError) -> str {
    return match e {
        UrlFailed(t) -> "E " + hex_text(t)
    }
}

fn parse_either(plain: bool, t: str) -> GoUrl ! GoUrlError {
    if plain {
        return try gourl.parse(t)
    }
    return try gourl.parse_request_uri(t)
}

fn unescape_either(query: bool, t: str) -> bytes ! GoUrlError {
    if query {
        return try gourl.query_unescape(t)
    }
    return try gourl.path_unescape(t)
}

fn url_line(f: [str]) -> str {
    let op = f[0]
    if op == "p" or op == "r" {
        return match parse_either(op == "p", unhex(f[1])) {
            Ok(u) -> url_desc(u)
            Err(e) -> url_err(e)
        }
    }
    if op == "ref" {
        let base = match gourl.parse(unhex(f[1])) {
            Ok(u) -> u
            Err(e) -> return url_err(e)
        }
        return match gourl.parse_reference(base, unhex(f[2])) {
            Ok(u) -> url_desc(u)
            Err(e) -> url_err(e)
        }
    }
    if op == "jp" {
        var elems: [str] = []
        for k in 2..f.len() {
            elems.push(unhex(f[k]))
        }
        return match gourl.parse(unhex(f[1])) {
            Ok(u) -> hex_text(gourl.to_string(gourl.join_path(u, elems)))
            Err(e) -> url_err(e)
        }
    }
    if op == "qe" {
        return hex_text(gourl.query_escape(raw_arg(f[1])))
    }
    if op == "pe" {
        return hex_text(gourl.path_escape(raw_arg(f[1])))
    }
    if op == "qu" or op == "pu" {
        return match unescape_either(op == "qu", unhex(f[1])) {
            Ok(x) -> hex_raw(x)
            Err(e) -> url_err(e)
        }
    }
    let (v, e) = gourl.parse_query(unhex(f[1]))
    return hex_text(gourl.encode_query(v)) + " " + (match e {
        Some(x) -> match x {
            UrlFailed(t) -> hex_text(t)
        }
        None -> "-"
    })
}

fn mime_decode(word: bool, t: str) -> bytes ! str {
    if word {
        return try gomime.decode_word(t)
    }
    return try gomime.decode_header(t)
}

fn mime_line(f: [str]) -> str {
    let op = f[0]
    if op == "pm" {
        let (t, params, err) = gomime.parse_media_type(unhex(f[1]))
        var parts = [hex_text(t)]
        for p in params {
            parts.push(hex_text(p.0) + "=" + hex_raw(p.1))
        }
        return parts.join(",") + " " + (match err {
            Some(e) -> hex_text(e)
            None -> "-"
        })
    }
    if op == "fm" {
        var params: [(str, str)] = []
        var i = 2
        while i + 1 < f.len() {
            params.push((unhex(f[i]), unhex(f[i + 1])))
            i = i + 2
        }
        return hex_text(gomime.format_media_type(unhex(f[1]), params))
    }
    if op == "we" {
        return hex_text(gomime.encode_word(f[1], unhex(f[2]), unhex(f[3])))
    }
    return match mime_decode(op == "wd", unhex(f[1])) {
        Ok(x) -> hex_raw(x)
        Err(e) -> "E " + hex_text(e)
    }
}

fn hex_opt(t: Option[str]) -> str {
    return match t {
        Some(x) -> hex_text(x)
        None -> "~"
    }
}

fn split_desc(scheme: str, netloc: str, rest: [str], url: str) -> str {
    let (user, password) = pyurlparse.userinfo(netloc)
    let port = match pyurlparse.port(netloc) {
        Ok(p) -> match p {
            Some(v) -> v.to_str()
            None -> "~"
        }
        Err(e) -> match e {
            PyValueError(t) -> "E" + hex_text(t)
        }
    }
    let fields = [hex_text(scheme), hex_text(netloc)] + rest.map(|x| hex_text(x)) + [hex_opt(user), hex_opt(password), hex_opt(pyurlparse.hostname(netloc)),
        port, hex_text(url)]
    return fields.join(",")
}

fn py_err(e: PyUrlError) -> str {
    return match e {
        PyValueError(t) -> "E " + hex_text(t)
    }
}

fn pyurl_line(f: [str]) -> str {
    let op = f[0]
    if op == "us" {
        return match pyurlparse.urlsplit(unhex(f[1]), unhex(f[2]), f[3] == "1") {
            Ok(r) -> split_desc(r.scheme, r.netloc, [r.path, r.query, r.fragment], pyurlparse.urlunsplit(r))
            Err(e) -> py_err(e)
        }
    }
    if op == "up" {
        return match pyurlparse.urlparse(unhex(f[1]), unhex(f[2]), f[3] == "1") {
            Ok(r) -> split_desc(r.scheme, r.netloc, [r.path, r.params, r.query, r.fragment], pyurlparse.urlunparse(r))
            Err(e) -> py_err(e)
        }
    }
    if op == "uj" {
        return match pyurlparse.urljoin(unhex(f[1]), unhex(f[2]), f[3] == "1") {
            Ok(t) -> hex_text(t)
            Err(e) -> py_err(e)
        }
    }
    if op == "ud" {
        return match pyurlparse.urldefrag(unhex(f[1])) {
            Ok(p) -> hex_text(p.0) + " " + hex_text(p.1)
            Err(e) -> py_err(e)
        }
    }
    if op == "q" {
        return hex_text(pyurlparse.quote(unhex(f[1]), unhex(f[2])))
    }
    if op == "qp" {
        return hex_text(pyurlparse.quote_plus(unhex(f[1]), unhex(f[2])))
    }
    if op == "qb" {
        return hex_text(pyurlparse.quote_from_bytes(raw_arg(f[1]), unhex(f[2])))
    }
    if op == "uq" {
        return hex_text(pyurlparse.unquote(unhex(f[1])))
    }
    if op == "uqp" {
        return hex_text(pyurlparse.unquote_plus(unhex(f[1])))
    }
    if op == "uqb" {
        return hex_raw(pyurlparse.unquote_to_bytes(unhex(f[1])))
    }
    if op == "qsl" or op == "qs" {
        var o = pyurlparse.default_query_options()
        o.keep_blank_values = f[2] == "1"
        if op == "qsl" {
            o.strict_parsing = f[3] == "1"
            o.max_num_fields = num(f, 4)
            o.separator = unhex(f[5])
            return match pyurlparse.parse_qsl(unhex(f[1]), o) {
                Ok(ps) -> if ps.len() == 0 { "-" } else { ps.map(|p| hex_text(p.0) + "=" + hex_text(p.1)).join(",") }
                Err(e) -> py_err(e)
            }
        }
        return match pyurlparse.parse_qs(unhex(f[1]), o) {
            Ok(ps) -> if ps.len() == 0 { "-" } else { ps.map(|p| hex_text(p.0) + "=" + p.1.map(|v| hex_text(v)).join("+")).join(",") }
            Err(e) -> py_err(e)
        }
    }
    var pairs: [(str, [str])] = []
    for k in 1..f.len() {
        let item = f[k]
        let eq = item.index_of("=") ?? item.len()
        let vs = item.substr(eq + 1, item.len() - eq - 1)
        pairs.push((unhex(item.substr(0, eq)), vs.split("+").map(|v| unhex(v))))
    }
    return hex_text(pyurlparse.urlencode(pairs, ""))
}

fn fbits(h: str) -> f64 {
    return hex_u64(h).from_bits()
}

fn fhex(x: f64) -> str {
    return gostrconv.format_uint(x.to_bits(), 16)
}

fn rnd_err(e: PyRandomError) -> str {
    return match e {
        PyValueError(t) -> "E" + hex_text(t)
        PyIndexError(t) -> "E" + hex_text(t)
    }
}

fn ints_text(xs: [i64]) -> str {
    return xs.map(|x| x.to_str()).join("/")
}

fn rnd_float(inout r: PyRandom, name: str, a: [str]) -> str ! PyRandomError {
    if name == "uniform" {
        return fhex(pyrandom.uniform(r, fbits(a[0]), fbits(a[1])))
    }
    if name == "triangular" {
        return fhex(pyrandom.triangular(r, fbits(a[0]), fbits(a[1]), if a[2] == "~" { None } else { Some(fbits(a[2])) }))
    }
    if name == "normal" {
        return fhex(pyrandom.normalvariate(r, fbits(a[0]), fbits(a[1])))
    }
    if name == "gauss" {
        return fhex(pyrandom.gauss(r, fbits(a[0]), fbits(a[1])))
    }
    if name == "lognormal" {
        return fhex(pyrandom.lognormvariate(r, fbits(a[0]), fbits(a[1])))
    }
    if name == "expo" {
        return fhex(pyrandom.expovariate(r, fbits(a[0])))
    }
    if name == "vonmises" {
        return fhex(pyrandom.vonmisesvariate(r, fbits(a[0]), fbits(a[1])))
    }
    if name == "gamma" {
        return fhex(try pyrandom.gammavariate(r, fbits(a[0]), fbits(a[1])))
    }
    if name == "beta" {
        return fhex(try pyrandom.betavariate(r, fbits(a[0]), fbits(a[1])))
    }
    if name == "pareto" {
        return fhex(pyrandom.paretovariate(r, fbits(a[0])))
    }
    return fhex(pyrandom.weibullvariate(r, fbits(a[0]), fbits(a[1])))
}

fn rnd_call(inout r: PyRandom, c: str) -> str ! PyRandomError {
    let parts = c.split(",")
    let name = parts[0]
    let a = parts.slice(1, parts.len())
    if name == "random" {
        return fhex(pyrandom.random(r))
    }
    if name == "bits" {
        return pyrandom.getrandbits(r, num(a, 0)).to_str()
    }
    if name == "range" {
        return (try pyrandom.randrange(r, num(a, 0), num(a, 1), num(a, 2))).to_str()
    }
    if name == "range1" {
        return (try pyrandom.randrange_below(r, num(a, 0))).to_str()
    }
    if name == "int" {
        return (try pyrandom.randint(r, num(a, 0), num(a, 1))).to_str()
    }
    if name == "choice" {
        return (try pyrandom.choice_index(r, num(a, 0))).to_str()
    }
    if name == "shuffle" {
        var xs: [i64] = []
        for i in 0..num(a, 0) {
            xs.push(i)
        }
        return ints_text(pyrandom.shuffle(r, xs))
    }
    if name == "sample" {
        return ints_text(try pyrandom.sample_indices(r, num(a, 0), num(a, 1)))
    }
    if name == "choices" {
        return ints_text(pyrandom.choices_uniform(r, num(a, 0), num(a, 1)))
    }
    if name == "choicesw" or name == "choicescw" {
        let w = if a[0].len() == 0 { [] } else { a[0].split("/").map(|x| fbits(x)) }
        return ints_text(try pyrandom.choices_cumulative(r, if name == "choicesw" { pyrandom.accumulate(w) } else { w }, num(a, 1)))
    }
    if name == "bytes" {
        return hex_raw(pyrandom.randbytes(r, num(a, 0)))
    }
    if name == "binomial" {
        return (try pyrandom.binomialvariate(r, num(a, 0), fbits(a[1]))).to_str()
    }
    return try rnd_float(r, name, a)
}

fn pyrandom_line(f: [str]) -> str {
    let seed = f[0]
    let kind = seed.substr(0, 1)
    let val = seed.substr(2, seed.len() - 2)
    var r = if kind == "i" { pyrandom.seeded(val.parse_int() ?? 0) } else if kind == "s" { pyrandom.seeded_text(unhex(val)) } else {
        pyrandom.seeded_bytes(raw_arg(val))
    }
    var out: [str] = []
    for k in 1..f.len() {
        out.push(match rnd_call(r, f[k]) {
            Ok(t) -> t
            Err(e) -> rnd_err(e)
        })
    }
    return out.join(" ")
}

fn flist(t: str) -> [f64] {
    return if t.len() == 0 { [] } else { t.split("/").map(|x| fbits(x)) }
}

fn math_err(e: PyMathError) -> str {
    return match e {
        PyMathValueError(t) -> "V" + hex_text(t)
        PyMathOverflowError(t) -> "O" + hex_text(t)
    }
}

fn math_float(op: str, a: [str]) -> f64 ! PyMathError {
    if op == "fsum" {
        return try pymath.fsum(flist(a[0]))
    }
    if op == "sumprod" {
        return try pymath.sumprod(flist(a[0]), flist(a[1]))
    }
    if op == "prod" {
        return pymath.prod(flist(a[0]))
    }
    if op == "fma" {
        return try pymath.fma(fbits(a[0]), fbits(a[1]), fbits(a[2]))
    }
    if op == "lgamma" {
        return try pymath.lgamma(fbits(a[0]))
    }
    if op == "gamma" {
        return try pymath.gamma(fbits(a[0]))
    }
    if op == "ulp" {
        return pymath.ulp(fbits(a[0]))
    }
    if op == "hypot" {
        return pymath.hypot(flist(a[0]))
    }
    if op == "dist" {
        return try pymath.dist(flist(a[0]), flist(a[1]))
    }
    if op == "remainder" {
        return try pymath.remainder(fbits(a[0]), fbits(a[1]))
    }
    return try pymath.nextafter(fbits(a[0]), fbits(a[1]), if a[2] == "~" { None } else { Some(num(a, 2)) })
}

fn math_int(op: str, a: [str]) -> str ! PyMathError {
    if op == "isqrt" {
        return (try pymath.isqrt(num(a, 0))).to_str()
    }
    if op == "comb" {
        return try pymath.comb(num(a, 0), num(a, 1))
    }
    if op == "perm" {
        return try pymath.perm(num(a, 0), if a[1] == "~" { None } else { Some(num(a, 1)) })
    }
    if op == "factorial" {
        return try pymath.factorial(num(a, 0))
    }
    let ints = if a[0].len() == 0 { [] } else { a[0].split("/").map(|x| x.parse_int() ?? 0) }
    return if op == "gcd" { pymath.gcd(ints).to_str() } else { pymath.lcm(ints) }
}

fn pymath_line(f: [str]) -> str {
    let op = f[0]
    let a = f.slice(1, f.len())
    if ["isqrt", "comb", "perm", "factorial", "gcd", "lcm"].contains(op) {
        return match math_int(op, a) {
            Ok(t) -> t
            Err(e) -> math_err(e)
        }
    }
    return match math_float(op, a) {
        Ok(x) -> fhex(x)
        Err(e) -> math_err(e)
    }
}

fn stat_err(e: PyStatError) -> str {
    return match e {
        StatisticsError(t) -> "S" + hex_text(t)
        StatValueError(t) -> "V" + hex_text(t)
        StatAttributeError(t) -> "A" + hex_text(t)
    }
}

fn opt_float(t: str) -> Option[f64] {
    return if t == "~" { None } else { Some(fbits(t)) }
}

fn floats_hex(xs: [f64]) -> str {
    return if xs.len() == 0 { "-" } else { xs.map(|x| fhex(x)).join("/") }
}

fn stat_one(op: str, a: [str]) -> f64 ! PyStatError {
    let d = flist(a[0])
    if op == "mean" {
        return try pystatistics.mean(d)
    }
    if op == "fmean" {
        return try pystatistics.fmean(d)
    }
    if op == "geometric_mean" {
        return try pystatistics.geometric_mean(d)
    }
    if op == "median" {
        return try pystatistics.median(d)
    }
    if op == "median_low" {
        return try pystatistics.median_low(d)
    }
    if op == "median_high" {
        return try pystatistics.median_high(d)
    }
    if op == "mode" {
        return try pystatistics.mode(d)
    }
    if op == "fmeanw" {
        return try pystatistics.fmean_weighted(d, flist(a[1]))
    }
    if op == "harmonic" {
        return try pystatistics.harmonic_mean(d, if a[1] == "~" { None } else { Some(flist(a[1])) })
    }
    if op == "grouped" {
        return try pystatistics.median_grouped(d, fbits(a[1]))
    }
    if op == "variance" {
        return try pystatistics.variance(d, opt_float(a[1]))
    }
    if op == "pvariance" {
        return try pystatistics.pvariance(d, opt_float(a[1]))
    }
    if op == "stdev" {
        return try pystatistics.stdev(d, opt_float(a[1]))
    }
    if op == "pstdev" {
        return try pystatistics.pstdev(d, opt_float(a[1]))
    }
    if op == "covariance" {
        return try pystatistics.covariance(d, flist(a[1]))
    }
    return try pystatistics.correlation(d, flist(a[1]), a[2])
}

fn stat_many(op: str, a: [str]) -> [f64] ! PyStatError {
    if op == "multimode" {
        return pystatistics.multimode(flist(a[0]))
    }
    if op == "quantiles" {
        return try pystatistics.quantiles(flist(a[0]), num(a, 1), a[2])
    }
    if op == "regression" {
        let (s, i) = try pystatistics.linear_regression(flist(a[0]), flist(a[1]), a[2] == "1")
        return [s, i]
    }
    if op == "samples" {
        let d = try pystatistics.from_samples(flist(a[0]))
        return [d.mu, d.sigma]
    }
    let nd = try pystatistics.normal(fbits(a[0]), fbits(a[1]))
    if op == "pdf" {
        return [try pystatistics.pdf(nd, fbits(a[2]))]
    }
    if op == "zscore" {
        return [try pystatistics.zscore(nd, fbits(a[2]))]
    }
    if op == "invcdf" {
        return [try pystatistics.inv_cdf(nd, fbits(a[2]))]
    }
    return try pystatistics.normal_quantiles(nd, num(a, 2))
}

fn pystat_line(f: [str]) -> str {
    let op = f[0]
    let a = f.slice(1, f.len())
    if ["multimode", "quantiles", "regression", "samples", "pdf", "zscore", "invcdf", "nquantiles"].contains(op) {
        return match stat_many(op, a) {
            Ok(xs) -> floats_hex(xs)
            Err(e) -> stat_err(e)
        }
    }
    return match stat_one(op, a) {
        Ok(x) -> fhex(x)
        Err(e) -> stat_err(e)
    }
}

fn main() / {io} {
    let argv = args()
    var i = 0
    while i + 1 < argv.len() {
        let op = argv[i]
        let text = match read_bytes(argv[i + 1]) {
            Ok(d) -> d.to_str()
            Err(_e) -> ""
        }
        for l in text.split("\n").filter(|l| l.len() > 0) {
            if op == "netip" {
                print(netip_line(l.split(" ")))
            }
            if op == "url" {
                print(url_line(l.split(" ")))
            }
            if op == "mime" {
                print(mime_line(l.split(" ")))
            }
            if op == "pyurl" {
                print(pyurl_line(l.split(" ")))
            }
            if op == "pyrandom" {
                print(pyrandom_line(l.split(" ")))
            }
            if op == "pymath" {
                print(pymath_line(l.split(" ")))
            }
            if op == "pystat" {
                print(pystat_line(l.split(" ")))
            }
            if op == "strconv" {
                print(strconv_line(l.split(" ")))
            }
        }
        i = i + 2
    }
}
