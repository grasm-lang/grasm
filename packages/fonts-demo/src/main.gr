// Five font packages, against the tables of a real font and against a font
// this program builds.
//
// The tables below were taken out of Andale Mono with `fontTools`, and every
// number asserted about them is one fontTools reports for the same table.
import sfnt
import cmap
import glyf
import fontmetrics
import woff

fn say(inout f: i64, name: str, held: bool) / {io} {
    if held {
        print("  ok    {name}")
    } else {
        print("  FAIL  {name}")
        f = f + 1
    }
}

fn unhex(text: str) -> bytes {
    var out: [i64] = []
    let digits = "0123456789abcdef"
    var i = 0
    while i + 2 <= text.len() {
        let hi = digits.index_of(text.substr(i, 1)) ?? 0
        let lo = digits.index_of(text.substr(i + 1, 1)) ?? 0
        out.push(hi * 16 + lo)
        i = i + 2
    }
    return bytes_of(out)
}

// ------------------------------------------------------------------ sfnt

fn assembled() -> bytes {
    let tags = ["head", "hhea", "maxp", "OS/2", "cmap"]
    let contents = [table_head(), table_hhea(), table_maxp(), table_os_2(),
        table_cmap()]
    let built: bytes ! SfntError = sfnt.build(sfnt.truetype_version(), tags,
        contents)
    let font = built ?? bytes_of([])
    let sealed: bytes ! SfntError = sfnt.seal(font)
    return sealed ?? font
}

fn check_sfnt(inout f: i64) / {io} {
    print("-- sfnt: a directory of tables, and a checksum with a hole in it")
    let data = assembled()
    let parsed: SfntFont ! SfntError = sfnt.parse(data)
    let font = parsed ?? SfntFont{ version: 0, tables: [],
        data: bytes_of([]) }
    say(f, "a font assembled here parses back with its five tables",
        font.tables.len() == 5 and font.version == sfnt.truetype_version())
    say(f, "the directory is sorted by tag, as the format requires",
        sfnt.table_tags(font).join(",") == "OS/2,cmap,head,hhea,maxp")
    say(f, "every table's bytes come back exactly",
        (sfnt.table_data(font, "head") ?? bytes_of([])).len() ==
        table_head().len() and
        (sfnt.table_data(font, "cmap") ?? bytes_of([])).to_list() ==
        table_cmap().to_list())
    say(f, "and every checksum in the directory is the one its bytes give",
        sfnt.bad_checksums(font).len() == 0)
    // The whole-file checksum is computed with its own field zeroed, which
    // is the one rule nobody implements right the first time.
    say(f, "the file checksum in `head` is the one the file gives",
        sfnt.is_sealed(font))
    say(f, "a table nobody added is an error, not an empty one",
        refuses_missing(font))
    say(f, "the required tables are named, and the missing ones listed",
        sfnt.required_tables().len() == 6 and
        sfnt.missing_required(font).join(",") == "hmtx,name")
    say(f, "quadratic and cubic outlines are told apart by their tables",
        not sfnt.has_truetype_outlines(font) and
        not sfnt.has_postscript_outlines(font))
    say(f, "a tag that is not four characters is refused",
        refuses_tag())
    say(f, "and a file too short to hold a directory is too",
        refuses_short())
}

fn refuses_missing(font: SfntFont) -> bool {
    match sfnt.table_data(font, "glyf") {
        Ok(_d) -> {
            return false
        }
        Err(_e) -> {
            return true
        }
    }
}

fn refuses_tag() -> bool {
    match sfnt.build(sfnt.truetype_version(), ["hd"], [bytes_of([1])]) {
        Ok(_d) -> {
            return false
        }
        Err(_e) -> {
            return true
        }
    }
}

fn refuses_short() -> bool {
    match sfnt.parse(bytes_of([0, 1, 0, 0])) {
        Ok(_d) -> {
            return false
        }
        Err(_e) -> {
            return true
        }
    }
}

// ------------------------------------------------------------------ cmap

fn check_cmap(inout f: i64) / {io} {
    print("-- cmap: prefer the widest subtable, or lose everything above BMP")
    let data = table_cmap()
    let subs = cmap.subtables(data) ?? []
    say(f, "the font has the usual pair: MacRoman and Windows Unicode",
        subs.len() == 2 and subs[0].platform == 1 and subs[0].format == 0 and
        subs[1].platform == 3 and subs[1].format == 4)
    let best: CmapSubtable ! CmapError = cmap.best_subtable(data)
    let b = best ?? subs[0]
    say(f, "and the format 4 one is chosen, not the first listed",
        b.format == 4 and b.platform == 3)
    // Every glyph number here is `fontTools`' for the same character.
    say(f, "letters map to the glyphs fontTools reports",
        glyph(data, b, 65) == 36 and glyph(data, b, 90) == 61 and
        glyph(data, b, 97) == 68 and glyph(data, b, 122) == 93)
    say(f, "and so do digits, punctuation and a space",
        glyph(data, b, 48) == 19 and glyph(data, b, 32) == 3 and
        glyph(data, b, 126) == 97)
    say(f, "an accented letter and a ligature are glyphs like any other",
        glyph(data, b, 233) == 112 and glyph(data, b, 64257) == 192)
    say(f, "a character the font has not got is glyph zero, not an error",
        glyph(data, b, 19968) == 0)
    say(f, "the missing characters of a string can be listed before drawing",
        cmap.missing_characters(data, "hello").len() == 0 and
        cmap.missing_characters(data, "\u{4e00}\u{4e01}").len() == 2)
    say(f, "the font maps six hundred and fifty-four characters",
        (cmap.all_mappings(data, b) ?? []).len() == 654)

    // A format 4 subtable built here, which fontTools reads unchanged.
    var mappings: [(i64, i64)] = []
    for pair in [[65, 1], [66, 2], [67, 3], [200, 10], [1000, 50],
        [1001, 51]] {
        mappings.push((pair[0], pair[1]))
    }
    let built: bytes ! CmapError = cmap.build_format4(mappings)
    let table = cmap.build_table(built ?? bytes_of([]))
    say(f, "a table built here maps what went into it",
        lookup(table, 65) == 1 and lookup(table, 67) == 3 and
        lookup(table, 200) == 10 and lookup(table, 1001) == 51)
    say(f, "and nothing else",
        lookup(table, 199) == 0 and lookup(table, 1002) == 0)
    say(f, "unsorted mappings are refused rather than encoded wrongly",
        refuses_unsorted())
}

fn glyph(data: bytes, subtable: CmapSubtable, codepoint: i64) -> i64 {
    let g: i64 ! CmapError = cmap.glyph_for(data, subtable, codepoint)
    return g ?? (0 - 1)
}

fn lookup(data: bytes, codepoint: i64) -> i64 {
    let g: i64 ! CmapError = cmap.glyph_of(data, codepoint)
    return g ?? (0 - 1)
}

fn refuses_unsorted() -> bool {
    match cmap.build_format4([(66, 1), (65, 2)]) {
        Ok(_t) -> {
            return false
        }
        Err(_e) -> {
            return true
        }
    }
}

// ----------------------------------------------------------- fontmetrics

fn head_info() -> FontHead {
    let h: FontHead ! MetricsError = fontmetrics.parse_head(table_head())
    return h ?? FontHead{ units_per_em: 0, x_min: 0, y_min: 0, x_max: 0,
        y_max: 0, long_loca: false }
}

fn check_fontmetrics(inout f: i64) / {io} {
    print("-- fontmetrics: three line heights, and no correct one")
    let head = head_info()
    // fontTools reports exactly these for Andale Mono.
    say(f, "the design grid is 2048 units to the em",
        head.units_per_em == 2048 and head.long_loca == false)
    say(f, "and the font's bounding box is the one in the file",
        head.x_min == 0 and head.y_min == 0 - 447 and
        head.x_max == 1229 and head.y_max == 2038)
    let hhea: LineMetrics ! MetricsError =
    fontmetrics.parse_hhea(table_hhea())
    let line = hhea ?? LineMetrics{ ascender: 0, descender: 0, line_gap: 0 }
    say(f, "hhea gives one set of vertical metrics",
        line.ascender == 1858 and line.descender == 0 - 446 and
        line.line_gap == 0)
    let typo: LineMetrics ! MetricsError =
    fontmetrics.parse_typo_metrics(table_os_2())
    let t = typo ?? line
    say(f, "OS/2 gives a different one",
        t.ascender == 1436 and t.descender == 0 - 412 and
        t.line_gap == 343)
    let all_heights: (i64, i64, i64) ! MetricsError =
    fontmetrics.all_line_heights(table_hhea(), table_os_2())
    let heights = all_heights ?? (0, 0, 0)
    say(f, "so the same font has three line heights, and they differ",
        heights.0 == 2304 and heights.1 == 2191 and heights.2 == 2304)
    // Bit 7 of fsSelection is clear in this font, so hhea wins.
    say(f, "which one a renderer uses is a flag in OS/2",
        not fontmetrics.uses_typo_metrics(table_os_2()) and
        (fontmetrics.preferred_metrics(table_hhea(), table_os_2())
            ?? t).ascender == 1858)
    say(f, "the glyph count is in maxp",
        fontmetrics.glyph_count(table_maxp()) == 659)
    let count = fontmetrics.number_of_h_metrics(table_hhea())
    say(f, "every glyph has its own advance in this font",
        count == 659)
    say(f, "and the advances are the ones fontTools reports",
        advance(0) == 1229 and advance(36) == 1229 and
        bearing(36) == 57 and bearing(68) == 215)
    say(f, "a monospaced font is one measured to be, not one that says so",
        fontmetrics.is_monospaced(table_hmtx_head(), count, 100))
    say(f, "design units become points by dividing by the em",
        fontmetrics.scale_to(1229, 2048, 12.0) > 7.2 and
        fontmetrics.scale_to(1229, 2048, 12.0) < 7.21)
    say(f, "a glyph past the table is an error, not a silent zero",
        refuses_glyph(count))
}

fn advance(glyph: i64) -> i64 {
    let a: i64 ! MetricsError = fontmetrics.advance_width(
        table_hmtx_head(), 659, glyph)
    return a ?? (0 - 1)
}

fn bearing(glyph: i64) -> i64 {
    let m: (i64, i64) ! MetricsError = fontmetrics.glyph_metrics(
        table_hmtx_head(), 659, glyph)
    return (m ?? (0 - 1, 0 - 1)).1
}

fn refuses_glyph(count: i64) -> bool {
    match fontmetrics.glyph_metrics(table_hmtx_head(), count, 5000) {
        Ok(_m) -> {
            return false
        }
        Err(_e) -> {
            return true
        }
    }
}

// ------------------------------------------------------------------ glyf

fn letter_a() -> Glyph {
    let g: Glyph ! GlyfError = glyf.parse_glyph(glyph_a_outline(),
        glyph_a_loca(), false, 0)
    return g ?? glyf.empty_glyph()
}

fn check_glyf(inout f: i64) / {io} {
    print("-- glyf: the on-curve point that is not in the file")
    let a = letter_a()
    // fontTools reports two contours, eleven points, all on the curve.
    say(f, "the letter A has two contours and eleven points",
        glyf.contour_count(a) == 2 and glyf.point_count(a) == 11 and
        glyf.on_curve_count(a) == 11)
    say(f, "its contours end where fontTools says",
        a.contour_ends.len() == 2 and a.contour_ends[0] == 7 and
        a.contour_ends[1] == 10)
    say(f, "and its bounding box is the one in the glyph header",
        a.x_min == 57 and a.y_min == 0 and a.x_max == 1176 and
        a.y_max == 1411)
    say(f, "which agrees with the points it actually has",
        glyf.bounds_agree(a))
    say(f, "the first points are the deltas unpacked in order",
        a.points[0].x == 1176 and a.points[0].y == 0 and
        a.points[2].x == 848 and a.points[2].y == 494)
    say(f, "a straight-sided letter needs no implied points",
        glyf.contour_with_implied(a, 0).len() == 8)
    say(f, "it is not a composite, so it refers to no other glyph",
        not glyf.is_composite(a) and a.components.len() == 0)
    say(f, "an empty glyph is a space and not an error",
        glyf.is_empty(unhex("00000000"), false, 0))
    say(f, "a glyph past the end of loca is refused",
        refuses_range())
    // Two off-curve points in a row imply one between them, which no file
    // stores and every renderer must insert.
    let curved = curved_glyph()
    // Four off-curve points in a ring imply four more, one in each gap.
    say(f, "two off-curve points in a row imply one between them",
        glyf.point_count(curved) == 4 and
        glyf.contour_with_implied(curved, 0).len() == 8)
}

/// A square with every corner off the curve, which is a circle-ish shape and
/// the smallest thing that exercises the implied point.
fn curved_glyph() -> Glyph {
    return Glyph{ contour_count: 1, x_min: 0, y_min: 0, x_max: 100,
        y_max: 100, contour_ends: [3],
        points: [
            GlyphPoint{ x: 0, y: 0, on_curve: false },
            GlyphPoint{ x: 100, y: 0, on_curve: false },
            GlyphPoint{ x: 100, y: 100, on_curve: false },
            GlyphPoint{ x: 0, y: 100, on_curve: false },
        ],
        components: [] }
}

fn refuses_range() -> bool {
    match glyf.parse_glyph(glyph_a_outline(), glyph_a_loca(), false, 5) {
        Ok(_g) -> {
            return false
        }
        Err(_e) -> {
            return true
        }
    }
}

// ------------------------------------------------------------------ woff

fn check_woff(inout f: i64) / {io} {
    print("-- woff: the same font, compressed a table at a time")
    let font = assembled()
    let wrapped: bytes ! WoffError = woff.from_sfnt(font)
    let file = wrapped ?? bytes_of([])
    say(f, "a font wraps into a WOFF that says what it is",
        woff.describe(file) == "WOFF 1.0" and
        woff.describe(font) == "TrueType")
    let parsed: WoffFont ! WoffError = woff.parse(file)
    let w = parsed ?? WoffFont{ flavor: 0, total_sfnt_size: 0, major: 0,
        minor: 0, entries: [], has_metadata: false, metadata_length: 0 }
    say(f, "the wrapper records the flavour and the original size",
        w.flavor == sfnt.truetype_version() and
        w.total_sfnt_size == font.len() and w.entries.len() == 5)
    say(f, "a table stored rather than deflated is not compressed",
        not woff.is_compressed(w.entries[0]))
    say(f, "and its bytes come back unchanged",
        (woff.table_data(file, woff.entry_named(w, "cmap")
            ?? w.entries[0]) ?? bytes_of([])).to_list() ==
        table_cmap().to_list())
    let back: bytes ! WoffError = woff.to_sfnt(file)
    let rebuilt = back ?? bytes_of([])
    say(f, "unwrapping gives a font of the same size with the same tables",
        rebuilt.len() == font.len() and
        (sfnt.parse(rebuilt) ?? sfnt.parse(font)
            ?? SfntFont{ version: 0, tables: [], data: bytes_of([]) })
            .tables.len() == 5)
    say(f, "whose checksums are all correct",
        sfnt.bad_checksums(sfnt.parse(rebuilt) ??
            SfntFont{ version: 0, tables: [], data: bytes_of([]) })
            .len() == 0)
    say(f, "WOFF2 is a different format and is refused rather than guessed",
        refuses_woff2() and
        woff.describe(unhex("774f4632")) ==
        "WOFF 2.0, which this does not read")
    say(f, "a file that is not a font at all is named as such",
        woff.describe(unhex("deadbeef")) == "not a font")
    say(f, "and the compression ratio is measurable",
        woff.compression_ratio(w, file.len()) > 1.0)
}

fn refuses_woff2() -> bool {
    match woff.parse(unhex("774f4632000000000000002c0000000000000000")) {
        Ok(_w) -> {
            return false
        }
        Err(_e) -> {
            return true
        }
    }
}

fn main() / {io} {
    var f = 0
    check_sfnt(f)
    check_cmap(f)
    check_fontmetrics(f)
    check_glyf(f)
    check_woff(f)
    if f == 0 {
        print("fonts: every claim held")
    } else {
        print("fonts: {f} claims failed")
    }
}

// ------------------------------------------------------- the font tables
/// The `head` table of Andale Mono, exactly as the file has it.
fn table_head() -> bytes {
    let hex = "00010000000200001a3694785f0f3cf5000b080000000000af2e0c8d00000000" +
    "c1ed5fef0000fe4104cd07f600000008000100000000"
    return unhex(hex)
}

/// The `hhea` table of Andale Mono, exactly as the file has it.
fn table_hhea() -> bytes {
    let hex = "000100000742fe42000004cd0000000004cd0001000000000000000000000000" +
    "00000293"
    return unhex(hex)
}

/// The `maxp` table of Andale Mono, exactly as the file has it.
fn table_maxp() -> bytes {
    let hex = "000100000293012200490051000500020010001b003b0000020f06b700030002"
    return unhex(hex)
}

/// The `OS/2` table of Andale Mono, exactly as the file has it.
fn table_os_2() -> bytes {
    let hex = "000104cd019000050008059a053300000090059a0533000001f70066026e0000" +
    "020b0509000000000004000002870000000000000000000000004d4f4e4f0040" +
    "0020fb02059cfe640157074201be6000009fdfd70000"
    return unhex(hex)
}

/// Andale Mono's `cmap`: a MacRoman format 0 subtable and a Windows
/// Unicode format 4 one, which is the usual pair.
