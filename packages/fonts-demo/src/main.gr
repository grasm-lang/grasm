/// The first hundred and twenty advance widths of Andale Mono's `hmtx`.
///
/// Truncated: the demo only asks about glyphs inside it, and the whole
/// table is five kilobytes of the same number.
fn table_hmtx_head() -> bytes {
    let hex = "04cd00d80000000004cd000004cd000004cd01df04cd016404cd005804cd00e3" +
    "04cd002f04cd005004cd021b04cd01b804cd010e04cd010404cd008d04cd01ee" +
    "04cd013304cd01e504cd00d704cd009304cd011404cd00cd04cd00c704cd0079" +
    "04cd00e104cd00bc04cd00c704cd00a404cd00b204cd01e704cd01ee04cd00e3" +
    "04cd008d04cd010a04cd00f004cd006204cd003904cd00d104cd007f04cd00d1" +
    "04cd010004cd010004cd007f04cd00d104cd011f04cd009c04cd00d104cd0100" +
    "04cd00ac04cd00bc04cd007f04cd010004cd007f04cd00d104cd00e304cd0062" +
    "04cd00d104cd003504cd002b04cd005604cd005e04cd00b604cd020a04cd00d5" +
    "04cd011704cd006f04cd000004cd015c04cd00d704cd00d704cd00b004cd0091" +
    "04cd00aa04cd00df04cd00b204cd00d704cd012704cd00d704cd00d704cd00f4" +
    "04cd008104cd00d704cd009104cd00d704cd009104cd014604cd00e904cd00f0" +
    "04cd00d504cd008704cd007304cd009104cd007504cd00cb04cd016604cd0214" +
