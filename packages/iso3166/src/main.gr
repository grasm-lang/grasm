let NAMES: Map[str, str] = load(packed_names())
let ZONES: Map[str, str] = load(packed_zones())

fn load(packed: str) -> Map[str, str] {
    var out: Map[str, str] = {}
    for entry in packed.split("|") {
        if entry.len() == 0 {
            continue
        }
        let cut = entry.index_of("=") ?? -1
        if cut < 0 {
            continue
        }
        out.set(entry.substr(0, cut),
            entry.substr(cut + 1, entry.len() - cut - 1))
    }
    return out
}

/// The English name for an alpha-2 code, upper or lower case.
pub fn name_of(code: str) -> Option[str] {
    return NAMES.get(code.to_upper())
}

/// Whether `code` is an assigned alpha-2 country code.
pub fn is_country(code: str) -> bool {
    return NAMES.has(code.to_upper())
}

/// Every assigned code, in order.
pub fn codes() -> [str] {
    var out: [str] = []
    for key in NAMES.keys() {
        out.push(key)
    }
    out.sort()
    return out
}

/// How many there are, which is a number worth being able to assert.
pub fn count() -> i64 {
    return NAMES.len()
}

/// The time zone names a country uses, in the order `zone.tab` lists them —
/// which puts the most populous first.
pub fn zones_of(code: str) -> [str] {
    match ZONES.get(code.to_upper()) {
        Some(list) -> return list.split(",")
        None -> return []
    }
}

/// The one zone a country uses, when it uses exactly one.
///
/// Most countries do. The ones that do not — the United States, Russia,
/// Australia and a dozen others — cannot be given a single answer, and a
/// caller that wants one has to ask a person which.
pub fn single_zone(code: str) -> Option[str] {
    let list = zones_of(code)
    if list.len() == 1 {
        return Some(list[0])
    }
    return None
}

/// The country a zone belongs to, which is the lookup a timestamp needs.
pub fn country_of_zone(zone: str) -> Option[str] {
    for entry in ZONES.entries() {
        for name in entry.1.split(",") {
            if name == zone {
                return Some(entry.0)
            }
        }
    }
    return None
}

/// The codes with more than one zone, which is the list a user interface has
/// to ask about.
pub fn multi_zone_codes() -> [str] {
    var out: [str] = []
    for code in codes() {
        if zones_of(code).len() > 1 {
            out.push(code)
        }
    }
    return out
}
