// Rasterise a character from a font and print the coverage as text, so the
// shape can be checked by reading it.
import pcfont
import sfnt
import cmap
import glyf
import pcframe

fn table(data: bytes, font: SfntFont, tag: str) -> bytes ! SfntError {
    let t = try sfnt.table_named(font, tag)
    return data.slice(t.offset, t.offset + t.length)
}

fn main() -> () ! (SfntError | CmapError | GlyfError | MetricsError) / {io} {
    let a = args()
    if (a.get(3) ?? "") == "text" {
        try show_text(a.get(0) ?? "", a.get(1) ?? "A", (a.get(2) ?? "16").parse_int() ?? 16)
        return
    }
    let path = a.get(0) ?? ""
    let ch = (a.get(1) ?? "A").chars().get(0) ?? "A"
    let size = (a.get(2) ?? "16").parse_int() ?? 16
    let data = read_bytes(path) ?? bytes_of([])
    let font = try sfnt.parse(data)
    let head = try table(data, font, "head")
    let upm = head.at(18) * 256 + head.at(19)
    let long_loca = head.at(51) == 1
    let gid = try cmap.glyph_of(try table(data, font, "cmap"), ch.codes().get(0) ?? 65)
    let g = try glyf.parse_glyph(
        try table(data, font, "glyf"),
        try table(data, font, "loca"),
        long_loca,
        gid,
    )
    let r = pcfont.raster_glyph(g, upm, size)
    print("upm {upm} gid {gid} size {pcfont.width_of(r)}x{pcfont.height_of(r)} inked {pcfont.inked(r)}")
    var y = 0
    while y < pcfont.height_of(r) {
        var line = ""
        var x = 0
        while x < pcfont.width_of(r) {
            let v = pcfont.at(r, x, y)
            line = line + if v > 200 { "#" } else if v > 100 { "+" } else if v > 20 { "." } else { " " }
            x = x + 1
        }
        print("|{line}|")
        y = y + 1
    }
}

/// Draw a string into a surface and print it, so text layout can be read.
pub fn show_text(path: str, text: str, size: i64) -> () ! (SfntError | MetricsError) / {io} {
    let data = read_bytes(path) ?? bytes_of([])
    let f = try pcfont.load(data)
    let w = pcfont.text_width(f, text, size) + 4
    let h = pcfont.line_height(f, size) + 4
    var s = pcframe.filled(w, h, 0, 0, 0)
    let end = pcfont.draw_text(s, f, text, 2, 2 + pcfont.baseline(f, size), size, 255, 255, 255)
    print("{w}x{h} advance {end - 2} line {pcfont.line_height(f, size)}")
    var y = 0
    while y < h {
        var line = ""
        var x = 0
        while x < w {
            let p = pcframe.pixel(s, x, y)
            let v = p.get(0).unwrap_or(0)
            line = line + if v > 200 { "#" } else if v > 100 { "+" } else if v > 20 { "." } else { " " }
            x = x + 1
        }
        print("|{line}|")
        y = y + 1
    }
}
