// Whether a string may be an npm package name, by npm's own rules
// (validate-npm-package-name), with its exact error and warning messages.
//
// A name must be URL-safe -- or a scope and a URL-safe name, `@scope/name`
// -- non-empty, and must not start with `.` or `_`, have surrounding
// spaces, or be `node_modules` or `favicon.ico`. Names that were allowed
// once but not for new packages only warn: capital letters, more than 214
// characters, any of `~'!()*` in the last segment, or a Node core module's
// name (`http`, `fs`, ...). So a name is valid for new packages with no
// errors and no warnings, and for old ones with no errors.

type NpmNameReport = {
    valid_for_new: bool,
    valid_for_old: bool,
    warnings: [str],
    errors: [str],
}

// BEGIN GENERATED by scripts/gen_npmname.py from Node v25.2.1
fn builtins() -> [str] {
    ["_http_agent", "_http_client", "_http_common", "_http_incoming", "_http_outgoing", "_http_server", "_stream_duplex",
        "_stream_passthrough", "_stream_readable", "_stream_transform", "_stream_wrap", "_stream_writable", "_tls_common",
        "_tls_wrap", "assert", "assert/strict", "async_hooks", "buffer", "child_process", "cluster", "console",
        "constants", "crypto", "dgram", "diagnostics_channel", "dns", "dns/promises", "domain", "events", "fs",
        "fs/promises", "http", "http2", "https", "inspector", "inspector/promises", "module", "net", "os", "path",
        "path/posix", "path/win32", "perf_hooks", "process", "punycode", "querystring", "readline", "readline/promises",
        "repl", "stream", "stream/consumers", "stream/promises", "stream/web", "string_decoder", "sys", "timers",
        "timers/promises", "tls", "trace_events", "tty", "url", "util", "util/types", "v8", "vm", "wasi", "worker_threads",
        "zlib", "node:sea", "node:sqlite", "node:test", "node:test/reporters"]
}
// END GENERATED

fn is_js_space(c: str) -> bool {
    let v = c.code_at(0)
    (v >= 9 and v <= 13) or v == 32 or v == 160 or v == 5760 or (v >= 8192 and v <= 8202) or v == 8232 or
    v == 8233 or v == 8239 or v == 8287 or v == 12288 or v == 65279
}

fn trimmed(s: str) -> bool {
    let cs = s.chars()
    cs.len() == 0 or (not is_js_space(cs[0]) and not is_js_space(cs[cs.len() - 1]))
}

/// Whether encodeURIComponent leaves the string unchanged.
fn url_safe(s: str) -> bool {
    for c in s.chars() {
        let ok = (c >= "A" and c <= "Z") or (c >= "a" and c <= "z") or (c >= "0" and c <= "9") or "-_.!~*'()".contains(c)
        if not ok {
            return false
        }
    }
    true
}

/// npm's `^(?:@([^/]+?)[/])?([^/]+?)$`: (has scope, scope, name), or None.
fn scoped(name: str) -> Option[(bool, str, str)] {
    let parts = name.split("/")
    if parts.len() == 1 {
        return if name.len() > 0 { Some((false, "", name)) } else { None }
    }
    if parts.len() == 2 and parts[0].starts_with("@") and parts[0].len() > 1 and parts[1].len() > 0 {
        return Some((true, parts[0].substr(1, parts[0].len() - 1), parts[1]))
    }
    None
}

pub fn validate(name: str) -> NpmNameReport {
    var warnings: [str] = []
    var errors: [str] = []
    if name.len() == 0 {
        errors.push("name length must be greater than zero")
    }
    if name.starts_with(".") {
        errors.push("name cannot start with a period")
    }
    if name.starts_with("_") {
        errors.push("name cannot start with an underscore")
    }
    if not trimmed(name) {
        errors.push("name cannot contain leading or trailing spaces")
    }
    for excluded in ["node_modules", "favicon.ico"] {
        if name.to_lower() == excluded {
            errors.push(excluded + " is not a valid package name")
        }
    }
    if builtins().contains(name.to_lower()) {
        warnings.push(name + " is a core module name")
    }
    if name.len() > 214 {
        warnings.push("name can no longer contain more than 214 characters")
    }
    if name.to_lower() != name {
        warnings.push("name can no longer contain capital letters")
    }
    let segments = name.split("/")
    let last = segments[segments.len() - 1]
    for c in last.chars() {
        if "~'!()*".contains(c) {
            warnings.push("name can no longer contain special characters (\"~'!()*\")")
            break
        }
    }
    if not url_safe(name) {
        var fine = false
        match scoped(name) {
            Some((has_scope, user, pkg)) -> {
                if pkg.starts_with(".") {
                    errors.push("name cannot start with a period")
                }
                fine = has_scope and url_safe(user) and url_safe(pkg)
            }
            None -> {}
        }
        if not fine {
            errors.push("name can only contain URL-friendly characters")
        }
    }
    NpmNameReport{ valid_for_new: errors.len() == 0 and warnings.len() == 0, valid_for_old: errors.len() == 0,
        warnings: warnings, errors: errors }
}
