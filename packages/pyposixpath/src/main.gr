// Python's `posixpath` (what `os.path` is on Linux and macOS), as CPython
// 3.13 computes it: `normpath`, `join`, `split`, `splitext`, `basename`,
// `dirname`, `isabs`, `splitroot`, `commonprefix`, `commonpath`,
// `abspath` and `relpath`.
//
// Python build tools, packagers and test runners compute their paths
// with these, and a tool that has to name the same files needs the same
// lexical rules:
//
//   - Exactly two leading slashes are kept (`//a`, as POSIX allows); one,
//     or three or more, become one.
//   - `join` restarts at an absolute part and adds no slash after one
//     already there; `split` keeps a root of slashes whole.
//   - `splitext` ignores leading dots, so `.bashrc` has no extension but
//     `..x.y` has `.y`.
//   - `commonprefix` is character-wise (`/usr/lib` and `/usr/local` share
//     `/usr/l`); `commonpath` is component-wise and refuses to mix
//     absolute and relative paths.
//   - `abspath` and `relpath` take the current directory as `cwd` here,
//     where Python would call `os.getcwd()`.

type PosixPathError = | PathValueError(msg: str)

pub fn error_text(e: PosixPathError) -> str {
    return match e {
        PathValueError(m) -> m
    }
}

fn cs(s: str) -> [i64] {
    return s.codes()
}

fn text(c: [i64]) -> str {
    return c.map(|x| x.to_char()).join("")
}

fn rfind(c: [i64], x: i64) -> i64 {
    var i = c.len() - 1
    while i >= 0 and c[i] != x {
        i = i - 1
    }
    return i
}

fn all_slashes(c: [i64]) -> bool {
    return c.all(|x| x == 47)
}

fn rstrip_slash(c: [i64]) -> [i64] {
    var n = c.len()
    while n > 0 and c[n - 1] == 47 {
        n = n - 1
    }
    return c.slice(0, n)
}

/// `splitroot(p)`: drive (always empty), root and tail.
pub fn splitroot(p: str) -> (str, str, str) {
    let c = cs(p)
    if c.len() == 0 or c[0] != 47 {
        return ("", "", p)
    }
    if c.len() < 2 or c[1] != 47 or (c.len() >= 3 and c[2] == 47) {
        return ("", "/", text(c.slice(1, c.len())))
    }
    return ("", "//", text(c.slice(2, c.len())))
}

/// `normpath(p)`.
pub fn normpath(p: str) -> str {
    if p.len() == 0 {
        return "."
    }
    let (_d, root, tail) = splitroot(p)
    var comps: [str] = []
    for comp in tail.split("/") {
        if comp.len() == 0 or comp == "." {
            continue
        }
        if comp != ".." or (root.len() == 0 and comps.len() == 0) or (comps.len() > 0 and comps[comps.len() - 1] == "..") {
            comps.push(comp)
        } else if comps.len() > 0 {
            comps.pop()
        }
    }
    let out = root + comps.join("/")
    return if out.len() == 0 { "." } else { out }
}

/// `join(a, *p)`.
pub fn join(parts: [str]) -> str {
    var path = if parts.len() > 0 { parts[0] } else { "" }
    for k in 1..parts.len() {
        let b = parts[k]
        if b.starts_with("/") or path.len() == 0 {
            path = b
        } else if path.ends_with("/") {
            path = path + b
        } else {
            path = path + "/" + b
        }
    }
    return path
}

/// `split(p)`: head and tail.
pub fn split(p: str) -> (str, str) {
    let c = cs(p)
    let i = rfind(c, 47) + 1
    var head = c.slice(0, i)
    if head.len() > 0 and not all_slashes(head) {
        head = rstrip_slash(head)
    }
    return (text(head), text(c.slice(i, c.len())))
}

pub fn basename(p: str) -> str {
    let c = cs(p)
    return text(c.slice(rfind(c, 47) + 1, c.len()))
}

pub fn dirname(p: str) -> str {
    let (head, _tail) = split(p)
    return head
}

pub fn isabs(p: str) -> bool {
    return p.starts_with("/")
}

/// `splitext(p)`: root and extension.
pub fn splitext(p: str) -> (str, str) {
    let c = cs(p)
    let sep = rfind(c, 47)
    let dot = rfind(c, 46)
    if dot > sep {
        var k = sep + 1
        while k < dot {
            if c[k] != 46 {
                return (text(c.slice(0, dot)), text(c.slice(dot, c.len())))
            }
            k = k + 1
        }
    }
    return (p, "")
}

/// -1, 0 or 1, by code point.
fn cmp(a: [i64], b: [i64]) -> i64 {
    let n = if a.len() < b.len() { a.len() } else { b.len() }
    for i in 0..n {
        if a[i] != b[i] {
            return if a[i] < b[i] { 0 - 1 } else { 1 }
        }
    }
    return if a.len() < b.len() { 0 - 1 } else if a.len() > b.len() { 1 } else { 0 }
}

fn cmp_lists(a: [[i64]], b: [[i64]]) -> i64 {
    let n = if a.len() < b.len() { a.len() } else { b.len() }
    for i in 0..n {
        let c = cmp(a[i], b[i])
        if c != 0 {
            return c
        }
    }
    return if a.len() < b.len() { 0 - 1 } else if a.len() > b.len() { 1 } else { 0 }
}

/// `commonprefix(m)`: the longest common leading characters.
pub fn commonprefix(m: [str]) -> str {
    if m.len() == 0 {
        return ""
    }
    var s1 = cs(m[0])
    var s2 = cs(m[0])
    for p in m {
        let c = cs(p)
        if cmp(c, s1) < 0 {
            s1 = c
        }
        if cmp(c, s2) > 0 {
            s2 = c
        }
    }
    for i in 0..s1.len() {
        if s1[i] != s2[i] {
            return text(s1.slice(0, i))
        }
    }
    return text(s1)
}

fn list_prefix(a: [[i64]], b: [[i64]]) -> i64 {
    var lo = a
    var hi = b
    if cmp_lists(b, a) < 0 {
        lo = b
        hi = a
    }
    for i in 0..lo.len() {
        if cmp(lo[i], hi[i]) != 0 {
            return i
        }
    }
    return lo.len()
}

/// `commonpath(paths)`: the longest common sub-path.
pub fn commonpath(paths: [str]) -> str ! PosixPathError {
    if paths.len() == 0 {
        fail(PathValueError("commonpath() arg is an empty sequence"))
    }
    let abs = paths[0].starts_with("/")
    if paths.any(|p| p.starts_with("/") != abs) {
        fail(PathValueError("Can't mix absolute and relative paths"))
    }
    let split_paths = paths.map(|p| p.split("/").filter(|c| c.len() > 0 and c != ".").map(|c| cs(c)))
    var s1 = split_paths[0]
    var s2 = split_paths[0]
    for s in split_paths {
        if cmp_lists(s, s1) < 0 {
            s1 = s
        }
        if cmp_lists(s, s2) > 0 {
            s2 = s
        }
    }
    var common = s1
    for i in 0..s1.len() {
        if cmp(s1[i], s2[i]) != 0 {
            common = s1.slice(0, i)
            break
        }
    }
    return (if abs { "/" } else { "" }) + common.map(|c| text(c)).join("/")
}

/// `abspath(p)` with `os.getcwd()` being `cwd`.
pub fn abspath(p: str, cwd: str) -> str {
    return normpath(if p.starts_with("/") { p } else { join([cwd, p]) })
}

fn components(p: str) -> [[i64]] {
    let c = cs(p)
    var i = 0
    while i < c.len() and c[i] == 47 {
        i = i + 1
    }
    let tail = text(c.slice(i, c.len()))
    return if tail.len() == 0 { [] } else { tail.split("/").map(|x| cs(x)) }
}

/// `relpath(path, start)` with `os.getcwd()` being `cwd`.
pub fn relpath(path: str, start: str, cwd: str) -> str ! PosixPathError {
    if path.len() == 0 {
        fail(PathValueError("no path specified"))
    }
    let start_list = components(abspath(start, cwd))
    let path_list = components(abspath(path, cwd))
    let i = list_prefix(start_list, path_list)
    var rel: [str] = []
    for _k in 0..(start_list.len() - i) {
        rel.push("..")
    }
    for k in i..path_list.len() {
        rel.push(text(path_list[k]))
    }
    return if rel.len() == 0 { "." } else { rel.join("/") }
}
