// Printing a double as the shortest decimal that reads back as itself.
//
// `0.1 + 0.2` is a double whose exact value is
// 0.3000000000000000444089209850062616169452667236328125. Printing all of
// that is useless; printing `0.3` is wrong, because `0.3` is a different
// double. The right answer is `0.30000000000000004` — the shortest string
// that, parsed back, gives the same bits. Every modern language prints
// floats this way, and two packages here had to write down a caveat for
// want of it: `formatspec` refuses float presentations and `picklefile`
// says its rendering matches Python's `repr` "except for floats".
//
// ## Why this is not a formatting detail
//
// A float printed with too few digits is a different number when it is read
// back. A float printed with too many is noise, and worse, is *unstable* —
// `%.17g` of 0.3 is `0.29999999999999999`, which is the same double and does
// not look like it. Configuration files, JSON, CSV exports, test fixtures
// and log lines all get read by something, and a value that changes when it
// makes the round trip is a bug that surfaces a long way from here.
//
// ## How it is done here
//
// Not with floating-point arithmetic. A double is exactly `m × 2^e` for
// integers `m` and `e`, so rounding it to `k` decimal digits is an exact
// question about integers, and `packages/bigint` answers it: build the
// numerator and denominator, divide, round half to even. That is slow and
// it is *right*, which matters more — the fast algorithms for this (Grisu,
// Ryū) exist because printing floats is on the hot path of serialisers, and
// they are several hundred lines of tables and proofs each.
//
// Then each candidate length from 1 to 17 digits is tried in turn and the
// first one that parses back to the same bits wins. Seventeen always works:
// that is the number of decimal digits that distinguishes every double from
// every other.
//
// The layout is Python's `repr`, which is also JavaScript's and Java's in
// the cases that matter: fixed notation while the exponent is in range,
// scientific outside it, and a trailing `.0` so a whole number still looks
// like a float.
//
// Checked against Python's `repr` over random doubles across the whole
// exponent range, the subnormals, and the values that are famous for
// breaking implementations.

import bigint

let SIGNIFICAND_BITS = 52
let EXPONENT_MASK = 2047
let BIAS = 1075

type FloatParts = {
    negative: bool,
    /// The digits, without a decimal point.
    digits: str,
    /// Where the point goes: the value is `0.<digits> × 10^point`.
    point: i64,
    /// `inf`, `-inf` or `nan` when the value is not a number.
    special: str,
}

fn ten_to(power: i64) -> BigInt {
    return bigint.pow(bigint.from_i64(10), power)
}

fn two_to(power: i64) -> BigInt {
    return bigint.pow(bigint.from_i64(2), power)
}

fn larger(a: i64, b: i64) -> i64 {
    return if a > b { a } else { b }
}

/// `mantissa × 2^exponent × 10^scale`, as an exact fraction.
fn scaled(mantissa: BigInt, exponent: i64, scale: i64) -> (BigInt, BigInt) {
    var top = mantissa
    var bottom = bigint.from_i64(1)
    if exponent >= 0 {
        top = bigint.mul(top, two_to(exponent))
    } else {
        bottom = bigint.mul(bottom, two_to(0 - exponent))
    }
    if scale >= 0 {
        top = bigint.mul(top, ten_to(scale))
    } else {
        bottom = bigint.mul(bottom, ten_to(0 - scale))
    }
    return (top, bottom)
}

/// `top / bottom`, rounded half to even — which is the rounding every
/// floating-point standard uses and the one that does not drift.
fn rounded_quotient(top: BigInt, bottom: BigInt) -> BigInt {
    let split = bigint.divmod(top, bottom) ??
    (bigint.zero(), bigint.zero())
    let doubled = bigint.mul(split.1, bigint.from_i64(2))
    let order = bigint.compare(doubled, bottom)
    if order > 0 {
        return bigint.add(split.0, bigint.from_i64(1))
    }
    if order < 0 {
        return split.0
    }
    // Exactly half: up only if that makes the last digit even.
    let last = bigint.rem(split.0, bigint.from_i64(2)) ?? bigint.zero()
    if bigint.is_zero(last) {
        return split.0
    }
    return bigint.add(split.0, bigint.from_i64(1))
}

/// Where the decimal point falls: the number of digits before it.
///
/// Started from an approximation of `log10(2)` and then corrected by exact
/// comparison, because an estimate that is one out gives an answer that is
/// a factor of ten wrong and looks almost right.
fn decimal_point(mantissa: BigInt, exponent: i64) -> i64 {
    let bits = bigint.bit_length(mantissa) + exponent
    // 1233/4096 is log10(2) to more places than this needs.
    var point = bits * 1233 / 4096 + 1
    var going = true
    while going {
        let pair = scaled(mantissa, exponent, 0 - point + 1)
        // `pair.0 / pair.1` must land in [1, 10).
        let quotient = bigint.div(pair.0, pair.1) ?? bigint.zero()
        if bigint.is_zero(quotient) {
            point = point - 1
        } else if bigint.compare(quotient, bigint.from_i64(10)) >= 0 {
            point = point + 1
        } else {
            going = false
        }
    }
    return point
}

/// The `k` most significant decimal digits of `mantissa × 2^exponent`,
/// correctly rounded, with the decimal point that goes with them.
fn digits_at(mantissa: BigInt, exponent: i64, point: i64,
    k: i64) -> (str, i64) {
    let pair = scaled(mantissa, exponent, k - point)
    var value = rounded_quotient(pair.0, pair.1)
    var text = bigint.to_str(value)
    if text.len() > k {
        // Rounding carried into a new digit: 999 became 1000.
        return (text.substr(0, k), point + 1)
    }
    while text.len() < k {
        text = "0" + text
    }
    return (text, point)
}

fn build(digits: str, point: i64, negative: bool) -> str {
    var out = ""
    if negative {
        out = "-"
    }
    // `repr` switches to an exponent below 1e-4 and at 1e17.
    if point <= 0 - 4 or point > 16 {
        out = out + digits.substr(0, 1)
        if digits.len() > 1 {
            out = out + "." + digits.substr(1, digits.len() - 1)
        }
        var power = point - 1
        var mark = "+"
        if power < 0 {
            mark = "-"
            power = 0 - power
        }
        var figure = power.to_str()
        if figure.len() < 2 {
            figure = "0" + figure
        }
        return out + "e" + mark + figure
    }
    if point <= 0 {
        var zeros = ""
        var i = 0
        while i < 0 - point {
            zeros = zeros + "0"
            i = i + 1
        }
        return out + "0." + zeros + digits
    }
    if point >= digits.len() {
        var zeros = ""
        var i = 0
        while i < point - digits.len() {
            zeros = zeros + "0"
            i = i + 1
        }
        // A whole number still has to look like a float.
        return out + digits + zeros + ".0"
    }
    return out + digits.substr(0, point) + "." +
    digits.substr(point, digits.len() - point)
}

/// The pieces of `value`: sign, digits, and where the point goes.
pub fn parts(value: f64) -> FloatParts {
    let bits = value.to_bits()
    let negative = bits.ushr(63).bit_and(1) == 1
    let raw_exponent = bits.ushr(SIGNIFICAND_BITS).bit_and(EXPONENT_MASK)
    let fraction = bits.bit_and(4503599627370495)
    if raw_exponent == EXPONENT_MASK {
        var name = "inf"
        if fraction != 0 {
            name = "nan"
        } else if negative {
            name = "-inf"
        }
        return FloatParts{
            negative: negative,
            digits: "",
            point: 0,
            special: name,
        }
    }
    if raw_exponent == 0 and fraction == 0 {
        return FloatParts{
            negative: negative,
            digits: "0",
            point: 1,
            special: "",
        }
    }
    var mantissa = bigint.from_i64(fraction)
    var exponent = 0 - BIAS + 1
    if raw_exponent != 0 {
        mantissa = bigint.from_i64(fraction + 4503599627370496)
        exponent = raw_exponent - BIAS
    }
    let point = decimal_point(mantissa, exponent)
    var k = 1
    while k <= 17 {
        let candidate = digits_at(mantissa, exponent, point, k)
        // Seventeen digits always distinguish one double from every other,
        // so the loop always ends; anything shorter has to be checked.
        if k == 17 {
            return FloatParts{
                negative: negative,
                digits: candidate.0,
                point: candidate.1,
                special: "",
            }
        }
        let text = build(candidate.0, candidate.1, false)
        match text.parse_float() {
            Some(back) -> {
                if back.to_bits() == bits.bit_and(9223372036854775807) {
                    return FloatParts{
                        negative: negative,
                        digits: candidate.0,
                        point: candidate.1,
                        special: "",
                    }
                }
            }
            None -> {}
        }
        k = k + 1
    }
    return FloatParts{
        negative: negative,
        digits: "0",
        point: 1,
        special: "",
    }
}

/// The shortest decimal string that reads back as `value`, laid out the way
/// `repr` lays it out.
pub fn repr(value: f64) -> str {
    let found = parts(value)
    if found.special != "" {
        return found.special
    }
    if found.digits == "0" {
        if found.negative {
            return "-0.0"
        }
        return "0.0"
    }
    return build(found.digits, found.point, found.negative)
}

/// How many significant digits it takes to write `value` back exactly.
pub fn significant_digits(value: f64) -> i64 {
    let found = parts(value)
    if found.special != "" {
        return 0
    }
    var end = found.digits.len()
    while end > 1 and found.digits.substr(end - 1, 1) == "0" {
        end = end - 1
    }
    return end
}

/// `value` with exactly `places` digits after the point, correctly rounded —
/// which is what a `%.*f` does and what `formatspec` needs for `f`.
pub fn fixed(value: f64, places: i64) -> str {
    let bits = value.to_bits()
    let raw_exponent = bits.ushr(SIGNIFICAND_BITS).bit_and(EXPONENT_MASK)
    if raw_exponent == EXPONENT_MASK {
        return repr(value)
    }
    let negative = bits.ushr(63).bit_and(1) == 1
    let fraction = bits.bit_and(4503599627370495)
    var mantissa = bigint.from_i64(fraction)
    var exponent = 0 - BIAS + 1
    if raw_exponent != 0 {
        mantissa = bigint.from_i64(fraction + 4503599627370496)
        exponent = raw_exponent - BIAS
    }
    let pair = scaled(mantissa, exponent, places)
    var text = bigint.to_str(rounded_quotient(pair.0, pair.1))
    while text.len() <= places {
        text = "0" + text
    }
    var out = ""
    if negative {
        out = "-"
    }
    let cut = text.len() - places
    out = out + text.substr(0, cut)
    if places > 0 {
        out = out + "." + text.substr(cut, places)
    }
    return out
}

/// Whether `text` reads back as exactly `value`, which is the property the
/// shortest string is chosen for.
pub fn round_trips(text: str, value: f64) -> bool {
    match text.parse_float() {
        Some(back) -> return back.to_bits() == value.to_bits()
        None -> return false
    }
}
