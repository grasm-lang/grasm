// Netpbm images: PBM, PGM and PPM, plain (P1, P2, P3) and raw (P4, P5, P6).
//
// The simplest image formats in use: a magic number, the width and height
// (and a maximum sample value for grey and colour) in ASCII separated by
// whitespace and `#` comments, then the samples -- as decimal text in the
// plain forms, as bytes in the raw ones (bits packed eight to a byte, most
// significant first, rows padded to a byte, for bitmaps; two bytes
// big-endian per sample when the maximum is over 255). In a bitmap 1 is
// black. Scientific tools, image test suites, ImageMagick and FFmpeg
// pipelines and countless C programs write these because nothing simpler
// exists.
//
// `decode` keeps the samples as written, with their maximum; `to_pillow`
// scales them the way Pillow does -- to 0..65535 for grey with a maximum
// over 255, to 0..255 otherwise, rounding halves to even -- and turns a
// bitmap into 0 for black and 255 for white.
//
// Checked against Pillow's PPM plugin.

type PnmImage = { width: i64, height: i64, channels: i64, maxval: i64, bitmap: bool, samples: [i64] }

type PnmError =
    | PnmNotPnm
    | PnmMalformed(why: str)
    | PnmTruncated

type PnmReader = { data: bytes, at: i64 }

fn skip_space(inout r: PnmReader) {
    while r.at < r.data.len() {
        let c = r.data.at(r.at)
        if c == 35 {
            while r.at < r.data.len() and r.data.at(r.at) != 10 and r.data.at(r.at) != 13 {
                r.at = r.at + 1
            }
        } else if c == 32 or c == 9 or c == 10 or c == 13 or c == 11 or c == 12 {
            r.at = r.at + 1
        } else {
            return
        }
    }
}

fn number(inout r: PnmReader) -> i64 ! PnmError {
    skip_space(r)
    var v = 0
    var digits = 0
    while r.at < r.data.len() {
        let c = r.data.at(r.at)
        if c < 48 or c > 57 {
            break
        }
        v = v * 10 + c - 48
        digits = digits + 1
        if v > 4294967295 {
            fail(PnmMalformed("a number too large"))
        }
        r.at = r.at + 1
    }
    if digits == 0 {
        fail(if r.at >= r.data.len() { PnmTruncated } else { PnmMalformed("a number was expected") })
    }
    return v
}

/// One digit of a plain bitmap: 0 or 1, whitespace optional between them.
fn bit(inout r: PnmReader) -> i64 ! PnmError {
    skip_space(r)
    if r.at >= r.data.len() {
        fail(PnmTruncated)
    }
    let c = r.data.at(r.at)
    r.at = r.at + 1
    if c != 48 and c != 49 {
        fail(PnmMalformed("a bitmap digit other than 0 or 1"))
    }
    return c - 48
}

pub fn decode(data: bytes) -> PnmImage ! PnmError {
    if data.len() < 2 or data.at(0) != 80 or data.at(1) < 49 or data.at(1) > 54 {
        fail(PnmNotPnm)
    }
    let kind = data.at(1) - 48
    var r = PnmReader{ data: data, at: 2 }
    let w = try number(r)
    let h = try number(r)
    let bitmap = kind == 1 or kind == 4
    let maxval = if bitmap { 1 } else { try number(r) }
    if w == 0 or h == 0 or w * h > 400000000 {
        fail(PnmMalformed("an empty or oversized image"))
    }
    if maxval < 1 or maxval > 65535 {
        fail(PnmMalformed("a maximum sample value outside 1..65535"))
    }
    let channels = if kind == 3 or kind == 6 { 3 } else { 1 }
    let n = w * h * channels
    var samples: [i64] = []
    if kind <= 3 {
        for _i in 0..n {
            let v = if bitmap { try bit(r) } else { try number(r) }
            samples.push(if v > maxval { maxval } else { v })
        }
        return PnmImage{ width: w, height: h, channels: channels, maxval: maxval, bitmap: bitmap, samples: samples }
    }
    // Exactly one whitespace byte separates the header from raw data.
    r.at = r.at + 1
    if bitmap {
        let row = (w + 7) / 8
        if r.at + row * h > data.len() {
            fail(PnmTruncated)
        }
        for y in 0..h {
            for x in 0..w {
                samples.push(data.at(r.at + y * row + x / 8).ushr(7 - x % 8).bit_and(1))
            }
        }
    } else {
        let size = if maxval > 255 { 2 } else { 1 }
        if r.at + n * size > data.len() {
            fail(PnmTruncated)
        }
        for i in 0..n {
            let v = if size == 2 { data.at(r.at + 2 * i) * 256 + data.at(r.at + 2 * i + 1) } else { data.at(r.at + i) }
            samples.push(if v > maxval { maxval } else { v })
        }
    }
    return PnmImage{ width: w, height: h, channels: channels, maxval: maxval, bitmap: bitmap, samples: samples }
}

/// The samples as Pillow presents them: a bitmap as 0 (black) and 255;
/// a maximum of 255 or less scaled to 0..255; a larger one to 0..65535.
pub fn to_pillow(img: PnmImage) -> [i64] {
    if img.bitmap {
        return img.samples.map(|v| if v == 1 { 0 } else { 255 })
    }
    let top = if img.maxval > 255 and img.channels == 1 { 65535 } else { 255 }
    let m = img.maxval
    return img.samples.map(|v| {
        let q = v * top / m
        let r = v * top % m
        // Halves round to even, as Pillow's arithmetic does.
        if 2 * r > m or 2 * r == m and q % 2 == 1 { q + 1 } else { q }
    })
}

fn header(img: PnmImage, magic: i64) -> str {
    let dims = "P{magic}\n{img.width} {img.height}\n"
    return if img.bitmap { dims } else { dims + "{img.maxval}\n" }
}

/// The raw form: P4, P5 or P6.
pub fn encode(img: PnmImage) -> bytes ! PnmError {
    if img.samples.len() != img.width * img.height * img.channels or (img.channels != 1 and img.channels != 3) {
        fail(PnmMalformed("samples that do not fill the image"))
    }
    let magic = if img.bitmap { 4 } else if img.channels == 3 { 6 } else { 5 }
    var out = header(img, magic).to_bytes().to_list()
    if img.bitmap {
        let row = (img.width + 7) / 8
        for y in 0..img.height {
            var line: [i64] = []
            for _b in 0..row {
                line.push(0)
            }
            for x in 0..img.width {
                if img.samples[y * img.width + x] != 0 {
                    line[x / 8] = line[x / 8].bit_or(1.shl(7 - x % 8))
                }
            }
            for item in line {
                out.push(item)
            }
        }
        return bytes_of(out)
    }
    for v in img.samples {
        for item in (if img.maxval > 255 { [v.ushr(8), v.bit_and(255)] } else { [v] }) {
            out.push(item)
        }
    }
    return bytes_of(out)
}

/// The plain form: P1, P2 or P3, at most 70 characters a line.
pub fn encode_plain(img: PnmImage) -> bytes ! PnmError {
    if img.samples.len() != img.width * img.height * img.channels or (img.channels != 1 and img.channels != 3) {
        fail(PnmMalformed("samples that do not fill the image"))
    }
    let magic = if img.bitmap { 1 } else if img.channels == 3 { 3 } else { 2 }
    var out = header(img, magic)
    var line = ""
    for v in img.samples {
        let t = "{v}"
        if line.len() + t.len() + 1 > 70 {
            out = out + line + "\n"
            line = ""
        }
        line = if line.len() == 0 { t } else { line + " " + t }
    }
    return (out + line + "\n").to_bytes()
}
