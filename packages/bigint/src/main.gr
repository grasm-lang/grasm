// Integers with no upper bound.
//
// `i64` stops at about 9.2 quintillion, which is enough for counting things
// and not enough for the three places this is actually needed: an RSA
// modulus, a factorial, and money held as an exact integer of the smallest
// unit across a currency with a large denomination. In every one of those the
// wrong answer is silent — a wrapped `i64` is still a number, and it still
// prints.
//
// Digits are kept in base 1,000,000,000, least significant first, with the
// sign held separately. Base 10^9 is chosen so that a limb product plus a
// carry stays inside `i64`: 10^18 + 10^9 is comfortably under the limit,
// which matters because a debug build checks overflow and would trap.

type BigInt = {
    /// Base 10^9 limbs, least significant first. Empty means zero.
    limb: [i64],
    negative: bool,
}

type BigError =
    | NotANumber(text: str)
    | DivideByZero

fn base() -> i64 {
    return 1000000000
}

fn limb_digits() -> i64 {
    return 9
}

/// Drop leading zero limbs, and refuse to keep a negative zero.
fn trim(inout n: BigInt) {
    while n.limb.len() > 0 and n.limb[n.limb.len() - 1] == 0 {
        n.limb.pop()
    }
    if n.limb.len() == 0 {
        n.negative = false
    }
}

pub fn zero() -> BigInt {
    return BigInt{ limb: [], negative: false }
}

pub fn from_i64(v: i64) -> BigInt {
    var out = BigInt{ limb: [], negative: v < 0 }
    // Counted down on the negative side, where i64::MIN fits: negating it
    // overflows, and the loop then never ran and MIN came out as 0.
    var left = if v < 0 { v } else { 0 - v }
    while left < 0 {
        out.limb.push(0 - left % base())
        left = left / base()
    }
    return out
}

pub fn parse(text: str) -> BigInt ! BigError {
    var body = text
    var negative = false
    if body.starts_with("-") {
        negative = true
        body = body.substr(1, body.len() - 1)
    } else if body.starts_with("+") {
        body = body.substr(1, body.len() - 1)
    }
    if body.len() == 0 {
        fail(NotANumber(text))
    }
    for c in body.chars() {
        if c < "0" or c > "9" {
            fail(NotANumber(text))
        }
    }
    var out = BigInt{ limb: [], negative: negative }
    // From the least significant end, nine characters at a time.
    var at = body.len()
    while at > 0 {
        let take = if at >= limb_digits() { limb_digits() } else { at }
        let chunk = body.substr(at - take, take)
        out.limb.push(chunk.parse_int() ?? 0)
        at = at - take
    }
    trim(out)
    return out
}

fn pad9(v: i64) -> str {
    var s = "{v}"
    while s.len() < limb_digits() {
        s = "0{s}"
    }
    return s
}

pub fn to_str(n: BigInt) -> str {
    if n.limb.len() == 0 {
        return "0"
    }
    var out = if n.negative { "-" } else { "" }
    out = out + "{n.limb[n.limb.len() - 1]}"
    var i = n.limb.len() - 2
    while i >= 0 {
        out = out + pad9(n.limb[i])
        i = i - 1
    }
    return out
}

pub fn is_zero(n: BigInt) -> bool {
    return n.limb.len() == 0
}

/// -1, 0 or 1.
pub fn sign(n: BigInt) -> i64 {
    if n.limb.len() == 0 {
        return 0
    }
    if n.negative {
        return 0 - 1
    }
    return 1
}

/// Decimal digits, which is the length of `to_str` without a sign.
pub fn digit_count(n: BigInt) -> i64 {
    if n.limb.len() == 0 {
        return 1
    }
    let top = "{n.limb[n.limb.len() - 1]}"
    return top.len() + (n.limb.len() - 1) * limb_digits()
}

fn cmp_abs(a: BigInt, b: BigInt) -> i64 {
    if a.limb.len() != b.limb.len() {
        if a.limb.len() < b.limb.len() {
            return 0 - 1
        }
        return 1
    }
    var i = a.limb.len() - 1
    while i >= 0 {
        if a.limb[i] != b.limb[i] {
            if a.limb[i] < b.limb[i] {
                return 0 - 1
            }
            return 1
        }
        i = i - 1
    }
    return 0
}

fn add_abs(a: BigInt, b: BigInt) -> [i64] {
    var out: [i64] = []
    var carry = 0
    var i = 0
    while i < a.limb.len() or i < b.limb.len() or carry > 0 {
        var sum = carry
        if i < a.limb.len() {
            sum = sum + a.limb[i]
        }
        if i < b.limb.len() {
            sum = sum + b.limb[i]
        }
        out.push(sum % base())
        carry = sum / base()
        i = i + 1
    }
    return out
}

/// `a - b`, where `|a| >= |b|` is the caller's responsibility.
fn sub_abs(a: BigInt, b: BigInt) -> [i64] {
    var out: [i64] = []
    var borrow = 0
    var i = 0
    while i < a.limb.len() {
        var d = a.limb[i] - borrow
        if i < b.limb.len() {
            d = d - b.limb[i]
        }
        if d < 0 {
            d = d + base()
            borrow = 1
        } else {
            borrow = 0
        }
        out.push(d)
        i = i + 1
    }
    return out
}

pub fn add(a: BigInt, b: BigInt) -> BigInt {
    if a.negative == b.negative {
        var out = BigInt{ limb: add_abs(a, b), negative: a.negative }
        trim(out)
        return out
    }
    let order = cmp_abs(a, b)
    if order == 0 {
        return zero()
    }
    if order > 0 {
        var out = BigInt{ limb: sub_abs(a, b), negative: a.negative }
        trim(out)
        return out
    }
    var out = BigInt{ limb: sub_abs(b, a), negative: b.negative }
    trim(out)
    return out
}

pub fn negate(n: BigInt) -> BigInt {
    if is_zero(n) {
        return n
    }
    return BigInt{ limb: n.limb, negative: not n.negative }
}

pub fn sub(a: BigInt, b: BigInt) -> BigInt {
    return add(a, negate(b))
}

pub fn compare(a: BigInt, b: BigInt) -> i64 {
    if a.negative != b.negative {
        if a.negative {
            return 0 - 1
        }
        return 1
    }
    let order = cmp_abs(a, b)
    if a.negative {
        return 0 - order
    }
    return order
}

pub fn mul(a: BigInt, b: BigInt) -> BigInt {
    if is_zero(a) or is_zero(b) {
        return zero()
    }
    var acc: [i64] = []
    for _i in 0..(a.limb.len() + b.limb.len()) {
        acc.push(0)
    }
    for i in 0..a.limb.len() {
        var carry = 0
        for j in 0..b.limb.len() {
            // Under 10^18 + 2 * 10^9, which is what base 10^9 was chosen for.
            let here = acc[i + j] + a.limb[i] * b.limb[j] + carry
            acc[i + j] = here % base()
            carry = here / base()
        }
        var at = i + b.limb.len()
        while carry > 0 {
            let here = acc[at] + carry
            acc[at] = here % base()
            carry = here / base()
            at = at + 1
        }
    }
    var out = BigInt{ limb: acc, negative: a.negative != b.negative }
    trim(out)
    return out
}

/// Multiply the magnitude by a single limb-sized value.
fn mul_small(limb: [i64], by: i64) -> [i64] {
    var out: [i64] = []
    var carry = 0
    for l in limb {
        let here = l * by + carry
        out.push(here % base())
        carry = here / base()
    }
    while carry > 0 {
        out.push(carry % base())
        carry = carry / base()
    }
    return out
}

/// Quotient and remainder, both truncated toward zero the way `i64 / i64` is.
/// Divide the magnitude by a single limb, keeping the remainder.
fn divmod_small(limb: [i64], by: i64) -> ([i64], i64) {
    var out: [i64] = []
    for _i in 0..limb.len() {
        out.push(0)
    }
    var rest = 0
    var i = limb.len() - 1
    while i >= 0 {
        let here = rest * base() + limb[i]
        out[i] = here / by
        rest = here % by
        i = i - 1
    }
    return (out, rest)
}

pub fn divmod(a: BigInt, b: BigInt) -> (BigInt, BigInt) ! BigError {
    if is_zero(b) {
        fail(DivideByZero)
    }
    if cmp_abs(a, b) < 0 {
        return (zero(), a)
    }
    // Normalise so the divisor's top limb is at least half the base. That is
    // what makes the quotient estimate below wrong by at most one, and it is
    // the difference between three comparisons a limb and thirty: the first
    // version bisected the whole range, and one RSA-2048 verification took
    // ten seconds because of it.
    let shift = base() / (b.limb[b.limb.len() - 1] + 1)
    var top = BigInt{ limb: b.limb, negative: false }
    var left = BigInt{ limb: a.limb, negative: false }
    if shift > 1 {
        top = BigInt{ limb: mul_small(b.limb, shift), negative: false }
        left = BigInt{ limb: mul_small(a.limb, shift), negative: false }
        trim(top)
        trim(left)
    }
    let n = top.limb.len()
    let top_limb = top.limb[n - 1]
    var quotient: [i64] = []
    for _i in 0..left.limb.len() {
        quotient.push(0)
    }
    var rest = zero()
    var i = left.limb.len() - 1
    while i >= 0 {
        // Shift the running remainder up one limb and bring the next down.
        var shifted: [i64] = [left.limb[i]]
        for l in rest.limb {
            shifted.push(l)
        }
        rest = BigInt{ limb: shifted, negative: false }
        trim(rest)
        // The estimate, from the top two limbs of the remainder over the top
        // limb of the divisor. Under normalisation it is exact or one too
        // large, so at most two corrections follow.
        var guess = 0
        if rest.limb.len() > n {
            guess = (rest.limb[n] * base() + rest.limb[n - 1]) / top_limb
        } else if rest.limb.len() == n {
            guess = rest.limb[n - 1] / top_limb
        }
        if guess > base() - 1 {
            guess = base() - 1
        }
        var taken = BigInt{ limb: mul_small(top.limb, guess), negative: false }
        trim(taken)
        while guess > 0 and cmp_abs(taken, rest) > 0 {
            guess = guess - 1
            taken = BigInt{ limb: mul_small(top.limb, guess), negative: false }
            trim(taken)
        }
        quotient[i] = guess
        if guess > 0 {
            rest = BigInt{ limb: sub_abs(rest, taken), negative: false }
            trim(rest)
        }
        i = i - 1
    }
    var q = BigInt{ limb: quotient, negative: a.negative != b.negative }
    trim(q)
    // Undo the normalisation on the remainder; the quotient is unaffected.
    if shift > 1 {
        rest = BigInt{ limb: divmod_small(rest.limb, shift).0, negative: false }
        trim(rest)
    }
    var r = rest
    r.negative = a.negative and not is_zero(r)
    return (q, r)
}

pub fn div(a: BigInt, b: BigInt) -> BigInt ! BigError {
    let pair = try divmod(a, b)
    return pair.0
}

pub fn rem(a: BigInt, b: BigInt) -> BigInt ! BigError {
    let pair = try divmod(a, b)
    return pair.1
}

pub fn pow(base_value: BigInt, exponent: i64) -> BigInt {
    if exponent <= 0 {
        return from_i64(1)
    }
    // Square and multiply: 2^4096 is twelve multiplications, not 4096.
    var result = from_i64(1)
    var squared = base_value
    var left = exponent
    while left > 0 {
        if left % 2 == 1 {
            result = mul(result, squared)
        }
        squared = mul(squared, squared)
        left = left / 2
    }
    return result
}

/// `base^exponent mod modulus`, by squaring.
///
/// The operation an RSA verification is: with the usual public exponent of
/// 65537 that is seventeen squarings and two multiplications, each followed
/// by a reduction. Written here rather than in `rsa` because it is
/// arithmetic, and because a modular exponentiation with no reduction inside
/// the loop builds a number with as many digits as the exponent has bits.
pub fn mod_pow(base_value: BigInt, exponent: BigInt,
    modulus: BigInt) -> BigInt ! BigError {
    if is_zero(modulus) {
        fail(DivideByZero)
    }
    var result = from_i64(1)
    var squared = try rem(base_value, modulus)
    var left = exponent
    let two = from_i64(2)
    while not is_zero(left) {
        let split = try divmod(left, two)
        if not is_zero(split.1) {
            result = try rem(mul(result, squared), modulus)
        }
        squared = try rem(mul(squared, squared), modulus)
        left = split.0
    }
    return result
}

/// A big-endian byte string as a number.
pub fn from_bytes(data: bytes) -> BigInt {
    var out = zero()
    let base_256 = from_i64(256)
    for i in 0..data.len() {
        out = add(mul(out, base_256), from_i64(data.at(i)))
    }
    return out
}

/// And back, left-padded to `width` bytes.
///
/// Padded rather than trimmed, because a signature or a modulus is a
/// fixed-width quantity and a leading zero byte is part of it.
pub fn to_bytes(n: BigInt, width: i64) -> bytes ! BigError {
    var out: [i64] = []
    var left = n
    let base_256 = from_i64(256)
    while not is_zero(left) {
        let split = try divmod(left, base_256)
        out.push(to_i64(split.1) ?? 0)
        left = split.0
    }
    while out.len() < width {
        out.push(0)
    }
    return bytes_of(out.rev())
}

/// How many bits the value occupies — an RSA key's size.
///
/// Estimated from the decimal digit count and then corrected, because the
/// exact answer by repeated division is one division per bit and a 2048-bit
/// modulus has two thousand of them.
pub fn bit_length(n: BigInt) -> i64 {
    if is_zero(n) {
        return 0
    }
    let two = from_i64(2)
    var bits = (digit_count(n).as_f64() * 3.321928094887362).as_i64() + 1
    while bits > 1 and compare(pow(two, bits - 1), n) > 0 {
        bits = bits - 1
    }
    while compare(pow(two, bits), n) <= 0 {
        bits = bits + 1
    }
    return bits
}

pub fn factorial(n: i64) -> BigInt {
    var out = from_i64(1)
    for i in 1..(n + 1) {
        out = mul(out, from_i64(i))
    }
    return out
}

/// The value as an `i64`, or `None` when it does not fit — which is the check
/// that using this type at all was meant to make possible.
pub fn to_i64(n: BigInt) -> Option[i64] {
    if n.limb.len() > 3 {
        return None
    }
    // Accumulated as a negative number, where i64::MIN fits; the positive
    // magnitude of MIN does not, and it used to come back as None.
    let min = 0 - 9223372036854775807 - 1
    var v = 0
    var i = n.limb.len() - 1
    while i >= 0 {
        if v < min / base() {
            return None
        }
        let scaled = v * base()
        if scaled < min + n.limb[i] {
            return None
        }
        v = scaled - n.limb[i]
        i = i - 1
    }
    if n.negative {
        return Some(v)
    }
    if v == min {
        return None
    }
    return Some(0 - v)
}
