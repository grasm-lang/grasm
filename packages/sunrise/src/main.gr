// Sunrise, sunset, and the days when neither happens.
//
// Sunrise is the moment the sun's upper limb crosses the horizon, which is
// when its centre is 0.833 degrees *below* it — half a degree of atmospheric
// refraction plus a quarter of a degree of the sun's own radius. Getting that
// constant wrong is a three-minute error at London's latitude and a much
// larger one further north, because the sun crosses the horizon at a shallower
// angle there and takes longer to do it.
//
// ## The equation
//
// The sun's altitude at hour angle H is
//
// ```
// sin(alt) = sin(lat) sin(dec) + cos(lat) cos(dec) cos(H)
// ```
//
// Solve for H at the target altitude and you have how long before and after
// solar noon the sun is at that height. Solar noon itself is 12:00 shifted by
// the equation of time and by four minutes for every degree of longitude.
//
// That is all of it. The only subtlety is that the declination and the
// equation of time change during the day, so the answer is refined once using
// the values at the time first computed — which moves the answer by a few
// seconds and is what every implementation does.
//
// ## The days it does not work
//
// Inside the polar circles the equation has no solution for part of the year:
// the cosine of the hour angle comes out above 1 or below -1, meaning the sun
// never gets that low, or never gets that high. That is polar day and polar
// night, and it is not an error — it is the answer.
//
// A library that returns a NaN there, or clamps and returns a plausible time,
// is worse than one that says so. Tromso has no sunrise for two months and a
// program that prints one is lying.
//
// ## Twilight
//
// The same equation at -6, -12 and -18 degrees: civil, nautical and
// astronomical. Above about 60 degrees of latitude astronomical twilight
// never ends in midsummer — the sun stays within 18 degrees of the horizon
// all night — which is why the sky over Scotland never goes properly dark in
// June.
//
// ## The date is a UTC date
//
// Four minutes of clock time per degree of longitude means Sydney's sunrise
// happens before its UTC day begins and New York's sunset after its UTC day
// ends. The answer here is always the crossing that falls *within* the
// requested UTC day, which is what a caller who passed a date wants and what
// `astral` returns.
//
// ## How accurate it is
//
// The hour angle is solved in closed form and then refined once with the
// declination at the answer, which is what NOAA's own spreadsheet does.
// Against `astral`, which solves iteratively, the difference is 12 seconds at
// the equator, 23 at London, 73 at Reykjavik and 89 at Tromso — it grows with
// latitude because the sun crosses the horizon at a shallower angle there, so
// a small error in altitude is a large one in time. Further refinement passes
// do not close it: the two methods have converged to slightly different
// answers, and the atmosphere makes both of them approximate anyway, since
// real refraction depends on the temperature and pressure nobody supplies.
//
// Checked against `astral`.

import solar

type SunError =
    | AlwaysUp(latitude: f64)
    | AlwaysDown(latitude: f64)

    /// Midnight UTC on a date, as a POSIX instant.
pub fn midnight(year: i64, month: i64, day: i64) -> i64 {
    return days_from_epoch(year, month, day) * 86400
}

fn days_from_epoch(year: i64, month: i64, day: i64) -> i64 {
    var y = year
    if month <= 2 {
        y = y - 1
    }
    let era = divide_floor(y, 400)
    let year_of_era = y - era * 400
    var m = month
    if m > 2 {
        m = m - 3
    } else {
        m = m + 9
    }
    let day_of_year = (153 * m + 2) / 5 + day - 1
    let day_of_era = year_of_era * 365 + year_of_era / 4 -
    year_of_era / 100 + day_of_year
    return era * 146097 + day_of_era - 719468
}

fn divide_floor(a: i64, b: i64) -> i64 {
    var q = a / b
    if a % b != 0 and (a < 0) != (b < 0) {
        q = q - 1
    }
    return q
}

fn pi() -> f64 {
    return 3.141592653589793
}

fn radians(d: f64) -> f64 {
    return d * pi() / 180.0
}

fn to_degrees(r: f64) -> f64 {
    return r * 180.0 / pi()
}

fn arccos(x: f64) -> f64 {
    if x >= 1.0 {
        return 0.0
    }
    if x <= 0.0 - 1.0 {
        return pi()
    }
    return pi() / 2.0 - (x / (1.0 - x * x).sqrt()).atan()
}

/// Solar noon on a date at a longitude, as a POSIX instant.
///
/// Twelve hundred hours, shifted by the equation of time and by four minutes
/// for every degree of longitude. Refined once, because the equation of time
/// at midnight is not quite the one at noon.
pub fn solar_noon(year: i64, month: i64, day: i64, longitude: f64) -> i64 {
    let base = midnight(year, month, day)
    var minutes = 720.0 - 4.0 * longitude -
    solar.equation_of_time(base + 43200)
    let refined = base + (minutes * 60.0).as_i64()
    minutes = 720.0 - 4.0 * longitude - solar.equation_of_time(refined)
    return base + (minutes * 60.0 + 0.5).as_i64()
}

/// The hour angle, in degrees, at which the sun is at an altitude.
///
/// The equation has no solution when the sun never reaches that altitude, or
/// never falls below it — which is polar day and polar night, and is an
/// answer rather than an error.
pub fn hour_angle_at(latitude: f64, declination: f64,
    altitude: f64) -> f64 ! SunError {
    let lat = radians(latitude)
    let dec = radians(declination)
    let cosine = (radians(altitude).sin() - lat.sin() * dec.sin()) /
    (lat.cos() * dec.cos())
    if cosine > 1.0 {
        fail(AlwaysDown(latitude))
    }
    if cosine < 0.0 - 1.0 {
        fail(AlwaysUp(latitude))
    }
    return to_degrees(arccos(cosine))
}

/// The instant the sun reaches an altitude, rising or setting.
fn crossing(year: i64, month: i64, day: i64, latitude: f64, longitude: f64,
    altitude: f64, rising: bool) -> i64 ! SunError {
    let base = midnight(year, month, day)
    var guess = base + 43200
    var i = 0
    var out = guess
    // Two passes: the declination and the equation of time at the answer are
    // not the ones at noon, and the difference is worth a few seconds.
    while i < 2 {
        let dec = solar.declination(guess)
        let angle = try hour_angle_at(latitude, dec, altitude)
        var minutes = 720.0 - 4.0 * (longitude + angle) -
        solar.equation_of_time(guess)
        if not rising {
            minutes = 720.0 - 4.0 * (longitude - angle) -
            solar.equation_of_time(guess)
        }
        // Placed inside the requested UTC day. Four minutes a degree of
        // longitude puts Sydney's sunrise before the day starts and New
        // York's sunset after it ends, and a caller who asked about a date
        // wants the event that falls in it — not the one that happens to be
        // nearest the arithmetic.
        while minutes < 0.0 {
            minutes = minutes + 1440.0
        }
        while minutes >= 1440.0 {
            minutes = minutes - 1440.0
        }
        out = base + (minutes * 60.0 + 0.5).as_i64()
        guess = out
        i = i + 1
    }
    return out
}

/// Sunrise on a date at a place.
pub fn sunrise(year: i64, month: i64, day: i64, latitude: f64,
    longitude: f64) -> i64 ! SunError {
    return try crossing(year, month, day, latitude, longitude,
        solar.sunrise_altitude(), true)
}

/// Sunset on a date at a place.
pub fn sunset(year: i64, month: i64, day: i64, latitude: f64,
    longitude: f64) -> i64 ! SunError {
    return try crossing(year, month, day, latitude, longitude,
        solar.sunrise_altitude(), false)
}

/// The start of a twilight, at a given depression below the horizon.
pub fn twilight_start(year: i64, month: i64, day: i64, latitude: f64,
    longitude: f64, altitude: f64) -> i64 ! SunError {
    return try crossing(year, month, day, latitude, longitude, altitude,
        true)
}

/// The end of a twilight.
pub fn twilight_end(year: i64, month: i64, day: i64, latitude: f64,
    longitude: f64, altitude: f64) -> i64 ! SunError {
    return try crossing(year, month, day, latitude, longitude, altitude,
        false)
}

/// Dawn: the start of civil twilight.
pub fn dawn(year: i64, month: i64, day: i64, latitude: f64,
    longitude: f64) -> i64 ! SunError {
    return try twilight_start(year, month, day, latitude, longitude,
        solar.civil_twilight())
}

/// Dusk: the end of civil twilight.
pub fn dusk(year: i64, month: i64, day: i64, latitude: f64,
    longitude: f64) -> i64 ! SunError {
    return try twilight_end(year, month, day, latitude, longitude,
        solar.civil_twilight())
}

/// How long the sun is up, in seconds.
pub fn day_length(year: i64, month: i64, day: i64, latitude: f64,
    longitude: f64) -> i64 ! SunError {
    return (try sunset(year, month, day, latitude, longitude)) -
    (try sunrise(year, month, day, latitude, longitude))
}

/// Whether the sun stays up all day.
pub fn is_polar_day(year: i64, month: i64, day: i64,
    latitude: f64) -> bool {
    match hour_angle_at(latitude, solar.declination(midnight(year, month,
        day) + 43200), solar.sunrise_altitude()) {
        Ok(_v) -> return false
        Err(e) -> {
            match e {
                AlwaysUp(_lat) -> return true
                AlwaysDown(_lat) -> return false
            }
        }
    }
}

/// Whether the sun never rises.
pub fn is_polar_night(year: i64, month: i64, day: i64,
    latitude: f64) -> bool {
    match hour_angle_at(latitude, solar.declination(midnight(year, month,
        day) + 43200), solar.sunrise_altitude()) {
        Ok(_v) -> return false
        Err(e) -> {
            match e {
                AlwaysUp(_lat) -> return false
                AlwaysDown(_lat) -> return true
            }
        }
    }
}

/// Whether astronomical twilight lasts all night.
///
/// Above about 60 degrees in midsummer it does: the sun never falls 18
/// degrees below the horizon, so the sky never goes properly dark. That is
/// why a June night in Scotland has no real darkness in it.
pub fn has_no_true_night(year: i64, month: i64, day: i64,
    latitude: f64) -> bool {
    match hour_angle_at(latitude, solar.declination(midnight(year, month,
        day) + 43200), solar.astronomical_twilight()) {
        Ok(_v) -> return false
        Err(_e) -> return true
    }
}

/// The latitude at which the sun is exactly on the horizon at local
/// midnight — the edge of the midnight sun for a date.
pub fn polar_circle() -> f64 {
    return 66.5622
}
