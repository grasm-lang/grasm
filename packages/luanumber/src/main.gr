// Lua's arithmetic, as Lua 5.5 computes it: the integer and float
// subtypes through every operator, string coercion, comparisons, and the
// math library functions that turn one subtype into the other.
//
// Lua is embedded in Neovim, Redis, nginx, games and network tools, and a
// host that evaluates the same expressions -- a config preprocessor, a
// Redis script tester, a port of a Lua module -- has to get the same
// numbers and the same errors:
//
//   - **Integers wrap around** on `+ - * unm` and `math.abs`; `//` floors
//     and `%` takes the divisor's sign, with `minint // -1` = minint and
//     `x % -1` = 0; `x // 0` is "attempt to divide by zero" and `x % 0`
//     "attempt to perform 'n%%0'".
//   - **Floats**: `/` always divides as floats, `//` is `floor(a/b)`, `%`
//     is C's `fmod` moved to the divisor's sign (so `-0.0` and NaN come out
//     as C makes them), and `x ^ 2` is `x * x`; any operation with a float
//     operand is a float.
//   - **Strings** convert in arithmetic as `tonumber` reads them (`"10"+1`
//     is the integer 11, `" 0x10 "` is 16, `"1e1"` a float); a string that
//     is not a number is an error -- and in 5.5 bitwise operators refuse
//     strings outright.
//   - **Bitwise operators** need integers or integral floats ("number has
//     no integer representation" otherwise); shifts are logical, and 64
//     or more places, either way, give 0.
//   - **Comparisons** between an integer and a float are exact
//     (`2^53+1 > 2^53` holds), strings compare bytewise, a number against a
//     string is an error, and `==` never converts.
//   - `math.tointeger`, `math.type`, `math.floor`, `math.ceil` (an integer
//     when it fits), `math.abs`, `math.fmod`, `math.max`, `math.min` (which
//     answer the original argument, string or number), `math.ult`, and
//     `tonumber(s, base)` with wrap-around.
//
// Values are integers, floats and strings; errors are reported by kind
// (`div0`, `mod0`, `noint`, `bitstr`, `arith`, `compare`, `fmod0`) since
// Lua's messages also name the variables involved. Not covered: `^` with
// an exponent other than 2 (it goes to the C library's `pow`), and the
// trigonometric and logarithmic functions, for the same reason.
//
// Checked against `lua` 5.5 evaluating generated operations under
// `pcall`.

import luaformat

/// A Lua value this works on.
type LuaNumValue = | LnInt(v: i64) | LnFloat(x: f64) | LnStr(s: str) | LnBool(b: bool) | LnNil

/// The error Lua raises, by kind, or a refusal.
type LuaNumError = | LuaRaised(kind: str) | LuaNumRefused(why: str)

fn raised(kind: str) -> LuaNumError {
    return LuaRaised(kind)
}

fn min_int() -> i64 {
    return 0 - 9223372036854775807 - 1
}

/// A string as a number, as `tonumber` (and string arithmetic) reads it.
fn str_number(s: str) -> Option[LuaNumValue] {
    if s.contains("\u{0}") {
        return None
    }
    return match luaformat.tonumber(s) {
        Some(n) -> Some(if n.is_integer { LnInt(n.integer) } else { LnFloat(n.float) })
        None -> None
    }
}

fn is_number(v: LuaNumValue) -> bool {
    return match v {
        LnInt(_i) -> true
        LnFloat(_x) -> true
        _ -> false
    }
}

fn to_float(v: LuaNumValue) -> f64 {
    return match v {
        LnInt(i) -> i.as_f64()
        LnFloat(x) -> x
        _ -> 0.0
    }
}

/// lua_numbertointeger: a float in range, truncated.
fn float_to_int(f: f64) -> Option[i64] {
    if f >= 0.0 - 9223372036854775808.0 and f < 9223372036854775808.0 {
        return Some(f.as_i64())
    }
    return None
}

/// luaV_flttointeger with mode 0 (exact), 1 (floor) or 2 (ceil).
fn flt_to_integer(n: f64, mode: i64) -> Option[i64] {
    var f = n.floor()
    if n != f {
        if mode == 0 {
            return None
        }
        if mode == 2 {
            f = f + 1.0
        }
    }
    return float_to_int(f)
}

/// The operands of an arithmetic operator as numbers: numbers stay,
/// strings go through `tonumber`, anything else fails.
fn arith_operand(v: LuaNumValue) -> Option[LuaNumValue] {
    return match v {
        LnInt(i) -> Some(LnInt(i))
        LnFloat(x) -> Some(LnFloat(x))
        LnStr(s) -> str_number(s)
        _ -> None
    }
}

fn idiv(m: i64, n: i64) -> i64 ! LuaNumError {
    if n == 0 {
        fail(raised("div0"))
    }
    if n == 0 - 1 {
        return 0 - m
    }
    var q = m / n
    if m.bit_xor(n) < 0 and m % n != 0 {
        q = q - 1
    }
    return q
}

fn imod(m: i64, n: i64) -> i64 ! LuaNumError {
    if n == 0 {
        fail(raised("mod0"))
    }
    if n == 0 - 1 {
        return 0
    }
    var r = m % n
    if r != 0 and r.bit_xor(n) < 0 {
        r = r + n
    }
    return r
}

/// luai_nummod.
fn fmod_lua(a: f64, b: f64) -> f64 {
    var m = a % b
    let fix = if m > 0.0 { b < 0.0 } else { m < 0.0 and b > 0.0 }
    if fix {
        m = m + b
    }
    return m
}

fn float_arith(op: str, a: f64, b: f64) -> LuaNumValue ! LuaNumError {
    if op == "+" {
        return LnFloat(a + b)
    }
    if op == "-" {
        return LnFloat(a - b)
    }
    if op == "*" {
        return LnFloat(a * b)
    }
    if op == "/" {
        return LnFloat(a / b)
    }
    if op == "//" {
        return LnFloat((a / b).floor())
    }
    if op == "%" {
        return LnFloat(fmod_lua(a, b))
    }
    if b == 2.0 {
        return LnFloat(a * a)
    }
    fail(LuaNumRefused("^ with an exponent other than 2 goes through the C library's pow"))
}

fn int_arith(op: str, a: i64, b: i64) -> LuaNumValue ! LuaNumError {
    if op == "+" {
        return LnInt(a + b)
    }
    if op == "-" {
        return LnInt(a - b)
    }
    if op == "*" {
        return LnInt(a * b)
    }
    if op == "//" {
        return LnInt(try idiv(a, b))
    }
    return LnInt(try imod(a, b))
}

fn is_bitwise(op: str) -> bool {
    return op == "&" or op == "|" or op == "~" or op == "<<" or op == ">>"
}

/// The integer a bitwise operand stands for.
fn bit_operand(v: LuaNumValue) -> Option[i64] {
    return match v {
        LnInt(i) -> Some(i)
        LnFloat(x) -> flt_to_integer(x, 0)
        _ -> None
    }
}

fn shift_left(x: i64, y: i64) -> i64 {
    if y < 0 {
        return if y <= 0 - 64 { 0 } else { x.ushr(0 - y) }
    }
    return if y >= 64 { 0 } else { x.shl(y) }
}

fn bitwise(op: str, a: LuaNumValue, b: LuaNumValue) -> LuaNumValue ! LuaNumError {
    let x = bit_operand(a)
    let y = bit_operand(b)
    if x.is_none() or y.is_none() {
        fail(raised(if is_number(a) and is_number(b) { "noint" } else { "bitstr" }))
    }
    let i = x ?? 0
    let j = y ?? 0
    if op == "&" {
        return LnInt(i.bit_and(j))
    }
    if op == "|" {
        return LnInt(i.bit_or(j))
    }
    if op == "~" {
        return LnInt(i.bit_xor(j))
    }
    if op == "<<" {
        return LnInt(shift_left(i, j))
    }
    return LnInt(shift_left(i, 0 - j))
}

/// `a op b` for `+ - * / // % ^` and `& | ~ << >>`.
pub fn arith(op: str, a: LuaNumValue, b: LuaNumValue) -> LuaNumValue ! LuaNumError {
    if is_bitwise(op) {
        return try bitwise(op, a, b)
    }
    if not (op == "+" or op == "-" or op == "*" or op == "/" or op == "//" or op == "%" or op == "^") {
        fail(LuaNumRefused("unknown operator " + op))
    }
    let x = arith_operand(a)
    let y = arith_operand(b)
    if x.is_none() or y.is_none() {
        fail(raised("arith"))
    }
    let p = x ?? LnInt(0)
    let q = y ?? LnInt(0)
    match p {
        LnInt(i) -> match q {
            LnInt(j) -> if op != "/" and op != "^" {
                return try int_arith(op, i, j)
            }
            _ -> {}
        }
        _ -> {}
    }
    return try float_arith(op, to_float(p), to_float(q))
}

/// Unary minus and `~`.
pub fn unary(op: str, a: LuaNumValue) -> LuaNumValue ! LuaNumError {
    if op == "~" {
        match bit_operand(a) {
            Some(i) -> return LnInt(i.bit_not())
            None -> fail(raised(if is_number(a) { "noint" } else { "bitstr" }))
        }
    }
    return match arith_operand(a) {
        Some(v) -> match v {
            LnInt(i) -> LnInt(0 - i)
            LnFloat(x) -> LnFloat(x * (0.0 - 1.0))
            _ -> fail(raised("arith"))
        }
        None -> fail(raised("arith"))
    }
}

fn fits_float(i: i64) -> bool {
    return i >= 0 - 9007199254740992 and i <= 9007199254740992
}

fn lt_int_float(i: i64, f: f64) -> bool {
    if fits_float(i) {
        return i.as_f64() < f
    }
    return match flt_to_integer(f, 2) {
        Some(fi) -> i < fi
        None -> f > 0.0
    }
}

fn le_int_float(i: i64, f: f64) -> bool {
    if fits_float(i) {
        return i.as_f64() <= f
    }
    return match flt_to_integer(f, 1) {
        Some(fi) -> i <= fi
        None -> f > 0.0
    }
}

fn lt_float_int(f: f64, i: i64) -> bool {
    if fits_float(i) {
        return f < i.as_f64()
    }
    return match flt_to_integer(f, 1) {
        Some(fi) -> fi < i
        None -> f < 0.0
    }
}

fn le_float_int(f: f64, i: i64) -> bool {
    if fits_float(i) {
        return f <= i.as_f64()
    }
    return match flt_to_integer(f, 2) {
        Some(fi) -> fi <= i
        None -> f < 0.0
    }
}

fn num_less(a: LuaNumValue, b: LuaNumValue, or_equal: bool) -> bool {
    return match a {
        LnInt(i) -> match b {
            LnInt(j) -> if or_equal { i <= j } else { i < j }
            LnFloat(g) -> if or_equal { le_int_float(i, g) } else { lt_int_float(i, g) }
            _ -> false
        }
        LnFloat(f) -> match b {
            LnInt(j) -> if or_equal { le_float_int(f, j) } else { lt_float_int(f, j) }
            LnFloat(g) -> if or_equal { f <= g } else { f < g }
            _ -> false
        }
        _ -> false
    }
}

/// l_strcmp in the C locale: bytewise.
fn str_compare(a: str, b: str) -> i64 {
    let x = a.to_bytes().to_list()
    let y = b.to_bytes().to_list()
    var i = 0
    while i < x.len() and i < y.len() {
        if x[i] != y[i] {
            return if x[i] < y[i] { 0 - 1 } else { 1 }
        }
        i = i + 1
    }
    return if x.len() == y.len() { 0 } else if x.len() < y.len() { 0 - 1 } else { 1 }
}

/// `a < b` (or `a <= b`).
fn less(a: LuaNumValue, b: LuaNumValue, or_equal: bool) -> bool ! LuaNumError {
    if is_number(a) and is_number(b) {
        return num_less(a, b, or_equal)
    }
    match a {
        LnStr(s) -> match b {
            LnStr(t) -> {
                let c = str_compare(s, t)
                return if or_equal { c <= 0 } else { c < 0 }
            }
            _ -> {}
        }
        _ -> {}
    }
    fail(raised("compare"))
}

/// `a == b`: no conversions, integers and floats equal when the numbers
/// are.
pub fn equal(a: LuaNumValue, b: LuaNumValue) -> bool {
    return match a {
        LnInt(i) -> match b {
            LnInt(j) -> i == j
            LnFloat(g) -> flt_to_integer(g, 0) == Some(i)
            _ -> false
        }
        LnFloat(f) -> match b {
            LnInt(j) -> flt_to_integer(f, 0) == Some(j)
            LnFloat(g) -> f == g
            _ -> false
        }
        LnStr(s) -> match b {
            LnStr(t) -> s == t
            _ -> false
        }
        LnBool(x) -> match b {
            LnBool(y) -> x == y
            _ -> false
        }
        LnNil -> b == LnNil
    }
}

/// `a op b` for `< <= > >= == ~=`.
pub fn compare(op: str, a: LuaNumValue, b: LuaNumValue) -> bool ! LuaNumError {
    if op == "<" {
        return try less(a, b, false)
    }
    if op == "<=" {
        return try less(a, b, true)
    }
    if op == ">" {
        return try less(b, a, false)
    }
    if op == ">=" {
        return try less(b, a, true)
    }
    if op == "==" {
        return equal(a, b)
    }
    if op == "~=" {
        return not equal(a, b)
    }
    fail(LuaNumRefused("unknown comparison " + op))
}

/// lua_tointegerx: numbers, and strings that read as numbers, with an
/// exact integer value.
fn to_integer(v: LuaNumValue) -> Option[i64] {
    return match v {
        LnInt(i) -> Some(i)
        LnFloat(x) -> flt_to_integer(x, 0)
        LnStr(s) -> match str_number(s) {
            Some(n) -> to_integer(n)
            None -> None
        }
        _ -> None
    }
}

/// luaL_checknumber: a number, or a string that reads as one.
fn check_number(v: LuaNumValue) -> f64 ! LuaNumError {
    return match arith_operand(v) {
        Some(n) -> to_float(n)
        None -> fail(raised("arg"))
    }
}

fn is_int(v: LuaNumValue) -> bool {
    return match v {
        LnInt(_i) -> true
        _ -> false
    }
}

fn num_int(d: f64) -> LuaNumValue {
    return match float_to_int(d) {
        Some(i) -> if d == d { LnInt(i) } else { LnFloat(d) }
        None -> LnFloat(d)
    }
}

/// `math.<name>(args...)` for tointeger, type, floor, ceil, abs, fmod,
/// max, min and ult; `nil` comes back as LnNil.
pub fn math(name: str, args: [LuaNumValue]) -> LuaNumValue ! LuaNumError {
    if args.len() == 0 {
        fail(raised("arg"))
    }
    let a = args[0]
    if name == "tointeger" {
        return match to_integer(a) {
            Some(i) -> LnInt(i)
            None -> LnNil
        }
    }
    if name == "type" {
        return match a {
            LnInt(_i) -> LnStr("integer")
            LnFloat(_x) -> LnStr("float")
            _ -> LnNil
        }
    }
    if name == "floor" or name == "ceil" {
        if is_int(a) {
            return a
        }
        let x = try check_number(a)
        return num_int(if name == "floor" { x.floor() } else { x.ceil() })
    }
    if name == "abs" {
        return match a {
            LnInt(i) -> LnInt(if i < 0 { 0 - i } else { i })
            _ -> LnFloat((try check_number(a)).abs())
        }
    }
    return try math_two(name, args)
}

fn math_two(name: str, args: [LuaNumValue]) -> LuaNumValue ! LuaNumError {
    if name == "max" or name == "min" {
        var best = 0
        var i = 1
        while i < args.len() {
            let better = if name == "max" { try less(args[best], args[i], false) } else { try less(args[i], args[best], false) }
            if better {
                best = i
            }
            i = i + 1
        }
        return args[best]
    }
    if args.len() < 2 {
        fail(raised("arg"))
    }
    let a = args[0]
    let b = args[1]
    if name == "fmod" {
        if is_int(a) and is_int(b) {
            let d = to_integer(b) ?? 0
            if d == 0 {
                fail(raised("fmod0"))
            }
            if d == 0 - 1 {
                return LnInt(0)
            }
            return LnInt((to_integer(a) ?? 0) % d)
        }
        return LnFloat((try check_number(a)) % (try check_number(b)))
    }
    if name == "ult" {
        let x = try check_integer(a)
        let y = try check_integer(b)
        return LnBool(x.bit_xor(min_int()) < y.bit_xor(min_int()))
    }
    fail(LuaNumRefused("math." + name + " is not covered"))
}

/// luaL_checkinteger.
fn check_integer(v: LuaNumValue) -> i64 ! LuaNumError {
    match to_integer(v) {
        Some(i) -> return i
        None -> {}
    }
    return match arith_operand(v) {
        Some(_n) -> fail(raised("noint"))
        None -> fail(raised("arg"))
    }
}

fn is_space(c: i64) -> bool {
    return c == 32 or c >= 9 and c <= 13
}

fn is_alnum(c: i64) -> bool {
    return c >= 48 and c <= 57 or c >= 65 and c <= 90 or c >= 97 and c <= 122
}

/// `tonumber(s, base)`: digits of the base with an optional sign and
/// spaces around, wrapping around 64 bits; None when it is not a numeral.
pub fn tonumber_base(s: str, base: i64) -> Option[i64] ! LuaNumError {
    if base < 2 or base > 36 {
        fail(raised("base"))
    }
    let b = s.to_bytes().to_list()
    var i = 0
    while i < b.len() and is_space(b[i]) {
        i = i + 1
    }
    var neg = false
    if i < b.len() and b[i] == 45 {
        neg = true
        i = i + 1
    } else if i < b.len() and b[i] == 43 {
        i = i + 1
    }
    if not (i < b.len() and is_alnum(b[i])) {
        return None
    }
    var n = 0
    while i < b.len() and is_alnum(b[i]) {
        let c = b[i]
        let digit = if c <= 57 { c - 48 } else if c <= 90 { c - 55 } else { c - 87 }
        if digit >= base {
            return None
        }
        n = n * base + digit
        i = i + 1
    }
    while i < b.len() and is_space(b[i]) {
        i = i + 1
    }
    if i != b.len() {
        return None
    }
    return Some(if neg { 0 - n } else { n })
}
