// The Grasm side of scripts/b34_diff.py: `<op> x x<fields>`, the fields
// `|`-separated, bytes in hex and numbers in decimal. Answers are hex, or
// ERR.
import ripemd160
import whirlpool
import sm3
import mdc2
import hmac
import kbkdf
import x963kdf
import tls12prf
import sshkdf
import sskdf
import x942kdf
import pkcs12kdf
import krb5kdf
import pbkdf1
import md5
import sha1
import crypto_hash
import sha512
import sha3
import cmac
import aes

type B34Hash = { f: fn(bytes) -> bytes, block: i64 }

fn from_hex(text: str) -> bytes {
    var out: [i64] = []
    var i = 1
    while i + 1 < text.len() {
        // Fields that are not hex (hash names, numbers) decode to junk
        // nobody reads; a sign must not make that junk negative.
        let v = text.substr(i, 2).parse_int_base(16) ?? 0
        out.push(if v < 0 or v > 255 { 0 } else { v })
        i = i + 2
    }
    bytes_of(out)
}

fn unhex(text: str) -> bytes {
    from_hex(":" + text)
}

fn hex(raw: bytes) -> str {
    let digits = "0123456789abcdef"
    var out = ""
    var i = 0
    while i < raw.len() {
        out = out + digits.substr(raw.at(i) / 16, 1) + digits.substr(raw.at(i) % 16, 1)
        i = i + 1
    }
    out
}

fn int(s: str) -> i64 {
    s.parse_int() ?? 0
}

fn hash_of(name: str) -> B34Hash {
    if name == "md5" {
        return B34Hash{ f: |x| md5.hash(x), block: 64 }
    }
    if name == "sha1" {
        return B34Hash{ f: |x| sha1.hash(x), block: 64 }
    }
    if name == "sha256" {
        return B34Hash{ f: |x| crypto_hash.sha256_of(x), block: 64 }
    }
    if name == "sha384" {
        return B34Hash{ f: |x| sha512.sha384(x), block: 128 }
    }
    if name == "sha512" {
        return B34Hash{ f: |x| sha512.sha512(x), block: 128 }
    }
    if name == "sha512-256" {
        return B34Hash{ f: |x| sha512.sha512_256(x), block: 128 }
    }
    if name == "sha3-224" {
        return B34Hash{ f: |x| sha3.sha3_224(x), block: 144 }
    }
    if name == "sha3-256" {
        return B34Hash{ f: |x| sha3.sha3_256(x), block: 136 }
    }
    if name == "sha3-384" {
        return B34Hash{ f: |x| sha3.sha3_384(x), block: 104 }
    }
    if name == "sha3-512" {
        return B34Hash{ f: |x| sha3.sha3_512(x), block: 72 }
    }
    if name == "sm3" {
        return B34Hash{ f: |x| sm3.hash(x), block: 64 }
    }
    if name == "ripemd160" {
        return B34Hash{ f: |x| ripemd160.hash(x), block: 64 }
    }
    if name == "mdc2" {
        return B34Hash{ f: |x| mdc2.hash(x), block: 8 }
    }
    return B34Hash{ f: |x| whirlpool.hash(x), block: 64 }
}

fn kek(s: str) -> X942Kek {
    if s == "1" { X942Aes128Wrap } else if s == "2" { X942Aes192Wrap } else if s == "3" { X942Aes256Wrap } else { X942Des3Wrap }
}

fn krb(s: str) -> Krb5Cipher {
    if s == "a128" { Krb5Aes128 } else if s == "a256" { Krb5Aes256 } else { Krb5Des3 }
}

fn answer_kbkdf(g: [str], f: [bytes]) -> str {
    let prf: fn(bytes) -> bytes = if g[0] == "cmac" {
        let c = aes.new_cipher(f[1])
            |m| cmac.cmac_with(16, |b| aes.encrypt_with(c, b), m)
    } else {
        let h = hash_of(g[0])
            |m| hmac.hmac(h.f, h.block, f[1], m)
    }
    let mode = if g[2] == "f" { KbkdfFeedback } else { KbkdfCounter }
    let o = KbkdfOptions{ counter_bits: int(g[7]), use_length: g[8] == "1", use_separator: g[9] == "1" }
    return match kbkdf.derive(prf, mode, f[3], f[4], f[5], int(g[6]), o) {
        Ok(b) -> hex(b)
        Err(_) -> "ERR"
    }
}

fn answer(op: str, text: str) -> str {
    let parts = op.split(".")
    let g = text.split("|")
    let f = g.map(|x| unhex(x))
    let h = hash_of(if parts.len() > 1 { parts[1] } else { "" })
    let kind = parts[0]
    if kind == "hash" {
        return hex(h.f(f[0]))
    }
    if kind == "hmac" {
        return hex(hmac.hmac(h.f, h.block, f[0], f[1]))
    }
    if kind == "kbkdf" {
        return answer_kbkdf(g, f)
    }
    if kind == "x963" {
        return match x963kdf.derive(h.f, f[0], f[1], int(g[2])) {
            Ok(b) -> hex(b)
            Err(_) -> "ERR"
        }
    }
    if kind == "tls12" {
        return hex(tls12prf.prf(|k, m| hmac.hmac(h.f, h.block, k, m), f[0], f[1], f[2], int(g[3])))
    }
    if kind == "tls10" {
        return hex(tls12prf.prf_tls10(f[0], f[1], f[2], int(g[3])))
    }
    if kind == "ssh" {
        return hex(sshkdf.derive(h.f, f[0], f[1], int(g[2]), f[3], int(g[4])))
    }
    if kind == "sskdf" {
        return match sskdf.hash_derive(h.f, f[0], f[1], int(g[2])) {
            Ok(b) -> hex(b)
            Err(_) -> "ERR"
        }
    }
    if kind == "sskdfh" {
        return match sskdf.hmac_derive(|k, m| hmac.hmac(h.f, h.block, k, m), f[0], f[1], f[2], int(g[3])) {
            Ok(b) -> hex(b)
            Err(_) -> "ERR"
        }
    }
    if kind == "x942" {
        let info = X942Info{ party_u: f[2], party_v: f[3], supp_pub: f[4], supp_priv: f[5], use_keybits: g[6] == "1" }
        return hex(x942kdf.derive(h.f, f[0], kek(g[1]), info, int(g[7])))
    }
    if kind == "pkcs12" {
        return match pkcs12kdf.derive(h.f, h.block, f[0], f[1], int(g[2]), int(g[3]), int(g[4])) {
            Ok(b) -> hex(b)
            Err(_) -> "ERR"
        }
    }
    if kind == "krb5" {
        return match krb5kdf.derive(krb(g[0]), f[1], f[2]) {
            Ok(b) -> hex(b)
            Err(_) -> "ERR"
        }
    }
    if kind == "bmp" {
        return hex(pkcs12kdf.bmp_password(f[0].to_str()))
    }
    if kind == "mpint" {
        return hex(sshkdf.mpint(f[0]))
    }
    return match pbkdf1.derive(h.f, f[0], f[1], int(g[2]), int(g[3])) {
        Ok(b) -> hex(b)
        Err(_) -> "ERR"
    }
}

fn main() / {io} {
    let argv = args()
    var i = 0
    while i + 2 < argv.len() {
        print(answer(argv[i], from_hex(argv[i + 2]).to_str()))
        i = i + 3
    }
}
