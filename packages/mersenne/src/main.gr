// MT19937, the Mersenne Twister — the same numbers Python, NumPy, Ruby, PHP,
// MATLAB and R produce from the same seed.
//
// `packages/random` already has a generator, and a better one: xoshiro256**
// is faster, has a smaller state, and passes tests MT19937 fails. It is the
// right choice for anything that just needs random numbers, and nothing here
// should replace it.
//
// This exists for the other reason people want a generator: **agreeing with
// somebody else**. A simulation whose paper says "seeded with 12345", a test
// fixture generated by a Python script, a shuffled dataset that has to come
// out in the same order in two languages — all of those need this exact
// generator, because "random" in every one of those sentences means MT19937.
// A better generator is the wrong answer to that question.
//
// Neither is cryptographically usable. Observing 624 outputs of MT19937
// recovers the entire state, and the next number after that is not a guess.
// `packages/nonce` and `packages/random`'s byte functions are for keys.
//
// ## Seeding is the part that differs between languages
//
// The generator is one algorithm; how a seed becomes the initial state is
// not. `seeded` here is the reference `init_genrand`, which takes one 32-bit
// number. `seeded_by_array` is `init_by_array`, which takes any number of
// them — and that is what Python's `random.seed(n)` uses, breaking `n` into
// 32-bit words, least significant first. Feeding a seed to the wrong one of
// these gives a perfectly good stream that matches nobody.
//
// Checked against Python's `random` over its whole output: `getrandbits`,
// the 53-bit doubles from `random()`, and `randrange`.

let N = 624
let M = 397
let MATRIX = 2567483615
let UPPER = 2147483648
let LOWER = 2147483647
let MASK32 = 4294967295

type MersenneRng = {
    state: [i64],
    at: i64,
}

/// The reference `init_genrand`: one 32-bit seed.
pub fn seeded(seed: i64) -> MersenneRng {
    var state: [i64] = [seed.bit_and(MASK32)]
    var i = 1
    while i < N {
        let previous = state[i - 1]
        let mixed = previous.bit_xor(previous.ushr(30))
        state.push((1812433253 * mixed + i).bit_and(MASK32))
        i = i + 1
    }
    return MersenneRng{ state: state, at: N }
}

/// The reference `init_by_array`, which is what a seed larger than 32 bits
/// goes through and what Python uses for every integer seed.
pub fn seeded_by_array(key: [i64]) -> MersenneRng {
    var r = seeded(19650218)
    var i = 1
    var j = 0
    var k = if N > key.len() { N } else { key.len() }
    while k > 0 {
        let previous = r.state[i - 1]
        let mixed = previous.bit_xor(previous.ushr(30))
        r.state[i] = r.state[i].bit_xor(1664525 * mixed).bit_and(MASK32)
        r.state[i] = (r.state[i] + key[j] + j).bit_and(MASK32)
        i = i + 1
        j = j + 1
        if i >= N {
            r.state[0] = r.state[N - 1]
            i = 1
        }
        if j >= key.len() {
            j = 0
        }
        k = k - 1
    }
    k = N - 1
    while k > 0 {
        let previous = r.state[i - 1]
        let mixed = previous.bit_xor(previous.ushr(30))
        r.state[i] = r.state[i].bit_xor(1566083941 * mixed).bit_and(MASK32)
        r.state[i] = (r.state[i] - i).bit_and(MASK32)
        i = i + 1
        if i >= N {
            r.state[0] = r.state[N - 1]
            i = 1
        }
        k = k - 1
    }
    // The top bit on and everything else off, which guarantees the state is
    // not all zeros — the one state from which the generator never escapes.
    r.state[0] = UPPER
    r.at = N
    return r
}

/// The seed Python builds from an integer: 32-bit words, least significant
/// first, and a single zero word for zero.
pub fn python_key(seed: i64) -> [i64] {
    var n = seed
    if n < 0 {
        n = 0 - n
    }
    if n == 0 {
        return [0]
    }
    var key: [i64] = []
    while n > 0 {
        key.push(n.bit_and(MASK32))
        n = n.ushr(32)
    }
    return key
}

/// Seeded the way `random.seed(n)` seeds, so the streams agree.
pub fn python_seeded(seed: i64) -> MersenneRng {
    return seeded_by_array(python_key(seed))
}

fn twist(inout r: MersenneRng) {
    var i = 0
    while i < N {
        let mixed = r.state[i].bit_and(UPPER)
            .bit_or(r.state[(i + 1) % N].bit_and(LOWER))
        var next = r.state[(i + M) % N].bit_xor(mixed.ushr(1))
        if mixed % 2 == 1 {
            next = next.bit_xor(MATRIX)
        }
        r.state[i] = next.bit_and(MASK32)
        i = i + 1
    }
    r.at = 0
}

/// The next 32 bits, which is `getrandbits(32)`.
pub fn next_u32(inout r: MersenneRng) -> i64 {
    if r.at >= N {
        twist(r)
    }
    var y = r.state[r.at]
    r.at = r.at + 1
    // Tempering: four shifts and two masks, which turn a state word into
    // something that passes the tests the raw state does not.
    y = y.bit_xor(y.ushr(11))
    y = y.bit_xor(y.shl(7).bit_and(2636928640))
    y = y.bit_xor(y.shl(15).bit_and(4022730752))
    return y.bit_xor(y.ushr(18)).bit_and(MASK32)
}

/// `count` bits, taken the way Python's `getrandbits` takes them: the high
/// bits of a 32-bit word, and several words for more than 32.
pub fn next_bits(inout r: MersenneRng, count: i64) -> i64 {
    if count <= 0 {
        return 0
    }
    if count <= 32 {
        return next_u32(r).ushr(32 - count)
    }
    var out = 0
    var left = count
    var shift = 0
    while left > 0 {
        var take = left
        if take > 32 {
            take = 32
        }
        let word = next_u32(r).ushr(32 - take)
        out = out.bit_or(word.shl(shift))
        shift = shift + take
        left = left - take
    }
    return out
}

/// A double in [0, 1) with 53 bits of it, which is what `random()` returns.
pub fn next_double(inout r: MersenneRng) -> f64 {
    let high = next_u32(r).ushr(5)
    let low = next_u32(r).ushr(6)
    return (high.as_f64() * 67108864.0 + low.as_f64()) / 9007199254740992.0
}

/// A number below `n`, chosen the way Python's `randrange` chooses it:
/// enough bits to cover the range, retried until one lands inside.
pub fn below(inout r: MersenneRng, n: i64) -> i64 {
    if n <= 0 {
        return 0
    }
    var bits = 0
    var span = n - 1
    while span > 0 {
        bits = bits + 1
        span = span.ushr(1)
    }
    var candidate = next_bits(r, bits)
    while candidate >= n {
        candidate = next_bits(r, bits)
    }
    return candidate
}

/// `xs` shuffled the way Python's `random.shuffle` shuffles it — backwards,
/// with `randbelow` at each step.
pub fn shuffled[T](inout r: MersenneRng, xs: [T]) -> [T] {
    var out = xs
    var i = out.len() - 1
    while i > 0 {
        let j = below(r, i + 1)
        let held = out[i]
        out[i] = out[j]
        out[j] = held
        i = i - 1
    }
    return out
}
