// <<< end generated >>>

type QrMatrix = {
    size: i64,
    /// Row-major, 1 dark and 0 light.
    module: [i64],
    /// 1 where the module is part of the function patterns and not data.
    reserved: [i64],
    version: i64,
    level: i64,
    mask: i64,
}

type QrError =
    | TooLong(bytes: i64)
    | BadLevel(level: i64)
    | BadVersion(version: i64)

pub let LEVEL_L = 0
pub let LEVEL_M = 1
pub let LEVEL_Q = 2
pub let LEVEL_H = 3

pub fn level_name(level: i64) -> str {
    return ["L", "M", "Q", "H"][level]
}

// --------------------------------------------------------------- GF(256)

/// The field QR uses: bytes, with 0x11D as the primitive polynomial.
fn gf_exp() -> [i64] {
    var table: [i64] = []
    var x = 1
    for _i in 0..512 {
        table.push(x)
        x = x * 2
        if x >= 256 {
            x = x.bit_xor(285)
        }
    }
    return table
}

fn gf_log(exp: [i64]) -> [i64] {
    var table: [i64] = []
    for _i in 0..256 {
        table.push(0)
    }
    for i in 0..255 {
        table[exp[i]] = i
    }
    return table
}

fn gf_mul(exp: [i64], log: [i64], a: i64, b: i64) -> i64 {
    if a == 0 or b == 0 {
        return 0
    }
    return exp[(log[a] + log[b]) % 255]
}

/// The generator polynomial for `count` error words: the product of
/// (x - a^i) for i in 0..count.
fn generator(exp: [i64], log: [i64], count: i64) -> [i64] {
    var poly: [i64] = [1]
    for i in 0..count {
        var next: [i64] = []
        for _j in 0..(poly.len() + 1) {
            next.push(0)
        }
        for j in 0..poly.len() {
            next[j] = next[j].bit_xor(poly[j])
            next[j + 1] = next[j + 1].bit_xor(gf_mul(exp, log, poly[j], exp[i]))
        }
        poly = next
    }
    return poly
}

/// The error words for one block: polynomial division, remainder kept.
fn error_words(exp: [i64], log: [i64], data: [i64], count: i64) -> [i64] {
    let poly = generator(exp, log, count)
    var rest: [i64] = []
    for _i in 0..count {
        rest.push(0)
    }
    for b in data {
        let factor = b.bit_xor(rest[0])
        for i in 0..(count - 1) {
            rest[i] = rest[i + 1]
        }
        rest[count - 1] = 0
        if factor != 0 {
            for i in 0..count {
                rest[i] = rest[i].bit_xor(gf_mul(exp, log, poly[i + 1], factor))
            }
        }
    }
    return rest
}

// ------------------------------------------------------------ the tables

fn block_row(version: i64, level: i64) -> [i64] {
    let at = ((version - 1) * 4 + level) * 5
    var out: [i64] = []
    for i in 0..5 {
        out.push(QR_BLOCKS[at + i])
    }
    return out
}

/// The data capacity of a version and level, in codewords.
pub fn data_capacity(version: i64, level: i64) -> i64 {
    let row = block_row(version, level)
    return row[0] * row[1] + row[2] * row[3]
}

pub fn total_codewords(version: i64, level: i64) -> i64 {
    let row = block_row(version, level)
    return (row[0] + row[2]) * row[4] + data_capacity(version, level)
}

pub fn size_of_version(version: i64) -> i64 {
    return 17 + version * 4
}

/// How many bits are left over after the codewords, per version.
///
/// They are written as zeros. A symbol that omits them is short by up to
/// seven modules and scans as nothing.
fn remainder_bits(version: i64) -> i64 {
    if version == 1 {
        return 0
    }
    if version <= 6 {
        return 7
    }
    if version <= 13 {
        return 0
    }
    if version <= 20 {
        return 3
    }
    if version <= 27 {
        return 4
    }
    if version <= 34 {
        return 3
    }
    return 0
}

/// Byte mode's character-count field is 8 bits up to version 9 and 16 above.
fn count_bits(version: i64) -> i64 {
    if version <= 9 {
        return 8
    }
    return 16
}

/// The smallest version that holds `length` bytes at this level.
pub fn smallest_version(length: i64, level: i64) -> i64 ! QrError {
    if level < 0 or level > 3 {
        fail(BadLevel(level))
    }
    for version in 1..41 {
        let bits = 4 + count_bits(version) + length * 8
        if bits <= data_capacity(version, level) * 8 {
            return version
        }
    }
    fail(TooLong(length))
}

// ------------------------------------------------------------- bit stream

fn push_bits(inout out: [i64], value: i64, width: i64) {
    var i = width - 1
    while i >= 0 {
        out.push(value.ushr(i).bit_and(1))
        i = i - 1
    }
}

fn codewords_for(data: bytes, version: i64, level: i64) -> [i64] {
    var bits: [i64] = []
    // Mode 4 is byte mode.
    push_bits(bits, 4, 4)
    push_bits(bits, data.len(), count_bits(version))
    for i in 0..data.len() {
        push_bits(bits, data.at(i), 8)
    }
    let capacity = data_capacity(version, level) * 8
    // A terminator of up to four zero bits, then out to a byte boundary.
    var terminator = capacity - bits.len()
    if terminator > 4 {
        terminator = 4
    }
    for _i in 0..terminator {
        bits.push(0)
    }
    while bits.len() % 8 != 0 {
        bits.push(0)
    }
    var words: [i64] = []
    var i = 0
    while i < bits.len() {
        var v = 0
        for j in 0..8 {
            v = v * 2 + bits[i + j]
        }
        words.push(v)
        i = i + 8
    }
    // The two pad codewords the standard names, alternating.
    var pad = 236
    while words.len() < data_capacity(version, level) {
        words.push(pad)
        pad = if pad == 236 { 17 } else { 236 }
    }
    return words
}

/// Data and error words, split into blocks and interleaved.
fn interleaved(words: [i64], version: i64, level: i64) -> [i64] {
    let row = block_row(version, level)
    let exp = gf_exp()
    let log = gf_log(exp)
    var data_blocks: [[i64]] = []
    var ec_blocks: [[i64]] = []
    var at = 0
    for group in 0..2 {
        let count = if group == 0 { row[0] } else { row[2] }
        let size = if group == 0 { row[1] } else { row[3] }
        for _b in 0..count {
            var block: [i64] = []
            for _i in 0..size {
                block.push(words[at])
                at = at + 1
            }
            ec_blocks.push(error_words(exp, log, block, row[4]))
            data_blocks.push(block)
        }
    }
    var out: [i64] = []
    var longest = 0
    for b in data_blocks {
        if b.len() > longest {
            longest = b.len()
        }
    }
    // Codeword i of every block, then i+1 of every block: a smudge that
    // destroys a run of the symbol costs each block a little rather than one
    // block everything.
    for i in 0..longest {
        for b in data_blocks {
            if i < b.len() {
                out.push(b[i])
            }
        }
    }
    for i in 0..row[4] {
        for b in ec_blocks {
            out.push(b[i])
        }
    }
    return out
}

// ---------------------------------------------------------------- the grid

fn blank(version: i64) -> QrMatrix {
    let size = size_of_version(version)
    var module: [i64] = []
    var reserved: [i64] = []
    for _i in 0..(size * size) {
        module.push(0)
        reserved.push(0)
    }
    return QrMatrix{
        size: size, module: module, reserved: reserved, version: version,
        level: 0, mask: 0,
    }
}

fn set(inout m: QrMatrix, x: i64, y: i64, dark: i64, is_function: i64) {
    if x < 0 or y < 0 or x >= m.size or y >= m.size {
        return
    }
    m.module[y * m.size + x] = dark
    if is_function == 1 {
        m.reserved[y * m.size + x] = 1
    }
}

pub fn at(m: QrMatrix, x: i64, y: i64) -> i64 {
    if x < 0 or y < 0 or x >= m.size or y >= m.size {
        return 0
    }
    return m.module[y * m.size + x]
}

fn is_reserved(m: QrMatrix, x: i64, y: i64) -> bool {
    return m.reserved[y * m.size + x] == 1
}

fn place_finder(inout m: QrMatrix, ox: i64, oy: i64) {
    for dy in (0 - 1)..8 {
        for dx in (0 - 1)..8 {
            let x = ox + dx
            let y = oy + dy
            if x < 0 or y < 0 or x >= m.size or y >= m.size {
                continue
            }
            // Seven by seven: a dark ring, a light ring, a dark centre — and
            // the light separator around it, which is what makes the pattern
            // findable at any rotation.
            var dark = 0
            if dx >= 0 and dx <= 6 and dy >= 0 and dy <= 6 {
                let edge = dx == 0 or dx == 6 or dy == 0 or dy == 6
                let core = dx >= 2 and dx <= 4 and dy >= 2 and dy <= 4
                dark = if edge or core { 1 } else { 0 }
            }
            set(m, x, y, dark, 1)
        }
    }
}

fn alignment_centres(version: i64) -> [i64] {
    var at_index = 0
    for _v in 1..version {
        at_index = at_index + 1 + QR_ALIGNMENT[at_index]
    }
    let count = QR_ALIGNMENT[at_index]
    var out: [i64] = []
    for i in 0..count {
        out.push(QR_ALIGNMENT[at_index + 1 + i])
    }
    return out
}

fn place_alignment(inout m: QrMatrix) {
    let centres = alignment_centres(m.version)
    for cy in centres {
        for cx in centres {
            // Not over a finder: the three corners already have one.
            if (cx < 9 and cy < 9) or (cx > m.size - 10 and cy < 9) or
            (cx < 9 and cy > m.size - 10) {
                continue
            }
            for dy in (0 - 2)..3 {
                for dx in (0 - 2)..3 {
                    let ring = if dx < 0 { 0 - dx } else { dx }
                    let ringy = if dy < 0 { 0 - dy } else { dy }
                    let far = if ring > ringy { ring } else { ringy }
                    set(m, cx + dx, cy + dy, if far == 1 { 0 } else { 1 }, 1)
                }
            }
        }
    }
}

fn place_function(inout m: QrMatrix) {
    place_finder(m, 0, 0)
    place_finder(m, m.size - 7, 0)
    place_finder(m, 0, m.size - 7)
    // The timing patterns: one alternating row and one column, which give a
    // scanner the module pitch.
    for i in 8..(m.size - 8) {
        let dark = if i % 2 == 0 { 1 } else { 0 }
        set(m, i, 6, dark, 1)
        set(m, 6, i, dark, 1)
    }
    place_alignment(m)
    // The dark module, which is always dark and has no other purpose.
    set(m, 8, m.size - 8, 1, 1)
    // Reserve the format areas — but not row 6 or column 6, which the
    // timing patterns above have already claimed. Blanking those two
    // intersections leaves a symbol two modules wrong and unreadable, and
    // the two are the only ones the format path never writes back.
    for i in 0..9 {
        if i != 6 {
            set(m, i, 8, 0, 1)
            set(m, 8, i, 0, 1)
        }
    }
    for i in 0..8 {
        set(m, m.size - 1 - i, 8, 0, 1)
        set(m, 8, m.size - 1 - i, 0, 1)
    }
    if m.version >= 7 {
        for i in 0..18 {
            let x = i / 3
            let y = i % 3
            set(m, x, m.size - 11 + y, 0, 1)
            set(m, m.size - 11 + y, x, 0, 1)
        }
    }
}

/// Walk the symbol as the standard does: two columns at a time, right to
/// left, alternating up and down, skipping the timing column.
fn place_data(inout m: QrMatrix, words: [i64], version: i64) {
    var bits: [i64] = []
    for w in words {
        push_bits(bits, w, 8)
    }
    for _i in 0..remainder_bits(version) {
        bits.push(0)
    }
    var at = 0
    var column = m.size - 1
    var upward = true
    while column > 0 {
        if column == 6 {
            // The vertical timing pattern is not a data column at all.
            column = column - 1
        }
        for row in 0..m.size {
            let y = if upward { m.size - 1 - row } else { row }
            for side in 0..2 {
                let x = column - side
                if is_reserved(m, x, y) {
                    continue
                }
                var bit = 0
                if at < bits.len() {
                    bit = bits[at]
                    at = at + 1
                }
                set(m, x, y, bit, 0)
            }
        }
        upward = not upward
        column = column - 2
    }
}

fn mask_bit(mask: i64, x: i64, y: i64) -> bool {
    if mask == 0 {
        return (x + y) % 2 == 0
    }
    if mask == 1 {
        return y % 2 == 0
    }
    if mask == 2 {
        return x % 3 == 0
    }
    if mask == 3 {
        return (x + y) % 3 == 0
    }
    if mask == 4 {
        return (y / 2 + x / 3) % 2 == 0
    }
    if mask == 5 {
        return (x * y) % 2 + (x * y) % 3 == 0
    }
    if mask == 6 {
        return ((x * y) % 2 + (x * y) % 3) % 2 == 0
    }
    return ((x + y) % 2 + (x * y) % 3) % 2 == 0
}

fn apply_mask(inout m: QrMatrix, mask: i64) {
    for y in 0..m.size {
        for x in 0..m.size {
            if is_reserved(m, x, y) {
                continue
            }
            if mask_bit(mask, x, y) {
                m.module[y * m.size + x] = 1 - m.module[y * m.size + x]
            }
        }
    }
}

/// The four penalty rules, which is how a mask is chosen.
fn penalty(m: QrMatrix) -> i64 {
    var total = 0
    // Rule 1: runs of five or more of one colour, in rows and in columns.
    for line in 0..2 {
        for a in 0..m.size {
            var run = 1
            var last = 0 - 1
            for b in 0..m.size {
                let v = if line == 0 { at(m, b, a) } else { at(m, a, b) }
                if v == last {
                    run = run + 1
                } else {
                    if run >= 5 {
                        total = total + 3 + (run - 5)
                    }
                    run = 1
                    last = v
                }
            }
            if run >= 5 {
                total = total + 3 + (run - 5)
            }
        }
    }
    // Rule 2: every 2x2 block of one colour.
    for y in 0..(m.size - 1) {
        for x in 0..(m.size - 1) {
            let v = at(m, x, y)
            if at(m, x + 1, y) == v and at(m, x, y + 1) == v and
            at(m, x + 1, y + 1) == v {
                total = total + 3
            }
        }
    }
    // Rule 3: anything that looks like a finder pattern, in either direction.
    let pattern = [1, 0, 1, 1, 1, 0, 1, 0, 0, 0, 0]
    for line in 0..2 {
        for a in 0..m.size {
            for b in 0..(m.size - 10) {
                var forward = true
                var backward = true
                for k in 0..11 {
                    let v = if line == 0 { at(m, b + k, a) } else { at(m, a, b + k) }
                    if v != pattern[k] {
                        forward = false
                    }
                    if v != pattern[10 - k] {
                        backward = false
                    }
                }
                if forward or backward {
                    total = total + 40
                }
            }
        }
    }
    // Rule 4: how far the proportion of dark modules is from a half.
    var dark = 0
    for v in m.module {
        dark = dark + v
    }
    let percent = dark * 100 / (m.size * m.size)
    var away = if percent > 50 { percent - 50 } else { 50 - percent }
    total = total + away / 5 * 10
    return total
}

fn place_format(inout m: QrMatrix, level: i64, mask: i64) {
    let bits = QR_FORMAT_INFO[level * 8 + mask]
    for i in 0..15 {
        // Bit `i` goes at position `i` along the path, least significant
        // first. Writing them the other way round produces a symbol whose
        // format field is the mirror of the one it means.
        let bit = bits.ushr(i).bit_and(1)
        // The first copy, around the top-left finder.
        if i < 6 {
            set(m, 8, i, bit, 1)
        } else if i == 6 {
            set(m, 8, 7, bit, 1)
        } else if i == 7 {
            set(m, 8, 8, bit, 1)
        } else if i == 8 {
            set(m, 7, 8, bit, 1)
        } else {
            set(m, 14 - i, 8, bit, 1)
        }
        // The second, split between the other two corners.
        if i < 8 {
            set(m, m.size - 1 - i, 8, bit, 1)
        } else {
            set(m, 8, m.size - 15 + i, bit, 1)
        }
    }
    set(m, 8, m.size - 8, 1, 1)
}

fn place_version(inout m: QrMatrix) {
    if m.version < 7 {
        return
    }
    let bits = QR_VERSION_INFO[m.version - 7]
    for i in 0..18 {
        let bit = bits.ushr(i).bit_and(1)
        let x = i / 3
        let y = i % 3
        set(m, x, m.size - 11 + y, bit, 1)
        set(m, m.size - 11 + y, x, bit, 1)
    }
}

/// Encode at a chosen version, level and mask. `mask` of -1 scores all eight.
pub fn encode_at(data: bytes, version: i64, level: i64,
    mask: i64) -> QrMatrix ! QrError {
    if level < 0 or level > 3 {
        fail(BadLevel(level))
    }
    if version < 1 or version > 40 {
        fail(BadVersion(version))
    }
    if 4 + count_bits(version) + data.len() * 8 > data_capacity(version, level) * 8 {
        fail(TooLong(data.len()))
    }
    let words = interleaved(codewords_for(data, version, level), version, level)
    var base = blank(version)
    place_function(base)
    place_data(base, words, version)
    var best = base
    var best_mask = 0
    var best_score = 0 - 1
    var candidate = if mask >= 0 { mask } else { 0 }
    let last = if mask >= 0 { mask } else { 7 }
    while candidate <= last {
        var trial = base
        apply_mask(trial, candidate)
        place_format(trial, level, candidate)
        place_version(trial)
        let score = penalty(trial)
        if best_score < 0 or score < best_score {
            best_score = score
            best = trial
            best_mask = candidate
        }
        candidate = candidate + 1
    }
    best.level = level
    best.mask = best_mask
    return best
}

/// Encode into the smallest version that fits.
pub fn encode(data: bytes, level: i64) -> QrMatrix ! QrError {
    let version = try smallest_version(data.len(), level)
    return try encode_at(data, version, level, 0 - 1)
}

pub fn encode_text(text: str, level: i64) -> QrMatrix ! QrError {
    return try encode(text.to_bytes(), level)
}

pub fn size_of(m: QrMatrix) -> i64 {
    return m.size
}

pub fn version_of(m: QrMatrix) -> i64 {
    return m.version
}

pub fn mask_of(m: QrMatrix) -> i64 {
    return m.mask
}

pub fn level_of(m: QrMatrix) -> i64 {
    return m.level
}

/// The symbol as rows of `0` and `1`, for a test or another renderer.
pub fn rows(m: QrMatrix) -> [str] {
    var out: [str] = []
    for y in 0..m.size {
        var line = ""
        for x in 0..m.size {
            line = line + "{at(m, x, y)}"
        }
        out.push(line)
    }
    return out
}

/// The symbol drawn with half-block characters, two rows per line.
///
/// A terminal cell is about twice as tall as it is wide, so one character per
/// module gives a symbol no scanner reads. Two rows to a character makes it
/// square.
pub fn to_text(m: QrMatrix, quiet: i64) -> str {
    var out: [str] = []
    let full = m.size + quiet * 2
    var y = 0
    while y < full {
        var line = ""
        for x in 0..full {
            let top = at(m, x - quiet, y - quiet)
            let bottom = at(m, x - quiet, y + 1 - quiet)
            // Dark is drawn light and light dark, because a terminal is
            // usually light-on-dark and a scanner needs the quiet zone pale.
            if top == 1 and bottom == 1 {
                line = line + " "
            } else if top == 1 {
                line = line + (9604).to_char()
            } else if bottom == 1 {
                line = line + (9600).to_char()
            } else {
                line = line + (9608).to_char()
            }
        }
        out.push(line)
        y = y + 2
    }
    return out.join("\n")
}

/// How many bytes fit at a version and level.
pub fn capacity_bytes(version: i64, level: i64) -> i64 {
    return data_capacity(version, level) - 1 - count_bits(version) / 8
}
