// Retry policies: how long to wait, and when to stop.
//
// Two mistakes this exists to prevent. **Retrying forever**, which turns a
// dead dependency into a wedged process — a policy has a deadline and says so.
// And **retrying what cannot succeed**: a 400 is the caller's fault and no
// number of attempts fixes it, so `should_retry` refuses rather than looping.
//
// Randomness is a parameter, so this needs no capability and a test is exact.

type RetryPolicy = {
    max_attempts: i64,
    base_ms: i64,
    cap_ms: i64,
    /// Total time allowed across all attempts; -1 for none.
    deadline_ms: i64,
    jitter: bool,
}

pub fn exponential(max_attempts: i64, base_ms: i64, cap_ms: i64) -> RetryPolicy {
    return RetryPolicy{
        max_attempts: max_attempts, base_ms: base_ms, cap_ms: cap_ms,
        deadline_ms: 0 - 1, jitter: true,
    }
}

pub fn with_deadline(p: RetryPolicy, deadline_ms: i64) -> RetryPolicy {
    var out = p
    out.deadline_ms = deadline_ms
    return out
}

pub fn without_jitter(p: RetryPolicy) -> RetryPolicy {
    var out = p
    out.jitter = false
    return out
}

/// The ceiling for `attempt`, counted from 0, doubling and capped.
pub fn ceiling_ms(p: RetryPolicy, attempt: i64) -> i64 {
    var v = p.base_ms
    var i = 0
    while i < attempt and v < p.cap_ms {
        v = v * 2
        i = i + 1
    }
    if v > p.cap_ms {
        return p.cap_ms
    }
    return v
}

/// How long to wait before `attempt`. `random_thousandths` is 0..999.
///
/// Full jitter — anywhere in [0, ceiling] — rather than ceiling ± a wobble,
/// because a thousand clients failing at one instant must not all return at
/// one instant.
pub fn delay_ms(p: RetryPolicy, attempt: i64, random_thousandths: i64) -> i64 {
    let ceiling = ceiling_ms(p, attempt)
    if not p.jitter {
        return ceiling
    }
    var r = random_thousandths
    if r < 0 {
        r = 0
    }
    if r > 999 {
        r = 999
    }
    return ceiling * r / 1000
}

/// Whether another attempt is allowed, given how many have run and how long
/// they have taken in total.
pub fn may_retry(p: RetryPolicy, attempts_so_far: i64, elapsed_ms: i64) -> bool {
    if attempts_so_far >= p.max_attempts {
        return false
    }
    if p.deadline_ms >= 0 and elapsed_ms >= p.deadline_ms {
        return false
    }
    return true
}

/// Whether a status is worth retrying at all.
///
/// 408 and 429 are explicit "try later". 5xx other than 501 may be transient.
/// Everything in the 4xx range is the caller's fault, and retrying it is a
/// loop that never terminates in a way anybody notices.
pub fn should_retry(status: i64) -> bool {
    if status == 408 or status == 429 {
        return true
    }
    if status == 501 {
        return false
    }
    return status >= 500 and status < 600
}

/// The total wait across a whole policy, without jitter — for deciding
/// whether a deadline is even reachable before starting.
pub fn worst_case_ms(p: RetryPolicy) -> i64 {
    var total = 0
    for i in 0..p.max_attempts {
        total = total + ceiling_ms(p, i)
    }
    return total
}
