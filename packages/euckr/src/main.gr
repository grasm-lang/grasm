    ]
}

fn trail_index(trail: i64) -> i64 {
    if trail >= 161 and trail <= 254 {
        return trail - 161 + 0
    }
    return 0 - 1
}

fn lead_index(lead: i64) -> i64 {
    var i = 0
    for candidate in leads() {
        if candidate == lead {
            return i
        }
        i = i + 1
    }
    return 0 - 1
}

/// Whether a byte can start a two-byte character.
pub fn is_lead(byte: i64) -> bool {
    return lead_index(byte) >= 0
}

/// Whether a byte can follow a lead byte.
pub fn is_trail(byte: i64) -> bool {
    return trail_index(byte) >= 0
}

/// The code point a lead and trail byte stand for, or -1.
pub fn pair_to_code(lead: i64, trail: i64) -> i64 {
    let row = lead_index(lead)
    let column = trail_index(trail)
    if row < 0 or column < 0 {
        return 0 - 1
    }
    let code = rows()[row].substr(column * 4, 4).parse_int_base(16) ?? 0
    if code == 0 {
        return 0 - 1
    }
    return code
}

/// The two bytes a code point is written as, or (-1, -1).
///
/// Linear in the size of the table. Fine for one character; use an encoder
/// for a document.
pub fn code_to_pair(code: i64) -> (i64, i64) {
    var row = 0
    for text in rows() {
        var column = 0
        while column * 4 < text.len() {
            if (text.substr(column * 4, 4).parse_int_base(16) ?? 0) == code {
                return (leads()[row], trail_of(column))
            }
            column = column + 1
        }
        row = row + 1
    }
    return (0 - 1, 0 - 1)
}

fn trail_of(column: i64) -> i64 {
    if column >= 0 and column < 94 {
        return column - 0 + 161
    }
    return 0 - 1
}

/// A reverse table, built once.
///
/// Where two byte pairs decode to the same character the first pair in the
/// table wins, except where `preferred_pair` says otherwise.
pub fn encoder() -> EucKrEncoder {
    var out: Map[i64, i64] = map()
    var row = 0
    for text in rows() {
        var column = 0
        while column * 4 < text.len() {
            let code = text.substr(column * 4, 4).parse_int_base(16) ?? 0
            if code != 0 and not out.has(code) {
                out.set(code, leads()[row] * 256 + trail_of(column))
            }
            column = column + 1
        }
        row = row + 1
    }
    return EucKrEncoder{ map: out }
}

/// Bytes to text.
pub fn decode(data: bytes) -> str ! EucKrError {
    var out = ""
    var at = 0
    while at < data.len() {
        let byte = data.at(at)
        if byte < 128 {
            out = out + byte.to_char()
            at = at + 1
            continue
        }
        if not is_lead(byte) {
            fail(Invalid(at, byte))
        }
        if at + 1 >= data.len() {
            fail(Truncated(at))
        }
        let code = pair_to_code(byte, data.at(at + 1))
        if code < 0 {
            fail(Invalid(at, byte))
        }
        out = out + code.to_char()
        at = at + 2
    }
    return out
}

/// Text to bytes, with a prepared table.
pub fn encode_with(table: EucKrEncoder, text: str) -> bytes ! EucKrError {
    var out: [i64] = []
    var at = 0
    for code in text.codes() {
        if code < 128 {
            out.push(code)
            at = at + 1
            continue
        }
        match table.map.get(code) {
            Some(pair) -> {
                out.push(pair / 256)
                out.push(pair % 256)
            }
            None -> {
                fail(Unencodable(at, code))
            }
        }
        at = at + 1
    }
    return bytes_of(out)
}

/// Text to bytes, building the table first.
pub fn encode(text: str) -> bytes ! EucKrError {
    return try encode_with(encoder(), text)
}

/// Whether every character can be written.
pub fn is_encodable(text: str) -> bool {
    match encode(text) {
        Ok(_v) -> return true
        Err(_e) -> return false
    }
}

/// Whether the bytes decode without error.
pub fn is_valid(data: bytes) -> bool {
    match decode(data) {
        Ok(_v) -> return true
        Err(_e) -> return false
    }
}

/// How many characters the bytes hold, without building the string.
pub fn char_count(data: bytes) -> i64 ! EucKrError {
    return (try decode(data)).codes().len()
}

/// How many byte pairs the table defines.
pub fn table_size() -> i64 {
    var total = 0
    for text in rows() {
        var column = 0
        while column * 4 < text.len() {
            if (text.substr(column * 4, 4).parse_int_base(16) ?? 0) != 0 {
                total = total + 1
            }
            column = column + 1
        }
    }
    return total
}
