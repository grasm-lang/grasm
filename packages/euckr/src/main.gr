// EUC-KR: Korean text, and 8,822 syllables that are not enough.
//
// Korean is written in syllable blocks assembled from an alphabet of 24
// letters. There are 11,172 possible modern syllables. KS X 1001, which
// EUC-KR encodes, contains 2,350 of them — the ones in common use — and
// leaves the rest unwritable.
//
// That gap is the whole story of Korean encoding. A name, a dialect word, or
// an old spelling using one of the missing 8,822 syllables simply could not
// be typed. Microsoft's answer was CP949, which extends EUC-KR with the
// missing syllables in the lead-byte space EUC-KR leaves empty; Unicode's was
// to allocate all 11,172 in one contiguous block, which is why Hangul in
// Unicode is a beautifully regular arithmetic mapping and Hangul in EUC-KR is
// a lookup table.
//
// ## Why the trail bytes are safe here
//
// EUC-KR's trail bytes are 0xA1 to 0xFE — all high. Unlike Shift-JIS and
// Big5, no ASCII byte ever appears inside a character, so a program that
// scans for `/` or `\` is safe. EUC-KR is an EUC encoding, and that
// discipline is what the EUC family is for.
//
// ## What is stored
//
// KS X 1001 in the 0xB0 to 0xC8 lead range is the Hangul syllables; 0xA1 to
// 0xAC is punctuation, Greek, Cyrillic and the box-drawing set; 0xCA onward
// is 4,888 hanja, which are Chinese characters used in Korean and which
// appear more than once in the table where the same character has more than
// one Korean reading.
//
// The table is Python's `codecs` module's, and this agrees with it on all
// 8,225 two-byte characters.

type EucKrError =
    | Invalid(at: i64, byte: i64)
    | Truncated(at: i64)
    | Unencodable(at: i64, codepoint: i64)

    /// A prepared reverse table.
    ///
    /// Decoding is a lookup and needs nothing prepared. Encoding is the other
    /// way round, and searching a table of thousands of entries for every
    /// character would make encoding quadratic in the size of the table. A caller
    /// encoding more than a line of text builds one of these once.
type EucKrEncoder = { map: Map[i64, i64] }

fn leads() -> [i64] {
    return [161, 162, 163, 164, 165, 166, 167, 168, 169, 170, 171, 172, 176, 177, 178, 179, 180, 181, 182, 183, 184, 185, 186, 187, 188, 189, 190, 191, 192, 193, 194, 195, 196, 197, 198, 199, 200, 202, 203, 204, 205, 206, 207, 208, 209, 210, 211, 212, 213, 214, 215, 216, 217, 218, 219, 220, 221, 222, 223, 224, 225, 226, 227, 228, 229, 230, 231, 232, 233, 234, 235, 236, 237, 238, 239, 240, 241, 242, 243, 244, 245, 246, 247, 248, 249, 250, 251, 252, 253]
}

fn rows() -> [str] {
    return [
        "",
        "",
        "",
        "",
        "",
        "",
        "",
        "",
        "",
        "",
        "",
        "",
        "",
        "",
        "",
        "",
        "",
        "",
        "",
        "",
        "",
        "",
        "",
        "",
        "",
        "",
        "",
        "",
        "",
        "",
        "",
        "",
        "",
        "",
        "",
        "",
        "",
        "",
        "",
        "",
        "",
        "",
        "",
        "",
        "",
        "",
        "",
        "",
        "",
        "",
        "",
        "",
        "",
        "",
        "",
        "",
