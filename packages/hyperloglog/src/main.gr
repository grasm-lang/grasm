// HyperLogLog: how many *distinct* things went past, in fixed memory.
//
// Counting distinct values exactly costs memory proportional to the number of
// distinct values — a set of every user ID that visited today is a set of every
// user ID that visited today. HyperLogLog answers the same question from a few
// kilobytes, with a few percent error, and the memory does not grow.
//
// The idea: hash each item, count the leading zeros, keep the maximum. A hash
// with k leading zeros turns up about once every 2^k items, so the largest k
// seen estimates the count. One estimate is wildly noisy, so the hash also
// picks one of many registers and the estimates are averaged harmonically.
//
// **This is an estimate.** Billing, quotas and anything a person will dispute
// need an exact count; this is for dashboards.

type Hll = {
    /// 2^p registers. p=10 gives 1024 registers and about 3% error.
    p: i64,
    register: [i64],
}

pub fn new_hll(p: i64) -> Hll {
    var bits = p
    if bits < 4 {
        bits = 4
    }
    if bits > 16 {
        bits = 16
    }
    var r: [i64] = []
    for _i in 0..(2 ^ bits) {
        r.push(0)
    }
    return Hll{ p: bits, register: r }
}

fn mask32(v: i64) -> i64 {
    return v.bit_and(4294967295)
}

/// FNV-1a, 32 bits. Every product is masked: a release build wraps silently
/// and a debug build checks overflow, so an unmasked hash would work in the
/// build people ship and panic in the build the gates run.
fn hash_of(text: str) -> i64 {
    var h = 2166136261
    let raw = text.to_bytes()
    for i in 0..raw.len() {
        h = mask32(h.bit_xor(raw.at(i)))
        h = mask32(mask32(h.shl(24)) + mask32(h.shl(8)) + mask32(h.shl(7)) +
            mask32(h.shl(4)) + mask32(h.shl(1)) + h)
    }
    return h
}


/// `a * b` modulo 2^32, without overflowing an i64.
///
/// A 32x32 product needs 64 bits and `i64` has 63, so the multiply is split at
/// 16 bits and the halves recombined.
fn mul32(a: i64, b: i64) -> i64 {
    let hi = a / 65536
    let lo = a % 65536
    return mask32((hi * b) % 65536 * 65536 + lo * b)
}

/// Murmur3's finaliser.
///
/// FNV-1a's *high* bits are weak — the last byte barely reaches them — and the
/// bucket index is taken from exactly those bits. Without this avalanche the
/// sketch clustered: 21 empty registers where 8 were expected, and a distinct
/// count 27% low. With it, 7 empty and 1.9% error. Measured, not assumed.
fn avalanche(x: i64) -> i64 {
    var h = x
    h = h.bit_xor(h / 65536)
    h = mul32(h, 2246822507)
    h = h.bit_xor(h / 8192)
    h = mul32(h, 3266489909)
    h = h.bit_xor(h / 65536)
    return mask32(h)
}

/// Leading zeros in the low `bits` of `v`, plus one.
fn rank_of(v: i64, bits: i64) -> i64 {
    var n = 1
    var probe = 2 ^ (bits - 1)
    while probe > 0 and v.bit_and(probe) == 0 {
        n = n + 1
        probe = probe / 2
    }
    return n
}

pub fn observe(inout h: Hll, item: str) {
    let x = avalanche(hash_of(item))
    // The top p bits pick the register; the rest supply the rank.
    let index = x / (2 ^ (32 - h.p))
    let rest = x % (2 ^ (32 - h.p))
    let r = rank_of(rest, 32 - h.p)
    if r > h.register[index] {
        h.register[index] = r
    }
}

fn alpha_thousandths(m: i64) -> i64 {
    if m == 16 {
        return 673
    }
    if m == 32 {
        return 697
    }
    if m == 64 {
        return 709
    }
    // 0.7213 / (1 + 1.079/m), close enough at every size above 64.
    return 7213000 / (10000 + 10790 / m)
}

/// The estimated number of distinct items.
pub fn estimate(h: Hll) -> i64 {
    let m = h.register.len()
    // Harmonic mean of 2^-register, in integer arithmetic: sum of 2^-r scaled.
    var sum_scaled = 0
    var zeros = 0
    for r in h.register {
        if r == 0 {
            zeros = zeros + 1
        }
        // 2^30 / 2^r, so the sum stays an integer with room to spare.
        sum_scaled = sum_scaled + (1073741824 / (2 ^ r))
    }
    if sum_scaled == 0 {
        return 0
    }
    let raw = alpha_thousandths(m) * m * m * 1073741824 / sum_scaled / 1000
    // Small-range correction: with empty registers, linear counting is far
    // more accurate than the raw estimate.
    if raw < m * 5 / 2 and zeros > 0 {
        return linear_count(m, zeros)
    }
    return raw
}

fn linear_count(m: i64, zeros: i64) -> i64 {
    // m * ln(m/zeros), with ln by a series since there is no float log here.
    let ratio_thousandths = m * 1000 / zeros
    return m * ln_thousandths(ratio_thousandths) / 1000
}

/// Natural log of `x/1000`, returned in thousandths.
fn ln_thousandths(x: i64) -> i64 {
    if x <= 1000 {
        return 0
    }
    // ln(v) = 2 * atanh((v-1)/(v+1)), summed as a series.
    let num = (x - 1000) * 1000 / (x + 1000)
    var term = num
    var total = num
    let sq = num * num / 1000000
    var k = 3
    while k < 16 {
        term = term * sq / 1000
        total = total + term / k
        k = k + 2
    }
    return total * 2
}

/// Merge another sketch in. Two counts of the same stream, or two shards of
/// one — this is the property that makes HLL usable across machines.
pub fn merge(inout a: Hll, b: Hll) {
    if a.p != b.p {
        return
    }
    for i in 0..a.register.len() {
        if b.register[i] > a.register[i] {
            a.register[i] = b.register[i]
        }
    }
}

/// Bytes held, so a caller can see what the estimate is buying.
pub fn register_count(h: Hll) -> i64 {
    return h.register.len()
}
