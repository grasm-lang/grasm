import gitindex
import gitattributes
import mailmap

fn from_hex(text: str) -> bytes {
    var out: [i64] = []
    var i = 1
    while i + 1 < text.len() {
        out.push(text.substr(i, 2).parse_int_base(16) ?? 0)
        i = i + 2
    }
    return bytes_of(out)
}

fn to_hex(text: str) -> str {
    let digits = "0123456789abcdef"
    let raw = text.to_bytes()
    var out = ""
    var i = 0
    while i < raw.len() {
        out = out + digits.substr(raw.at(i) / 16, 1) +
        digits.substr(raw.at(i) % 16, 1)
        i = i + 1
    }
    return out
}

fn main() / {io} {
    var i = 0
    while i + 1 < args().len() {
        let what = args()[i]
        if what == "attr" {
            // `attr <file text> <path> <attribute name>`
            let file = gitattributes.parse(from_hex(args()[i + 1]).to_str())
            print(to_hex(gitattributes.attribute_for(file,
                from_hex(args()[i + 2]).to_str(), false,
                from_hex(args()[i + 3]).to_str())))
            i = i + 4
            continue
        }
        if what == "mailmap" {
            let map = mailmap.parse(from_hex(args()[i + 1]).to_str())
            print(to_hex(mailmap.resolve_line(map,
                from_hex(args()[i + 2]).to_str())))
            i = i + 3
            continue
        }
        let raw = from_hex(args()[i + 1])
        if what == "checksum" {
            if gitindex.checksum_holds(raw) {
                print("yes")
            } else {
                print("no")
            }
            i = i + 2
            continue
        }
        match gitindex.decode(raw) {
            Err(_e) -> print("?refused?")
            Ok(index) -> {
                if what == "stage" {
                    print(to_hex(gitindex.render_stage_quoted(index)
                            .join("\n")))
                } else if what == "stageraw" {
                    print(to_hex(gitindex.render_stage(index).join("\n")))
                } else if what == "version" {
                    print(index.version.to_str())
                } else if what == "extensions" {
                    print(index.extensions.join(","))
                } else if what == "conflicted" {
                    print(to_hex(gitindex.conflicted(index).join("\n")))
                } else {
                    print(gitindex.path_count(index).to_str())
                }
            }
        }
        i = i + 2
    }
}
