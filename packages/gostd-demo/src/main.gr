// Eight packages from Go's standard library, each asserted against an
// answer Go gave. `scripts/gostd_diff.sh` holds them to Go case for case;
// this is the short version that every engine runs.
import fnv
import rc4
import des
import goquote
import gotimefmt
import tabwriter
import textproto
import suffixarray

fn hex(raw: bytes) -> str {
    let digits = "0123456789abcdef"
    var out = ""
    var i = 0
    while i < raw.len() {
        out = out + digits.substr(raw.at(i) / 16, 1) + digits.substr(raw.at(i) % 16, 1)
        i = i + 1
    }
    out
}

fn unhex(text: str) -> bytes {
    var out: [i64] = []
    var i = 0
    while i + 1 < text.len() {
        out.push(text.substr(i, 2).parse_int_base(16) ?? 0)
        i = i + 2
    }
    bytes_of(out)
}

fn main() / {io} {
    let hello = "hello".to_bytes()
    assert_eq(hex(fnv.to_bytes(fnv.fnv64a(hello), 64)), "a430d84680aabd0b")
    assert_eq(hex(fnv.to_bytes(fnv.fnv32a(hello), 32)), "4f9f2cab")
    assert_eq(hex(fnv.fnv128a(hello)), "e3e1efd54283d94f7081314b599d31b3")

    // RFC 6229's first key, sixteen bytes of keystream.
    match rc4.apply(unhex("0102030405"), bytes_filled(16, 0)) {
        Ok(ks) -> assert_eq(hex(ks), "b2396305f03dc027ccc3524a0a1118a8")
        Err(_) -> panic("rc4 refused a five-byte key")
    }

    // The worked example every DES text uses.
    match des.new_cipher(unhex("133457799bbcdff1")) {
        Ok(c) -> {
            let out = des.encrypt_ecb(c, unhex("0123456789abcdef")) ?? bytes_of([])
            assert_eq(hex(out), "85e813540f0ab405")
            let back = des.decrypt_ecb(c, out) ?? bytes_of([])
            assert_eq(hex(back), "0123456789abcdef")
        }
        Err(_) -> panic("des refused an eight-byte key")
    }

    let awkward = "tab\té\\x00".to_bytes().concat(bytes_of([255]))
    let q = goquote.quote(awkward)
    assert_eq(q, "\"tab\\té\\\\x00\\xff\"")
    match goquote.unquote(q.to_bytes()) {
        Ok(v) -> assert_eq(hex(v), hex(awkward))
        Err(_) -> panic("goquote could not read back what it wrote")
    }

    let t = gotimefmt.new_time(1709634000, 123456789, 19800, "IST")
    assert_eq(gotimefmt.format(t, "2006-01-02T15:04:05.000Z07:00 Mon"),
        "2024-03-05T15:50:00.123+05:30 Tue")
    match gotimefmt.parse("Jan _2 15:04:05 MST 2006", "Mar  5 10:20:30 PDT 2024") {
        Ok(p) -> {
            assert_eq(p.unix, 1709634030)
            assert_eq(p.zone, "PDT")
        }
        Err(_) -> panic("gotimefmt could not parse a Stamp")
    }

    let table = tabwriter.format(tabwriter.config(0, 8, 1, 32, 0),
        "a\tbbb\tc\naaaa\tb\tc\n".to_bytes())
    assert_eq(table.to_str(), "a    bbb c\naaaa b   c\n")

    let mail = "content-TYPE: text/plain\r\nX-Note: one\r\n  two\r\n\r\nbody".to_bytes()
    match textproto.read_header(mail, 0) {
        Ok(got) -> {
            assert_eq(textproto.get(got.0, "Content-Type") ?? "", "text/plain")
            assert_eq(textproto.get(got.0, "x-note") ?? "", "one two")
            assert_eq(mail.slice(got.1, mail.len()).to_str(), "body")
        }
        Err(_) -> panic("textproto refused a well-formed header")
    }
    assert_eq(textproto.dot_encode(".a\nb".to_bytes()).to_str(), "..a\r\nb\r\n.\r\n")

    let idx = suffixarray.new_index("banana".to_bytes())
    assert_eq(idx.sa, [5, 3, 1, 0, 4, 2])
    assert_eq(suffixarray.count(idx, "ana".to_bytes()), 2)
    assert_eq(suffixarray.longest_repeat("banana".to_bytes()), (1, 3))
    print("gostd: ok")
}
