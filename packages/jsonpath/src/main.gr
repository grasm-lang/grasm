// A path selector over hierarchical data: `$.users[0].name`.
//
// This works on a **flat address model** rather than on a parsed JSON value:
// a caller supplies paths and values as parallel lists, and this decides which
// paths a selector matches. That keeps the package free of any dependency on a
// particular JSON representation — it selects over anything addressable, which
// includes a config tree, a form submission and a flattened document.
//
// The wildcard rules are the ones worth stating. `*` matches exactly one
// segment; `..` matches any depth, which is the difference between
// `$.a.*.name` and `$.a..name`.

type Selector = {
    segment: [str],
}

type PathError = | BadSelector(text: str)

/// `$.users[0].name` into segments: users, 0, name.
pub fn parse(text: str) -> Selector ! PathError {
    var t = text.trim()
    if t.starts_with("$") {
        t = t.substr(1, t.len() - 1)
    }
    var out: [str] = []
    var current = ""
    var i = 0
    let cs = t.chars()
    while i < cs.len() {
        let c = cs[i]
        if c == "." {
            if current != "" {
                out.push(current)
                current = ""
            }
            // `..` is the any-depth marker and is kept as its own segment.
            if i + 1 < cs.len() and cs[i + 1] == "." {
                out.push("..")
                i = i + 1
            }
        } else {
            if c == "[" {
                if current != "" {
                    out.push(current)
                    current = ""
                }
                var index = ""
                i = i + 1
                while i < cs.len() and cs[i] != "]" {
                    if cs[i] != "'" and cs[i] != "\"" {
                        index = index + cs[i]
                    }
                    i = i + 1
                }
                if i >= cs.len() {
                    fail(BadSelector(text))
                }
                out.push(index)
            } else {
                current = current + c
            }
        }
        i = i + 1
    }
    if current != "" {
        out.push(current)
    }
    return Selector{ segment: out }
}

fn split_path(path: str) -> [str] {
    var out: [str] = []
    for p in path.split(".") {
        if p != "" {
            out.push(p)
        }
    }
    return out
}

/// Whether a concrete path matches the selector.
pub fn matches(s: Selector, path: str) -> bool {
    return walk(s.segment, 0, split_path(path), 0)
}

fn walk(sel: [str], si: i64, path: [str], pi: i64) -> bool {
    if si >= sel.len() {
        return pi >= path.len()
    }
    let seg = sel[si]
    if seg == ".." {
        // Any depth: try consuming zero or more path segments.
        var k = pi
        while k <= path.len() {
            if walk(sel, si + 1, path, k) {
                return true
            }
            k = k + 1
        }
        return false
    }
    if pi >= path.len() {
        return false
    }
    if seg == "*" or seg == path[pi] {
        return walk(sel, si + 1, path, pi + 1)
    }
    return false
}

/// Every value whose path matches, in order.
pub fn select(selector: str, paths: [str], values: [str]) -> [str] {
    var out: [str] = []
    match parse(selector) {
        Err(_e) -> return out
        Ok(s) -> {
            for i in 0..paths.len() {
                if matches(s, paths[i]) and i < values.len() {
                    out.push(values[i])
                }
            }
            return out
        }
    }
}

/// The first match, which is what a config lookup wants.
pub fn select_one(selector: str, paths: [str], values: [str]) -> Option[str] {
    let hits = select(selector, paths, values)
    if hits.len() == 0 {
        return None
    }
    return Some(hits[0])
}

/// The paths that matched rather than their values.
pub fn select_paths(selector: str, paths: [str]) -> [str] {
    var out: [str] = []
    match parse(selector) {
        Err(_e) -> return out
        Ok(s) -> {
            for p in paths {
                if matches(s, p) {
                    out.push(p)
                }
            }
            return out
        }
    }
}
