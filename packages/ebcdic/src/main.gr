        "011F004A004B004C004D004E004F00500051005200B900FB005C00F900FA00FF" +
        "00FC00F70053005400550056005700580059005A00B200D4002300D200D300D5" +
        "003000310032003300340035003600370038003900B300DB002200D900DA009F"
    }
    if page == "cp1140" {
        return "0000000100020003009C00090086007F0097008D008E000B000C000D000E000F" +
        "0010001100120013009D008500080087001800190092008F001C001D001E001F" +
        "00800081008200830084000A0017001B00880089008A008B008C000500060007" +
        "0090009100160093009400950096000400980099009A009B00140015009E001A" +
        "002000A000E200E400E000E100E300E500E700F100A2002E003C0028002B007C" +
        "002600E900EA00EB00E800ED00EE00EF00EC00DF00210024002A0029003B00AC" +
        "002D002F00C200C400C000C100C300C500C700D100A6002C0025005F003E003F" +
        "00F800C900CA00CB00C800CD00CE00CF00CC0060003A002300400027003D0022" +
        "00D800610062006300640065006600670068006900AB00BB00F000FD00FE00B1" +
        "00B0006A006B006C006D006E006F00700071007200AA00BA00E600B800C620AC" +
        "00B5007E0073007400750076007700780079007A00A100BF00D000DD00DE00AE" +
        "005E00A300A500B700A900A700B600BC00BD00BE005B005D00AF00A800B400D7" +
        "007B00410042004300440045004600470048004900AD00F400F600F200F300F5" +
        "007D004A004B004C004D004E004F00500051005200B900FB00FC00F900FA00FF" +
        "005C00F70053005400550056005700580059005A00B200D400D600D200D300D5" +
        "003000310032003300340035003600370038003900B300DB00DC00D900DA009F"
    }
    return ""
}

fn code_at(table: str, byte: i64) -> i64 {
    return table.substr(byte * 4, 4).parse_int_base(16) ?? 0
}

/// Whether a page name is one this carries.
pub fn has_page(page: str) -> bool {
    return table_of(page.to_lower()).len() == 1024
}

/// Bytes to text in a page. Every byte is a character, so this cannot fail
/// on the data — only on a page it does not know.
pub fn decode(data: bytes, page: str) -> str ! EbcdicError {
    let table = table_of(page.to_lower())
    if table.len() != 1024 {
        fail(EbcdicUnknownPage(page))
    }
    var out = ""
    var i = 0
    while i < data.len() {
        out = out + code_at(table, data.at(i)).to_char()
        i = i + 1
    }
    return out
}

/// A reverse table for a page, built once.
fn reverse(table: str) -> Map[i64, i64] {
    var out: Map[i64, i64] = {}
    var b = 0
    while b < 256 {
        let code = code_at(table, b)
        if not out.has(code) {
            out.set(code, b)
        }
        b = b + 1
    }
    return out
}

/// Text to bytes in a page.
pub fn encode(text: str, page: str) -> bytes ! EbcdicError {
    let table = table_of(page.to_lower())
    if table.len() != 1024 {
        fail(EbcdicUnknownPage(page))
    }
    let back = reverse(table)
    var out: [i64] = []
    var at = 0
    for code in text.codes() {
        match back.get(code) {
            Some(b) -> out.push(b)
            None -> fail(EbcdicUnencodable(at, code))
        }
        at = at + 1
    }
    return bytes_of(out)
}

/// Whether every character in `text` exists in a page.
pub fn is_encodable(text: str, page: str) -> bool {
    match encode(text, page) {
        Ok(_data) -> return true
        Err(_e) -> return false
    }
}

/// A record file split into records on EBCDIC's own newline, 0x15, and each
/// record decoded.
///
/// Not on 0x25, which is EBCDIC's line feed and which the files do not use,
/// and not on `\n` after decoding, which NEL does not become.
pub fn records(data: bytes, page: str) -> [str] ! EbcdicError {
    var out: [str] = []
    var current: [i64] = []
    var i = 0
    while i < data.len() {
        let b = data.at(i)
        if b == 21 {
            out.push(try decode(bytes_of(current), page))
            current = []
        } else {
            current.push(b)
        }
        i = i + 1
    }
    if current.len() > 0 {
        out.push(try decode(bytes_of(current), page))
    }
    return out
}

/// Fixed-width records, which is the other way mainframe files are laid
/// out: no separators at all, every record the same number of bytes.
pub fn fixed_records(data: bytes, width: i64,
    page: str) -> [str] ! EbcdicError {
    var out: [str] = []
    if width <= 0 {
        return out
    }
    var at = 0
    while at < data.len() {
        var chunk: [i64] = []
        var i = 0
        while i < width and at + i < data.len() {
            chunk.push(data.at(at + i))
            i = i + 1
        }
        out.push(try decode(bytes_of(chunk), page))
        at = at + width
    }
    return out
}
