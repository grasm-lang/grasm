// EBCDIC: the character encoding mainframes still write.
//
// Banks, insurers, airlines and governments run IBM mainframes, and the
// data those machines produce — fixed-width record files, COBOL copybooks,
// print streams, batch exports that arrive nightly over SFTP — is EBCDIC,
// not ASCII. It is a different encoding from the ground up, not a variant:
// the letters are not even contiguous (`I` is 0xC9 and `J` is 0xD1), digits
// sort after letters, and a program that reads it as Latin-1 produces
// rubbish that does not look like rubbish until somebody checks a name.
//
// There is no single EBCDIC. Each country's code page moves the punctuation
// and the national letters to different bytes, so `[` is 0xBA in one and
// 0x4A in another, and the same file read with the wrong page swaps
// brackets for letters. This package carries five of them, named the way
// Python and IBM name them:
//
//   `cp037`  US, Canada and much of the English-speaking mainframe world
//   `cp273`  Germany and Austria
//   `cp500`  the international page, and the common interchange one
//   `cp1026`  Turkey
//   `cp1140`  cp037 with the euro sign where the currency sign was
//
// One byte deserves a sentence. EBCDIC has its own newline, 0x15 (NEL),
// which decodes to U+0085 rather than to `\n`. A record file split on 0x25
// (LF) finds nothing, and one converted to text and then split on `\n` finds
// nothing either. `records` below splits on NEL because that is what the
// files use.
//
// The tables come from Python's own codecs, byte by byte, rather than from
// a mapping file typed out, and the gate checks all 256 bytes of every page
// in both directions.

type EbcdicError =
    | EbcdicUnknownPage(name: str)
    | EbcdicUnencodable(at: i64, codepoint: i64)

    /// The code page names this package carries.
pub fn pages() -> [str] {
    return ["cp037", "cp273", "cp500", "cp1026", "cp1140"]
}

/// 256 code points, four hexadecimal digits each, for a page.
fn table_of(page: str) -> str {
    if page == "cp037" {
        return "0000000100020003009C00090086007F0097008D008E000B000C000D000E000F" +
        "0010001100120013009D008500080087001800190092008F001C001D001E001F" +
        "00800081008200830084000A0017001B00880089008A008B008C000500060007" +
        "0090009100160093009400950096000400980099009A009B00140015009E001A" +
        "002000A000E200E400E000E100E300E500E700F100A2002E003C0028002B007C" +
        "002600E900EA00EB00E800ED00EE00EF00EC00DF00210024002A0029003B00AC" +
        "002D002F00C200C400C000C100C300C500C700D100A6002C0025005F003E003F" +
        "00F800C900CA00CB00C800CD00CE00CF00CC0060003A002300400027003D0022" +
        "00D800610062006300640065006600670068006900AB00BB00F000FD00FE00B1" +
        "00B0006A006B006C006D006E006F00700071007200AA00BA00E600B800C600A4" +
        "00B5007E0073007400750076007700780079007A00A100BF00D000DD00DE00AE" +
        "005E00A300A500B700A900A700B600BC00BD00BE005B005D00AF00A800B400D7" +
        "007B00410042004300440045004600470048004900AD00F400F600F200F300F5" +
        "007D004A004B004C004D004E004F00500051005200B900FB00FC00F900FA00FF" +
        "005C00F70053005400550056005700580059005A00B200D400D600D200D300D5" +
        "003000310032003300340035003600370038003900B300DB00DC00D900DA009F"
    }
    if page == "cp273" {
        return "0000000100020003009C00090086007F0097008D008E000B000C000D000E000F" +
        "0010001100120013009D008500080087001800190092008F001C001D001E001F" +
        "00800081008200830084000A0017001B00880089008A008B008C000500060007" +
        "0090009100160093009400950096000400980099009A009B00140015009E001A" +
        "002000A000E2007B00E000E100E300E500E700F100C4002E003C0028002B0021" +
        "002600E900EA00EB00E800ED00EE00EF00EC007E00DC0024002A0029003B005E" +
        "002D002F00C2005B00C000C100C300C500C700D100F6002C0025005F003E003F" +
        "00F800C900CA00CB00C800CD00CE00CF00CC0060003A002300A70027003D0022" +
        "00D800610062006300640065006600670068006900AB00BB00F000FD00FE00B1" +
        "00B0006A006B006C006D006E006F00700071007200AA00BA00E600B800C600A4" +
        "00B500DF0073007400750076007700780079007A00A100BF00D000DD00DE00AE" +
        "00A200A300A500B700A9004000B600BC00BD00BE00AC007C203E00A800B400D7" +
        "00E400410042004300440045004600470048004900AD00F400A600F200F300F5" +
        "00FC004A004B004C004D004E004F00500051005200B900FB007D00F900FA00FF" +
        "00D600F70053005400550056005700580059005A00B200D4005C00D200D300D5" +
        "003000310032003300340035003600370038003900B300DB005D00D900DA009F"
    }
    if page == "cp500" {
        return "0000000100020003009C00090086007F0097008D008E000B000C000D000E000F" +
        "0010001100120013009D008500080087001800190092008F001C001D001E001F" +
        "00800081008200830084000A0017001B00880089008A008B008C000500060007" +
        "0090009100160093009400950096000400980099009A009B00140015009E001A" +
        "002000A000E200E400E000E100E300E500E700F1005B002E003C0028002B0021" +
        "002600E900EA00EB00E800ED00EE00EF00EC00DF005D0024002A0029003B005E" +
        "002D002F00C200C400C000C100C300C500C700D100A6002C0025005F003E003F" +
        "00F800C900CA00CB00C800CD00CE00CF00CC0060003A002300400027003D0022" +
        "00D800610062006300640065006600670068006900AB00BB00F000FD00FE00B1" +
        "00B0006A006B006C006D006E006F00700071007200AA00BA00E600B800C600A4" +
        "00B5007E0073007400750076007700780079007A00A100BF00D000DD00DE00AE" +
        "00A200A300A500B700A900A700B600BC00BD00BE00AC007C00AF00A800B400D7" +
        "007B00410042004300440045004600470048004900AD00F400F600F200F300F5" +
