// Hex and base64.
//
// Encoding is the easy half and is not where the defects are. Decoding is:
// input somebody else chose, which may be truncated, may carry a character
// that is not in the alphabet, may be padded wrongly, or may not be padded at
// all. Every decoder here answers `Option` and none of them panics — a bad
// encoding is an ordinary thing to be handed, not a bug in the program that
// was handed it.
//
// The invariant worth stating: `decode(encode(b)) == b` for every byte
// sequence, and `decode` of anything `encode` cannot produce is `None`. Those
// two together are what stops a decoder from quietly accepting garbage.

let HEX_LOWER = "0123456789abcdef"
let B64 = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
let B64URL = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_"

// --- hex -------------------------------------------------------------------

pub fn encode_hex(b: bytes) -> str {
    let digits = HEX_LOWER.chars()
    var out = ""
    for v in b.to_list() {
        out = out + digits[v / 16] + digits[v % 16]
    }
    out
}

pub fn encode_hex_upper(b: bytes) -> str {
    encode_hex(b).to_upper()
}

fn hex_digit(c: str) -> i64 {
    match c.to_lower().parse_int_base(16) {
        Some(v) -> v
        None -> -1
    }
}

/// Hex back to bytes. `None` for an odd number of digits, or any character
/// that is not one — including whitespace, which is not skipped: a decoder
/// that skips what it does not understand accepts inputs no encoder produced.
pub fn decode_hex(s: str) -> Option[bytes] {
    let cs = s.chars()
    if cs.len() % 2 != 0 {
        return None
    }
    var out: [i64] = []
    var i = 0
    while i < cs.len() {
        let hi = hex_digit(cs[i])
        let lo = hex_digit(cs[i + 1])
        if hi < 0 or lo < 0 {
            return None
        }
        out.push(hi * 16 + lo)
        i = i + 2
    }
    Some(bytes_of(out))
}

// --- base64 ----------------------------------------------------------------

fn encode_with(b: bytes, alphabet: str, pad: bool) -> str {
    let digits = alphabet.chars()
    let vs = b.to_list()
    var out = ""
    var i = 0
    while i + 2 < vs.len() {
        let n = vs[i] * 65536 + vs[i + 1] * 256 + vs[i + 2]
        out = out + digits[n / 262144] + digits[(n / 4096) % 64] +
        digits[(n / 64) % 64] + digits[n % 64]
        i = i + 3
    }
    let left = vs.len() - i
    if left == 1 {
        let n = vs[i] * 16
        out = out + digits[n / 64] + digits[n % 64]
        if pad {
            out = out + "=="
        }
    } else if left == 2 {
        let n = vs[i] * 1024 + vs[i + 1] * 4
        out = out + digits[n / 4096] + digits[(n / 64) % 64] + digits[n % 64]
        if pad {
            out = out + "="
        }
    }
    out
}

pub fn encode_base64(b: bytes) -> str {
    encode_with(b, B64, true)
}

/// The url-safe alphabet, unpadded — which is what a URL, a JWT and a file
/// name all want, and `=` is what none of them want.
pub fn encode_base64_url(b: bytes) -> str {
    encode_with(b, B64URL, false)
}

fn value_of(c: str, alphabet: str) -> i64 {
    match alphabet.index_of(c) {
        Some(i) -> i
        None -> -1
    }
}

fn decode_with(s: str, alphabet: str) -> Option[bytes] {
    var text = s
    // Padding is optional on the way in and is checked rather than trimmed
    // blindly: `=` may only be the last one or two characters, and only where
    // the length calls for it.
    var pad = 0
    while text.ends_with("=") {
        pad = pad + 1
        text = text.substr(0, text.len() - 1)
    }
    if pad > 2 {
        return None
    }
    let cs = text.chars()
    if cs.len() % 4 == 1 {
        return None
    }
    if pad > 0 and (cs.len() + pad) % 4 != 0 {
        return None
    }
    var out: [i64] = []
    var acc = 0
    var bits = 0
    for c in cs {
        let v = value_of(c, alphabet)
        if v < 0 {
            return None
        }
        acc = acc * 64 + v
        bits = bits + 6
        if bits >= 8 {
            bits = bits - 8
            out.push(acc / (2 ^ bits))
            // Kept to the bits that have not been delivered. Letting the
            // accumulator carry every group seen so far overflows an `i64`
            // after ten characters and the arithmetic goes negative — which
            // `bytes_of` catches with a panic, and which a shorter test would
            // never have reached.
            acc = acc % (2 ^ bits)
        }
    }
    // The bits left over must be zero. A trailing group that carries bits it
    // cannot deliver is an encoding no encoder produced, and accepting it
    // makes two different texts decode to the same bytes.
    if bits > 0 and acc % (2 ^ bits) != 0 {
        return None
    }
    Some(bytes_of(out))
}

pub fn decode_base64(s: str) -> Option[bytes] {
    decode_with(s, B64)
}

pub fn decode_base64_url(s: str) -> Option[bytes] {
    decode_with(s, B64URL)
}

/// Base64 the way Go's `base64.StdEncoding` reads it, for formats whose
/// reference reader is Go (signed notes, checksum-database tree heads):
/// padding is required, carriage returns and line feeds anywhere are
/// skipped, and the unused bits of the last group are ignored rather than
/// refused. Prefer `decode_base64` anywhere a format does not say this.
pub fn decode_base64_go(s: str) -> Option[bytes] {
    let text = s.replace("\r", "").replace("\n", "")
    if text.len() % 4 != 0 {
        return None
    }
    var pad = 0
    while pad < text.len() and text.substr(text.len() - 1 - pad, 1) == "=" {
        pad = pad + 1
    }
    if pad == 0 or pad > 2 {
        return decode_with(text, B64)
    }
    // Clear the bits the padding says are unused, then decode strictly.
    let at = text.len() - 1 - pad
    let v = value_of(text.substr(at, 1), B64)
    if v < 0 {
        return None
    }
    let unused = if pad == 1 { 4 } else { 16 }
    let fixed = text.substr(0, at) + B64.substr(v - v % unused, 1) + text.substr(at + 1, pad)
    decode_with(fixed, B64)
}

// --- comparing -------------------------------------------------------------

/// Equal or not, in time that does not depend on where they differ.
///
/// `a == b` on bytes stops at the first difference, which tells whoever is
/// timing it how much of a secret they have guessed. This does not stop, and
/// is the comparison to use on anything that is checked rather than read.
pub fn equal_constant_time(a: bytes, b: bytes) -> bool {
    if a.len() != b.len() {
        return false
    }
    var diff = 0
    for i in 0..a.len() {
        diff = diff.bit_or(a.at(i).bit_xor(b.at(i)))
    }
    diff == 0
}
