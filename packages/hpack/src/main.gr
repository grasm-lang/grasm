        32765, 3, 35, 4, 36, 5, 37, 38, 39, 6, 116, 117,
        40, 41, 42, 7, 43, 118, 44, 8, 9, 45, 119, 120,
        121, 122, 123, 32766, 2044, 16381, 8189, 268435452, 1048550, 4194258, 1048551, 1048552,
