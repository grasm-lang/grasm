}

/// The first code of each length, indexed by length minus one.
fn huffman_first_code() -> [i64] {
    return [
        0, 0, 0, 0, 0, 20, 92, 248, 0, 1016, 2042, 4090,
        8184, 16380, 32764, 0, 0, 0, 524272, 1048550, 2097116, 4194258, 8388568, 16777194,
        33554412, 67108832, 134217694, 268435426, 0, 1073741820]
}

/// Where that length's symbols start in `huffman_symbols`.
fn huffman_first_index() -> [i64] {
    return [
        0, 0, 0, 0, 0, 10, 36, 68, 0, 74, 79, 82,
        84, 90, 92, 0, 0, 0, 95, 98, 106, 119, 145, 174,
        186, 190, 205, 224, 0, 253]
}

/// How many symbols share each length.
fn huffman_count() -> [i64] {
    return [
        0, 0, 0, 0, 10, 26, 32, 6, 0, 5, 3, 2,
        6, 2, 3, 0, 0, 0, 3, 8, 13, 26, 29, 12,
        4, 15, 19, 29, 0, 4]
}

/// A Huffman-coded string decoded.
///
/// The padding rule is the security-relevant part: what follows the last
/// symbol must be fewer than eight bits and must be the prefix of the EOS
/// code, which is all ones. A decoder that accepts anything else accepts
/// two encodings of the same header, and a proxy pair that disagrees about
/// which is which is a request smuggling primitive.
fn huffman_decode(raw: bytes) -> str ! HpackError {
    let symbols = huffman_symbols()
    let first_code = huffman_first_code()
    let first_index = huffman_first_index()
    let counts = huffman_count()
    var out: [i64] = []
    var acc = 0
    var width = 0
    var i = 0
    while i < raw.len() {
        let byte = raw.at(i)
        var bit = 7
        while bit >= 0 {
            acc = acc * 2 + byte.ushr(bit).bit_and(1)
            width = width + 1
            if width > 30 {
                fail(BadHuffman(i))
            }
            let count = counts[width - 1]
            if count > 0 {
                let offset = acc - first_code[width - 1]
                if offset >= 0 and offset < count {
                    let symbol = symbols[first_index[width - 1] + offset]
                    if symbol == 256 {
                        // An explicit EOS in the middle of a string is a
                        // compression error, not an end marker.
                        fail(BadHuffman(i))
                    }
                    out.push(symbol)
                    acc = 0
                    width = 0
                }
            }
            bit = bit - 1
        }
        i = i + 1
    }
    if width >= 8 {
        fail(BadHuffman(raw.len()))
    }
    var ones = 1
    var j = 0
    while j < width {
        ones = ones * 2
        j = j + 1
    }
    if width > 0 and acc != ones - 1 {
        fail(BadHuffman(raw.len()))
    }
    // Built as octets and turned into text at the end, the same way the
    // uncoded path does it: a header value is a sequence of bytes, and
    // building the string a codepoint at a time turns every byte above 127
    // into a different value.
    return bytes_of(out).to_str()
}

/// Some octets Huffman-coded, and whether it was worth sending that way.
///
/// Octets rather than text, because an HPACK string is a byte sequence: a
/// value carrying a byte above 127 is not text in any encoding, and taking
/// a `str` here would silently re-encode it as two bytes of UTF-8.
///
/// An encoder is never required to use Huffman, and for bytes that are all
/// long codes it is longer than the original — so the answer carries
/// whether it shrank, and a caller that ignores that sends more bytes than
/// it had to.
pub fn huffman_encode(octets: bytes) -> (bytes, bool) {
    let codes = huffman_codes()
    let lengths = huffman_lengths()
    var out: [i64] = []
    var acc = 0
    var width = 0
    var i = 0
    while i < octets.len() {
        let symbol = octets.at(i)
        var bits = lengths[symbol]
        let code = codes[symbol]
        while bits > 0 {
            bits = bits - 1
            acc = acc * 2 + code.ushr(bits).bit_and(1)
            width = width + 1
            if width == 8 {
                out.push(acc)
                acc = 0
                width = 0
            }
        }
        i = i + 1
    }
    if width > 0 {
        // The padding is the EOS prefix, which is all ones.
        while width < 8 {
            acc = acc * 2 + 1
            width = width + 1
        }
        out.push(acc)
    }
    return (bytes_of(out), out.len() < octets.len())
}
