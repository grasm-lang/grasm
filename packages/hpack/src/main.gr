// HPACK: how HTTP/2 stops sending the same headers on every request.
//
// A browser sends `user-agent`, `accept`, `cookie` on every request, and in
// HTTP/1 that is a kilobyte of identical text each time. HPACK replaces them
// with **indices into a table both ends maintain**, so the second request
// costs a byte per header.
//
// That shared table is the whole design and the whole danger. It is mutable
// state on a connection, so encoder and decoder must agree exactly — a
// decoder that inserts one entry the encoder did not will mis-decode every
// header after it, not just the one, and there is no checksum to notice.
//
// **And it is where CRIME and BREACH live.** If a header's compressed size
// depends on whether it matches a previous one, an attacker who can make a
// request with a guessed prefix can learn whether the guess was right from the
// length. HPACK's answer is the "never indexed" form, which is why a decoder
// has to preserve that distinction rather than treating it as a hint.
//
//     0b1xxxxxxx  indexed: this header is entry N, whole
//     0b01xxxxxx  literal, and add it to the table
//     0b0000xxxx  literal, do not add it
//     0b0001xxxx  literal, never add it and never let a proxy either
//     0b001xxxxx  a new maximum table size

type HeaderPair = {
    name: str,
    value: str,
}

type HpackError =
    | Truncated(at: i64)
    | BadIndex(index: i64)
    | BadHuffman(at: i64)
    | TableTooLarge(size: i64)
    | Overlong(length: i64)

    /// The static table, RFC 7541 appendix A. Sixty-one entries every connection
    /// starts with, so the commonest headers cost one byte before anything has
    /// been sent at all.
pub fn static_table() -> [HeaderPair] {
    [pair(":authority", ""), pair(":method", "GET"), pair(":method", "POST"),
        pair(":path", "/"), pair(":path", "/index.html"),
        pair(":scheme", "http"), pair(":scheme", "https"),
        pair(":status", "200"), pair(":status", "204"), pair(":status", "206"),
        pair(":status", "304"), pair(":status", "400"), pair(":status", "404"),
        pair(":status", "500"), pair("accept-charset", ""),
        pair("accept-encoding", "gzip, deflate"), pair("accept-language", ""),
        pair("accept-ranges", ""), pair("accept", ""),
        pair("access-control-allow-origin", ""), pair("age", ""), pair("allow", ""),
        pair("authorization", ""), pair("cache-control", ""),
        pair("content-disposition", ""), pair("content-encoding", ""),
        pair("content-language", ""), pair("content-length", ""),
        pair("content-location", ""), pair("content-range", ""),
        pair("content-type", ""), pair("cookie", ""), pair("date", ""),
        pair("etag", ""), pair("expect", ""), pair("expires", ""), pair("from", ""),
        pair("host", ""), pair("if-match", ""), pair("if-modified-since", ""),
        pair("if-none-match", ""), pair("if-range", ""),
        pair("if-unmodified-since", ""), pair("last-modified", ""), pair("link", ""),
        pair("location", ""), pair("max-forwards", ""),
        pair("proxy-authenticate", ""), pair("proxy-authorization", ""),
        pair("range", ""), pair("referer", ""), pair("refresh", ""),
        pair("retry-after", ""), pair("server", ""), pair("set-cookie", ""),
        pair("strict-transport-security", ""), pair("transfer-encoding", ""),
        pair("user-agent", ""), pair("vary", ""), pair("via", ""),
        pair("www-authenticate", "")]
}

pub fn pair(name: str, value: str) -> HeaderPair {
    HeaderPair{ name: name, value: value }
}

/// The dynamic half: what this connection has sent, newest first.
// Named `HeaderTable` rather than `Table`, because types share one namespace
// across a program ([T-MODULE-NS]) and `sstable` declares a `Table`.
type HeaderTable = {
    entries: [HeaderPair],
    size: i64,
    capacity: i64,
}

pub fn new_table(capacity: i64) -> HeaderTable {
    var e: [HeaderPair] = []
    HeaderTable{ entries: e, size: 0, capacity: capacity }
}

/// An entry costs its two strings plus thirty-two bytes.
///
/// The thirty-two is not a guess about memory: it is in the specification, so
/// both ends compute the same size and evict at the same moment. An
/// implementation that used its real memory cost would evict at a different
/// time from its peer and every later index would be wrong.
fn entry_size(h: HeaderPair) -> i64 {
    h.name.byte_len() + h.value.byte_len() + 32
}

fn evict(inout t: HeaderTable) {
    // Written the obvious way again. It could not be, for a while: `pop()` in
    // a loop body leaked what it discarded, because a loop body is a block in
    // statement position and its last expression was handed to nobody and
    // released by nobody (F92). Fixed in the backend, so this reads as it
    // should.
    while t.size > t.capacity and t.entries.len() > 0 {
        t.size = t.size - entry_size(t.entries[t.entries.len() - 1])
        t.entries.pop()
    }
}

pub fn insert(inout t: HeaderTable, h: HeaderPair) {
    let cost = entry_size(h)
    if cost > t.capacity {
        // An entry larger than the whole table empties it and is not stored,
        // which is the specification's rule and not an error.
        var none: [HeaderPair] = []
        t.entries = none
        t.size = 0
        return
    }
    var next: [HeaderPair] = [h]
    for e in t.entries {
        next.push(e)
    }
    t.entries = next
    t.size = t.size + cost
    evict(t)
}

pub fn set_capacity(inout t: HeaderTable, capacity: i64) {
    t.capacity = capacity
    evict(t)
}

/// Entry `i`, counting the static table first.
///
/// Indices are one-based, which is a trap: index 0 is not an entry and must be
/// refused rather than read as the first one.
pub fn entry_at(t: HeaderTable, index: i64) -> Option[HeaderPair] {
    if index < 1 {
        return None
    }
    let statics = static_table()
    if index <= statics.len() {
        return Some(statics[index - 1])
    }
    let dynamic = index - statics.len() - 1
    if dynamic < t.entries.len() {
        return Some(t.entries[dynamic])
    }
    None
}

/// An integer in HPACK's prefix encoding.
///
/// The first `prefix` bits live in the byte already being read, and the rest
/// follow seven bits at a time. Bounded, because a run of continuation bytes
/// is a thing a crafted stream contains.
fn read_integer(data: bytes, at: i64, prefix: i64) -> (i64, i64) ! HpackError {
    if at >= data.len() {
        fail(Truncated(at))
    }
    let mask = 1.shl(prefix) - 1
    var value = data.at(at).bit_and(mask)
    var i = at + 1
    if value < mask {
        return (value, i)
    }
    var shift = 0
    var width = 0
    var going = true
    while going {
        if i >= data.len() {
            fail(Truncated(i))
        }
        if width >= 8 {
            fail(Overlong(width))
        }
        let b = data.at(i)
        i = i + 1
        width = width + 1
        value = value + b.bit_and(127).shl(shift)
        shift = shift + 7
        if b < 128 {
            going = false
        }
    }
    (value, i)
}

fn write_integer(inout out: [i64], value: i64, prefix: i64, flags: i64) {
    let mask = 1.shl(prefix) - 1
    if value < mask {
        out.push(flags.bit_or(value))
        return
    }
    out.push(flags.bit_or(mask))
    var v = value - mask
    while v >= 128 {
        out.push(v.bit_and(127).bit_or(128))
        v = v.ushr(7)
    }
    out.push(v)
}

/// A string: a length with a one-bit "is it Huffman" flag.
fn read_string(data: bytes, at: i64) -> (str, i64) ! HpackError {
    if at >= data.len() {
        fail(Truncated(at))
    }
    let huffman = data.at(at).bit_and(128) != 0
    let header = try read_integer(data, at, 7)
    let length = header.0
    let start = header.1
    if length < 0 or start + length > data.len() {
        fail(Truncated(start))
    }
    let raw = data.slice(start, start + length)
    if huffman {
        (try huffman_decode(raw), start + length)
    } else {
        (raw.to_str(), start + length)
    }
}

/// Decode one header block against the table, updating it.
///
/// The table is `inout` because decoding *is* a mutation: an indexed literal
/// adds an entry, and a decoder that skipped that would go out of step with
/// the encoder and mis-read everything afterwards.
pub fn decode(inout t: HeaderTable, data: bytes) -> [HeaderPair] ! HpackError {
    var out: [HeaderPair] = []
    var at = 0
    while at < data.len() {
        let first = data.at(at)
        if first.bit_and(128) != 0 {
            let r = try read_integer(data, at, 7)
            at = r.1
            match entry_at(t, r.0) {
                Some(h) -> out.push(h)
                None -> fail(BadIndex(r.0))
            }
        } else if first.bit_and(192) == 64 {
            let r = try read_integer(data, at, 6)
            at = r.1
            let h = try read_literal(t, data, at, r.0)
            out.push(h.0)
            at = h.1
            insert(t, h.0)
        } else if first.bit_and(224) == 32 {
            let r = try read_integer(data, at, 5)
            at = r.1
            if r.0 > 1048576 {
                fail(TableTooLarge(r.0))
            }
            set_capacity(t, r.0)
        } else {
            // The two literal-without-indexing forms. They differ only in
            // whether a proxy may re-encode them as indexed, which this
            // decoder preserves by not inserting either.
            let r = try read_integer(data, at, 4)
            at = r.1
            let h = try read_literal(t, data, at, r.0)
            out.push(h.0)
            at = h.1
        }
    }
    out
}

fn read_literal(t: HeaderTable, data: bytes, at: i64, name_index: i64) -> (HeaderPair, i64) ! HpackError {
    var i = at
    var name = ""
    if name_index == 0 {
        let s = try read_string(data, i)
        name = s.0
        i = s.1
    } else {
        match entry_at(t, name_index) {
            Some(h) -> name = h.name
            None -> fail(BadIndex(name_index))
        }
    }
    let v = try read_string(data, i)
    (pair(name, v.0), v.1)
}

/// Encode headers as literals with indexing.
///
/// Deliberately simple: it never emits an indexed reference of its own, so
/// what it produces is always decodable and never smaller than it could be.
/// The interesting half of HPACK is the decoder, because that is the half that
/// reads what someone else sent.
pub fn encode(inout t: HeaderTable, headers: [HeaderPair]) -> bytes {
    var out: [i64] = []
    for h in headers {
        write_integer(out, 0, 6, 64)
        write_string(out, h.name)
        write_string(out, h.value)
        insert(t, h)
    }
    bytes_of(out)
}

fn write_string(inout out: [i64], s: str) {
    let b = s.to_bytes()
    write_integer(out, b.len(), 7, 0)
    for v in b.to_list() {
        out.push(v)
    }
}

/// Huffman decoding, with RFC 7541 appendix B's table.
///
/// The table was refused here for a long time, and the reason was right:
/// transcribing 256 codes from memory is exactly the kind of thing that is
/// wrong in one entry, and a Huffman table wrong in one entry decodes most
/// headers correctly and mangles the rest — worse than not decoding at all.
///
/// What changed is where the table came from. It is extracted from the
/// RFC's own text and cross-checked against another implementation's table
/// entry by entry, which is a different act from writing it out: a
/// transcription that disagrees with the source is caught before it ships,
/// and this one agreed on all 257 symbols.
///
/// The codes are canonical, so decoding needs three small tables rather
/// than a 65536-entry tree: for each length, the first code of that length
/// and where its symbols start.
/// The symbols of RFC 7541 appendix B, ordered by code length and then by
/// code — the canonical order a decoder walks.
fn huffman_symbols() -> [i64] {
    return [
        48, 49, 50, 97, 99, 101, 105, 111, 115, 116, 32, 37,
        45, 46, 47, 51, 52, 53, 54, 55, 56, 57, 61, 65,
        95, 98, 100, 102, 103, 104, 108, 109, 110, 112, 114, 117,
        58, 66, 67, 68, 69, 70, 71, 72, 73, 74, 75, 76,
        77, 78, 79, 80, 81, 82, 83, 84, 85, 86, 87, 89,
        106, 107, 113, 118, 119, 120, 121, 122, 38, 42, 44, 59,
        88, 90, 33, 34, 40, 41, 63, 39, 43, 124, 35, 62,
        0, 36, 64, 91, 93, 126, 94, 125, 60, 96, 123, 92,
        195, 208, 128, 130, 131, 162, 184, 194, 224, 226, 153, 161,
        167, 172, 176, 177, 179, 209, 216, 217, 227, 229, 230, 129,
        132, 133, 134, 136, 146, 154, 156, 160, 163, 164, 169, 170,
        173, 178, 181, 185, 186, 187, 189, 190, 196, 198, 228, 232,
        233, 1, 135, 137, 138, 139, 140, 141, 143, 147, 149, 150,
        151, 152, 155, 157, 158, 165, 166, 168, 174, 175, 180, 182,
        183, 188, 191, 197, 231, 239, 9, 142, 144, 145, 148, 159,
        171, 206, 215, 225, 236, 237, 199, 207, 234, 235, 192, 193,
        200, 201, 202, 205, 210, 213, 218, 219, 238, 240, 242, 243,
        255, 203, 204, 211, 212, 214, 221, 222, 223, 241, 244, 245,
        246, 247, 248, 250, 251, 252, 253, 254, 2, 3, 4, 5,
        6, 7, 8, 11, 12, 14, 15, 16, 17, 18, 19, 20,
        21, 23, 24, 25, 26, 27, 28, 29, 30, 31, 127, 220,
        249, 10, 13, 22, 256]
}

