import sshprivkey
import allowedsigners
import gitstripspace

fn from_hex(text: str) -> str {
    var out: [i64] = []
    var i = 1
    while i + 1 < text.len() {
        out.push(text.substr(i, 2).parse_int_base(16) ?? 0)
        i = i + 2
    }
    return bytes_of(out).to_str()
}

fn to_hex(text: str) -> str {
    let digits = "0123456789abcdef"
    let raw = text.to_bytes()
    var out = ""
    var i = 0
    while i < raw.len() {
        out = out + digits.substr(raw.at(i) / 16, 1) +
        digits.substr(raw.at(i) % 16, 1)
        i = i + 1
    }
    return out
}

fn read_or_hex(where: str) -> str / {io} {
    match read_file(where) {
        Ok(text) -> return text
        Err(_e) -> return from_hex(where)
    }
}

fn main() / {io} {
    var i = 0
    while i + 1 < args().len() {
        let what = args()[i]
        if what == "privpub" or what == "privfp" or what == "privinfo" {
            let text = read_or_hex(args()[i + 1])
            match sshprivkey.parse(text) {
                Err(_e) -> print("?refused?")
                Ok(key) -> {
                    if what == "privpub" {
                        print(to_hex(sshprivkey.public_line(key)))
                    } else if what == "privfp" {
                        print(sshprivkey.fingerprint(key))
                    } else {
                        var locked = "no"
                        if sshprivkey.is_encrypted(key) {
                            locked = "yes"
                        }
                        print(sshprivkey.key_type(key) + " " + key.cipher +
                            " " + key.kdf + " " + locked)
                    }
                }
            }
            i = i + 2
            continue
        }
        if what == "strip" or what == "stripc" or what == "subject" or
        what == "body" {
            let text = read_or_hex(args()[i + 1])
            if what == "strip" {
                print(to_hex(gitstripspace.clean(text, false)))
            } else if what == "stripc" {
                print(to_hex(gitstripspace.clean(text, true)))
            } else if what == "subject" {
                print(to_hex(gitstripspace.subject_of(text)))
            } else {
                print(to_hex(gitstripspace.body_of(text)))
            }
            i = i + 2
            continue
        }
        // `principals <file> <keytype> <key> <namespace>`
        let entries = allowedsigners.parse(read_or_hex(args()[i + 1]))
        print(to_hex(allowedsigners.find_principals(entries,
            args()[i + 2], args()[i + 3], args()[i + 4]).join("\n")))
        i = i + 5
    }
}
