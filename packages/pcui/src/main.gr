// Immediate-mode widgets, drawn into a surface.
//
// Immediate mode rather than retained, and the language is the reason. A
// retained toolkit is a tree of widget objects that outlive the frame, each
// holding its own state and a callback the toolkit invokes -- and there are
// no mutable globals to hang that tree from ([E-REPLAY]), no way for C to
// call back into Grasm, and a callback that mutates something outside itself
// is what the effect system exists to refuse.
//
// Immediate mode wants none of that. A widget is a function of this frame's
// input that draws and returns what happened:
//
//     if pcui.button(ui, Rect{...}, "Save") { save() }
//
// There is no widget to keep, so there is nothing to keep it in. The state
// that must persist -- which layer is selected, where a slider sits -- is the
// caller's, passed in and returned, which is also what makes a session
// replayable.
//
// Nothing here opens a window. The caller polls, fills an `Input`, calls
// these, and uploads the surface; `packages/sdl` is one way to do that and
// not the only one.
import pcframe
import pcfont

/// What the pointer did this frame.
///
/// `pressed` and `released` are edges, not states: a button fires once on the
/// frame the press lands, and holding it down does not fire again.
type Input = {
    mx: i64,
    my: i64,
    down: bool,
    pressed: bool,
    released: bool,
}

type Color = {
    r: i64,
    g: i64,
    b: i64,
}

type Theme = {
    panel: Color,
    raised: Color,
    hot: Color,
    active: Color,
    text: Color,
    accent: Color,
    track: Color,
}

/// Everything a frame of widgets needs, threaded through with `inout`.
type Ui = {
    surface: Surface,
    font: Font,
    input: Input,
    size: i64,
    theme: Theme,
    cx: i64,
    cy: i64,
    cw: i64,
    gap: i64,
}

pub fn rgb(r: i64, g: i64, b: i64) -> Color {
    Color{ r: r, g: g, b: b }
}

/// A dark theme, which is what an image editor uses so the image is the
/// brightest thing on the screen.
pub fn dark() -> Theme {
    Theme{
        panel: rgb(24, 26, 32),
        raised: rgb(44, 48, 58),
        hot: rgb(58, 64, 78),
        active: rgb(26, 77, 255),
        text: rgb(226, 230, 240),
        accent: rgb(26, 77, 255),
        track: rgb(16, 18, 22),
    }
}

pub fn no_input() -> Input {
    Input{ mx: 0 - 1, my: 0 - 1, down: false, pressed: false, released: false }
}

/// Start a frame. The surface and the caller's state come in, and the surface
/// comes back out of `surface_of` with this frame drawn on it.
pub fn begin(surface: Surface, font: Font, input: Input, size: i64, theme: Theme) -> Ui {
    Ui{
        surface: surface,
        font: font,
        input: input,
        size: size,
        theme: theme,
        cx: 0,
        cy: 0,
        cw: 0,
        gap: 6,
    }
}

pub fn surface_of(ui: Ui) -> Surface {
    ui.surface
}

pub fn is_inside(r: Rect, x: i64, y: i64) -> bool {
    x >= r.x and y >= r.y and x < r.x + r.w and y < r.y + r.h
}

/// Whether the pointer is over a rectangle this frame.
pub fn hot(ui: Ui, r: Rect) -> bool {
    is_inside(r, ui.input.mx, ui.input.my)
}

fn paint(inout ui: Ui, r: Rect, c: Color) {
    pcframe.fill_rect(ui.surface, r, c.r, c.g, c.b, 255)
}

/// A one-pixel border, drawn as four fills.
fn outline(inout ui: Ui, r: Rect, c: Color) {
    paint(ui, Rect{ x: r.x, y: r.y, w: r.w, h: 1 }, c)
    paint(ui, Rect{ x: r.x, y: r.y + r.h - 1, w: r.w, h: 1 }, c)
    paint(ui, Rect{ x: r.x, y: r.y, w: 1, h: r.h }, c)
    paint(ui, Rect{ x: r.x + r.w - 1, y: r.y, w: 1, h: r.h }, c)
}

/// A background panel, which is what a palette or a toolbar sits on.
pub fn panel(inout ui: Ui, r: Rect) {
    paint(ui, r, ui.theme.panel)
}

/// Text with its left edge at `x` and its baseline placed inside a row of
/// height `h` starting at `y`, which is what a caller means by "in this row".
pub fn label(inout ui: Ui, x: i64, y: i64, h: i64, text: str) -> i64 {
    let base = y + (h + ui.size * 2 / 3) / 2
    let c = ui.theme.text
    pcfont.draw_text(ui.surface, ui.font, text, x, base, ui.size, c.r, c.g, c.b)
}

/// Text centred in a rectangle.
pub fn label_centred(inout ui: Ui, r: Rect, text: str) {
    let w = pcfont.text_width(ui.font, text, ui.size)
    let _ = label(ui, r.x + (r.w - w) / 2, r.y, r.h, text)
}

/// A button. True on the frame the press lands inside it.
///
/// The press rather than the release, so a drag that starts on a button and
/// ends elsewhere still counts -- which is what a toolbar wants, and the
/// opposite of what a dialog's OK wants. A dialog can test `released` itself.
pub fn button(inout ui: Ui, r: Rect, text: str) -> bool {
    let over = hot(ui, r)
    var fill = ui.theme.raised
    if over and ui.input.down {
        fill = ui.theme.active
    } else if over {
        fill = ui.theme.hot
    }
    paint(ui, r, fill)
    outline(ui, r, ui.theme.track)
    label_centred(ui, r, text)
    over and ui.input.pressed
}

/// Where a slider's value lands, given the pointer and whether it is being
/// dragged.
///
/// Separate from the drawing because this is the part that can be wrong in a
/// way nobody sees until a value is off by one at an end stop, and it is
/// testable without a font or a surface.
pub fn slider_value(r: Rect, mx: i64, value: i64, lo: i64, hi: i64, dragging: bool) -> i64 {
    var v = value
    if dragging and hi > lo and r.w > 0 {
        v = lo + (mx - r.x) * (hi - lo) / r.w
    }
    if v < lo {
        return lo
    }
    if v > hi {
        return hi
    }
    v
}

/// A horizontal slider. Returns the value it should hold after this frame,
/// which is the old one unless the pointer is dragging it.
///
/// The value is the caller's, passed in and returned: there is nowhere here
/// to keep it, and a frame that cannot remember is a frame that can be
/// replayed.
pub fn slider(inout ui: Ui, r: Rect, value: i64, lo: i64, hi: i64) -> i64 {
    let track = Rect{ x: r.x, y: r.y + r.h / 2 - 2, w: r.w, h: 4 }
    paint(ui, track, ui.theme.track)
    let dragging = hot(ui, r) and ui.input.down
    let v = slider_value(r, ui.input.mx, value, lo, hi, dragging)
    // The filled part, then the knob over it.
    let span = if hi > lo { (v - lo) * (r.w - 10) / (hi - lo) } else { 0 }
    paint(ui, Rect{ x: r.x, y: track.y, w: span + 5, h: track.h }, ui.theme.accent)
    let knob = Rect{ x: r.x + span, y: r.y + 2, w: 10, h: r.h - 4 }
    paint(ui, knob, if hot(ui, r) { ui.theme.text } else { ui.theme.raised })
    outline(ui, knob, ui.theme.track)
    v
}

/// A checkbox. Returns what it should hold after this frame.
pub fn checkbox(inout ui: Ui, r: Rect, text: str, on: bool) -> bool {
    let box = Rect{ x: r.x, y: r.y + (r.h - 12) / 2, w: 12, h: 12 }
    paint(ui, box, if on { ui.theme.accent } else { ui.theme.raised })
    outline(ui, box, ui.theme.track)
    let _ = label(ui, r.x + 18, r.y, r.h, text)
    if hot(ui, r) and ui.input.pressed {
        return not on
    }
    on
}

/// One row of a list. True on the frame it is pressed, so a caller selects by
/// assigning the index it returns true for.
pub fn list_item(inout ui: Ui, r: Rect, text: str, selected: bool) -> bool {
    let over = hot(ui, r)
    if selected {
        paint(ui, r, ui.theme.active)
    } else if over {
        paint(ui, r, ui.theme.hot)
    } else {
        paint(ui, r, ui.theme.raised)
    }
    let _ = label(ui, r.x + 6, r.y, r.h, text)
    over and ui.input.pressed
}

/// Start stacking rows down a column.
pub fn stack(inout ui: Ui, x: i64, y: i64, w: i64) {
    ui.cx = x
    ui.cy = y
    ui.cw = w
}

/// The next row of height `h` in the current stack.
pub fn row(inout ui: Ui, h: i64) -> Rect {
    let r = Rect{ x: ui.cx, y: ui.cy, w: ui.cw, h: h }
    ui.cy = ui.cy + h + ui.gap
    r
}

/// Leave a gap without drawing anything.
pub fn space(inout ui: Ui, h: i64) {
    ui.cy = ui.cy + h
}

test "a point inside a rectangle is inside, and the far edges are not" {
    let r = Rect{ x: 10, y: 10, w: 5, h: 5 }
    assert(is_inside(r, 10, 10))
    assert(is_inside(r, 14, 14))
    assert(not is_inside(r, 15, 14))
    assert(not is_inside(r, 14, 15))
    assert(not is_inside(r, 9, 10))
}

test "an undragged slider keeps its value" {
    let r = Rect{ x: 0, y: 0, w: 100, h: 20 }
    assert_eq(slider_value(r, 50, 37, 0, 100, false), 37)
}

test "a dragged slider follows the pointer" {
    let r = Rect{ x: 0, y: 0, w: 100, h: 20 }
    assert_eq(slider_value(r, 0, 50, 0, 100, true), 0)
    assert_eq(slider_value(r, 50, 0, 0, 100, true), 50)
    assert_eq(slider_value(r, 100, 0, 0, 100, true), 100)
}

test "a slider clamps at both ends rather than running past them" {
    let r = Rect{ x: 20, y: 0, w: 100, h: 20 }
    assert_eq(slider_value(r, 0, 50, 0, 100, true), 0)
    assert_eq(slider_value(r, 9999, 50, 0, 100, true), 100)
    // And a value handed in out of range is brought back.
    assert_eq(slider_value(r, 0, 0 - 10, 0, 100, false), 0)
    assert_eq(slider_value(r, 0, 500, 0, 100, false), 100)
}

test "a slider over a shifted range maps from its own left edge" {
    let r = Rect{ x: 100, y: 0, w: 200, h: 20 }
    assert_eq(slider_value(r, 100, 0, 0 - 50, 50, true), 0 - 50)
    assert_eq(slider_value(r, 200, 0, 0 - 50, 50, true), 0)
    assert_eq(slider_value(r, 300, 0, 0 - 50, 50, true), 50)
}

test "a degenerate slider does not divide by zero" {
    assert_eq(slider_value(Rect{ x: 0, y: 0, w: 0, h: 10 }, 5, 3, 0, 10, true), 3)
    assert_eq(slider_value(Rect{ x: 0, y: 0, w: 10, h: 10 }, 5, 7, 5, 5, true), 5)
}
