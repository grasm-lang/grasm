import eucjp
import iso2022jp
import shiftjis

fn from_hex(text: str) -> bytes {
    var out: [i64] = []
    var i = 1
    while i + 1 < text.len() {
        out.push(text.substr(i, 2).parse_int_base(16) ?? 0)
        i = i + 2
    }
    return bytes_of(out)
}

fn to_hex(raw: bytes) -> str {
    let digits = "0123456789abcdef"
    var out = ""
    var i = 0
    while i < raw.len() {
        out = out + digits.substr(raw.at(i) / 16, 1) +
        digits.substr(raw.at(i) % 16, 1)
        i = i + 1
    }
    return out
}

fn main() / {io} {
    let table = shiftjis.encoder()
    var i = 0
    while i + 1 < args().len() {
        let what = args()[i]
        let arg = args()[i + 1]
        if what == "eucdec" {
            print(to_hex((eucjp.decode(from_hex(arg)) ?? "\u{7}")
                    .to_bytes()))
        } else if what == "eucenc" {
            print(to_hex(eucjp.encode_with(table,
                from_hex(arg).to_str()) ?? "\u{7}".to_bytes()))
        } else if what == "isodec" {
            print(to_hex((iso2022jp.decode(from_hex(arg)) ?? "\u{7}")
                    .to_bytes()))
        } else {
            print(to_hex(iso2022jp.encode_with(table,
                from_hex(arg).to_str()) ?? "\u{7}".to_bytes()))
        }
        i = i + 2
    }
}
