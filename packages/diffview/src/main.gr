// Unified diffs — the `-`/`+` format every code review renders.
//
// The alignment is the whole job. A diff that reports "everything changed"
// because one line was inserted at the top is useless, so this finds the
// longest common subsequence and reports only what actually moved.
//
// LCS is O(n*m) in time and memory, which is fine for a file and hopeless for
// a database dump. That bound is stated rather than discovered: `unified`
// refuses inputs past a limit instead of allocating until the machine stops.

type Edit =
    | Keep(text: str)
    | Remove(text: str)
    | Insert(text: str)

type DiffError = | TooLarge(lines: i64)

/// The edit script turning `a` into `b`.
pub fn diff(a: [str], b: [str]) -> [Edit] ! DiffError {
    if a.len() * b.len() > 4000000 {
        fail(TooLarge(a.len() + b.len()))
    }
    let n = a.len()
    let m = b.len()
    // table[i * (m+1) + j] = LCS length of a[i..] and b[j..], built backwards.
    var table: [i64] = []
    for _i in 0..((n + 1) * (m + 1)) {
        table.push(0)
    }
    var i = n - 1
    while i >= 0 {
        var j = m - 1
        while j >= 0 {
            if a[i] == b[j] {
                table[i * (m + 1) + j] = table[(i + 1) * (m + 1) + j + 1] + 1
            } else {
                let down = table[(i + 1) * (m + 1) + j]
                let right = table[i * (m + 1) + j + 1]
                table[i * (m + 1) + j] = if down > right { down } else { right }
            }
            j = j - 1
        }
        i = i - 1
    }
    var out: [Edit] = []
    var x = 0
    var y = 0
    while x < n and y < m {
        if a[x] == b[y] {
            out.push(Keep(a[x]))
            x = x + 1
            y = y + 1
        } else {
            if table[(x + 1) * (m + 1) + y] >= table[x * (m + 1) + y + 1] {
                out.push(Remove(a[x]))
                x = x + 1
            } else {
                out.push(Insert(b[y]))
                y = y + 1
            }
        }
    }
    while x < n {
        out.push(Remove(a[x]))
        x = x + 1
    }
    while y < m {
        out.push(Insert(b[y]))
        y = y + 1
    }
    return out
}

/// The edit script as `-`/`+`/` ` lines.
pub fn render(edits: [Edit]) -> str {
    var lines: [str] = []
    for e in edits {
        match e {
            Keep(t) -> lines.push(" {t}")
            Remove(t) -> lines.push("-{t}")
            Insert(t) -> lines.push("+{t}")
        }
    }
    return lines.join("\n")
}

/// Only the changed regions, with `context` unchanged lines either side —
/// which is what makes a diff of a large file readable.
pub fn unified(edits: [Edit], context: i64) -> str {
    var keep: [bool] = []
    for _e in edits {
        keep.push(false)
    }
    for i in 0..edits.len() {
        let changed = match edits[i] {
            Keep(_t) -> false
            Remove(_t) -> true
            Insert(_t) -> true
        }
        if changed {
            var k = i - context
            while k <= i + context {
                if k >= 0 and k < keep.len() {
                    keep[k] = true
                }
                k = k + 1
            }
        }
    }
    var lines: [str] = []
    var skipping = false
    for i in 0..edits.len() {
        if keep[i] {
            skipping = false
            match edits[i] {
                Keep(t) -> lines.push(" {t}")
                Remove(t) -> lines.push("-{t}")
                Insert(t) -> lines.push("+{t}")
            }
        } else {
            if not skipping {
                lines.push("@@")
                skipping = true
            }
        }
    }
    return lines.join("\n")
}

pub fn added(edits: [Edit]) -> i64 {
    var n = 0
    for e in edits {
        match e {
            Insert(_t) -> n = n + 1
            _ -> {}
        }
    }
    return n
}

pub fn removed(edits: [Edit]) -> i64 {
    var n = 0
    for e in edits {
        match e {
            Remove(_t) -> n = n + 1
            _ -> {}
        }
    }
    return n
}

pub fn unchanged(edits: [Edit]) -> bool {
    return added(edits) == 0 and removed(edits) == 0
}
