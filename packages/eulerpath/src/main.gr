// Euler paths and circuits (Hierholzer, 1873): a walk that uses every edge
// exactly once.
//
// One exists in an undirected graph when every vertex with an edge is in
// one connected piece and zero or two vertices have odd degree (zero gives
// a circuit); in a directed graph, when every vertex has as many edges in
// as out except possibly a start with one more out and an end with one
// more in. It is what routes a snow plough or a pen plotter, assembles a
// genome from k-mers (de Bruijn graphs), and draws a figure without lifting
// the pen.
//
// The answer names edges by their index in the input, not only vertices,
// so parallel edges are told apart. Iterative.

type EulerWalk = {
    vertices: [i64],
    edges: [i64],
}

fn degree_start(n: i64, edges: [(i64, i64)], directed: bool) -> i64 {
    var out_deg: [i64] = []
    var in_deg: [i64] = []
    for _i in 0..n {
        out_deg.push(0)
        in_deg.push(0)
    }
    for (a, b) in edges {
        out_deg[a] = out_deg[a] + 1
        in_deg[b] = in_deg[b] + 1
    }
    var start = -1
    var odd = 0
    var plus = 0
    var minus = 0
    for v in 0..n {
        if start == -1 and out_deg[v] + in_deg[v] > 0 {
            start = v
        }
        if directed {
            let d = out_deg[v] - in_deg[v]
            if d == 1 {
                plus = plus + 1
            } else if d == -1 {
                minus = minus + 1
            } else if d != 0 {
                return -2
            }
        } else if (out_deg[v] + in_deg[v]) % 2 == 1 {
            odd = odd + 1
        }
    }
    if directed and (plus > 1 or minus > 1 or plus != minus) {
        return -2
    }
    if not directed and odd != 0 and odd != 2 {
        return -2
    }
    for v in 0..n {
        if directed and out_deg[v] - in_deg[v] == 1 {
            return v
        }
        if not directed and (out_deg[v] + in_deg[v]) % 2 == 1 {
            return v
        }
    }
    start
}

fn walk(n: i64, edges: [(i64, i64)], directed: bool, start: i64) -> Option[EulerWalk] {
    var adj: [[(i64, i64)]] = []
    var at: [i64] = []
    for _i in 0..n {
        adj.push([])
        at.push(0)
    }
    for k in 0..edges.len() {
        let (a, b) = edges[k]
        adj[a].push((b, k))
        if not directed {
            adj[b].push((a, k))
        }
    }
    var used: [bool] = []
    for _k in 0..edges.len() {
        used.push(false)
    }
    var stack: [(i64, i64)] = [(start, -1)]
    var vs: [i64] = []
    var es: [i64] = []
    while stack.len() > 0 {
        let (v, via) = stack[stack.len() - 1]
        while at[v] < adj[v].len() and used[adj[v][at[v]].1] {
            at[v] = at[v] + 1
        }
        if at[v] < adj[v].len() {
            let (w, id) = adj[v][at[v]]
            used[id] = true
            stack.push((w, id))
        } else {
            stack = stack.slice(0, stack.len() - 1)
            vs.push(v)
            if via != -1 {
                es.push(via)
            }
        }
    }
    if es.len() != edges.len() {
        return None
    }
    var rv: [i64] = []
    var re: [i64] = []
    for k in 0..vs.len() {
        rv.push(vs[vs.len() - 1 - k])
    }
    for k in 0..es.len() {
        re.push(es[es.len() - 1 - k])
    }
    Some(EulerWalk{ vertices: rv, edges: re })
}

fn find(n: i64, edges: [(i64, i64)], directed: bool) -> Option[EulerWalk] {
    if edges.len() == 0 {
        return Some(EulerWalk{ vertices: [], edges: [] })
    }
    let start = degree_start(n, edges, directed)
    if start < 0 {
        return None
    }
    walk(n, edges, directed, start)
}

/// A walk over every edge of an undirected graph, a circuit when one
/// exists; `None` when there is none. A graph with no edges has the empty
/// walk.
pub fn undirected(n: i64, edges: [(i64, i64)]) -> Option[EulerWalk] {
    find(n, edges, false)
}

/// The same for a directed graph, each edge followed from its first
/// vertex to its second.
pub fn directed(n: i64, edges: [(i64, i64)]) -> Option[EulerWalk] {
    find(n, edges, true)
}

/// Whether the walk ends where it began.
pub fn is_circuit(w: EulerWalk) -> bool {
    w.vertices.len() > 0 and w.vertices[0] == w.vertices[w.vertices.len() - 1]
}
