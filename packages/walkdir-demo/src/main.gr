// Walks a tree and prints what it found, for `scripts/walkdirtest.sh` to
// compare against `find`.
import walkdir

fn main() -> () ! WalkError / {io} {
    let a = args()
    // Without an argument -- the way difftest runs every corpus program --
    // a fixed tree, not the working directory: `.` was the whole checkout,
    // 38,000 files that changed while a build ran beside the two engines,
    // so the interpreter and the compiled program counted different trees.
    let root = a.get(0) ?? "packages/walkdir"
    let limit = (a.get(1) ?? "16").parse_int() ?? 16
    let w = try walkdir.walk(root, limit)
    print("files {w.files.len()}")
    for f in w.files {
        print("F {f}")
    }
    print("dirs {w.dirs.len()}")
    for d in w.dirs {
        print("D {d}")
    }
    print("hit_limit {w.hit_limit}")
}
