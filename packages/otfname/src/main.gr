// The OpenType `name` table: every string a font carries about itself.
//
// Family and subfamily names, the full and PostScript names, copyright,
// trademark, designer, licence text and URLs, sample text, and the names
// of variable-font axes and instances, each keyed by a name ID and a
// platform, encoding and language. Font menus, PDF embedding, CSS
// `local()` matching and licence checks all read it.
//
// Strings for the Unicode and Windows platforms are UTF-16BE; Macintosh
// Roman (platform 1, encoding 0) is decoded by its table. Other Macintosh
// encodings are returned as their bytes, undecoded. Format 1 tables also
// carry language-tag strings, which are read as UTF-16BE.
//
// Checked against fontTools' `name` table on macOS's system fonts.

type NameRecord = { platform: i64, encoding: i64, language: i64, name_id: i64, raw: bytes, text: str, decoded: bool }

type NameTable = { format: i64, records: [NameRecord], language_tags: [str] }

type NameError =
    | NameMalformed(why: str)

fn u16(b: bytes, at: i64) -> i64 {
    return b.at(at) * 256 + b.at(at + 1)
}

/// UTF-16BE to text; an unpaired surrogate becomes U+FFFD.
pub fn utf16be(b: bytes) -> str {
    var out = ""
    var i = 0
    while i + 1 < b.len() {
        var c = u16(b, i)
        i = i + 2
        if c >= 55296 and c <= 56319 {
            if i + 1 < b.len() and u16(b, i) >= 56320 and u16(b, i) <= 57343 {
                c = 65536 + (c - 55296) * 1024 + (u16(b, i) - 56320)
                i = i + 2
            } else {
                c = 65533
            }
        } else if c >= 56320 and c <= 57343 {
            c = 65533
        }
        out = out + c.to_char()
    }
    return out
}

pub fn mac_roman(b: bytes) -> str {
    let high = MAC_ROMAN_HIGH
    var out = ""
    for i in 0..b.len() {
        let c = b.at(i)
        out = out + (if c < 128 { c } else { high[c - 128] }).to_char()
    }
    return out
}

pub fn parse(data: bytes) -> NameTable ! NameError {
    if data.len() < 6 {
        fail(NameMalformed("shorter than its header"))
    }
    let format = u16(data, 0)
    let count = u16(data, 2)
    let storage = u16(data, 4)
    if format > 1 {
        fail(NameMalformed("format {format}"))
    }
    if 6 + 12 * count > data.len() {
        fail(NameMalformed("records past the end"))
    }
    var records: [NameRecord] = []
    for i in 0..count {
        let at = 6 + 12 * i
        let p = u16(data, at)
        let e = u16(data, at + 2)
        let len = u16(data, at + 8)
        let off = storage + u16(data, at + 10)
        if off + len > data.len() {
            fail(NameMalformed("a string past the end"))
        }
        let raw = data.slice(off, off + len)
        let unicode = p == 0 or p == 3
        let roman = p == 1 and e == 0
        let text = if unicode { utf16be(raw) } else if roman { mac_roman(raw) } else { "" }
        records.push(NameRecord{ platform: p, encoding: e, language: u16(data, at + 4), name_id: u16(data, at + 6), raw: raw,
            text: text, decoded: unicode or roman })
    }
    var tags: [str] = []
    if format == 1 {
        let base = 6 + 12 * count
        if base + 2 > data.len() {
            fail(NameMalformed("no language tag count"))
        }
        let n = u16(data, base)
        for i in 0..n {
            let at = base + 2 + 4 * i
            if at + 4 > data.len() {
                fail(NameMalformed("language tags past the end"))
            }
            let off = storage + u16(data, at + 2)
            let len = u16(data, at)
            if off + len > data.len() {
                fail(NameMalformed("a language tag past the end"))
            }
            tags.push(utf16be(data.slice(off, off + len)))
        }
    }
    return NameTable{ format: format, records: records, language_tags: tags }
}

/// The best string for a name ID: Windows English (US), then any Windows,
/// then Unicode, then Macintosh Roman English.
pub fn lookup(t: NameTable, name_id: i64) -> Option[str] {
    for pass in 0..4 {
        for r in t.records {
            if r.name_id == name_id and r.decoded {
                let ok = if pass == 0 { r.platform == 3 and r.language == 1033 } else if pass == 1 { r.platform == 3 } else if pass == 2 {
                    r.platform == 0
                } else { r.platform == 1 and r.language == 0 }
                if ok {
                    return Some(r.text)
                }
            }
        }
    }
    return None
}

