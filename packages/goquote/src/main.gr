fn load_ranges(packed: str) -> [i64] {
    var out: [i64] = []
    if packed.len() == 0 {
        return out
    }
    for pair in packed.split(",") {
        let cut = pair.index_of("-") ?? 0
        out.push(pair.substr(0, cut).parse_int_base(16) ?? 0)
        out.push(pair.substr(cut + 1, pair.len() - cut - 1).parse_int_base(16) ?? 0)
    }
    out
}

let GO_HIDDEN = load_ranges(GO_HIDDEN_PACKED)
let GO_GRAPHIC = load_ranges(GO_GRAPHIC_PACKED)

fn in_ranges(table: [i64], r: i64) -> bool {
    var low = 0
    var high = table.len() / 2 - 1
    while low <= high {
        let mid = (low + high) / 2
        if r < table[mid * 2] {
            high = mid - 1
        } else if r > table[mid * 2 + 1] {
            low = mid + 1
        } else {
            return true
        }
    }
    false
}

/// `strconv.IsPrint`.
pub fn is_print(r: i64) -> bool {
    valid_rune(r) and not in_ranges(GO_HIDDEN, r)
}

/// `strconv.IsGraphic`: printable, or one of the spaces Unicode calls
/// graphic -- U+00A0, U+3000 and their kind.
pub fn is_graphic(r: i64) -> bool {
    is_print(r) or in_ranges(GO_GRAPHIC, r)
}

/// `appendEscapedRune`, the one place the three quoting modes differ.
fn escape_rune(inout out: [i64], rune: i64, quote: i64, ascii: bool, graphic: bool) {
    var r = rune
    if r == quote or r == 92 {
        out.push(92)
        push_rune(out, r)
        return
    }
    if ascii {
        if r < 128 and is_print(r) {
            out.push(r)
            return
        }
    } else if is_print(r) or (graphic and in_ranges(GO_GRAPHIC, r)) {
        push_rune(out, r)
        return
    }
    let named = [7, 8, 12, 10, 13, 9, 11]
    let letters = [97, 98, 102, 110, 114, 116, 118]
    for k in 0..7 {
        if r == named[k] {
            out.push(92)
            out.push(letters[k])
            return
        }
    }
    if r < 32 or r == 127 {
        out.push(92)
        out.push(120)
        push_hex(out, r.bit_and(255), 2)
        return
    }
    if not valid_rune(r) {
        r = 65533
    }
    if r < 65536 {
        out.push(92)
        out.push(117)
        push_hex(out, r, 4)
    } else {
        out.push(92)
        out.push(85)
        push_hex(out, r, 8)
    }
}

fn quote_with(s: bytes, quote: i64, ascii: bool, graphic: bool) -> str {
    var out: [i64] = [quote]
    var at = 0
    while at < s.len() {
        let d = decode_rune(s, at)
        if d.1 == 1 and d.0 == 65533 {
            out.push(92)
            out.push(120)
            push_hex(out, s.at(at), 2)
        } else {
            escape_rune(out, d.0, quote, ascii, graphic)
        }
        at = at + d.1
    }
    out.push(quote)
    bytes_of(out).to_str()
}

/// `strconv.Quote`: a double-quoted Go literal, with Go's printable
/// characters left as they are.
pub fn quote(s: bytes) -> str {
    quote_with(s, 34, false, false)
}

/// `strconv.QuoteToASCII`: everything outside printable ASCII escaped, so
/// the result survives any channel that mangles non-ASCII.
pub fn quote_ascii(s: bytes) -> str {
    quote_with(s, 34, true, false)
}

/// `strconv.QuoteToGraphic`: as `quote`, but Unicode's graphic spaces are
/// left alone too.
pub fn quote_graphic(s: bytes) -> str {
    quote_with(s, 34, false, true)
}

fn quote_rune_with(rune: i64, ascii: bool, graphic: bool) -> str {
    let r = if valid_rune(rune) { rune } else { 65533 }
    var out: [i64] = [39]
    escape_rune(out, r, 39, ascii, graphic)
    out.push(39)
    bytes_of(out).to_str()
}

/// `strconv.QuoteRune`: a single-quoted rune literal. A value that is not a
/// valid rune is quoted as U+FFFD, as Go does.
pub fn quote_rune(r: i64) -> str {
    quote_rune_with(r, false, false)
}

pub fn quote_rune_ascii(r: i64) -> str {
    quote_rune_with(r, true, false)
}

pub fn quote_rune_graphic(r: i64) -> str {
    quote_rune_with(r, false, true)
}

/// `strconv.CanBackquote`: whether `s` can be written as a raw string
/// literal unchanged -- one line, no backquote, no control character but
/// tab, valid UTF-8 and no byte-order mark.
pub fn can_backquote(s: bytes) -> bool {
    var at = 0
    while at < s.len() {
        let d = decode_rune(s, at)
        at = at + d.1
        if d.1 > 1 {
            if d.0 == 65279 {
                return false
            }
            continue
        }
        if d.0 == 65533 {
            return false
        }
        if (d.0 < 32 and d.0 != 9) or d.0 == 96 or d.0 == 127 {
            return false
        }
    }
    true
}

fn unhex(c: i64) -> i64 {
    if c >= 48 and c <= 57 {
        c - 48
    } else if c >= 97 and c <= 102 {
        c - 87
    } else if c >= 65 and c <= 70 {
        c - 55
    } else {
        -1
    }
}

/// `UnquoteChar`'s answer: the value, whether it is a rune to be encoded
/// (rather than a single byte), and where the rest begins. `-1` as the end
/// is a syntax error.
type GoChar = {
    value: i64,
    multibyte: bool,
    next: i64,
}

fn bad_char() -> GoChar {
    GoChar{ value: 0, multibyte: false, next: -1 }
}

fn unquote_char(s: bytes, at: i64, quote: i64) -> GoChar {
    if at >= s.len() {
        return bad_char()
    }
    let c = s.at(at)
    if c == quote and (quote == 39 or quote == 34) {
        return bad_char()
    }
    if c >= 128 {
        let d = decode_rune(s, at)
        return GoChar{ value: d.0, multibyte: true, next: at + d.1 }
    }
    if c != 92 {
        return GoChar{ value: c, multibyte: false, next: at + 1 }
    }
    if at + 1 >= s.len() {
        return bad_char()
    }
    let e = s.at(at + 1)
    var p = at + 2
    let simple = [97, 98, 102, 110, 114, 116, 118]
    let values = [7, 8, 12, 10, 13, 9, 11]
    for k in 0..7 {
        if e == simple[k] {
            return GoChar{ value: values[k], multibyte: false, next: p }
        }
    }
    if e == 120 or e == 117 or e == 85 {
        let n = if e == 120 { 2 } else if e == 117 { 4 } else { 8 }
        if p + n > s.len() {
            return bad_char()
        }
        var v = 0
        for j in 0..n {
            let x = unhex(s.at(p + j))
            if x < 0 {
                return bad_char()
            }
            v = v.shl(4).bit_or(x)
        }
        p = p + n
        if e == 120 {
            return GoChar{ value: v, multibyte: false, next: p }
        }
        if not valid_rune(v) {
            return bad_char()
        }
        return GoChar{ value: v, multibyte: true, next: p }
    }
    if e >= 48 and e <= 55 {
        var v = e - 48
        if p + 2 > s.len() {
            return bad_char()
        }
        for j in 0..2 {
            let x = s.at(p + j) - 48
            if x < 0 or x > 7 {
                return bad_char()
            }
            v = v.shl(3).bit_or(x)
        }
        if v > 255 {
            return bad_char()
        }
        return GoChar{ value: v, multibyte: false, next: p + 2 }
    }
    if e == 92 {
        return GoChar{ value: 92, multibyte: false, next: p }
    }
    if (e == 39 or e == 34) and e == quote {
        return GoChar{ value: e, multibyte: false, next: p }
    }
    bad_char()
}

fn contains_between(s: bytes, from: i64, end: i64, c: i64) -> bool {
    var i = from
    while i < end {
        if s.at(i) == c {
            return true
        }
        i = i + 1
    }
    false
}

/// `strconv`'s `unquote`: the value (or, when `unescape` is false, the
/// literal itself) and where the literal ended. `-1` is a syntax error.
fn unquote_at(s: bytes, unescape: bool) -> (bytes, i64) {
    let fail_with = (bytes_of([]), -1)
    if s.len() < 2 {
        return fail_with
    }
    let quote = s.at(0)
    let found = s.index_of(quote, 1)
    if found.is_none() {
        return fail_with
    }
    let end = (found ?? 0) + 1
    if quote == 96 {
        if not unescape {
            return (s.slice(0, end), end)
        }
        var raw: [i64] = []
        for i in 1..end - 1 {
            if s.at(i) != 13 {
                raw.push(s.at(i))
            }
        }
        return (bytes_of(raw), end)
    }
    if quote != 34 and quote != 39 {
        return fail_with
    }
    if not contains_between(s, 0, end, 92) and not contains_between(s, 0, end, 10) {
        var valid = false
        if quote == 34 {
            valid = valid_utf8(s, 1, end - 1)
        } else if end > 2 {
            let d = decode_rune(s, 1)
            valid = 1 + d.1 + 1 == end and (d.0 != 65533 or d.1 != 1)
        }
        if valid {
            if unescape {
                return (s.slice(1, end - 1), end)
            }
            return (s.slice(0, end), end)
        }
    }
    var out: [i64] = []
    var at = 1
    while at < s.len() and s.at(at) != quote {
        let ch = unquote_char(s, at, quote)
        if s.at(at) == 10 or ch.next < 0 {
            return fail_with
        }
        at = ch.next
        if ch.value < 128 or not ch.multibyte {
            out.push(ch.value)
        } else {
            push_rune(out, ch.value)
        }
        if quote == 39 {
            break
        }
    }
    if not (at < s.len() and s.at(at) == quote) {
        return fail_with
    }
    at = at + 1
    if unescape {
        return (bytes_of(out), at)
    }
    (s.slice(0, at), at)
}

/// `strconv.Unquote`: the value of a Go string, rune or raw-string literal.
/// The whole input must be the literal; anything after it is a syntax error.
pub fn unquote(s: bytes) -> bytes ! GoQuoteError {
    let r = unquote_at(s, true)
    if r.1 < 0 or r.1 != s.len() {
        fail(Syntax)
    }
    r.0
}

/// `strconv.QuotedPrefix`: the literal at the start of `s`, quotes included,
/// leaving whatever follows it.
pub fn quoted_prefix(s: bytes) -> bytes ! GoQuoteError {
    let r = unquote_at(s, false)
    if r.1 < 0 {
        fail(Syntax)
    }
    r.0
}
