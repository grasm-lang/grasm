// Go's string and rune literals: `strconv.Quote`, `Unquote` and their family.
//
// A Go literal is what `%q` prints, what `go/printer` writes, what a Go
// struct tag holds and what a dozen config formats borrowed -- HCL, Caddy,
// Terraform plans, `go.mod` replace paths, every Go program's log line that
// quotes a user value. Reading or writing one by hand gets three things
// wrong, and this exists so they are got right once:
//
// - **The input is bytes, not text.** A Go string may hold any bytes, and
//   `Quote` writes a byte that is not part of valid UTF-8 as `\x80` rather
//   than replacing it. So `quote` takes `bytes`, and `unquote` returns
//   `bytes`, because `"\xff"` is a legal literal whose value is not UTF-8.
// - **What counts as printable is Go's answer, not Unicode's.** `Quote`
//   leaves a character alone when `strconv.IsPrint` says so, and that is a
//   specific list -- letters, marks, numbers, punctuation, symbols and the
//   ASCII space, never U+00A0. The list below is read out of Go by
//   `scripts/gen_goprint.go`, not typed, and the gate fails when it is stale.
// - **Decoding is Go's decoding.** A surrogate, an overlong form and a
//   truncated sequence each decode to U+FFFD *one byte at a time*, so
//   `"\xed\xa0\x80"` quotes as three `\x` escapes, not one.

type GoQuoteError =
    | Syntax

fn hex_digit(v: i64) -> i64 {
    if v < 10 {
        v + 48
    } else {
        v + 87
    }
}

fn push_hex(inout out: [i64], v: i64, digits: i64) {
    var k = digits - 1
    while k >= 0 {
        out.push(hex_digit(v.ushr(4 * k).bit_and(15)))
        k = k - 1
    }
}

fn push_rune(inout out: [i64], r: i64) {
    if r < 128 {
        out.push(r)
    } else if r < 2048 {
        out.push(192 + r.ushr(6))
        out.push(128 + r.bit_and(63))
    } else if r < 65536 {
        out.push(224 + r.ushr(12))
        out.push(128 + r.ushr(6).bit_and(63))
        out.push(128 + r.bit_and(63))
    } else {
        out.push(240 + r.ushr(18))
        out.push(128 + r.ushr(12).bit_and(63))
        out.push(128 + r.ushr(6).bit_and(63))
        out.push(128 + r.bit_and(63))
    }
}

/// `utf8.ValidRune`: in range, and not a surrogate.
pub fn valid_rune(r: i64) -> bool {
    (r >= 0 and r < 55296) or (r > 57343 and r <= 1114111)
}

fn cont(b: bytes, at: i64, lo: i64, hi: i64) -> bool {
    at < b.len() and b.at(at) >= lo and b.at(at) <= hi
}

/// `utf8.DecodeRune` at `at`: the rune and how many bytes it took. Anything
/// that is not a complete, shortest, non-surrogate encoding is `(0xFFFD, 1)`.
pub fn decode_rune(b: bytes, at: i64) -> (i64, i64) {
    let c = b.at(at)
    if c < 128 {
        return (c, 1)
    }
    if c >= 194 and c <= 223 {
        if cont(b, at + 1, 128, 191) {
            return (c.bit_and(31).shl(6).bit_or(b.at(at + 1).bit_and(63)), 2)
        }
        return (65533, 1)
    }
    if c >= 224 and c <= 239 {
        let lo = if c == 224 { 160 } else { 128 }
        let hi = if c == 237 { 159 } else { 191 }
        if cont(b, at + 1, lo, hi) and cont(b, at + 2, 128, 191) {
            let r = c.bit_and(15).shl(12)
                .bit_or(b.at(at + 1).bit_and(63).shl(6))
                .bit_or(b.at(at + 2).bit_and(63))
            return (r, 3)
        }
        return (65533, 1)
    }
    if c >= 240 and c <= 244 {
        let lo = if c == 240 { 144 } else { 128 }
        let hi = if c == 244 { 143 } else { 191 }
        if cont(b, at + 1, lo, hi) and cont(b, at + 2, 128, 191) and
        cont(b, at + 3, 128, 191) {
            let r = c.bit_and(7).shl(18)
                .bit_or(b.at(at + 1).bit_and(63).shl(12))
                .bit_or(b.at(at + 2).bit_and(63).shl(6))
                .bit_or(b.at(at + 3).bit_and(63))
            return (r, 4)
        }
        return (65533, 1)
    }
    (65533, 1)
}

fn valid_utf8(b: bytes, from: i64, end: i64) -> bool {
    var at = from
    while at < end {
        let d = decode_rune(b, at)
        if d.1 == 1 and d.0 == 65533 {
            return false
        }
        at = at + d.1
    }
    // A sequence that runs past `end` decoded as valid above only by
    // reading beyond it; one that stops exactly at `end` did not.
    at == end
}

