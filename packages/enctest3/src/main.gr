import quotedprintable
import ascii85
import uuencode

fn from_hex(text: str) -> bytes {
    var out: [i64] = []
    var i = 0
    while i + 1 < text.len() {
        out.push(text.substr(i, 2).parse_int_base(16) ?? 0)
        i = i + 2
    }
    return bytes_of(out)
}

fn to_hex(raw: bytes) -> str {
    let digits = "0123456789abcdef"
    var out = ""
    var i = 0
    while i < raw.len() {
        out = out + digits.substr(raw.at(i) / 16, 1) +
        digits.substr(raw.at(i) % 16, 1)
        i = i + 1
    }
    return out
}

fn main() / {io} {
    var i = 0
    while i + 1 < args().len() {
        let what = args()[i]
        let data = from_hex(args()[i + 1])
        if what == "qpcrlf" {
            print(to_hex(quotedprintable.encode(data, true).to_bytes()))
        } else if what == "qp" {
            print(to_hex(quotedprintable.encode(data, false).to_bytes()))
        } else if what == "qpback" {
            print(to_hex(quotedprintable.decode(data.to_str())))
        } else if what == "qpheader" {
            print(to_hex(quotedprintable.encode_header(data.to_str())
                    .to_bytes()))
        } else if what == "a85" {
            print(to_hex(ascii85.encode(data, true).to_bytes()))
        } else if what == "b85" {
            print(to_hex(ascii85.encode(data, false).to_bytes()))
        } else if what == "a85back" {
            print(to_hex(ascii85.decode(data.to_str(), true) ??
                bytes_of([255])))
        } else if what == "uu" {
            print(to_hex(uuencode.encode_line(data).to_bytes()))
        } else if what == "uuback" {
            print(to_hex(uuencode.decode_line(data.to_str()) ??
                bytes_of([255])))
        }
        i = i + 2
    }
}
