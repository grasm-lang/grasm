// TIFF decode, to pixels.
//
// TIFF is not one format, it is a container with a tag table, and a decoder
// is mostly the business of reading that table and then dispatching to a
// codec. Three of the four codecs that matter were already here -- `lzw`
// even carries `tiff_options()` for TIFF's own bit packing, which is checked
// against Pillow -- so this package is the container plus PackBits.
//
//     1      uncompressed
//     5      LZW, TIFF's packing, optionally with a predictor
//     8/32946 Deflate, through `zlib`
//     32773  PackBits
//
// Both byte orders. Strips, not tiles: a tiled TIFF is rarer than a striped
// one and is refused by name rather than decoded wrongly.
//
// The planes are `bytes` at one byte a sample ([L-LIB-BYTES-WRITE]). A
// 24-megapixel RGB TIFF is 72 MB of samples; as `[i64]` the same decode
// would want 576 MB.
import deflate
import lzw
import zlib

type TiffError =
    | NotTiff
    | Truncated(at: i64)
    | BadTag(tag: i64)
    | Unsupported(what: str, value: i64)
    | Tiled
    | NoImage
    /// Writing only: the pixel buffer is not `width * height * comps`.
    | WrongSize(want: i64, got: i64)

type TiffImage = {
    width: i64,
    height: i64,
    /// 1 for grayscale, 3 for RGB, 4 for RGB with alpha.
    comps: i64,
    pixels: bytes,
}

/// A tag's value, already resolved from inline bytes or an offset.
type Field = {
    tag: i64,
    kind: i64,
    count: i64,
    values: [i64],
}

pub fn tag_width() -> i64 {
    256
}

pub fn tag_height() -> i64 {
    257
}

pub fn tag_bits() -> i64 {
    258
}

pub fn tag_compression() -> i64 {
    259
}

pub fn tag_photometric() -> i64 {
    262
}

pub fn tag_strip_offsets() -> i64 {
    273
}

pub fn tag_samples() -> i64 {
    277
}

pub fn tag_rows_per_strip() -> i64 {
    278
}

pub fn tag_strip_counts() -> i64 {
    279
}

pub fn tag_planar() -> i64 {
    284
}

pub fn tag_predictor() -> i64 {
    317
}

/// The size in bytes of one value of each TIFF field type.
pub fn type_size(kind: i64) -> i64 {
    match kind {
        1 -> 1
        2 -> 1
        3 -> 2
        4 -> 4
        5 -> 8
        6 -> 1
        7 -> 1
        8 -> 2
        9 -> 4
        10 -> 8
        11 -> 4
        12 -> 8
        _ -> 0
    }
}

fn u16_at(d: bytes, i: i64, little: bool) -> i64 {
    if little {
        return d.at(i) + d.at(i + 1) * 256
    }
    d.at(i) * 256 + d.at(i + 1)
}

fn u32_at(d: bytes, i: i64, little: bool) -> i64 {
    if little {
        return d.at(i) +
        d.at(i + 1) * 256 +
        d.at(i + 2) * 65536 +
        d.at(i + 3) * 16777216
    }
    d.at(i) * 16777216 +
    d.at(i + 1) * 65536 +
    d.at(i + 2) * 256 +
    d.at(i + 3)
}

/// True for a little-endian file, which is what `II` means.
pub fn is_little(data: bytes) -> bool {
    data.len() >= 2 and data.at(0) == 73 and data.at(1) == 73
}

pub fn is_tiff(data: bytes) -> bool {
    if data.len() < 8 {
        return false
    }
    let ii = data.at(0) == 73 and data.at(1) == 73
    let mm = data.at(0) == 77 and data.at(1) == 77
    if not (ii or mm) {
        return false
    }
    u16_at(data, 2, ii) == 42
}

/// Read one value of a field, whatever its width.
fn value_at(data: bytes, at: i64, kind: i64, little: bool) -> i64 {
    match kind {
        1 -> data.at(at)
        2 -> data.at(at)
        6 -> data.at(at)
        7 -> data.at(at)
        3 -> u16_at(data, at, little)
        8 -> u16_at(data, at, little)
        4 -> u32_at(data, at, little)
        9 -> u32_at(data, at, little)
        // A rational is two longs; the numerator is what a caller wants.
        5 -> u32_at(data, at, little)
        10 -> u32_at(data, at, little)
        _ -> 0
    }
}

/// Every field of the first image file directory.
///
/// A field's values sit inside the entry when they fit in four bytes and at
/// an offset when they do not, which is the one thing about TIFF that catches
/// every first implementation.
pub fn fields(data: bytes) -> [Field] ! TiffError {
    if not is_tiff(data) {
        fail(NotTiff)
    }
    let little = is_little(data)
    let ifd = u32_at(data, 4, little)
    if ifd + 2 > data.len() {
        fail(Truncated(ifd))
    }
    let n = u16_at(data, ifd, little)
    var out: [Field] = []
    var i = 0
    while i < n {
        let e = ifd + 2 + i * 12
        if e + 12 > data.len() {
            fail(Truncated(e))
        }
        let kind = u16_at(data, e + 2, little)
        let count = u32_at(data, e + 4, little)
        let size = type_size(kind)
        var values: [i64] = []
        if size > 0 and count > 0 {
            let inline = count * size <= 4
            let base = if inline { e + 8 } else { u32_at(data, e + 8, little) }
            // A count of thousands is a colour map, and nothing here reads
            // one; the first few values are what every tag below needs.
            let want = if count > 64 { 64 } else { count }
            var k = 0
            while k < want {
                let at = base + k * size
                if at + size <= data.len() {
                    values.push(value_at(data, at, kind, little))
                }
                k = k + 1
            }
        }
        out.push(Field{ tag: u16_at(data, e, little), kind: kind, count: count, values: values })
        i = i + 1
    }
    out
}

/// The first value of a tag, or `fallback` when the file does not carry it.
pub fn tag_or(fs: [Field], tag: i64, fallback: i64) -> i64 {
    for f in fs {
        if f.tag == tag {
            return f.values.get(0).unwrap_or(fallback)
        }
    }
    fallback
}

/// Every value of a tag.
pub fn tag_all(fs: [Field], tag: i64) -> [i64] {
    for f in fs {
        if f.tag == tag {
            return f.values
        }
    }
    []
}

/// PackBits: a run-length coding where the length byte is signed.
///
/// `n` in 0..127 means the next `n + 1` bytes are literal; `n` in -1..-127
/// means the next byte repeats `1 - n` times; -128 is a no-op that every
/// encoder emits and every decoder must skip.
pub fn unpackbits(src: bytes, expect: i64) -> bytes {
    var out: [i64] = []
    var i = 0
    while i < src.len() and out.len() < expect {
        var n = src.at(i)
        i = i + 1
        if n >= 128 {
            n = n - 256
        }
        if n == 0 - 128 {
            // Skipped, as the specification says.
        } else if n >= 0 {
            var k = 0
            while k <= n and i < src.len() {
                out.push(src.at(i))
                i = i + 1
                k = k + 1
            }
        } else {
            if i < src.len() {
                let b = src.at(i)
                i = i + 1
                var k = 0
                while k < 1 - n {
                    out.push(b)
                    k = k + 1
                }
            }
        }
    }
    bytes_of(out)
}

/// Undo horizontal differencing, which is predictor 2.
///
/// Each sample is stored as its difference from the sample one pixel to the
/// left in the same channel, which makes a photograph compress far better and
/// a decoder that ignores it produce a smear.
pub fn unpredict(inout row: bytes, width: i64, comps: i64) {
    var x = 1
    while x < width {
        var c = 0
        while c < comps {
            let i = x * comps + c
            let prev = row.at(i - comps)
            row.set(i, (row.at(i) + prev) % 256)
            c = c + 1
        }
        x = x + 1
    }
}

/// One strip, decompressed.
fn strip_bytes(
    data: bytes,
    off: i64,
    len: i64,
    compression: i64,
    expect: i64,
) -> bytes ! TiffError {
    if off + len > data.len() {
        fail(Truncated(off))
    }
    let raw = data.slice(off, off + len)
    if compression == 1 {
        return raw
    }
    if compression == 32773 {
        return unpackbits(raw, expect)
    }
    if compression == 5 {
        match lzw.decode(raw, lzw.tiff_options()) {
            Ok(b) -> return b
            Err(_e) -> fail(Unsupported("an LZW strip that did not decode", 5))
        }
    }
    if compression == 8 or compression == 32946 {
        match zlib.decompress(raw, expect + 64) {
            Ok(b) -> return b
            Err(_e) -> fail(Unsupported("a Deflate strip that did not decode", 8))
        }
    }
    fail(Unsupported("compression", compression))
}

/// Decode a striped TIFF.
pub fn decode(data: bytes) -> TiffImage ! TiffError {
    let fs = try fields(data)
    let width = tag_or(fs, tag_width(), 0)
    let height = tag_or(fs, tag_height(), 0)
    if width <= 0 or height <= 0 {
        fail(NoImage)
    }
    // A tiled file carries TileWidth (322) and no strips.
    if tag_or(fs, 322, 0) != 0 {
        fail(Tiled)
    }
    let bits = tag_or(fs, tag_bits(), 8)
    if bits != 8 {
        fail(Unsupported("bits per sample", bits))
    }
    let comps = tag_or(fs, tag_samples(), 1)
    if comps != 1 and comps != 3 and comps != 4 {
        fail(Unsupported("samples per pixel", comps))
    }
    let planar = tag_or(fs, tag_planar(), 1)
    if planar != 1 {
        fail(Unsupported("planar configuration", planar))
    }
    let compression = tag_or(fs, tag_compression(), 1)
    let predictor = tag_or(fs, tag_predictor(), 1)
    if predictor != 1 and predictor != 2 {
        fail(Unsupported("predictor", predictor))
    }
    let photometric = tag_or(fs, tag_photometric(), 1)
    if photometric != 0 and photometric != 1 and photometric != 2 {
        fail(Unsupported("photometric interpretation", photometric))
    }
    let offsets = tag_all(fs, tag_strip_offsets())
    let counts = tag_all(fs, tag_strip_counts())
    if offsets.len() == 0 {
        fail(NoImage)
    }
    var rows_per = tag_or(fs, tag_rows_per_strip(), height)
    if rows_per <= 0 {
        rows_per = height
    }
    let stride = width * comps
    var out = bytes_filled(stride * height, 0)
    var s = 0
    var row = 0
    while s < offsets.len() and row < height {
        let rows = if row + rows_per > height { height - row } else { rows_per }
        let expect = stride * rows
        let strip = try strip_bytes(
            data,
            offsets.get(s).unwrap_or(0),
            counts.get(s).unwrap_or(0),
            compression,
            expect,
        )
        var r = 0
        while r < rows and row + r < height {
            let from = r * stride
            if from + stride <= strip.len() {
                var line = strip.slice(from, from + stride)
                if predictor == 2 {
                    unpredict(line, width, comps)
                }
                out.copy_from((row + r) * stride, line)
            }
            r = r + 1
        }
        row = row + rows
        s = s + 1
    }
    // Photometric 0 is white-is-zero, so the samples are inverted.
    if photometric == 0 {
        var i = 0
        while i < out.len() {
            out.set(i, 255 - out.at(i))
            i = i + 1
        }
    }
    return TiffImage{ width: width, height: height, comps: comps, pixels: out }
}

test "a file that is not a TIFF is not mistaken for one" {
    assert(not is_tiff(bytes_of([])))
    // Seven bytes cannot carry a header, whatever they say.
    assert(not is_tiff(bytes_of([73, 73, 42, 0, 8, 0, 0])))
    // `II` then 42 little-endian is a TIFF; 42 written big-endian is not.
    assert(is_tiff(bytes_of([73, 73, 42, 0, 8, 0, 0, 0])))
    assert(not is_tiff(bytes_of([73, 73, 0, 42, 8, 0, 0, 0])))
    assert(is_tiff(bytes_of([77, 77, 0, 42, 0, 0, 0, 8, 0])))
    assert(not is_tiff(bytes_of([80, 75, 3, 4, 0, 0, 0, 0, 0])))
}

test "byte order is read from the magic rather than assumed" {
    assert(is_little(bytes_of([73, 73, 42, 0])))
    assert(not is_little(bytes_of([77, 77, 0, 42])))
}

test "every field type has the size the specification gives it" {
    for pair in [[1, 1], [2, 1], [3, 2], [4, 4], [5, 8], [8, 2], [9, 4], [11, 4], [12, 8]] {
        assert_eq(type_size(pair.get(0).unwrap_or(0)), pair.get(1).unwrap_or(0))
    }
    // An unknown type has no size, which is how a field with one is skipped.
    assert_eq(type_size(99), 0)
}

test "packbits expands literals, runs, and skips the no-op" {
    // 2 means three literals; -3 means the next byte four times.
    assert_eq(unpackbits(bytes_of([2, 10, 20, 30]), 3).to_list(), [10, 20, 30])
    assert_eq(unpackbits(bytes_of([253, 7]), 4).to_list(), [7, 7, 7, 7])
    // 128 is -128, which every encoder emits and every decoder must skip.
    assert_eq(unpackbits(bytes_of([128, 0, 5]), 1).to_list(), [5])
    assert_eq(unpackbits(bytes_of([]), 4).len(), 0)
}

test "packbits stops at the length the caller expects" {
    // A run longer than the row must not run past the end of it.
    assert_eq(unpackbits(bytes_of([2, 1, 2, 3, 2, 4, 5, 6]), 3).len(), 3)
}

test "horizontal differencing is undone left to right" {
    // Three RGB pixels: 10,20,30 then +1 each, then +1 again.
    var row = bytes_of([10, 20, 30, 1, 1, 1, 1, 1, 1])
    unpredict(row, 3, 3)
    assert_eq(row.to_list(), [10, 20, 30, 11, 21, 31, 12, 22, 32])
}

test "differencing wraps at a byte, as the stored difference does" {
    var row = bytes_of([250, 0, 0, 10, 0, 0])
    unpredict(row, 2, 3)
    assert_eq(row.at(3), 4)
}

// --- writing ---------------------------------------------------------------

/// PackBits, the run-length coding TIFF calls 32773.
///
/// A run of two or more identical bytes becomes `(257 - n, byte)`; anything
/// else becomes a literal `(n - 1, bytes)`. Both counts cap at 128, and the
/// byte 128 is a no-op that is never written -- the decoder in this file has
/// a note about reading one.
///
/// A run of exactly two costs the same as two literals, so it is only worth
/// coding when it is longer, except at the start of a literal where breaking
/// out is free.
pub fn packbits_encode(data: bytes) -> bytes {
    var out: [i64] = []
    var at = 0
    while at < data.len() {
        let run = run_length(data, at)
        if run >= 3 {
            out.push(257 - run)
            out.push(data.at(at))
            at = at + run
        } else {
            let n = literal_length(data, at)
            out.push(n - 1)
            var k = 0
            while k < n {
                out.push(data.at(at + k))
                k = k + 1
            }
            at = at + n
        }
    }
    bytes_of(out)
}

/// How many identical bytes start at `at`, capped where the count field ends.
fn run_length(data: bytes, at: i64) -> i64 {
    var run = 1
    while at + run < data.len() and run < 128 and data.at(at + run) == data.at(at) {
        run = run + 1
    }
    run
}

/// How many bytes to emit literally before a run of three is worth coding.
///
/// A run of two costs the same either way, so it stays inside the literal;
/// breaking out for it would make the output longer, not shorter.
fn literal_length(data: bytes, at: i64) -> i64 {
    var n = 0
    while at + n < data.len() and n < 128 {
        if run_length(data, at + n) >= 3 {
            break
        }
        n = n + 1
    }
    if n == 0 {
        return 1
    }
    n
}

fn put16(inout out: [i64], v: i64) {
    out.push(v.bit_and(255))
    out.push(v.shr(8).bit_and(255))
}

fn put32(inout out: [i64], v: i64) {
    out.push(v.bit_and(255))
    out.push(v.shr(8).bit_and(255))
    out.push(v.shr(16).bit_and(255))
    out.push(v.shr(24).bit_and(255))
}

/// One IFD entry: tag, type, count, and either the value or an offset to it.
///
/// A value of four bytes or fewer lives in the entry; anything longer is an
/// offset. Getting that boundary wrong writes a file whose tags point at the
/// middle of the pixels, which readers report as a corrupt image rather than
/// as a bad tag.
fn entry(inout out: [i64], tag: i64, kind: i64, count: i64, value: i64) {
    put16(out, tag)
    put16(out, kind)
    put32(out, count)
    if kind == 3 and count == 1 {
        // A SHORT sits in the first two bytes of the field, not the last.
        put16(out, value)
        put16(out, 0)
    } else {
        put32(out, value)
    }
}

/// Write a baseline striped TIFF, little-endian, one strip.
///
/// `compression` is 1 (none), 8 (Deflate) or 32773 (PackBits) -- three of
/// the four this file reads. LZW is not written: `lzw` can code it, but the
/// patent-era packing has enough corners that writing one without a reader
/// to check against is how a subtly wrong file gets shipped, and Pillow
/// reads what this writes.
///
/// One strip rather than several. A striped file with `RowsPerStrip` equal
/// to the height is valid and is what most writers emit for a small image;
/// several strips would be a second thing to get wrong for no gain here.
pub fn encode(image: TiffImage, compression: i64) -> bytes ! TiffError {
    if image.comps != 1 and image.comps != 3 and image.comps != 4 {
        fail(Unsupported("samples per pixel", image.comps))
    }
    let expect = image.width * image.height * image.comps
    if image.pixels.len() != expect {
        fail(WrongSize(expect, image.pixels.len()))
    }
    var body = image.pixels
    if compression == 32773 {
        body = packbits_encode(image.pixels)
    } else if compression == 8 {
        body = deflate.compress_zlib(image.pixels, zlib.adler32(image.pixels))
    } else if compression != 1 {
        fail(Unsupported("compression for writing", compression))
    }

    // Header, then the pixels, then the tag table. The table goes last so
    // its offsets are known without a second pass.
    var out: [i64] = [73, 73]
    put16(out, 42)
    put32(out, 8 + body.len())
    var i = 0
    while i < body.len() {
        out.push(body.at(i))
        i = i + 1
    }

    let ifd_at = 8 + body.len()
    // Tags must be written in ascending order, and a reader is entitled to
    // binary-search them. Twelve bytes an entry, two for the count, four for
    // the next-IFD pointer.
    var count = 10
    if image.comps == 4 {
        count = 11
    }
    let after = ifd_at + 2 + count * 12 + 4
    // BitsPerSample is one SHORT a sample, so it only fits in the entry when
    // there are two or fewer.
    var bits_value = 8
    if image.comps > 2 {
        bits_value = after
    }

    put16(out, count)
    entry(out, tag_width(), 4, 1, image.width)
    entry(out, tag_height(), 4, 1, image.height)
    entry(out, tag_bits(), 3, image.comps, bits_value)
    entry(out, tag_compression(), 3, 1, compression)
    // 1 is black-is-zero, 2 is RGB.
    entry(out, tag_photometric(), 3, 1, if image.comps == 1 { 1 } else { 2 })
    entry(out, tag_strip_offsets(), 4, 1, 8)
    entry(out, tag_samples(), 3, 1, image.comps)
    entry(out, tag_rows_per_strip(), 4, 1, image.height)
    entry(out, tag_strip_counts(), 4, 1, body.len())
    entry(out, tag_planar(), 3, 1, 1)
    if image.comps == 4 {
        // ExtraSamples: 2 is unassociated alpha. Without it a reader is
        // within its rights to treat the fourth sample as premultiplied and
        // divide the colour by it.
        entry(out, 338, 3, 1, 2)
    }
    // No second IFD.
    put32(out, 0)
    if image.comps > 2 {
        var k = 0
        while k < image.comps {
            put16(out, 8)
            k = k + 1
        }
    }
    bytes_of(out)
}

test "PackBits codes a run as a count and a byte" {
    // Five of the same: 257 - 5 = 252, then the byte.
    let coded = packbits_encode(bytes_of([9, 9, 9, 9, 9]))
    assert_eq(coded.len(), 2)
    assert_eq(coded.at(0), 252)
    assert_eq(coded.at(1), 9)
}

test "PackBits leaves bytes that do not repeat alone" {
    // Four literals: the count is n - 1, then the bytes.
    let coded = packbits_encode(bytes_of([1, 2, 3, 4]))
    assert_eq(coded.len(), 5)
    assert_eq(coded.at(0), 3)
    assert_eq(coded.at(1), 1)
    assert_eq(coded.at(4), 4)
}

test "a run of two stays inside a literal" {
    // Coding it costs two bytes and leaving it costs two, so breaking the
    // literal to code it would only add a header.
    let coded = packbits_encode(bytes_of([1, 2, 2, 3]))
    assert_eq(coded.at(0), 3)
    assert_eq(coded.len(), 5)
}

test "what PackBits writes, this file reads back" {
    for src in [
        [5, 5, 5, 5, 5, 1, 2, 3],
        [1],
        [7, 7],
        [0, 0, 0, 1, 1, 1, 2, 2, 2],
    ] {
        let original = bytes_of(src)
        let coded = packbits_encode(original)
        let back = unpackbits(coded, original.len())
        assert_eq(back.len(), original.len())
        for i in 0..original.len() {
            assert_eq(back.at(i), original.at(i))
        }
    }
}

test "a run longer than the count field is split" {
    // 300 identical bytes cannot be one run: the count stops at 128.
    var src: [i64] = []
    for _i in 0..300 {
        src.push(42)
    }
    let coded = packbits_encode(bytes_of(src))
    // Three runs at most, two bytes each, and far smaller than the input.
    assert(coded.len() <= 8)
    assert(coded.len() * 10 < 300)
}

test "writing refuses a pixel buffer of the wrong size" {
    let img = TiffImage{ width: 4, height: 4, comps: 3, pixels: bytes_filled(10, 0) }
    match encode(img, 1) {
        Ok(_b) -> assert(false)
        Err(_e) -> assert(true)
    }
}

test "a written TIFF starts with the little-endian magic" {
    let img = TiffImage{ width: 2, height: 2, comps: 1, pixels: bytes_filled(4, 7) }
    match encode(img, 1) {
        Err(_e) -> assert(false)
        Ok(b) -> {
            assert_eq(b.at(0), 73)
            assert_eq(b.at(1), 73)
            assert_eq(b.at(2), 42)
            assert_eq(b.at(3), 0)
            assert(is_tiff(b))
        }
    }
}

test "what is written reads back through this package too" {
    var px: [i64] = []
    for i in 0..(6 * 5 * 3) {
        px.push((i * 11) % 256)
    }
    let img = TiffImage{ width: 6, height: 5, comps: 3, pixels: bytes_of(px) }
    for codec in [1, 8, 32773] {
        match encode(img, codec) {
            Err(_e) -> assert(false)
            Ok(b) -> {
                match decode(b) {
                    Err(_e) -> assert(false)
                    Ok(back) -> {
                        assert_eq(back.width, 6)
                        assert_eq(back.height, 5)
                        assert_eq(back.comps, 3)
                        for i in 0..px.len() {
                            assert_eq(back.pixels.at(i), px.get(i).unwrap_or(0))
                        }
                    }
                }
            }
        }
    }
}
