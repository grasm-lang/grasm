// Syslog messages, both formats, in and out.
//
// Two formats share the wire and only one of them is specified. RFC 3164 is
// the older one, and it is a description of what implementations were already
// doing rather than a design: its timestamp has no year and no timezone, its
// day-of-month is space-padded to two characters, and the hostname and the
// program name are told apart by guessing. RFC 5424 replaced it with a real
// grammar, a full timestamp and structured data.
//
// A parser has to accept both, because the ones sending 3164 are the devices
// nobody will be updating. So this reads either and writes either, and says
// which it read.

type SyslogMessage = {
    facility: i64,
    severity: i64,
    /// 1 for RFC 5424, 0 for RFC 3164.
    version: i64,
    timestamp: str,
    hostname: str,
    app_name: str,
    process_id: str,
    message_id: str,
    /// Raw `[id key="value"]` groups, unparsed.
    structured_data: str,
    message: str,
}

type SyslogError =
    | NoPriority(text: str)
    | BadPriority(value: i64)
    | Truncated(text: str)

pub let EMERGENCY = 0
pub let ALERT = 1
pub let CRITICAL = 2
pub let ERROR = 3
pub let WARNING = 4
pub let NOTICE = 5
pub let INFO = 6
pub let DEBUG = 7

pub let KERNEL = 0
pub let USER = 1
pub let MAIL = 2
pub let DAEMON = 3
pub let AUTH = 4
pub let SYSLOG = 5
pub let LOCAL0 = 16

/// A message with the fields a program actually fills in, and `-` for the
/// rest.
pub fn message(facility: i64, severity: i64, timestamp: str, hostname: str,
    app_name: str, text: str) -> SyslogMessage {
    return SyslogMessage{
        facility: facility, severity: severity, version: 1,
        timestamp: timestamp, hostname: hostname, app_name: app_name,
        process_id: "", message_id: "", structured_data: "", message: text,
    }
}

pub fn severity_name(level: i64) -> str {
    let names = ["emerg", "alert", "crit", "err", "warning", "notice",
        "info", "debug"]
    if level < 0 or level > 7 {
        return "unknown"
    }
    return names[level]
}

pub fn facility_name(facility: i64) -> str {
    let names = ["kern", "user", "mail", "daemon", "auth", "syslog", "lpr",
        "news", "uucp", "cron", "authpriv", "ftp", "ntp", "audit", "alert",
        "cron2", "local0", "local1", "local2", "local3", "local4", "local5",
        "local6", "local7"]
    if facility < 0 or facility >= names.len() {
        return "unknown"
    }
    return names[facility]
}

/// The priority is one number holding two: `facility * 8 + severity`.
///
/// Packed rather than sent as two fields because the format predates anyone
/// worrying about that, and every parser has to unpack it the same way.
pub fn priority_of(facility: i64, severity: i64) -> i64 {
    return facility * 8 + severity
}

pub fn facility_of(priority: i64) -> i64 {
    return priority / 8
}

pub fn severity_of(priority: i64) -> i64 {
    return priority % 8
}

/// RFC 5424: `<pri>1 timestamp host app procid msgid [sd] message`.
///
/// A field with nothing in it is `-`, never empty — an empty field would be
/// two spaces in a row and the grammar has no way to count them.
pub fn format_5424(m: SyslogMessage) -> str {
    let priority = priority_of(m.facility, m.severity)
    let sd = if m.structured_data == "" { "-" } else { m.structured_data }
    let host = if m.hostname == "" { "-" } else { m.hostname }
    let app = if m.app_name == "" { "-" } else { m.app_name }
    let pid = if m.process_id == "" { "-" } else { m.process_id }
    let mid = if m.message_id == "" { "-" } else { m.message_id }
    return "<{priority}>1 {m.timestamp} {host} {app} {pid} {mid} {sd} {m.message}"
}

/// RFC 3164: `<pri>Mmm dd hh:mm:ss host tag: message`.
///
/// The day is space-padded, not zero-padded — "Jun  5" has two spaces, and a
/// parser splitting on whitespace runs have to cope with that.
pub fn format_3164(m: SyslogMessage) -> str {
    let priority = priority_of(m.facility, m.severity)
    var tag = m.app_name
    if m.process_id != "" and m.process_id != "-" {
        tag = "{tag}[{m.process_id}]"
    }
    return "<{priority}>{m.timestamp} {m.hostname} {tag}: {m.message}"
}

fn split_once(text: str, sep: str) -> (str, str) {
    match text.index_of(sep) {
        Some(at) -> return (text.substr(0, at),
            text.substr(at + sep.len(), text.len() - at - sep.len()))
        None -> return (text, "")
    }
}

/// Read the `[a b="c"]` groups off the front, respecting escaped brackets.
fn take_structured(text: str) -> (str, str) {
    if text.starts_with("-") {
        return ("", text.substr(1, text.len() - 1).trim_start())
    }
    if not text.starts_with("[") {
        return ("", text)
    }
    let cs = text.chars()
    var i = 0
    var depth = 0
    var quoted = false
    while i < cs.len() {
        let c = cs[i]
        if c == "\\" {
            i = i + 2
            continue
        }
        if c == "\"" {
            quoted = not quoted
        } else if not quoted and c == "[" {
            depth = depth + 1
        } else if not quoted and c == "]" {
            depth = depth - 1
            if depth == 0 and (i + 1 >= cs.len() or cs[i + 1] != "[") {
                return (text.substr(0, i + 1),
                    text.substr(i + 1, text.len() - i - 1).trim_start())
            }
        }
        i = i + 1
    }
    return (text, "")
}

pub fn parse(line: str) -> SyslogMessage ! SyslogError {
    if not line.starts_with("<") {
        fail(NoPriority(line))
    }
    let close = line.index_of(">") ?? 0 - 1
    if close < 1 {
        fail(NoPriority(line))
    }
    let priority = line.substr(1, close - 1).parse_int() ?? 0 - 1
    if priority < 0 or priority > 191 {
        fail(BadPriority(priority))
    }
    var rest = line.substr(close + 1, line.len() - close - 1)
    // A version number and a space means RFC 5424; anything else is 3164.
    if rest.starts_with("1 ") {
        rest = rest.substr(2, rest.len() - 2)
        let a = split_once(rest, " ")
        let b = split_once(a.1, " ")
        let c = split_once(b.1, " ")
        let d = split_once(c.1, " ")
        let e = split_once(d.1, " ")
        let sd = take_structured(e.1)
        return SyslogMessage{
            facility: facility_of(priority), severity: severity_of(priority),
            version: 1, timestamp: a.0, hostname: undash(b.0),
            app_name: undash(c.0), process_id: undash(d.0),
            message_id: undash(e.0), structured_data: sd.0, message: sd.1,
        }
    }
    // RFC 3164: the timestamp is exactly fifteen characters, "Mmm dd
    // hh:mm:ss", with the day *space*-padded. Splitting on whitespace and
    // rejoining loses that second space, and the format is fixed-width
    // precisely so a reader does not have to guess.
    if rest.len() < 16 {
        fail(Truncated(line))
    }
    let stamp = rest.substr(0, 15)
    var tail = rest.substr(16, rest.len() - 16).split(" ")
    var host = ""
    while tail.len() > 0 and host == "" {
        host = tail[0]
        tail = tail.slice(1, tail.len())
    }
    var app = ""
    var pid = ""
    var body = tail.join(" ")
    if tail.len() > 0 and tail[0].ends_with(":") {
        var tag = tail[0].substr(0, tail[0].len() - 1)
        match tag.index_of("[") {
            Some(open) -> {
                pid = tag.substr(open + 1, tag.len() - open - 2)
                tag = tag.substr(0, open)
            }
            None -> {}
        }
        app = tag
        body = tail.slice(1, tail.len()).join(" ")
    }
    return SyslogMessage{
        facility: facility_of(priority), severity: severity_of(priority),
        version: 0, timestamp: stamp, hostname: host,
        app_name: app, process_id: pid, message_id: "",
        structured_data: "", message: body,
    }
}

fn undash(field: str) -> str {
    if field == "-" {
        return ""
    }
    return field
}

/// Escape a value for structured data: `"`, `\` and `]` only.
///
/// Three characters, and no others — escaping more produces something a
/// conforming reader will hand back with the backslashes still in it.
pub fn escape_value(value: str) -> str {
    return value.replace("\\", "\\\\").replace("\"", "\\\"").replace("]", "\\]")
}

pub fn structured_element(id: str, keys: [str], values: [str]) -> str {
    var out = "[{id}"
    for i in 0..keys.len() {
        if i < values.len() {
            let v = escape_value(values[i])
            out = out + " {keys[i]}=\"{v}\""
        }
    }
    return out + "]"
}

/// Whether a message is at or above a severity — remembering that lower is
/// worse, which is the one thing everybody gets backwards.
pub fn at_least(m: SyslogMessage, severity: i64) -> bool {
    return m.severity <= severity
}

/// The line's total length, which matters: RFC 5424 guarantees only 480
/// bytes over UDP, and a receiver may cut anything longer.
pub fn is_safe_length(line: str) -> bool {
    return line.byte_len() <= 480
}
