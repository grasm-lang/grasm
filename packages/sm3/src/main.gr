// SM3, China's national hash function (GB/T 32905-2016, ISO/IEC 10118-3).
//
// A 256-bit Merkle-Damgard hash in SHA-256's family: 512-bit blocks,
// eight 32-bit chaining words, 64 rounds. It differs in the parts that
// matter to its security margin: each block is expanded to 68 words plus
// 64 differences, the first sixteen rounds use XOR where the rest use
// majority and choice, and two permutations P0 and P1 of rotations and
// XORs diffuse the state.
//
// SM3 is the hash of the SM2 signature and key-exchange suite, of China's
// TLS suites (RFC 8998), of TPM 2.0's SM3_256 bank, and of Chinese
// commercial PKI. Its MAC is HMAC-SM3, from `hmac`.
//
// Checked against OpenSSL's SM3 and HMAC-SM3.

let M32 = 4294967295

fn rotl(x: i64, n: i64) -> i64 {
    let m = n % 32
    return if m == 0 { x } else { x.shl(m).bit_or(x.ushr(32 - m)).bit_and(M32) }
}

fn p0(x: i64) -> i64 {
    return x.bit_xor(rotl(x, 9)).bit_xor(rotl(x, 17))
}

fn p1(x: i64) -> i64 {
    return x.bit_xor(rotl(x, 15)).bit_xor(rotl(x, 23))
}

pub fn hash(message: bytes) -> bytes {
    var v = [0x7380166F, 0x4914B2B9, 0x172442D7, 0xDA8A0600, 0xA96F30BC, 0x163138AA, 0xE38DEE4D, 0xB0FB0E4E]
    var data = message.to_list()
    data.push(128)
    while data.len() % 64 != 56 {
        data.push(0)
    }
    let bits = message.len() * 8
    for i in 0..8 {
        data.push(bits.ushr(8 * (7 - i)).bit_and(255))
    }
    var at = 0
    while at < data.len() {
        var w: [i64] = []
        for i in 0..16 {
            let p = at + 4 * i
            w.push(data[p].shl(24).bit_or(data[p + 1].shl(16)).bit_or(data[p + 2].shl(8)).bit_or(data[p + 3]))
        }
        for j in 16..68 {
            w.push(p1(w[j - 16].bit_xor(w[j - 9]).bit_xor(rotl(w[j - 3], 15))).bit_xor(rotl(w[j - 13], 7)).bit_xor(w[j - 6]))
        }
        var a = v[0]
        var b = v[1]
        var c = v[2]
        var d = v[3]
        var e = v[4]
        var f = v[5]
        var g = v[6]
        var h = v[7]
        for j in 0..64 {
            let t = if j < 16 { 0x79CC4519 } else { 0x7A879D8A }
            let ss1 = rotl((rotl(a, 12) + e + rotl(t, j)).bit_and(M32), 7)
            let ss2 = ss1.bit_xor(rotl(a, 12))
            let ff = if j < 16 { a.bit_xor(b).bit_xor(c) } else { a.bit_and(b).bit_or(a.bit_and(c)).bit_or(b.bit_and(c)) }
            let gg = if j < 16 { e.bit_xor(f).bit_xor(g) } else { e.bit_and(f).bit_or(e.bit_not().bit_and(M32).bit_and(g)) }
            let tt1 = (ff + d + ss2 + w[j].bit_xor(w[j + 4])).bit_and(M32)
            let tt2 = (gg + h + ss1 + w[j]).bit_and(M32)
            d = c
            c = rotl(b, 9)
            b = a
            a = tt1
            h = g
            g = rotl(f, 19)
            f = e
            e = p0(tt2)
        }
        let next = [a, b, c, d, e, f, g, h]
        for i in 0..8 {
            v[i] = v[i].bit_xor(next[i])
        }
        at = at + 64
    }
    var out: [i64] = []
    for x in v {
        out = out + [x.ushr(24).bit_and(255), x.ushr(16).bit_and(255), x.ushr(8).bit_and(255), x.bit_and(255)]
    }
    return bytes_of(out)
}
