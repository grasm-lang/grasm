// Sample arithmetic: gain, fades, filters, echo, resampling, metering.
//
// Audio is the one place where "close enough" has a definition, so the
// arithmetic here is written to match implementations that already exist
// rather than to be defensible on its own. The filters are the RBJ Audio EQ
// Cookbook, which is what ffmpeg's `biquad`, `lowpass` and `highpass` are;
// `echo` is ffmpeg's `aecho` with the same argument meanings; `fade` is
// `afade` with the same curves. `scripts/audio_diff.sh` runs both.
//
// Two decisions worth stating:
//
//   - **A buffer is `[f64]`, one channel, normalized to -1.0..1.0.** Samples
//     arrive from a file as integers of some width, and every operation that
//     follows — a gain of 0.7, a filter, a sum of four tracks — leaves that
//     grid. Rounding back to integers once, at the end, is one rounding; doing
//     it after every stage is a different program that sounds worse.
//
//   - **Nothing here reads a file or a clock, and nothing captures state.**
//     That is what lets a mixdown run through `par_map`: a function that
//     touches no `ref` and no effect can be handed a slice of the timeline on
//     another core. It is the only multicore this language has.
//
// The difference equation used for every filter is direct form 1,
//
//     y[n] = b0·x[n] + b1·x[n-1] + b2·x[n-2] - a1·y[n-1] - a2·y[n-2]
//
// with the coefficients already divided by a0, which is how ffmpeg takes them
// and how the cookbook prints them.

type DspError =
    | BadRate(rate: i64)
    | BadQ(q: f64)
    | BadRange(what: str)

/// A second-order section, normalized by a0 — a biquad, named for what it is
/// rather than for the shape of its equation, because `loudness` already has
/// a `Biquad` and types share one namespace across a program ([T-MODULE-NS]).
type Section = {
    b0: f64,
    b1: f64,
    b2: f64,
    a1: f64,
    a2: f64,
}

let PI = 3.141592653589793
let LN10 = 2.302585092994046

/// `x` raised to `y`, for positive `x`.
//
// There is no `pow` on `f64` in this language, and the exponents here are all
// of the form 10^(dB/20), so this is the identity every audio program uses
// anyway.
pub fn powf(x: f64, y: f64) -> f64 {
    if x == 0.0 {
        return 0.0
    }
    return (y * x.ln()).exp()
}

/// A decibel figure as a multiplier: -6 dB is about 0.501.
pub fn db_to_gain(db: f64) -> f64 {
    return (db / 20.0 * LN10).exp()
}

/// The inverse, with silence reported as -infinity's stand-in rather than a
/// number that would make a meter draw a full bar.
pub fn gain_to_db(gain: f64) -> f64 {
    let g = gain.abs()
    if g <= 0.0 {
        return -144.0
    }
    return 20.0 * g.log10()
}

/// Every sample multiplied by the same figure.
pub fn gain(buf: [f64], db: f64) -> [f64] {
    let g = db_to_gain(db)
    var out: [f64] = []
    for x in buf {
        out.push(x * g)
    }
    return out
}

/// Every sample multiplied by a plain factor, which is what a fader holds.
pub fn scale(buf: [f64], factor: f64) -> [f64] {
    var out: [f64] = []
    for x in buf {
        out.push(x * factor)
    }
    return out
}

/// The largest absolute sample.
pub fn peak(buf: [f64]) -> f64 {
    var top = 0.0
    for x in buf {
        let a = x.abs()
        if a > top {
            top = a
        }
    }
    return top
}

/// Root mean square, the figure a loudness meter averages.
pub fn rms(buf: [f64]) -> f64 {
    if buf.len() == 0 {
        return 0.0
    }
    var sum = 0.0
    for x in buf {
        sum = sum + x * x
    }
    return (sum / buf.len().as_f64()).sqrt()
}

pub fn peak_db(buf: [f64]) -> f64 {
    return gain_to_db(peak(buf))
}

pub fn rms_db(buf: [f64]) -> f64 {
    return gain_to_db(rms(buf))
}

/// How many samples are at or past full scale — the ones a converter cannot
/// represent and a file clips.
pub fn clipped(buf: [f64]) -> i64 {
    var n = 0
    for x in buf {
        if x >= 1.0 or x <= -1.0 {
            n = n + 1
        }
    }
    return n
}

/// Held inside full scale by hard limiting, which is what a file write does
/// anyway — done here so it can be counted first.
pub fn clamp(buf: [f64]) -> [f64] {
    var out: [f64] = []
    for x in buf {
        if x > 1.0 {
            out.push(1.0)
        } else if x < -1.0 {
            out.push(-1.0)
        } else {
            out.push(x)
        }
    }
    return out
}

/// Scaled so the loudest sample sits at `target_db`. Silence is left alone
/// rather than multiplied by infinity.
pub fn normalise(buf: [f64], target_db: f64) -> [f64] {
    let top = peak(buf)
    if top <= 0.0 {
        return buf
    }
    return scale(buf, db_to_gain(target_db) / top)
}

/// The fade shapes, by the names `afade` uses for them.
//
// These are not shapes chosen here: each one is what ffmpeg computes, read off
// its output rather than guessed at. `log` in particular is not the mirror of
// `exp` that its name suggests — it is `1 + log10(t)/5`, which reaches 0.8 a
// tenth of the way in, and a fade that used the obvious formula instead would
// be audibly wrong for the first fifth of every fade.
pub let FADE_LINEAR = 0
pub let FADE_QUARTER_SINE = 1
pub let FADE_HALF_SINE = 2
pub let FADE_LOGARITHMIC = 3
pub let FADE_EXPONENTIAL = 4
pub let FADE_SQUARE_ROOT = 5
pub let FADE_QUADRATIC = 6
pub let FADE_CUBIC = 7
pub let FADE_PARABOLA = 8

/// The gain a curve asks for at `t`, which runs 0 to 1 across the fade.
pub fn curve(shape: i64, t: f64) -> f64 {
    if t <= 0.0 {
        return 0.0
    }
    if shape == FADE_QUARTER_SINE {
        return (t * PI / 2.0).sin()
    } else if shape == FADE_HALF_SINE {
        return (1.0 - (t * PI).cos()) / 2.0
    } else if shape == FADE_LOGARITHMIC {
        return 1.0 + t.log10() / 5.0
    } else if shape == FADE_EXPONENTIAL {
        return powf(0.1, (1.0 - t) * 5.0)
    } else if shape == FADE_SQUARE_ROOT {
        return t.sqrt()
    } else if shape == FADE_QUADRATIC {
        return t * t
    } else if shape == FADE_CUBIC {
        return t * t * t
    } else if shape == FADE_PARABOLA {
        return 1.0 - (1.0 - t).sqrt()
    }
    return t
}

/// A fade over the first `count` samples, silent at the start.
pub fn fade_in(buf: [f64], count: i64, shape: i64) -> [f64] {
    var out: [f64] = []
    var i = 0
    while i < buf.len() {
        if i < count and count > 0 {
            out.push(buf[i] * curve(shape, i.as_f64() / count.as_f64()))
        } else {
            out.push(buf[i])
        }
        i = i + 1
    }
    return out
}

/// A fade over the last `count` samples, silent at the end.
pub fn fade_out(buf: [f64], count: i64, shape: i64) -> [f64] {
    var out: [f64] = []
    let start = buf.len() - count
    var i = 0
    while i < buf.len() {
        if i >= start and count > 0 {
            let t = (i - start).as_f64() / count.as_f64()
            out.push(buf[i] * curve(shape, 1.0 - t))
        } else {
            out.push(buf[i])
        }
        i = i + 1
    }
    return out
}

/// Two buffers added sample for sample, the result as long as the longer.
pub fn add(a: [f64], b: [f64]) -> [f64] {
    let n = if a.len() > b.len() { a.len() } else { b.len() }
    var out: [f64] = []
    var i = 0
    while i < n {
        let x = if i < a.len() { a[i] } else { 0.0 }
        let y = if i < b.len() { b[i] } else { 0.0 }
        out.push(x + y)
        i = i + 1
    }
    return out
}

/// `add` at an offset and through a fader, which is what a track is: a clip
/// starting somewhere on a timeline at some level.
pub fn add_at(base: [f64], clip: [f64], at: i64, factor: f64) -> [f64] {
    let need = at + clip.len()
    var out: [f64] = []
    var i = 0
    let n = if base.len() > need { base.len() } else { need }
    while i < n {
        var v = if i < base.len() { base[i] } else { 0.0 }
        if i >= at and i - at < clip.len() {
            v = v + clip[i - at] * factor
        }
        out.push(v)
        i = i + 1
    }
    return out
}

/// `add_at` into a buffer that is already long enough, without building a new
/// one.
//
// `add_at` answers with a fresh buffer, which is the right shape for a
// pipeline and the wrong one for a sum: laying sixty-four clips onto a
// timeline that way copies the whole timeline sixty-four times, and the
// copying dwarfs the filtering it was there to serve. A mixdown that did this
// spent nine tenths of its time in the sum and looked, from the outside, like
// a mixdown that was not using its cores.
pub fn mix_into(inout base: [f64], clip: [f64], at: i64, factor: f64) {
    var i = 0
    while i < clip.len() {
        let where_at = at + i
        if where_at >= 0 and where_at < base.len() {
            base[where_at] = base[where_at] + clip[i] * factor
        }
        i = i + 1
    }
}

/// One mono buffer as a stereo pair, at a position from -1 (left) to 1.
//
// Equal power rather than linear: a linear pan is 3 dB quieter in the middle,
// which is audible as a dip when a source is swept across.
pub fn pan(buf: [f64], position: f64) -> ([f64], [f64]) {
    var p = position
    if p < -1.0 {
        p = -1.0
    }
    if p > 1.0 {
        p = 1.0
    }
    let angle = (p + 1.0) * PI / 4.0
    let l = angle.cos()
    let r = angle.sin()
    return (scale(buf, l), scale(buf, r))
}

/// Samples in the other order.
pub fn reverse(buf: [f64]) -> [f64] {
    var out: [f64] = []
    var i = buf.len() - 1
    while i >= 0 {
        out.push(buf[i])
        i = i - 1
    }
    return out
}

/// A window of the buffer, clipped to what exists rather than failing: a
/// selection that runs past the end of a clip is an ordinary thing for an
/// editor to ask for.
pub fn cut(buf: [f64], from: i64, count: i64) -> [f64] {
    var start = from
    if start < 0 {
        start = 0
    }
    var end = start + count
    if end > buf.len() {
        end = buf.len()
    }
    var out: [f64] = []
    var i = start
    while i < end {
        out.push(buf[i])
        i = i + 1
    }
    return out
}

/// Leading and trailing samples quieter than `threshold_db` removed.
pub fn trim_silence(buf: [f64], threshold_db: f64) -> [f64] {
    let limit = db_to_gain(threshold_db)
    var first = 0
    while first < buf.len() and buf[first].abs() < limit {
        first = first + 1
    }
    var last = buf.len() - 1
    while last >= first and buf[last].abs() < limit {
        last = last - 1
    }
    if last < first {
        return []
    }
    return cut(buf, first, last - first + 1)
}

// --- filters ----------------------------------------------------------------

/// A section built from coefficients already divided by a0.
pub fn biquad(b0: f64, b1: f64, b2: f64, a1: f64, a2: f64) -> Section {
    return Section{ b0: b0, b1: b1, b2: b2, a1: a1, a2: a2 }
}

fn normalised(b0: f64, b1: f64, b2: f64, a0: f64, a1: f64, a2: f64) -> Section {
    return Section{ b0: b0 / a0, b1: b1 / a0, b2: b2 / a0, a1: a1 / a0,
        a2: a2 / a0 }
}

fn omega(rate: i64, hz: f64) -> f64 {
    return 2.0 * PI * hz / rate.as_f64()
}

/// A two-pole low-pass at `hz`, resonance `q` — the cookbook's LPF, which is
/// what `lowpass` is in ffmpeg and `BiquadFilterNode` in a browser.
pub fn lowpass(rate: i64, hz: f64, q: f64) -> Section ! DspError {
    if rate <= 0 {
        fail(BadRate(rate))
    }
    if q <= 0.0 {
        fail(BadQ(q))
    }
    let w = omega(rate, hz)
    let cw = w.cos()
    let alpha = w.sin() / (2.0 * q)
    return normalised((1.0 - cw) / 2.0, 1.0 - cw, (1.0 - cw) / 2.0,
        1.0 + alpha, -2.0 * cw, 1.0 - alpha)
}

/// The same shape, the other way up.
pub fn highpass(rate: i64, hz: f64, q: f64) -> Section ! DspError {
    if rate <= 0 {
        fail(BadRate(rate))
    }
    if q <= 0.0 {
        fail(BadQ(q))
    }
    let w = omega(rate, hz)
    let cw = w.cos()
    let alpha = w.sin() / (2.0 * q)
    return normalised((1.0 + cw) / 2.0, -(1.0 + cw), (1.0 + cw) / 2.0,
        1.0 + alpha, -2.0 * cw, 1.0 - alpha)
}

/// A band around `hz`, at constant 0 dB peak gain.
pub fn bandpass(rate: i64, hz: f64, q: f64) -> Section ! DspError {
    if rate <= 0 {
        fail(BadRate(rate))
    }
    if q <= 0.0 {
        fail(BadQ(q))
    }
    let w = omega(rate, hz)
    let cw = w.cos()
    let alpha = w.sin() / (2.0 * q)
    return normalised(alpha, 0.0, -alpha, 1.0 + alpha, -2.0 * cw, 1.0 - alpha)
}

/// A notch: everything but a band around `hz`.
pub fn notch(rate: i64, hz: f64, q: f64) -> Section ! DspError {
    if rate <= 0 {
        fail(BadRate(rate))
    }
    if q <= 0.0 {
        fail(BadQ(q))
    }
    let w = omega(rate, hz)
    let cw = w.cos()
    let alpha = w.sin() / (2.0 * q)
    return normalised(1.0, -2.0 * cw, 1.0, 1.0 + alpha, -2.0 * cw, 1.0 - alpha)
}

/// A bell: `db` of boost or cut around `hz`, the band of an equaliser.
pub fn peaking(rate: i64, hz: f64, q: f64, db: f64) -> Section ! DspError {
    if rate <= 0 {
        fail(BadRate(rate))
    }
    if q <= 0.0 {
        fail(BadQ(q))
    }
    let a = powf(10.0, db / 40.0)
    let w = omega(rate, hz)
    let cw = w.cos()
    let alpha = w.sin() / (2.0 * q)
    return normalised(1.0 + alpha * a, -2.0 * cw, 1.0 - alpha * a,
        1.0 + alpha / a, -2.0 * cw, 1.0 - alpha / a)
}

/// A shelf that lifts or drops everything below `hz`.
pub fn lowshelf(rate: i64, hz: f64, q: f64, db: f64) -> Section ! DspError {
    if rate <= 0 {
        fail(BadRate(rate))
    }
    if q <= 0.0 {
        fail(BadQ(q))
    }
    let a = powf(10.0, db / 40.0)
    let w = omega(rate, hz)
    let cw = w.cos()
    let alpha = w.sin() / (2.0 * q)
    let root = 2.0 * a.sqrt() * alpha
    return normalised(a * ((a + 1.0) - (a - 1.0) * cw + root),
        2.0 * a * ((a - 1.0) - (a + 1.0) * cw),
        a * ((a + 1.0) - (a - 1.0) * cw - root),
        (a + 1.0) + (a - 1.0) * cw + root,
        -2.0 * ((a - 1.0) + (a + 1.0) * cw),
        (a + 1.0) + (a - 1.0) * cw - root)
}

/// And the one above it.
pub fn highshelf(rate: i64, hz: f64, q: f64, db: f64) -> Section ! DspError {
    if rate <= 0 {
        fail(BadRate(rate))
    }
    if q <= 0.0 {
        fail(BadQ(q))
    }
    let a = powf(10.0, db / 40.0)
    let w = omega(rate, hz)
    let cw = w.cos()
    let alpha = w.sin() / (2.0 * q)
    let root = 2.0 * a.sqrt() * alpha
    return normalised(a * ((a + 1.0) + (a - 1.0) * cw + root),
        -2.0 * a * ((a - 1.0) + (a + 1.0) * cw),
        a * ((a + 1.0) + (a - 1.0) * cw - root),
        (a + 1.0) - (a - 1.0) * cw + root,
        2.0 * ((a - 1.0) - (a + 1.0) * cw),
        (a + 1.0) - (a - 1.0) * cw - root)
}

/// One pass of a section over a buffer, starting from silence.
pub fn filter(buf: [f64], f: Section) -> [f64] {
    var x1 = 0.0
    var x2 = 0.0
    var y1 = 0.0
    var y2 = 0.0
    var out: [f64] = []
    for x in buf {
        let y = f.b0 * x + f.b1 * x1 + f.b2 * x2 - f.a1 * y1 - f.a2 * y2
        x2 = x1
        x1 = x
        y2 = y1
        y1 = y
        out.push(y)
    }
    return out
}

/// Forwards and then backwards, which cancels the phase shift and doubles the
/// slope — what `filtfilt` does, and what an editor's "no phase smearing"
/// option means.
pub fn filter_twice(buf: [f64], f: Section) -> [f64] {
    return reverse(filter(reverse(filter(buf, f)), f))
}

/// Echo, with `aecho`'s arguments: the dry level, the wet level, and a tap
/// per delay with its own decay.
//
// Taps read the *input*, not the output, so this is a finite echo rather than
// a feedback loop that never ends. That is what ffmpeg does, and the
// difference is audible: a feedback echo with decay 0.6 is still ringing long
// after this one has stopped.
pub fn echo(buf: [f64], rate: i64, in_gain: f64, out_gain: f64,
    delays_ms: [f64], decays: [f64]) -> [f64] ! DspError {
    if rate <= 0 {
        fail(BadRate(rate))
    }
    if delays_ms.len() != decays.len() {
        fail(BadRange("a decay per delay"))
    }
    var taps: [i64] = []
    var longest = 0
    for d in delays_ms {
        let n = (d * rate.as_f64() / 1000.0).round().as_i64()
        taps.push(n)
        if n > longest {
            longest = n
        }
    }
    let total = buf.len() + longest
    var out: [f64] = []
    var i = 0
    while i < total {
        var v = if i < buf.len() { buf[i] * in_gain } else { 0.0 }
        var t = 0
        while t < taps.len() {
            let at = i - taps[t]
            if at >= 0 and at < buf.len() {
                v = v + buf[at] * decays[t]
            }
            t = t + 1
        }
        out.push(v * out_gain)
        i = i + 1
    }
    return out
}

// --- rate -------------------------------------------------------------------

/// Resampled by reading between samples in a straight line.
//
// Cheap and wrong in a specific way: the straight line is a low-pass filter
// with a droop near Nyquist and an image above it. Fine for a preview, which
// is what an editor scrubbing a waveform needs; `resample_sinc` is for the
// render.
pub fn resample_linear(buf: [f64], from_rate: i64,
    to_rate: i64) -> [f64] ! DspError {
    if from_rate <= 0 {
        fail(BadRate(from_rate))
    }
    if to_rate <= 0 {
        fail(BadRate(to_rate))
    }
    if from_rate == to_rate or buf.len() == 0 {
        return buf
    }
    let ratio = from_rate.as_f64() / to_rate.as_f64()
    let count = (buf.len().as_f64() / ratio).as_i64()
    var out: [f64] = []
    var i = 0
    while i < count {
        let at = i.as_f64() * ratio
        let left = at.as_i64()
        let frac = at - left.as_f64()
        let a = if left < buf.len() { buf[left] } else { 0.0 }
        let b = if left + 1 < buf.len() { buf[left + 1] } else { a }
        out.push(a + (b - a) * frac)
        i = i + 1
    }
    return out
}

fn sinc(x: f64) -> f64 {
    if x == 0.0 {
        return 1.0
    }
    let p = PI * x
    return p.sin() / p
}

/// Resampled through a windowed sinc of `half_width` samples each side.
//
// The window is Blackman, the kernel is cut off at the lower of the two
// Nyquist frequencies, and that cutoff is the part that matters: leaving it
// at the source's Nyquist when downsampling folds everything above the new
// one back into the audible band, which is the aliasing that makes a cheap
// sample-rate conversion sound metallic.
pub fn resample_sinc(buf: [f64], from_rate: i64, to_rate: i64,
    half_width: i64) -> [f64] ! DspError {
    if from_rate <= 0 {
        fail(BadRate(from_rate))
    }
    if to_rate <= 0 {
        fail(BadRate(to_rate))
    }
    if half_width < 1 {
        fail(BadRange("half_width"))
    }
    if from_rate == to_rate or buf.len() == 0 {
        return buf
    }
    let ratio = from_rate.as_f64() / to_rate.as_f64()
    let cutoff = if ratio > 1.0 { 1.0 / ratio } else { 1.0 }
    let width = if ratio > 1.0 { half_width.as_f64() * ratio } else {
        half_width.as_f64() }
    let count = (buf.len().as_f64() / ratio).as_i64()
    var out: [f64] = []
    var i = 0
    while i < count {
        let at = i.as_f64() * ratio
        let centre = at.as_i64()
        var sum = 0.0
        var weight = 0.0
        var k = centre - width.as_i64() - 1
        let last = centre + width.as_i64() + 1
        while k <= last {
            if k >= 0 and k < buf.len() {
                let d = at - k.as_f64()
                if d.abs() <= width {
                    let t = d / width
                    // Blackman, in the -1..1 form.
                    let w = 0.42 + 0.5 * (PI * t).cos() +
                    0.08 * (2.0 * PI * t).cos()
                    let h = cutoff * sinc(cutoff * d) * w
                    sum = sum + buf[k] * h
                    weight = weight + h
                }
            }
            k = k + 1
        }
        out.push(if weight != 0.0 { sum / weight } else { 0.0 })
        i = i + 1
    }
    return out
}

// --- integers in, integers out ----------------------------------------------

/// Integer samples of `bits` width as -1.0..1.0.
//
// The divisor is the negative full scale, because that is the one a signed
// two's complement sample actually reaches: 16-bit runs -32768..32767, so
// dividing by 32768 puts every representable sample inside the range and
// dividing by 32767 puts one sample outside it.
pub fn from_samples(samples: [i64], bits: i64) -> [f64] ! DspError {
    if bits != 8 and bits != 16 and bits != 24 and bits != 32 {
        fail(BadRange("bits"))
    }
    var scale_by = 1.0
    var i = 1
    while i < bits {
        scale_by = scale_by * 2.0
        i = i + 1
    }
    var out: [f64] = []
    for s in samples {
        out.push(s.as_f64() / scale_by)
    }
    return out
}

/// And back, rounded once and held inside the representable range.
pub fn to_samples(buf: [f64], bits: i64) -> [i64] ! DspError {
    if bits != 8 and bits != 16 and bits != 24 and bits != 32 {
        fail(BadRange("bits"))
    }
    var scale_by = 1.0
    var i = 1
    while i < bits {
        scale_by = scale_by * 2.0
        i = i + 1
    }
    let top = scale_by.as_i64() - 1
    let bottom = 0 - scale_by.as_i64()
    var out: [i64] = []
    for x in buf {
        var v = (x * scale_by).round().as_i64()
        if v > top {
            v = top
        }
        if v < bottom {
            v = bottom
        }
        out.push(v)
    }
    return out
}

/// Interleaved frames split into one buffer per channel.
pub fn deinterleave(samples: [i64], channels: i64,
    bits: i64) -> [[f64]] ! DspError {
    if channels < 1 {
        fail(BadRange("channels"))
    }
    let flat = try from_samples(samples, bits)
    var out: [[f64]] = []
    var c = 0
    while c < channels {
        var one: [f64] = []
        var i = c
        while i < flat.len() {
            one.push(flat[i])
            i = i + channels
        }
        out.push(one)
        c = c + 1
    }
    return out
}

/// One buffer per channel back into interleaved frames.
pub fn interleave(channels: [[f64]], bits: i64) -> [i64] ! DspError {
    if channels.len() == 0 {
        return []
    }
    var longest = 0
    for ch in channels {
        if ch.len() > longest {
            longest = ch.len()
        }
    }
    var flat: [f64] = []
    var i = 0
    while i < longest {
        for ch in channels {
            flat.push(if i < ch.len() { ch[i] } else { 0.0 })
        }
        i = i + 1
    }
    return try to_samples(flat, bits)
}

/// A sine at `hz`, for a test tone and for checking a filter against a
/// frequency whose answer is known.
pub fn tone(hz: f64, samples: i64, rate: i64, amplitude: f64) -> [f64] {
    var out: [f64] = []
    var i = 0
    while i < samples {
        out.push(amplitude * (2.0 * PI * hz * i.as_f64() / rate.as_f64()).sin())
        i = i + 1
    }
    return out
}

/// Silence, which an editor needs as often as it needs sound.
pub fn silence(samples: i64) -> [f64] {
    var out: [f64] = []
    var i = 0
    while i < samples {
        out.push(0.0)
        i = i + 1
    }
    return out
}
