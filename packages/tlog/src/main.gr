// Tamper-evident logs: the Merkle tree behind sum.golang.org, Certificate
// Transparency and Sigstore's Rekor.
//
// An append-only log commits to every record it holds with one hash, the
// root of a binary Merkle tree over the records (RFC 6962's tree: a leaf
// is SHA-256 of 0x00 and the record, an interior node SHA-256 of 0x01 and
// its two children, a tree whose size is not a power of two split at the
// largest power of two below it). Two proofs keep the log honest:
//
// - a record proof shows that record n is in the tree of size t, with
//   about log2(t) hashes;
// - a tree proof shows that the tree of size t extends the tree of size
//   n, so a log that rewrote history is caught.
//
// This keeps the hashes the way `golang.org/x/mod/sumdb/tlog` stores them,
// one flat sequence numbered by `stored_index` with every complete
// subtree's hash written once when its last record arrives, and it serves
// them in tiles: fixed-height slices of the tree named by paths like
// `tile/8/0/x123/456.p/7`, which is how the checksum database lets a
// client fetch a proof as a few cacheable files. A tree head travels as
// the text `go.sum database tree`, the size and the base64 root.
//
// Checked against golang.org/x/mod/sumdb/tlog.
import crypto_hash
import bytes_codec

type TlogError =
    | TlogBadInput(why: str)
    | TlogBadPath(path: str)
    | TlogBadTree

/// The hash of a record's data.
pub fn record_hash(data: bytes) -> bytes {
    return crypto_hash.sha256_of(bytes_of([0]).concat(data))
}

/// The hash of an interior node.
pub fn node_hash(left: bytes, right: bytes) -> bytes {
    return crypto_hash.sha256_of(bytes_of([1]).concat(left).concat(right))
}

/// The hash of the empty tree, SHA-256 of nothing.
pub fn empty_hash() -> bytes {
    return crypto_hash.sha256_of(bytes_of([]))
}

/// Where the hash of the n-th subtree at a level sits in storage.
pub fn stored_index(level: i64, n: i64) -> i64 {
    var m = n
    var l = level
    while l > 0 {
        m = 2 * m + 1
        l = l - 1
    }
    var i = 0
    while m > 0 {
        i = i + m
        m = m / 2
    }
    return i + level
}

fn trailing_zeros(v: i64) -> i64 {
    var x = v
    var n = 0
    while x > 0 and x % 2 == 0 {
        x = x / 2
        n = n + 1
    }
    return n
}

/// The level and position a storage index holds.
pub fn split_stored_index(index: i64) -> (i64, i64) {
    var n = index / 2
    var at = stored_index(0, n)
    while true {
        let x = at + 1 + trailing_zeros(n + 1)
        if x > index {
            break
        }
        n = n + 1
        at = x
    }
    let level = index - at
    return (level, n.shr(level))
}

/// How many hashes a log of n records stores.
pub fn stored_count(n: i64) -> i64 {
    if n == 0 {
        return 0
    }
    var count = stored_index(0, n - 1) + 1
    var i = n - 1
    while i % 2 == 1 {
        count = count + 1
        i = i / 2
    }
    return count
}

/// The hashes to append when record n arrives, given the stored ones so far.
pub fn stored_hashes(n: i64, data: bytes, stored: [bytes]) -> [bytes] {
    var h = record_hash(data)
    var out: [bytes] = [h]
    let m = trailing_zeros(n + 1)
    var i = 0
    while i < m {
        h = node_hash(stored[stored_index(i, n.shr(i) - 1)], h)
        out.push(h)
        i = i + 1
    }
    return out
}

/// All the stored hashes of a log of these records, in storage order.
pub fn store(records: [bytes]) -> [bytes] {
    var out: [bytes] = []
    var n = 0
    for r in records {
        out = out + stored_hashes(n, r, out)
        n = n + 1
    }
    return out
}

/// The largest power of two below n, and its log.
fn maxpow2(n: i64) -> (i64, i64) {
    var l = 0
    while 1.shl(l + 1) < n {
        l = l + 1
    }
    return (1.shl(l), l)
}

/// The hash of records lo to hi, from complete subtrees in storage.
fn subtree_hash(stored: [bytes], lo: i64, hi: i64) -> bytes {
    var parts: [bytes] = []
    var at = lo
    while at < hi {
        let (k, level) = maxpow2(hi - at + 1)
        parts.push(stored[stored_index(level, at.shr(level))])
        at = at + k
    }
    var h = parts[parts.len() - 1]
    var i = parts.len() - 2
    while i >= 0 {
        h = node_hash(parts[i], h)
        i = i - 1
    }
    return h
}

/// The root of the tree of the first n records.
pub fn tree_hash(stored: [bytes], n: i64) -> bytes {
    return if n == 0 { empty_hash() } else { subtree_hash(stored, 0, n) }
}

fn leaf_proof(stored: [bytes], lo: i64, hi: i64, n: i64) -> [bytes] {
    if lo + 1 == hi {
        return []
    }
    let (k, _l) = maxpow2(hi - lo)
    if n < lo + k {
        return leaf_proof(stored, lo, lo + k, n) + [subtree_hash(stored, lo + k, hi)]
    }
    return leaf_proof(stored, lo + k, hi, n) + [subtree_hash(stored, lo, lo + k)]
}

/// The proof that record n is in the tree of size t.
pub fn prove_record(stored: [bytes], t: i64, n: i64) -> [bytes] ! TlogError {
    if t < 0 or n < 0 or n >= t {
        fail(TlogBadInput("a record outside the tree"))
    }
    return leaf_proof(stored, 0, t, n)
}

fn run_record_proof(p: [bytes], lo: i64, hi: i64, n: i64, leaf: bytes) -> Option[bytes] {
    if lo + 1 == hi {
        return if p.len() == 0 { Some(leaf) } else { None }
    }
    if p.len() == 0 {
        return None
    }
    let (k, _l) = maxpow2(hi - lo)
    let last = p[p.len() - 1]
    let rest = p.slice(0, p.len() - 1)
    if n < lo + k {
        return match run_record_proof(rest, lo, lo + k, n, leaf) {
            Some(th) -> Some(node_hash(th, last))
            None -> None
        }
    }
    return match run_record_proof(rest, lo + k, hi, n, leaf) {
        Some(th) -> Some(node_hash(last, th))
        None -> None
    }
}

/// Whether a proof shows the record with hash h at index n in the tree of
/// size t with root th.
pub fn check_record(proof: [bytes], t: i64, th: bytes, n: i64, h: bytes) -> bool {
    if t < 0 or n < 0 or n >= t {
        return false
    }
    return run_record_proof(proof, 0, t, n, h) == Some(th)
}

fn tree_proof(stored: [bytes], lo: i64, hi: i64, n: i64) -> [bytes] {
    if n == hi {
        return if lo == 0 { [] } else { [subtree_hash(stored, lo, hi)] }
    }
    let (k, _l) = maxpow2(hi - lo)
    if n <= lo + k {
        return tree_proof(stored, lo, lo + k, n) + [subtree_hash(stored, lo + k, hi)]
    }
    return tree_proof(stored, lo + k, hi, n) + [subtree_hash(stored, lo, lo + k)]
}

/// The proof that the tree of size t extends the tree of size n.
pub fn prove_tree(stored: [bytes], t: i64, n: i64) -> [bytes] ! TlogError {
    if t < 1 or n < 1 or n > t {
        fail(TlogBadInput("sizes out of order"))
    }
    return tree_proof(stored, 0, t, n)
}

fn run_tree_proof(p: [bytes], lo: i64, hi: i64, n: i64, old: bytes) -> Option[(bytes, bytes)] {
    if n == hi {
        if lo == 0 {
            return if p.len() == 0 { Some((old, old)) } else { None }
        }
        return if p.len() == 1 { Some((p[0], p[0])) } else { None }
    }
    if p.len() == 0 {
        return None
    }
    let (k, _l) = maxpow2(hi - lo)
    let last = p[p.len() - 1]
    let rest = p.slice(0, p.len() - 1)
    if n <= lo + k {
        return match run_tree_proof(rest, lo, lo + k, n, old) {
            Some(r) -> Some((r.0, node_hash(r.1, last)))
            None -> None
        }
    }
    return match run_tree_proof(rest, lo + k, hi, n, old) {
        Some(r) -> Some((node_hash(last, r.0), node_hash(last, r.1)))
        None -> None
    }
}

/// Whether a proof shows the tree of size t with root th extending the tree
/// of size n with root h.
pub fn check_tree(proof: [bytes], t: i64, th: bytes, n: i64, h: bytes) -> bool {
    if t < 1 or n < 1 or n > t {
        return false
    }
    return match run_tree_proof(proof, 0, t, n, h) {
        Some(r) -> r.0 == h and r.1 == th
        None -> false
    }
}

// --- Tiles --------------------------------------------------------------------------------

/// A tile: height, level (-1 for record data), number within the level,
/// and width (2^height when complete).
type TlogTile = { h: i64, l: i64, n: i64, w: i64 }

/// The tile holding a stored hash.
pub fn tile_for_index(h: i64, index: i64) -> TlogTile {
    let (level0, n0) = split_stored_index(index)
    let l = level0 / h
    let level = level0 - l * h
    let tn = n0.shl(level).shr(h)
    let within = n0 - tn.shl(h).shr(level)
    return TlogTile{ h: h, l: l, n: tn, w: (within + 1).shl(level) }
}

fn pad3(n: i64) -> str {
    var s = "{n}"
    while s.len() < 3 {
        s = "0" + s
    }
    return s
}

/// A tile's path, `tile/H/L/[xNNN/]NNN[.p/W]`.
pub fn tile_path(t: TlogTile) -> str {
    var n = t.n
    var ns = pad3(n % 1000)
    while n >= 1000 {
        n = n / 1000
        ns = "x" + pad3(n % 1000) + "/" + ns
    }
    let p = if t.w != 1.shl(t.h) { ".p/{t.w}" } else { "" }
    let l = if t.l == -1 { "data" } else { "{t.l}" }
    return "tile/{t.h}/{l}/{ns}{p}"
}

fn small_int(s: str) -> i64 {
    if s.len() == 0 or s.len() > 9 {
        return 0 - 1
    }
    var v = 0
    var i = 0
    if s.starts_with("+") or s.starts_with("-") {
        // Go's strconv.Atoi takes a sign; a tile path's canonical form does not.
        let neg = s.starts_with("-")
        let body = small_int(s.substr(1, s.len() - 1))
        return if body < 0 { 0 - 1 } else if neg { 0 - 2 - body } else { body }
    }
    while i < s.len() {
        let c = s.code_at(i)
        if c < 48 or c > 57 {
            return 0 - 1
        }
        v = v * 10 + c - 48
        i = i + 1
    }
    return v
}

/// A tile path back to the tile; only canonical paths are accepted.
pub fn parse_tile_path(path: str) -> TlogTile ! TlogError {
    var f = path.split("/")
    if f.len() < 4 or f[0] != "tile" {
        fail(TlogBadPath(path))
    }
    let h = small_int(f[1])
    let data = f[2] == "data"
    let l = if data { 0 } else { small_int(f[2]) }
    if h < 1 or l < 0 or h > 30 {
        fail(TlogBadPath(path))
    }
    var w = 1.shl(h)
    let dotp = f[f.len() - 2]
    if dotp.ends_with(".p") {
        let ww = small_int(f[f.len() - 1])
        if ww <= 0 or ww >= w {
            fail(TlogBadPath(path))
        }
        w = ww
        f[f.len() - 2] = dotp.substr(0, dotp.len() - 2)
        f = f.slice(0, f.len() - 1)
    }
    var n = 0
    for s in f.slice(3, f.len()) {
        let part = if s.starts_with("x") { s.substr(1, s.len() - 1) } else { s }
        let nn = small_int(part)
        if nn < 0 or nn >= 1000 {
            fail(TlogBadPath(path))
        }
        n = n * 1000 + nn
    }
    let t = TlogTile{ h: h, l: if data { 0 - 1 } else { l }, n: n, w: w }
    if tile_path(t) != path {
        fail(TlogBadPath(path))
    }
    return t
}

/// The tiles that change when a log of height-h tiles grows from one size
/// to another.
pub fn new_tiles(h: i64, old_size: i64, new_size: i64) -> [TlogTile] {
    var out: [TlogTile] = []
    var level = 0
    while new_size.shr(h * level) > 0 {
        let old_n = old_size.shr(h * level)
        let new_n = new_size.shr(h * level)
        if old_n != new_n {
            var n = old_n.shr(h)
            while n < new_n.shr(h) {
                out.push(TlogTile{ h: h, l: level, n: n, w: 1.shl(h) })
                n = n + 1
            }
            let last = new_n.shr(h)
            let w = new_n - last.shl(h)
            if w > 0 {
                out.push(TlogTile{ h: h, l: level, n: last, w: w })
            }
        }
        level = level + 1
    }
    return out
}

// --- Tree heads ----------------------------------------------------------------------------

/// A tree head as the checksum database writes it.
pub fn format_tree(n: i64, hash: bytes) -> str {
    return "go.sum database tree\n{n}\n" + bytes_codec.encode_base64(hash) + "\n"
}

/// A tree head's size and root hash.
pub fn parse_tree(text: str) -> (i64, bytes) ! TlogError {
    if not text.starts_with("go.sum database tree\n") or text.split("\n").len() < 4 or text.len() > 1000000 {
        fail(TlogBadTree)
    }
    let lines = text.split("\n")
    let size = lines[1]
    if size.len() == 0 or size.len() > 18 or not size.codes().all(|c| c >= 48 and c <= 57) or size.len() > 1 and size.code_at(0) == 48 {
        fail(TlogBadTree)
    }
    let hash = bytes_codec.decode_base64_go(lines[2]) ?? fail(TlogBadTree)
    if hash.len() != 32 {
        fail(TlogBadTree)
    }
    return (size.parse_int() ?? 0, hash)
}
