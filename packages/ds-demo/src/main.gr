// Data structures on inputs small enough to check by eye.
// scripts/ds_diff.sh holds them to Python models on thousands of random
// scripts; this is the short version every engine runs.
import fenwick
import segtree
import intervaltree
import rankselect
import wavelet
import sparseset
import slotmap
import timerwheel

fn main() / {io} {
    var f = fenwick.from_list([3, 1, 4, 1, 5])
    fenwick.add(f, 2, 10)
    assert_eq(fenwick.prefix_sum(f, 3), 18)
    assert_eq(fenwick.lower_bound(f, 15), 2)

    var lows = segtree.min_tree([5, 2, 8, 6])
    segtree.set(lows, 1, 9)
    assert_eq(segtree.query(lows, 0, 4), 5)
    var ranges = segtree.new_range_add_tree([1, 2, 3, 4])
    segtree.add_range(ranges, 1, 3, 10)
    assert_eq(segtree.summary(ranges, 0, 4), (30, 1, 13))

    // Meetings 9-11 and 10-12 overlap 10:30; the 12-13 one does not.
    var day = intervaltree.new_interval_tree()
    for (s, e, id) in [(900, 1100, 1), (1000, 1200, 2), (1200, 1300, 3)] {
        assert_eq(intervaltree.insert(day, s, e, id), true)
    }
    assert_eq(intervaltree.stabbing(day, 1030).map(|m| m.id), [1, 2])

    let bits = rankselect.from_positions(10, [1, 4, 5, 9])
    assert_eq(rankselect.rank1(bits, 6), 3)
    assert_eq(rankselect.select1(bits, 3), 9)

    match wavelet.new_wavelet([5, 1, 4, 1, 3, 9]) {
        Ok(w) -> {
            assert_eq(wavelet.rank(w, 1, 6), 2)
            assert_eq(wavelet.quantile(w, 0, 6, 2), 3)
            assert_eq(wavelet.range_count(w, 1, 5, 2, 5), 2)
        }
        Err(_) -> panic("the values were refused")
    }

    var live = sparseset.new_sparse_set(100)
    assert_eq(sparseset.insert(live, 42), true)
    sparseset.clear(live)
    assert_eq(sparseset.contains(live, 42), false)

    var store: SlotMap[str] = slotmap.new_slot_map()
    let old = slotmap.insert(store, "first")
    let _ = slotmap.remove(store, old)
    let reused = slotmap.insert(store, "second")
    assert_eq(reused.index, old.index)
    assert_eq(slotmap.get(store, old), None)
    assert_eq(slotmap.get(store, reused), Some("second"))

    var wheel = timerwheel.new_wheel(0)
    let late = timerwheel.schedule(wheel, 5000)
    let soon = timerwheel.schedule(wheel, 10)
    assert_eq(timerwheel.advance(wheel, 100), [soon])
    assert_eq(timerwheel.advance(wheel, 1048576), [late])
    print("ds: ok")
}
