import mimeword

fn from_hex(text: str) -> str {
    var out: [i64] = []
    var i = 0
    while i + 1 < text.len() {
        out.push(text.substr(i, 2).parse_int_base(16) ?? 0)
        i = i + 2
    }
    return bytes_of(out).to_str()
}

fn to_hex_bytes(raw: bytes) -> str {
    let digits = "0123456789abcdef"
    var out = ""
    var i = 0
    while i < raw.len() {
        out = out + digits.substr(raw.at(i) / 16, 1) +
            digits.substr(raw.at(i) % 16, 1)
        i = i + 1
    }
    return out
}

fn main() / {io} {
    var i = 0
    while i < args().len() {
        var pieces: [str] = []
        for word in mimeword.decode(from_hex(args()[i])) {
            var charset = word.charset
            if word.language.len() > 0 {
                charset = charset + "*" + word.language
            }
            pieces.push(to_hex_bytes(word.raw) + ":" + charset)
        }
        print(pieces.join(","))
        i = i + 1
    }
}
