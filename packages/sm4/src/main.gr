// SM4, China's national block cipher (GB/T 32907-2016, ISO/IEC 18033-3
// amendment 1).
//
// A 128-bit block and key, 32 rounds of an unbalanced Feistel network on
// four 32-bit words: each round mixes three words with a round key, passes
// them through the 8-bit S-box four times and a linear map of rotations,
// and folds the result into the fourth. The key schedule is the same round
// with a different linear map. Decryption is encryption with the round
// keys reversed.
//
// SM4 is mandatory in Chinese commercial cryptography: TLS's
// TLS_SM4_GCM_SM3 and TLS_SM4_CCM_SM3 suites (RFC 8998), WAPI wireless, the
// SM2/SM3/SM4 stack of Chinese PKI, and payment and smart-card systems
// there. Its modes come from `blockmodes`.
//
// Checked against OpenSSL's SM4.

type Sm4Cipher = { rk: [i64], sbox: [i64] }

type Sm4Error =
    | Sm4BadKey(length: i64)

fn word(b: bytes, at: i64) -> i64 {
    return b.at(at).shl(24).bit_or(b.at(at + 1).shl(16)).bit_or(b.at(at + 2).shl(8)).bit_or(b.at(at + 3))
}

fn rotl(x: i64, n: i64) -> i64 {
    return x.shl(n).bit_or(x.ushr(32 - n)).bit_and(4294967295)
}

/// The S-box on each byte of a word.
fn tau(s: [i64], x: i64) -> i64 {
    return s[x.ushr(24).bit_and(255)].shl(24).bit_or(s[x.ushr(16).bit_and(255)].shl(16))
        .bit_or(s[x.ushr(8).bit_and(255)].shl(8)).bit_or(s[x.bit_and(255)])
}

pub fn new_cipher(key: bytes) -> Sm4Cipher ! Sm4Error {
    if key.len() != 16 {
        fail(Sm4BadKey(key.len()))
    }
    let s = SM4_SBOX
    let fk = [0xA3B1BAC6, 0x56AA3350, 0x677D9197, 0xB27022DC]
    var k: [i64] = []
    for i in 0..4 {
        k.push(word(key, 4 * i).bit_xor(fk[i]))
    }
    var rk: [i64] = []
    for i in 0..32 {
        // CK_i: bytes (4i + j) * 7 mod 256.
        var ck = 0
        for j in 0..4 {
            ck = ck.shl(8).bit_or((4 * i + j) * 7 % 256)
        }
        let b = tau(s, k[i + 1].bit_xor(k[i + 2]).bit_xor(k[i + 3]).bit_xor(ck))
        k.push(k[i].bit_xor(b).bit_xor(rotl(b, 13)).bit_xor(rotl(b, 23)))
        rk.push(k[i + 4])
    }
    return Sm4Cipher{ rk: rk, sbox: s }
}

fn crypt(c: Sm4Cipher, block: bytes, forward: bool) -> bytes {
    if block.len() != 16 {
        panic("SM4 works on 16-byte blocks")
    }
    var x = [word(block, 0), word(block, 4), word(block, 8), word(block, 12)]
    for i in 0..32 {
        let r = if forward { c.rk[i] } else { c.rk[31 - i] }
        let b = tau(c.sbox, x[i + 1].bit_xor(x[i + 2]).bit_xor(x[i + 3]).bit_xor(r))
        x.push(x[i].bit_xor(b).bit_xor(rotl(b, 2)).bit_xor(rotl(b, 10)).bit_xor(rotl(b, 18)).bit_xor(rotl(b, 24)))
    }
    var out: [i64] = []
    for i in 0..4 {
        let w = x[35 - i]
        out = out + [w.ushr(24).bit_and(255), w.ushr(16).bit_and(255), w.ushr(8).bit_and(255), w.bit_and(255)]
    }
    return bytes_of(out)
}

/// One 16-byte block.
pub fn encrypt_block(c: Sm4Cipher, block: bytes) -> bytes {
    return crypt(c, block, true)
}

pub fn decrypt_block(c: Sm4Cipher, block: bytes) -> bytes {
    return crypt(c, block, false)
}

