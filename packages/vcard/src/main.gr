// vCard, RFC 6350 — the format a contact is exchanged in.
//
// It shares its line syntax with iCalendar, so `contentline` does the
// reading; what is here is the shape of a card and the two properties
// whose values are *structured* rather than plain text.
//
// ## N and ADR are lists of lists
//
//   N:Smith;John;Q.,Public;Dr.;Jr.,M.D.
//
// Five components separated by semicolons, each of which may itself be
// several values separated by commas. So `Q.,Public` is two middle names
// and the commas inside it are not separators between components. A
// reader that splits on `;` and stops has thrown away the structure the
// property exists for; one that splits on `,` first has merged the
// components.
//
// ## The version decides what is legal
//
// A 3.0 card writes types as `TEL;HOME;VOICE:...` and a 4.0 card writes
// `TEL;TYPE="home,voice":...`. Both appear in the wild, so `types_of`
// answers with both spellings folded together — a caller wanting to know
// whether a number is a mobile should not have to know which decade the
// card came from.
import contentline

type CardError =
    | NotACard()
    | Unbalanced()

    /// One card: its properties, in the order they were written.
type VCard = {
    properties: [ContentLine],
}

/// Read every card in a file. A file may hold many, one after another.
pub fn parse_all(text: str) -> [VCard] ! CardError {
    var lines: [ContentLine] = []
    match contentline.parse_all(text) {
        Ok(found) -> lines = found
        Err(_why) -> fail(NotACard())
    }
    var out: [VCard] = []
    var current: [ContentLine] = []
    var open = false
    for line in lines {
        if line.name == "BEGIN" and line.value.to_upper() == "VCARD" {
            if open {
                fail(Unbalanced())
            }
            open = true
            current = []
        } else if line.name == "END" and
        line.value.to_upper() == "VCARD" {
            if not open {
                fail(Unbalanced())
            }
            out.push(VCard{ properties: current })
            open = false
        } else if open {
            current.push(line)
        }
    }
    if open {
        fail(Unbalanced())
    }
    if out.len() == 0 {
        fail(NotACard())
    }
    return out
}

/// The first property of a name, or nothing.
pub fn property(card: VCard, name: str) -> Option[ContentLine] {
    for line in card.properties {
        if line.name == name.to_upper() {
            return Some(line)
        }
    }
    return None
}

/// Every property of a name, since a card may hold several telephone
/// numbers and several addresses.
pub fn properties(card: VCard, name: str) -> [ContentLine] {
    var out: [ContentLine] = []
    for line in card.properties {
        if line.name == name.to_upper() {
            out.push(line)
        }
    }
    return out
}

/// A plain text property, with its escapes undone.
pub fn text_of(card: VCard, name: str) -> str {
    match property(card, name) {
        Some(line) -> return contentline.unescape_text(line.value)
        None -> return ""
    }
}

/// A structured value: components separated by semicolons, each of which
/// is a list separated by commas.
pub fn structured(value: str) -> [[str]] {
    var out: [[str]] = []
    var current = ""
    var component: [str] = []
    var i = 0
    while i < value.len() {
        let here = value.substr(i, 1)
        if here == "\\" and i + 1 < value.len() {
            current = current + here + value.substr(i + 1, 1)
            i = i + 2
        } else if here == "," {
            component.push(contentline.unescape_text(current))
            current = ""
            i = i + 1
        } else if here == ";" {
            component.push(contentline.unescape_text(current))
            out.push(component)
            component = []
            current = ""
            i = i + 1
        } else {
            current = current + here
            i = i + 1
        }
    }
    component.push(contentline.unescape_text(current))
    out.push(component)
    return out
}

/// The five components of `N`: family, given, additional, prefixes,
/// suffixes. Missing ones come back empty rather than absent, so a caller
/// can index without checking.
pub fn name_parts(card: VCard) -> [[str]] {
    var out: [[str]] = [[], [], [], [], []]
    match property(card, "N") {
        Some(line) -> {
            let parts = structured(line.value)
            var i = 0
            while i < 5 {
                if i < parts.len() {
                    out[i] = parts[i]
                }
                i = i + 1
            }
        }
        None -> {}
    }
    return out
}

/// The display name, falling back to assembling one from `N`.
///
/// `FN` is required in 4.0 and was not in 3.0, and plenty of 3.0 cards in
/// the wild have only `N` — so a reader that returns nothing for those is
/// a reader that loses contacts.
pub fn display_name(card: VCard) -> str {
    let full = text_of(card, "FN")
    if full.len() > 0 {
        return full
    }
    let parts = name_parts(card)
    var pieces: [str] = []
    if parts[3].len() > 0 and parts[3][0].len() > 0 {
        pieces.push(parts[3].join(" "))
    }
    if parts[1].len() > 0 and parts[1][0].len() > 0 {
        pieces.push(parts[1].join(" "))
    }
    if parts[2].len() > 0 and parts[2][0].len() > 0 {
        pieces.push(parts[2].join(" "))
    }
    if parts[0].len() > 0 and parts[0][0].len() > 0 {
        pieces.push(parts[0].join(" "))
    }
    if parts[4].len() > 0 and parts[4][0].len() > 0 {
        pieces.push(parts[4].join(" "))
    }
    return pieces.join(" ")
}

/// The types a property carries, in either spelling, lower-cased.
///
/// A 3.0 card writes `TEL;HOME;VOICE:` — the types are bare parameter
/// names with no value — and a 4.0 card writes `TEL;TYPE="home,voice":`.
/// Both mean the same thing and both turn up.
pub fn types_of(line: ContentLine) -> [str] {
    var out: [str] = []
    for param in line.params {
        if param.name == "TYPE" {
            for value in param.values {
                for piece in value.split(",") {
                    if piece.len() > 0 {
                        out.push(piece.to_lower())
                    }
                }
            }
        } else if param.values.len() == 0 {
            out.push(param.name.to_lower())
        }
    }
    return out
}

/// Whether a property is of a given type, whichever way the card wrote it.
pub fn has_type(line: ContentLine, name: str) -> bool {
    for found in types_of(line) {
        if found == name.to_lower() {
            return true
        }
    }
    return false
}

/// The version a card declares, or the empty string.
pub fn version_of(card: VCard) -> str {
    return text_of(card, "VERSION")
}

/// Write a card back out.
pub fn render(card: VCard) -> str {
    var out = "BEGIN:VCARD\r\n"
    for line in card.properties {
        out = out + contentline.render(line) + "\r\n"
    }
    return out + "END:VCARD\r\n"
}
