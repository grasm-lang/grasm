// PackBits: the run-length coding in TIFF, MacPaint, PSD and ICNS.
//
// A header byte n says what follows: 0 to 127, n + 1 literal bytes; -1 to
// -127, one byte repeated 1 - n times; -128, nothing. Decoding is
// unambiguous; encoding is not, and readers do not care, but a file that
// must match what libtiff writes byte for byte does: libtiff encodes each
// row on its own, runs of two or more as runs (128 at most each),
// literals up to 128, and folds a literal, a run of two and a literal
// back into one literal while it fits.
//
// `decode` unpacks a buffer; `encode_row` packs one row as libtiff's
// PackBitsEncode does, and `encode` packs rows of `row_size` bytes.

type PackBitsError =
    | PackBitsTruncated(at: i64)
    | PackBitsTooLarge(limit: i64)

/// Unpacks at most `limit` bytes.
pub fn decode(d: bytes, limit: i64) -> bytes ! PackBitsError {
    var out: [i64] = []
    var p = 0
    while p < d.len() {
        let n = d.at(p)
        p = p + 1
        if n < 128 {
            if p + n + 1 > d.len() {
                fail(PackBitsTruncated(p - 1))
            }
            for k in 0..(n + 1) {
                out.push(d.at(p + k))
            }
            p = p + n + 1
        } else if n > 128 {
            if p >= d.len() {
                fail(PackBitsTruncated(p - 1))
            }
            for _k in 0..(257 - n) {
                out.push(d.at(p))
            }
            p = p + 1
        }
        if out.len() > limit {
            fail(PackBitsTooLarge(limit))
        }
    }
    return bytes_of(out)
}

/// One row, as libtiff's PackBitsEncode packs it. States: 0 base,
/// 1 literal, 2 run, 3 literal then run.
pub fn encode_row(row: bytes) -> bytes {
    var out: [i64] = []
    var state = 0
    var last = 0 - 1
    var i = 0
    while i < row.len() {
        let b = row.at(i)
        var n = 1
        i = i + 1
        while i < row.len() and row.at(i) == b {
            n = n + 1
            i = i + 1
        }
        var again = true
        while again {
            again = false
            if state == 3 {
                // A literal, a run of two and this one byte become one
                // literal while it fits.
                if n == 1 and out[out.len() - 2] == 255 and out[last] < 126 {
                    out[last] = out[last] + 2
                    state = if out[last] == 127 { 0 } else { 1 }
                    out[out.len() - 2] = out[out.len() - 1]
                } else {
                    state = 2
                }
                again = true
                continue
            }
            if n > 1 {
                state = if state == 1 { 3 } else { 2 }
                if n > 128 {
                    out.push(129)
                    out.push(b)
                    n = n - 128
                    again = true
                    continue
                }
                out.push(257 - n)
                out.push(b)
            } else if state == 1 {
                out[last] = out[last] + 1
                if out[last] == 127 {
                    state = 0
                }
                out.push(b)
            } else {
                last = out.len()
                out.push(0)
                out.push(b)
                state = 1
            }
        }
    }
    return bytes_of(out)
}

/// Rows of `row_size` bytes, each packed on its own.
pub fn encode(d: bytes, row_size: i64) -> bytes {
    var out: [i64] = []
    var at = 0
    while at < d.len() {
        let end = if at + row_size > d.len() { d.len() } else { at + row_size }
        for x in encode_row(d.slice(at, end)).to_list() {
            out.push(x)
        }
        at = end
    }
    return bytes_of(out)
}
