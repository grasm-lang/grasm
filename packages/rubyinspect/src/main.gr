fn at(b: [i64], i: i64) -> i64 {
    return if i >= 0 and i < b.len() { b[i] } else { 0 }
}

fn cont(b: [i64], i: i64, lo: i64, hi: i64) -> bool {
    return i < b.len() and b[i] >= lo and b[i] <= hi
}

/// The UTF-8 character at `i` as Onigmo reads it: (code point, length),
/// or (-1, 0) where the bytes are not a whole, valid character.
fn utf8_at(b: [i64], i: i64) -> (i64, i64) {
    let c = b[i]
    if c < 128 {
        return (c, 1)
    }
    if c >= 194 and c <= 223 and cont(b, i + 1, 128, 191) {
        return ((c - 192).shl(6) + b[i + 1] - 128, 2)
    }
    if c >= 224 and c <= 239 {
        let lo = if c == 224 { 160 } else { 128 }
        let hi = if c == 237 { 159 } else { 191 }
        if cont(b, i + 1, lo, hi) and cont(b, i + 2, 128, 191) {
            return ((c - 224).shl(12) + (b[i + 1] - 128).shl(6) + b[i + 2] - 128, 3)
        }
    }
    if c >= 240 and c <= 244 {
        let lo = if c == 240 { 144 } else { 128 }
        let hi = if c == 244 { 143 } else { 191 }
        if cont(b, i + 1, lo, hi) and cont(b, i + 2, 128, 191) and cont(b, i + 3, 128, 191) {
            return ((c - 240).shl(18) + (b[i + 1] - 128).shl(12) + (b[i + 2] - 128).shl(6) + b[i + 3] - 128, 4)
        }
    }
    return (0 - 1, 0)
}

fn is_print(c: i64, table: [i64]) -> bool {
    var lo = 0
    var hi = table.len() / 2 - 1
    while lo <= hi {
        let mid = (lo + hi) / 2
        if c < table[2 * mid] {
            hi = mid - 1
        } else if c > table[2 * mid + 1] {
            lo = mid + 1
        } else {
            return true
        }
    }
    return false
}

fn hex_upper(v: i64, width: i64) -> [i64] {
    let digits = "0123456789ABCDEF"
    var rev: [i64] = []
    var x = v
    while x > 0 or rev.len() < width {
        rev.push(digits.code_at(x % 16))
        x = x / 16
    }
    var out: [i64] = []
    var k = rev.len() - 1
    while k >= 0 {
        out.push(rev[k])
        k = k - 1
    }
    return out
}

fn ascii(s: str) -> [i64] {
    return s.to_bytes().to_list()
}

/// The letter of `\n`, `\r`, ... for a control character with one, or 0.
fn named_escape(c: i64) -> i64 {
    let pairs = [(10, 110), (13, 114), (9, 116), (12, 102), (11, 118), (8, 98), (7, 97), (27, 101)]
    for (k, letter) in pairs {
        if k == c {
            return letter
        }
    }
    return 0
}

fn starts_interpolation(c: i64) -> bool {
    return c == 36 or c == 64 or c == 123
}

/// `str.inspect`, for a UTF-8 string or (`binary`) an ASCII-8BIT one.
pub fn inspect(s: bytes, binary: bool) -> str {
    let b = s.to_list()
    let table = print_ranges()
    var out = [34]
    var i = 0
    while i < b.len() {
        let (c, n) = if binary { (b[i], 1) } else { utf8_at(b, i) }
        if n == 0 {
            out = out + [92, 120] + hex_upper(b[i], 2)
            i = i + 1
            continue
        }
        let next = i + n
        var escape_hash = false
        if c == 35 and next < b.len() {
            let (cc, m) = if binary { (b[next], 1) } else { utf8_at(b, next) }
            escape_hash = m > 0 and starts_interpolation(cc)
        }
        if c == 34 or c == 92 or escape_hash {
            out.push(92)
            out.push(c)
        } else if named_escape(c) != 0 {
            out = out + [92, named_escape(c)]
        } else if (not binary and is_print(c, table)) or (c >= 32 and c <= 126) {
            out = out + b.slice(i, next)
        } else if binary {
            out = out + [92, 120] + hex_upper(c, 2)
        } else if c < 65536 {
            out = out + [92, 117] + hex_upper(c, 4)
        } else {
            out = out + [92, 117, 123] + hex_upper(c, 1) + [125]
        }
        i = next
    }
    out.push(34)
    return bytes_of(out).to_str()
}

/// `str.dump`, for a UTF-8 string or (`binary`) an ASCII-8BIT one.
pub fn dump(s: bytes, binary: bool) -> str {
    let b = s.to_list()
    var out = [34]
    var i = 0
    while i < b.len() {
        let c = b[i]
        i = i + 1
        if c == 34 or c == 92 {
            out = out + [92, c]
        } else if c == 35 {
            if i < b.len() and starts_interpolation(b[i]) {
                out.push(92)
            }
            out.push(35)
        } else if named_escape(c) != 0 {
            out = out + [92, named_escape(c)]
        } else if c >= 32 and c <= 126 {
            out.push(c)
        } else {
            let (cc, n) = if binary { (0 - 1, 0) } else { utf8_at(b, i - 1) }
            if n >= 2 {
                out = out + (if cc <= 65535 { [92, 117] + hex_upper(cc, 4) } else { [92, 117, 123] + hex_upper(cc, 1) + [125] })
                i = i - 1 + n
            } else {
                out = out + [92, 120] + hex_upper(c, 2)
            }
        }
    }
    out.push(34)
    return bytes_of(out).to_str()
}

fn undump_fail(msg: str) -> RubyUndumpError {
    return RubyUndumpError(msg)
}

fn invalid_format() -> RubyUndumpError {
    return RubyUndumpError("invalid dumped string; not wrapped with '\"' nor '\"...\".force_encoding(\"...\")' form")
}

fn is_hex(c: i64) -> bool {
    return (c >= 48 and c <= 57) or (c >= 65 and c <= 70) or (c >= 97 and c <= 102)
}

/// ruby_scan_hex: up to `limit` hex digits at `i`; their value and count.
fn scan_hex(b: [i64], i: i64, limit: i64) -> (i64, i64) {
    var v = 0
    var n = 0
    while n < limit and is_hex(at(b, i + n)) {
        let c = at(b, i + n)
        if n < 15 {
            v = v * 16 + (if c <= 57 { c - 48 } else if c <= 70 { c - 55 } else { c - 87 })
        }
        n = n + 1
    }
    return (v, n)
}

fn utf8_bytes(c: i64) -> [i64] {
    if c < 128 {
        return [c]
    }
    if c < 2048 {
        return [192 + c.shr(6), 128 + c.bit_and(63)]
    }
    if c < 65536 {
        return [224 + c.shr(12), 128 + c.shr(6).bit_and(63), 128 + c.bit_and(63)]
    }
    return [240 + c.shr(18), 128 + c.shr(12).bit_and(63), 128 + c.shr(6).bit_and(63), 128 + c.bit_and(63)]
}

/// State while undumping: the bytes so far, where reading is, and which
/// kind of escape has been seen.
type Undump = { out: [i64], s: i64, utf8: bool, binary: bool }

/// `\u{...}`: hex code points separated by spaces, up to `}`.
fn unicode_braces(b: [i64], inout u: Undump) ! RubyUndumpError {
    u.s = u.s + 1
    while true {
        if u.s >= b.len() {
            fail(undump_fail("unterminated Unicode escape"))
        }
        let c = b[u.s]
        if c == 125 {
            u.s = u.s + 1
            return
        }
        if c == 32 or (c >= 9 and c <= 13) {
            u.s = u.s + 1
            continue
        }
        let (v, n) = scan_hex(b, u.s, b.len() - u.s)
        if n == 0 or n > 6 {
            fail(undump_fail("invalid Unicode escape"))
        }
        if v > 1114111 {
            fail(undump_fail("invalid Unicode codepoint (too large)"))
        }
        if v >= 55296 and v <= 57343 {
            fail(undump_fail("invalid Unicode codepoint"))
        }
        u.out = u.out + utf8_bytes(v)
        u.s = u.s + n
    }
}

fn after_backslash(b: [i64], inout u: Undump) ! RubyUndumpError {
    let c = b[u.s]
    if c == 92 or c == 34 or c == 35 {
        u.out.push(c)
        u.s = u.s + 1
        return
    }
    let named = [(110, 10), (114, 13), (116, 9), (102, 12), (118, 11), (98, 8), (97, 7), (101, 27)]
    for (letter, v) in named {
        if c == letter {
            u.out.push(v)
            u.s = u.s + 1
            return
        }
    }
    if c == 117 {
        if u.binary {
            fail(undump_fail("hex escape and Unicode escape are mixed"))
        }
        u.utf8 = true
        u.s = u.s + 1
        if u.s >= b.len() {
            fail(undump_fail("invalid Unicode escape"))
        }
        if b[u.s] == 123 {
            try unicode_braces(b, u)
            return
        }
        let (v, n) = scan_hex(b, u.s, 4)
        if n != 4 {
            fail(undump_fail("invalid Unicode escape"))
        }
        if v >= 55296 and v <= 57343 {
            fail(undump_fail("invalid Unicode codepoint"))
        }
        u.out = u.out + utf8_bytes(v)
        u.s = u.s + 4
        return
    }
    if c == 120 {
        if u.utf8 {
            fail(undump_fail("hex escape and Unicode escape are mixed"))
        }
        u.binary = true
        u.s = u.s + 1
        if u.s >= b.len() {
            fail(undump_fail("invalid hex escape"))
        }
        let (v, n) = scan_hex(b, u.s, 2)
        if n != 2 {
            fail(undump_fail("invalid hex escape"))
        }
        u.out.push(v)
        u.s = u.s + 2
        return
    }
    u.out = u.out + [92, c]
    u.s = u.s + 1
}

fn lower_ascii(s: str) -> str {
    return s.codes().map(|c| (if c >= 65 and c <= 90 { c + 32 } else { c }).to_char()).join("")
}

/// The `.force_encoding("...")` tail after the closing quote at `s`: the
/// encoding it names.
fn encoding_suffix(b: [i64], s0: i64, utf8: bool) -> str ! RubyUndumpError {
    var s = s0
    if b.len() - s > 4 and b.slice(s, s + 4) == ascii(".dup") {
        s = s + 4
    }
    let fe = ascii(".force_encoding(\"")
    if b.len() - s <= fe.len() or b.slice(s, s + fe.len()) != fe {
        fail(invalid_format())
    }
    s = s + fe.len()
    if utf8 {
        fail(undump_fail("dumped string contained Unicode escape but used force_encoding"))
    }
    var q = s
    while q < b.len() and b[q] != 34 {
        q = q + 1
    }
    if q >= b.len() or b.len() - q != 2 or b[q + 1] != 41 {
        fail(invalid_format())
    }
    let name = lower_ascii(bytes_of(b.slice(s, q)).to_str())
    for (alias, canonical) in encoding_names() {
        if lower_ascii(alias) == name {
            return canonical
        }
    }
    fail(undump_fail("dumped string has unknown encoding name"))
}

/// `str.undump`, for a UTF-8 `str`.
pub fn undump(text: str) -> RubyUndumped ! RubyUndumpError {
    let b = ascii(text)
    if b.filter(|c| c >= 128).len() > 0 {
        fail(undump_fail("non-ASCII character detected"))
    }
    if b.contains(0) {
        fail(undump_fail("string contains null byte"))
    }
    if b.len() < 2 or b[0] != 34 {
        fail(invalid_format())
    }
    var u = Undump{ out: [], s: 1, utf8: false, binary: false }
    var encoding = "UTF-8"
    while true {
        if u.s >= b.len() {
            fail(undump_fail("unterminated dumped string"))
        }
        if b[u.s] == 34 {
            u.s = u.s + 1
            if u.s != b.len() {
                encoding = try encoding_suffix(b, u.s, u.utf8)
            }
            break
        }
        if b[u.s] == 92 {
            u.s = u.s + 1
            if u.s >= b.len() {
                fail(undump_fail("invalid escape"))
            }
            try after_backslash(b, u)
        } else {
            u.out.push(b[u.s])
            u.s = u.s + 1
        }
    }
    return RubyUndumped{ data: bytes_of(u.out), encoding: encoding }
}
