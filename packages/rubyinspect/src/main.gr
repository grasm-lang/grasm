// Ruby's `String#inspect`, `String#dump` and `String#undump`, as Ruby 2.6
// writes and reads them.
//
// `inspect` is how Ruby shows a string -- in `p`, in logs, in error
// messages ("invalid value for Integer(): \"x\"") and in test failures --
// and `dump` is its ASCII-only, reversible form, which `undump` reads
// back. A tool that compares Ruby's output, or produces text Ruby will
// undump, has to escape exactly as Ruby does:
//
//   - `inspect` keeps printable characters as they are, escapes `"` and
//     `\` and a `#` that starts `#{`, `#$` or `#@`, writes `\n \r \t \f
//     \v \b \a \e`, and writes the rest as `\u0001`, `\u{1F600}` (for a
//     UTF-8 string) or `\xFF` (for a binary one, and for every byte of a
//     UTF-8 string that is not valid UTF-8). What counts as printable is
//     Onigmo's Print class in Ruby 2.6's Unicode 12.1, taken from Ruby
//     itself: U+0085 is printable there, U+200B too, and unassigned code
//     points are not.
//   - `dump` escapes the same characters and every byte outside ASCII's
//     printable range, as `\uXXXX` / `\u{X}` for valid UTF-8 in a UTF-8
//     string and as `\xNN` otherwise.
//   - `undump` reads that form back, `.force_encoding("...")` (and the
//     older `.dup.force_encoding`) included, with Ruby's errors: mixed
//     `\u` and `\x`, a code point past U+10FFFF or a surrogate, a
//     non-ASCII or NUL character, an unknown encoding name. The encoding
//     names are Ruby's, matched without regard to case; `locale`,
//     `external` and `filesystem` are taken to be UTF-8.
//
// Strings are bytes with an encoding: UTF-8, or binary (ASCII-8BIT).
// `inspect` is shown as it is with UTF-8 the default external encoding.

/// The RuntimeError `undump` raises, with Ruby's message.
type RubyUndumpError = | RubyUndumpError(msg: str)

pub fn error_text(e: RubyUndumpError) -> str {
    return match e {
        RubyUndumpError(m) -> m
    }
}

/// What `undump` gives: the bytes and the name of their encoding.
type RubyUndumped = { data: bytes, encoding: str }

