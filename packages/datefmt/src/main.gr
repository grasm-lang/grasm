// `strftime` and `strptime`: the date format everything already speaks.
//
// Log lines, cron files, `date +%F`, filenames with a timestamp in them,
// every C program and every language that copied C. A program that reads
// or writes any of those needs the same directives, and writing them out
// by hand — `"{year}-{month}-{day}"` with the zero padding done twice —
// is where the off-by-one in the month index lives.
//
// ## What is here and what is not
//
// The directives that mean the same thing everywhere: the numbers, the
// English day and month names, the ISO week date, and the composites `%F`,
// `%T`, `%D` and `%R`. Not `%c`, `%x` and `%X`, which are whatever the
// locale says and therefore mean nothing in a file another machine will
// read; and not `%Z`, which is a name a zone database has to supply —
// `tzfile` has one, and this package takes the offset it already knows.
//
// ## Two week numberings that disagree, and a third
//
// `%U` counts weeks from the first Sunday and `%W` from the first Monday,
// so days before that are week zero. `%V` is the ISO week, which is never
// zero and whose year `%G` is not always `%Y` — the 29th of December 2025
// is in ISO week 1 of 2026. Code that prints `%Y-W%V` produces a date that
// does not exist for about four days a year.
import time

type FormatError =
    | UnknownDirective(directive: str)
    | Trailing()
    | DoesNotMatch(directive: str, at: i64)
    | OutOfRange(directive: str, value: i64)

fn day_names() -> [str] {
    return ["Sunday", "Monday", "Tuesday", "Wednesday", "Thursday",
        "Friday", "Saturday"]
}

fn month_names() -> [str] {
    return ["January", "February", "March", "April", "May", "June",
        "July", "August", "September", "October", "November", "December"]
}

fn pad(value: i64, width: i64) -> str {
    var text = "{value}"
    var negative = false
    if text.starts_with("-") {
        negative = true
        text = text.substr(1, text.len() - 1)
    }
    while text.len() < width {
        text = "0" + text
    }
    if negative {
        return "-" + text
    }
    return text
}

/// The weekday with Sunday as zero, which is what `%w` prints and what
/// `%U` counts from. `time.weekday` answers ISO's numbering, where Monday
/// is one and Sunday is seven, and the two disagree about every day.
pub fn sunday_weekday(date: Date) -> i64 {
    return time.weekday(date) % 7
}

/// The weekday of a timestamp, Sunday as zero.
pub fn weekday_of(stamp: Stamp) -> i64 {
    return sunday_weekday(stamp.date)
}

/// The ISO week number, and the year it belongs to.
///
/// Returned together because they disagree: a date in early January can be
/// in the last week of the year before, and one in late December can be in
/// week one of the year after. Returning only the week is how `%G` gets
/// written as `%Y`.
pub fn iso_week(date: Date) -> (i64, i64) {
    // The Thursday of this date's week decides which year the week is in.
    let weekday = time.weekday(date) - 1
    let thursday = time.civil_from_days(time.days_from_civil(date) -
        weekday + 3)
    let first = Date{ year: thursday.year, month: 1, day: 1 }
    let week = (time.days_from_civil(thursday) -
        time.days_from_civil(first)) / 7 + 1
    return (week, thursday.year)
}

/// `%U`: weeks numbered from the first Sunday, which is week one.
fn sunday_week(date: Date) -> i64 {
    return (time.day_of_year(date) + 6 - sunday_weekday(date)) / 7
}

/// `%W`: the same from the first Monday.
fn monday_week(date: Date) -> i64 {
    return (time.day_of_year(date) + 6 - (time.weekday(date) - 1)) / 7
}

fn offset_text(offset_minutes: i64, colon: bool) -> str {
    var sign = "+"
    var minutes = offset_minutes
    if minutes < 0 {
        sign = "-"
        minutes = 0 - minutes
    }
    if colon {
        return sign + pad(minutes / 60, 2) + ":" + pad(minutes % 60, 2)
    }
    return sign + pad(minutes / 60, 2) + pad(minutes % 60, 2)
}

/// Format a timestamp.
///
/// `offset_minutes` is what `%z` writes; the stamp itself is already local
/// to that offset, because a formatter that shifted the clock as well
/// would be doing arithmetic the caller did not ask for.
pub fn format(pattern: str, stamp: Stamp,
    offset_minutes: i64) -> str ! FormatError {
    var out = ""
    var i = 0
    while i < pattern.len() {
        let here = pattern.substr(i, 1)
        if here != "%" {
            out = out + here
            i = i + 1
            continue
        }
        if i + 1 >= pattern.len() {
            fail(Trailing())
        }
        let directive = pattern.substr(i + 1, 1)
        out = out + try one(directive, stamp, offset_minutes)
        i = i + 2
    }
    return out
}

fn one(directive: str, stamp: Stamp,
    offset_minutes: i64) -> str ! FormatError {
    let date = stamp.date
    let clock = stamp.time
    if directive == "%" {
        return "%"
    } else if directive == "n" {
        return "\n"
    } else if directive == "t" {
        return "\t"
    } else if directive == "a" {
        return day_names()[sunday_weekday(date)].substr(0, 3)
    } else if directive == "A" {
        return day_names()[sunday_weekday(date)]
    } else if directive == "b" or directive == "h" {
        return month_names()[date.month - 1].substr(0, 3)
    } else if directive == "B" {
        return month_names()[date.month - 1]
    } else if directive == "C" {
        return pad(date.year / 100, 2)
    } else if directive == "d" {
        return pad(date.day, 2)
    } else if directive == "e" {
        if date.day < 10 {
            return " {date.day}"
        }
        return "{date.day}"
    } else if directive == "f" {
        return pad(clock.milli * 1000, 6)
    } else if directive == "H" {
        return pad(clock.hour, 2)
    } else if directive == "I" {
        return pad(twelve_hour(clock.hour), 2)
    } else if directive == "j" {
        return pad(time.day_of_year(date), 3)
    } else if directive == "m" {
        return pad(date.month, 2)
    } else if directive == "M" {
        return pad(clock.minute, 2)
    } else if directive == "p" {
        if clock.hour < 12 {
            return "AM"
        }
        return "PM"
    } else if directive == "S" {
        return pad(clock.second, 2)
    } else if directive == "u" {
        return "{time.weekday(date)}"
    } else if directive == "U" {
        return pad(sunday_week(date), 2)
    } else if directive == "V" {
        return pad(iso_week(date).0, 2)
    } else if directive == "w" {
        return "{sunday_weekday(date)}"
    } else if directive == "W" {
        return pad(monday_week(date), 2)
    } else if directive == "y" {
        return pad(date.year % 100, 2)
    } else if directive == "Y" {
        return "{date.year}"
    } else if directive == "G" {
        return "{iso_week(date).1}"
    } else if directive == "z" {
        return offset_text(offset_minutes, false)
    } else if directive == "Z" {
        return ""
    } else if directive == "D" {
        return pad(date.month, 2) + "/" + pad(date.day, 2) + "/" +
        pad(date.year % 100, 2)
    } else if directive == "F" {
        return pad(date.year, 4) + "-" + pad(date.month, 2) + "-" +
        pad(date.day, 2)
    } else if directive == "R" {
        return pad(clock.hour, 2) + ":" + pad(clock.minute, 2)
    } else if directive == "T" {
        return pad(clock.hour, 2) + ":" + pad(clock.minute, 2) + ":" +
        pad(clock.second, 2)
    }
    fail(UnknownDirective(directive))
}

fn twelve_hour(hour: i64) -> i64 {
    if hour == 0 {
        return 12
    }
    if hour > 12 {
        return hour - 12
    }
    return hour
}

/// What a parse has found so far.
type DateParts = {
    stamp: Stamp,
    /// Minutes east of UTC, from `%z`. Zero when the pattern had none.
    offset_minutes: i64,
    /// Whether `%z` appeared, since an offset of zero is not the same as
    /// no offset at all.
    has_offset: bool,
}

fn is_digit(character: str) -> bool {
    let byte = character.to_bytes().at(0)
    return byte >= 48 and byte <= 57
}

/// Read up to `most` digits, and at least one.
fn read_number(text: str, at: i64, most: i64) -> (i64, i64) {
    var value = 0
    var i = at
    var taken = 0
    // A field written with `%d` may still arrive space-padded, the way
    // `%e` writes it.
    while i < text.len() and text.substr(i, 1) == " " and taken == 0 {
        i = i + 1
    }
    while i < text.len() and taken < most and is_digit(text.substr(i, 1)) {
        value = value * 10 + (text.substr(i, 1).parse_int() ?? 0)
        i = i + 1
        taken = taken + 1
    }
    if taken == 0 {
        return (0 - 1, at)
    }
    return (value, i)
}

fn match_name(text: str, at: i64, names: [str]) -> (i64, i64) {
    var index = 0
    while index < names.len() {
        let full = names[index]
        if starts_at(text, at, full) {
            return (index, at + full.len())
        }
        let short = full.substr(0, 3)
        if starts_at(text, at, short) {
            return (index, at + short.len())
        }
        index = index + 1
    }
    return (0 - 1, at)
}

fn starts_at(text: str, at: i64, needle: str) -> bool {
    if at + needle.len() > text.len() {
        return false
    }
    return text.substr(at, needle.len()).to_lower() == needle.to_lower()
}

/// A parse in progress: the fields found so far, and how far into the
/// text it has read.
type DateParseState = {
    year: i64,
    month: i64,
    day: i64,
    hour: i64,
    minute: i64,
    second: i64,
    milli: i64,
    offset: i64,
    has_offset: bool,
    /// Whether `%p` said afternoon, and whether it appeared at all — a
    /// twelve-hour clock without a meridiem is a different reading from
    /// one with `AM`.
    pm: bool,
    has_meridiem: bool,
    /// `%j`, kept aside rather than turned into a month and a day on the
    /// spot: the pattern may name the year afterwards, and 1972 has a
    /// twenty-ninth of February where 1970 does not.
    day_of_year: i64,
    at: i64,
}

/// Read a timestamp written in a known format.
///
/// Deliberately strict: every literal character in the pattern must be
/// there, and a number that is not a number is an error rather than a
/// zero. A parser that shrugs turns a malformed log line into a record
/// dated the first of January in the year zero.
pub fn parse(pattern: str, text: str) -> DateParts ! FormatError {
    var state = DateParseState{ year: 1900, month: 1, day: 1, hour: 0,
        minute: 0, second: 0, milli: 0, offset: 0, has_offset: false,
        pm: false, has_meridiem: false, day_of_year: 0, at: 0 }
    var i = 0
    while i < pattern.len() {
        let here = pattern.substr(i, 1)
        if here != "%" {
            if state.at >= text.len() or
            text.substr(state.at, 1) != here {
                fail(DoesNotMatch(here, state.at))
            }
            i = i + 1
            state.at = state.at + 1
            continue
        }
        if i + 1 >= pattern.len() {
            fail(Trailing())
        }
        try take(state, pattern.substr(i + 1, 1), text)
        i = i + 2
    }
    if state.at != text.len() {
        fail(Trailing())
    }
    if state.day_of_year > 0 {
        let start = Date{ year: state.year, month: 1, day: 1 }
        let found = time.civil_from_days(
            time.days_from_civil(start) + state.day_of_year - 1)
        state.month = found.month
        state.day = found.day
    }
    var hour = state.hour
    if state.has_meridiem {
        if state.pm and hour < 12 {
            hour = hour + 12
        }
        if not state.pm and hour == 12 {
            hour = 0
        }
    }
    return DateParts{ stamp: Stamp{ date: Date{ year: state.year,
        month: state.month, day: state.day },
        time: Time{ hour: hour, minute: state.minute,
            second: state.second, milli: state.milli } },
        offset_minutes: state.offset, has_offset: state.has_offset }
}

/// One directive, against the text at `state.at`.
fn take(inout state: DateParseState, directive: str,
    text: str) -> bool ! FormatError {
    if directive == "%" {
        if state.at >= text.len() or text.substr(state.at, 1) != "%" {
            fail(DoesNotMatch("%", state.at))
        }
        state.at = state.at + 1
        return true
    }
    if directive == "b" or directive == "B" or directive == "h" or
    directive == "a" or directive == "A" or directive == "p" or
    directive == "z" or directive == "j" {
        return try take_word(state, directive, text)
    }
    return try take_number(state, directive, text)
}

/// The directives that read a run of digits.
fn take_number(inout state: DateParseState, directive: str,
    text: str) -> bool ! FormatError {
    var width = 2
    if directive == "Y" {
        width = 4
    } else if directive == "f" {
        width = 6
    }
    let got = read_number(text, state.at, width)
    if got.0 < 0 {
        fail(DoesNotMatch(directive, state.at))
    }
    let value = got.0
    if directive == "Y" {
        state.year = value
    } else if directive == "y" {
        // The POSIX window: 69 to 99 is the twentieth century.
        if value < 69 {
            state.year = 2000 + value
        } else {
            state.year = 1900 + value
        }
    } else if directive == "m" {
        if value < 1 or value > 12 {
            fail(OutOfRange("m", value))
        }
        state.month = value
    } else if directive == "d" or directive == "e" {
        if value < 1 or value > 31 {
            fail(OutOfRange("d", value))
        }
        state.day = value
    } else if directive == "H" {
        if value > 23 {
            fail(OutOfRange("H", value))
        }
        state.hour = value
    } else if directive == "I" {
        if value < 1 or value > 12 {
            fail(OutOfRange("I", value))
        }
        state.hour = value
    } else if directive == "M" {
        if value > 59 {
            fail(OutOfRange("M", value))
        }
        state.minute = value
    } else if directive == "S" {
        if value > 61 {
            fail(OutOfRange("S", value))
        }
        state.second = value
    } else if directive == "f" {
        // A fractional field is left-aligned: `.5` is half a second, not
        // five microseconds.
        var scaled = value
        var digits = got.1 - state.at
        while digits < 6 {
            scaled = scaled * 10
            digits = digits + 1
        }
        state.milli = scaled / 1000
    } else {
        fail(UnknownDirective(directive))
    }
    state.at = got.1
    return true
}

/// The directives that read a name, a meridiem, an offset, or the day of
/// the year.
fn take_word(inout state: DateParseState, directive: str,
    text: str) -> bool ! FormatError {
    if directive == "j" {
        let got = read_number(text, state.at, 3)
        if got.0 < 1 or got.0 > 366 {
            fail(OutOfRange("j", got.0))
        }
        state.day_of_year = got.0
        state.at = got.1
        return true
    }
    if directive == "b" or directive == "B" or directive == "h" {
        let got = match_name(text, state.at, month_names())
        if got.0 < 0 {
            fail(DoesNotMatch(directive, state.at))
        }
        state.month = got.0 + 1
        state.at = got.1
        return true
    }
    if directive == "a" or directive == "A" {
        let got = match_name(text, state.at, day_names())
        if got.0 < 0 {
            fail(DoesNotMatch(directive, state.at))
        }
        // The name is checked and then thrown away: the date it belongs to
        // is already known, and a name that disagrees with it is the
        // caller's problem to notice.
        state.at = got.1
        return true
    }
    if directive == "p" {
        if starts_at(text, state.at, "AM") {
            state.has_meridiem = true
            state.pm = false
            state.at = state.at + 2
            return true
        }
        if starts_at(text, state.at, "PM") {
            state.has_meridiem = true
            state.pm = true
            state.at = state.at + 2
            return true
        }
        fail(DoesNotMatch("p", state.at))
    }
    let got = try read_offset(text, state.at)
    state.offset = got.0
    state.has_offset = true
    state.at = got.1
    return true
}

/// `%z`, in the four spellings that turn up: `+0100`, `+01:00`, `+01` and
/// `Z`.
fn read_offset(text: str, at: i64) -> (i64, i64) ! FormatError {
    if at < text.len() and (text.substr(at, 1) == "Z" or
        text.substr(at, 1) == "z") {
        return (0, at + 1)
    }
    if at >= text.len() {
        fail(DoesNotMatch("z", at))
    }
    let sign = text.substr(at, 1)
    if sign != "+" and sign != "-" {
        fail(DoesNotMatch("z", at))
    }
    let hours = read_number(text, at + 1, 2)
    if hours.0 < 0 {
        fail(DoesNotMatch("z", at))
    }
    var i = hours.1
    var minutes = 0
    if i < text.len() and text.substr(i, 1) == ":" {
        i = i + 1
    }
    if i < text.len() and is_digit(text.substr(i, 1)) {
        let got = read_number(text, i, 2)
        minutes = got.0
        i = got.1
    }
    var total = hours.0 * 60 + minutes
    if sign == "-" {
        total = 0 - total
    }
    return (total, i)
}
