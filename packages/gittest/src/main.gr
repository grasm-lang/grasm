// The Grasm side of scripts/git_diff.py: git's binary index formats and
// pretty formats, from files and objects a real repository holds. Bytes
// travel as hex; fields are separated by U+001F.
import packidx
import packrev
import midx
import commitgraph
import gitlogfmt

fn us() -> str {
    "\u{1f}"
}

fn from_hex(text: str) -> bytes {
    var out: [i64] = []
    var i = 0
    while i + 1 < text.len() {
        out.push(text.substr(i, 2).parse_int_base(16) ?? 0)
        i = i + 2
    }
    bytes_of(out)
}

fn hex(raw: bytes) -> str {
    let digits = "0123456789abcdef"
    var out = ""
    for i in 0..raw.len() {
        out = out + digits.substr(raw.at(i) / 16, 1) + digits.substr(raw.at(i) % 16, 1)
    }
    out
}

fn answer_idx(a: str) -> str {
    match packidx.read(from_hex(a), 20) {
        Err(_) -> "ERR"
        Ok(idx) -> "v{idx.version}" + us() + idx.entries.map(|e| hex(e.name) + ":{e.offset}:{e.crc}").join(",")
    }
}

fn answer_idx_write(spec: str, checksum: str) -> str {
    var entries: [PackIndexEntry] = []
    if spec.len() > 0 {
        for e in spec.split(",") {
            let f = e.split(":")
            entries.push(PackIndexEntry{ name: from_hex(f[0]), offset: f[1].parse_int() ?? 0, crc: f[2].parse_int() ?? 0 })
        }
    }
    hex(packidx.write(entries, from_hex(checksum)))
}

fn answer_rev(a: str, b: str) -> str {
    let offsets = if b.len() == 0 { [] } else { b.split(",").map(|x| x.parse_int() ?? 0) }
    match packrev.read(from_hex(a)) {
        Err(_) -> "ERR"
        Ok(r) -> r.positions.map(|p| "{p}").join(",") + us() + "{hex(packrev.build(offsets, r.pack_checksum)) == a}"
    }
}

fn answer_midx(a: str) -> str {
    match midx.read(from_hex(a)) {
        Err(_) -> "ERR"
        Ok(m) -> m.packs.join(",") + us() + m.entries.map(|e| hex(e.name) + ":{e.pack}:{e.offset}").join(",") + us() +
        m.reverse.map(|p| "{p}").join(",")
    }
}

fn answer_cg(a: str) -> str {
    match commitgraph.read(from_hex(a)) {
        Err(_) -> "ERR"
        Ok(g) -> {
            var out: [str] = []
            for c in g.commits {
                let parents = c.parents.map(|p| if p < g.commits.len() { hex(g.commits[p].oid) } else { "?" }).join(" ")
                out.push(hex(c.oid) + ":" + hex(c.tree) + ":" + parents + ":{c.level}:{c.time}:{c.corrected}")
            }
            out.join(",")
        }
    }
}

fn answer_log(a: str, b: str) -> str {
    let f = b.split(us())
    match gitlogfmt.from_object(f[0], from_hex(a)) {
        Err(_) -> "ERR"
        Ok(c) -> hex(gitlogfmt.format(c, from_hex(f[1]).to_str(), 7).to_bytes())
    }
}

fn answer(what: str, a: str, b: str) -> str {
    if what == "idx" {
        return answer_idx(a)
    }
    if what == "idxw" {
        return answer_idx_write(a, b)
    }
    if what == "rev" {
        return answer_rev(a, b)
    }
    if what == "midx" {
        return answer_midx(a)
    }
    if what == "cg" {
        return answer_cg(a)
    }
    if what == "cgv" {
        return match commitgraph.read(from_hex(a)) {
            Err(_) -> "ERR"
            Ok(g) -> commitgraph.verify(g).map(|p| hex(p.oid) + ":{p.have}:{p.want}").join(",")
        }
    }
    answer_log(a, b)
}

fn main() / {io} {
    let argv = args()
    var i = 0
    while i + 2 < argv.len() {
        print(answer(argv[i], argv[i + 1], argv[i + 2]))
        i = i + 3
    }
}
