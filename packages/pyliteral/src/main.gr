// Python values written as Python source, read without running anything.
//
// A great deal of text in the world is a Python literal: configuration files
// and command-line flags read with `ast.literal_eval`, `repr` output in logs
// and test fixtures, the values in `setup.py` and `__init__.py` that tools
// read without importing, notebook metadata, a `str(dict)` someone saved
// instead of JSON. Reading it with `eval` runs whatever it says. Reading it
// with a JSON parser fails at the first single quote, tuple or `None`.
//
// This reads exactly what `ast.literal_eval` reads, and nothing it refuses:
//
// - numbers in every notation Python has — `0x_ff`, `0o17`, `1_000`, `1.e5`,
//   `.5j` — with integers of any size;
// - strings with every prefix and quote style, adjacent strings joined, and
//   every escape; bytes, which must be ASCII in the source;
// - tuples with or without parentheses, lists, dicts, sets and `set()`;
// - `None`, `True`, `False`, `...`, a sign on a number, and a real number
//   plus or minus an imaginary one — the only arithmetic there is, because it
//   is the only way to write a complex number.
//
// Values keep Python's meaning of equal, which is where a set or dict read
// by anything else goes wrong: `{1: 'a', 1.0: 'b', True: 'c'}` is `{1: 'c'}`,
// because those three keys are one key. An unhashable key or set member is
// refused as Python refuses it.
//
// `repr` writes values back the way Python does: the shortest float that
// reads back, complex numbers as `(1-0j)`, strings in whichever quote needs
// no escaping and with every character Python considers unprintable escaped
// — from a table generated out of Python's own Unicode database by
// `scripts/gen_printable.py`. Sets are the exception. Python writes a set in
// the order of its hash table, which for strings changes from one process
// to the next, so `repr` writes a set's members in the order `pprint` sorts
// them — by Python's `<`, and by type name where that raises.
//
// Two things Python accepts are refused, both because a Grasm `str` cannot
// hold them: a lone surrogate such as `'\ud800'`, and `\N{...}` escapes,
// which need the whole Unicode name list.
//
// Checked against `ast.literal_eval` and `repr`.

import bigint
import shortestfloat

type PyValue =
    | PyNone
    | PyBool(value: bool)
    | PyInt(value: BigInt)
    | PyFloat(value: f64)
    | PyComplex(real: f64, imag: f64)
    | PyStr(value: str)
    | PyBytes(value: bytes)
    | PyEllipsis
    | PyTuple(items: [ref PyValue])
    | PyList(items: [ref PyValue])
    | PySet(items: [ref PyValue])
    | PyFrozenSet(items: [ref PyValue])
    | PyDict(keys: [ref PyValue], values: [ref PyValue])

type PyLiteralError =
    | PyLiteralSyntax(at: i64, why: str)
    | PyLiteralMalformed(at: i64, why: str)
    | PyLiteralUnhashable(at: i64)
    | PyLiteralUnsupported(at: i64, why: str)

    /// One token: `kind` is `num`, `str`, `bytes`, `name`, `op`, `newline` or
    /// `end`, with its text, and for literals the value.
type PyToken = {
    kind: str,
    text: str,
    at: i64,
    literal: ref PyValue,
}

