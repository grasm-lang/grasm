fn load_hidden() -> [i64] {
    var out: [i64] = []
    for pair in HIDDEN_PACKED.split(",") {
        let dash = pair.index_of("-") ?? 0
        out.push(pair.substr(0, dash).parse_int_base(16) ?? 0)
        out.push(pair.substr(dash + 1, pair.len()).parse_int_base(16) ?? 0)
    }
    return out
}

let HIDDEN = load_hidden()

/// Whether Python's `str.isprintable` is false for a code point.
pub fn is_hidden(code: i64) -> bool {
    var low = 0
    var high = HIDDEN.len() / 2 - 1
    while low <= high {
        let mid = (low + high) / 2
        if code < HIDDEN[mid * 2] {
            high = mid - 1
        } else if code > HIDDEN[mid * 2 + 1] {
            low = mid + 1
        } else {
            return true
        }
    }
    return false
}

// ---------------------------------------------------------------------------
// Tokens

fn none_value() -> ref PyValue {
    return ref(PyNone)
}

fn token(kind: str, text: str, at: i64) -> PyToken {
    return PyToken{ kind: kind, text: text, at: at, literal: none_value() }
}

fn is_digit(c: i64) -> bool {
    return c >= 48 and c <= 57
}

fn is_name_start(c: i64) -> bool {
    return (c >= 65 and c <= 90) or (c >= 97 and c <= 122) or c == 95 or
    c >= 128
}

fn is_name_char(c: i64) -> bool {
    return is_name_start(c) or is_digit(c)
}

fn code(codes: [i64], at: i64) -> i64 {
    return if at < codes.len() { codes[at] } else { -1 }
}

/// Where a run of digits in `base`, with single underscores between them,
/// ends; `at` when there is none. An underscore not followed by a digit ends
/// the run at the underscore, which the caller then refuses.
fn digit_run(codes: [i64], at: i64, base: i64) -> i64 {
    var i = at
    while true {
        if digit_in_base(code(codes, i), base) {
            i = i + 1
        } else if code(codes, i) == 95 and i > at and
        digit_in_base(code(codes, i + 1), base) {
            i = i + 1
        } else {
            return i
        }
    }
    return i
}

fn digit_in_base(c: i64, base: i64) -> bool {
    if base == 16 {
        return is_digit(c) or (c >= 97 and c <= 102) or (c >= 65 and c <= 70)
    }
    return c >= 48 and c < 48 + base
}

fn without_underscores(text: str) -> str {
    return text.replace("_", "")
}

fn parse_radix(digits: str, base: i64) -> BigInt {
    var out = bigint.zero()
    let b = bigint.from_i64(base)
    for c in digits.to_lower().codes() {
        let v = if is_digit(c) { c - 48 } else { c - 87 }
        out = bigint.add(bigint.mul(out, b), bigint.from_i64(v))
    }
    return out
}

fn number_token(codes: [i64], text: str, start: i64) -> (PyToken, i64) ! PyLiteralError {
    let c0 = code(codes, start)
    let c1 = code(codes, start + 1)
    if c0 == 48 and (c1 == 120 or c1 == 88 or c1 == 111 or c1 == 79 or
        c1 == 98 or c1 == 66) {
        let base = if c1 == 120 or c1 == 88 { 16 } else if c1 == 111 or
        c1 == 79 { 8 } else { 2 }
        var first = start + 2
        if code(codes, first) == 95 {
            first = first + 1
        }
        let end = digit_run(codes, first, base)
        if end == first or is_name_char(code(codes, end)) or
        code(codes, end) == 46 {
            fail(PyLiteralSyntax(start, "invalid number"))
        }
        let digits = without_underscores(text.substr(first, end - first))
        let value = ref(PyInt(parse_radix(digits, base)))
        return (PyToken{ kind: "num", text: text.substr(start, end - start),
            at: start, literal: value }, end)
    }
    return try decimal_token(codes, text, start)
}

/// A Python float literal's digits in the form `parse_float` reads: a digit
/// on both sides of the point.
fn float_text(body: str) -> str {
    var t = body.to_lower()
    if t.starts_with(".") {
        t = "0" + t
    }
    t = t.replace(".e", ".0e")
    if t.ends_with(".") {
        t = t + "0"
    }
    return t
}

fn decimal_token(codes: [i64], text: str, start: i64) -> (PyToken, i64) ! PyLiteralError {
    var i = digit_run(codes, start, 10)
    let whole_end = i
    var is_float = false
    if code(codes, i) == 46 {
        is_float = true
        i = i + 1
        if is_digit(code(codes, i)) {
            i = digit_run(codes, i, 10)
        }
    }
    if whole_end == start and i == start + 1 {
        fail(PyLiteralSyntax(start, "invalid number"))
    }
    let e = code(codes, i)
    if e == 101 or e == 69 {
        var j = i + 1
        if code(codes, j) == 43 or code(codes, j) == 45 {
            j = j + 1
        }
        let exp_end = digit_run(codes, j, 10)
        if exp_end == j {
            fail(PyLiteralSyntax(start, "invalid exponent"))
        }
        i = exp_end
        is_float = true
    }
    var imaginary = false
    if code(codes, i) == 106 or code(codes, i) == 74 {
        imaginary = true
        i = i + 1
    }
    if is_name_char(code(codes, i)) or code(codes, i) == 46 or
    code(codes, i) == 95 {
        fail(PyLiteralSyntax(start, "invalid decimal literal"))
    }
    let raw = text.substr(start, i - start)
    let body = without_underscores(if imaginary { raw.substr(0,
        raw.len() - 1) } else { raw })
    if imaginary or is_float {
        let x = float_text(body).parse_float() ?? 0.0
        let value = if imaginary { PyComplex(0.0, x) } else { PyFloat(x) }
        return (PyToken{ kind: "num", text: raw, at: start, literal: ref(value) },
            i)
    }
    // A decimal integer may not have a leading zero unless it is all zeros.
    if body.len() > 1 and body.starts_with("0") and
    body.replace("0", "").len() > 0 {
        fail(PyLiteralSyntax(start, "leading zeros in a decimal integer"))
    }
    if body.len() > 4300 {
        fail(PyLiteralSyntax(start, "integer exceeds 4300 digits"))
    }
    let n = bigint.parse(body) ?? bigint.zero()
    return (PyToken{ kind: "num", text: raw, at: start, literal: ref(PyInt(n)) },
        i)
}

/// The prefix letters before a quote, if they are a string prefix Python
/// has: `r`, `u`, `b`, `f`, `t` and the combinations of `r` with `b`, `f`
/// or `t`, in either order and any case.
fn prefix_kind(prefix: str) -> str {
    let p = prefix.to_lower()
    let plain = ["", "u", "r", "b", "br", "rb", "f", "fr", "rf", "t", "tr", "rt"]
    return if plain.contains(p) { p } else { "?" }
}

fn hex_of(codes: [i64], at: i64, count: i64) -> i64 {
    var v = 0
    var i = 0
    while i < count {
        let c = code(codes, at + i)
        if not digit_in_base(c, 16) {
            return -1
        }
        let d = if is_digit(c) { c - 48 } else if c >= 97 { c - 87 } else {
            c - 55 }
        v = v * 16 + d
        i = i + 1
    }
    return v
}

/// The body of a string between its quotes, with newlines as the tokenizer
/// sees them — `\r\n` and `\r` read as `\n` — and escapes decoded unless
/// `raw`. Code points for a str, byte values for bytes.
fn decode_body(codes: [i64], from: i64, to: i64, raw: bool,
    is_bytes: bool) -> [i64] ! PyLiteralError {
    var out: [i64] = []
    var i = from
    while i < to {
        var c = codes[i]
        if c == 13 {
            c = 10
            if i + 1 < to and codes[i + 1] == 10 {
                i = i + 1
            }
        }
        if is_bytes and c >= 128 {
            fail(PyLiteralSyntax(i, "bytes can only contain ASCII"))
        }
        if c != 92 or raw {
            out.push(c)
            i = i + 1
            continue
        }
        let step = try escape_at(codes, i, to, is_bytes)
        for v in step.0 {
            out.push(v)
        }
        i = step.1
    }
    return out
}

/// The values one backslash escape at `at` stands for, and where the text
/// resumes after it.
fn escape_at(codes: [i64], at: i64, to: i64, is_bytes: bool) -> ([i64], i64) ! PyLiteralError {
    let next = code(codes, at + 1)
    let simple = [(92, 92), (39, 39), (34, 34), (97, 7), (98, 8), (102, 12),
        (110, 10), (114, 13), (116, 9), (118, 11)]
    for pair in simple {
        if next == pair.0 {
            return ([pair.1], at + 2)
        }
    }
    if next == 10 {
        return ([], at + 2)
    }
    if next == 13 {
        return ([], if code(codes, at + 2) == 10 { at + 3 } else { at + 2 })
    }
    if next >= 48 and next <= 55 {
        var v = 0
        var i = at + 1
        while i < to and i < at + 4 and codes[i] >= 48 and codes[i] <= 55 {
            v = v * 8 + (codes[i] - 48)
            i = i + 1
        }
        return ([if is_bytes { v % 256 } else { v }], i)
    }
    if next == 120 {
        let v = hex_of(codes, at + 2, 2)
        if v < 0 or at + 4 > to {
            fail(PyLiteralSyntax(at, "truncated \\xXX escape"))
        }
        return ([v], at + 4)
    }
    if not is_bytes and (next == 117 or next == 85) {
        let width = if next == 117 { 4 } else { 8 }
        let v = hex_of(codes, at + 2, width)
        if v < 0 or at + 2 + width > to {
            fail(PyLiteralSyntax(at, "truncated \\u escape"))
        }
        if v > 1114111 {
            fail(PyLiteralSyntax(at, "illegal Unicode character"))
        }
        if v >= 55296 and v <= 57343 {
            fail(PyLiteralUnsupported(at, "a lone surrogate"))
        }
        return ([v], at + 2 + width)
    }
    if not is_bytes and next == 78 {
        fail(PyLiteralUnsupported(at, "\\N\{...\} escapes"))
    }
    return ([92], at + 1)
}

fn string_token(codes: [i64], text: str, start: i64,
    quote_at: i64) -> (PyToken, i64) ! PyLiteralError {
    let kind = prefix_kind(text.substr(start, quote_at - start))
    if kind == "?" {
        fail(PyLiteralSyntax(start, "invalid string prefix"))
    }
    let q = codes[quote_at]
    let triple = code(codes, quote_at + 1) == q and code(codes, quote_at + 2) == q
    let open = if triple { 3 } else { 1 }
    var i = quote_at + open
    var close = -1
    while i < codes.len() {
        let c = codes[i]
        if c == 92 {
            let crlf = code(codes, i + 1) == 13 and code(codes, i + 2) == 10
            i = i + (if crlf { 3 } else { 2 })
            continue
        }
        if not triple and (c == 10 or c == 13) {
            break
        }
        if c == q and (not triple or (code(codes, i + 1) == q and
            code(codes, i + 2) == q)) {
            close = i
            break
        }
        i = i + 1
    }
    if close < 0 {
        fail(PyLiteralSyntax(start, "unterminated string literal"))
    }
    let end = close + open
    let tok_text = text.substr(start, end - start)
    if kind.contains("f") or kind.contains("t") {
        return (PyToken{ kind: "fstr", text: tok_text, at: start,
            literal: none_value() }, end)
    }
    let raw = kind.contains("r")
    let is_bytes = kind.contains("b")
    let values = try decode_body(codes, quote_at + open, close, raw, is_bytes)
    if is_bytes {
        return (PyToken{ kind: "bytes", text: tok_text, at: start,
            literal: ref(PyBytes(bytes_of(values))) }, end)
    }
    var s = ""
    for v in values {
        s = s + v.to_char()
    }
    return (PyToken{ kind: "str", text: tok_text, at: start,
        literal: ref(PyStr(s)) }, end)
}

fn is_blank(c: i64) -> bool {
    return c == 32 or c == 9 or c == 12
}

/// The tokens of `text`, which has already had leading spaces and tabs
/// removed. Newlines inside brackets are dropped, as Python's tokenizer
/// drops them; a newline outside them is a `newline` token.
fn tokenize(text: str) -> [PyToken] ! PyLiteralError {
    let codes = text.codes()
    var out: [PyToken] = []
    var depth = 0
    var i = 0
    // At the start of a line outside brackets, the spaces and tabs before
    // its first token: any at all is an indent, which a literal cannot
    // have. A form feed starts the count again, and a line that turns out
    // to be blank or only a comment does not count.
    var line_start = true
    var indent = 0
    while i < codes.len() {
        let c = codes[i]
        if c == 0 {
            fail(PyLiteralSyntax(i, "source code cannot contain null bytes"))
        }
        if line_start and depth == 0 {
            if c == 32 or c == 9 {
                indent = indent + 1
                i = i + 1
                continue
            }
            if c == 12 {
                indent = 0
                i = i + 1
                continue
            }
            if c == 35 or c == 10 or c == 13 {
                indent = 0
            } else if c != 92 {
                if indent > 0 {
                    fail(PyLiteralSyntax(i, "unexpected indent"))
                }
                line_start = false
            }
        }
        let step = try one_token(codes, text, i, depth)
        i = step.1
        match step.0 {
            Some(t) -> {
                if t.kind == "newline" {
                    line_start = true
                    indent = 0
                    if out.len() > 0 and out[out.len() - 1].kind != "newline" {
                        out.push(t)
                    }
                } else {
                    if t.text == "(" or t.text == "[" or t.text == "\{" {
                        if depth >= 200 {
                            fail(PyLiteralSyntax(t.at,
                                "too many nested parentheses"))
                        }
                        depth = depth + 1
                    } else if t.text == ")" or t.text == "]" or
                    t.text == "\}" {
                        depth = depth - 1
                    }
                    out.push(t)
                }
            }
            None -> {}
        }
    }
    if line_start and indent > 0 {
        fail(PyLiteralSyntax(codes.len(), "unexpected indent"))
    }
    out.push(token("end", "", codes.len()))
    return out
}

/// The token at `i`, or nothing for whitespace, comments and continuations,
/// and where scanning resumes.
fn one_token(codes: [i64], text: str, i: i64,
    depth: i64) -> (Option[PyToken], i64) ! PyLiteralError {
    let c = codes[i]
    if is_blank(c) {
        return (None, i + 1)
    }
    if c == 35 {
        var j = i
        while j < codes.len() and codes[j] != 10 and codes[j] != 13 {
            j = j + 1
        }
        return (None, j)
    }
    if c == 10 or c == 13 {
        let next = if c == 13 and code(codes, i + 1) == 10 { i + 2 } else {
            i + 1 }
        return (if depth > 0 { None } else { Some(token("newline", "", i)) },
            next)
    }
    if c == 92 {
        let n = code(codes, i + 1)
        let after = if n == 13 and code(codes, i + 2) == 10 { i + 3 } else {
            i + 2 }
        if n != 10 and n != 13 {
            fail(PyLiteralSyntax(i,
                "unexpected character after line continuation"))
        }
        // A continuation must continue into something: one that is the last
        // thing in the text is an unexpected end, even after a complete
        // value.
        if after >= codes.len() {
            fail(PyLiteralSyntax(i, "unexpected EOF while parsing"))
        }
        return (None, after)
    }
    if is_digit(c) or (c == 46 and is_digit(code(codes, i + 1))) {
        let t = try number_token(codes, text, i)
        return (Some(t.0), t.1)
    }
    if c == 39 or c == 34 {
        let t = try string_token(codes, text, i, i)
        return (Some(t.0), t.1)
    }
    if is_name_start(c) {
        var j = i
        while j < codes.len() and is_name_char(codes[j]) {
            j = j + 1
        }
        if code(codes, j) == 39 or code(codes, j) == 34 {
            let t = try string_token(codes, text, i, j)
            return (Some(t.0), t.1)
        }
        return (Some(token("name", text.substr(i, j - i), i)), j)
    }
    if c == 46 and code(codes, i + 1) == 46 and code(codes, i + 2) == 46 {
        return (Some(token("op", "...", i)), i + 3)
    }
    let ops = "()[]\{\},:+-"
    let ch = c.to_char()
    if ops.contains(ch) {
        return (Some(token("op", ch, i)), i + 1)
    }
    fail(PyLiteralSyntax(i, "a character a literal cannot contain"))
}

// ---------------------------------------------------------------------------
// Parsing

/// An expression as literal_eval sees it: a constant, a container, a sign
/// applied to one, or a sum of two.
type PyNode = {
    kind: str,
    at: i64,
    literal: ref PyValue,
    items: [ref PyNode],
    keys: [ref PyNode],
    op: str,
}

fn node(kind: str, at: i64) -> ref PyNode {
    return ref(PyNode{ kind: kind, at: at, literal: none_value(), items: [],
        keys: [], op: "" })
}

fn peek(tokens: [PyToken], at: i64) -> PyToken {
    return tokens[if at < tokens.len() { at } else { tokens.len() - 1 }]
}

fn is_op(tokens: [PyToken], at: i64, text: str) -> bool {
    let t = peek(tokens, at)
    return t.kind == "op" and t.text == text
}

fn expect_op(tokens: [PyToken], at: i64, text: str) -> i64 ! PyLiteralError {
    if not is_op(tokens, at, text) {
        fail(PyLiteralSyntax(peek(tokens, at).at, "expected `{text}`"))
    }
    return at + 1
}

/// Whether the token at `at` can start an expression.
fn starts_expression(tokens: [PyToken], at: i64) -> bool {
    let t = peek(tokens, at)
    if t.kind == "num" or t.kind == "str" or t.kind == "bytes" or
    t.kind == "fstr" or t.kind == "name" {
        return true
    }
    return t.kind == "op" and (t.text == "(" or t.text == "[" or t.text == "\{" or
        t.text == "+" or t.text == "-" or t.text == "...")
}

/// Comma-separated expressions up to `close`, and whether a comma was seen.
fn sequence(tokens: [PyToken], start: i64,
    close: str) -> ([ref PyNode], bool, i64) ! PyLiteralError {
    var items: [ref PyNode] = []
    var comma = false
    var at = start
    while not is_op(tokens, at, close) {
        let e = try sum(tokens, at)
        items.push(e.0)
        at = e.1
        if is_op(tokens, at, ",") {
            comma = true
            at = at + 1
        } else if not is_op(tokens, at, close) {
            fail(PyLiteralSyntax(peek(tokens, at).at, "expected `,` or `{close}`"))
        }
    }
    return (items, comma, at + 1)
}

fn sum(tokens: [PyToken], start: i64) -> (ref PyNode, i64) ! PyLiteralError {
    let first = try unary(tokens, start)
    var left = first.0
    var at = first.1
    while is_op(tokens, at, "+") or is_op(tokens, at, "-") {
        let op = peek(tokens, at).text
        let right = try unary(tokens, at + 1)
        var n = node("binop", left.at)
        n.op = op
        n.items = [left, right.0]
        left = n
        at = right.1
    }
    return (left, at)
}

fn unary(tokens: [PyToken], start: i64) -> (ref PyNode, i64) ! PyLiteralError {
    if is_op(tokens, start, "+") or is_op(tokens, start, "-") {
        let operand = try unary(tokens, start + 1)
        var n = node("unary", peek(tokens, start).at)
        n.op = peek(tokens, start).text
        n.items = [operand.0]
        return (n, operand.1)
    }
    let a = try atom(tokens, start)
    let next = peek(tokens, a.1)
    if next.kind == "op" and (next.text == "(" or next.text == "[") {
        fail(PyLiteralMalformed(next.at, "a call or subscript"))
    }
    if next.kind == "name" or next.kind == "num" or next.kind == "str" or
    next.kind == "bytes" or next.kind == "fstr" {
        fail(PyLiteralSyntax(next.at, "invalid syntax"))
    }
    return a
}

fn strings(tokens: [PyToken], start: i64) -> (ref PyNode, i64) ! PyLiteralError {
    var at = start
    var text = ""
    var raw: [i64] = []
    var saw_bytes = false
    var saw_str = false
    var saw_f = false
    while true {
        let t = peek(tokens, at)
        if t.kind == "str" {
            saw_str = true
            match t.literal {
                PyStr(s) -> text = text + s
                _ -> {}
            }
        } else if t.kind == "bytes" {
            saw_bytes = true
            match t.literal {
                PyBytes(b) -> {
                    var i = 0
                    while i < b.len() {
                        raw.push(b.at(i))
                        i = i + 1
                    }
                }
                _ -> {}
            }
        } else if t.kind == "fstr" {
            saw_f = true
        } else {
            break
        }
        at = at + 1
    }
    if saw_bytes and (saw_str or saw_f) {
        fail(PyLiteralSyntax(peek(tokens, start).at,
            "cannot mix bytes and nonbytes literals"))
    }
    var n = node(if saw_f { "joined" } else { "const" }, peek(tokens, start).at)
    n.literal = if saw_bytes { ref(PyBytes(bytes_of(raw))) } else {
        ref(PyStr(text)) }
    return (n, at)
}

fn atom(tokens: [PyToken], start: i64) -> (ref PyNode, i64) ! PyLiteralError {
    let t = peek(tokens, start)
    if t.kind == "num" {
        var n = node("const", t.at)
        n.literal = t.literal
        return (n, start + 1)
    }
    if t.kind == "str" or t.kind == "bytes" or t.kind == "fstr" {
        return try strings(tokens, start)
    }
    if t.kind == "name" {
        return try name_atom(tokens, start)
    }
    if is_op(tokens, start, "...") {
        var n = node("const", t.at)
        n.literal = ref(PyEllipsis)
        return (n, start + 1)
    }
    if is_op(tokens, start, "(") {
        let s = try sequence(tokens, start + 1, ")")
        if s.0.len() == 1 and not s.1 {
            return (s.0[0], s.2)
        }
        var n = node("tuple", t.at)
        n.items = s.0
        return (n, s.2)
    }
    if is_op(tokens, start, "[") {
        let s = try sequence(tokens, start + 1, "]")
        var n = node("list", t.at)
        n.items = s.0
        return (n, s.2)
    }
    if is_op(tokens, start, "\{") {
        return try braces(tokens, start)
    }
    fail(PyLiteralSyntax(t.at, "invalid syntax"))
}

fn name_atom(tokens: [PyToken], start: i64) -> (ref PyNode, i64) ! PyLiteralError {
    let t = peek(tokens, start)
    var n = node("const", t.at)
    if t.text == "None" {
        n.literal = ref(PyNone)
        return (n, start + 1)
    }
    if t.text == "True" or t.text == "False" {
        n.literal = ref(PyBool(t.text == "True"))
        return (n, start + 1)
    }
    if t.text == "set" and is_op(tokens, start + 1, "(") and
    is_op(tokens, start + 2, ")") {
        n.literal = ref(PySet([]))
        return (n, start + 3)
    }
    fail(PyLiteralMalformed(t.at, "a name"))
}

fn braces(tokens: [PyToken], start: i64) -> (ref PyNode, i64) ! PyLiteralError {
    let open = peek(tokens, start)
    var at = start + 1
    if is_op(tokens, at, "\}") {
        return (node("dict", open.at), at + 1)
    }
    let first = try sum(tokens, at)
    at = first.1
    if not is_op(tokens, at, ":") {
        let rest = try sequence_after(tokens, at, first.0)
        var n = node("set", open.at)
        n.items = rest.0
        return (n, rest.1)
    }
    var keys: [ref PyNode] = [first.0]
    var values: [ref PyNode] = []
    while true {
        at = try expect_op(tokens, at, ":")
        let v = try sum(tokens, at)
        values.push(v.0)
        at = v.1
        if is_op(tokens, at, "\}") {
            break
        }
        at = try expect_op(tokens, at, ",")
        if is_op(tokens, at, "\}") {
            break
        }
        let k = try sum(tokens, at)
        keys.push(k.0)
        at = k.1
    }
    var n = node("dict", open.at)
    n.keys = keys
    n.items = values
    return (n, at + 1)
}

fn sequence_after(tokens: [PyToken], start: i64,
    first: ref PyNode) -> ([ref PyNode], i64) ! PyLiteralError {
    var items: [ref PyNode] = [first]
    var at = start
    if is_op(tokens, at, ",") {
        let s = try sequence(tokens, at + 1, "\}")
        for item in s.0 {
            items.push(item)
        }
        return (items, s.2)
    }
    at = try expect_op(tokens, at, "\}")
    return (items, at)
}

fn top(tokens: [PyToken]) -> ref PyNode ! PyLiteralError {
    if not starts_expression(tokens, 0) {
        fail(PyLiteralSyntax(peek(tokens, 0).at, "invalid syntax"))
    }
    let first = try sum(tokens, 0)
    var at = first.1
    var result = first.0
    if is_op(tokens, at, ",") {
        var items: [ref PyNode] = [first.0]
        at = at + 1
        while starts_expression(tokens, at) {
            let e = try sum(tokens, at)
            items.push(e.0)
            at = e.1
            if not is_op(tokens, at, ",") {
                break
            }
            at = at + 1
        }
        result = node("tuple", first.0.at)
        result.items = items
    }
    while peek(tokens, at).kind == "newline" {
        at = at + 1
    }
    if peek(tokens, at).kind != "end" {
        fail(PyLiteralSyntax(peek(tokens, at).at, "invalid syntax"))
    }
    return result
}

// ---------------------------------------------------------------------------
// Evaluation, as `ast.literal_eval` walks the tree

fn number_of(n: ref PyNode) -> ref PyValue ! PyLiteralError {
    if n.kind != "const" {
        fail(PyLiteralMalformed(n.at, "not a number"))
    }
    match n.literal {
        PyInt(_v) -> return n.literal
        PyFloat(_v) -> return n.literal
        PyComplex(_r, _i) -> return n.literal
        _ -> fail(PyLiteralMalformed(n.at, "not a number"))
    }
}

fn negate(v: ref PyValue) -> ref PyValue {
    match v {
        PyInt(n) -> return ref(PyInt(bigint.negate(n)))
        PyFloat(x) -> return ref(PyFloat(-1.0 * x))
        PyComplex(r, i) -> return ref(PyComplex(-1.0 * r, -1.0 * i))
        _ -> return v
    }
}

fn signed_number_of(n: ref PyNode) -> ref PyValue ! PyLiteralError {
    if n.kind == "unary" {
        let operand = try number_of(n.items[0])
        return if n.op == "-" { negate(operand) } else { operand }
    }
    return try number_of(n)
}

/// An integer as the nearest double, refused where Python's `float(int)`
/// overflows.
fn int_to_float(n: BigInt, at: i64) -> f64 ! PyLiteralError {
    let x = bigint.to_str(n).parse_float() ?? 0.0
    if x - x != 0.0 {
        fail(PyLiteralMalformed(at, "int too large to convert to float"))
    }
    return x
}

fn evaluate(n: ref PyNode) -> ref PyValue ! PyLiteralError {
    if n.kind == "const" {
        return n.literal
    }
    if n.kind == "tuple" or n.kind == "list" or n.kind == "set" {
        var items: [ref PyValue] = []
        for item in n.items {
            items.push(try evaluate(item))
        }
        if n.kind == "tuple" {
            return ref(PyTuple(items))
        }
        if n.kind == "list" {
            return ref(PyList(items))
        }
        return ref(PySet(try unique(items, n.at)))
    }
    if n.kind == "dict" {
        var keys: [ref PyValue] = []
        for k in n.keys {
            keys.push(try evaluate(k))
        }
        var values: [ref PyValue] = []
        for v in n.items {
            values.push(try evaluate(v))
        }
        return try build_dict(keys, values, n.at)
    }
    if n.kind == "binop" {
        match try complex_sum(n) {
            Some(v) -> return v
            None -> {}
        }
    }
    return try signed_number_of(n)
}

/// `real ± complex`, the one sum literal_eval evaluates.
fn complex_sum(n: ref PyNode) -> Option[ref PyValue] ! PyLiteralError {
    let left = try signed_number_of(n.items[0])
    let right = try number_of(n.items[1])
    let x = match left {
        PyInt(v) -> try int_to_float(v, n.at)
        PyFloat(v) -> v
        _ -> return None
    }
    match right {
        PyComplex(r, i) -> {
            if n.op == "+" {
                return Some(ref(PyComplex(x + r, i)))
            }
            return Some(ref(PyComplex(x - r, -1.0 * i)))
        }
        _ -> return None
    }
}

fn build_dict(keys: [ref PyValue], values: [ref PyValue],
    at: i64) -> ref PyValue ! PyLiteralError {
    var out_keys: [ref PyValue] = []
    var out_values: [ref PyValue] = []
    var i = 0
    while i < keys.len() {
        if not is_hashable(keys[i]) {
            fail(PyLiteralUnhashable(at))
        }
        var found = -1
        var j = 0
        while j < out_keys.len() and found < 0 {
            if equals(out_keys[j], keys[i]) {
                found = j
            }
            j = j + 1
        }
        if found >= 0 {
            out_values[found] = values[i]
        } else {
            out_keys.push(keys[i])
            out_values.push(values[i])
        }
        i = i + 1
    }
    return ref(PyDict(out_keys, out_values))
}

fn unique(items: [ref PyValue], at: i64) -> [ref PyValue] ! PyLiteralError {
    var out: [ref PyValue] = []
    for item in items {
        if not is_hashable(item) {
            fail(PyLiteralUnhashable(at))
        }
        var seen = false
        for o in out {
            if equals(o, item) {
                seen = true
            }
        }
        if not seen {
            out.push(item)
        }
    }
    return out
}

/// The value of a Python literal, as `ast.literal_eval(text)` returns it.
pub fn literal_eval(text: str) -> ref PyValue ! PyLiteralError {
    var start = 0
    let codes = text.codes()
    while start < codes.len() and (codes[start] == 32 or codes[start] == 9) {
        start = start + 1
    }
    let body = text.substr(start, text.len())
    let tokens = try tokenize(body)
    let tree = try top(tokens)
    return try evaluate(tree)
}

// ---------------------------------------------------------------------------
// Equality and hashing, as Python has them

/// A number as an exact rational comparison key: kind and parts.
fn numeric(v: ref PyValue) -> Option[(f64, f64, BigInt, bool)] {
    match v {
        PyBool(b) -> return Some((0.0, 0.0, bigint.from_i64(if b { 1 } else {
            0 }), true))
        PyInt(n) -> return Some((0.0, 0.0, n, true))
        PyFloat(x) -> return Some((x, 0.0, bigint.zero(), false))
        PyComplex(r, i) -> return Some((r, i, bigint.zero(), false))
        _ -> return None
    }
}

/// The exact integer value of an integral, finite double.
fn float_to_bigint(x: f64) -> BigInt {
    if x == 0.0 {
        return bigint.zero()
    }
    let bits = x.to_bits()
    let negative = bits < 0
    let magnitude = if negative { bits + 9223372036854775807 + 1 } else { bits }
    let exponent = magnitude / 4503599627370496
    var m = magnitude % 4503599627370496
    var e = -1074
    if exponent > 0 {
        m = m + 4503599627370496
        e = exponent - 1075
    }
    while e < 0 {
        m = m / 2
        e = e + 1
    }
    let value = bigint.mul(bigint.from_i64(m), bigint.pow(bigint.from_i64(2), e))
    return if negative { bigint.negate(value) } else { value }
}

fn is_finite(x: f64) -> bool {
    return x - x == 0.0
}

/// Whether a double is exactly the integer `n`.
fn float_is_int(x: f64, n: BigInt) -> bool {
    if not is_finite(x) or x.floor() != x {
        return false
    }
    return bigint.compare(float_to_bigint(x), n) == 0
}

/// -1, 0 or 1 as the integer `n` is below, equal to or above `x`, exactly.
fn compare_int_float(n: BigInt, x: f64) -> i64 {
    if not is_finite(x) {
        return if x > 0.0 { -1 } else { 1 }
    }
    let floor = x.floor()
    let c = bigint.compare(n, float_to_bigint(floor))
    if c != 0 {
        return c
    }
    return if x > floor { -1 } else { 0 }
}

fn numbers_equal(a: (f64, f64, BigInt, bool), b: (f64, f64, BigInt, bool)) -> bool {
    if a.3 and b.3 {
        return bigint.compare(a.2, b.2) == 0
    }
    if a.3 {
        return b.1 == 0.0 and float_is_int(b.0, a.2)
    }
    if b.3 {
        return a.1 == 0.0 and float_is_int(a.0, b.2)
    }
    return a.0 == b.0 and a.1 == b.1
}

/// Python's `==` between two values.
pub fn equals(a: ref PyValue, b: ref PyValue) -> bool {
    match numeric(a) {
        Some(na) -> return match numeric(b) {
            Some(nb) -> numbers_equal(na, nb)
            None -> false
        }
        None -> {}
    }
    match a {
        PyNone -> return match b {
            PyNone -> true
            _ -> false
        }
        PyEllipsis -> return match b {
            PyEllipsis -> true
            _ -> false
        }
        PyStr(x) -> return match b {
            PyStr(y) -> x == y
            _ -> false
        }
        PyBytes(x) -> return match b {
            PyBytes(y) -> x == y
            _ -> false
        }
        PyTuple(xs) -> return match b {
            PyTuple(ys) -> all_equal(xs, ys)
            _ -> false
        }
        PyList(xs) -> return match b {
            PyList(ys) -> all_equal(xs, ys)
            _ -> false
        }
        PyDict(ka, va) -> return match b {
            PyDict(kb, vb) -> dicts_equal(ka, va, kb, vb)
            _ -> false
        }
        _ -> return sets_equal(a, b)
    }
}

fn all_equal(xs: [ref PyValue], ys: [ref PyValue]) -> bool {
    if xs.len() != ys.len() {
        return false
    }
    var i = 0
    while i < xs.len() {
        if not equals(xs[i], ys[i]) {
            return false
        }
        i = i + 1
    }
    return true
}

fn members(v: ref PyValue) -> Option[[ref PyValue]] {
    match v {
        PySet(items) -> return Some(items)
        PyFrozenSet(items) -> return Some(items)
        _ -> return None
    }
}

fn contains_value(items: [ref PyValue], v: ref PyValue) -> bool {
    for item in items {
        if equals(item, v) {
            return true
        }
    }
    return false
}

fn sets_equal(a: ref PyValue, b: ref PyValue) -> bool {
    let xs = members(a) ?? []
    match members(b) {
        Some(ys) -> {
            if members(a).is_none() or xs.len() != ys.len() {
                return false
            }
            for x in xs {
                if not contains_value(ys, x) {
                    return false
                }
            }
            return true
        }
        None -> return false
    }
}

fn dicts_equal(ka: [ref PyValue], va: [ref PyValue], kb: [ref PyValue],
    vb: [ref PyValue]) -> bool {
    if ka.len() != kb.len() {
        return false
    }
    var i = 0
    while i < ka.len() {
        var found = false
        var j = 0
        while j < kb.len() and not found {
            if equals(ka[i], kb[j]) {
                if not equals(va[i], vb[j]) {
                    return false
                }
                found = true
            }
            j = j + 1
        }
        if not found {
            return false
        }
        i = i + 1
    }
    return true
}

/// Whether Python can hash the value: not a list, dict or set, and not a
/// tuple holding one.
pub fn is_hashable(v: ref PyValue) -> bool {
    match v {
        PyList(_items) -> return false
        PyDict(_k, _v) -> return false
        PySet(_items) -> return false
        PyTuple(items) -> {
            for item in items {
                if not is_hashable(item) {
                    return false
                }
            }
            return true
        }
        _ -> return true
    }
}

/// Python's `<`, or `None` where Python raises `TypeError` — between
/// types that do not order, and for complex numbers, dicts and `None`.
pub fn less(a: ref PyValue, b: ref PyValue) -> Option[bool] {
    if type_name(a) == "complex" or type_name(b) == "complex" {
        return None
    }
    match numeric(a) {
        Some(na) -> return match numeric(b) {
            Some(nb) -> numbers_less(na, nb)
            None -> None
        }
        None -> {}
    }
    match a {
        PyStr(x) -> return match b {
            PyStr(y) -> Some(x < y)
            _ -> None
        }
        PyBytes(x) -> return match b {
            PyBytes(y) -> Some(bytes_less(x, y))
            _ -> None
        }
        PyTuple(xs) -> return match b {
            PyTuple(ys) -> sequence_less(xs, ys)
            _ -> None
        }
        PyList(xs) -> return match b {
            PyList(ys) -> sequence_less(xs, ys)
            _ -> None
        }
        _ -> {}
    }
    let xs = members(a) ?? []
    match members(b) {
        Some(ys) -> {
            if members(a).is_none() {
                return None
            }
            if xs.len() >= ys.len() {
                return Some(false)
            }
            for x in xs {
                if not contains_value(ys, x) {
                    return Some(false)
                }
            }
            return Some(true)
        }
        None -> return None
    }
}

fn numbers_less(a: (f64, f64, BigInt, bool), b: (f64, f64, BigInt, bool)) -> Option[bool] {
    if a.3 and b.3 {
        return Some(bigint.compare(a.2, b.2) < 0)
    }
    if a.3 {
        return Some(compare_int_float(a.2, b.0) < 0)
    }
    if b.3 {
        return Some(compare_int_float(b.2, a.0) > 0)
    }
    return Some(a.0 < b.0)
}

fn bytes_less(x: bytes, y: bytes) -> bool {
    var i = 0
    while i < x.len() and i < y.len() {
        if x.at(i) != y.at(i) {
            return x.at(i) < y.at(i)
        }
        i = i + 1
    }
    return x.len() < y.len()
}

fn sequence_less(xs: [ref PyValue], ys: [ref PyValue]) -> Option[bool] {
    var i = 0
    while i < xs.len() and i < ys.len() {
        if not equals(xs[i], ys[i]) {
            return less(xs[i], ys[i])
        }
        i = i + 1
    }
    return Some(xs.len() < ys.len())
}

/// `str(type(value))`, which is what `pprint` orders values of unorderable
/// types by.
pub fn type_text(value: ref PyValue) -> str {
    return "<class '" + type_name(value) + "'>"
}

/// The order `pprint` sorts in: Python's `<`, and where that raises, the
/// type's name. Python then breaks a tie between two unorderable values of
/// one type by their memory addresses; this breaks it by `repr`, which at
/// least gives the same answer twice.
pub fn safe_less(a: ref PyValue, b: ref PyValue) -> bool {
    match less(a, b) {
        Some(answer) -> return answer
        None -> {}
    }
    let ta = type_text(a)
    let tb = type_text(b)
    if ta != tb {
        return ta < tb
    }
    return repr(a) < repr(b)
}

/// Values in `pprint`'s order, the same whatever order they arrive in.
///
/// `safe_less` is not always a consistent order — `True < 5e-324` fails
/// numerically, `True` sorts before `b''` by type name, and `b''` before
/// `5e-324` — and then a sort's answer depends on where it started. Python's
/// does, and starts from hash-table order. This starts from the order of
/// type name and `repr`, so the answer is at least fixed, and where the
/// order is consistent it is the one `pprint` gives.
pub fn sort_values(items: [ref PyValue]) -> [ref PyValue] {
    var keyed: [(str, str, i64)] = []
    var i = 0
    while i < items.len() {
        keyed.push((type_text(items[i]), repr(items[i]), i))
        i = i + 1
    }
    keyed.sort()
    var start: [ref PyValue] = []
    for k in keyed {
        start.push(items[k.2])
    }
    return merge_sorted(start)
}

fn merge_sorted(items: [ref PyValue]) -> [ref PyValue] {
    if items.len() <= 1 {
        return items
    }
    let middle = items.len() / 2
    let left = merge_sorted(items.slice(0, middle))
    let right = merge_sorted(items.slice(middle, items.len()))
    var out: [ref PyValue] = []
    var i = 0
    var j = 0
    while i < left.len() and j < right.len() {
        if safe_less(right[j], left[i]) {
            out.push(right[j])
            j = j + 1
        } else {
            out.push(left[i])
            i = i + 1
        }
    }
    while i < left.len() {
        out.push(left[i])
        i = i + 1
    }
    while j < right.len() {
        out.push(right[j])
        j = j + 1
    }
    return out
}

// ---------------------------------------------------------------------------
// repr

fn hex_digits(v: i64, width: i64) -> str {
    return v.to_base(16).pad_start(width, "0")
}

fn quote_for(has_single: bool, has_double: bool) -> str {
    return if has_single and not has_double { "\"" } else { "'" }
}

/// `repr` of a str.
pub fn repr_str(value: str) -> str {
    let quote = quote_for(value.contains("'"), value.contains("\""))
    var out = quote
    for c in value.codes() {
        if c == 92 {
            out = out + "\\\\"
        } else if c == quote.code_at(0) {
            out = out + "\\" + quote
        } else if c == 9 {
            out = out + "\\t"
        } else if c == 10 {
            out = out + "\\n"
        } else if c == 13 {
            out = out + "\\r"
        } else if c < 32 or c == 127 {
            out = out + "\\x" + hex_digits(c, 2)
        } else if c < 127 {
            out = out + c.to_char()
        } else if is_hidden(c) {
            out = out + (if c < 256 { "\\x" + hex_digits(c, 2) } else if c < 65536 {
                "\\u" + hex_digits(c, 4) } else { "\\U" + hex_digits(c, 8) })
        } else {
            out = out + c.to_char()
        }
    }
    return out + quote
}

/// `repr` of bytes.
pub fn repr_bytes(value: bytes) -> str {
    var has_single = false
    var has_double = false
    var i = 0
    while i < value.len() {
        has_single = has_single or value.at(i) == 39
        has_double = has_double or value.at(i) == 34
        i = i + 1
    }
    let quote = quote_for(has_single, has_double)
    var out = "b" + quote
    i = 0
    while i < value.len() {
        let c = value.at(i)
        if c == 92 {
            out = out + "\\\\"
        } else if c == quote.code_at(0) {
            out = out + "\\" + quote
        } else if c == 9 {
            out = out + "\\t"
        } else if c == 10 {
            out = out + "\\n"
        } else if c == 13 {
            out = out + "\\r"
        } else if c < 32 or c >= 127 {
            out = out + "\\x" + hex_digits(c, 2)
        } else {
            out = out + c.to_char()
        }
        i = i + 1
    }
    return out + quote
}

/// `repr` of a float: the shortest text that reads back.
pub fn repr_float(x: f64) -> str {
    return shortestfloat.repr(x)
}

/// A float as `complex.__repr__` writes each part: `repr` without a
/// trailing `.0`.
fn complex_part(x: f64) -> str {
    let text = shortestfloat.repr(x)
    return if text.ends_with(".0") { text.substr(0, text.len() - 2) } else {
        text }
}

/// `repr` of a complex number.
pub fn repr_complex(real: f64, imag: f64) -> str {
    let imag_text = complex_part(imag)
    if real == 0.0 and real.to_bits() == 0 {
        return imag_text + "j"
    }
    let sign = if imag_text.starts_with("-") { "" } else { "+" }
    return "(" + complex_part(real) + sign + imag_text + "j)"
}

fn repr_all(items: [ref PyValue]) -> [str] {
    var parts: [str] = []
    for item in items {
        parts.push(repr(item))
    }
    return parts
}

/// `repr(value)`, with a set's members in `pprint`'s order.
pub fn repr(value: ref PyValue) -> str {
    match value {
        PyNone -> return "None"
        PyBool(b) -> return if b { "True" } else { "False" }
        PyInt(n) -> return bigint.to_str(n)
        PyFloat(x) -> return repr_float(x)
        PyComplex(r, i) -> return repr_complex(r, i)
        PyStr(s) -> return repr_str(s)
        PyBytes(b) -> return repr_bytes(b)
        PyEllipsis -> return "Ellipsis"
        PyTuple(items) -> {
            if items.len() == 1 {
                return "(" + repr(items[0]) + ",)"
            }
            return "(" + repr_all(items).join(", ") + ")"
        }
        PyList(items) -> return "[" + repr_all(items).join(", ") + "]"
        PySet(items) -> {
            if items.len() == 0 {
                return "set()"
            }
            return "\{" + repr_all(sort_values(items)).join(", ") + "\}"
        }
        PyFrozenSet(items) -> {
            if items.len() == 0 {
                return "frozenset()"
            }
            return "frozenset(\{" + repr_all(sort_values(items)).join(", ") +
            "\})"
        }
        PyDict(keys, values) -> {
            var parts: [str] = []
            var i = 0
            while i < keys.len() {
                parts.push(repr(keys[i]) + ": " + repr(values[i]))
                i = i + 1
            }
            return "\{" + parts.join(", ") + "\}"
        }
    }
}

/// Python's name for the value's type.
pub fn type_name(value: ref PyValue) -> str {
    return match value {
        PyNone -> "NoneType"
        PyBool(_b) -> "bool"
        PyInt(_n) -> "int"
        PyFloat(_x) -> "float"
        PyComplex(_r, _i) -> "complex"
        PyStr(_s) -> "str"
        PyBytes(_b) -> "bytes"
        PyEllipsis -> "ellipsis"
        PyTuple(_items) -> "tuple"
        PyList(_items) -> "list"
        PySet(_items) -> "set"
        PyFrozenSet(_items) -> "frozenset"
        PyDict(_k, _v) -> "dict"
    }
}
