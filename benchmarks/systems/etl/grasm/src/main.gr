// Streaming JSON-to-database ETL.
//
// Reads a JSON Lines file a chunk at a time, decodes each line into typed
// records with the `json` package's cursor, validates, transforms, and inserts
// batches of 1000 into an in-memory "database" that keeps one aggregate per
// city and a running checksum. Each batch is dropped after its insert, so the
// memory a run needs does not depend on the size of the file.
//
//     etl <path.jsonl>
import json

type Address = { city: str, zip: str }
type User = { name: str, email: str, tags: [str], address: Address }
type Order = { sku: str, qty: i64, price: i64 }
type Customer = { id: i64, user: User, orders: [Order], note: str }

// What the pipeline loads: one row per valid customer.
type Row = {
    id: i64,
    name: str,
    city: str,
    order_count: i64,
    total_cents: i64,
    tag_count: i64
}

type CityAgg = { count: i64, total: i64 }

type Db = {
    cities: Map[str, CityAgg],
    rows: i64,
    total_cents: i64,
    checksum: i64
}

let BATCH = 1000
let MODULUS = 1000000007
let CHUNK = 1048576

// The members each object is read for, as the key bytes `json.next_member`
// compares in place: made once, so no key is ever made into a string.
type Keys = { address: [bytes], user: [bytes], order: [bytes], customer: [bytes] }

fn keys_of(names: [str]) -> [bytes] {
    var out: [bytes] = []
    for n in names {
        out.push(n.to_bytes())
    }
    out
}

// --- decoding: the text straight into typed values -------------------------
//
// Each line is read with the `json` package's cursor rather than parsed into a
// tree and then walked: the tree was most of the run's time and all of its
// garbage, and Rust's serde and Go's encoding/json fill their structs straight
// from the text too. Members may come in any order. One the record does not
// have is skipped -- and still checked, so a line with a broken unknown member
// is rejected as `json.parse` rejected it. A key that comes twice keeps its
// first value, as `json.get` answered, and the second is only checked. A field
// that never came fails once its object has ended. Any failure rejects the
// line, so the error says why only for whoever is debugging this.

fn missing(r: JsonReader, key: str) -> JsonError {
    JsonError{ why: "missing `{key}`", at: r.i }
}

fn decode_address(inout r: JsonReader, keys: Keys) -> Address ! JsonError {
    var city = ""
    var zip = ""
    var has_city = false
    var has_zip = false
    try json.open_object(r)
    var going = true
    while going {
        let k = try json.next_member(r, keys.address)
        if k < 0 {
            going = false
        } else {
            if k == 0 and not has_city {
                city = try json.read_str(r)
                has_city = true
            } else if k == 1 and not has_zip {
                zip = try json.read_str(r)
                has_zip = true
            } else {
                try json.skip(r)
            }
        }
    }
    if not has_city {
        fail(missing(r, "city"))
    }
    if not has_zip {
        fail(missing(r, "zip"))
    }
    Address{ city: city, zip: zip }
}

fn decode_user(inout r: JsonReader, keys: Keys) -> User ! JsonError {
    var name = ""
    var email = ""
    var tags: [str] = []
    var address = Address{ city: "", zip: "" }
    var has_name = false
    var has_email = false
    var has_tags = false
    var has_address = false
    try json.open_object(r)
    var going = true
    while going {
        let k = try json.next_member(r, keys.user)
        if k < 0 {
            going = false
        } else {
            if k == 0 and not has_name {
                name = try json.read_str(r)
                has_name = true
            } else if k == 1 and not has_email {
                email = try json.read_str(r)
                has_email = true
            } else if k == 2 and not has_tags {
                try json.open_list(r)
                while try json.next_item(r) {
                    tags.push(try json.read_str(r))
                }
                has_tags = true
            } else if k == 3 and not has_address {
                address = try decode_address(r, keys)
                has_address = true
            } else {
                try json.skip(r)
            }
        }
    }
    if not has_name {
        fail(missing(r, "name"))
    }
    if not has_email {
        fail(missing(r, "email"))
    }
    if not has_tags {
        fail(missing(r, "tags"))
    }
    if not has_address {
        fail(missing(r, "address"))
    }
    User{ name: name, email: email, tags: tags, address: address }
}

fn decode_order(inout r: JsonReader, keys: Keys) -> Order ! JsonError {
    var sku = ""
    var qty = 0
    var price = 0
    var has_sku = false
    var has_qty = false
    var has_price = false
    try json.open_object(r)
    var going = true
    while going {
        let k = try json.next_member(r, keys.order)
        if k < 0 {
            going = false
        } else {
            if k == 0 and not has_sku {
                sku = try json.read_str(r)
                has_sku = true
            } else if k == 1 and not has_qty {
                qty = try json.read_int(r)
                has_qty = true
            } else if k == 2 and not has_price {
                price = try json.read_int(r)
                has_price = true
            } else {
                try json.skip(r)
            }
        }
    }
    if not has_sku {
        fail(missing(r, "sku"))
    }
    if not has_qty {
        fail(missing(r, "qty"))
    }
    if not has_price {
        fail(missing(r, "price"))
    }
    Order{ sku: sku, qty: qty, price: price }
}

fn decode_customer(inout r: JsonReader, keys: Keys) -> Customer ! JsonError {
    var id = 0
    var user = User{ name: "", email: "", tags: [], address: Address{ city: "", zip: "" } }
    var orders: [Order] = []
    var note = ""
    var has_id = false
    var has_user = false
    var has_orders = false
    var has_note = false
    try json.open_object(r)
    var going = true
    while going {
        let k = try json.next_member(r, keys.customer)
        if k < 0 {
            going = false
        } else {
            if k == 0 and not has_id {
                id = try json.read_int(r)
                has_id = true
            } else if k == 1 and not has_user {
                user = try decode_user(r, keys)
                has_user = true
            } else if k == 2 and not has_orders {
                try json.open_list(r)
                while try json.next_item(r) {
                    orders.push(try decode_order(r, keys))
                }
                has_orders = true
            } else if k == 3 and not has_note {
                note = try json.read_str(r)
                has_note = true
            } else {
                try json.skip(r)
            }
        }
    }
    if not has_id {
        fail(missing(r, "id"))
    }
    if not has_user {
        fail(missing(r, "user"))
    }
    if not has_orders {
        fail(missing(r, "orders"))
    }
    if not has_note {
        fail(missing(r, "note"))
    }
    Customer{ id: id, user: user, orders: orders, note: note }
}

/// One line, which must be one record and nothing after it.
fn decode(line: bytes, keys: Keys) -> Customer ! JsonError {
    var r = json.reader_of(line)
    let c = try decode_customer(r, keys)
    try json.finish(r)
    c
}

// --- validate and transform ------------------------------------------------

fn validate(c: Customer) -> bool {
    if not c.user.email.contains("@") {
        return false
    }
    c.orders.all(|o| o.qty > 0 and o.price >= 0)
}

fn transform(c: Customer) -> Row {
    Row{
        id: c.id,
        name: c.user.name,
        city: c.user.address.city,
        order_count: c.orders.len(),
        total_cents: c.orders.fold(0, |acc, o| acc + o.qty * o.price),
        tag_count: c.user.tags.len()
    }
}

// --- the mock database -----------------------------------------------------

fn insert(inout db: Db, batch: [Row]) {
    for r in batch {
        let agg = db.cities.get(r.city) ?? CityAgg{ count: 0, total: 0 }
        db.cities.set(r.city, CityAgg{ count: agg.count + 1, total: agg.total + r.total_cents })
        db.rows = db.rows + 1
        db.total_cents = db.total_cents + r.total_cents
        let mix = r.id * 7919 + r.total_cents + r.order_count * 31 + r.tag_count * 17 + r.name.byte_len()
        db.checksum = (db.checksum * 1000003 + mix) % MODULUS
    }
}

fn city_digest(db: Db) -> i64 {
    var d = 0
    for (city, agg) in db.cities.entries() {
        d = (d * 131 + agg.count * 7 + agg.total + city.byte_len()) % MODULUS
    }
    d
}

// --- streaming lines -------------------------------------------------------

// The offset of the last newline in `b`, or -1.
fn last_newline(b: bytes) -> i64 {
    var i = b.len() - 1
    while i >= 0 and b.at(i) != 10 {
        i = i - 1
    }
    i
}

fn main() {
    let a = args()
    if a.len() != 1 {
        print("usage: etl <path.jsonl>")
        exit(2)
    }
    let path = a[0]
    let size = match file_size(path) {
        Ok(n) -> n
        Err(e) -> {
            print("etl: cannot stat {path}: {e}")
            exit(1)
        }
    }

    let keys = Keys{
        address: keys_of(["city", "zip"]),
        user: keys_of(["name", "email", "tags", "address"]),
        order: keys_of(["sku", "qty", "price"]),
        customer: keys_of(["id", "user", "orders", "note"]),
    }
    var db = Db{ cities: map(), rows: 0, total_cents: 0, checksum: 0 }
    var batch: [Row] = []
    var rejected = 0
    var off = 0
    var want = CHUNK
    while off < size {
        let b = match read_bytes_at(path, off, want) {
            Ok(d) -> d
            Err(e) -> {
                print("etl: cannot read {path}: {e}")
                exit(1)
            }
        }
        var end = last_newline(b)
        if end < 0 {
            if off + b.len() < size {
                // A line longer than the chunk: read more at once.
                want = want * 2
                continue
            }
            end = b.len() - 1
        }
        // Lines are cut straight out of the bytes: the reader works on bytes,
        // and text is decoded only where a string value is read. Through a
        // `str`, every line was checked as UTF-8 and copied twice. As
        // `lines()` does, a line's trailing `\r` is not part of it.
        var start = 0
        while start <= end {
            let stop = b.index_of(10, start) ?? (end + 1)
            var cut = stop
            if cut > start and b.at(cut - 1) == 13 {
                cut = cut - 1
            }
            let line_start = start
            start = stop + 1
            if cut == line_start {
                continue
            }
            match decode(b.slice(line_start, cut), keys) {
                Ok(c) -> {
                    if validate(c) {
                        batch.push(transform(c))
                        if batch.len() == BATCH {
                            insert(db, batch)
                            batch = []
                        }
                    } else {
                        rejected = rejected + 1
                    }
                }
                Err(_e) -> rejected = rejected + 1
            }
        }
        off = off + end + 1
    }
    if not batch.is_empty() {
        insert(db, batch)
        batch = []
    }

    print("valid={db.rows} rejected={rejected} cities={db.cities.len()} total_cents={db.total_cents} checksum={db.checksum} city_digest={city_digest(db)}")
}
