fn main() {
    let words = ["alpha", "beta", "gamma", "delta", "epsilon", "zeta", "eta", "theta"]
    var counts = map()
    for i in 0..400000 {
        let w = words[i % 8] + "{i % 97}"
        counts.set(w, (counts.get(w) ?? 0) + 1)
    }
    var total = 0
    for k in counts.keys() {
        total = total + (counts.get(k) ?? 0)
    }
    print("{counts.len()} {total}")
}
