fn mix(seed: i64) -> i64 {
    var acc = seed
    var i = 0
    while i < 800 {
        acc = (acc * 1103515245 + 12345) % 2147483648
        i = i + 1
    }
    acc % 1000
}

fn main() {
    var xs: [i64] = []
    for i in 0..200000 {
        xs.push(i)
    }
    let out = xs.par_map(|x| mix(x))
    var total = 0
    for v in out {
        total = total + v
    }
    print("{total}")
}
