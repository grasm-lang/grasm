// Parallel work over *text*, not over machine words.
//
// `parmap` next to this measures arithmetic on integers, which every language
// here can hand to a thread by copying eight bytes. This one hands each worker
// a string, has it build another, and hands one back — the shape of a parallel
// parser, log scanner or template renderer, and the shape that a refcounted
// runtime has to answer for, because now the threads are sharing values rather
// than words.
//
// Grasm ran this on one core until [G6] made the reference count atomic; the
// fallback was silent, which is worse than a refusal.

fn heavy(w: str) -> str {
    var acc = w
    for i in 0..200 {
        acc = acc + "{i % 7}"
    }
    "{acc.len()}-{w}"
}

fn main() {
    var words: [str] = []
    for i in 0..20000 {
        words.push("w{i}")
    }
    let out = words.par_map(|w| heavy(w))

    // Content-sensitive, so a wrong answer cannot pass by having the right
    // number of results.
    var h = 0
    for s in out {
        for c in s.codes() {
            h = (h * 131 + c) % 1000000007
        }
    }
    print("{h}")
}
