fn main() {
    var xs: [i64] = []
    var seed = 12345
    for _n in 0..400000 {
        seed = (seed * 1103515245 + 12345) % 2147483648
        xs.push(seed % 1000000)
    }
    xs.sort()
    var checksum = 0
    for k in 0..xs.len() {
        checksum = (checksum + xs[k] * (k % 7 + 1)) % 1000000007
    }
    print("{xs.len()} {checksum}")
}
