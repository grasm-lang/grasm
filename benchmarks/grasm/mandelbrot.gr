// The canonical "N times faster than Python" kernel: a tight float loop with
// no allocation. `par_map` spreads the rows across cores — the compiler has
// already proved the row function effect-free, so this is safe by type.
fn escapes(cx: f64, cy: f64) -> i64 {
    var zx = 0.0
    var zy = 0.0
    var i = 0
    while i < 200 {
        if zx * zx + zy * zy > 4.0 {
            return i
        }
        let tx = zx * zx - zy * zy + cx
        zy = 2.0 * zx * zy + cy
        zx = tx
        i = i + 1
    }
    200
}

fn row_count(row: i64) -> i64 {
    var inside = 0
    let cy = row.as_f64() / 400.0 * 2.4 - 1.2
    var col = 0
    while col < 600 {
        let cx = col.as_f64() / 600.0 * 3.0 - 2.0
        if escapes(cx, cy) == 200 {
            inside = inside + 1
        }
        col = col + 1
    }
    inside
}

fn main() {
    var rows: [i64] = []
    for r in 0..400 {
        rows.push(r)
    }
    print("{rows.par_map(|r| row_count(r)).sum()}")
}
