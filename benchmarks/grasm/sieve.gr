fn main() {
    let limit = 2000000
    var flags = (0..=limit).map(|_i| true)
    var count = 0
    for i in 2..=limit {
        if flags[i] {
            count += 1
            var j = i * i
            while j <= limit {
                flags[j] = false
                j += i
            }
        }
    }
    print("{count}")
}
