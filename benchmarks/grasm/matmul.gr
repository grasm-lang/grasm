fn main() {
    let n = 200
    var a: [i64] = []
    var b: [i64] = []
    for i in 0..n * n {
        a.push(i % 7)
        b.push(i % 5)
    }
    var c: [i64] = []
    for _slot in 0..n * n {
        c.push(0)
    }
    var i = 0
    while i < n {
        var k = 0
        while k < n {
            let aik = a[i * n + k]
            if aik != 0 {
                var j = 0
                while j < n {
                    c[i * n + j] = c[i * n + j] + aik * b[k * n + j]
                    j = j + 1
                }
            }
            k = k + 1
        }
        i = i + 1
    }
    var total = 0
    for v in c {
        total = total + v
    }
    print("{total}")
}
