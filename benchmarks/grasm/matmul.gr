fn main() {
    let n = 200
    let a = (0..n * n).map(|i| i % 7)
    let b = (0..n * n).map(|i| i % 5)
    var c = (0..n * n).map(|_i| 0)
    for i in 0..n {
        for k in 0..n {
            let aik = a[i * n + k]
            if aik != 0 {
                for j in 0..n {
                    c[i * n + j] += aik * b[k * n + j]
                }
            }
        }
    }
    print("{c.sum()}")
}
