//! tag: T-INOUT-PLACE-ARG
//! expect: output
//! 3 [+2]
//! 15 [+5]
//! 7 [+2, +4]
//! 30 [+5, +15]
//! 9 [+2, +4, +2]
// Passing something that is not a plain variable to an `inout` parameter.
//
// A field, an element, a field of an element: each names a place, and a place
// can be written back to. A plain call read places already; a call through a
// method receiver did not, and neither did a call qualified by a module, and
// both refused outright — "inout arguments that aren't plain variables". So a
// server holding its state in one struct could not hand a piece of that state
// to a package function that appends to it, and had to copy the piece out and
// assign it back by hand.
//
// The module-qualified form needs a package, which a conformance case does
// not have; `scripts/broker_test.sh` covers it, where it was first hit. The
// interpreter accepted every form from the start, so this is also the case
// that keeps the two engines saying the same thing.
type Counter = { n: i64, tags: [str] }

type Box = { one: Counter, many: [Counter] }

fn bump(inout c: Counter, by: i64) {
    c.n = c.n + by
    c.tags.push("+{by}")
}

fn main() {
    var b = Box{ one: Counter{ n: 1, tags: [] },
        many: [Counter{ n: 10, tags: [] }] }

    // A field of a struct, and an element of a list in a field.
    bump(b.one, 2)
    bump(b.many[0], 5)
    print("{b.one.n} {b.one.tags}")
    print("{b.many[0].n} {b.many[0].tags}")

    // The same places as a method receiver, which is a second path through
    // the backend and was refused by that one too.
    b.one.bump(4)
    b.many[0].bump(15)
    print("{b.one.n} {b.one.tags}")
    print("{b.many[0].n} {b.many[0].tags}")

    // An index that is computed, so the place cannot be read at compile time.
    var which = [b.one]
    let at = which.len() - 1
    bump(which[at], 2)
    print("{which[at].n} {which[at].tags}")
}
