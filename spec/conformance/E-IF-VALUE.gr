//! tag: E-IF-VALUE
//! expect: output
//! big
//! 0
//! 1
fn describe(n: i64) -> str {
    if n > 10 {
        "big"
    } else {
        "small"
    }
}
fn takes_unit(u: ()) -> i64 {
    1
}

fn main() {
    print(describe(50))
    var count = 0
    if false {
        count = 1
    }
    print("{count}")
    // `()` has one value, and that is the only thing of its type.
    let nothing: () = ()
    print("{takes_unit(nothing)}")
}
