//! tag: E-INOUT-PLACE-WRITEBACK
//! expect: output
//! 2 [2, 2, 9] a! 3.0 true
// An `inout` argument that is a *place* — a field, an element, a field of a
// field — rather than a plain variable. A place holds a boxed value and an
// `inout` parameter is a pointer to a slot of the callee's own type, so the
// two have to meet: the compiled engine passed the box straight through, the
// callee incremented its *address*, and reading the field back said
// `unbox: not an i64` for a program `grasm run` answered.
type Inner = { v: i64 }
type Outer = { i: Inner, xs: [i64], s: str, f: f64, b: bool }

fn bump(inout n: i64) {
    n += 1
}
fn app(inout s: str) {
    s = s + "!"
}
fn scale(inout x: f64) {
    x = x * 2.0
}
fn flip(inout b: bool) {
    b = not b
}
fn addall(inout xs: [i64]) {
    xs.push(9)
}

fn main() {
    var o = Outer{ i: Inner{ v: 1 }, xs: [1, 2], s: "a", f: 1.5, b: false }
    bump(o.i.v)
    bump(o.xs[0])
    app(o.s)
    scale(o.f)
    flip(o.b)
    addall(o.xs)
    print("{o.i.v} {o.xs} {o.s} {o.f} {o.b}")
}
