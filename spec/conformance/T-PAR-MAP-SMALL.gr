//! tag: T-PAR-MAP-SMALL
//! expect: output
//! 6 jobs, in order
//! 0 1 4 9 16 25
//! same as one core
//! 3 kept
// A short list whose elements are expensive is worth splitting.
//
// The runtime used to decide by counting: fewer than 256 elements meant one
// core, whatever was in them. So a thousand-element `x * x` was threaded and a
// six-element list of real work was not — backwards, and found by writing an
// audio mixdown whose elements were forty milliseconds each.
//
// It now computes the first element on the calling thread, times it, and
// splits the rest when what is left is worth the spawns. What must not change
// is any of this file's output: `par_map` answers in input order for any core
// count, and `par_filter` keeps the same elements in the same order, which is
// what makes a parallel program's result independent of the machine it ran on.
type Job = {
    n: i64,
    label: str,
}

/// Expensive enough that the runtime chooses to spread it, and exact, so the
/// answer cannot depend on how it was divided.
fn work(j: Job) -> i64 {
    var spin = 0
    var i = 0
    while i < 400000 {
        spin = (spin + i) % 7919
        i = i + 1
    }
    return j.n * j.n + spin * 0
}

fn heavy_even(j: Job) -> bool {
    var spin = 0
    var i = 0
    while i < 400000 {
        spin = (spin + i) % 7919
        i = i + 1
    }
    return j.n % 2 == 0 and spin >= 0
}

fn main() {
    var jobs: [Job] = []
    var k = 0
    while k < 6 {
        jobs.push(Job{ n: k, label: "j{k}" })
        k = k + 1
    }
    let done = jobs.par_map(|j| work(j))
    print("{done.len()} jobs, in order")
    var line = ""
    for v in done {
        line = line + (if line == "" { "" } else { " " }) + "{v}"
    }
    print(line)

    // The claim `par_map` makes is that this is the same list.
    var serial: [i64] = []
    for j in jobs {
        serial.push(work(j))
    }
    print(if serial == done { "same as one core" } else { "DIFFERENT" })

    let kept = jobs.par_filter(|j| heavy_even(j))
    print("{kept.len()} kept")
}
