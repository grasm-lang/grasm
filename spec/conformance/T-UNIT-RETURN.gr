//! tag: T-UNIT-RETURN
//! expect: output
//! n is 2 and nothing came back
fn nothing() -> () {
    return ()
}

fn effectful(inout n: i64) -> () {
    n = n + 1
    return ()
}

fn conditional(n: i64) -> () {
    if n > 0 {
        return ()
    }
    return ()
}

fn main() {
    let _v = nothing()
    var n = 0
    effectful(n)
    effectful(n)
    conditional(n)
    print("n is {n} and nothing came back")
}
