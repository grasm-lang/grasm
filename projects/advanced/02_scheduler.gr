// Advanced project 2: cooperative task scheduler simulation.
// Validates: state machines, priority queues, determinism, scale (10k tasks).

type TaskState =
    | Ready
    | Running
    | Blocked(until_tick: i64)
    | Done(at_tick: i64)

type Task = { id: i64, priority: i64, work_left: i64, state: TaskState }

type Sched = { tasks: [Task], tick: i64, completed: i64, context_switches: i64 }

fn new_sched() -> Sched {
    Sched{ tasks: [], tick: 0, completed: 0, context_switches: 0 }
}

fn spawn(inout s: Sched, priority: i64, work: i64) -> i64 {
    let id = s.tasks.len() + 1
    s.tasks.push(Task{ id: id, priority: priority, work_left: work, state: Ready })
    id
}

// Pick the highest-priority ready task (stable on id for determinism).
fn pick_next(s: Sched) -> Option[i64] {
    var best_idx: Option[i64] = None
    var best_prio = 0 - 1
    var i = 0
    while i < s.tasks.len() {
        let t = s.tasks[i]
        let ready = match t.state {
            Ready -> true
            Blocked(until) -> s.tick >= until
            _ -> false
        }
        if ready and t.priority > best_prio {
            best_prio = t.priority
            best_idx = Some(i)
        }
        i += 1
    }
    best_idx
}

// One tick: run the chosen task for one unit; every 5th unit of work blocks
// the task for 2 ticks (simulated I/O wait).
fn step(inout s: Sched) -> bool {
    s.tick += 1
    match pick_next(s) {
        None -> {
            // Nothing runnable; if tasks remain blocked, time passes.
            var any_left = false
            for t in s.tasks {
                let live = match t.state {
                    Done(at) -> false
                    _ -> true
                }
                if live {
                    any_left = true
                }
            }
            any_left
        }
        Some(i) -> {
            s.context_switches += 1
            var t = s.tasks[i]
            t.work_left -= 1
            if t.work_left <= 0 {
                t.state = Done(s.tick)
                s.completed += 1
            } else if t.work_left % 5 == 0 {
                t.state = Blocked(s.tick + 2)
            } else {
                t.state = Ready
            }
            s.tasks[i] = t
            true
        }
    }
}

fn run_until_done(inout s: Sched, max_ticks: i64) {
    while s.tick < max_ticks {
        if not step(s) {
            break
        }
    }
}

fn main() {
    var s = new_sched()
    let a = s.spawn(1, 7)
    let b = s.spawn(3, 4)
    let c = s.spawn(2, 6)
    s.run_until_done(1000)
    print("done at tick {s.tick}: {s.completed}/3 tasks, {s.context_switches} switches")
    for t in s.tasks {
        match t.state {
            Done(at) -> print("  task {t.id} (prio {t.priority}) finished at {at}")
            _ -> print("  task {t.id} unfinished")
        }
    }

    // Scale test: 2000 tasks.
    var big = new_sched()
    for i in 0..2000 {
        let _id = big.spawn(i % 10, 3)
    }
    big.run_until_done(100000)
    print("scale: {big.completed}/2000 completed in {big.tick} ticks")
}

test "priorities win" {
    var s = new_sched()
    let low = s.spawn(1, 3)
    let high = s.spawn(9, 3)
    s.run_until_done(100)
    // High priority must finish before low.
    let high_done = match s.tasks[1].state {
        Done(at) -> at
        _ -> 99999
    }
    let low_done = match s.tasks[0].state {
        Done(at) -> at
        _ -> 99999
    }
    assert(high_done < low_done)
    assert_eq(s.completed, 2)
}

test "deterministic" {
    var s1 = new_sched()
    var s2 = new_sched()
    let x1 = s1.spawn(2, 8)
    let y1 = s1.spawn(5, 5)
    let x2 = s2.spawn(2, 8)
    let y2 = s2.spawn(5, 5)
    s1.run_until_done(500)
    s2.run_until_done(500)
    assert_eq(s1.tick, s2.tick)
    assert_eq(s1.context_switches, s2.context_switches)
}

test "blocked tasks resume" {
    var s = new_sched()
    let t = s.spawn(1, 6)
    s.run_until_done(100)
    assert_eq(s.completed, 1)
}
