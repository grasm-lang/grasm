// Beginner project 1: number games — fizzbuzz, primes, collatz.
// Validates: control flow, match, functions, interpolation, ranges.

fn fizzbuzz(n: i64) -> str {
    match (n % 3 == 0, n % 5 == 0) {
        (true, true) -> "FizzBuzz"
        (true, false) -> "Fizz"
        (false, true) -> "Buzz"
        (false, false) -> "{n}"
    }
}

fn is_prime(n: i64) -> bool {
    if n < 2 {
        return false
    }
    var d = 2
    while d * d <= n {
        if n % d == 0 {
            return false
        }
        d += 1
    }
    true
}

fn collatz_steps(start: i64) -> i64 {
    var n = start
    var steps = 0
    while n != 1 {
        if n % 2 == 0 {
            n = n / 2
        } else {
            n = 3 * n + 1
        }
        steps += 1
    }
    steps
}

fn main() {
    var line: [str] = []
    for i in 1..=15 {
        line.push(fizzbuzz(i))
    }
    print(line.join(" "))

    let primes = [2, 3, 4, 5, 16, 17, 97, 100].filter(|n| is_prime(n))
    print("primes: {primes}")

    print("collatz(27) takes {collatz_steps(27)} steps")
}

test "fizzbuzz rules" {
    assert_eq(fizzbuzz(3), "Fizz")
    assert_eq(fizzbuzz(10), "Buzz")
    assert_eq(fizzbuzz(15), "FizzBuzz")
    assert_eq(fizzbuzz(7), "7")
}

test "primes" {
    assert(is_prime(2))
    assert(is_prime(97))
    assert(not is_prime(1))
    assert(not is_prime(100))
}

test "collatz" {
    assert_eq(collatz_steps(1), 0)
    assert_eq(collatz_steps(6), 8)
    assert_eq(collatz_steps(27), 111)
}
